@@ -192,6 +192,25 @@ export function createCoins(course: Course): CoinSystem {
   // coin (≈ 5.6 % of the frame height).
   const coinV = (flag05('match08') || flag05('matchall')) && flag05('m08coinv');
   const COINV_CAP = 0.056, BENNY_UP = 0.75, BENNY_R = 0.95;
+  // `&m08coinsz=1` (Screen 08 r23, with m08coinv + coins08px; visuals only — count, score, pickup rules and positions
+  // unchanged): the far picture coins' world sizes were fitted ~10–33 % larger than the nearest one's (each only to its
+  // painted size at the approved view), so while swimming they grew to the full cap well above Benny, where the picture
+  // shows smaller coins (~15–20 % larger than painted at the same screen height). Now the cap follows the painted coin
+  // line: at each screen height a picture coin is at most the painted coin at that height (+6 %, so the approved start
+  // view keeps its exact painted coins); below the nearest painted coin the old cap holds.
+  const coinSz = coinV && flag05('coins08px') && flag05('m08coinsz');
+  const SZ_Y: number[] = [], SZ_D: number[] = [];
+  if (coinSz) {
+    const pts = coins08px.coins.map((c) => [c.px[1] / 1536, (2 * c.px[2]) / 1536]).sort((a, b) => a[0] - b[0]);
+    let mx = 0;
+    for (const [y, d] of pts) { mx = Math.max(mx, d); SZ_Y.push(y); SZ_D.push(mx * 1.06); }
+  }
+  const capAt = (yf: number) => {
+    if (!SZ_Y.length || yf >= SZ_Y[SZ_Y.length - 1]) return COINV_CAP;
+    if (yf <= SZ_Y[0]) return SZ_D[0];
+    let k = 0; while (SZ_Y[k + 1] < yf) k++;
+    return Math.min(COINV_CAP, SZ_D[k] + ((SZ_D[k + 1] - SZ_D[k]) * (yf - SZ_Y[k])) / (SZ_Y[k + 1] - SZ_Y[k]));
+  };
   let cam: THREE.PerspectiveCamera | null = null;
   let bS = -1, bLat = 0;
   const cv = new THREE.Vector3(), bv = new THREE.Vector3(), cn = new THREE.Vector3(), bn = new THREE.Vector3();
@@ -201,7 +220,9 @@ export function createCoins(course: Course): CoinSystem {
     const dist = cv.copy(pos).sub(cam.position).length();
     let k = 1;
     const frac = size / (2 * dist * tanH); // coin diameter as a fraction of the frame height
-    if (frac > COINV_CAP) k = COINV_CAP / frac;
+    let cap = COINV_CAP;
+    if (coinSz) { cn.copy(pos).project(cam); if (cn.z < 1) cap = capAt((1 - cn.y) / 2); }
+    if (frac > cap) k = cap / frac;
     const fb = course.sample(bS);
     bv.copy(fb.pos).addScaledVector(fb.right, bLat).addScaledVector(fb.up, BENNY_UP);
     const bd = bv.distanceTo(cam.position);
