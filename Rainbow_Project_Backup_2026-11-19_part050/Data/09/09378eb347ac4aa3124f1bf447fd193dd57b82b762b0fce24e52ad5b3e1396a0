import concurrent.futures
import csv
import hashlib
import io
import json
from pathlib import Path
import subprocess
from zipfile import ZIP_DEFLATED, ZipFile

root = Path(__file__).parent
source = Path("/workspace/library-files/Rainbow-ChatGPT-Review")
folder = root / "phone"
folder.mkdir(exist_ok=True)
work = root / "video-work"
work.mkdir()
files = sorted((source / "Individual_Videos").glob("SCREEN*_ENTRANCE_TO_EXIT.mp4"))
assert len(files) == 10

def facts(path):
    info = json.loads(subprocess.check_output([
        "ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
        "stream=codec_name,nb_frames,width,height,avg_frame_rate:format=duration",
        "-of", "json", str(path)]))
    return info["streams"][0], float(info["format"]["duration"])

def filehash(path):
    with path.open("rb") as f:
        return hashlib.file_digest(f, "sha256").hexdigest()

def encode(original):
    target = work / original.name
    args = ["ffmpeg", "-nostdin", "-v", "error", "-y", "-i", str(original),
            "-map", "0:v:0", "-map_metadata", "-1", "-an", "-fps_mode", "passthrough",
            "-c:v", "libx264", "-preset", "medium", "-pix_fmt", "yuv420p", "-threads", "2",
            "-b:v", "1200k", "-passlogfile", str(work / original.stem)]
    subprocess.run(args + ["-pass", "1", "-f", "null", "/dev/null"], check=True)
    subprocess.run(args + ["-pass", "2", "-movflags", "+faststart", str(target)], check=True)
    a, da = facts(original)
    b, db = facts(target)
    assert b["codec_name"] == "h264" and a["nb_frames"] == b["nb_frames"]
    assert (a["width"], a["height"], a["avg_frame_rate"]) == (b["width"], b["height"], b["avg_frame_rate"])
    assert abs(da - db) < 0.001
    subprocess.run(["ffmpeg", "-nostdin", "-v", "error", "-xerror", "-i", str(target),
                    "-map", "0:v:0", "-f", "null", "-"], check=True)
    rel = f"Screen_{original.name[6:8]}/{original.name}"
    return (target, {"file": rel, "width": b["width"], "height": b["height"],
                     "frames": b["nb_frames"], "rate": b["avg_frame_rate"], "seconds": db,
                     "source_sha256": filehash(original), "phone_sha256": filehash(target)})

with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
    encoded = list(pool.map(encode, files))
dest = folder / "Rainbow_Gameplay_Phone_Review.zip"
with ZipFile(source / "Rainbow_Gameplay_Videos.zip") as source_zip, ZipFile(dest, "x", compression=ZIP_DEFLATED) as out:
    input_index = list(csv.DictReader(io.StringIO(source_zip.read("FILE_INDEX.csv").decode("utf-8-sig"))))
    for path, row in encoded:
        original = source_zip.read(row["file"])
        assert hashlib.sha256(original).hexdigest() == row["source_sha256"]
        out.write(path, row["file"])
        match = next((r for r in input_index if row["file"] in r.values()), {})
        row["source_branch"] = match.get("source_branch", "")
        row["source_commit"] = match.get("source_commit", "")
    report = io.StringIO()
    writer = csv.DictWriter(report, fieldnames=encoded[0][1].keys()); writer.writeheader()
    writer.writerows(row for _, row in encoded)
    out.writestr("PHONE_VIDEO_INDEX.csv", report.getvalue())
    out.writestr("VIDEO_TIMESTAMPS.csv", source_zip.read("VIDEO_TIMESTAMPS.csv"))
    out.writestr("README_FIRST.md", """# Rainbow phone gameplay review

Each of the five screen folders contains two uninterrupted H.264 rides from entrance to exit. CLAUDIA_RETAINED is the saved gameplay baseline. CODEX_CANDIDATE is an experiment awaiting the owner's approval. Watch the same timestamp in both clips when comparing a turn, drop or transition.

These are compact encodes of the high-detail captures. Every ride retains all the original frames, 648 × 1152 resolution, 12 frames per second and its original duration. Fine texture detail may be softer from compression. Use the complete video collection for close inspection of foam edges and tunnel textures.

The footage records the playable Three.js renderer. The stage timings use the saved capture clock. VIDEO_TIMESTAMPS.csv identifies the source checkpoints. PHONE_VIDEO_INDEX.csv records the original and compact file hashes.
""")
assert dest.stat().st_size <= 10 * 1024 * 1024
with ZipFile(dest) as check:
    assert check.testzip() is None
    assert all(hashlib.sha256(check.read(row["file"])).hexdigest() == row["phone_sha256"] for _, row in encoded)
print("Phone gameplay ZIP", len(encoded), "complete source-matched rides,", dest.stat().st_size, "bytes", flush=True)
