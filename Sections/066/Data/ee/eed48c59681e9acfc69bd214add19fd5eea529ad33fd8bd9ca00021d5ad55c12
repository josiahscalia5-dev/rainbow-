from pathlib import Path
import json,hashlib,re,subprocess,zipfile
from html.parser import HTMLParser

root=Path.cwd();out=Path('/workspace/library-files/Rainbow-Motion-Toolchain')
source=json.loads((root/'heads.json').read_text());pack=json.loads((out/'evidence/capture-summary.json').read_text())
remote=json.loads((root/'remote-end.json').read_text());(out/'evidence/remote-end.json').write_text(json.dumps(remote,indent=2))
base='https://github.com/josiahscalia5-dev/rainbow-/commit/'
tip='The repository was checked before capture at 21:16 UTC on November 18, 2026 and again at '+remote['checkedAt']+'. '+remote['note']+'\n\n'
tip+='| Source | Branch | Commit used |\n| --- | --- | --- |\n'
for sid,v in source.items():tip+=f"| {sid} | `{v['branch']}` | [{v['commit']}]({base}{v['commit']}) |\n"
table='| Screen | Whole-frame RGB agreement | Pixelmatch mismatches | Independent repeat, exact changed pixels |\n| --- | ---: | ---: | ---: |\n'
rows=['04','05','06','07','08','04r']
for sid in rows:
 q=pack[sid];lab='04 ring specialist' if sid=='04r' else sid
 table+=f"| {lab} | {q['within20Percent']:.2f}% | {q['pixelmatchMismatches']:,} | {q['independentRepeatChangedPixels']:,} |\n"
details=[]
for sid in rows:
 q=pack[sid]
 if q['independentRepeatChangedPixels']:
  from PIL import Image
  import numpy as np
  a=np.asarray(Image.open(out/'screens'/sid/'CLAUDIA_BEFORE.png').convert('RGB'))
  b=np.asarray(Image.open(out/'screens'/sid/'independent-opening.png').convert('RGB'))
  y,x=np.where((a!=b).any(-1));details.append(f"{sid} had {len(x):,} exact changed pixels within rows {int(y.min())}–{int(y.max())}")
repeat=('. '.join(details)+'. ') if details else 'All native repeats matched pixel for pixel. '
stable=[sid for sid in rows if pack[sid]['independentRepeatChangedPixels']==0]
if stable and details:repeat+='The independent repeats matched exactly for '+', '.join(stable)+'.'
count=sum(pack[s]['stills'] for s in rows if s!='04r'); n=sum(pack[s]['clipFrames'] for s in rows if s!='04r')
cov=f'The five stages produced {count} distinct full-size viewpoints and {n} encoded continuous-route frames. The gold-ring specialist has {pack["04r"]["stills"]} further full-size viewpoints.'
screen=(root/'scenery-reviewed.md').read_text()
report=(root/'REPORT-template.md').read_text().replace('@REFS@',tip).replace('@METRICS@',table).replace('@REPEATS@',repeat).replace('@SCENERY@',screen).replace('@COVERAGE@',cov)
assert not re.search(r'@[A-Z]+@',report)
(out/'REPORT.md').write_text(report)
legacy=Path('/workspace/library-files/Rainbow-S07-Image2Blender')
legacy_names=['APPROVED.jpg','CLAUDIA_BEFORE_opening.png','IMAGE2BLENDER_TEST_opening.png','CLAUDIA_BEFORE_forward10.png','IMAGE2BLENDER_TEST_forward10.png','CLAUDIA_BEFORE_left12.png','IMAGE2BLENDER_TEST_left12.png','CLAUDIA_BEFORE_right12.png','IMAGE2BLENDER_TEST_right12.png']
import shutil
d=out/'previous-Image2Blender';d.mkdir(exist_ok=True)
for nm in legacy_names:shutil.copyfile(legacy/nm,d/nm)
index=out/'index.html'
s=index.read_text().replace('</main>','<h2>Earlier Image2Blender bank trial</h2><p>The editable banks widened in the forward view and stayed too straight during hard steering. This trial was rejected.</p><ul>'+''.join('<li><a href="previous-Image2Blender/'+nm+'">'+nm.replace('_',' ').rsplit('.',1)[0]+'</a></li>' for nm in legacy_names)+'</ul></main>')
index.write_text(s)
class Links(HTMLParser):
 def __init__(self):super().__init__();self.target=[]
 def handle_starttag(self,tag,attrs):
  for attr,v in attrs:
   if attr in ('href','src'):self.target.append(v)
for f in out.rglob('*.html'):
 parser=Links();parser.feed(f.read_text())
 for l in parser.target:assert (f.parent/l).is_file(),(f,l)
for sid in rows:
 dest=out/'screens'/sid
 from PIL import Image
 for f in dest.glob('*.png'):assert Image.open(f).size==(864,1536),f
for f in (out/'screen-07-paddle').glob('*.png'):assert Image.open(f).size==(864,1536),f
for f in (out/'screen-07-paddle').glob('*.mp4'):
 jsonprobe=json.loads(subprocess.check_output(['ffprobe','-v','error','-show_entries','stream=width,height,nb_frames,r_frame_rate','-of','json',str(f)]))['streams'][0]
 assert int(jsonprobe['nb_frames'])==39 and int(jsonprobe['width'])==324 and jsonprobe['r_frame_rate']=='12/1',jsonprobe
feedback=json.load(open(out/'screens/08/post-feedback.json'));assert all('after' in row and row['state']['hearts']==4 for row in feedback)
sha=hashlib.sha256((out/'screen-07-paddle'/'APPROVED.jpg').read_bytes()).hexdigest();assert sha==json.load(open(root/'reference-checks.json'))['manifest']['references/07_dive_the_washer_tube.png']
for z in out.glob('*.zip'):
 with zipfile.ZipFile(z) as q:assert q.testzip() is None,z
target=out/'Rainbow-motion-review.zip'
with zipfile.ZipFile(target,'w',compression=zipfile.ZIP_DEFLATED,compresslevel=1) as z:
 for p in sorted(out.rglob('*')):
  if p.is_file() and p.suffix!='.zip':z.write(p,p.relative_to(out))
with zipfile.ZipFile(target) as z:
 assert z.testzip() is None
 assert 'proposal/.agents/skills/rainbow-visual-motion-matcher/SKILL.md' in z.namelist()
 assert 'index.html' in z.namelist()
print('Verified linked native images, stage ZIPs, original hash, paired videos and mobile bundle.',target.stat().st_size,count,n)
