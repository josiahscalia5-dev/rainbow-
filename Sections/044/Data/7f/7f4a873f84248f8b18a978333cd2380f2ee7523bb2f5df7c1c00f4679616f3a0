import json, os, shutil, subprocess, sys
from pathlib import Path
root, before, coat, scenery = map(Path, sys.argv[1:])
base=json.loads((scenery/'baseline.json').read_text())
heads = {b.removeprefix('refs/heads/'):a for a,b in (s.split() for s in (root/'remote-at-start.tsv').read_text().splitlines())}
parent='codex/s06-benny-layered-coat'
assert heads[parent]=='35dd903dc09f08d7b3262b9cab2753ad0d40d19c'
assert heads[base['retained']['branch']]==base['retained']['commit']
branch='codex/s06-benny-reference-pink'
assert branch not in heads
base.update(branch=branch, parent={'branch':parent,'commit':heads[parent]})
(root/'baseline.json').write_text(json.dumps(base,indent=2)+'\n')
repo=root/'repo';repo.mkdir(exist_ok=True)
def git(*args):return subprocess.check_output(['git','-C', str(repo),*args],env={**os.environ,'GIT_LFS_SKIP_SMUDGE':'1'})
git('init','--quiet');git('remote','add','origin','https://github.com/josiahscalia5-dev/rainbow-.git')
git('config','user.name','Codex');git('config','user.email','codex@users.noreply.github.com')
git('config','core.sparseCheckout','true');git('config','remote.origin.promisor','true');git('config','remote.origin.partialclonefilter','blob:none')
(repo/'.git/info/sparse-checkout').write_text('/.gitattributes\n/src/game/Game.ts\n/src/characters/benny/\n/tools/benny-reference-pink/\n/assets/textures/match06/coat-locks.png\n/assets/textures/match06/benny-reference-pink.png\n/experiments/codex/s06-benny-reference-pink/\n')
git('fetch','--quiet','--depth=3','--filter=blob:none','origin','refs/heads/'+parent)
git('switch','-c',branch,heads[parent]);assert git('rev-parse','HEAD').decode().strip()==heads[parent]
game=root/'games/06';game.mkdir(parents=True,exist_ok=True)
for source in before.rglob('*'):
    rel=source.relative_to(before)
    if rel.parts[0] in ['node_modules','dist','.git'] or (source.is_dir() and not source.is_symlink()):continue
    dest=game/rel;dest.parent.mkdir(parents=True,exist_ok=True)
    if source.is_symlink(): dest.symlink_to(source.resolve())
    elif rel.parts[0]=='src':shutil.copyfile(source,dest)
    else:os.link(source,dest)
for name in ['src/game/Game.ts','src/characters/benny/coat06.ts','src/characters/benny/fur.ts','assets/textures/match06/coat-locks.png']:
    dest=game/name;dest.parent.mkdir(parents=True,exist_ok=True)
    if dest.exists():dest.unlink()
    shutil.copyfile(repo/name,dest)
(game/'node_modules').symlink_to((before/'node_modules').resolve(),target_is_directory=True)
for name in ['capture.cjs','queries.json','serve.cjs']:shutil.copyfile(scenery/name,root/name)
(root/'flags.json').write_text(json.dumps({'06':'cx06ReferencePink=1'})+'\n')
(root/'authoring').mkdir();(root/'diagnostics').mkdir()
# Reuse verified A/B source pictures and copy protected evidence without writing through their links.
bdir=root/'proof/06/BEFORE';bdir.mkdir(parents=True)
for f in (scenery/'proof/06/BEFORE').iterdir():os.link(f,bdir/f.name)
print('Independent character branch',branch,heads[parent])
