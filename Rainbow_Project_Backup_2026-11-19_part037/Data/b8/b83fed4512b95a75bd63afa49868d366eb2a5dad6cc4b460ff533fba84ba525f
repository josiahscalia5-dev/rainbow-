{"agentId": "ad0e2086ebd5ee08b", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "claude/rainbow-3d-account-transfer-syorak", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Spline water ribbon — the traversable stream Benny rides from the Drum A drain to the towel.\n3\t *\n4\t * Geometry: rows every `ds` along the master course, columns across `widthAt(s)`; a slightly\n5\t * concave trough with raised frothy edges plus a short skirt under each edge (thickness).\n6\t * Shader: electric-cyan core with meandering hot-pink flow bands, advected white streaks and\n7\t * sparkles (two-phase flow-map advection so per-stage speeds never shear), Fresnel/haze\n8\t * reflection, specular glints, cellular soap-foam fringe, Benny ripple rings + V-wake, the five\n9\t * glowing chevrons on the 04 slide, a dithered hand-over to the whirlpool surface in 03 and a\n10\t * drain-away for the 11 outro.\n11\t */\n12\timport * as THREE from 'three';\n13\timport type { Course, StageId } from '../world/course';\n14\timport { FRAG_FX_GLSL, FRAG_TAIL, NOISE_GLSL, PALETTE, withFog } from './glsl';\n15\t\n16\t/** wave amplitude per stage (units); blended across boundaries */\n17\tconst AMP: Partial<Record<StageId, number>> = {\n18\t  '02': 0.06, '03': 0.08, '04': 0.03, '05': 0.1, '06': 0.12, '07': 0.1, '08': 0.1, '09': 0.16, '10': 0.08, '11': 0.05,\n19\t};\n20\texport const EDGE_LIFT = 0.28;\n21\t\n22\t/**\n23\t * Per-stage colour-band layout (blended across stage boundaries, baked into `aStyle`):\n24\t *  x gate: 1 = pink bands taper off and part around Benny so the water at and behind him is pure\n25\t *          cyan (ref 05: rows y=1200/1400 are 0% pink); 0 = bands run right past him (refs 04/06/07\n26\t *          keep pink at the sides near the camera)\n27\t *  y off:  band-centre offset from the meandering core centre, fraction of the half width\n28\t *  z wid:  band half width, fraction of the half width\n29\t * Between the two bands is the electric-cyan core; outside them more cyan, then the foam lace.\n30\t */\n31\ttype Style = [number, number, number, number];\n32\t/*  w free: weight of the shader's own drifting channel meander (meander() in FRAG). 0 in 05, where the\n33\t *          course itself winds (S05/meander05 in course.ts) and the core is pinned to the route (see\n34\t *          coreLateral) so the coins on the route stay on the cyan core. 1 elsewhere (04/06/07 unchanged).\n35\t * 05 layout from ref 05 at the live 05 camera (y=600 ≈ 36 px/u, y=700 ≈ 63, y=800 ≈ 93): in the mid/far\n36\t * field each pink band is ≈20 % of the water width, the cyan core ≈45 %, a thin outer cyan strip ≈7 %\n37\t * → band centre 0.62 hw, half width 0.19 hw. Toward Benny the bands taper to half width (gate, FRAG),\n38\t * which gives the ref's ≈100–130 px bands at y=800 and a pure-cyan near field. */\n39\tconst BAND_STYLE: Partial<Record<StageId, Style>> = {\n40\t  '04': [0, 0.6, 0.19, 1],\n41\t  '05': [1, 0.62, 0.19, 0],\n42\t  '06': [0.4, 0.48, 0.1, 1],\n43\t  '07': [0, 0.52, 0.13, 1],\n44\t};\n45\tconst BAND_DEFAULT: Style = [0, 0.5, 0.12, 1];\n46\t\n47\tfunction bandStyleAt(course: Course, s: number): Style {\n48\t  const o: Style = [0, 0, 0, 0];\n49\t  let w = 0;\n50\t  for (const st of course.stages) {\n51\t    const a = smooth(st.s0 - 5, st.s0 + 5, s) * (1 - smooth(st.s1 - 5, st.s1 + 5, s));\n52\t    if (a <= 0) continue;\n53\t    const v = BAND_STYLE[st.id] ?? BAND_DEFAULT;\n54\t    for (let i = 0; i < 4; i++) o[i] += v[i] * a;\n55\t    w += a;\n56\t  }\n57\t  if (w <= 0) return [...(BAND_STYLE[course.stageAtS(s).id] ?? BAND_DEFAULT)];\n58\t  return [o[0] / w, o[1] / w, o[2] / w, o[3] / w];\n59\t}\n60\t\n61\t/**\n62\t * 05 current: lateral position (units, ribbon `right` axis, + = right) of the centre of the\n63\t * electric-cyan core relative to the route centreline. The core swings WITH the course meander,\n64\t * amplified by CORE_SWING, so the two pink bands trace S-bends ≈(1 + CORE_SWING)× as strong as the\n65\t * route's own (ref 05: ±60–120 px). Bounded by CORE_SWING · max|offset05| (≈0.9 · 1.85 = 1.7 u at the\n66\t * far crest; ≤1.25 u within 35 u of the 05 checkpoint), inside the ≥2 u core half width, so a coin on\n67\t * the route centre (lat 0) still sits on cyan. 0 outside 05.\n68\t * gameplay/coins.ts may place the 05 coins at this lateral to put them exactly on the core centre.\n69\t */\n70\texport const CORE_SWING = 0.9;\n71\texport function coreLateral(course: Course, s: number): number {\n72\t  const st = course.stage('05');\n73\t  if (s <= st.s0 || s >= st.s1) return 0;\n74\t  return CORE_SWING * course.offset05(s) * course.sample(s).right.x;\n75\t}\n76\t\n77\t/**\n78\t * Ribbon colours in shader (pre-tonemap, linear) space. NeutralToneMapping desaturates anything\n79\t * whose peak channel passes ≈0.76·exposure, so these were solved by inverting Neutral at the game's\n80\t * exposure 0.86 (src/render/env.ts). Flat values after tone mapping: cyanDeep #0065D6, cyan #1D89F0,\n81\t * cyanBright #42C8F7, pinkDeep #E206BE, pink #F741DD (H 308°, not violet), pinkLight #FA93E7. The\n82\t * streaks/crests/glints added on top lift the rendered cyan median to ≈#06A7FF (ref 05 #039FF6).\n83\t * Crests/highlights are allowed to desaturate toward white (that is how the ref highlights look).\n84\t * The shared PALETTE in glsl.ts is untouched (whirlpool, drum and final wave use it).\n85\t */\n86\tconst lin = (r: number, g: number, b: number) => new THREE.Color().setRGB(r, g, b, THREE.LinearSRGBColorSpace);\n87\tconst RIBBON_PAL = {\n88\t  cyanDeep: lin(0.0, 0.15, 0.78),\n89\t  cyan: lin(0.0, 0.31, 1.12),\n90\t  cyanBright: lin(0.04, 0.95, 1.55),\n91\t  pinkDeep: lin(0.9, 0.02, 0.62),\n92\t  pink: lin(1.55, 0.03, 1.2),\n93\t  pinkLight: lin(2.2, 0.5, 1.8),\n94\t};\n95\t/**\n96\t * 05 river palette (wave 4), shader-space linear values solved through the full post chain\n97\t * (exposure 0.86 → Neutral → sRGB → grade.ts saturation 1.36 / contrast 1.15; bloom ignored) so the\n98\t * flat colours land on the ref 05 samples instead of clipping: cyan deep ≈#0466CF (troughs),\n99\t * cyan ≈#029AF3 (ref core), bright ≈#33C0FF, streak ≈#8FE6FF; pink deep ≈#BC16A8, pink ≈#F73DEA\n100\t * (ref #F739E5 / band medians #F749F1), light ≈#FA9EF2, streak ≈#FEC0F6. The old RIBBON_PAL pink\n101\t * (1.55, 0.03, 1.2) clips to #FF23FF in that chain and the lighting lifted it to lavender #FF6CFF.\n102\t */\n103\tconst RIVER05_PAL = {\n104\t  cyanDeep: lin(0.04, 0.16, 0.46),\n105\t  cyan: lin(0.06, 0.37, 0.74),\n106\t  cyanBright: lin(0.1, 0.8, 1.8),\n107\t  cyanStreak: lin(0.36, 1.25, 2.1),\n108\t  pinkDeep: lin(0.36, 0.04, 0.3),\n109\t  pink: lin(0.7, 0.08, 0.64),\n110\t  pinkLight: lin(0.92, 0.3, 0.88),\n111\t  pinkStreak: lin(1.1, 0.58, 1.04),\n112\t};\n113\t/** 05 texture advection relative to the stage speed (>1: the current visibly overtakes Benny) */\n114\tconst FLOW05 = 1.3;\n115\t\n116\texport function ampAt(course: Course, s: number): number {\n117\t  let v = 0, w = 0;\n118\t  for (const st of course.stages) {\n119\t    const a = smooth(st.s0 - 5, st.s0 + 5, s) * (1 - smooth(st.s1 - 5, st.s1 + 5, s));\n120\t    if (a > 0) { v += (AMP[st.id] ?? 0.08) * a; w += a; }\n121\t  }\n122\t  let amp = w > 0 ? v / w : 0.08;\n123\t  // calm the long straight of the deep plunge (fast sheet flow)\n124\t  const pt = course.marks['07_plunge_top'], pb = course.marks['07_plunge_bottom'];\n125\t  if (pt !== undefined) amp *= 1 - 0.6 * smooth(pt, pt + 8, s) * (1 - smooth(pb - 8, pb, s));\n126\t  return amp;\n127\t}\n128\t\n129\tfunction smooth(a: number, b: number, x: number) {\n130\t  const t = Math.min(1, Math.max(0, (x - a) / (b - a)));\n131\t  return t * t * (3 - 2 * t);\n132\t}\n133\t\n134\t/** CPU mirror of the vertex displacement (keep in sync with VERT). */\n135\texport function ribbonWave(u: number, s: number, t: number, amp: number): number {\n136\t  const au = Math.min(1, Math.abs(u));\n137\t  const trough = EDGE_LIFT * au * au * au;\n138\t  return trough + amp * (0.6 * Math.sin(s * 0.9 - t * 2.4 + u * 1.7) + 0.4 * Math.sin(s * 0.41 + t * 1.5 - u * 2.3));\n139\t}\n140\t\n141\tconst VERT = /* glsl */ `\n142\tattribute vec2 aUV;      // x = u (-1..1 across), y = s (arc length)\n143\tattribute float aHalfW;\n144\tattribute float aSpeed;\n145\tattribute float aAmp;\n146\tattribute float aSkirt;  // 0 surface, 1 skirt bottom\n147\tattribute vec4 aStyle;   // band layout: gate, offset, half width, free-meander weight (see BAND_STYLE)\n148\tattribute float aCore;   // 05: core-centre lateral swing (units, see coreLateral)\n149\tattribute vec3 aTan;     // course tangent (downstream)\n150\tuniform float uTime;\n151\tuniform vec4 uHide;      // s03Start, s04Start, chuteMark, unused\n152\tvarying vec2 vUV;\n153\tvarying float vHalfW;\n154\tvarying float vSpeed;\n155\tvarying float vSkirt;\n156\tvarying float vHide;\n157\tvarying vec4 vStyle;\n158\tvarying float vCore;\n159\tvarying vec3 vTanW;\n160\tvarying vec3 vPosW;\n161\tvarying vec3 vNormalW;\n162\t#include <fog_pars_vertex>\n163\tvoid main() {\n164\t  vStyle = aStyle;\n165\t  vCore = aCore;\n166\t  vTanW = normalize(mat3(modelMatrix) * aTan);\n167\t  float u = aUV.x;\n168\t  float s = aUV.y;\n169\t  float h = aAmp * (0.6 * sin(s * 0.9 - uTime * 2.4 + u * 1.7) + 0.4 * sin(s * 0.41 + uTime * 1.5 - u * 2.3));\n170\t  vec3 p = position + normal * h * (1.0 - aSkirt);\n171\t  vec4 wp = modelMatrix * vec4(p, 1.0);\n172\t  vPosW = wp.xyz;\n173\t  vNormalW = normalize(mat3(modelMatrix) * normal);\n174\t  vUV = aUV;\n175\t  vHalfW = aHalfW;\n176\t  vSpeed = aSpeed;\n177\t  vSkirt = aSkirt;\n178\t  // hand the stream over to the whirlpool surface during 03 (dithered fade both ways)\n179\t  float inside03 = smoothstep(uHide.x + 0.5, uHide.x + 3.5, s) * (1.0 - smoothstep(uHide.y - 9.0, uHide.y - 1.5, s));\n180\t  vHide = 1.0 - inside03;\n181\t  vec4 mvPosition = viewMatrix * wp;\n182\t  gl_Position = projectionMatrix * mvPosition;\n183\t  #include <fog_vertex>\n184\t}\n185\t`;\n186\t\n187\tconst FRAG = /* glsl */ `\n188\tuniform float uTime;\n189\tuniform vec3 uCyanDeep;\n190\tuniform vec3 uCyan;\n191\tuniform vec3 uCyanBright;\n192\tuniform vec3 uPinkDeep;\n193\tuniform vec3 uPink;\n194\tuniform vec3 uPinkLight;\n195\tuniform vec3 uFoam;\n196\tuniform vec3 uFoamLav;\n197\tuniform vec3 uHaze;\n198\tuniform vec3 uLightDir;\n199\tuniform vec3 uBenny;      // s, lateral (units), strength\n200\tuniform float uBennyR;    // Benny's waterline radius (units)\n201\tuniform vec3 uChevron;    // start s, spacing, enabled\n202\tuniform vec2 uOutro;      // amount, chamber start s\n203\t// 05 river palette (see RIVER05_PAL) + its one constant advection speed (no stage-speed shear)\n204\tuniform vec3 uC5Deep;\n205\tuniform vec3 uC5;\n206\tuniform vec3 uC5Bright;\n207\tuniform vec3 uC5Streak;\n208\tuniform vec3 uP5Deep;\n209\tuniform vec3 uP5;\n210\tuniform vec3 uP5Light;\n211\tuniform vec3 uP5Streak;\n212\tuniform float uFlow05;\n213\tvarying vec2 vUV;\n214\tvarying float vHalfW;\n215\tvarying float vSpeed;\n216\tvarying float vSkirt;\n217\tvarying float vHide;\n218\tvarying vec4 vStyle;\n219\tvarying float vCore;\n220\tvarying vec3 vTanW;\n221\tvarying vec3 vPosW;\n222\tvarying vec3 vNormalW;\n223\t#include <fog_pars_fragment>\n224\t${NOISE_GLSL}\n225\t${FRAG_FX_GLSL}\n226\t\n227\t// Stationary channel shape (refs 05–07): lateral offset (units) of the electric-cyan core centre\n228\t// relative to the course centreline. Two incommensurate sines + slow noise so the S-curves do not\n229\t// visibly repeat; λ≈26 u differs from the course's own 05 geometry meander (λ≈36 u), so the two beat\n230\t// rather than cancel. It only drifts slowly downstream (+s) at a constant rate (no shear between\n231\t// stage speeds); the strand texture below is what is advected at the local stage speed.\n232\tfloat meander(float s, float hw) {\n233\t  float a = s - uTime * 0.7;\n234\t  float m = 0.2 * sin(a * 0.24) + 0.08 * sin(a * 0.53 + 1.3) + 0.12 * (vnoise(vec2(a * 0.05, 4.7)) - 0.5);\n235\t  return m * min(hw, 4.5);\n236\t}\n237\t\n238\t// Combed flow lines (ref 05: thin bright streaks along the flow, 2–4 px apart in the mid-ground).\n239\t// Anti-aliased lines across the flow (K slots per unit), each broken into tapered streak segments of\n240\t// varying length/brightness. Line width is in PIXELS (≈1.2 px core + ≈2.5 px glow), so near the camera\n241\t// the slots spread apart into sparse crisp glints instead of wide parallel light stripes (the\n242\t// \"flattened stripes\" the user rejected); the lines fade once they get closer than ≈3 px.\n243\tfloat combed(float x, float v, float K, float seed) {\n244\t  float p = x * K;\n245\t  float id = floor(p);\n246\t  float fw = max(fwidth(p), 1e-4);            // slots per pixel\n247\t  float hs = hash12(vec2(id, seed));\n248\t  float dpx = abs(fract(p) - 0.5 - (hs - 0.5) * 0.5) / fw;   // pixels from the line centre\n249\t  float line = (1.0 - smoothstep(0.4, 1.3, dpx)) * 0.8 + exp(-dpx * 0.45) * 0.3;\n250\t  // each line breaks into tapered streak segments; sparser when the slots are far apart on screen\n251\t  float sparse = smoothstep(0.03, 0.006, fw);\n252\t  float seg = smoothstep(0.5 + 0.15 * sparse, 0.9, vnoise(vec2(id * 3.7 + seed, v * 0.2 + hs * 9.0)));\n253\t  return line * seg * (0.45 + 0.55 * hs) * (1.0 - smoothstep(0.22, 0.4, fw));\n254\t}\n255\t\n256\t// advected strand texture (\"combed\" glossy water lines parallel to the flow)\n257\t// x = lateral units relative to the meander centre, v = advected arc length, aa = 0..1 detail fade\n258\t// returns: x = height 0..1 (shading + bump), y = white glint lines, z = mid strands, w = fine strands\n259\t// sw = swirl (05): the strands wander laterally and are less stretched, so the water reads as\n260\t// curling glossy flow instead of uniform straight parallel stripes (the user's rejected look)\n261\tvec4 strands(float x, float v, vec2 aa, float sw) {\n262\t  x += sw * 0.9 * (vnoise(vec2(x * 0.45, v * 0.2 + 7.0)) - 0.5);\n263\t  float a = vnoise(vec2(x * 2.4, v * (0.08 + 0.1 * sw)));\n264\t  float b = vnoise(vec2(x * 7.0 + a * 1.6, v * 0.19 + 5.0));\n265\t  #ifdef LOW_Q\n266\t  float c = b;\n267\t  #else\n268\t  float c = vnoise(vec2(x * 17.0 + b * 2.2, v * 0.42 + 3.0));\n269\t  #endif\n270\t  b = mix(0.5, b, aa.x);\n271\t  c = mix(0.5, c, aa.y);\n272\t  float h = a * 0.42 + b * 0.34 + c * 0.24;\n273\t  h = smoothstep(0.18, 0.82, h);              // more contrast: deep azure troughs, bright crests\n274\t  float line = smoothstep(0.72, 0.86, c) * aa.y + smoothstep(0.7, 0.86, b) * aa.x * 0.85;\n275\t  // the combed lines follow the large-scale strand warp so they bend with the flow\n276\t  float xw = x + (a - 0.5) * 0.5;\n277\t  line = max(line, combed(xw, v, 6.0, 0.0) * 0.85);\n278\t  #ifndef LOW_Q\n279\t  line = max(line, combed(xw + (b - 0.5) * 0.12, v * 1.3, 15.0, 11.0) * 0.55);\n280\t  #endif\n281\t  return vec4(h, line, b, c);\n282\t}\n283\t\n284\t// 05 silk streaks: anti-aliased light lines along the FLOW coordinate q (band-relative, so they bend\n285\t// with the pink S-bands instead of running as straight parallel road stripes). Each line wanders\n286\t// slowly (wig, slot fraction) so neighbours braid, and breaks into advected tapered segments of\n287\t// varying brightness. Width in pixels; the lines fade once they crowd closer than ≈3 px.\n288\tfloat silk(float q, float v, float K, float seed, float wig) {\n289\t  float p = q * K;\n290\t  float fw = max(fwidth(p), 1e-4);\n291\t  float id = floor(p);\n292\t  float hs = hash12(vec2(id, seed));\n293\t  float c = 0.5 + (hs - 0.5) * 0.34 + wig * sin(v * (0.28 + 0.3 * hs) + hs * 6.283);\n294\t  float dpx = abs(fract(p) - c) / fw;\n295\t  float line = (1.0 - smoothstep(0.3, 1.2, dpx)) * 0.7 + exp(-dpx * 0.55) * 0.4;\n296\t  // short tapered brush dashes (≈1–2 u: ref 05 speed streaks are 30–80 px in the mid field)\n297\t  float n = vnoise(vec2(id * 3.1 + seed, v * 0.42 + hs * 17.0));\n298\t  float seg = smoothstep(0.5, 0.86, n);\n299\t  return line * seg * (0.5 + 0.7 * hs) * (1.0 - smoothstep(0.22, 0.42, fw));\n300\t}\n301\t\n302\tvoid main() {\n303\t  float u = vUV.x;\n304\t  float s = vUV.y;\n305\t  // dithered hide (03 hand-over)\n306\t  if (vHide < 0.5) discard;\n307\t  float cutFoam = 1.0 - smoothstep(0.5, 0.85, vHide);\n308\t  // 11 outro: the stream drains away in the chamber, leaving puddles\n309\t  if (uOutro.x > 0.0 && s > uOutro.y - 2.0) {\n310\t    float n = vnoise(vec2(u * 3.0, s * 0.35)) * 0.7 + 0.3;\n311\t    if (n < uOutro.x * 1.15) discard;\n312\t  }\n313\t\n314\t  // ---- channel layout: winding cyan core between two hot-pink S-bands, cyan again outside ----\n315\t  float hw = vHalfW;\n316\t  float lat = u * hw;                         // lateral units in the ribbon frame\n317\t  // core centre: free drifting meander on 04/06/07 (freeK = 1); on 05 (freeK = 0) pinned to the\n318\t  // course's own S-meander, amplified (vCore = CORE_SWING · offset05), so the coins stay on cyan\n319\t  float freeK = vStyle.w;\n320\t  float sw = 1.0 - freeK;                     // weight of the 05 river look (1 on 05 only)\n321\t  float M = meander(s, hw) * freeK + vCore;\n322\t  float x = lat - M;                          // lateral units in the core's frame\n323\t  // 05: the pink bands swing a further ±0.45 u about the core (a stationary λ≈20 u S on top of the\n324\t  // course meander), so they read as clear S-bends; the coins (at coreLateral = M) stay on cyan\n325\t  float sbend = sw * 0.45 * sin(s * 0.31 - 0.834);\n326\t  float xb = x - sbend;                       // band frame (== x on 04/06/07)\n327\t\n328\t  // detail fade with distance (cells per pixel), keeps far water from shimmering\n329\t  float fwx = fwidth(x);\n330\t  float fws = fwidth(s);\n331\t  // (a noise cell must stay ≳6–8 px wide; the combed lines of ref 05 are 2–4 px apart in the\n332\t  // mid-ground, so fading earlier than this flattens the water into a plain fill)\n333\t  vec2 aa = vec2(1.0 - smoothstep(0.12, 0.26, max(fwx * 7.0, fws * 0.19)),\n334\t                 1.0 - smoothstep(0.09, 0.2, max(fwx * 17.0, fws * 0.42)));\n335\t  // hair-fine combed strands for close-up water (refs: dense parallel flow lines)\n336\t  float aaH = 1.0 - smoothstep(0.14, 0.3, fwx * 46.0);\n337\t  #ifdef LOW_Q\n338\t  aa.y = 0.0;\n339\t  aaH = 0.0;\n340\t  #endif\n341\t\n342\t  // two-phase flow-map advection of the strands (period 4 s; offset scales with stage speed)\n343\t  float ph0 = fract(uTime * 0.25);\n344\t  float ph1 = fract(uTime * 0.25 + 0.5);\n345\t  float w0 = 1.0 - abs(1.0 - 2.0 * ph0);\n346\t  // (04/06/07 strand texture; 05 has its own silk/swell field below)\n347\t  vec4 F = vec4(0.5, 0.0, 0.5, 0.5);\n348\t  if (freeK > 0.001) F = mix(strands(x, s - vSpeed * ph1 * 4.0 + 23.0, aa, sw), strands(x, s - vSpeed * ph0 * 4.0, aa, sw), w0);\n349\t  float v5 = s - uTime * uFlow05;             // 05 advected arc length (one constant speed: no shear)\n350\t\n351\t  // Benny parts the bands like a bow wave (vStyle.x, ref 05): just ahead of him they narrow and\n352\t  // swing outward, so the water at and behind him (the near field) is pure cyan; behind him they\n353\t  // continue only as thin streaks pushed out toward the foam banks\n354\t  // (05: the near rows only show lat ±2.3 behind Benny, so a light parting is enough there)\n355\t  float gate = 1.0, part = 0.0, near05 = 1.0;\n356\t  float db = s - uBenny.x;\n357\t  if (vStyle.x > 0.0) {\n358\t    // 05 (wave 4): the bands stay wide (≥75 %) and run in CLOSER (0.8× offset) beside Benny, so they\n359\t    // sweep past both his sides like ref 05 (pink beside the hat/body at y≈800–1000) instead of\n360\t    // parting out under the foam banks; full width/offset ≈14–20 u ahead\n361\t    float g05 = 0.75 + 0.25 * smoothstep(1.0, 20.0, db);\n362\t    float gOld = 0.4 + 0.6 * smoothstep(0.0, 4.5, db);\n363\t    gate = mix(1.0, mix(g05, gOld, freeK), vStyle.x);\n364\t    part = vStyle.x * hw * 0.3 * freeK * (1.0 - smoothstep(-1.0, 9.0, db));\n365\t    near05 = mix(1.0, 0.8 + 0.2 * smoothstep(2.0, 14.0, db), sw * vStyle.x);\n366\t  }\n367\t  float hwc = min(hw, 4.5);\n368\t  float aaw = fwidth(lat) * 0.85 + 0.01;      // ≈1 px edges: no lavender cyan/pink blend zone\n369\t  // flowing band edges (the advected strand texture). 05: only a soft travelling ripple, so the band\n370\t  // edges are clean S-curves instead of the torn/jagged combed edges of the old slab\n371\t  float pert = mix((vnoise(vec2(x * 0.9, v5 * 0.12 + 3.0)) - 0.5) * 0.3,\n372\t                   (F.z - 0.5) * 0.5 + (F.w - 0.5) * 0.22, freeK) * hwc * 0.22;\n373\t  // 05: the band shapes are carried downstream (a slow travelling wobble), so the pink S-sections\n374\t  // visibly flow and swirl even though the channel itself is fixed to the course meander\n375\t  float tv = s - uTime * vSpeed * 0.3;\n376\t  float wob = sw * hwc;\n377\t  float offL = hw * (vStyle.y * near05 + mix(0.03, 0.07, freeK) * sin(s * 0.13 + 1.7)) + part + wob * 0.05 * sin(tv * 0.42 + 1.1);\n378\t  float offR = hw * (vStyle.y * near05 + mix(0.03, 0.07, freeK) * sin(s * 0.11 + 4.2)) + part + wob * 0.05 * sin(tv * 0.37 + 3.9);\n379\t  float modA = mix(0.15, 0.4, freeK);         // 05: even band width (the ±40 % swell drew the slab)\n380\t  float wL = hw * vStyle.z * (1.0 + modA * sin(s * 0.19 + 0.4) + 0.08 * wob * sin(tv * 0.6)) * gate;\n381\t  float wR = hw * vStyle.z * (1.0 + modA * sin(s * 0.17 + 2.9) + 0.08 * wob * sin(tv * 0.55 + 2.0)) * gate;\n382\t  if (freeK < 0.5) {\n383\t    // keep both bands inside the water (the core swing pushes one toward the bank on each bend)\n384\t    float Mb = M + sbend;\n385\t    offL = min(offL, Mb + hw - wL - 0.5);\n386\t    offR = min(offR, hw - wR - 0.5 - Mb);\n387\t  }\n388\t  float sdL = xb + offL + pert;\n389\t  float sdR = xb - offR + pert;\n390\t  float dL = abs(sdL);\n391\t  float dR = abs(sdR);\n392\t  float on = smoothstep(0.02, 0.2, gate);\n393\t  float pL = (1.0 - smoothstep(wL - aaw, wL + aaw, dL)) * on;\n394\t  float pR = (1.0 - smoothstep(wR - aaw, wR + aaw, dR)) * on;\n395\t  // a thin cyan thread splits a band into two streaks along some stretches (ref 05 mid-ground)\n396\t  float rimW = 0.05 * hwc + aaw;\n397\t  float thrW = 0.028 * hwc;\n398\t  float splitOn = smoothstep(0.55, 0.7, vnoise(vec2(s * 0.07, 13.0))) * mix(0.0, 1.0, freeK);\n399\t  float sL = (1.0 - smoothstep(thrW, thrW + aaw, abs(xb + offL + pert * 1.4 + 0.25 * wL * sin(s * 0.5)))) * splitOn;\n400\t  float sR = (1.0 - smoothstep(thrW, thrW + aaw, abs(xb - offR + pert * 1.4 - 0.25 * wR * sin(s * 0.45 + 1.0)))) * (1.0 - splitOn) * freeK;\n401\t  // only split bands that are wide enough (smooth ramp: a hard step cut the band across the flow)\n402\t  pL *= 1.0 - sL * smoothstep(rimW * 1.8, rimW * 2.8, wL);\n403\t  pR *= 1.0 - sR * smoothstep(rimW * 1.8, rimW * 2.8, wR);\n404\t  // hair-thin pink filaments drifting through the cyan core (mid/far field only)\n405\t  float fil = 0.0;\n406\t  #ifndef LOW_Q\n407\t  float fc = hw * 0.18 * sin(s * 0.21 + 0.8);\n408\t  fil = (1.0 - smoothstep(0.025 * hwc, 0.025 * hwc + aaw, abs(x - fc + pert * 0.7)))\n409\t      * smoothstep(0.62, 0.78, vnoise(vec2(s * 0.09, 21.0))) * gate * aa.x * freeK;   // 05 core: pure cyan\n410\t  #endif\n411\t  float pinkM = max(max(pL, pR), fil);\n412\t  // 05: the parted bands close in behind Benny as two thin hot-pink wake trails (ref 05 near rows:\n413\t  // pink sweeps at both sides of the spray fan, ≈1 u out from his track, gone again by ≈2 u back)\n414\t  float trail = 0.0, relT = 0.0;\n415\t  if (sw > 0.001 && uBenny.z > 0.0 && vStyle.x > 0.0) {\n416\t    float back = -db;\n417\t    // curved sweep: leaves his flank steeply, then bends back along the flow\n418\t    float tc = 0.5 + 1.0 * (1.0 - exp(-max(back - 0.45, 0.0) * 1.5));\n419\t    float tw = 0.09 + 0.08 * smoothstep(0.5, 1.6, back);\n420\t    float dT = abs(lat - uBenny.y) - tc + 0.04 * sin(v5 * 3.0 + lat);\n421\t    relT = dT / tw;\n422\t    // crisp ≈1 px edge (a feathered pink-over-blue edge reads as violet, the \"muddy purple\" to avoid);\n423\t    // the sweep instead narrows to nothing at both ends\n424\t    float taper = smoothstep(0.4, 0.85, back) * (1.0 - smoothstep(1.2, 1.85, back));\n425\t    float twt = tw * (0.25 + 0.75 * taper);\n426\t    trail = (1.0 - smoothstep(twt - aaw, twt + aaw, abs(dT))) * step(0.02, taper) * uBenny.z * sw * vStyle.x;\n427\t    relT = dT / max(twt, 1e-3);\n428\t    pinkM = max(pinkM, trail);\n429\t  }\n430\t  // glossy rims: light-pink just inside each band edge, bright cyan just outside it\n431\t  float rimIn = max(pL * smoothstep(wL - rimW, wL - aaw, dL), pR * smoothstep(wR - rimW, wR - aaw, dR));\n432\t  float rimOut = max((1.0 - pL) * (1.0 - smoothstep(wL + aaw, wL + rimW * 1.6, dL)),\n433\t                     (1.0 - pR) * (1.0 - smoothstep(wR + aaw, wR + rimW * 1.6, dR))) * on;\n434\t  float rel = pL >= pR ? sdL / max(wL, 1e-3) : -sdR / max(wR, 1e-3);   // -1 outer edge .. +1 core side\n435\t  vec3 N0 = normalize(vNormalW);\n436\t  if (!gl_FrontFacing) N0 = -N0;\n437\t  vec3 V = normalize(cameraPosition - vPosW);\n438\t  vec3 L = normalize(uLightDir);\n439\t  vec3 Hv = normalize(L + V);\n440\t  vec3 Lg = normalize(vTanW + N0 * 0.1);      // the bright tunnel end, far downstream\n441\t\n442\t  vec3 col = vec3(0.0);\n443\t  // =============== 04 / 06 / 07 surface (freeK = 1; unchanged look) ===============\n444\t  if (freeK > 0.001) {\n445\t    float h = F.x;\n446\t    float hair = 0.5;\n447\t    if (aaH > 0.0) {\n448\t      float sv = s - vSpeed * fract(uTime * 0.5) * 2.0;\n449\t      float hA = vnoise(vec2(x * 46.0 + F.w * 3.0, sv * 0.9));\n450\t      float hB = vnoise(vec2(x * 46.0 + F.w * 3.0, (sv + vSpeed) * 0.9 + 17.0));\n451\t      hair = mix(0.5, mix(hB, hA, 1.0 - abs(1.0 - 2.0 * fract(uTime * 0.5))), aaH);\n452\t    }\n453\t    // deep azure troughs → electric cyan → light-cyan crests (crests stay a minority of the area)\n454\t    vec3 cyanCol = mix(uCyanDeep, uCyan, smoothstep(mix(0.3, 0.22, freeK), mix(0.72, 0.62, freeK), h));\n455\t    cyanCol = mix(cyanCol, uCyanBright, smoothstep(mix(0.7, 0.64, freeK), 0.95, h) * mix(0.55, 0.7, freeK) + rimOut * 0.45);\n456\t    // satin ribbon: a soft light streak runs along each band, off-centre toward the core\n457\t    float satin = exp(-pow((rel - 0.3) * 2.2, 2.0));\n458\t    vec3 pinkCol = mix(uPinkDeep, uPink, smoothstep(0.3, 0.72, h + satin * 0.2));\n459\t    pinkCol = mix(pinkCol, uPinkLight, clamp(smoothstep(0.6, 0.92, h) * 0.7 + satin * 0.35 + rimIn * 0.45, 0.0, 1.0));\n460\t    col = mix(cyanCol, pinkCol, pinkM);\n461\t    col *= 0.88 + 0.24 * hair;\n462\t    vec3 streakCol = mix(vec3(0.6, 1.25, 1.6), vec3(1.6, 0.8, 1.6), pinkM);\n463\t    col += streakCol * smoothstep(0.82, 0.94, hair) * 0.3 * aaH;\n464\t\n465\t    // ---- glossy lighting ----\n466\t    #ifdef LOW_Q\n467\t    vec3 N = normalize(N0 + 0.25 * vec3(h - 0.5, 0.0, F.z - 0.5));\n468\t    #else\n469\t    float bumpAmt = 0.07 * (1.0 - smoothstep(0.1, 0.5, fws));\n470\t    vec3 N = bumpNormal(vPosW, N0, h * bumpAmt);\n471\t    #endif\n472\t    float nv = clamp(dot(N, V), 0.0, 1.0);\n473\t    float fres = pow(1.0 - nv, 4.0);\n474\t    vec3 R = reflect(-V, N);\n475\t    // tinted (not white) reflection so the glossy far water stays saturated, not pastel\n476\t    vec3 reflTint = mix(uCyanBright, uPinkLight, pinkM);\n477\t    vec3 refl = mix(reflTint, vec3(1.5), smoothstep(0.6, 1.0, R.y) * 0.5);\n478\t    col = mix(col, refl, fres * 0.22);\n479\t    float spec = pow(clamp(dot(N, Hv), 0.0, 1.0), 120.0);\n480\t    float sheen = pow(clamp(dot(R, L), 0.0, 1.0), 10.0);\n481\t    col += vec3(1.0) * spec * 1.2 + reflTint * sheen * 0.12;\n482\t    // glossy white-blue reflection of the bright tunnel end (refs 05–07): the light sits far\n483\t    // downstream, so its mirror image is a glitter path along the river toward the VP, broken into\n484\t    // streaks by the bump normals and the strand crests (never a flat milky sheet)\n485\t    float glit = pow(clamp(dot(R, Lg), 0.0, 1.0), 160.0);\n486\t    float glitMask = smoothstep(0.5, 0.88, h) * 0.75 + F.y * 0.6;\n487\t    col += mix(vec3(0.7, 1.1, 1.45), vec3(1.5, 0.85, 1.4), pinkM) * glit * glitMask * mix(0.9, 0.45, freeK);\n488\t    // advected glossy streak lines along the flow\n489\t    col += streakCol * F.y * 0.8;\n490\t\n491\t    // ---- foreground ripple crests: pixel-thin lines bowed upstream around the core, in short\n492\t    // segments, so the near water reads as moving glossy ripples, not soft horizontal bars\n493\t    float nearK = 1.0 - smoothstep(0.02, 0.05, fws);\n494\t    if (nearK > 0.0) {\n495\t      float ph = s * 4.2 - uTime * 6.0 + 0.2 * x * x + 1.6 * vnoise(vec2(lat * 0.7, s * 0.45));\n496\t      float q = fract(ph * 0.159155 - 0.25) - 0.5;              // 0 on a crest (sin = 1)\n497\t      float dpx = abs(q) / max(fwidth(ph * 0.159155), 1e-4);\n498\t      float crest = (1.0 - smoothstep(0.5, 1.8, dpx)) * smoothstep(0.52, 0.8, vnoise(vec2(lat * 2.6, s * 1.1 + 3.0)));\n499\t      col *= 1.0 - 0.14 * nearK * (0.5 - 0.5 * sin(ph));\n500\t      col += mix(vec3(0.9, 1.4, 1.7), vec3(1.7, 1.1, 1.7), pinkM) * crest * nearK * mix(0.9, 0.6, freeK);\n501\t    }\n502\t\n503\t    // ---- white star glints (4-point, twinkling, carried by the flow) ----\n504\t    #ifdef LOW_Q\n505\t    vec2 g = vec2(lat * 1.2, (s - vSpeed * uTime * 0.6) * 0.8);\n506\t    float hs = hash12(floor(g));\n507\t    float sparkle = step(0.9, hs) * smoothstep(0.22, 0.0, length(fract(g) - 0.5)) * (0.5 + 0.5 * sin(uTime * 7.0 + hs * 40.0));\n508\t    col += vec3(1.3) * sparkle;\n509\t    #else\n510\t    // wide cells so the long horizontal arms are not clipped at the cell border in the mid-ground\n511\t    float glint = starGlint(vec2(lat * 0.55, (s - vSpeed * uTime * 0.55) * 0.42), 0.42, 22.0, 2.4, uTime);\n512\t    col += vec3(2.0, 2.2, 2.3) * glint * (1.0 - smoothstep(0.3, 0.8, fws));\n513\t    #endif\n514\t  }\n515\t\n516\t  // =============== 05: thick glossy river (sw = 1) ===============\n517\t  // The user rejected the 05 water as \"a flat blue road with straight stripes\". Here the surface is a\n518\t  // flow-aligned height field: every streak, ridge and flare is laid out in the flow coordinate q\n519\t  // (-1 on the left band's centre line, +1 on the right one), so they bend with the pink S-bands.\n520\t  // Depth comes from deep-azure troughs between bright crests, tubular pink ribbons (deep magenta\n521\t  // edges → hot pink → light satin crest), Fresnel sky tint, sun specular, the tunnel-end glitter\n522\t  // path and bump normals from the same height field; the near field (right behind Benny, where\n523\t  // 1 u ≈ 250 px) swaps the along-flow ridges for bowed cross-flow ripple crests and horizontal flares.\n524\t  if (sw > 0.001) {\n525\t    float cLc = -offL - pert, cRc = offR - pert;\n526\t    float hS = max(0.5 * (cRc - cLc), 0.6);\n527\t    float q = (xb - 0.5 * (cLc + cRc)) / hS;\n528\t    float near5 = 1.0 - smoothstep(0.0075, 0.014, fws);\n529\t    float wq = q + 0.05 * sin(v5 * 0.23 + q * 4.0);           // slow braid of the flow lines\n530\t    // height: braided swell ridges along the flow (mid/far), ripple cells (near), silk lines on top\n531\t    float rFar = vnoise(vec2(wq * 7.0, v5 * 0.2));\n532\t    float rNear = vnoise(vec2(lat * 2.2 + 0.5 * sin(v5 * 1.1), v5 * 1.3 + 9.0));\n533\t    float swell = mix(rFar, rNear, near5);\n534\t    swell = mix(0.5, swell, 1.0 - smoothstep(0.3, 0.7, fwidth(wq * 7.0)));\n535\t    float silkA = silk(wq, v5, 15.0, 0.0, 0.16);\n536\t    float silkB = 0.0;\n537\t    #ifndef LOW_Q\n538\t    silkB = silk(wq, v5 * 1.35 + 40.0, 38.0, 7.0, 0.1);\n539\t    #endif\n540\t    float silkL = max(silkA, silkB * mix(0.45, 0.8, pinkM)) * (1.0 - near5);\n541\t    float H5 = clamp(swell * 0.8 + silkL * 0.35 + 0.2 * near5, 0.0, 1.0);\n542\t\n543\t    // cyan: deep azure troughs -> electric cyan -> bright cyan crests; light seam beside each band\n544\t    vec3 cy = mix(uC5Deep, uC5, smoothstep(0.26, 0.74, H5));\n545\t    cy = mix(cy, uC5Bright, clamp(smoothstep(0.76, 0.98, H5) * 0.6 + rimOut * 0.55, 0.0, 1.0));\n546\t    // pink: tubular ribbons (deep magenta edges -> hot pink -> light satin crest off-centre)\n547\t    float relB = trail > max(pL, pR) ? relT : rel;\n548\t    float prof = 1.0 - relB * relB;\n549\t    float satin5 = exp(-pow((relB - 0.3) * 3.2, 2.0));\n550\t    vec3 pk = mix(uP5Deep, uP5, smoothstep(0.0, 0.6, prof) * (0.62 + 0.55 * H5));\n551\t    pk = mix(pk, uP5Light, clamp(satin5 * 0.4 + smoothstep(0.78, 0.98, H5) * 0.25 + rimIn * 0.35, 0.0, 1.0));\n552\t    // glossy crest line along each ribbon (its brightest silk, toward the core side)\n553\t    pk = mix(pk, uP5Streak, exp(-pow((relB - 0.42) * 9.0, 2.0)) * 0.55 * smoothstep(0.35, 0.65, swell));\n554\t    vec3 c5 = mix(cy, pk, pinkM);\n555\t    // silk streak light: light cyan-white on cyan, light pink on pink (the ribbons are combed silk);\n556\t    // the strongest dashes burn to near-white (ref 05 streak heads)\n557\t    c5 = mix(c5, mix(uC5Streak, uP5Streak, pinkM), clamp(silkL * mix(0.9, 1.05, pinkM), 0.0, 1.0));\n558\t    c5 += vec3(0.9, 1.0, 1.1) * smoothstep(0.75, 1.1, silkA) * 0.6;\n559\t\n560\t    // glossy lighting from the same height field\n561\t    #ifdef LOW_Q\n562\t    vec3 N5 = normalize(N0 + 0.3 * vec3(H5 - 0.5, 0.0, swell - 0.5));\n563\t    #else\n564\t    vec3 N5 = bumpNormal(vPosW, N0, H5 * 0.09 * (1.0 - smoothstep(0.1, 0.5, fws)));\n565\t    #endif\n566\t    float nv5 = clamp(dot(N5, V), 0.0, 1.0);\n567\t    vec3 R5 = reflect(-V, N5);\n568\t    c5 = mix(c5, mix(uC5Bright, uP5Light, pinkM), pow(1.0 - nv5, 3.0) * mix(0.1, 0.16, pinkM));\n569\t    c5 += vec3(1.0) * pow(clamp(dot(N5, Hv), 0.0, 1.0), 90.0) * 1.1;\n570\t    float gl5 = pow(clamp(dot(R5, Lg), 0.0, 1.0), 90.0);\n571\t    c5 += mix(vec3(0.6, 1.2, 1.6), vec3(1.4, 0.7, 1.3), pinkM) * gl5 * (smoothstep(0.6, 0.92, H5) * 0.6 + silkL * 0.7);\n572\t\n573\t    // near field (right behind Benny, 1 u ≈ 250 px):