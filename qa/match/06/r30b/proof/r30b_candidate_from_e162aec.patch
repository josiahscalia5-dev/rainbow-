+  float rim = (1.0 - smoothstep(-aa, aa, abs(d - 0.045) - 0.03)) * (1.0 - far);
+  vec3 cs = mix(c, hole, cov) + vec3(1.0, 0.75, 0.98) * 0.30 * rim * smoothstep(-0.02, 0.06, p.y) - vec3(0.12, 0.05, 0.10) * rim * smoothstep(0.02, -0.06, p.y);
