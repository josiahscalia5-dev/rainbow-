from pathlib import Path
import hashlib,json,subprocess
v=Path.cwd();common='/tmp/rainbow-visual-audit.X0POSzUq/objects.git';heads=json.load(open('heads.json'))
def git_blob(data):
 return hashlib.sha1(b'blob '+str(len(data)).encode()+b'\0'+data).hexdigest()
def git(cmd):
 return subprocess.check_output(['git','--git-dir='+common,*cmd])
for sid in ('04','05','06','07','08'):
 base=heads[sid]['commit']
 root=v/'games'/sid;owned=set(json.load(open('base-'+sid+'.json'))['paths'])
 paths=['src','assets','public','references','character_references','index.html','package-lock.json','package.json','tsconfig.json','vite.config.ts','scripts/gameplay-test.mjs']
 tree={p.decode():pre.split()[2].decode() for record in git(['ls-tree','-r','-z',base,'--',*paths]).split(b'\0') if record for pre,p in [record.split(b'\t',1)]}
 present=0;diff=[];missing=[]
 for name,oid in tree.items():
  f=root/name
  if not f.is_file():missing.append(name);continue
  raw=f.read_bytes();sha=git_blob(raw)
  if name in owned:continue
  if sha!=oid:
   ptr=(f'version https://git-lfs.github.com/spec/v1\noid sha256:{hashlib.sha256(raw).hexdigest()}\nsize {len(raw)}\n').encode()
   if git_blob(ptr)!=oid:diff.append(name)
  present+=1
 man=git(['cat-file','blob',base+':scripts/reference.sha256']).decode()
 relative={}
 for row in man.splitlines():
  if row.strip():
   rhs,f=row.split(maxsplit=1); f=f.strip().lstrip('*');assert hashlib.sha256((root/f).read_bytes()).hexdigest()==rhs
   relative[f]=rhs
 data={'sourceCommit':base,'verifiedReferenceHashes':relative,'runtimeFilesChecked':present,'differentFromBaseOutsideExperiment':diff,'trackedFilesOutsideDisposableCopy':missing}
 (v/('source-check-'+sid+'.json')).write_text(json.dumps(data,indent=2)+'\n')
 print(sid,present,len(relative),'different',len(diff),diff[:5],'omitted',len(missing),missing[:4],flush=True)
