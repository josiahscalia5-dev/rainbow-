{"agentId": "aaef40383ee292ad9", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "claude/rainbow-restore-env-setup-bxn85h", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Screen 05 FULL REFERENCE MATCH — Benny (`?benny05=1`, or the master `?match05=1`; qa/pilot05/full_reference_match/benny/).\n3\t *\n4\t * Applied to Benny HIMSELF (every screen sees the same corrected character while the switch is on), on top of the\n5\t * unchanged canonical assets/models/benny.glb, rig and clips. Off (default): nothing in this file runs, every material,\n6\t * geometry and shader program is the previous one.\n7\t *\n8\t *  1. Beanie geometry (visual only, hat-local): cuff band thinner and the whole beanie a little lower on the head, pom-pom\n9\t *     lower and slightly toward his right, star re-seated — measured against the approved picture at the locked 05 frame.\n10\t *  2. Swim-clip body roll damped (the clip's ±0.05 rad side wobble tipped the beanie ~13 px sideways at the pom; the\n11\t *     approved Benny rides upright). Pitch bob, paddling, feet, steering lean and every gameplay transform are unchanged.\n12\t *  3. Albedo maps baked from the APPROVED pixels into each part's own UV space (tools: benny/work/bake.py): the beanie's\n13\t *     knit stitches / stripes / ribbed cuff, the pom-pom yarn, the cotton-candy fur colour and its shading. The maps are\n14\t *     solved through the live lighting and post chain (two calibration renders: display → linear radiance = albedo·E + S),\n15\t *     so the screen shows the approved colours at the locked frame and they stay glued to the 3D surfaces while he moves.\n16\t *     Texels the 05 camera never sees (his front, the cuff's far side) are filled from the seen knit / fur.\n17\t *  4. Finer, denser, more clumped shell fur (soft tufts instead of coarse straight spikes).\n18\t */\n19\timport * as THREE from 'three';\n20\timport { on05 } from '../../vfx/waterRibbon';\n21\timport type { FurHandle, FurParams } from './fur';\n22\t\n23\texport const BENNY05: boolean = on05('benny05');\n24\t\n25\t/** shell-fur overrides (merged over the GLB's userData.fur) */\n26\texport const FUR05: Record<string, Partial<FurParams>> = {\n27\t  fur_body: { density: 96, shells: 24, length: 0.11, gravity: 0.16 },\n28\t  fur_armL: { density: 120, shells: 12, length: 0.05 },\n29\t  fur_armR: { density: 120, shells: 12, length: 0.05 },\n30\t  fur_pom: { density: 64, shells: 18, length: 0.12, gravity: 0.03 },\n31\t};\n32\t/** strand clumping toward tuft centres (fur.ts default 0.42) */\n33\tconst CLUMP05: Record<string, number> = { fur_body: 0.55, fur_pom: 0.6 };\n34\t\n35\t/** beanie geometry (hat-local units; GLB build: brimBottom 0.22, cuffH 0.265, pom 0.12 above the crown apex) */\n36\texport const HAT05 = {\n37\t  /** whole beanie lowered along the body's up axis */\n38\t  drop: 0.028,\n39\t  /** whole beanie shifted toward his right (−X): the approved beanie sits ≈5 px further image-right on the body */\n40\t  shiftX: -0.028,\n41\t  /** extra backward tilt of the beanie (rad, about X; − = top toward his back) */\n42\t  tilt: 0,\n43\t  /** crown dome shoulder taper (GLB build 0.18: r ∝ (1 − taper·t)); the approved dome is fuller near the top */\n44\t  crownTaper: 0.0,\n45\t  /** folded cuff band height */\n46\t  cuffH: 0.226,\n47\t  /** pom-pom core: extra offset (x = toward his LEFT, + y up) and scale */\n48\t  pomDX: -0.057,\n49\t  pomDY: -0.016,\n50\t  /** toward his back (−Z ≈ toward the rear chase camera): the approved pom-pom overhangs the crown's back slope */\n51\t  pomDZ: -0.16,\n52\t  pomScale: 0.97,\n53\t  /** star: extra offset in hat-local units after following the cuff top */\n54\t  starDY: 0.069,\n55\t  starDX: 0.0,\n56\t  /** star face scale (its own x, y) */\n57\t  starScale: [0.96, 0.89] as [number, number],\n58\t  /** cuff outer radius factor (approved cuff ≈ 297 px wide vs 291) */\n59\t  brimW: 1.0,\n60\t  /** crown dome height (GLB 0.53) */\n61\t  crownH: 0.58,\n62\t};\n63\t\n64\t/** swim clip: factor on the body's side roll (z) */\n65\texport const ROLL05 = 0.3;\n66\t\n67\tconst D = { skin: 0.7, brimBottom: 0.22, cuffH: 0.265, brimR: 0.8, crownH: 0.53 };\n68\t\n69\tfunction lathe(points: [number, number][], segs: number, v0: number, v1: number): THREE.LatheGeometry {\n70\t  const g = new THREE.LatheGeometry(points.map(([r, y]) => new THREE.Vector2(r, y)), segs);\n71\t  const p = g.attributes.position as THREE.BufferAttribute;\n72\t  const uv = g.attributes.uv as THREE.BufferAttribute;\n73\t  for (let i = 0; i < p.count; i++) uv.setXY(i, uv.getX(i), (p.getY(i) - v0) / (v1 - v0));\n74\t  return g;\n75\t}\n76\t\n77\t/** the GLB's beanie profiles (build.ts) with the HAT05 cuff height; u = once around (+Z front = 0, back = 0.5) */\n78\tfunction hatGeometries(cuffH: number, taper: number, crownH: number): { brim: THREE.BufferGeometry; crown: THREE.BufferGeometry; yt: number; crownTop: number } {\n79\t  const yb = D.brimBottom;\n80\t  const yt = yb + cuffH;\n81\t  const bk = D.brimR / 0.778;\n82\t  const bw = bk * HAT05.brimW;\n83\t  const lip = Math.sqrt(D.skin * D.skin - yb * yb) + 0.012;\n84\t  const brim = lathe(\n85\t    [\n86\t      [lip, yb + 0.01],\n87\t      [0.725 * bw, yb - 0.008],\n88\t      [0.758 * bw, yb + 0.02],\n89\t      [0.776 * bw, yb + 0.07],\n90\t      [0.781 * bw, yb + 0.5 * cuffH],\n91\t      // fuller rolled top edge (approved: the cuff's upper corners stand higher at the sides)\n92\t      [0.781 * bw, yt - 0.06],\n93\t      [0.772 * bw, yt - 0.022],\n94\t      [0.745 * bw, yt - 0.004],\n95\t      [0.69 * bk, yt],\n96\t    ],\n97\t    96,\n98\t    yb - 0.01,\n99\t    yt + 0.005,\n100\t  );\n101\t  const crownY0 = yt - 0.045;\n102\t  const R0 = 0.705 * bk;\n103\t  const prof: [number, number][] = [];\n104\t  for (const t of [0, 0.08, 0.16, 0.25, 0.34, 0.43, 0.52, 0.6, 0.68, 0.75, 0.81, 0.86, 0.9, 0.935, 0.96, 0.98, 0.993, 1]) {\n105\t    prof.push([R0 * Math.sqrt(Math.max(0, 1 - t * t)) * (1 - taper * t), crownY0 + t * crownH]);\n106\t  }\n107\t  const crown = lathe(prof, 96, crownY0, crownY0 + crownH);\n108\t  return { brim, crown, yt, crownTop: crownY0 + crownH };\n109\t}\n110\t\n111\t/** a copy of the swim clip whose body side roll is scaled by ROLL05 (the cached GLB clips stay untouched) */\n112\texport function dampedClips(clips: THREE.AnimationClip[]): THREE.AnimationClip[] {\n113\t  return clips.map((c) => {\n114\t    if (c.name !== 'swim') return c;\n115\t    const k = c.clone();\n116\t    for (const t of k.tracks) {\n117\t      if (t.name !== 'body.quaternion') continue;\n118\t      const q = new THREE.Quaternion(), e = new THREE.Euler();\n119\t      for (let i = 0; i < t.values.length; i += 4) {\n120\t        q.fromArray(t.values, i);\n121\t        e.setFromQuaternion(q, 'XYZ');\n122\t        e.z *= ROLL05;\n123\t        q.setFromEuler(e).toArray(t.values, i);\n124\t      }\n125\t    }\n126\t    return k;\n127\t  });\n128\t}\n129\t\n130\t// ------------------------------------------------------------------ baked maps\n131\tconst T = (f: string) => new URL(`../../../assets/textures/benny05/${f}`, import.meta.url).href;\n132\t/** part → baked albedo (sRGB PNG) + colour factor (the map stores albedo / factor so it fits 0..1) + optional normal map */\n133\texport const MAPS05: Record<string, { map: string; scale: number; normal?: string; normalScale?: number }> = {\n134\t  fur_body: { map: 'body.png', scale: 1 },\n135\t  fur_armL: { map: 'armL.png', scale: 1 },\n136\t  fur_armR: { map: 'armR.png', scale: 1 },\n137\t  fur_pom: { map: 'pom.png', scale: 1 },\n138\t  hat_crown: { map: 'crown.png', scale: 1, normal: 'crown_n.png', normalScale: 0.8 },\n139\t  hat_brim: { map: 'brim.png', scale: 1, normal: 'brim_n.png', normalScale: 0.8 },\n140\t};\n141\t/** star: solved base colour (linear) */\n142\texport const STAR05 = { color: [1, 0.62, 0.03] as [number, number, number] };\n143\t\n144\tlet loaded: Promise<Record<string, THREE.Texture | null>> | null = null;\n145\t/** load every baked map once (missing files → null: that part keeps its GLB look) */\n146\texport function loadBenny05Maps(): Promise<Record<string, THREE.Texture | null>> {\n147\t  if (loaded) return loaded;\n148\t  const files = new Set<string>();\n149\t  for (const m of Object.values(MAPS05)) { files.add(m.map); if (m.normal) files.add(m.normal); }\n150\t  const tl = new THREE.TextureLoader();\n151\t  loaded = Promise.all(\n152\t    [...files].map(async (f) => {\n153\t      try {\n154\t        const t = await tl.loadAsync(T(f));\n155\t        t.colorSpace = f.endsWith('_n.png') ? THREE.NoColorSpace : THREE.SRGBColorSpace;\n156\t        t.wrapS = THREE.RepeatWrapping;\n157\t        t.anisotropy = 4;\n158\t        t.needsUpdate = true;\n159\t        return [f, t] as const;\n160\t      } catch {\n161\t        console.warn('[benny05] missing baked map', f);\n162\t        return [f, null] as const;\n163\t      }\n164\t    }),\n165\t  ).then((e) => Object.fromEntries(e));\n166\t  return loaded;\n167\t}\n168\t\n169\tconst PART_ID: [RegExp, number][] = [\n170\t  [/^fur_body/, 1], [/^hat_crown/, 2], [/^hat_brim/, 3], [/^fur_pom/, 4], [/^hat_star/, 5],\n171\t  [/^fur_armL/, 6], [/^fur_armR/, 7], [/^fur_footL/, 8], [/^fur_footR/, 9],\n172\t];\n173\tconst partId = (n: string) => PART_ID.find(([re]) => re.test(n))?.[1] ?? 10;\n174\t\n175\texport interface Benny05Handle {\n176\t  /** QA: render Benny's (u, v, part id, shell layer) into a float target; returns base64 Float32 RGBA of rect */\n177\t  uvPass(renderer: THREE.WebGLRenderer, world: THREE.Scene, camera: THREE.Camera, rect: [number, number, number, number]): string;\n178\t  /** QA: constant linear albedo k on every baked part (+ star), or null = back to the baked maps */\n179\t  calib(k: number | null): void;\n180\t}\n181\t\n182\t/**\n183\t * Apply the corrected look to a freshly cloned Benny scene (after the fur upgrade). `maps` from loadBenny05Maps().\n184\t */\n185\texport function applyBenny05(scene: THREE.Object3D, furs: FurHandle[], maps: Record<string, THREE.Texture | null>): Benny05Handle {\n186\t  const get = (n: string) => scene.getObjectByName(n);\n187\t  // ---- beanie geometry ----\n188\t  const hat = get('hat')!;\n189\t  hat.position.y -= HAT05.drop;\n190\t  hat.position.x += HAT05.shiftX;\n191\t  hat.rotation.x += HAT05.tilt;\n192\t  const g = hatGeometries(HAT05.cuffH, HAT05.crownTaper, HAT05.crownH);\n193\t  const brim = get('hat_brim') as THREE.Mesh;\n194\t  const crown = get('hat_crown') as THREE.Mesh;\n195\t  brim.geometry = g.brim;\n196\t  crown.geometry = g.crown;\n197\t  const dCuff = HAT05.cuffH - D.cuffH;\n198\t  const star = get('hat_star') as THREE.Mesh;\n199\t  star.position.y += dCuff + HAT05.starDY;\n200\t  star.position.x += HAT05.starDX;\n201\t  star.scale.set(HAT05.starScale[0], HAT05.starScale[1], 1);\n202\t  const pom = get('pom')!;\n203\t  pom.position.y += dCuff + (HAT05.crownH - D.crownH) + HAT05.pomDY;\n204\t  pom.position.x += HAT05.pomDX;\n205\t  pom.position.z += HAT05.pomDZ;\n206\t  pom.scale.setScalar(HAT05.pomScale);\n207\t\n208\t  // ---- fur clumping ----\n209\t  for (const f of furs) {\n210\t    const c = CLUMP05[f.mesh.name];\n211\t    if (c !== undefined) f.uniforms.uClump.value = c;\n212\t  }\n213\t\n214\t  // ---- materials (own copies: the cached GLB materials are shared by every clone) ----\n215\t  const white = new THREE.DataTexture(new Uint8Array([255, 255, 255, 255]), 1, 1);\n216\t  white.needsUpdate = true;\n217\t  type St = { mesh: THREE.Mesh; mat: THREE.MeshStandardMaterial; map: THREE.Texture | null; color: THREE.Color; fur?: FurHandle; root?: THREE.Color; tip?: THREE.Color };\n218\t  const baked: St[] = [];\n219\t  scene.traverse((o) => {\n220\t    const m = o as THREE.Mesh;\n221\t    if (!m.isMesh) return;\n222\t    const spec = MAPS05[m.name];\n223\t    if (!spec) return;\n224\t    const fur = furs.find((f) => f.mesh === m);\n225\t    const mat = fur ? fur.material : (m.material as THREE.MeshStandardMaterial).clone();\n226\t    if (!fur) m.material = mat;\n227\t    const tex = maps[spec.map];\n228\t    if (fur) {\n229\t      const d = mat.defines ?? (mat.defines = {});\n230\t      d.BENNY05 = '';\n231\t    }\n232\t    if (tex) {\n233\t      if (fur) {\n234\t        // root → tip shading only as a relative factor on the baked colour\n235\t        fur.uniforms.uRoot.value.setRGB(0.86, 0.86, 0.86);\n236\t        fur.uniforms.uTip.value.setRGB(1, 1, 1);\n237\t      }\n238\t      mat.map = tex;\n239\t      mat.color.setScalar(spec.scale);\n240\t      if (!fur) {\n241\t        const n = spec.normal ? maps[spec.normal] : null;\n242\t        mat.normalMap = n;\n243\t        if (n) mat.normalScale.setScalar(spec.normalScale ?? 1);\n244\t      }\n245\t    } else if (fur) {\n246\t      // no bake yet: keep the GLB root / tip colours through the multiply path\n247\t      mat.map = white;\n248\t    } else if (m.name === 'hat_crown' && mat.map) {\n249\t      mat.map = mat.map.clone();\n250\t      mat.map.repeat.x = 4; // GLB crown texture was authored for a 4× u repeat\n251\t      mat.map.needsUpdate = true;\n252\t      if (mat.normalMap) { mat.normalMap = mat.normalMap.clone(); mat.normalMap.repeat.x = 4; mat.normalMap.needsUpdate = true; }\n253\t    }\n254\t    mat.needsUpdate = true;\n255\t    baked.push({ mesh: m, mat, map: mat.map, color: mat.color.clone(), fur, root: fur?.uniforms.uRoot.value.clone(), tip: fur?.uniforms.uTip.value.clone() });\n256\t  });\n257\t  const starMat = (star.material as THREE.MeshStandardMaterial).clone();\n258\t  starMat.color.setRGB(...STAR05.color);\n259\t  star.material = starMat;\n260\t  const starCol = starMat.color.clone();\n261\t\n262\t  // ---- QA hooks ----\n263\t  const uvPass: Benny05Handle['uvPass'] = (renderer, world, camera, rect) => {\n264\t    const size = renderer.getDrawingBufferSize(new THREE.Vector2());\n265\t    const rt = new THREE.WebGLRenderTarget(size.x, size.y, { type: THREE.FloatType, depthBuffer: true });\n266\t