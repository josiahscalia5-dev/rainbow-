+// polished copper-gold band: th = angle round the ring, v = 0..1 across its profile, n = normal, T = tunnel direction
+vec3 sbGold(float th, float v, vec3 n, vec3 V, vec3 T) {
+  vec3 n2 = dot(n, V) < 0.0 ? -n : n;
