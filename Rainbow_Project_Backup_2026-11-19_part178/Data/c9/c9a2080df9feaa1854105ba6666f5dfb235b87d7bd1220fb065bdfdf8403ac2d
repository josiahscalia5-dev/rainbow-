emains blocked.", "eager_input_streaming": true, "input_schema": {"properties": {"environment_id": {"description": "The target environment (env_...), exactly as passed to get_environment.", "type": "string"}, "mode": {"description": "Required. \"network_only\": the session's network follows the target environment and this machine is kept. No other value is accepted.", "enum": ["network_only"], "type": "string"}, "switch_statement": {"description": "The exact `switch_statement` get_environment returned for this environment_id: the target's name, the hosts it allows, package managers, MCP servers, its variable names and setup script with when each takes effect, and whose environment it is. Shown to the person approving; the call is refused if it does not match what the server computes after they approve.", "type": "string"}}, "required": ["environment_id", "switch_statement", "mode"], "type": "object"}, "name": "mcp__claude-code-remote__switch_environment"}, "server": "claude-code-remote"}, {"description": "Unarchive a previously archived Claude Code Remote session. Transitions it back to active so it can accept events again; a fresh container will be provisioned on the next send_message. Use this to resume a session that was archived prematurely.", "name": "mcp__claude-code-remote__unarchive_session", "schema": {"description": "Unarchive a previously archived Claude Code Remote session. Transitions it back to active so it can accept events again; a fresh container will be provisioned on the next send_message. Use this to resume a session that was archived prematurely.", "eager_input_streaming": true, "input_schema": {"properties": {"session_id": {"description": "The target session ID to unarchive.", "type": "string"}}, "required": ["session_id"], "type": "object"}, "name": "mcp__claude-code-remote__unarchive_session"}, "server": "claude-code-remote"}, {"description": "Unsubscribe this session from GitHub activity on a pull request. Webhook events for this PR will no 