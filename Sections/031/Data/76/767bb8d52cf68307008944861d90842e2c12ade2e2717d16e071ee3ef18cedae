{"agentId": "a0204aae384750b81", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-4f6c3e0e-5kxgr0", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Spline water ribbon — the traversable stream Benny rides from the Drum A drain to the towel.\n3\t *\n4\t * Geometry: rows every `ds` along the master course, columns across `widthAt(s)`; a slightly\n5\t * concave trough with raised frothy edges plus a short skirt under each edge (thickness).\n6\t * Shader: electric-cyan core with meandering hot-pink flow bands, advected white streaks and\n7\t * sparkles (two-phase flow-map advection so per-stage speeds never shear), Fresnel/haze\n8\t * reflection, specular glints, cellular soap-foam fringe, Benny ripple rings + V-wake, the five\n9\t * glowing chevrons on the 04 slide, a dithered hand-over to the whirlpool surface in 03 and a\n10\t * drain-away for the 11 outro.\n11\t */\n12\timport * as THREE from 'three';\n13\timport type { Course, StageId } from '../world/course';\n14\timport { FRAG_FX_GLSL, FRAG_TAIL, NOISE_GLSL, PALETTE, withFog } from './glsl';\n15\t\n16\t/** wave amplitude per stage (units); blended across boundaries */\n17\tconst AMP: Partial<Record<StageId, number>> = {\n18\t  '02': 0.06, '03': 0.08, '04': 0.03, '05': 0.1, '06': 0.12, '07': 0.1, '08': 0.1, '09': 0.16, '10': 0.08, '11': 0.05,\n19\t};\n20\texport const EDGE_LIFT = 0.28;\n21\t\n22\t/**\n23\t * Per-stage colour-band layout (blended across stage boundaries, baked into `aStyle`):\n24\t *  x gate: 1 = pink bands taper off and part around Benny so the water at and behind him is pure\n25\t *          cyan (ref 05: rows y=1200/1400 are 0% pink); 0 = bands run right past him (refs 04/06/07\n26\t *          keep pink at the sides near the camera)\n27\t *  y off:  band-centre offset from the meandering core centre, fraction of the half width\n28\t *  z wid:  band half width, fraction of the half width\n29\t * Between the two bands is the electric-cyan core; outside them more cyan, then the foam lace.\n30\t */\n31\ttype Style = [number, number, number, number];\n32\t/*  w free: weight of the shader's own drifting channel meander (meander() in FRAG). 0 in 05, where the\n33\t *          course itself winds (S05/meander05 in course.ts) and the core is pinned to the route (see\n34\t *          coreLateral) so the coins on the route stay on the cyan core. 1 elsewhere (04/06/07 unchanged).\n35\t * 05 layout from ref 05 at the live 05 camera (y=600 ≈ 36 px/u, y=700 ≈ 63, y=800 ≈ 93): in the mid/far\n36\t * field each pink band is ≈20 % of the water width, the cyan core ≈45 %, a thin outer cyan strip ≈7 %\n37\t * → band centre 0.62 hw, half width 0.19 hw. Toward Benny the bands taper to half width (gate, FRAG),\n38\t * which gives the ref's ≈100–130 px bands at y=800 and a pure-cyan near field. */\n39\tconst BAND_STYLE: Partial<Record<StageId, Style>> = {\n40\t  '04': [0, 0.6, 0.19, 1],\n41\t  '05': [1, 0.62, 0.19, 0],\n42\t  '06': [0.4, 0.48, 0.1, 1],\n43\t  '07': [0, 0.52, 0.13, 1],\n44\t};\n45\tconst BAND_DEFAULT: Style = [0, 0.5, 0.12, 1];\n46\t\n47\tfunction bandStyleAt(course: Course, s: number): Style {\n48\t  const o: Style = [0, 0, 0, 0];\n49\t  let w = 0;\n50\t  for (const st of course.stages) {\n51\t    const a = smooth(st.s0 - 5, st.s0 + 5, s) * (1 - smooth(st.s1 - 5, st.s1 + 5, s));\n52\t    if (a <= 0) continue;\n53\t    const v = BAND_STYLE[st.id] ?? BAND_DEFAULT;\n54\t    for (let i = 0; i < 4; i++) o[i] += v[i] * a;\n55\t    w += a;\n56\t  }\n57\t  if (w <= 0) return [...(BAND_STYLE[course.stageAtS(s).id] ?? BAND_DEFAULT)];\n58\t  return [o[0] / w, o[1] / w, o[2] / w, o[3] / w];\n59\t}\n60\t\n61\t/**\n62\t * 05 current: lateral position (units, ribbon `right` axis, + = right) of the centre of the\n63\t * electric-cyan core relative to the route centreline. The core swings WITH the course meander,\n64\t * amplified by CORE_SWING, so the two pink bands trace S-bends ≈(1 + CORE_SWING)× as strong as the\n65\t * route's own (ref 05: ±60–120 px). Bounded by CORE_SWING · max|offset05| (≈0.9 · 1.85 = 1.7 u at the\n66\t * far crest; ≤1.25 u within 35 u of the 05 checkpoint), inside the ≥2 u core half width, so a coin on\n67\t * the route centre (lat 0) still sits on cyan. 0 outside 05.\n68\t * gameplay/coins.ts may place the 05 coins at this lateral to put them exactly on the core centre.\n69\t */\n70\texport const CORE_SWING = 0.9;\n71\texport function coreLateral(course: Course, s: number): number {\n72\t  const st = course.stage('05');\n73\t  if (s <= st.s0 || s >= st.s1) return 0;\n74\t  return CORE_SWING * course.offset05(s) * course.sample(s).right.x;\n75\t}\n76\t\n77\t/**\n78\t * Ribbon colours in shader (pre-tonemap, linear) space. NeutralToneMapping desaturates anything\n79\t * whose peak channel passes ≈0.76·exposure, so these were solved by inverting Neutral at the game's\n80\t * exposure 0.86 (src/render/env.ts). Flat values after tone mapping: cyanDeep #0065D6, cyan #1D89F0,\n81\t * cyanBright #42C8F7, pinkDeep #E206BE, pink #F741DD (H 308°, not violet), pinkLight #FA93E7. The\n82\t * streaks/crests/glints added on top lift the rendered cyan median to ≈#06A7FF (ref 05 #039FF6).\n83\t * Crests/highlights are allowed to desaturate toward white (that is how the ref highlights look).\n84\t * The shared PALETTE in glsl.ts is untouched (whirlpool, drum and final wave use it).\n85\t */\n86\tconst lin = (r: number, g: number, b: number) => new THREE.Color().setRGB(r, g, b, THREE.LinearSRGBColorSpace);\n87\tconst RIBBON_PAL = {\n88\t  cyanDeep: lin(0.0, 0.15, 0.78),\n89\t  cyan: lin(0.0, 0.31, 1.12),\n90\t  cyanBright: lin(0.04, 0.95, 1.55),\n91\t  pinkDeep: lin(0.9, 0.02, 0.62),\n92\t  pink: lin(1.55, 0.03, 1.2),\n93\t  pinkLight: lin(2.2, 0.5, 1.8),\n94\t};\n95\t/**\n96\t * 05 river palette (wave 4), shader-space linear values solved through the full post chain\n97\t * (exposure 0.86 → Neutral → sRGB → grade.ts saturation 1.36 / contrast 1.15; bloom ignored) so the\n98\t * flat colours land on the ref 05 samples instead of clipping: cyan deep ≈#0466CF (troughs),\n99\t * cyan ≈#029AF3 (ref core), bright ≈#33C0FF, streak ≈#8FE6FF; pink deep ≈#BC16A8, pink ≈#F73DEA\n100\t * (ref #F739E5 / band medians #F749F1), light ≈#FA9EF2, streak ≈#FEC0F6. The old RIBBON_PAL pink\n101\t * (1.55, 0.03, 1.2) clips to #FF23FF in that chain and the lighting lifted it to lavender #FF6CFF.\n102\t */\n103\tconst RIVER05_PAL = {\n104\t  cyanDeep: lin(0.04, 0.16, 0.46),\n105\t  cyan: lin(0.06, 0.37, 0.74),\n106\t  cyanBright: lin(0.1, 0.8, 1.8),\n107\t  cyanStreak: lin(0.36, 1.25, 2.1),\n108\t  pinkDeep: lin(0.36, 0.04, 0.3),\n109\t  pink: lin(0.7, 0.08, 0.64),\n110\t  pinkLight: lin(0.92, 0.3, 0.88),\n111\t  pinkStreak: lin(1.1, 0.58, 1.04),\n112\t};\n113\t/** 05 texture advection relative to the stage speed (>1: the current visibly overtakes Benny) */\n114\tconst FLOW05 = 1.3;\n115\t\n116\texport function ampAt(course: Course, s: number): number {\n117\t  let v = 0, w = 0;\n118\t  for (const st of course.stages) {\n119\t    const a = smooth(st.s0 - 5, st.s0 + 5, s) * (1 - smooth(st.s1 - 5, st.s1 + 5, s));\n120\t    if (a > 0) { v += (AMP[st.id] ?? 0.08) * a; w += a; }\n121\t  }\n122\t  let amp = w > 0 ? v / w : 0.08;\n123\t  // calm the long straight of the deep plunge (fast sheet flow)\n124\t  const pt = course.marks['07_plunge_top'], pb = course.marks['07_plunge_bottom'];\n125\t  if (pt !== undefined) amp *= 1 - 0.6 * smooth(pt, pt + 8, s) * (1 - smooth(pb - 8, pb, s));\n126\t  return amp;\n127\t}\n128\t\n129\tfunction smooth(a: number, b: number, x: number) {\n130\t  const t = Math.min(1, Math.max(0, (x - a) / (b - a)));\n131\t  return t * t * (3 - 2 * t);\n132\t}\n133\t\n134\t/** CPU mirror of the vertex displacement (keep in sync with VERT). */\n135\texport function ribbonWave(u: number, s: number, t: number, amp: number): number {\n136\t  const au = Math.min(1, Math.abs(u));\n137\t  const trough = EDGE_LIFT * au * au * au;\n138\t  return trough + amp * (0.6 * Math.sin(s * 0.9 - t * 2.4 + u * 1.7) + 0.4 * Math.sin(s * 0.41 + t * 1.5 - u * 2.3));\n139\t}\n140\t\n141\tconst VERT = /* glsl */ `\n142\tattribute vec2 aUV;      // x = u (-1..1 across), y = s (arc length)\n143\tattribute float aHalfW;\n144\tattribute float aSpeed;\n145\tattribute float aAmp;\n146\tattribute float aSkirt;  // 0 surface, 1 skirt bottom\n147\tattribute vec4 aStyle;   // band layout: gate, offset, half width, free-meander weight (see BAND_STYLE)\n148\tattribute float aCore;   // 05: core-centre lateral swing (units, see coreLateral)\n149\tattribute vec3 aTan;     // course tangent (downstream)\n150\tuniform float uTime;\n151\tuniform vec4 uHide;      // s03Start, s04Start, chuteMark, unused\n152\tvarying vec2 vUV;\n153\tvarying float vHalfW;\n154\tvarying float vSpeed;\n155\tvarying float vSkirt;\n156\tvarying float vHide;\n157\tvarying vec4 vStyle;\n158\tvarying float vCore;\n159\tvarying vec3 vTanW;\n160\tvarying vec3 vPosW;\n161\tvarying vec3 vNormalW;\n162\t#include <fog_pars_vertex>\n163\tvoid main() {\n164\t  vStyle = aStyle;\n165\t  vCore = aCore;\n166\t  vTanW = normalize(mat3(modelMatrix) * aTan);\n167\t  float u = aUV.x;\n168\t  float s = aUV.y;\n169\t  float h = aAmp * (0.6 * sin(s * 0.9 - uTime * 2.4 + u * 1.7) + 0.4 * sin(s * 0.41 + uTime * 1.5 - u * 2.3));\n170\t  vec3 p = position + normal * h * (1.0 - aSkirt);\n171\t  vec4 wp = modelMatrix * vec4(p, 1.0);\n172\t  vPosW = wp.xyz;\n173\t  vNormalW = normalize(mat3(modelMatrix) * normal);\n174\t  vUV = aUV;\n175\t  vHalfW = aHalfW;\n176\t  vSpeed = aSpeed;\n177\t  vSkirt = aSkirt;\n178\t  // hand the stream over to the whirlpool surface during 03 (dithered fade both ways)\n179\t  float inside03 = smoothstep(uHide.x + 0.5, uHide.x + 3.5, s) * (1.0 - smoothstep(uHide.y - 9.0, uHide.y - 1.5, s));\n180\t  vHide = 1.0 - inside03;\n181\t  vec4 mvPosition = viewMatrix * wp;\n182\t  gl_Position = projectionMatrix * mvPosition;\n183\t  #include <fog_vertex>\n184\t}\n185\t`;\n186\t\n187\tconst FRAG = /* glsl */ `\n188\tuniform float uTime;\n189\tuniform vec3 uCyanDeep;\n190\tuniform vec3 uCyan;\n191\tuniform vec3 uCyanBright;\n192\tuniform vec3 uPinkDeep;\n193\tuniform vec3 uPink;\n194\tuniform vec3 uPinkLight;\n195\tuniform vec3 uFoam;\n196\tuniform vec3 uFoamLav;\n197\tuniform vec3 uHaze;\n198\tuniform vec3 uLightDir;\n199\tuniform vec3 uBenny;      // s, lateral (units), strength\n200\tuniform float uBennyR;    // Benny's waterline radius (units)\n201\tuniform vec3 uChevron;    // start s, spacing, enabled\n202\tuniform vec2 uOutro;      // amount, chamber start s\n203\t// 05 river palette (see RIVER05_PAL) + its one constant advection speed (no stage-speed shear)\n204\tuniform vec3 uC5Deep;\n205\tuniform vec3 uC5;\n206\tuniform vec3 uC5Bright;\n207\tuniform vec3 uC5Streak;\n208\tuniform vec3 uP5Deep;\n209\tuniform vec3 uP5;\n210\tuniform vec3 uP5Light;\n211\tuniform vec3 uP5Streak;\n212\tuniform float uFlow05;\n213\tvarying vec2 vUV;\n214\tvarying float vHalfW;\n215\tvarying float vSpeed;\n216\tvarying float vSkirt;\n217\tvarying float vHide;\n218\tvarying vec4 vStyle;\n219\tvarying float vCore;\n220\tvarying vec3 vTanW;\n221\tvarying vec3 vPosW;\n222\tvarying vec3 vNormalW;\n223\t#include <fog_pars_fragment>\n224\t${NOISE_GLSL}\n225\t${FRAG_FX_GLSL}\n226\t\n227\t// Stationary channel shape (refs 05–07): lateral offset (units) of the electric-cyan core centre\n228\t// relative to the course centreline. Two incommensurate sines + slow noise so the S-curves do not\n229\t// visibly repeat; λ≈26 u differs from the course's own 05 geometry meander (λ≈36 u), so the two beat\n230\t// rather than cancel. It only drifts slowly downstream (+s) at a constant rate (no shear between\n231\t// stage speeds); the strand texture below is what is advected at the local stage speed.\n232\tfloat meander(float s, float hw) {\n233\t  float a = s - uTime * 0.7;\n234\t  float m = 0.2 * sin(a * 0.24) + 0.08 * sin(a * 0.53 + 1.3) + 0.12 * (vnoise(vec2(a * 0.05, 4.7)) - 0.5);\n235\t  return m * min(hw, 4.5);\n236\t}\n237\t\n238\t// polynomial smooth minimum (k = blend width, units)\n239\tfloat smin(float a, float b, float k) {\n240\t  float h = max(k - abs(a - b), 0.0) / k;\n241\t  return min(a, b) - h * h * k * 0.25;\n242\t}\n243\t\n244\t// Combed flow lines (ref 05: thin bright streaks along the flow, 2–4 px apart in the mid-ground).\n245\t// Anti-aliased lines across the flow (K slots per unit), each broken into tapered streak segments of\n246\t// varying length/brightness. Line width is in PIXELS (≈1.2 px core + ≈2.5 px glow), so near the camera\n247\t// the slots spread apart into sparse crisp glints instead of wide parallel light stripes (the\n248\t// \"flattened stripes\" the user rejected); the lines fade once they get closer than ≈3 px.\n249\tfloat combed(float x, float v, float K, float seed) {\n250\t  float p = x * K;\n251\t  float id = floor(p);\n252\t  float fw = max(fwidth(p), 1e-4);            // slots per pixel\n253\t  float hs = hash12(vec2(id, seed));\n254\t  float dpx = abs(fract(p) - 0.5 - (hs - 0.5) * 0.5) / fw;   // pixels from the line centre\n255\t  float line = (1.0 - smoothstep(0.4, 1.3, dpx)) * 0.8 + exp(-dpx * 0.45) * 0.3;\n256\t  // each line breaks into tapered streak segments; sparser when the slots are far apart on screen\n257\t  float sparse = smoothstep(0.03, 0.006, fw);\n258\t  float seg = smoothstep(0.5 + 0.15 * sparse, 0.9, vnoise(vec2(id * 3.7 + seed, v * 0.2 + hs * 9.0)));\n259\t  return line * seg * (0.45 + 0.55 * hs) * (1.0 - smoothstep(0.22, 0.4, fw));\n260\t}\n261\t\n262\t// advected strand texture (\"combed\" glossy water lines parallel to the flow)\n263\t// x = lateral units relative to the meander centre, v = advected arc length, aa = 0..1 detail fade\n264\t// returns: x = height 0..1 (shading + bump), y = white glint lines, z = mid strands, w = fine strands\n265\t// sw = swirl (05): the strands wander laterally and are less stretched, so the water reads as\n266\t// curling glossy flow instead of uniform straight parallel stripes (the user's rejected look)\n267\tvec4 strands(float x, float v, vec2 aa, float sw) {\n268\t  x += sw * 0.9 * (vnoise(vec2(x * 0.45, v * 0.2 + 7.0)) - 0.5);\n269\t  float a = vnoise(vec2(x * 2.4, v * (0.08 + 0.1 * sw)));\n270\t  float b = vnoise(vec2(x * 7.0 + a * 1.6, v * 0.19 + 5.0));\n271\t  #ifdef LOW_Q\n272\t  float c = b;\n273\t  #else\n274\t  float c = vnoise(vec2(x * 17.0 + b * 2.2, v * 0.42 + 3.0));\n275\t  #endif\n276\t  b = mix(0.5, b, aa.x);\n277\t  c = mix(0.5, c, aa.y);\n278\t  float h = a * 0.42 + b * 0.34 + c * 0.24;\n279\t  h = smoothstep(0.18, 0.82, h);              // more contrast: deep azure troughs, bright crests\n280\t  float line = smoothstep(0.72, 0.86, c) * aa.y + smoothstep(0.7, 0.86, b) * aa.x * 0.85;\n281\t  // the combed lines follow the large-scale strand warp so they bend with the flow\n282\t  float xw = x + (a - 0.5) * 0.5;\n283\t  line = max(line, combed(xw, v, 6.0, 0.0) * 0.85);\n284\t  #ifndef LOW_Q\n285\t  line = max(line, combed(xw + (b - 0.5) * 0.12, v * 1.3, 15.0, 11.0) * 0.55);\n286\t  #endif\n287\t  return vec4(h, line, b, c);\n288\t}\n289\t\n290\t// 05 silk streaks: anti-aliased light lines along the FLOW coordinate q (band-relative, so they bend\n291\t// with the pink S-bands instead of running as straight parallel road stripes). Each line wanders\n292\t// slowly (wig, slot fraction) so neighbours braid, and breaks into advected tapered segments of\n293\t// varying brightness. Width in pixels; the lines fade once they crowd closer than ≈3 px.\n294\tfloat silk(float q, float v, float K, float seed, float wig) {\n295\t  float p = q * K;\n296\t  float fw = max(fwidth(p), 1e-4);\n297\t  float id = floor(p);\n298\t  float hs = hash12(vec2(id, seed));\n299\t  float c = 0.5 + (hs - 0.5) * 0.34 + wig * sin(v * (0.28 + 0.3 * hs) + hs * 6.283);\n300\t  float dpx = abs(fract(p) - c) / fw;\n301\t  float line = (1.0 - smoothstep(0.3, 1.2, dpx)) * 0.7 + exp(-dpx * 0.55) * 0.4;\n302\t  // short tapered brush dashes (≈1–2 u: ref 05 speed streaks are 30–80 px in the mid field)\n303\t  float n = vnoise(vec2(id * 3.1 + seed, v * 0.42 + hs * 17.0));\n304\t  float seg = smoothstep(0.5, 0.86, n);\n305\t  return line * seg * (0.5 + 0.7 * hs) * (1.0 - smoothstep(0.22, 0.42, fw));\n306\t}\n307\t\n308\tvoid main() {\n309\t  float u = vUV.x;\n310\t  float s = vUV.y;\n311\t  // dithered hide (03 hand-over)\n312\t  if (vHide < 0.5) discard;\n313\t  float cutFoam = 1.0 - smoothstep(0.5, 0.85, vHide);\n314\t  // 11 outro: the stream drains away in the chamber, leaving puddles\n315\t  if (uOutro.x > 0.0 && s > uOutro.y - 2.0) {\n316\t    float n = vnoise(vec2(u * 3.0, s * 0.35)) * 0.7 + 0.3;\n317\t    if (n < uOutro.x * 1.15) discard;\n318\t  }\n319\t\n320\t  // ---- channel layout: winding cyan core between two hot-pink S-bands, cyan again outside ----\n321\t  float hw = vHalfW;\n322\t  float lat = u * hw;                         // lateral units in the ribbon frame\n323\t  // core centre: free drifting meander on 04/06/07 (freeK = 1); on 05 (freeK = 0) pinned to the\n324\t  // course's own S-meander, amplified (vCore = CORE_SWING · offset05), so the coins stay on cyan\n325\t  float freeK = vStyle.w;\n326\t  float sw = 1.0 - freeK;                     // weight of the 05 river look (1 on 05 only)\n327\t  float M = meander(s, hw) * freeK + vCore;\n328\t  float x = lat - M;                          // lateral units in the core's frame\n329\t  // 05: the pink bands swing a further ±1.05 u about the core (a stationary λ≈20 u S on top of the\n330\t  // course meander, in phase with it: left at s≈139.5 / y≈800, right at s≈149.7 / y≈680 on the locked\n331\t  // view), so they read as ≈2 clear S-bends to the VP (ref 05: ±100 px). A small 2nd harmonic skews\n332\t  // each bend so the S is not a plain sine. The coins (at coreLateral = M) stay ≥0.3 u inside the cyan.\n333\t  float sbend = sw * (1.05 * sin(s * 0.31 - 0.834) + 0.18 * sin(s * 0.62 + 0.6));\n334\t  float xb = x - sbend;                       // band frame (== x on 04/06/07)\n335\t\n336\t  // detail fade with distance (cells per pixel), keeps far water from shimmering\n337\t  float fwx = fwidth(x);\n338\t  float fws = fwidth(s);\n339\t  // (a noise cell must stay ≳6–8 px wide; the combed lines of ref 05 are 2–4 px apart in the\n340\t  // mid-ground, so fading earlier than this flattens the water into a plain fill)\n341\t  vec2 aa = vec2(1.0 - smoothstep(0.12, 0.26, max(fwx * 7.0, fws * 0.19)),\n342\t                 1.0 - smoothstep(0.09, 0.2, max(fwx * 17.0, fws * 0.42)));\n343\t  // hair-fine combed strands for close-up water (refs: dense parallel flow lines)\n344\t  float aaH = 1.0 - smoothstep(0.14, 0.3, fwx * 46.0);\n345\t  #ifdef LOW_Q\n346\t  aa.y = 0.0;\n347\t  aaH = 0.0;\n348\t  #endif\n349\t\n350\t  // two-phase flow-map advection of the strands (period 4 s; offset scales with stage speed)\n351\t  float ph0 = fract(uTime * 0.25);\n352\t  float ph1 = fract(uTime * 0.25 + 0.5);\n353\t  float w0 = 1.0 - abs(1.0 - 2.0 * ph0);\n354\t  // (04/06/07 strand texture; 05 has its own silk/swell field below)\n355\t  vec4 F = vec4(0.5, 0.0, 0.5, 0.5);\n356\t  if (freeK > 0.001) F = mix(strands(x, s - vSpeed * ph1 * 4.0 + 23.0, aa, sw), strands(x, s - vSpeed * ph0 * 4.0, aa, sw), w0);\n357\t  float v5 = s - uTime * uFlow05;             // 05 advected arc length (one constant speed: no shear)\n358\t\n359\t  // Benny parts the bands like a bow wave (vStyle.x, ref 05): just ahead of him they narrow and\n360\t  // swing outward, so the water at and behind him (the near field) is pure cyan; behind him they\n361\t  // continue only as thin streaks pushed out toward the foam banks\n362\t  // (05: the near rows only show lat ±2.3 behind Benny, so a light parting is enough there)\n363\t  float gate = 1.0, part = 0.0, near05 = 1.0;\n364\t  float db = s - uBenny.x;\n365\t  if (vStyle.x > 0.0) {\n366\t    // 05 (wave 4): the bands stay wide (≥75 %) and run in CLOSER (0.8× offset) beside Benny, so they\n367\t    // sweep past both his sides like ref 05 (pink beside the hat/body at y≈800–1000) instead of\n368\t    // parting out under the foam banks; full width/offset ≈14–20 u ahead\n369\t    float g05 = 0.75 + 0.25 * smoothstep(1.0, 20.0, db);\n370\t    float gOld = 0.4 + 0.6 * smoothstep(0.0, 4.5, db);\n371\t    gate = mix(1.0, mix(g05, gOld, freeK), vStyle.x);\n372\t    part = vStyle.x * hw * 0.3 * freeK * (1.0 - smoothstep(-1.0, 9.0, db));\n373\t    near05 = mix(1.0, 0.8 + 0.2 * smoothstep(2.0, 14.0, db), sw * vStyle.x);\n374\t  }\n375\t  float hwc = min(hw, 4.5);\n376\t  float aaw = fwidth(lat) * 0.85 + 0.01;      // ≈1 px edges: no lavender cyan/pink blend zone\n377\t  // flowing band edges (the advected strand texture). 05: only a soft travelling ripple, so the band\n378\t  // edges are clean S-curves instead of the torn/jagged combed edges of the old slab\n379\t  float pert = mix((vnoise(vec2(x * 0.9, v5 * 0.12 + 3.0)) - 0.5) * 0.3,\n380\t                   (F.z - 0.5) * 0.5 + (F.w - 0.5) * 0.22, freeK) * hwc * 0.22;\n381\t  // 05: the band shapes are carried downstream (a slow travelling wobble), so the pink S-sections\n382\t  // visibly flow and swirl even though the channel itself is fixed to the course meander\n383\t  float tv = s - uTime * vSpeed * 0.3;\n384\t  float wob = sw * hwc;\n385\t  float offL = hw * (vStyle.y * near05 + mix(0.03, 0.07, freeK) * sin(s * 0.13 + 1.7)) + part + wob * 0.05 * sin(tv * 0.42 + 1.1);\n386\t  float offR = hw * (vStyle.y * near05 + mix(0.03, 0.07, freeK) * sin(s * 0.11 + 4.2)) + part + wob * 0.05 * sin(tv * 0.37 + 3.9);\n387\t  float modA = mix(0.15, 0.4, freeK);         // 05: even band width (the ±40 % swell drew the slab)\n388\t  float wL = hw * vStyle.z * (1.0 + modA * sin(s * 0.19 + 0.4) + 0.08 * wob * sin(tv * 0.6)) * gate;\n389\t  float wR = hw * vStyle.z * (1.0 + modA * sin(s * 0.17 + 2.9) + 0.08 * wob * sin(tv * 0.55 + 2.0)) * gate;\n390\t  float brush = 0.0;\n391\t  if (freeK < 0.5) {\n392\t    // keep both bands inside the water (the core swing pushes one toward the bank on each bend);\n393\t    // the band pressed against the bank thins a little instead of collapsing the cyan core\n394\t    // (smooth minimum: a hard min() put a visible corner in the band where the clamp starts)\n395\t    float Mb = M + sbend;\n396\t    float roomL = Mb + hw - 0.5 - offL, roomR = hw - 0.5 - Mb - offR;\n397\t    wL = smin(wL, max(roomL, 0.6 * wL), 0.5);\n398\t    wR = smin(wR, max(roomR, 0.6 * wR), 0.5);\n399\t    offL = smin(offL, Mb + hw - wL - 0.5, 1.2);\n400\t    offR = smin(offR, hw - wR - 0.5 - Mb, 1.2);\n401\t    // 05 (wave 5): behind Benny both S-bands run on as broad brushed sweeps at the image sides (ref 05\n402\t    // near rows: pink at x≈90–265 / 550–770, glossy cyan between and under him). From ≈3 u ahead of him\n403\t    // their centres glide to his track ±1.45 u and narrow to ±0.34 u, so each band stays ONE continuous\n404\t    // ribbon. (This replaces the separate wake \"trail\" sweep, which drew the two hard pink \"fins\".)\n405\t    if (vStyle.x > 0.0 && uBenny.z > 0.0) {\n406\t      float nb = sw * vStyle.x * (1.0 - smoothstep(-0.5, 3.0, db));\n407\t      float side = 1.42 + 0.02 * max(-db, 0.0);\n408\t      offL = mix(offL, Mb - (uBenny.y - side), nb);\n409\t      offR = mix(offR, (uBenny.y + side) - Mb, nb);\n410\t      wL = mix(wL, 0.34, nb);\n411\t      wR = mix(wR, 0.34, nb);\n412\t    }\n413\t    // brushed edges: each band edge is combed into pink / cyan strands along the flow (ref 05: the\n414\t    // ribbons fray into light streaks); crisp per-pixel strands, so no violet pink-over-cyan blend.\n415\t    // Faded out where a strand would be < ≈3 px wide (no shimmer in the far field)\n416\t    float bK = 11.0;\n417\t    brush = sw * (vnoise(vec2(xb * bK, v5 * 0.11 + 5.0)) - 0.5) * (1.0 - smoothstep(0.05, 0.12, fwx * bK));\n418\t  }\n419\t  float sdL = xb + offL + pert;\n420\t  float sdR = xb - offR + pert;\n421\t  float dL = abs(sdL);\n422\t  float dR = abs(sdR);\n423\t  float on = smoothstep(0.02, 0.2, gate);\n424\t  float pL = (1.0 - smoothstep(wL - aaw, wL + aaw, dL - brush * wL * 0.55)) * on;\n425\t  float pR = (1.0 - smoothstep(wR - aaw, wR + aaw, dR - brush * wR * 0.55)) * on;\n426\t  // a thin cyan thread splits a band into two streaks along some stretches (ref 05 mid-ground)\n427\t  float rimW = 0.05 * hwc + aaw;\n428\t  float thrW = 0.028 * hwc;\n429\t  float splitOn = smoothstep(0.55, 0.7, vnoise(vec2(s * 0.07, 13.0))) * mix(0.0, 1.0, freeK);\n430\t  float sL = (1.0 - smoothstep(thrW, thrW + aaw, abs(xb + offL + pert * 1.4 + 0.25 * wL * sin(s * 0.5)))) * splitOn;\n431\t  float sR = (1.0 - smoothstep(thrW, thrW + aaw, abs(xb - offR + pert * 1.4 - 0.25 * wR * sin(s * 0.45 + 1.0)))) * (1.0 - splitOn) * freeK;\n432\t  // only split bands that are wide enough (smooth ramp: a hard step cut the band across the flow)\n433\t  pL *= 1.0 - sL * smoothstep(rimW * 1.8, rimW * 2.8, wL);\n434\t  pR *= 1.0 - sR * smoothstep(rimW * 1.8, rimW * 2.8, wR);\n435\t  // hair-thin pink filaments drifting through the cyan core (mid/far field only)\n436\t  float fil = 0.0;\n437\t  #ifndef LOW_Q\n438\t  float fc = hw * 0.18 * sin(s * 0.21 + 0.8);\n439\t  fil = (1.0 - smoothstep(0.025 * hwc, 0.025 * hwc + aaw, abs(x - fc + pert * 0.7)))\n440\t      * smoothstep(0.62, 0.78, vnoise(vec2(s * 0.09, 21.0))) * gate * aa.x * freeK;   // 05 core: pure cyan\n441\t  #endif\n442\t  float pinkM = max(max(pL, pR), fil);\n443\t  // (wave 5: the separate 05 wake \"trail\" sweep is gone; the main bands themselves run on behind Benny)\n444\t  // glossy rims: light-pink just inside each band edge, bright cyan just outside it\n445\t  float rimIn = max(pL * smoothstep(wL - rimW, wL - aaw, dL), pR * smoothstep(wR - rimW, wR - aaw, dR));\n446\t  float rimOut = max((1.0 - pL) * (1.0 - smoothstep(wL + aaw, wL + rimW * 1.6, dL)),\n447\t                     (1.0 - pR) * (1.0 - smoothstep(wR + aaw, wR + rimW * 1.6, dR))) * on;\n448\t  float rel = pL >= pR ? sdL / max(wL, 1e-3) : -sdR / max(wR, 1e-3);   // -1 outer edge .. +1 core side\n449\t  vec3 N0 = normalize(vNormalW);\n450\t  if (!gl_FrontFacing) N0 = -N0;\n451\t  vec3 V = normalize(cameraPosition - vPosW);\n452\t  vec3 L = normalize(uLightDir);\n453\t  vec3 Hv = normalize(L + V);\n454\t  vec3 Lg = normalize(vTanW + N0 * 0.1);      // the bright tunnel end, far downstream\n455\t\n456\t  vec3 col = vec3(0.0);\n457\t  // =============== 04 / 06 / 07 surface (freeK = 1; unchanged look) ===============\n458\t  if (freeK > 0.001) {\n459\t    float h = F.x;\n460\t    float hair = 0.5;\n461\t    if (aaH > 0.0) {\n462\t      float sv = s - vSpeed * fract(uTime * 0.5) * 2.0;\n463\t      float hA = vnoise(vec2(x * 46.0 + F.w * 3.0, sv * 0.9));\n464\t      float hB = vnoise(vec2(x * 46.0 + F.w * 3.0, (sv + vSpeed) * 0.9 + 17.0));\n465\t      hair = mix(0.5, mix(hB, hA, 1.0 - abs(1.0 - 2.0 * fract(uTime * 0.5))), aaH);\n466\t    }\n467\t    // deep azure troughs → electric cyan → light-cyan crests (crests stay a minority of the area)\n468\t    vec3 cyanCol = mix(uCyanDeep, uCyan, smoothstep(mix(0.3, 0.22, freeK), mix(0.72, 0.62, freeK), h));\n469\t    cyanCol = mix(cyanCol, uCyanBright, smoothstep(mix(0.7, 0.64, freeK), 0.95, h) * mix(0.55, 0.7, freeK) + rimOut * 0.45);\n470\t    // satin ribbon: a soft light streak runs along each band, off-centre toward the core\n471\t    float satin = exp(-pow((rel - 0.3) * 2.2, 2.0));\n472\t    vec3 pinkCol = mix(uPinkDeep, uPink, smoothstep(0.3, 0.72, h + satin * 0.2));\n473\t    pinkCol = mix(pinkCol, uPinkLight, clamp(smoothstep(0.6, 0.92, h) * 0.7 + satin * 0.35 + rimIn * 0.45, 0.0, 1.0));\n474\t    col = mix(cyanCol, pinkCol, pinkM);\n475\t    col *= 0.88 + 0.24 * hair;\n476\t    vec3 streakCol = mix(vec3(0.6, 1.25, 1.6), vec3(1.6, 0.8, 1.6), pinkM);\n477\t    col += streakCol * smoothstep(0.82, 0.94, hair) * 0.3 * aaH;\n478\t\n479\t    // ---- glossy lighting ----\n480\t    #ifdef LOW_Q\n481\t    vec3 N = normalize(N0 + 0.25 * vec3(h - 0.5, 0.0, F.z - 0.5));\n482\t    #else\n483\t    float bumpAmt = 0.07 * (1.0 - smoothstep(0.1, 0.5, fws));\n484\t    vec3 N = bumpNormal(vPosW, N0, h * bumpAmt);\n485\t    #endif\n486\t    float nv = clamp(dot(N, V), 0.0, 1.0);\n487\t    float fres = pow(1.0 - nv, 4.0);\n488\t    vec3 R = reflect(-V, N);\n489\t    // tinted (not white) reflection so the glossy far water stays saturated, not pastel\n490\t    vec3 reflTint = mix(uCyanBright, uPinkLight, pinkM);\n491\t    vec3 refl = mix(reflTint, vec3(1.5), smoothstep(0.6, 1.0, R.y) * 0.5);\n492\t    col = mix(col, refl, fres * 0.22);\n493\t    float spec = pow(clamp(dot(N, Hv), 0.0, 1.0), 120.0);\n494\t    float sheen = pow(clamp(dot(R, L), 0.0, 1.0), 10.0);\n495\t    col += vec3(1.0) * spec * 1.2 + reflTint * sheen * 0.12;\n496\t    // glossy white-blue reflection of the bright tunnel end (refs 05–07): the light sits far\n497\t    // downstream, so its mirror image is a glitter path along the river toward the VP, broken into\n498\t    // streaks by the bump normals and the strand crests (never a flat milky sheet)\n499\t    float glit = pow(clamp(dot(R, Lg), 0.0, 1.0), 160.0);\n500\t    float glitMask = smoothstep(0.5, 0.88, h) * 0.75 + F.y * 0.6;\n501\t    col += mix(vec3(0.7, 1.1, 1.45), vec3(1.5, 0.85, 1.4), pinkM) * glit * glitMask * mix(0.9, 0.45, freeK);\n502\t    // advected glossy streak lines along the flow\n503\t    col += streakCol * F.y * 0.8;\n504\t\n505\t    // ---- foreground ripple crests: pixel-thin lines bowed upstream around the core, in short\n506\t    // segments, so the near water reads as moving glossy ripples, not soft horizontal bars\n507\t    float nearK = 1.0 - smoothstep(0.02, 0.05, fws);\n508\t    if (nearK > 0.0) {\n509\t      float ph = s * 4.2 - uTime * 6.0 + 0.2 * x * x + 1.6 * vnoise(vec2(lat * 0.7, s * 0.45));\n510\t      float q = fract(ph * 0.159155 - 0.25) - 0.5;              // 0 on a crest (sin = 1)\n511\t      float dpx = abs(q) / max(fwidth(ph * 0.159155), 1e-4);\n512\t      float crest = (1.0 - smoothstep(0.5, 1.8, dpx)) * smoothstep(0.52, 0.8, vnoise(vec2(lat * 2.6, s * 1.1 + 3.0)));\n513\t      col *= 1.0 - 0.14 * nearK * (0.5 - 0.5 * sin(ph));\n514\t      col += mix(vec3(0.9, 1.4, 1.7), vec3(1.7, 1.1, 1.7), pinkM) * crest * nearK * mix(0.9, 0.6, freeK);\n515\t    }\n516\t\n517\t    // ---- white star glints (4-point, twinkling, carried by the flow) ----\n518\t    #ifdef LOW_Q\n519\t    vec2 g = vec2(lat * 1.2, (s - vSpeed * uTime * 0.6) * 0.8);\n520\t    float hs = hash12(floor(g));\n521\t    float sparkle = step(0.9, hs) * smoothstep(0.22, 0.0, length(fract(g) - 0.5)) * (0.5 + 0.5 * sin(uTime * 7.0 + hs * 40.0));\n522\t    col += vec3(1.3) * sparkle;\n523\t    #else\n524\t    // wide cells so the long horizontal arms are not clipped at the cell border in the mid-ground\n525\t    float glint = starGlint(vec2(lat * 0.55, (s - vSpeed * uTime * 0.55) * 0.42), 0.42, 22.0, 2.4, uTime);\n526\t    col += vec3(2.0, 2.2, 2.3) * glint * (1.0 - smoothstep(0.3, 0.8, fws));\n527\t    #endif\n528\t  }\n529\t\n530\t  // =============== 05: thick glossy river (sw = 1) ===============\n531\t  // The user rejected the 05 water as \"a flat blue road with straight stripes\". Here the surface is a\n532\t  // flow-aligned height field: every streak, ridge and flare is laid out in the flow coordinate q\n533\t  // (-1 on the left band's centre line, +1 on the right one), so they bend with the pink S-bands.\n534\t  // Depth comes from deep-azure troughs between bright crests, tubular pink ribbons (deep magenta\n535\t  // edges → hot pink → light satin crest), Fresnel sky tint, sun specular, the tunnel-end glitter\n536\t  // path and bump normals from the same height field; the near field (right behind Benny, where\n537\t  // 1 u ≈ 250 px) swaps the along-flow ridges for bowed cross-flow ripple crests and horizontal flares.\n538\t  if (sw > 0.001) {\n539\t    float cLc = -offL - pert, cRc = offR - pert;\n540\t    float hS = max(0.5 * (cRc - cLc), 0.6);\n541\t    float q = (xb - 0.5 * (cLc + cRc)) / hS;\n542\t    float near5 = 1.0 - smoothstep(0.0075, 0.014, fws);\n543\t    float wq = q + 0.05 * sin(v5 * 0.23 + q * 4.0);           // slow braid of the flow lines\n544\t    // height: braided swell ridges along the flow (mid/far), ripple cells (near), silk lines on top\n545\t    float rFar = vnoise(vec2(wq * 7.0, v5 * 0.2));\n546\t    // near field (wave 5): thick water heaving over Benny's track. Bowed cross-flow swells (crest lines\n547\t    // arch toward the VP, \"∩\" like ref 05's near arcs, λ ≈ 0.55 u ≈ 90–110 px), broken into short\n548\t    // glossy segments by noise and warped so they never read as contour rings; deep azure troughs\n549\t    // between them. Advected with the current (v5).\n550\t    float dlN = lat - uBenny.y;\n551\t    float phN = (v5 + 0.2 * dlN * dlN) * 11.4 + 2.4 * vnoise(vec2(lat * 0.9, v5 * 0.7 + 2.0));\n552\t    float cN = 0.5 + 0.5 * sin(phN);\n553\t    float segN = smoothstep(0.3, 0.66, vnoise(vec2(lat * 1.8 + 4.0, floor(phN * 0.159155 + 0.25) * 1.37)));\n554\t    float crestN = (pow(cN, 30.0) + 0.15 * pow(cN, 6.0)) * segN;\n555\t    float troughN = pow(1.0 - cN, 3.0) * (0.65 + 0.35 * vnoise(vec2(lat * 0.7, v5 * 0.9 + 6.0)));\n556\t    // short thin speed streaks along the current (≈80–100 px dashes, ≈85 px apart, wavy)\n557\t    float strN = silk(lat, v5 * 5.0 + 60.0, 2.6, 21.0, 0.3);\n558\t    float rNear = 0.42 + 0.42 * crestN - 0.3 * troughN;\n559\t    float swell = mix(rFar, rNear, near5);\n560\t    swell = mix(0.5, swell, 1.0 - smoothstep(0.3, 0.7, fwidth(wq * 7.0)) * (1.0 - near5));\n561\t    float silkA = silk(wq, v5, 15.0, 0.0, 0.16);\n562\t    float silkB = 0.0;\n563\t    #ifndef LOW_Q\n564\t    silkB = silk(wq, v5 * 1.35 + 40.0, 38.0, 7.0, 0.1);\n565\t    #endif\n566\t    // (near field: the silk lines stay on the pink sweeps only, as brushed satin; on cyan they read as road lines)\n567\t    float silkL = max(silkA, silkB * mix(0.45, 0.8, pinkM)) * (1.0 - near5 * (1.0 - pinkM));\n568\t    float H5 = clamp(swell * 0.8 + silkL * 0.35 + 0.18 * near5, 0.0, 1.0);\n569\t\n570\t    // cyan: deep azure troughs -> electric cyan -> bright cyan crests; light seam beside each band\n571\t    vec3 cy = mix(uC5Deep, uC5, smoothstep(0.26, 0.74, H5));\n572\t    cy = mix(cy, uC5Bright, clamp(smoothstep(0.76, 0.98, H5) * 0.6 + rimOut * 0.55, 0.0, 1.0));\n573\t    // pink: tubular ribbons (deep magenta edges -> hot pink -> light satin crest off-centre)\n574\t    float relB = clamp(rel, -1.0, 1.0);\n575\t    float prof = 1.0 - relB * relB;\n576\t    float satin5 = exp(-pow((relB - 0.3) * 3.2, 2.0));\n577\t    vec3 pk = mix(uP5Deep, uP5, smoothstep(0.0, 0.6, prof) * (0.62 + 0.55 * H5));\n578\t    pk = mix(pk, uP5Light, clamp(satin5 * 0.4 + smoothstep(0.78, 0.98, H5) * 0.25 + rimIn * 0.35, 0.0, 1.0));\n579\t    // glossy crest line along each ribbon (its brightest silk, toward the core side)\n580\t    pk = mix(pk, uP5Streak, exp(-pow((relB - 0.42) * 9.0, 2.0)) * 0.55 * smoothstep(0.35, 0.65, swell));\n581\t    vec3 c5 = mix(cy, pk, pinkM);\n582\t    // silk streak light: light cyan-white on cyan, light pink on pink (the ribbons are combed silk);\n583\t    // the strongest dashes burn to near-white (ref 05 streak heads)\n584\t    c5 = mix(c5, mix(uC5Streak, uP5Streak, pinkM), clamp(silkL * mix(0.9, 1.05, pinkM), 0.0, 1.0));\n585\t    c5 += vec3(0.9, 1.0, 1.1) * smoothstep(0.75, 1.1, silkA) * 0.6;\n586\t\n587\t    // glossy lighting from the same height field\n588\t    #ifdef LOW_Q\n589\t    vec3 N5 = normalize(N0 + 0.3 * vec3(H5 - 0.5, 0.0, swell - 0.5));\n590\t    #else\n591\t    vec3 N5 = bumpNormal(vPosW, N0, H5 * 0.09 * (1.0 - smoothstep(0.1, 0.5, fws)));\n592\t    #endif\n593\t    float nv5 = clamp(dot(N5, V), 0.0, 1.0);\n594\t    vec3 R5 = reflect(-V, N5);\n595\t    c5 = mix(c5, mix(uC5Bright, uP5Light, pinkM), pow(1.0 - nv5, 3.0) * mix(0.1, 0.16, pinkM));\n596\t    c5 += vec3(1.0) * pow(clamp(dot(N5, Hv), 0.0, 1.0), 90.0) * 1.1;\n597\t    float gl5 = pow(clamp(dot(R5, Lg), 0.0, 1.0), 90.0);\n598\t    c5 += mix(vec3(0.6, 1.2, 1.6), vec3(1.4, 0.7, 1.3), pinkM) * gl5 * (smoothstep(0.6, 0.92, H5) * 0.6 + silkL * 0.7);\n599\t\n600\t    // near field (right behind Benny, 1 u ≈ 160–280 px): deep azure troughs, blue-white glossy swell\n601\t    // crests (the reflection of the lit tunnel on the heaving surface; on the pink sweeps a light-pink\n602\t    // sheen), soft flow streaks\n603\t    if (near5 > 0.0) {\n604\t      c5 *= 1.0 - near5 * 0.3 * troughN * (1.0 - 0.5 * pinkM);\n605\t      vec3 crestCol = mix(vec3(0.85, 1.65, 2.3), uP5Streak * 1.2, pinkM);\n606\t      c5 += crestCol * crestN * 2.1 * near5 * (1.0 - 0.45 * pinkM);\n607\t      c5 += mix(vec3(0.6, 1.3, 1.9), uP5Streak, pinkM) * strN * 0.45 * near5 * (1.0 - pinkM);\n608\t      // Fresnel-style sheen toward the screen sides (the surface bulges, its flanks face away)\n609\t      c5 = mix(c5, mix(vec3(0.5, 1.2, 1.9), uP5Light, pinkM), near5 * 0.18 * smoothstep(0.8, 1.6, abs(dlN)));\n610\t    }\n611\t\n612\t    // white 4-point flares carried by the current: along the flow in the mid field, across it near\n613\t    #ifdef LOW_Q\n614\t    vec2 g5 = vec2(wq * 6.0, v5 * 0.25);\n615\t    float hs5 = hash12(floor(g5));\n616\t    c5 += vec3(1.3) * step(0.88, hs5) * smoothstep(0.22, 0.0, length(fract(g5) - 0.5)) * (0.5 + 0.5 * sin(uTime * 7.0 + hs5 * 40.0));\n617\t    vec2 g5n = vec2(lat * 3.0, v5 * 2.4);\n618\t    float hs5n = hash12(floor(g5n) + 3.0);\n619\t    c5 += vec3(1.4) * near5 * step(0.6, hs5n) * smoothstep(0.16, 0.0, length(fract(g5n) - 0.5)) * (0.6 + 0.4 * sin(uTime * 6.0 + hs5n * 30.0));\n620\t    #else\n621\t    float flA = flowGlint(vec2(wq * 6.0, v5 * 0.075), 0.75, 18.0, 3.8, 0.0, uTime);\n622\t    float flB = flowGlint(vec2(lat * 1.6, v5 * 1.4 + 0.5), 0.6, 26.0, 3.2, 1.0, uTime + 2.7);\n623\t    // many small twinkling 4-point stars (ref 05: dozens of tiny white glints in the near and mid water)\n624\t    float flC = flowGlint(vec2(lat * 4.0, v5 * 3.2 + 0.3), 0.8, 8.0, 2.6, 1.0, uTime + 1.3);\n625\t    flC *= 0.4 + 0.9 * pow(cN, 3.0);            // the small stars cluster on the swell crests (not a uniform snow)\n626\t    float flD = flowGlint(vec2(wq * 16.0, v5 * 0.32 + 7.0), 0.5, 6.0, 2.4, 0.3, uTime + 4.1);\n627\t    // (the big near flares sit mostly on the swell crests: light catching the heaving surface)\n628\t    c5 += vec3(1.9, 2.1, 2.3) * (flA * (1.0 - near5) * (1.0 - smoothstep(0.3, 0.8, fws))\n629\t        + flB * near5 * (0.35 + 1.4 * pow(cN, 6.0) * segN) + flC * near5 + flD * (1.0 - near5) * (1.0 - smoothstep(0.2, 0.5, fws)) * 0.9)\n630\t        * (1.0 - 0.5 * pinkM);\n631\t    #endif\n632\t    col = mix(col, c5, sw);\n633\t  }\n634\t  // ---- soap-foam lace where the water meets the foam banks ----\n635\t  float edgeN = (vnoise(vec2(s * 1.3, u * 2.0)) - 0.5) * 0.1;\n636\t  float eu = abs(lat) - vHalfW;               // units from the edge (negative inside)\n637\t  float edge = smoothstep(-0.75, -0.3, eu + edgeN * vHalfW);\n638\t  if (edge > 0.0) {\n639\t    float c = cells(vec2(lat * 3.2, (s - vSpeed * uTime * 0.35) * 3.2));\n640\t    vec3 foamCol = mix(uFoam * 1.15, uFoamLav * 0.85, smoothstep(0.25, 0.75, c));\n641\t    col = mix(col, foamCol, edge * smoothstep(0.05, 0.4, c + edge * 0.3));\n642\t  }\n643\t  col = mix(col, uFoamLav * 0.92, vSkirt);\n644\t  float cutC = cells(vec2(u * vHalfW * 4.0, s * 3.6));\n645\t  col = mix(col, mix(uFoam * 1.2, uFoamLav * 0.8, smoothstep(0.2, 0.7, cutC)), cutFoam);\n646\t\n647\t  // ---- Benny: ripple rings and a V wake on the surface ----\n648\t  // (the 3D splash crown, spray fan and foam belong to riderSplash/spray/foam; here the water\n649\t  // around and behind him stays glossy electric cyan as in ref 05.) There is deliberately NO white\n650\t  // contact band at the waterline: the old contact -> uFoam mix drew a white elliptical rim that the\n651\t  // fur fringe turned into the jagged \"splash artifact\" under Benny (wave-3 correction 7). Only a\n652\t  // faint cyan brightening marks the waterline.\n653\t  if (uBenny.z > 0.0) {\n654\t    float du = lat - uBenny.y;\n655\t    float dv = s - uBenny.x;\n656\t    float rb = uBennyR;\n657\t    float d = length(vec2(du, dv));\n658\t    if (d < rb * 8.0) {\n659\t      float k = uBenny.z;\n660\t      float rr = max(0.0, d - rb * 0.92);\n661\t      float rings = smoothstep(0.75, 1.0, 0.5 + 0.5 * sin(d * 5.0 - uTime * 9.0)) * exp(-rr * 0.55) * smoothstep(rb, rb * 1.3, d);\n662\t      // 05: the magnified near field turned full rings into contour arcs; keep broken ripple fragments\n663\t      rings *= mix(1.0, 0.45 * smoothstep(0.45, 0.8, vnoise(vec2(atan(du, dv) * 3.0, d * 2.0))), sw);\n664\t      float back = max(-dv, 0.0);\n665\t      float wakeV = exp(-abs(abs(du) - back * 0.42 - rb * 0.95) * 6.0) * exp(-back * 0.18) * step(dv, 0.0);\n666\t      col += uCyanBright * 0.18 * (1.0 - smoothstep(0.0, rb * 0.3, rr)) * k;\n667\t      col += mix(uCyanBright, vec3(1.3), 0.4) * (rings * 0.22 + wakeV * 0.35) * k * (1.0 - pinkM * 0.5);\n668\t    }\n669\t  }\n670\t\n671\t  // 04: exactly five glowing chevrons pointing downhill (direction of travel)\n672\t  if (uChevron.z > 0.5) {\n673\t    float x = u * vHalfW;\n674\t    for (int k = 0; k < 5; k++) {\n675\t      float y = s - (uChevron.x + float(k) * uChevron.y);\n676\t      if (abs(y) < 2.4 && abs(x) < 1.6) {\n677\t        // \"^\" pointing toward +s: tip at y=+1.0, arms sweep back 1.9 units over ±1.15 lateral\n678\t        float dist = abs(y - (1.0 - abs(x) * 1.65)) * 0.52;\n679\t        float arm = smoothstep(1.2, 1.1, abs(x));\n680\t        float core = smoothstep(0.2, 0.11, dist) * arm;\n681\t        float halo = smoothstep(0.7, 0.0, dist) * smoothstep(1.5, 0.9, abs(x)) * 0.5;\n682\t        col = mix(col, vec3(1.0), clamp(halo, 0.0, 1.0));\n683\t        col = mix(col, vec3(2.2, 2.4, 2.5), core);\n684\t      }\n685\t    }\n686\t  }\n687\t  gl_FragColor = vec4(col, 1.0);\n688\t  ${FRAG_TAIL}\n689\t}\n690\t`;\n691\t\n692\texport interface Ribbon {\n693\t  mesh: THREE.Mesh;\n694\t  uniforms: Record<string, THREE.IUniform>;\n695\t  s0: number;\n696\t  s1: number;\n697\t  heightAt(s: number, lateral: number, t: number): number;\n698\t}\n699\t\n700\texport function createRibbon(course: Course, opts: { s0: number; s1: number; quality: 'high' | 'low' }): Ribbon {\n701\t  const { s0, s1, quality } = opts;\n702\t  const ds = quality === 'high' ? 0.4 : 0.7;\n703\t  const cols = quality === 'high' ? 18 : 10;\n704\t  const rows = Math.ceil((s1 - s0) / ds) + 1;\n705\t  const vertsPerRow = cols + 1 + 2; // + skirt left/right\n706\t  const n = rows * vertsPerRow;\n707\t  const pos = new Float32Array(n * 3);\n708\t  const nor = new Float32Array(n * 3);\n709\t  const uv = new Float32Array(n * 2);\n710\t  const halfW = new Float32Array(n);\n711\t  const speed = new Float32Array(n);\n712\t  const amp = new Float32Array(n);\n713\t  const skirt = new Float32Array(n);\n714\t  const style = new Float32Array(n * 4);\n715\t  const core = new Float32Array(n);\n716\t  const tang = new Float32Array(n * 3);\n717\t  const tmp = new THREE.Vector3();\n718\t  const nrm = new THREE.Vector3();\n719\t  let k = 0;\n720\t  for (let i = 0; i < rows; i++) {\n721\t    const s = Math.min(s1, s0 + i * ds);\n722\t    const f = course.sample(s);\n723\t    const hw = course.widthAt(s) / 2;\n724\t    const sp = Math.max(3, course.prop(s, 'speed'));\n725\t    const a = ampAt(course, s);\n726\t    const bs = bandStyleAt(course, s);\n727\t    const cl = coreLateral(course, s);\n728\t    const put = (u: number, lateral: number, h: number, isSkirt: number, nn: THREE.Vector3) => {\n729\t      tmp.copy(f.pos).addScaledVector(f.right, lateral).addScaledVector(f.up, h);\n730\t      tmp.toArray(pos, k * 3);\n731\t      nn.toArray(nor, k * 3);\n732\t      f.tan.toArray(tang, k * 3);\n733\t      uv[k * 2] = u;\n734\t      uv[k * 2 + 1] = s;\n735\t      halfW[k] = hw;\n736\t      speed[k] = sp;\n737\t      amp[k] = a;\n738\t      skirt[k] = isSkirt;\n739\t      for (let q = 0; q < 4; q++) style[k * 4 + q] = bs[q];\n740\t      core[k] = cl;\n741\t      k++;\n742\t    };\n743\t    // left skirt (below left edge)\n744\t    put(-1, -hw * 1.01, EDGE_LIFT - 0.7, 1, nrm.copy(f.right).negate());\n745\t    for (let j = 0; j <= cols; j++) {\n746\t      const u = -1 + (2 * j) / cols;\n747\t      const lift = EDGE_LIFT * Math.abs(u) ** 3;\n748\t      const slope = (EDGE_LIFT * 3 * u * Math.abs(u)) / hw; // d lift / d lateral\n749\t      nrm.copy(f.up).addScaledVector(f.right, -slope).normalize();\n750\t      put(u, u * hw, lift, 0, nrm);\n751\t    }\n752\t    put(1, hw * 1.01, EDGE_LIFT - 0.7, 1, nrm.copy(f.right));\n753\t  }\n754\t  const idx: number[] = [];\n755\t  for (let i = 0; i < rows - 1; i++) {\n756\t    for (let j = 0; j < vertsPerRow - 1; j++) {\n757\t      const a = i * vertsPerRow + j, b = a + 1, c = a + vertsPerRow, d = c + 1;\n758\t      idx.push(a, c, b, b, c, d);\n759\t    }\n760\t  }\n761\t  const geo = new THREE.BufferGeometry();\n762\t  geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));\n763\t  geo.setAttribute('normal', new THREE.BufferAttribute(nor, 3));\n764\t  geo.setAttribute('aUV', new THREE.BufferAttribute(uv, 2));\n765\t  geo.setAttribute('aHalfW', new THREE.BufferAttribute(halfW, 1));\n766\t  geo.setAttribute('aSpeed', new THREE.BufferAttribute(speed, 1));\n767\t  geo.setAttribute('aAmp', new THREE.BufferAttribute(amp, 1));\n768\t  geo.setAttribute('aSkirt', new THREE.BufferAttribute(skirt, 1));\n769\t  geo.setAttribute('aStyle', new THREE.BufferAttribute(style, 4));\n770\t  geo.setAttribute('aCore', new THREE.BufferAttribute(core, 1));\n771\t  geo.setAttribute('aTan', new THREE.BufferAttribute(tang, 3));\n772\t  geo.setIndex(idx);\n773\t  geo.computeBoundingSphere();\n774\t\n775\t  const st03 = course.stage('03'), st04 = course.stage('04'), st08 = course.stage('08');\n776\t  const uniforms = withFog({\n777\t    uTime: { value: 0 },\n778\t    uCyanDeep: { value: RIBBON_PAL.cyanDeep.clone() },\n779\t    uCyan: { value: RIBBON_PAL.cyan.clone() },\n780\t    uCyanBright: { value: RIBBON_PAL.cyanBright.clone() },\n781\t    uPinkDeep: { value: RIBBON_PAL.pinkDeep.clone() },\n782\t    uPink: { value: RIBBON_PAL.pink.clone() },\n783\t    uPinkLight: { value: RIBBON_PAL.pinkLight.clone() },\n784\t    uFoam: { value: PALETTE.foam.clone() },\n785\t    uFoamLav: { value: PALETTE.foamLav.clone() },\n786\t    uHaze: { value: PALETTE.haze.clone() },\n787\t    uLightDir: { value: new THREE.Vector3(0.3, 1.0, 0.45).normalize() },\n788\t    uBenny: { value: new THREE.Vector3(0, 0, 0) },\n789\t    uBennyR: { value: 0.7 },\n790\t    uChevron: { value: new THREE.Vector3(st04.s0 + 8.5, 3.6, 1) },\n791\t    uOutro: { value: new THREE.Vector2(0, st08.s0) },\n792\t    uHide: { value: new THREE.Vector4(st03.s0, st04.s0, 0, 0) },\n793\t    uC5Deep: { value: RIVER05_PAL.cyanDeep.clone() },\n794\t    uC5: { value: RIVER05_PAL.cyan.clone() },\n795\t    uC5Bright: { value: RIVER05_PAL.cyanBright.clone() },\n796\t    uC5Streak: { value: RIVER05_PAL.cyanStreak.clone() },\n797\t    uP5Deep: { value: RIVER05_PAL.pinkDeep.clone() },\n798\t    uP5: { value: RIVER05_PAL.pink.clone() },\n799\t    uP5Light: { value: RIVER05_PAL.pinkLight.clone() },\n800\t    uP5Streak: { value: RIVER05_PAL.pinkStreak.clone() },\n801\t    uFlow05: { value: course.stage('05').speed * FLOW05 },\n802\t  });\n803\t  const mat = new THREE.ShaderMaterial({\n804\t    uniforms,\n805\t    vertexShader: VERT,\n806\t    fragmentShader: FRAG,\n807\t    fog: true,\n808\t    side: THREE.DoubleSide,\n809\t    defines: quality === 'low' ? { LOW_Q: 1 } : {},\n810\t  });\n811\t  const mesh = new THREE.Mesh(geo, mat);\n812\t  mesh.name = 'water_ribbon';\n813\t  mesh.frustumCulled = false; // one long mesh spanning the whole course\n814\t  return {\n815\t    mesh,\n816\t    uniforms,\n817\t    s0,\n818\t    s1,\n819\t    heightAt(s, lateral, t) {\n820\t      const hw = course.widthAt(s) / 2;\n821\t      return ribbonWa