4), new THREE.MeshStandardMaterial({ color: '#f36fd6', metalness: 0.5, roughness: 0.2, emissive: '#c43bb0', emissiveIntensity: 0.35, side: THREE.DoubleSide }));\n167\t  deck.rotation.x = -Math.PI / 2;\n168\t  deck.position.set(B.center.x, B.rimY + 0.3, B.center.z);\n169\t  zones.basin.add(deck);\n170\t  buildBasinBackdrop(zones.basin, goldMat, chromeMat);\n171\t\n172\t  // =====================================================================================\n173\t  // 04 gold ring pipe\n174\t  // =====================================================================================\n175\t  const s04 = course.stage('04').s0, s05 = course.stage('05').s0;\n176\t  const tubeR = (s: number) => course.prop('tube', s);\n177\t  // the pipe mouth is the drain hole itself: narrow at the lip, opening up as it dives\n178\t  // the ring tunnel starts just ahead of Benny on the open slide (ref 04), with a flared mouth\n179\t  const g0 = s04 + 5.0;\n180\t  const r04 = (s: number) => tubeR(s) + 1.8 * (1 - sm(g0, g0 + 6, s));\n181\t  const goldPath = courseTubePath(course, r04, 0.9);\n182\t  const goldPipe = new THREE.Mesh(buildTubeGeometry(goldPath, g0, s05, { radial: 56, step: 0.4 }), goldRibbed(1.25));\n183\t  zones.tubes.add(goldPipe);\n184\t  zones.tubes.add(buildRings(goldPath, g0 + 0.2, s05 - 1, 1.6, goldMat, { tube: 0.05, inset: 0.02 }));\n185\t  // big mouth rings at the drain\n186\t  for (let i = 0; i < 4; i++) {\n187\t    const s = g0 + 0.05 + i * 0.3;\n188\t    zones.tubes.add(buildRings(goldPath, s, s + 0.01, 1, goldMat, { tube: 0.07, extra: 0.4 + i * 0.22 }));\n189\t  }\n190\t\n191\t  // =====================================================================================\n192\t  // 05–07 perforated tubes (incl. the 06 arch hall and the full 07 plunge)\n193\t  // =====================================================================================\n194\t  const s08 = course.stage('08').s0;\n195\t  const pinkFlow = pinkFlowMaterial();\n196\t  // refs 05–07: rich saturated magenta→violet glossy pressed metal, dense glowing slot rows, warm light\n197\t  // far down the tunnel. Own reflection environment (no cyan studio panel) + correct inward normals.\n198\t  // hot magenta near → violet mid-tunnel → warm yellow-white core at the vanishing point\n199\t  const tubeGlow: FarGlow = { color: '#ffd08a', near: 48, far: 105, strength: 1.5 };\n200\t  const wallGlow: FarGlow = { ...tubeGlow, mid: { color: '#8a3cf0', near: 10, far: 42, amount: 0.55 } };\n201\t  const tubeEnv = washerTubeEnv('wall');\n202\t  const goldEnv = washerTubeEnv('gold');\n203\t  // 06/07 ring bays (unchanged): gold bands every 9 units, 4 circumferential slot rows per bay\n204\t  const ringSpacing = 9.0;\n205\t  const slotRowsPerBay = 4;\n206\t  // analytic strip lights along the tunnel (28 around: ref 05 shows ≈12–16 marquee spots per half-ring)\n207\t  const strips: TubeStrips = { count: 28, width: 0.022, intensity: 2.6, color: '#ffd9f6', alt: 0.65 };\n208\t  // glossy (low roughness → the strips stay crisp lengthwise streaks instead of a flat clipped sheen)\n209\t  const wallBase = {\n210\t    // pale pink F0: the saturation comes from the magenta/violet tube environment, so white strip lights\n211\t    // reflect as white-pink streaks (a saturated F0 turned them into clipped flat magenta)\n212\t    color: '#ffa8e8', emissive: '#3a0656', emissiveIntensity: 0.3, holeColor: '#0c0014',\n213\t    slot: 1, repeatU: 48, stagger: false,\n214\t    streaks: 0, metalness: 0.92, roughness: 0.1,\n215\t    relief: { corrugation: 0.05, bevel: 0.05, bevelWidth: 0.12 }, rimColor: '#ff5fe0', rimStrength: 0.9,\n216\t    envMap: tubeEnv, envMapIntensity: 1.0, farGlow: wallGlow,\n217\t  } as const;\n218\t  // STAGE ANCHORS (wave 6): the 06/07 ring bays, hood lids and slot rows are laid out from the 06 STAGE\n219\t  // START, not from the 05 start, so reshaping the 05 river (which changes its arc length) never slides the\n220\t  // 06/07 rings, lids or slot rows along the tube. The phases reproduce the pre-wave-6 layout exactly\n221\t  // (measured on that course: first 06/07 ring 5.5644 u after the 06 start; slot-row phase 0.96618 there).\n222\t  const s06 = course.stage('06').s0;\n223\t  const RING06_PHASE = 5.5643876;\n224\t  const ROW06_PHASE = 0.9661842;\n225\t  const rowRepeat0607 = slotRowsPerBay / ringSpacing;\n226\t  const rowOffset0607 = (((ROW06_PHASE - s06 * rowRepeat0607) % 1) + 1) % 1;\n227\t  const perfTubeMat = perforatedMetal({ ...wallBase, repeatV: rowRepeat0607, offsetV: rowOffset0607, slotHalf: [0.36, 0.12] });\n228\t  withTubeStrips(perfTubeMat, strips, 'attribute', 'wall');\n229\t  // straight-axis tunnel (05 → 07 incl. arch + plunge); the stream winds inside it\n230\t  const perfPath = straightTubePath(course, s05, s08, { window: 30, taper: 14, baseRadius: tubeR });\n231\t\n232\t  // ---- 05 current (ref 05): long ring bays + forced-perspective far tunnel, anchored to the 05 camera ----\n233\t  // Ref 05 ring radii about the VP: 288,192,122,85,66,54,45 px → from the locked checkpoint eye the rings sit\n234\t  // at depth ≈36/55 (near bays ≈17–19 units) and then recede in ever longer bays to a small warm light.\n235\t  // The straight only runs ≈56 units ahead of that eye before it flares into the 06 hall, so the real bays\n236\t  // end with a ring at depth ≈54 (sF05) and a ForcedTunnel (tube.ts) continues the same tunnel — walls,\n237\t  // slot rows, rings, lid pairs, water — to a virtual depth ≈430, compressed along the eye rays into the\n238\t  // last ≈6 real units. If path-camera moves the checkpoint, the bays and the far section follow.\n239\t  const sCam05 = course.marks['05_crest'] - (STAGE_CAM['05']?.back ?? 6.4);\n240\t  const bay05 = 14;\n241\t  const sGlow05 = course.stage('06').s0 - 5.9; // the straight flares into the 06 hall after this\n242\t  const sF05 = Math.min(sCam05 + 54, sGlow05 - 2.5);\n243\t  const rings05: number[] = [];\n244\t  for (let s = sF05; s >= s05 + 2; s -= bay05) rings05.unshift(s);\n245\t  // 05 walls: 7 dark capsule-slot rows per 14-unit bay, centred between the bands (rows 2 apart),\n246\t  // slots ≈0.6 × 0.24 units laid along the circumference (ref 05 near slots ≈10 × 28 px)\n247\t  const slotPitch05 = bay05 / 7;\n248\t  // ref 05 walls: deep metallic magenta/violet (#CD32AA / #992FC2), black slots, white-pink lengthwise\n249\t  // streaks; the warm light only at the very end (virtual depth ≳160 → halo ≲60 px about the VP)\n250\t  const glow05: FarGlow = { color: '#ffd796', near: 160, far: 470, strength: 1.6, mid: { color: '#8a30d2', near: 4, far: 48, amount: 0.45 } };\n251\t  const wall05 = {\n252\t    // lavender F0 × the magenta tube environment → violet-magenta metal (ref #992FC2 / #CD32AA)\n253\t    ...wallBase, color: '#f29ad6', emissive: '#360440', emissiveIntensity: 0.14, envMapIntensity: 0.74,\n254\t    rimColor: '#ff4fd8', rimStrength: 0.45, farGlow: glow05,\n255\t    repeatV: 1 / slotPitch05, slotHalf: [0.3, 0.1] as [number, number],\n256\t    offsetV: 0.5 - ((((rings05[0] + slotPitch05 / 2) / slotPitch05) % 1) + 1) % 1,\n257\t  };\n258\t  const strips05: TubeStrips = { ...strips, intensity: 2.8 };\n259\t  const perf05Mat = withTubeStrips(perforatedMetal(wall05), strips05, 'attribute', 'wall05');\n260\t  const chunk = 40;\n261\t  const addWall = (a0: number, a1: number, mat: THREE.Material) => {\n262\t    for (let a = a0; a < a1 - 0.01; a += chunk) {\n263\t      const b = Math.min(a1, a + chunk + 0.6);\n264\t      zones.tubes.add(new THREE.Mesh(buildTubeGeometry(perfPath, a, b, { radial: 72, step: 0.6, frontNormals: true, axisAttr: true }), mat));\n265\t      // glossy magenta flow sheet lining the tube floor under the stream (refs 05/07 pink banks)\n266\t      zones.tubes.add(new THREE.Mesh(buildTubeGeometry(perfPath, a, b, { radial: 24, step: 0.8, arc: 1.9, inset: -0.12, vScale: 6, frontNormals: true }), pinkFlow.material));\n267\t    }\n268\t  };\n269\t  addWall(s05, sGlow05, perf05Mat);\n270\t  addWall(sGlow05, s08, perfTubeMat);\n271\t  // 06/07 rings and the 04→05 junction collar (unchanged look)\n272\t  const ringMat = withTubeStrips(withFarGlow(gold({ color: '#ffc890', roughness: 0.12, emissive: 0.16 }), tubeGlow, 'ring'), { ...strips, color: '#fff0c8', intensity: 3.2 }, 'instance', 'ring');\n273\t  ringMat.envMap = goldEnv;\n274\t  ringMat.envMapIntensity = 1.3;\n275\t  // ref 05 rings: polished YELLOW gold — pale-yellow highlights (#FCE082), gold mids (#F4B70F…#F9A640),\n276\t  // copper only on the shadowed side — from a yellow F0, little flat emissive (it flattened the band to\n277\t  // one orange) and the rounded double-lip band (bandGeometry) whose crown, groove and lip catch the\n278\t  // strip lights as marquee spots\n279\t  const goldEnv05 = washerTubeEnv('gold05');\n280\t  const gold05 = (key: string, virtual: boolean) => {\n281\t    const m = withTubeStrips(withFarGlow(gold({ color: '#ffd45c', roughness: 0.13, emissive: 0.1 }), glow05, key, virtual), { ...strips, color: '#fff2c8', intensity: 2.6, width: 0.016 }, 'instance', key);\n282\t    m.emissive.set('#e08a10');\n283\t    m.envMap = goldEnv05;\n284\t    m.envMapIntensity = 1.15;\n285\t    return m;\n286\t  };\n287\t  const ringMat05 = gold05('ring05', false);\n288\t  const collar = { depth: 0.022, lip: 0.012, width: 1.1 };\n289\t  const band05 = { height: 0.095, width: 0.78, lipHeight: 0.045, lipWidth: 0.26, groove: 0.07 };\n290\t  // gold junction collar 04→05 (slightly heavier)\n291\t  zones.tubes.add(buildRings(perfPath, s05 + 0.3, s05 + 0.31, 1, ringMat, { inset: 0.02, collar: { depth: 0.03, lip: 0.014, width: 1.3 } }));\n292\t  zones.tubes.add(buildRingsAt(perfPath, rings05, ringMat05, { inset: 0.02, band: band05 }));\n293\t  const rings0607: number[] = [];\n294\t  for (let s = s06 + RING06_PHASE - 2 * ringSpacing; s <= s08 - 1 + 1e-6; s += ringSpacing) if (s >= sGlow05 + 4) rings0607.push(s);\n295\t  zones.tubes.add(buildRingsAt(perfPath, rings0607, ringMat, { inset: 0.02, collar }));\n296\t  // copper nozzle lids: 