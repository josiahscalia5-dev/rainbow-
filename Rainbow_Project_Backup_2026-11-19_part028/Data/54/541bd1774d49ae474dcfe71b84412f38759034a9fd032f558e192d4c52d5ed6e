l },\n  river,\n};\nmkdirSync('qa/worldlabs/05/blender', { recursive: true });\nwriteFileSync('qa/worldlabs/05/blender/river05_layout.json', JSON.stringify(out));\nconsole.log('river samples', river.length, '| tunnel', JSON.stringify(out.tunnel), '| checkpoint s', cpS.toFixed(2));\n/** Final colour grade (display space): saturation / contrast / gentle vignette for the candy look. */\nimport * as THREE from 'three';\nimport { ShaderPass } from 'three/examples/jsm/postprocessing/ShaderPass.js';\n\nexport function createGradePass(opts: { saturation?: number; contrast?: number; vignette?: number } = {}) {\n  return new ShaderPass({\n    uniforms: {\n      tDiffuse: { value: null },\n      uSat: { value: opts.saturation ?? 1.36 },\n      uCon: { value: opts.contrast ?? 1.15 },\n      uVig: { value: opts.vignette ?? 0.18 },\n    },\n    vertexShader: /* glsl */ `varying vec2 vUv; void main(){ vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position,1.0); }`,\n    fragmentShader: /* glsl */ `\n      uniform sampler2D tDiffuse; uniform float uSat; uniform float uCon; uniform float uVig; varying vec2 vUv;\n      void main(){\n        vec4 c = texture2D(tDiffuse, vUv);\n        float l = dot(c.rgb, vec3(0.2126, 0.7152, 0.0722));\n        vec3 col = mix(vec3(l), c.rgb, uSat);\n        col = (col - 0.5) * uCon + 0.5;\n        vec2 d = vUv - 0.5; d.x *= 0.75;\n        col *= 1.0 - uVig * smoothstep(0.25, 0.75, length(d));\n        gl_FragColor = vec4(clamp(col, 0.0, 1.0), c.a);\n      }`,\n  } as unknown as THREE.ShaderMaterialParameters);\n}", "is_error": false, "tool_use_id": "toolu_01SZa9qCdQ1uVYsZB7rWgBF4", "type": "tool_result"}], "role": "user"}, "parentUuid": "128b1cf8-107e-4dda-bba3-603d319e948c", "permissionDecision": {"decision": "accept", "reasonType": "rule", "ruleSource": "cliArg", "source": "config"}, "promptId": "26387c80-5233-45ab-924c-c03d399e25e5", "sandboxed": false, "sessionId": "128ab5f6-c64f-55d7-bb6f-9279e02dca8d", "sourceToolAssistantUUI