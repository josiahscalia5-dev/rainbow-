<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<style>html,body{margin:0;background:#000;overflow:hidden} #bg{position:fixed;left:0;top:0;width:100vw;height:100vh}</style></head>
<body><img id="bg" alt="">
<script type="module">
// HUD-only harness (no WebGL): the REAL src/ui/hud.ts over a no-HUD game capture of the same locked 05 frame, so the
// DOM layer can be measured against the approved picture in seconds. Final numbers always come from real game captures.
import { createHud } from '/src/ui/hud.ts';
const q = new URLSearchParams(location.search);
const bg = document.getElementById('bg');
bg.src = q.get('bg') || '/qa/pilot05/full_reference_match/hud/harness_bg_stack_nohud.png';
const hud = createHud();
hud.setStage('05'); hud.setCoins(Number(q.get('coins') || 1420)); hud.setHearts(5); hud.setVisible(true);
await bg.decode();
await Promise.all([...document.querySelectorAll('#hud img')].map((i) => i.decode().catch(() => {})));
await document.fonts.ready;
window.__hudReady = true;
</script></body></html>
