{"agentId": "aea1b9944be07aee7", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "claude/rainbow-restore-c9-40w64b", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Screen 04 milestone M4 (round 8, qa/match/04/NOTES.md) — sub-switches of `?match04=1`, each `&m04…=1`, default off:\n3\t *  m04ring  — the gold washer opening and the gold-ring tunnel as REAL modeled geometry (lathe profiles sized from the\n4\t *             approved picture's mouth ring r 3.58 → 4.11 and the painted stacked ring bands), shaded as polished gold\n5\t *             (warm glow down the tunnel, pink / violet / cyan water reflections on the lower walls, glints, a row of\n6\t *             amber bulbs on the opening and on every ring lip). In the approved view these surfaces show the approved\n7\t *             pixels (camera projection, unchanged); they fade to their own crisp 3D gold as the camera leaves that view.\n8\t *  m04foam  — puffy 3D foam banks along both water edges (the painted white-lilac foam clusters), hidden in the approved\n9\t *             view (the painting carries them there), shown once the camera has left it.\n10\t *  m04bub   — iridescent soap bubbles floating in the tunnel air (camera-facing bubble discs), same visibility rule.\n11\t *  m04arrow — the five glowing blue chevron arrows drawn crisp on the water (distance-field shape at the painted\n12\t *             spacing) instead of the magnified painted arrow tile.\n13\t *  m04wave  — the painted swirl water without the obvious repeat (two offset samples of the swirl tile blended by a\n14\t *             slow world-anchored noise) and flowing down the slide.\n15\t * Without `?match04=1` nothing here runs; without the sub-switches nothing here is built.\n16\t */\n17\timport * as THREE from 'three';\n18\timport { PROJ05_INVERSE } from '../vfx/waterRibbon';\n19\t\n20\tconst QS = new URLSearchParams(location.search);\n21\tconst on = (k: string) => QS.get(k) === '1';\n22\texport const M04 = {\n23\t  ring: on('m04ring'),\n24\t  foam: on('m04foam'),\n25\t  bub: on('m04bub'),\n26\t  arrow: on('m04arrow'),\n27\t  wave: on('m04wave'),\n28\t  river: on('m04river'),\n29\t  gold: on('m04gold'),\n30\t  num: (k: string, d: number) => (QS.has(k) ? Number(QS.get(k)) : d),\n31\t};\n32\t\n33\texport interface M04Ctx {\n34\t  group: THREE.Group;\n35\t  shared: Record<string, THREE.IUniform>;\n36\t  proj: THREE.PerspectiveCamera;\n37\t  /** tube axis in group-local coordinates (x lateral, y up from the slide, z = -down the slide) */\n38\t  cx: number; cy: number; z0: number; len: number; r: number; outerR: number;\n39\t  hideOld: (names: string[]) => void;\n40\t}\n41\t\n42\tconst VERT = /* glsl */ `\n43\tuniform mat4 uProjVP;\n44\tattribute vec2 aK;\n45\tvarying vec4 vProj;\n46\tvarying vec3 vW;\n47\tvarying vec3 vN;\n48\tvarying vec2 vK;\n49\tvoid main() {\n50\t  vec4 wp = modelMatrix * vec4(position, 1.0);\n51\t  vProj = uProjVP * wp;\n52\t  vW = wp.xyz;\n53\t  vK = aK;\n54\t  vN = normalize(mat3(modelMatrix) * normal);\n55\t  gl_Position = projectionMatrix * viewMatrix * wp;\n56\t}`;\n57\t\n58\t// polished gold, art-directed in DISPLAY colours measured on the approved picture (then pjInverse like the plate):\n59\t// groove (110,35,5) / shadow band (168,70,18) / mid (205,97,28) / lit (245,143,38) / hot lip (255,204,77) / glint.\n60\t// Each ring = a broad polished band that brightens toward its lip, a bright rounded lip with hot spots, a thin dark groove;\n61\t// the far rings warm toward the glowing vanishing point; violet / pink water reflections on the lower walls.\n62\tconst GOLD_FRAG = /* glsl */ `\n63\tuniform sampler2D uPlate;\n64\tuniform vec4 uPjPost;\n65\tuniform vec2 uPjRes;\n66\tuniform float uAway;\n67\tuniform vec3 uAxO;\n68\tuniform vec3 uAxD;\n69\tuniform vec3 uAxU;\n70\tuniform vec3 uAxR;\n71\tuniform float uNB;\n72\tuniform float uP;\n73\tuniform float uLipBulb;\n74\tuniform float uBulbR;\n75\tuniform float uLen;\n76\tuniform vec4 uTone;        // band base, lip base, opening base, streak strength\n77\tuniform sampler2D uRingTile; // tile_ring.png: the painted ring colour at every angle (rows 56..176 = band near edge .. lip)\n78\tuniform float uPaint;      // how much of the painted ring colour drives the bands (m04paint)\n79\tuniform float uGoldY;      // m04gold: polished YELLOW-gold ramp (bright yellow-white highlights), fewer magenta tints\n80\tvarying vec4 vProj;\n81\tvarying vec3 vW;\n82\tvarying vec3 vN;\n83\tvarying vec2 vK;            // x: part (0 band, 1 lip, 2 groove, 3 opening face, 4 end glow), y: ring index (-1 = opening)\n84\t${PROJ05_INVERSE}\n85\tfloat h21(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }\n86\tvec3 goldRamp(float x) {\n87\t  x = clamp(x, 0.0, 1.0) * 5.0;\n88\t  vec3 c0 = vec3(0.43, 0.14, 0.02), c1 = vec3(0.66, 0.27, 0.07), c2 = vec3(0.80, 0.38, 0.11);\n89\t  vec3 c3 = vec3(0.96, 0.56, 0.15), c4 = vec3(1.0, 0.80, 0.30), c5 = vec3(1.0, 0.96, 0.80);\n90\t  if (x < 1.0) return mix(c0, c1, x);\n91\t  if (x < 2.0) return mix(c1, c2, x - 1.0);\n92\t  if (x < 3.0) return mix(c2, c3, x - 2.0);\n93\t  if (x < 4.0) return mix(c3, c4, x - 3.0);\n94\t  return mix(c4, c5, x - 4.0);\n95\t}\n96\tvec3 goldRampY(float x) {\n97\t  x = clamp(x, 0.0, 1.0) * 5.0;\n98\t  vec3 c0 = vec3(0.52, 0.22, 0.03), c1 = vec3(0.76, 0.40, 0.07), c2 = vec3(0.89, 0.55, 0.12);\n99\t  vec3 c3 = vec3(0.98, 0.72, 0.20), c4 = vec3(1.0, 0.87, 0.42), c5 = vec3(1.0, 0.98, 0.86);\n100\t  if (x < 1.0) return mix(c0, c1, x);\n101\t  if (x < 2.0) return mix(c1, c2, x - 1.0);\n102\t  if (x < 3.0) return mix(c2, c3, x - 2.0);\n103\t  if (x < 4.0) return mix(c3, c4, x - 3.0);\n104\t  return mix(c4, c5, x - 4.0);\n105\t}\n106\t// a few long highlight streaks around the ring (painted smears), different on every ring\n107\tfloat streaks(float ang, float ring) {\n108\t  float s = 0.0;\n109\t  for (int i = 0; i < 4; i++) {\n110\t    float fi = float(i);\n111\t    float c = (h21(vec2(ring, f