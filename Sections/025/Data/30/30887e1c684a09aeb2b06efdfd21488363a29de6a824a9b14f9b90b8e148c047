{"cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-251ed97c-ty2xvp", "isSidechain": false, "message": {"content": [{"content": "1\t#!/usr/bin/env python3\n2\t\"\"\"RAINBOW five-minute GitHub autosave.\n3\t\n4\tRun by cron (*/5), by Claude Code hooks (SessionStart / PreCompact / Stop / SessionEnd)\n5\tor by hand:  python3 scripts/rainbow-autosave.py [--reason manual] [--message \"milestone: …\"]\n6\t\n7\tEach run:\n8\t  1. validates repo identity (remote URL) and target branch from backups/autosave.config.json\n9\t  2. takes an exclusive lock and skips if another git operation is in progress\n10\t  3. refreshes sanitized Claude transcripts (only after verifying the GitHub repo is PRIVATE),\n11\t     backups/MANIFEST.json and the agent roster\n12\t  4. stages ONLY allow-listed paths (respecting .gitignore), scans staged text for secrets,\n13\t     enforces LFS for large binaries\n14\t  5. commits with a timestamp when real changes exist (status/log-only changes never commit)\n15\t  6. pushes (no force, ever) with retries and verifies the remote branch SHA == local HEAD\n16\t  7. records the result in the LIVE log (backups/.live/, git-ignored). The tracked copies\n17\t     backups/BACKUP_STATUS.json / BACKUP_LOG.md are refreshed from the live copies only inside a real\n18\t     commit, so a run never leaves the working tree dirty (no endless \"uncommitted changes\" prompts).\n19\tNever force-pushes, hard-resets, deletes files or rewrites history.\n20\t\"\"\"\n21\tfrom __future__ import annotations\n22\t\n23\timport argparse\n24\timport datetime as dt\n25\timport fcntl\n26\timport fnmatch\n27\timport hashlib\n28\timport json\n29\timport os\n30\timport re\n31\timport subprocess\n32\timport sys\n33\timport time\n34\timport urllib.request\n35\tfrom pathlib import Path\n36\t\n37\tREPO = Path(__file__).resolve().parents[1]\n38\tCFG = json.loads((REPO / \"backups\" / \"autosave.config.json\").read_text())\n39\tTRACKED_STATUS = REPO / \"backups\" / \"BACKUP_STATUS.json\"\n40\tTRACKED_LOG = REPO / \"backups\" / \"BACKUP_LOG.md\"\n41\tLIVE = REPO / \"backups\" / \".live\"\n42\tSTATUS = LIVE / \"BACKUP_STATUS.json\"\n43\tLOG = LIVE / \"BACKUP_LOG.md\"\n44\tLOCK = REPO / \"backups\" / \".autosave.lock\"\n45\tTRAILER = \"\\n\\n\" + CFG.get(\"commit_trailer\", \"Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\")\n46\tSECRET_PATTERNS = [\n47\t    re.compile(r\"-----BEGIN [A-Z ]*PRIVATE KEY-----\"),\n48\t    re.compile(r\"\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{30,}\\b\"),\n49\t    re.compile(r\"\\bgithub_pat_[A-Za-z0-9_]{30,}\\b\"),\n50\t    re.compile(r\"\\bsk-ant-[A-Za-z0-9_\\-]{20,}\"),\n51\t    re.compile(r\"\\bAKIA[0-9A-Z]{16}\\b\"),\n52\t    re.compile(r\"\\bxox[abposr]-[A-Za-z0-9\\-]{20,}\"),\n53\t    re.compile(r\"\\bAIza[0-9A-Za-z_\\-]{35}\"),\n54\t    re.compile(r\"\\bmsy_[A-Za-z0-9_\\-]{20,}\"),\n55\t]\n56\t_PT = Path(os.path.expanduser(\"~/.rainbow-autosave.private-terms\"))\n57\tPRIVATE_TERMS = [t.strip() for t in _PT.read_text().splitlines() if len(t.strip()) >= 4] if _PT.exists() else []\n58\tTEXT_EXT = {\".md\", \".json\", \".jsonl\", \".ts\", \".js\", \".mjs\", \".cjs\", \".py\", \".sh\", \".html\", \".css\",\n59\t            \".glsl\", \".txt\", \".yml\", \".yaml\", \".toml\", \".xml\", \".gradle\", \".properties\", \".kts\", \".csv\"}\n60\t\n61\t\n62\tdef now_utc() -> dt.datetime:\n63\t    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0)\n64\t\n65\t\n66\tdef git(*args: str, check: bool = True, timeout: int = 180) -> subprocess.CompletedProcess:\n67\t    p = subprocess.run([\"git\", *args], cwd=REPO, capture_output=True, text=True, timeout=timeout)\n68\t    if check and p.returncode != 0:\n69\t        raise RuntimeError(f\"git {' '.join(args)} failed ({p.returncode}): {p.stderr.strip()[:800]}\")\n70\t    return p\n71\t\n72\t\n73\tdef seed_live() -> None:\n74\t    \"\"\"First run in a fresh checkout: start the live log/status from the tracked copies.\"\"\"\n75\t    LIVE.mkdir(parents=True, exist_ok=True)\n76\t    for live, tracked in ((STATUS, TRACKED_STATUS), (LOG, TRACKED_LOG)):\n77\t        if not live.exists() and tracked.exists():\n78\t            live.write_text(tracked.read_text())\n79\t\n80\t\n81\tdef sync_tracked_from_live() -> None:\n82\t    \"\"\"Copy the live log/status into the tracked files (called only right before a real commit).\"\"\"\n83\t    for live, tracked in ((STATUS, TRACKED_STATUS), (LOG, TRACKED_LOG)):\n84\t        if live.exists():\n85\t            tracked.write_text(live.read_text())\n86\t\n87\t\n88\tdef load_status() -> dict:\n89\t    try:\n90\t        return json.loads(STATUS.read_text())\n91\t    except Exception:\n92\t        return {}\n93\t\n94\t\n95\tdef append_log(row: dict) -> None:\n96\t    if not LOG.exists():\n97\t        LOG.write_text(\n98\t            \"# Rainbow autosave log\\n\\nNewest last. `pushed` = remote SHA verified equal to local HEAD.\\n\\n\"\n99\t            \"| Time (UTC) | Reason | Result | Commit | Branch | Files staged | Pushed+verified | Error |\\n\"\n100\t            \"|---|---|---|---|---|---|---|---|\\n\")\n101\t    with LOG.open(\"a\") as fh:\n102\t        fh.write(\n103\t            f\"| {row['time']} | {row['reason']} | {row['result']} | `{(row.get('commit') or '—')[:12]}` | \"\n104\t            f\"`{row.get('branch', '—')}` | {row.get('files_staged', 0)} | {row.get('pushed_verified', False)} | \"\n105\t            f\"{(row.get('error') or '').replace('|', '/')[:300]} |\\n\")\n106\t\n107\t\n108\tdef write_status(st: dict) -> None:\n109\t    tmp = STATUS.with_suffix(\".tmp\")\n110\t    tmp.write_text(json.dumps(st, indent=2) + \"\\n\")\n111\t    os.replace(tmp, STATUS)\n112\t\n113\t\n114\tdef verify_private() -> bool | None:\n115\t    \"\"\"True/False if GitHub reports the repo privacy, None if it could not be checked.\"\"\"\n116\t    try:\n117\t        req = urllib.request.Request(f\"https://api.github.com/repos/{CFG['repo_full_name']}\",\n118\t                                     headers={\"Accept\": \"application/vnd.github+json\",\n119\t                                              \"User-Agent\": \"rainbow-autosave\"})\n120\t        with urllib.request.urlopen(req, timeout=20) as r:\n121\t            data = json.loads(r.read().decode())\n122\t        if data.get(\"full_name\") != CFG[\"repo_full_name\"]:\n123\t            return None\n124\t        return bool(data.get(\"private\"))\n125\t    except Exception:\n126\t        return None\n127\t\n128\t\n129\tdef refresh_manifest() -> None:\n130\t    \"\"\"Small manifest of tracked/allow-listed files (path, bytes, sha256) for recovery checks.\"\"\"\n131\t    rows = []\n132\t    for rel in sorted(allowlisted_files()):\n133\t        p = REPO / rel\n134\t        if not p.is_file() or rel.startswith(\"backups/claude-sessions/\") or rel in CFG[\"status_only_paths\"] \\\n135\t                or rel == \"backups/MANIFEST.json\":\n136\t            continue\n137\t        data = p.read_bytes()\n138\t        lfs = lfs_pointer(data)\n139\t        if lfs:\n140\t            # Content not fetched yet (pointer stub): record the real object's hash/size, not the stub's,\n141\t            # so a backup taken before `git lfs pull` never regresses the manifest.\n142\t            rows.append({\"path\": rel, \"bytes\": lfs[1], \"sha256\": lfs[0], \"lfs_pointer_only\": True})\n143\t            continue\n144\t        rows.append({\"path\": rel, \"bytes\": len(data), \"sha256\": hashlib.sha256(data).hexdigest()})\n145\t    text = json.dumps({\"project\": CFG[\"project\"], \"files\": rows}, indent=1) + \"\\n\"\n146\t    mp = REPO / \"backups\" / \"MANIFEST.json\"\n147\t    if not mp.exists() or mp.read_text() != text:\n148\t        mp.write_text(text)\n149\t\n150\t\n151\tdef lfs_pointer(data: bytes) -> tuple[str, int] | None:\n152\t    \"\"\"(oid, size) if `data` is a Git LFS pointer stub, else None.\"\"\"\n153\t    if len(data) > 1024 or not data.startswith(b\"version https://git-lfs.github.com/spec/v1\"):\n154\t        return None\n155\t    m = re.search(rb\"oid sha256:([0-9a-f]{64})\\s+size (\\d+)\", data)\n156\t    return (m.group(1).decode(), int(m.group(2))) if m else None\n157\t\n158\t\n159\tdef allowlisted_files() -> list[str]:\n160\t    \"\"\"Allow-listed files that git would track (tracked + untracked-not-ignored).\"\"\"\n161\t    out = git(\"ls-files\", \"--cached\", \"--others\", \"--exclude-standard\", \"-z\", \"--\", *CFG[\"allowlist\"],\n162\t              check=False).stdout\n163\t    return [x for x in out.split(\"\\0\") if x and (REPO / x).exists()]\n164\t\n165\t\n166\tdef lfs_tracked(rel: str) -> bool:\n167\t    out = git(\"check-attr\", \"filter\", \"--\", rel, check=False).stdout\n168\t    return out.strip().endswith(\": lfs\")\n169\t\n170\t\n171\tdef scan_and_guard(staged: list[str]) -> list[str]:\n172\t    \"\"\"Unstage files containing secrets or oversized non-LFS binaries. Returns problems.\"\"\"\n173\t    problems = []\n174\t    limit = CFG[\"max_plain_git_file_mb\"] * 1024 * 1024\n175\t    for rel in staged:\n176\t        p = REPO / rel\n177\t        if not p.is_file():\n178\t            continue\n179\t        size = p.stat().st_size\n180\t        if size > limit and not lfs_tracked(rel):\n181\t            git(\"reset\", \"-q\", \"--\", rel, check=False)\n182\t            problems.append(f\"{rel}: {size/1e6:.1f}MB exceeds plain-git limit and is not LFS-tracked (NOT backed up — add an LFS pattern)\")\n183\t            continue\n184\t        if p.suffix.lower() in TEXT_EXT and size < 20 * 1024 * 1024:\n185\t            try:\n186\t                txt = p.read_text(encoding=\"utf-8\", errors=\"ignore\")\n187\t            except Exception:\n188\t                continue\n189\t            hit = next((pat.pattern[:30] for pat in SECRET_PATTERNS if pat.search(txt)), None)\n190\t            if hit is None and any(t in txt for t in PRIVATE_TERMS):\n191\t                hit = \"private term (~/.rainbow-autosave.private-terms)\"\n192\t            if hit:\n193\t                git(\"reset\", \"-q\", \"--\", rel, check=False)\n194\t                problems.append(f\"{rel}: possible secret/private data ({hit}) — unstaged, NOT backed up\")\n195\t    return problems\n196\t\n197\t\n198\tdef push_and_verify(branch: str) -> tuple[bool, str]:\n199\t    err = \"\"\n200\t    for attempt in range(CFG[\"push_retries\"] + 1):\n201\t        p = git(\"push\", \"-u\", CFG[\"remote_name\"], f\"HEAD:refs/heads/{branch}\", check=False, timeout=600)\n202\t        if p.returncode == 0:\n203\t            break\n204\t        err = p.stderr.strip()[-600:]\n205\t        if \"non-fast-forward\" in err or \"fetch first\" in err or \"rejected\" in err:\n206\t            # someone else pushed: integrate without discarding anything; abort on conflict\n207\t            git(\"fetch\", CFG[\"remote_name\"], branch, check=False, timeout=300)\n208\t            m = git(\"merge\", \"--no-edit\", f\"{CFG['remote_name']}/{branch}\", check=False)\n209\t            if m.returncode != 0:\n210\t                git(\"merge\", \"--abort\", check=False)\n211\t                return False, \"remote branch diverged and merge conflicted; local commit kept, manual merge needed\"\n212\t        time.sleep(2 ** (attempt + 1))\n213\t    else:\n214\t        return False, f\"push failed after retries: {err}\"\n215\t    head = git(\"rev-parse\", \"HEAD\").stdout.strip()\n216\t    ls = git(\"ls-remote\", CFG[\"remote_name\"], f\"refs/heads/{branch}\", check=False, timeout=120)\n217\t    remote_sha = ls.stdout.split()[0] if ls.stdout.strip() else \"\"\n218\t    if remote_sha != head:\n219\t        return False, f\"remote verification mismatch: remote={remote_sha or 'none'} local={head}\"\n220\t    return True, \"\"\n221\t\n222\t\n223\tdef main() -> int:\n224\t    ap = argparse.ArgumentParser()\n225\t    ap.add_argument(\"--reason\", default=\"manual\")\n226\t    ap.add_argument(\"--message\", default=\"\")\n227\t    ap.add_argument(\"--no-push\", action=\"store_true\")\n228\t    a