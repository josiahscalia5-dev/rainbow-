{"agentId": "a589db1976a40894d", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-8b6fc834-7kd55l", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Spline water ribbon — the traversable stream Benny rides from the Drum A drain to the towel.\n3\t *\n4\t * Geometry: rows every `ds` along the master course, columns across `widthAt(s)`; a slightly\n5\t * concave trough with raised frothy edges plus a short skirt under each edge (thickness).\n6\t * Shader: electric-cyan core with meandering hot-pink flow bands, advected white streaks and\n7\t * sparkles (two-phase flow-map advection so per-stage speeds never shear), Fresnel/haze\n8\t * reflection, specular glints, cellular soap-foam fringe, Benny ripple rings + V-wake, the five\n9\t * glowing chevrons on the 04 slide, a dithered hand-over to the whirlpool surface in 03 and a\n10\t * drain-away for the 11 outro.\n11\t */\n12\timport * as THREE from 'three';\n13\timport type { Course, StageId } from '../world/course';\n14\timport { FRAG_FX_GLSL, FRAG_TAIL, NOISE_GLSL, PALETTE, withFog } from './glsl';\n15\t\n16\t/** wave amplitude per stage (units); blended across boundaries */\n17\tconst AMP: Partial<Record<StageId, number>> = {\n18\t  '02': 0.06, '03': 0.08, '04': 0.03, '05': 0.1, '06': 0.12, '07': 0.1, '08': 0.1, '09': 0.16, '10': 0.08, '11': 0.05,\n19\t};\n20\texport const EDGE_LIFT = 0.28;\n21\t\n22\texport function ampAt(course: Course, s: number): number {\n23\t  let v = 0, w = 0;\n24\t  for (const st of course.stages) {\n25\t    const a = smooth(st.s0 - 5, st.s0 + 5, s) * (1 - smooth(st.s1 - 5, st.s1 + 5, s));\n26\t    if (a > 0) { v += (AMP[st.id] ?? 0.08) * a; w += a; }\n27\t  }\n28\t  let amp = w > 0 ? v / w : 0.08;\n29\t  // calm the long straight of the deep plunge (fast sheet flow)\n30\t  const pt = course.marks['07_plunge_top'], pb = course.marks['07_plunge_bottom'];\n31\t  if (pt !== undefined) amp *= 1 - 0.6 * smooth(pt, pt + 8, s) * (1 - smooth(pb - 8, pb, s));\n32\t  return amp;\n33\t}\n34\t\n35\tfunction smooth(a: number, b: number, x: number) {\n36\t  const t = Math.min(1, Math.max(0, (x - a) / (b - a)));\n37\t  return t * t * (3 - 2 * t);\n38\t}\n39\t\n40\t/** CPU mirror of the vertex displacement (keep in sync with VERT). */\n41\texport function ribbonWave(u: number, s: number, t: number, amp: number): number {\n42\t  const au = Math.min(1, Math.abs(u));\n43\t  const trough = EDGE_LIFT * au * au * au;\n44\t  return trough + amp * (0.6 * Math.sin(s * 0.9 - t * 2.4 + u * 1.7) + 0.4 * Math.sin(s * 0.41 + t * 1.5 - u * 2.3));\n45\t}\n46\t\n47\tconst VERT = /* glsl */ `\n48\tattribute vec2 aUV;      // x = u (-1..1 across), y = s (arc length)\n49\tattribute float aHalfW;\n50\tattribute float aSpeed;\n51\tattribute float aAmp;\n52\tattribute float aSkirt;  // 0 surface, 1 skirt bottom\n53\tuniform float uTime;\n54\tuniform vec4 uHide;      // s03Start, s04Start, chuteMark, unused\n55\tvarying vec2 vUV;\n56\tvarying float vHalfW;\n57\tvarying float vSpeed;\n58\tvarying float vSkirt;\n59\tvarying float vHide;\n60\tvarying vec3 vPosW;\n61\tvarying vec3 vNormalW;\n62\t#include <fog_pars_vertex>\n63\tvoid main() {\n64\t  float u = aUV.x;\n65\t  float s = aUV.y;\n66\t  float h = aAmp * (0.6 * sin(s * 0.9 - uTime * 2.4 + u * 1.7) + 0.4 * sin(s * 0.41 + uTime * 1.5 - u * 2.3));\n67\t  vec3 p = position + normal * h * (1.0 - aSkirt);\n68\t  vec4 wp = modelMatrix * vec4(p, 1.0);\n69\t  vPosW = wp.xyz;\n70\t  vNormalW = normalize(mat3(modelMatrix) * normal);\n71\t  vUV = aUV;\n72\t  vHalfW = aHalfW;\n73\t  vSpeed = aSpeed;\n74\t  vSkirt = aSkirt;\n75\t  // hand the stream over to the whirlpool surface during 03 (dithered fade both ways)\n76\t  float inside03 = smoothstep(uHide.x + 0.5, uHide.x + 3.5, s) * (1.0 - smoothstep(uHide.y - 9.0, uHide.y - 1.5, s));\n77\t  vHide = 1.0 - inside03;\n78\t  vec4 mvPosition = viewMatrix * wp;\n79\t  gl_Position = projectionMatrix * mvPosition;\n80\t  #include <fog_vertex>\n81\t}\n82\t`;\n83\t\n84\tconst FRAG = /* glsl */ `\n85\tuniform float uTime;\n86\tuniform vec3 uCyanDeep;\n87\tuniform vec3 uCyan;\n88\tuniform vec3 uCyanBright;\n89\tuniform vec3 uPink;\n90\tuniform vec3 uPinkLight;\n91\tuniform vec3 uFoam;\n92\tuniform vec3 uFoamLav;\n93\tuniform vec3 uHaze;\n94\tuniform vec3 uLightDir;\n95\tuniform vec3 uBenny;      // s, lateral (units), strength\n96\tuniform float uBennyR;    // Benny's waterline radius (units)\n97\tuniform vec3 uChevron;    // start s, spacing, enabled\n98\tuniform vec2 uOutro;      // amount, chamber start s\n99\tvarying vec2 vUV;\n100\tvarying float vHalfW;\n101\tvarying float vSpeed;\n102\tvarying float vSkirt;\n103\tvarying float vHide;\n104\tvarying vec3 vPosW;\n105\tvarying vec3 vNormalW;\n106\t#include <fog_pars_fragment>\n107\t${NOISE_GLSL}\n108\t${FRAG_FX_GLSL}\n109\t\n110\t// Stationary channel shape (refs 05–07): u-centre of the electric-cyan core. It only drifts slowly\n111\t// downstream at a constant rate (no shear between stage speeds); the strand texture below is what\n112\t// is advected at the local stage speed.\n113\tfloat meander(float s) {\n114\t  float a = s - uTime * 0.9;\n115\t  return 0.16 * sin(a * 0.24) + 0.07 * sin(a * 0.55 + 1.3) + 0.16 * (vnoise(vec2(a * 0.055, 4.7)) - 0.5);\n116\t}\n117\t\n118\t// advected strand texture (\"combed\" glossy water lines parallel to the flow)\n119\t// x = lateral units relative to the meander centre, v = advected arc length, aa = 0..1 detail fade\n120\t// returns: x = height 0..1 (shading + bump), y = white glint lines, z = mid strands, w = fine strands\n121\tvec4 strands(float x, float v, vec2 aa) {\n122\t  float a = vnoise(vec2(x * 2.4, v * 0.08));\n123\t  float b = vnoise(vec2(x * 7.0 + a * 1.6, v * 0.19 + 5.0));\n124\t  #ifdef LOW_Q\n125\t  float c = b;\n126\t  #else\n127\t  float c = vnoise(vec2(x * 17.0 + b * 2.2, v * 0.42 + 3.0));\n128\t  #endif\n129\t  b = mix(0.5, b, aa.x);\n130\t  c = mix(0.5, c, aa.y);\n131\t  float h = a * 0.5 + b * 0.32 + c * 0.18;\n132\t  h = smoothstep(0.18, 0.82, h);              // more contrast: deep azure troughs, bright crests\n133\t  float line = smoothstep(0.72, 0.86, c) * aa.y + smoothstep(0.78, 0.9, b) * aa.x * 0.6;\n134\t  return vec4(h, line, b, c);\n135\t}\n136\t\n137\tvoid main() {\n138\t  float u = vUV.x;\n139\t  float s = vUV.y;\n140\t  // dithered hide (03 hand-over)\n141\t  if (vHide < 0.5) discard;\n142\t  float cutFoam = 1.0 - smoothstep(0.5, 0.85, vHide);\n143\t  // 11 outro: the stream drains away in the chamber, leaving puddles\n144\t  if (uOutro.x > 0.0 && s > uOutro.y - 2.0) {\n145\t    float n = vnoise(vec2(u * 3.0, s * 0.35)) * 0.7 + 0.3;\n146\t    if (n < uOutro.x * 1.15) discard;\n147\t  }\n148\t\n149\t  // ---- channel layout: cyan core winding inside hot-pink side bands ----\n150\t  float M = meander(s);\n151\t  float q = u - M;\n152\t  float x = q * vHalfW;                       // lateral units in the core's frame\n153\t  float lat = u * vHalfW;                     // lateral units in the ribbon frame\n154\t\n155\t  // detail fade with distance (cells per pixel), keeps far water from shimmering\n156\t  float fwx = fwidth(x);\n157\t  float fws = fwidth(s);\n158\t  vec2 aa = vec2(1.0 - smoothstep(0.08, 0.2, max(fwx * 7.0, fws * 0.19)),\n159\t                 1.0 - smoothstep(0.05, 0.14, max(fwx * 17.0, fws * 0.42)));\n160\t  // hair-fine combed strands for close-up water (refs: dense parallel flow lines)\n161\t  float aaH = 1.0 - smoothstep(0.12, 0.3, fwx * 46.0);\n162\t  #ifdef LOW_Q\n163\t  aa.y = 0.0;\n164\t  aaH = 0.0;\n165\t  #endif\n166\t\n167\t  // two-phase flow-map advection of the strands (period 4 s; offset scales with stage speed)\n168\t  float ph0 = fract(uTime * 0.25);\n169\t  float ph1 = fract(uTime * 0.25 + 0.5);\n170\t  float w0 = 1.0 - abs(1.0 - 2.0 * ph0);\n171\t  vec4 F = mix(strands(x, s - vSpeed * ph1 * 4.0 + 23.0, aa), strands(x, s - vSpeed * ph0 * 4.0, aa), w0);\n172\t\n173\t  float coreW = 0.6 + 0.08 * (vnoise(vec2(s * 0.1, 2.0)) - 0.5);\n174\t  // interleave pink/cyan strands along the band boundary (follows the flow)\n175\t  float aq = abs(q) + (F.z - 0.5) * 0.09 + (F.w - 0.5) * 0.05;\n176\t  float pinkBand = smoothstep(coreW - 0.035, coreW + 0.035, aq);\n177\t  // woven ribbons parallel to the flow: thin pink inside the cyan, thin cyan inside the pink\n178\t  float weave = vnoise(vec2(s * 0.045, 9.0));\n179\t  float pinkRib = (1.0 - smoothstep(0.012, 0.035, abs(aq - coreW * 0.58 - 0.05 * sin(s * 0.31)))) * smoothstep(0.42, 0.62, weave);\n180\t  float cyanRib = (1.0 - smoothstep(0.01, 0.03, abs(aq - coreW - 0.16 - 0.03 * sin(s * 0.4 + 2.0)))) * smoothstep(0.45, 0.65, 1.0 - weave);\n181\t  float pinkM = clamp(max(pinkBand, pinkRib) - cyanRib * pinkBand, 0.0, 1.0);\n182\t\n183\t  float h = F.x;\n184\t  float hair = 0.5;\n185\t  if (aaH > 0.0) {\n186\t    float sv = s - vSpeed * fract(uTime * 0.5) * 2.0;\n187\t    float hA = vnoise(vec2(x * 46.0 + F.w * 3.0, sv * 0.9));\n188\t    float hB = vnoise(vec2(x * 46.0 + F.w * 3.0, (sv + vSpeed) * 0.9 + 17.0));\n189\t    hair = mix(0.5, mix(hB, hA, 1.0 - abs(1.0 - 2.0 * fract(uTime * 0.5))), aaH);\n190\t  }\n191\t  vec3 cyanCol = mix(uCyanDeep, uCyan, smoothstep(0.2, 0.5, h));\n192\t  cyanCol = mix(cyanCol, uCyanBright, smoothstep(0.55, 0.85, h));\n193\t  vec3 pinkCol = mix(uPink * 0.8, uPink, smoothstep(0.2, 0.48, h));\n194\t  pinkCol = mix(pinkCol, uPinkLight, smoothstep(0.58, 0.88, h));\n195\t  vec3 col = mix(cyanCol, pinkCol, pinkM);\n196\t  col *= 0.86 + 0.28 * hair;\n197\t  col += vec3(0.9, 1.0, 1.0) * smoothstep(0.8, 0.92, hair) * 0.35 * aaH;\n198\t\n199\t  // ---- glossy lighting ----\n200\t  vec3 N0 = normalize(vNormalW);\n201\t  if (!gl_FrontFacing) N0 = -N0;\n202\t  #ifdef LOW_Q\n203\t  vec3 N = normalize(N0 + 0.25 * vec3(h - 0.5, 0.0, F.z - 0.5));\n204\t  #else\n205\t  float bumpAmt = 0.07 * (1.0 - smoothstep(0.1, 0.5, fws));\n206\t  vec3 N = bumpNormal(vPosW, N0, h * bumpAmt);\n207\t  #endif\n208\t  vec3 V = normalize(cameraPosition - vPosW);\n209\t  float nv = clamp(dot(N, V), 0.0, 1.0);\n210\t  float fres = pow(1.0 - nv, 4.0);\n211\t  vec3 R = reflect(-V, N);\n212\t  vec3 reflTint = mix(uCyanBright * 1.25, uPinkLight * 1.2, pinkM);\n213\t  vec3 refl = mix(reflTint, vec3(1.1), smoothstep(0.35, 0.95, R.y));\n214\t  col = mix(col, refl, fres * 0.35);\n215\t  vec3 L = normalize(uLightDir);\n216\t  vec3 H = normalize(L + V);\n217\t  float spec = pow(clamp(dot(N, H), 0.0, 1.0), 120.0);\n218\t  float sheen = pow(clamp(dot(R, L), 0.0, 1.0), 10.0);\n219\t  col += vec3(1.0) * spec * 1.3 + mix(uCyanBright, uPinkLight, pinkM) * sheen * 0.22;\n220\t  col += vec3(0.95, 1.0, 1.0) * F.y * 0.85;\n221\t\n222\t  // ---- white star glints (4-point, twinkling, carried by the flow) ----\n223\t  #ifdef LOW_Q\n224\t  vec2 g = vec2(lat * 1.2, (s - vSpeed * uTime * 0.6) * 0.8);\n225\t  float hs = hash12(floor(g));\n226\t  float sparkle = step(0.9, hs) * smoothstep(0.22, 0.0, length(fract(g) - 0.5)) * (0.5 + 0.5 * sin(uTime * 7.0 + hs * 40.0));\n227\t  col += vec3(1.3) * sparkle;\n228\t  #else\n229\t  float glint = starGlint(vec2(lat * 1.15, (s - vSpeed * uTime * 0.55) * 0.6), 0.22, 26.0, uTime);\n230\t  col += vec3(1.4) * glint * (1.0 - smoothstep(0.3, 0.8, fws));\n231\t  #endif\n232\t\n233\t  // ---- soap-foam lace where the water meets the foam banks ----\n234\t  float edgeN = (vnoise(vec2(s * 1.3, u * 2.0)) - 0.5) * 0.1;\n235\t  float eu = abs(lat) - vHalfW;               // units from the edge (negative inside)\n236\t  float edge = smoothstep(-0.75, -0.3, eu + edgeN * vHalfW);\n237\t  if (edge > 0.0) {\n238\t    float c = cells(vec2(lat * 3.2, (s - vSpeed * uTime * 0.35) * 3.2));\n239\t    vec3 foamCol = mix(uFoam * 1.15, uFoamLav * 0.85, smoothstep(0.25, 0.75, c));\n240\t    col = mix(col, foamCol, edge * smoothstep(0.05, 0.4, c + edge * 0.3));\n241\t  }\n242\t  col = mix(col, uFoamLav * 0.92, vSkirt);\n243\t  float cutC = cells(vec2(u * vHalfW * 4.0, s * 3.6));\n244\t  col = mix(col, mix(uFoam * 1.2, uFoamLav * 0.8, smoothst