{"agentId": "a98a34c02aaff8fbd", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-937c7fbb-htsrgt", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Foam banks along the stream (refs 03–10) + whirlpool rim foam.\n3\t *  - berm: ONE continuous lumpy lather bank per side, swept along the course (custom shader:\n4\t *    two-scale cellular soap bubbles with derivative bump lighting, lavender crevices, pores,\n5\t *    faint iridescent rim). This is what makes the banks read as continuous foam, not cotton balls.\n6\t *  - puffs: instanced bubble puffs sitting ON the berm crest (silhouette lumps), in ~40-unit chunks\n7\t *    so only chunks near Benny are drawn; quality 'low' halves density and uses 20-tri puffs.\n8\t *  - foam rings on the whirlpool rim and along its spiral bands (rotating with the swirl)\n9\t *  - flank banks (05, wave 4): one CONTINUOUS cloud bank per side that continues the berm down both\n10\t *    sides of the frame to Benny's level (ref 05: banks hugging BOTH edges y≈540–1300): a lather sheet\n11\t *    (berm shader, 1 draw) + world-anchored instanced puffs (1 draw), fitted to the frame edges from\n12\t *    the camera each frame. Replaces wave 3's floating \"flank\"/\"wake\" raft clumps, which read as round\n13\t *    islands on open water. Fixed pools, no per-frame allocation.\n14\t */\n15\timport * as THREE from 'three';\n16\timport { type Course, WORLD, funnelY } from '../world/course';\n17\timport { EDGE_LIFT, coreLateral } from './waterRibbon';\n18\timport { SPIRAL_C, FUNNEL_LIFT } from './whirlpool';\n19\timport { FRAG_FX_GLSL, FRAG_TAIL, NOISE_GLSL, withFog } from './glsl';\n20\t\n21\t/** c = (ambient occlusion 0..1, seed 0..1, tint -1..1) → instanceColor (see PUFF_VERT) */\n22\tinterface Puff { p: THREE.Vector3; r: number; ao: number; tint: number; w5?: number }\n23\t\n24\t// ---------------------------------------------------------------------------------- berm profile\n25\t/** berm spans e ∈ [BERM_IN, BERM_OUT] units outward from the ribbon edge (negative = over the water) */\n26\texport const BERM_IN = -0.6;\n27\texport const BERM_OUT = 1.2;\n28\tconst hash1 = (n: number) => { const x = Math.sin(n * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); };\n29\tconst noise1 = (x: number) => { const i = Math.floor(x), f = x - i, u = f * f * (3 - 2 * f); return hash1(i) * (1 - u) + hash1(i + 1) * u; };\n30\t/** 0..1 lumpiness of the bank at (s, side) — CPU only, baked into the mesh and the puff placement */\n31\texport function bermLump(s: number, side: number): number {\n32\t  return 0.55 * noise1(s * 0.33 + side * 31.7) + 0.45 * noise1(s * 1.05 + side * 7.3);\n33\t}\n34\t/** CPU cellular \"bubble dome\" field (0..1) so the bank silhouette is a pile of round lumps */\n35\texport function bermDomes(s: number, e: number, side: number): number {\n36\t  const gs = s / 0.95, ge = e / 0.62 + side * 11.3;\n37\t  const i0 = Math.floor(gs), j0 = Math.floor(ge);\n38\t  let best = 0;\n39\t  for (let di = -1; di <= 1; di++) for (let dj = -1; dj <= 1; dj++) {\n40\t    const i = i0 + di, j = j0 + dj;\n41\t    const ox = hash1(i * 17.13 + j * 3.71), oy = hash1(i * 5.31 + j * 19.7 + 4.2);\n42\t    const r = 0.45 + 0.4 * hash1(i * 7.7 + j * 13.1 + 9.9);\n43\t    const dx = (i + ox - gs) / r, dy = (j + oy - ge) / r;\n44\t    best = Math.max(best, 1 - (dx * dx + dy * dy));\n45\t  }\n46\t  return Math.max(0, best);\n47\t}\n48\t\n49\t/** height (along course up) of the bank surface at e units outward from the edge */\n50\texport function bermHeight(e: number, hw: number, lump: number): number {\n51\t  const uIn = Math.max(0, (hw + BERM_IN) / hw);\n52\t  const hIn = EDGE_LIFT * uIn * uIn * uIn - 0.07;\n53\t  const ep = 0.08 + 0.22 * lump;\n54\t  const hp = EDGE_LIFT + 0.14 + 0.5 * lump;\n55\t  const hOut = -0.95;\n56\t  if (e <= ep) {\n57\t    const t = Math.min(1, Math.max(0, (e - BERM_IN) / (ep - BERM_IN)));\n58\t    return hIn + (hp - hIn) * (1 - (1 - t) * (1 - t));\n59\t  }\n60\t  const t = Math.min(1, (e - ep) / (BERM_OUT - ep));\n61\t  return hp + (hOut - hp) * t * t;\n62\t}\n63\t\n64\t/** full bank surface height incl. bubble domes (shared by the mesh and the puff placement) */\n65\texport function bermSurface(s: number, e: number, side: number, hw: number): number {\n66\t  const domeK = Math.min(1, Math.max(0, (e + 0.3) / 0.35)) * Math.min(1, Math.max(0, (BERM_OUT - 0.1 - e) / 0.4));\n67\t  return bermHeight(e, hw, bermLump(s, side)) + 0.2 * domeK * Math.sqrt(bermDomes(s, e, side));\n68\t}\n69\t\n70\t/**\n71\t * wave 7: ref 05 soap colour ramp t = 0..1: blue-violet crevice -> blue -> periwinkle -> lavender-white -> white\n72\t * top cap. Stops = the ref 05 rim foam at its 5/20/50/70/90th luminance percentiles ((107,101,234) (117,143,247)\n73\t * (171,184,250) (216,212,251) (250,243,254)) inverted through the display pipeline (Neutral tone map x0.86 ->\n74\t * sRGB -> grade sat 1.36 / contrast 1.15; qa/pilot05/wave6/foam/tools/pipe.py). Only t > 0.8 reaches white.\n75\t * `soapT` = the shared view-space lighting (top-lit from the upper left, like the ref bubbles).\n76\t */\n77\tconst SOAP05_GLSL = /* glsl */ `\n78\tconst vec3 SOAP_CREV = vec3(0.23, 0.22, 0.66);\n79\tvec3 soap05(float t) {\n80\t  t = clamp(t, 0.0, 1.0) * 5.0;\n81\t  vec3 c = mix(SOAP_CREV, vec3(0.26, 0.38, 0.84), clamp(t, 0.0, 1.0));\n82\t  c = mix(c, vec3(0.38, 0.54, 0.97), clamp(t - 1.0, 0.0, 1.0));\n83\t  c = mix(c, vec3(0.56, 0.63, 0.96), clamp(t - 2.0, 0.0, 1.0));\n84\t  c = mix(c, vec3(0.78, 0.79, 0.98), clamp(t - 3.0, 0.0, 1.0));\n85\t  return mix(c, vec3(1.05, 1.03, 1.08), clamp(t - 4.0, 0.0, 1.0));\n86\t}\n87\tfloat soapT(vec3 Nv) {\n88\t  vec3 Lv = normalize(vec3(-0.35, 0.8, 0.5));\n89\t  float wrap = clamp(dot(Nv, Lv) * 0.55 + 0.5, 0.0, 1.0);\n90\t  float up = clamp(Nv.y * 0.5 + 0.5, 0.0, 1.0);\n91\t  return smoothstep(0.1, 0.8, wrap * 0.6 + up * 0.4);\n92\t}\n93\t`;\n94\t\n95\tconst BERM_VERT = /* glsl */ `\n96\tattribute vec3 aFoam;    // x = e (units outward from the stream edge), y = s, z = side (-1 / 1)\n97\tuniform float uTime;\n98\tvarying vec3 vFoam;\n99\tvarying vec3 vPosW;\n100\tvarying vec3 vNormalW;\n101\t#include <fog_pars_vertex>\n102\tvoid main() {\n103\t  // gentle breathing of the lather (never at the water line)\n104\t  float k = smoothstep(-0.2, 0.3, aFoam.x);\n105\t  vec3 p = position + normal * (0.03 * k * sin(uTime * 1.6 + aFoam.y * 2.1 + aFoam.z * 3.0));\n106\t  vec4 wp = modelMatrix * vec4(p, 1.0);\n107\t  vPosW = wp.xyz;\n108\t  vNormalW = normalize(mat3(modelMatrix) * normal);\n109\t  vFoam = aFoam;\n110\t  vec4 mvPosition = viewMatrix * wp;\n111\t  gl_Position = projectionMatrix * mvPosition;\n112\t  #include <fog_vertex>\n113\t}\n114\t`;\n115\t\n116\tconst BERM_FRAG = /* glsl */ `\n117\tuniform float uTime;\n118\tuniform vec2 uOutro;     // amount, chamber start s\n119\tuniform vec3 uLightDir;\n120\tuniform vec4 uSt05;      // wave 7: 05 soap shading weight ramps in s0..s1, out s2..s3 (= bermScale05)\n121\tvarying vec3 vFoam;\n122\tvarying vec3 vPosW;\n123\tvarying vec3 vNormalW;\n124\t#include <fog_pars_fragment>\n125\t${NOISE_GLSL}\n126\t${FRAG_FX_GLSL}\n127\t${SOAP05_GLSL}\n128\tvoid main() {\n129\t  float s = vFoam.y;\n130\t  if (uOutro.x > 0.0 && s > uOutro.y - 2.0) {\n131\t    float n = vnoise(vec2(vFoam.x * 3.0, s * 0.35)) * 0.7 + 0.3;\n132\t    if (n < uOutro.x * 1.15) discard;\n133\t  }\n134\t  vec2 p = vec2(vFoam.x * vFoam.z * 1.1, s - uTime * 0.25);\n135\t  // detail fade with distance (cells per pixel)\n136\t  float fw = max(fwidth(p.x), fwidth(p.y));\n137\t  float k1 = 1.0 - smoothstep(0.12, 0.3, fw * 1.6);\n138\t  float k2 = 1.0 - smoothstep(0.12, 0.3, fw * 3.8);\n139\t  float c1 = mix(0.45, cells(p * 1.6), k1);\n140\t  #ifdef LOW_Q\n141\t  float c2 = c1;\n142\t  #else\n143\t  float c2 = mix(0.45, cells(p * 3.8 + 11.0), k2);\n144\t  #endif\n145\t  // bubble domes: bright cell centres, deep crevices between bubbles\n146\t  float bub = (1.0 - c1 * c1) * 0.6 + (1.0 - c2 * c2) * 0.4;\n147\t  vec3 N0 = normalize(vNormalW);\n148\t  if (!gl_FrontFacing) N0 = -N0;\n149\t  #ifdef LOW_Q\n150\t  vec3 N = N0;\n151\t  #else\n152\t  vec3 N = bumpNormal(vPosW, N0, bub * 0.1);\n153\t  #endif\n154\t  vec3 L = normalize(uLightDir);\n155\t  vec3 V = normalize(cameraPosition - vPosW);\n156\t  float diff = 0.55 + 0.45 * max(dot(N, L), 0.0);\n157\t  vec3 white = vec3(1.0, 1.0, 1.0);\n158\t  vec3 lav = vec3(0.7, 0.68, 0.98);\n159\t  vec3 col = mix(lav, white, 0.3 + 0.7 * clamp(N.y * 0.5 + 0.5, 0.0, 1.0)) * diff;\n160\t  col = mix(col, lav * 0.8, smoothstep(0.6, 0.95, c1) * 0.7 * k1);\n161\t  col = mix(col, lav * 0.9, smoothstep(0.65, 0.95, c2) * 0.4 * k2);\n162\t  // tiny pores (open bubbles)\n163\t  #ifndef LOW_Q\n164\t  vec2 pp = p * 7.0 + 5.0;\n165\t  float pc = cells(pp);\n166\t  float kp = 1.0 - smoothstep(0.1, 0.25, fw * 7.0);\n167\t  col = mix(col, vec3(0.58, 0.56, 0.88), (1.0 - smoothstep(0.1, 0.2, pc)) * step(0.62, hash12(floor(pp))) * 0.75 * kp);\n168\t  #endif\n169\t  float spec = pow(max(dot(reflect(-V, N), L), 0.0), 28.0);\n170\t  float fres = pow(1.0 - clamp(dot(N, V), 0.0, 1.0), 3.0);\n171\t  col += vec3(1.0) * spec * 0.45 + iridescent(fres * 1.4 + c1 * 0.6) * fres * 0.18;\n172\t  col *= 0.96;\n173\t  // 05 (wave 7): the low rim under the puffs reads as small piled soap bubbles: white only on the cell\n174\t  // tops, periwinkle bodies, blue-violet crevices between the cells (ref 05 rim)\n175\t  float k05 = smoothstep(uSt05.x, uSt05.y, s) * (1.0 - smoothstep(uSt05.z, uSt05.w, s));\n176\t  // 05: the bank stops just past its bubble crest with a scalloped (cell) edge, so the purple wall shows right above\n177\t  // the rim instead of a pale lather slope (ref 05; e is the raw offset outward from the stream edge)\n178\t  if (vFoam.x > mix(9.0, 0.3 + 0.45 * (1.0 - c1), k05)) discard;\n179\t  if (k05 > 0.0) {\n180\t    vec3 Nv = normalize((viewMatrix * vec4(N, 0.0)).xyz);\n181\t    float t5 = soapT(Nv) * 0.55 + 0.45 * mix(0.55, bub, max(k1, 0.3)) - 0.1;\n182\t    t5 -= smoothstep(0.55, 0.95, c1) * 0.45 * k1 + smoothstep(0.62, 0.95, c2) * 0.25 * k2;\n183\t    vec3 c5 = soap05(t5);\n184\t    #ifndef LOW_Q\n185\t    c5 = mix(c5, SOAP_CREV, (1.0 - smoothstep(0.1, 0.2, pc)) * step(0.62, hash12(floor(pp))) * 0.7 * kp);\n186\t    #endif\n187\t    c5 += vec3(1.0) * spec * 0.3;\n188\t    col = mix(col, c5, k05);\n189\t  }\n190\t  gl_FragColor = vec4(col, 1.0);\n191\t  ${FRAG_TAIL}\n192\t}\n193\t`;\n194\t\n195\t// ---------------------------------------------------------------------------------- puffs\n196\t/**\n197\t * Soap-foam puff (ref 05 \"cloud banks\": white-lavender clumps, #FCF6FF lit tops, soft lavender\n198\t * undersides and crevices, a few darker pores, faint soap-film rim). instanceColor carries\n199\t * (x = ambient occlusion 0..1, y = seed, z = tint -1..1), not a colour.\n200\t */\n201\tconst PUFF_VERT = /* glsl */ `\n202\tuniform float uTime;\n203\tvarying vec3 vNormalW;\n204\tvarying vec3 vPosW;\n205\tvarying vec3 vLocal;\n206\tvarying vec3 vInst;\n207\tvarying float vW5;\n208\t#include <fog_pars_vertex>\n209\tvoid main() {\n210\t  // instanceColor.x = ao + 2 q, q = 0..8 = the 05 soap-shading weight x 8 (wave 7; ao <= 1 so floor(x / 2) = q)\n211\t  float q5 = floor(instanceColor.x * 0.5);\n212\t  vInst = vec3(instanceColor.x - 2.0 * q5, instanceColor.yz);\n213\t  vW5 = q5 / 8.0;\n214\t  float br = 1.0 + 0.035 * sin(uTime * 1.7 + instanceColor.y * 40.0);\n215\t  vec4 wp = modelMatrix * instanceMatrix * vec4(position * br, 1.0);\n216\t  vPosW = wp.xyz;\n217\t  vNormalW = normalize(mat3(modelMatrix) * mat3(instanceMatrix) * normal);\n218\t  vLocal = normal;\n219\t  vec4 mvPosition = viewMatrix * wp;\n220\t  gl_Position = projectionMatrix * mvPosition;\n221\t  #include <fog_vertex>\n222\t}\n223\t`;\n224\tconst PUFF_FRAG = /* glsl */ `\n225\tuniform vec3 uLightDir;\n226\tvarying vec3 vNormalW;\n227\tvarying vec3 vPosW;\n228\tvarying vec3 vLocal;\n229\tvarying vec3 vInst;\n230\tvarying float vW5;\n231\t#include <fog_pars_fragment>\n232\t${NOISE_GLSL}\n233\t${SOAP05_GLSL}\n234\tvoid main() {\n235\t  vec3 N = normalize(vNormalW);\n236\t  vec3 V = normalize(cameraPosition - vPosW);\n237\t  vec3 L = normalize(uLightDir);\n238\t  float wrap = clamp(dot(N, L) * 0.55 + 0.5, 0.0, 1.0);\n239\t  float upF = clamp(N.y * 0.5 + 0.5, 0.0, 1.0);\n240\t  float lit = smoothstep(0.18, 0.88, wrap * 0.65 + upF * 0.35);\n241\t  vec3 c5 = vec3(0.0);\n242\t  if (vW5 > 0.0) {\n243\t    // 05 (wave 7): ref soap ramp, view-space top light: white caps, periwinkle bodies, blue crevice rims\n244\t    vec3 Nv = normalize((viewMatrix * vec4(N, 0.0)).xyz);\n245\t    float z = clamp(Nv.z, 0.0, 1.0);\n246\t    float t5 = soapT(Nv) - pow(1.0 - z, 1.5) * (0.3 + 0.45 * clamp(0.5 - Nv.y * 0.7, 0.0, 1.0)) - (1.0 - vInst.x) * 0.35;\n247\t    c5 = soap05(t5 + 0.04 * vInst.z);\n248\t    #ifndef LOW_Q\n249\t    vec3 an5 = abs(vLocal);\n250\t    vec2 pc5 = (an5.x > an5.z ? vLocal.zy : vLocal.xy) * 2.6 + vInst.y * 17.0;\n251\t    float kp5 = 1.0 - smoothstep(0.2, 0.45, fwidth(pc5.x) + fwidth(pc5.y));\n252\t    c5 = mix(c5, SOAP_CREV, (1.0 - smoothstep(0.1, 0.2, cells(pc5))) * step(0.6, hash12(floor(pc5) + vInst.y * 31.0)) * kp5 * 0.5);\n253\t    #endif\n254\t    c5 += vec3(1.0) * pow(max(dot(reflect(-V, N), L), 0.0), 26.0) * 0.25;\n255\t  }\n256\t  vec3 lav = vec3(0.47, 0.44, 0.88);\n257\t  vec3 top = mix(vec3(1.1, 1.04, 1.16), vec3(1.04, 1.06, 1.16), clamp(vInst.z, 0.0, 1.0));\n258\t  top = mix(top, vec3(1.12, 1.02, 1.12), clamp(-vInst.z, 0.0, 1.0));\n259\t  vec3 col = mix(lav, top, lit);\n260\t  #ifndef LOW_Q\n261\t  // pores: small open bubbles on the puff skin (puff-local, two planar projections, no seam)\n262\t  vec3 an = abs(vLocal);\n263\t  vec2 pc = (an.x > an.z ? vLocal.zy : vLocal.xy) * 2.6 + vInst.y * 17.0;\n264\t  float cp = cells(pc);\n265\t  float kp = 1.0 - smoothstep(0.2, 0.45, fwidth(pc.x) + fwidth(pc.y));\n266\t  float pore = (1.0 - smoothstep(0.1, 0.2, cp)) * step(0.6, hash12(floor(pc) + vInst.y * 31.0));\n267\t  col = mix(col, lav * 0.95, pore * kp * 0.6 * lit);\n268\t  #endif\n269\t  // soap-film rim (cool lavender, a touch of pink) + soft glint\n270\t  float fres = pow(1.0 - clamp(dot(N, V), 0.0, 1.0), 2.4);\n271\t  col = mix(col, vec3(0.8, 0.68, 1.0), fres * 0.42);\n272\t  float spec = pow(max(dot(reflect(-V, N), L), 0.0), 26.0);\n273\t  col += vec3(1.0) * spec * 0.3;\n274\t  col *= mix(0.68, 1.0, vInst.x);\n275\t  col = mix(col, c5, vW5);\n276\t  gl_FragColor = vec4(col, 1.0);\n277\t  ${FRAG_TAIL}\n278\t}\n279\t`;\n280\t\n281\tfunction rng(seed: number) {\n282\t  let a = seed >>> 0;\n283\t  return () => {\n284\t    a = (a + 0x6d2b79f5) >>> 0;\n285\t    let t = a;\n286\t    t = Math.imul(t ^ (t >>> 15), t | 1);\n287\t    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n288\t    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n289\t  };\n290\t}\n291\t\n292\tfunction makePuffMaterial(quality: 'high' | 'low') {\n293\t  const uniforms = withFog({\n294\t    uTime: { value: 0 },\n295\t    uLightDir: { value: new THREE.Vector3(0.3, 1.0, 0.45).normalize() },\n296\t  });\n297\t  const mat = new THREE.ShaderMaterial({\n298\t    uniforms,\n299\t    vertexShader: PUFF_VERT,\n300\t    fragmentShader: PUFF_FRAG,\n301\t    fog: true,\n302\t    defines: quality === 'low' ? { LOW_Q: 1 } : {},\n303\t  });\n304\t  return { mat, uniforms };\n305\t}\n306\t\n307\t/**\n308\t * 05 flank-bank bubble: a camera-facing sphere IMPOSTOR (2 triangles) shaded like the soap puffs\n309\t * (white-lavender lit top, lavender underside, soap-film rim that reads as the crevice between piled\n310\t * bubbles, a few pores, a glint). instanceColor = (ambient occlusion, seed, tint) as for the puffs.\n311\t * The quad is pushed to the sphere's front so the lather apron and neighbours cut it like a sphere.\n312\t */\n313\tconst BANK_BUB_VERT = /* glsl */ `\n314\tvarying vec2 vP;\n315\tvarying vec3 vInst;\n316\tvarying float vBig;\n317\t#include <fog_pars_vertex>\n318\tvoid main() {\n319\t  vec4 c = modelMatrix * instanceMatrix * vec4(0.0, 0.0, 0.0, 1.0);\n320\t  float r = length((instanceMatrix * vec4(1.0, 0.0, 0.0, 0.0)).xyz);\n321\t  vec4 mvPosition = viewMatrix * c;\n322\t  // wave 7: 0 for bubbles <= ~18 px, 1 for >= ~40 px on screen (the ref's big near bumps show large white caps)\n323\t  vBig = smoothstep(0.012, 0.026, projectionMatrix[1][1] * r / max(-mvPosition.z, 0.01));\n324\t  mvPosition.xyz += normalize(-mvPosition.xyz) * r * 0.6;\n325\t  mvPosition.xy += position.xy * r;\n326\t  vP = position.xy;\n327\t  vInst = instanceColor;\n328\t  gl_Position = projectionMatrix * mvPosition;\n329\t  #include <fog_vertex>\n330\t}\n331\t`;\n332\tconst BANK_BUB_FRAG = /* glsl */ `\n333\tuniform vec3 uLightDir;\n334\tuniform float uTime;\n335\tvarying vec2 vP;\n336\tvarying vec3 vInst;\n337\tvarying float vBig;\n338\t#include <fog_pars_fragment>\n339\t${NOISE_GLSL}\n340\t${SOAP05_GLSL}\n341\tvoid main() {\n342\t  float d2 = dot(vP, vP);\n343\t  if (d2 > 1.0) discard;\n344\t  float z = sqrt(1.0 - d2);\n345\t  vec3 Nv = vec3(vP, z);\n346\t  // wave 7: ref 05 soap ramp (white top caps, lavender-white bodies, periwinkle / blue undersides); the\n347\t  // lower and side silhouette sinks into blue-violet (the crevice between piled bubbles), the top edge stays\n348\t  // light; inner / lower bubbles of a pile (ambient occlusion vInst.x) are bluer\n349\t  float t = soapT(Nv) - pow(1.0 - z, 1.5) * (0.3 + 0.45 * clamp(0.5 - vP.y * 0.7, 0.0, 1.0)) - (1.0 - vInst.x) * 0.35 + 0.05 * vBig;\n350\t  vec3 col = soap05(t + 0.04 * vInst.z);\n351\t  // pores: one or two small dark-blue open bubbles on the larger puffs\n352\t  vec2 pc = vP * 2.2 + vInst.y * 17.0;\n353\t  float cp = cells(pc);\n354\t  float kp = 1.0 - smoothstep(0.25, 0.5, fwidth(pc.x) * 2.0);\n355\t  col = mix(col, SOAP_CREV, (1.0 - smoothstep(0.1, 0.2, cp)) * step(0.7, hash12(floor(pc) + vInst.y * 31.0)) * kp * 0.5);\n356\t  vec3 Lv = (viewMatrix * vec4(normalize(uLightDir), 0.0)).xyz;\n357\t  float spec = pow(max(dot(reflect(vec3(0.0, 0.0, -1.0), Nv), Lv), 0.0), 24.0);\n358\t  col += vec3(1.0) * spec * 0.25;\n359\t  gl_FragColor = vec4(col, 1.0);\n360\t  ${FRAG_TAIL}\n361\t}\n362\t`;\n363\t\n364\tfunction makeBankBubbleMaterial() {\n365\t  const uniforms = withFog({\n366\t    uTime: { value: 0 },\n367\t    uLightDir: { value: new THREE.Vector3(0.3, 1.0, 0.45).normalize() },\n368\t  });\n369\t  const mat = new THREE.ShaderMaterial({ uniforms, vertexShader: BANK_BUB_VERT, fragmentShader: BANK_BUB_FRAG, fog: true });\n370\t  return { mat, uniforms };\n371\t}\n372\t\n373\t/** unit sphere puff with smooth normals (detail 0 icosahedra get flat normals by default) */\n374\tfunction puffGeometry(detail: number) {\n375\t  const g = new THREE.IcosahedronGeometry(1, detail);\n376\t  const p = g.attributes.position as THREE.BufferAttribute;\n377\t  const n = g.attributes.normal as THREE.BufferAttribute;\n378\t  const v = new THREE.Vector3();\n379\t  for (let i = 0; i < p.count; i++) { v.fromBufferAttribute(p, i).normalize(); n.setXYZ(i, v.x, v.y, v.z); }\n380\t  return g;\n381\t}\n382\t\n383\texport interface FoamSystem {\n384\t  group: THREE.Group;\n385\t  whirlGroup: THREE.Group;\n386\t  berm: THREE.Mesh;\n387\t  /** 05 flank-bank puffs (instanced, on top of `flank`) */\n388\t  rafts: THREE.InstancedMesh;\n389\t  /** 05 flank-bank lather sheet (shares the berm material) */\n390\t  flank: THREE.Mesh;\n391\t  /** Benny's waterline position on the course (call from water.wake() each riding frame) */\n392\t  rider(s: number, lat: number, strength: number): void;\n393\t  /** camera: needed in 05, where the flank banks are fitted to the frame edges */\n394\t  update(time: number, dt: number, focusS: number, outro?: number, camera?: THREE.Camera): void;\n395\t  /** QA: current flank-bank placement (kind L/R, row ds, inner-edge lateral, bank width) */\n396\t  qaRafts(): { visible: boolean; puffs: number; shown: number; clumps: { kind: string; ds: number; lat: number; k: number; y?: number; x?: number; env?: number; s?: number }[] };\n397\t  instanceCount: number;\n398\t}\n399\t\n400\t// ---------------------------------------------------------------------------------- flank banks (05)\n401\t/**\n402\t * In 05 the stream fills the tube floor wall to wall (S05.extent), so from the locked chase camera the\n403\t * real stream edges and their berm leave the frame below y≈800 and the near field shows only open water.\n404\t * Ref 05 has white cloud banks hugging BOTH sides all the way down to Benny's level (left x≈0–330 over\n405\t * y≈540–1300, right x≈560–864). Wave 4: one continuous bank per side, fitted to the frame edges each\n406\t * frame from the camera (so it holds for any device aspect), not floating islands:\n407\t *  - a lather sheet (berm shader) from just below the frame bottom (ds −3.4) up the side of the frame\n408\t *    until it merges into the berm (ds +15); its inner edge sits BANK_PX px in from the frame edge\n409\t *    (lumpy, slow noise along s) and dips just under the water so the stream cuts a natural waterline;\n410\t *  - instanced puffs (rim, crest, heaps) anchored to world cells along s, so the bank stays put on the\n411\t *    water like the berm and Benny rides past it; they give the lumpy cloud silhouette.\n412\t * Never closer than BANK_CLEAR_RIDER to Benny (near him) or BANK_CLEAR_CORE to the cyan core / coin line.\n413\t */\n414\tconst BANK_DS0 = -3.4;\n415\tconst BANK_DS1 = 15;\n416\t/** puffs stop here (further ahead the berm and its own puffs take over) */\n417\tconst BANK_PUFF_DS1 = 12.5;\n418\t/** inner edge of a clump at its widest: px in from the frame edge (of an 864-px wide frame), L / R */\n419\tconst BANK_PX: [number, number] = [170, 200];\n420\t/** lateral size of a clump (px): a clump whose inner edge lies further in than this floats off the frame\n421\t * edge with water beyond it (ref 05 lower clumps x≈50–200 and 610–790) */\n422\tconst CLUMP_PX = 135;\n423\t/**\n424\t * The flank lather SHEET (berm shader) read as flat white paper with straight cut edges at the clump ends;\n425\t * the ref clumps are piled bubbles only, so wave 5 hides it and the impostor bubbles carry the clumps.\n426\t */\n427\tconst FLANK_SHEET = false;\n428\t/**\n429\t * Wave 5: world-anchored clump envelope per side, [seed, frequency along s, threshold]. The near-field bank is a\n430\t * chain of separate LOW clumps with open water between them (ref 05: left clumps y≈1016–1108 and\n431\t * 1202–1330, right y≈800–950 and 1217–1300), not a continuous strip up the frame edge (wave 4 read as\n432\t * a white wall: the outer 40 px were foam on 74 % / 100 % of the rows y 700–1400). The seeds put the\n433\t * clumps of the QA frame (s≈132.4) where the ref has them; along 05 clumps cover ≈40 % of the length.\n434\t */\n435\tconst BANK_ENV: [number, number, number][] = [[58.457, 0.835, 0.581], [607.242, 0.459, 0.357], [267.601, 1.094, 0.563]];\n436\t/**\n437\t * wave 7 (ref 05 rows, qa/pilot05/wave7/foam): the bank row's inner edge (px in from the frame edge) and lateral size\n438\t * (px) by row ds. The right bank ahead of Benny is a NARROW rim hugging the river edge (ref y 700-940: inner edge\n439\t * 30 -> 158 -> 70 px, 20-66 px per row), not the wave-5 heap (124-179 px per row). The ref's near clumps: left x 0-130\n440\t * y 1020-1110 (ds 0.5-1.5), lower left x 60-230 y 1220-1300 and lower right x 650-800 y 1260-1330 (behind Benny,\n441\t * ds -1.1..-1.7). The envelope seeds\n442\t * (BANK_ENV, searched; [2] = right side beside / behind Benny) open/close the clumps at those rows of the QA frame.\n443\t */\n444\tconst RIM_R: [number, number][] = [[2.6, 60], [3.4, 70], [4.4, 105], [5.5, 140], [6.6, 158], [7.8, 153], [9.0, 135], [10.3, 104], [11.6, 70], [12.9, 30]];\n445\tconst RIM_R_PX = 80;\n446\tfunction rimR(ds: number): number {\n447\t  if (ds <= RIM_R[0][0]) return RIM_R[0][1];\n448\t  for (let i = 1; i < RIM_R.length; i++) {\n449\t    if (ds <= RIM_R[i][0]) {\n450\t      const [a, pa] = RIM_R[i - 1], [b, pb] = RIM_R[i];\n451\t      return pa + ((pb - pa) * (ds - a)) / (b - a);\n452\t    }\n453\t  }\n454\t  return RIM_R[RIM_R.length - 1][1];\n455\t}\n456\tconst BANK_CLEAR_RIDER = 1.3;\n457\tconst BANK_CLEAR_CORE = 1.45;\n458\t\n459\t/**\n460\t * wave 5: 0.4 in 05 (smooth ramps at the stage ends), 1 elsewhere. In 05 the stream-edge rim toward the VP\n461\t * is a LOW band of piled bubbles (ref ≈40–60 px); the full-height berm read as tall white heaps.\n462\t */\n463\tfunction bermScale05(course: Course): (s: number) => number {\n464\t  const st = course.stage('05');\n465\t  const sm = (a: number, b: number, x: number) => { const u = Math.min(1, Math.max(0, (x - a) / (b - a))); return u * u * (3 - 2 * u); };\n466\t  return (s) => 1 - 0.6 * sm(st.s0 - 6, st.s0 - 1, s) * (1 - sm(st.s1 - 1, st.s1 + 4, s));\n467\t}\n468\t/** squash the part of the bank above the stream's edge water level by k (k = 1: unchanged) */\n469\tconst squashBerm = (h: number, k: number) => (k < 1 && h > EDGE_LIFT ? EDGE_LIFT + (h - EDGE_LIFT) * k : h);\n470\t\n471\t/** continuous lather bank along both stream edges (skips the 03 whirlpool interior) */\n472\tfunction createBerm(course: Course, s0: number, s1: number, skip: [number, number], quality: 'high' | 'low') {\n473\t  const hk = bermScale05(course);\n474\t  const ds = quality === 'high' ? 0.32 : 0.8;\n475\t  const E = quality === 'high' ? [BERM_IN, -0.4, -0.25, -0.1, 0.04, 0.18, 0.34, 0.52, 0.75, 0.98, BERM_OUT] : [BERM_IN, -0.2, 0.15, 0.55, BERM_OUT];\n476\t  const rows = Math.ceil((s1 - s0) / ds) + 1;\n477\t  const C = E.length;\n478\t  const n = rows * C * 2;\n479\t  const pos = new Float32Array(n * 3);\n480\t  const foam = new Float32Array(n * 3);\n481\t  const tmp = new THREE.Vector3();\n482\t  let k = 0;\n483\t  const rowS: number[] = [];\n484\t  for (let i = 0; i < rows; i++) {\n485\t    const s = Math.min(s1, s0 + i * ds);\n486\t    rowS.push(s);\n487\t    const f = course.sample(s);\n488\t    const hw = course.widthAt(s) / 2;\n489\t    for (const side of [-1, 1]) {\n490\t      for (let j = 0; j < C; j++) {\n491\t        // left side is mirrored so every row runs inner → outer; bubble domes everywhere except\n492\t        // at the water line (keeps the lace edge flush with the stream)\n493\t        const e = E[j];\n494\t        const k05 = hk(s);\n495\t        const h = squashBerm(bermSurface(s, e, side, hw), k05);\n496\t        // 05: the outer (dry) side is laterally compressed too, so the rim is a narrow band of bubbles\n497\t        const eS = e > 0 ? e * (0.1 + 0.9 * k05) : e;\n498\t        tmp.copy(f.pos).addScaledVector(f.right, side * (hw + eS)).addScaledVector(f.up, h);\n499\t        tmp.toArray(pos, k * 3);\n500\t        foam[k * 3] = e;\n501\t        foam[k * 3 + 1] = s;\n502\t        foam[k * 3 + 2] = side;\n503\t        k++;\n504\t      }\n505\t    }\n506\t  }\n507\t  const idx: number[] = [];\n508\t  const rowStride = C * 2;\n509\t  for (let i = 0; i < rows - 1; i++) {\n510\t    const sa = rowS[i], sb = rowS[i + 1];\n511\t    if (sb > skip[0] && sa < skip[1]) continue;\n512\t    for (let sideI = 0; sideI < 2; sideI++) {\n513\t      for (let j = 0; j < C - 1; j++) {\n514\t        const a = i * rowStride + sideI * C + j, b = a + 1, c = a + rowStride, d = c + 1;\n515\t        // CCW seen from above on both sides (side +1 runs +right, side −1 runs −right)\n516\t        if (sideI === 1) idx.push(a, b, c, b, d, c);\n517\t        else idx.push(a, c, b, b, c, d);\n518\t      }\n519\t    }\n520\t  }\n521\t  const geo = new THREE.BufferGeometry();\n522\t  geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));\n523\t  geo.setAttribute('aFoam', new THREE.BufferAttribute(foam, 3));\n524\t  geo.setIndex(idx);\n525\t  geo.computeVertexNormals();\n526\t  const st05 = course.stage('05');\n527\t  const uniforms = withFog({\n528\t    uTime: { value: 0 },\n529\t    uOutro: { value: new THREE.Vector2(0, course.stage('08').s0) },\n530\t    uLightDir: { value: new THREE.Vector3(