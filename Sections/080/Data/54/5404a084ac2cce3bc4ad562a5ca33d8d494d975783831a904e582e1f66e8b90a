assert not checked_ids(ids)
pool=p/'gitBlobs';pool.mkdir(exist_ok=True)
proc=sp.Popen(basecmd+['cat-file','--batch'],stdin=sp.PIPE,stdout=sp.PIPE,stderr=sp.PIPE)
pointers={}
for h in sorted(ids):
    f=pool/h
    if not f.is_file():
        proc.stdin.write((h+'\n').encode());proc.stdin.flush();a,typ,size=proc.stdout.readline().split();assert a.decode()==h and typ==b'blob'
        with f.open('wb') as out:
            remaining=int(size)
            while remaining:
                data=proc.stdout.read(min(1024*1024,remaining));assert data;out.write(data);remaining-=len(data)
        assert proc.stdout.read(1)==b'\n'
    if f.stat().st_size<850:
