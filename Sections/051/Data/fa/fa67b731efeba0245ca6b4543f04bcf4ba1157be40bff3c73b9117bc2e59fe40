const {chromium}=require('playwright'),fs=require('node:fs');
(async()=>{
 const browser=await chromium.launch({executablePath:'/usr/bin/chromium',args:['--remote-debugging-port=19477','--remote-debugging-address=127.0.0.1','--use-angle=swiftshader','--enable-unsafe-swiftshader','--ignore-gpu-blocklist','--disable-background-networking','--disable-component-update','--host-resolver-rules=MAP * ~NOTFOUND, EXCLUDE localhost, EXCLUDE 127.0.0.1']});
 const ctx=await browser.newContext({viewport:{width:864,height:1536},deviceScaleFactor:1});const page=await ctx.newPage();
 await page.goto('about:blank'); fs.writeFileSync('private-browser.pid',String(process.pid)); console.log('Disposable Chromium CDP ready on loopback');
 const shutdown=async()=>{await browser.close();process.exit(0)};
 process.on('SIGTERM',shutdown);process.on('SIGINT',shutdown);
})();
