const fs=require('node:fs'),path=require('node:path'),{spawn}=require('node:child_process');
const {chromium}=require('playwright');
const root=__dirname,queries=require('./queries.json'),heads=require('./heads.json');
const base=(id)=>'http://127.0.0.1:'+(id==='04r'?5664:5600+Number(id))+'/?qa=1&dpr=1&'+queries[id];
const size={width:864,height:1536};
async function pageFor(browser,id,viewport,errors) {
 const page=await browser.newPage({viewport,deviceScaleFactor:1});page.setDefaultTimeout(100000);
 page.on('pageerror',e=>errors.push(e.message));page.on('response',r=>{if(r.status()>=400)errors.push(r.status()+' '+new URL(r.url()).pathname)});
 page.on('console',m=>{if(m.type()==='error') errors.push(m.text().slice(0,300))});
 await page.route('**/*',r=>['','127.0.0.1','localhost'].includes(new URL(r.request().url()).hostname)?r.continue():r.abort());
 await page.goto(base(id),{timeout:120000});
 await page.waitForFunction(()=>window.__rainbow?.ready || window.__error,null,{timeout:180000});
 const failure=await page.evaluate(()=>window.__error);if(failure)throw new Error(failure);
 await page.evaluate(()=>document.fonts.ready);return page;
}
function specifications(id) {
 const sid=id.slice(0,2);
 const frames=[['approved','checkpoint',0],['early','checkpoint',3],['forward','checkpoint',10],['hard-left','checkpoint',12,-1],['hard-right','checkpoint',12,1],['inlet','route',.006],['middle','route',.5],['deep','route',.76],['last-in-stage','end',-.45],['across-transition','end',.65]];
 const special={
  '04':[['past-arrows','route',.32]],'05':[['late-left-bend','route',.81,-1],['last-right-bend','route',.96,1]],
  '06':[['crest-release','checkpoint',1.1],['inside-arch','checkpoint',6]],
  '07':[['plunge-lip','mark','07_plunge_top'],['plunge-late','checkpointFraction',.80]],
  '08':[['spouts-and-platform','checkpoint',6],['river-bend','route',.66]]
 };
 if(id==='04r') return [frames[0],frames[2],frames[3],frames[4],frames[6],frames[8]];
 return [...frames,...special[sid]];
}
async function pose(page,sid,row){
 return page.evaluate(([id,[name,kind,value,steer=0]])=>{
  const r=window.__rainbow;r.run(false);
  const range=r.course.stage(id),prev=String(Number(id)-1).padStart(2,'0');
  let target,start,frames=0;
  if(kind==='checkpoint'||kind==='checkpointFraction'){
   r.goto(id);start=r.state().s;target=kind==='checkpoint'?start+value:start+(range.s1-start)*value;
  }else{
   r.startRideAt(prev);r.unfreeze();r.setSteer(0);r.step(1);start=r.state().s;
   target=kind==='end'?range.s1+value:kind==='mark'?r.course.marks[value]:range.s0+(range.s1-range.s0)*value;
  }
  while(r.state().s<target-.001 && frames<6000) {
   if(steer)r.setSteer(r.state().s>=target-12?steer:0);r.step(1);frames++;
  }
  r.setSteer(null);if(kind!=='checkpoint'||value!==0)r.freezeAt(12+frames/60);
  const draws=r.drawList();const state=r.state(),camera=r.camera();
  const {scene,renderer}=r.qa3d();
  let details=null;
  if(id==='07'){
   const grp=scene.getObjectByName('match07_projection');const paddles=[];
   for(const o of grp?.children||[])if(/^m07_paddle/.test(o.name)){
    const center=o.getWorldPosition(o.position.clone());const ndc=center.clone().project(r.qa3d().camera);
    const visible=ndc.z>=-1&&ndc.z<=1&&Math.abs(ndc.x)<1&&Math.abs(ndc.y)<1;
    paddles.push({name:o.name,center:center.toArray(),ndc:ndc.toArray(),inFrame:visible,ray:visible?r.probe(ndc.x,ndc.y).slice(0,3):[],material:o.material.type});
   }
   details={paddles,activeDraws:draws.filter(d=>/m07_(water|tube|paddle)/.test(d[0]))};
  }
  return {name,kind,value,steer,target,frames,state,camera,benny:r.bennyScreen(),coins:r.coinScreen(),course:{s0:range.s0,s1:range.s1},gl:{contextLost:renderer.getContext().isContextLost(),draws:renderer.info.render.calls,triangles:renderer.info.render.triangles},details};
 },[sid,row]);
}
async function clip(browser,id,dir,report){
 const sid=id.slice(0,2),page=await pageFor(browser,id,{width:324,height:576},report.errors);
 const start=await page.evaluate(id=>{
  const r=window.__rainbow,range=r.course.stage(id),prev=String(Number(id)-1).padStart(2,'0');
  r.run(false);r.startRideAt(prev);r.unfreeze();r.setSteer(0);r.step(1);
  while(r.state().s < range.s0+.04)r.step(1);
  return {s0:range.s0,s1:range.s1,start:r.state().s};
 },sid);
 const ff=spawn('ffmpeg',['-hide_banner','-loglevel','error','-y','-threads','2','-f','image2pipe','-vcodec','mjpeg','-r','12','-i','pipe:0','-c:v','libx264','-threads','2','-preset','veryfast','-crf','18','-pix_fmt','yuv420p','-movflags','+faststart',path.join(dir,'ride.mp4')],{stdio:['pipe','ignore','pipe']});
 let log='';ff.stderr.on('data',x=>{log+=x.toString()});
 const done=new Promise((resolve,reject)=>ff.on('exit',code=>code===0?resolve():reject(Error(log||'ffmpeg '+code))));
 const shots=[];let finalSeen=0;
 try {
  for(let index=0;index<580;index++){
   const point=await page.evaluate(([s0,s1,index,sid])=>{
    const r=window.__rainbow, progress=(r.state().s-s0)/(s1-s0);
    const stage=r.course.stage(r.state().stage);
    const safeTarget=Math.min(2,Math.max(.55,stage.width/2-1.45));
    const direction=progress<.12?0:progress<.33?-1:progress<.47?1:progress<.64?0:progress<.78?.9:progress<.91?-.85:0;
    const feedback=Math.max(-.92,Math.min(.92,(direction*safeTarget-r.state().lat)*.65));
    const entryInputs=progress<.12?0:progress<.33?-.84:progress<.47?.8:progress<.64?.03:progress<.78?.70:progress<.91?-.72:0;
    const steer=sid==='04'?entryInputs:feedback;
    r.setSteer(steer);if(index)r.step(5);r.drawList();
    const v=r.state();return {index,simulationTime:index/12,s:v.s,stage:v.stage,lat:v.lat,steer,hearts:v.hearts,coins:v.coins,cam:v.cam,benny:v.bennyY};
   },[start.s0,start.s1,index,sid]);
   const photo=await page.screenshot({type:'jpeg',quality:85,timeout:90000});
   if(!ff.stdin.write(photo)) await new Promise(resolve=>ff.stdin.once('drain',resolve));
   if(shots.length && point.s<shots.at(-1).s)throw Error('Clip respawned at '+point.s);
   shots.push(point);
   if(point.s>start.s1+.4 && ++finalSeen>=3)break;
  }
  if(shots.at(-1).stage===sid)throw Error('Clip did not cross stage boundary '+sid);
 }finally{ff.stdin.end();await done;await page.close()}
 return {fps:12,simulationStep:1/60,stepsPerFrame:5,width:324,height:576,steering:sid==='04'?'Alternates fixed inputs in the short gold entrance.':'Targets alternate lateral positions inside the existing collision bounds; full input at equal distances is tested independently in the native stills.',scope:'One continuous simulated ride from the level inlet through its boundary, with steering and animated water.',...start,frames:shots};
}
async function audit(browser,id) {
 const sid=id.slice(0,2),dir=path.join(root,'captures',id);fs.mkdirSync(dir,{recursive:true});
 let report={id,...heads[id],query:queries[id],errors:[],shots:[]};
 const previous=path.join(dir,'stills.json');
 const nativeDone=fs.existsSync(previous)&&fs.existsSync(path.join(dir,'repeat-opening.png'))&&JSON.parse(fs.readFileSync(previous)).shots.length===specifications(id).length&&(id!=='07'||fs.existsSync(path.join(dir,'gameplay.json')));
 if(nativeDone)report=JSON.parse(fs.readFileSync(previous));
 else {
 const page=await pageFor(browser,id,size,report.errors);
 for(const row of specifications(id)){
  const p=await pose(page,sid,row);report.shots.push(p);
  if(row[0]==='across-transition'){if(p.state.stage===sid)throw Error('Boundary check '+sid)}
  else if(p.state.stage!==sid)throw Error('Wrong stage '+JSON.stringify([id,row[0],p.state.stage]));
  await page.waitForTimeout(160);
  await page.screenshot({path:path.join(dir,row[0]+'.png'),animations:'disabled',timeout:90000});
  fs.writeFileSync(path.join(dir,'stills.json'),JSON.stringify(report,null,1));
 }
 await pose(page,sid,['repeat-opening','checkpoint',0]);await page.waitForTimeout(160);
 await page.screenshot({path:path.join(dir,'repeat-opening.png'),animations:'disabled',timeout:90000});
 if(id==='07'){
   const src=fs.readFileSync(path.join(root,'docs/07/scripts/gameplay-test.mjs'),'utf8'), marker='const result = await page.evaluate(';
   const a=src.indexOf(marker)+marker.length,b=src.indexOf('\n});\n\nresult.errors = errors;',a);
   if(a<marker.length||b<0)throw Error('Unrecognized gameplay suite');
   const result=await page.evaluate('('+src.slice(a,b)+'\n})()');
   fs.writeFileSync(path.join(dir,'gameplay.json'),JSON.stringify(result,null,2));
   const pickups=result.checks.realCoinPickups;
   if(Object.values(result.checks).filter(x=>x.pass).length!==8||pickups.collected!==91||pickups.endCoins!==2240)throw Error('07 gameplay regression');
 }
 await page.close();
 }
 console.log(id,'native captures verified',report.shots.length);
 if(id!=='04r'&&!fs.existsSync(path.join(dir,'clip.json'))){
   const c=await clip(browser,id,dir,report);
   fs.writeFileSync(path.join(dir,'clip.json'),JSON.stringify(c));
   console.log(id,'continuous clip',c.frames.length,'frames',c.frames.at(-1).stage);
 }
 fs.writeFileSync(path.join(dir,'stills.json'),JSON.stringify(report,null,1));
 if(report.errors.length)throw Error(id+' '+JSON.stringify(report.errors).slice(0,500));
}
async function main(){
 const browser=await chromium.launch({executablePath:'/usr/bin/chromium',args:['--use-angle=swiftshader','--enable-unsafe-swiftshader','--ignore-gpu-blocklist','--disable-background-timer-throttling']});
 try{for(const id of process.argv.slice(2)){await audit(browser,id)}}finally{await browser.close()}
}
main().catch(e=>{console.error(e.stack);process.exitCode=1});
