from pathlib import Path
import re,hashlib,sys,subprocess as sp,json,time,zipfile,os
root=Path(__file__).resolve().parent
proof=json.loads((root/'delivery-proof.json').read_text())
file=Path('/workspace/shared/downloads/Rainbow_Full_Code_and_Screens_ChatGPT.zip')
repo='josiahscalia5-dev/rainbow-'
prior=json.loads((root/'remote.json').read_text())
target=prior['refs']['codex/s06-benny-fitted-knit-cuff']
tag='codex-review-20261119-'+target[:7]+'-'+proof['sha256'][:8]
api='repos/'+repo
def cmd(args,timeout=900):
 proc=sp.run(args,stdout=sp.PIPE,stderr=sp.PIPE,timeout=timeout)
 if proc.returncode:
  msg=proc.stderr.decode(errors='replace')
  signals=re.findall(r'HTTP [0-9]+|context deadline exceeded|timed? out|not found|already exists|resource not accessible|Maximum supported size|unexpected EOF|connection reset|TLS handshake timeout|connection refused|unexpected status|authentication required|failed to upload',msg,re.I)
  raise RuntimeError('Command failed: '+args[0]+' '+args[1]+', exit '+str(proc.returncode)+'; status '+(', '.join(signals) or 'see private service response'))
 return proc.stdout
def gh(q):return json.loads(cmd(['gh','api',q]))
def has_release():
 opt=sp.run(['gh','api',api+'/releases/tags/'+tag],stdout=sp.PIPE,stderr=sp.PIPE)
 if opt.returncode:
  if re.search(rb'404|not found',opt.stderr,re.I):return None
  raise RuntimeError('Cannot determine whether the private release exists.')
 return json.loads(opt.stdout)
def digest(f):
 with f.open('rb') as stream:return hashlib.file_digest(stream,'sha256').hexdigest()
assert file.stat().st_size==proof['compressedBytes'] and digest(file)==proof['sha256']
check=gh(api);assert check['private'] is True and check['permissions']['push'] is True
notes=root/'release-description.md'
notes.write_text('Review the Rainbow game on Android with one ZIP. It contains the playable project source, all five original gameplay artworks, retained results, isolated experiments, 48 H.264 recordings, and a 37-page picture guide.\n\nExtract and open START_HERE.md or OPEN_ON_PHONE.html. The five original artworks are unchanged. This private review release contains evidence for the owner. The tested experiments remain isolated.\n\nSHA-256 '+proof['sha256']+'\n\nArchive size '+str(proof['compressedBytes'])+' bytes.\n')
r=has_release()
if r is None:
 print('Publishing the verified archive to an isolated private review release.',flush=True)
 cmd(['gh','release','create',tag,'--repo',repo,'--target',target,'--title','Rainbow full code and screens for ChatGPT review','--notes-file',str(notes),'--prerelease','--latest=false',str(file)],timeout=1200)
 r=has_release()
assert r and r['draft'] is False and r['prerelease'] is True and r['target_commitish']==target
owned=[asset for asset in r['assets'] if asset['name']==file.name]
if not owned:
 cmd(['gh','release','upload',tag,str(file),'--repo',repo],timeout=1200)
 r=has_release();owned=[asset for asset in r['assets'] if asset['name']==file.name]
assert len(owned)==1 and owned[0]['state']=='uploaded' and owned[0]['size']==proof['compressedBytes']
asset=owned[0];canonical=f'https://github.com/{repo}/releases/download/{tag}/{file.name}'
assert asset['browser_download_url']==canonical
restore=root/'authenticated-download';restore.mkdir(exist_ok=True);back=restore/file.name
if not back.is_file():
 print('Downloading the published asset through authenticated GitHub.',flush=True)
 cmd(['gh','release','download',tag,'--repo',repo,'--pattern',file.name,'--dir',str(restore)],timeout=1200)
assert back.stat().st_size==proof['compressedBytes'] and digest(back)==proof['sha256']
with zipfile.ZipFile(back) as z:
 assert len(z.namelist())==proof['files'] and z.testzip() is None
listed=cmd(['git','ls-remote','https://github.com/'+repo+'.git','refs/tags/'+tag,'refs/tags/'+tag+'^{}']).decode()
taghashes={line.split()[0] for line in listed.splitlines()};assert target in taghashes
heads=cmd(['git','ls-remote','--heads','https://github.com/'+repo+'.git']).decode()
current={name.removeprefix('refs/heads/'):h for h,name in (row.split() for row in heads.splitlines())}
delta=[n for n,h in prior['refs'].items() if current.get(n)!=h]
receipt={**proof,'repository':repo,'private':True,'releaseTag':tag,'releasePage':r['html_url'],'download':canonical,'assetID':asset['id'],'targetCommit':target,'authenticatedRemoteDownloadVerified':True,'releaseAssetBytes':back.stat().st_size,'branchTipsChangedSinceReview':delta}
(root/'published-review-proof.json').write_text(json.dumps(receipt,indent=2)+'\n')
print(json.dumps({k:receipt[k] for k in ['download','releasePage','sha256','files','compressedBytes','authenticatedRemoteDownloadVerified','branchTipsChangedSinceReview']}),flush=True)

