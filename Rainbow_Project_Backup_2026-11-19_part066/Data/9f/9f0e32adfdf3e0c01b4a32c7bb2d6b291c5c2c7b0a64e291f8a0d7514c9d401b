import asyncio,json,os,sys
from pathlib import Path
from mcp import ClientSession,StdioServerParameters
from mcp.client.stdio import stdio_client
ROOT=Path.cwd();bin=ROOT/'toolchain/node_modules/.bin';logs=ROOT/'diagnostic-output'
env={'PATH':os.environ['PATH'],'LANG':'C.UTF-8','XDG_CACHE_HOME':str(ROOT/'mcp-cache'),'XDG_CONFIG_HOME':str(ROOT/'mcp-config'),'TMPDIR':str(ROOT/'mcp-tmp'),'CI':'1','CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS':'1','CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS':'1'}
Path(env['TMPDIR']).mkdir(exist_ok=True)
end='http://127.0.0.1:19477'
spec={
 'microsoft':(str(bin/'playwright-mcp'),['--cdp-endpoint',end,'--output-dir',str(logs),'--console-level','error','--timeout-action','45000','--timeout-navigation','120000'],{}),
 'chrome':(str(bin/'chrome-devtools-mcp'),['--browser-url='+end,'--no-usage-statistics','--no-performance-crux'],{}),
 'three':('node',['--require',str(ROOT/'loopback-only.cjs'),str(ROOT/'toolchain/node_modules/threejs-devtools-mcp/dist/index.js')],{'BROWSER':'none','BRIDGE_PORT':'19478','DEV_URL':'http://127.0.0.1:5607','THREEJS_DEVTOOLS_NO_OVERLAY':'1'}),
 'spector':('node',[str(ROOT/'reviewed/spector-source/mcp/dist/index.js')],{'PLAYWRIGHT_BROWSERS_PATH':str(ROOT/'spector-browser')})}
async def connect(stack,name):
 cmd,args,extra=spec[name];logs.mkdir(exist_ok=True)
 log=stack.enter_context((logs/(name+'.log')).open('a'))
 transport=await stack.enter_async_context(stdio_client(StdioServerParameters(command=cmd,args=args,env={**env,**extra},cwd=ROOT),errlog=log))
 session=await stack.enter_async_context(ClientSession(*transport));await session.initialize()
 listing=await session.list_tools()
 params={x.name:x.inputSchema for x in listing.tools}
 (logs/(name+'-tool-schema.json')).write_text(json.dumps(params,indent=2))
 return session,params
if __name__=='__main__':
 from contextlib import AsyncExitStack
 async def one(name):
  async with AsyncExitStack() as stack:
   _,schema=await connect(stack,name)
   print(name,len(schema),[s for s in schema if any(x in s for x in ('scene','script','screen','evaluate','navigate','context','shader','capture','list_pages','draw','network','material','texture'))][:28],flush=True)
 async def main():
  await asyncio.gather(*(one(n) for n in spec))
 asyncio.run(main())
