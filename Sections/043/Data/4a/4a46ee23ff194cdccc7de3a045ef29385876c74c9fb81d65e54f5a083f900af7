"""Verify private GitHub bytes over resumable ranges without exposing transient URLs."""
import concurrent.futures, hashlib, json, subprocess, sys, urllib.request
from pathlib import Path
root=Path(sys.argv[1]);name=sys.argv[2];receipt=json.loads((root/'published.json').read_text())
tip=receipt['tip'];folder='experiments/'+receipt['branch']
api='repos/josiahscalia5-dev/rainbow-/contents/'+folder+'/'+name+'?ref='+tip
meta=json.loads(subprocess.check_output(['gh','api',api]))
expected=(root/'repo'/folder/name); total=expected.stat().st_size
size=5*1024*1024
def test(start):
    stop=min(total,start+size)-1
    request=urllib.request.Request(meta['download_url'],headers={'User-Agent':'Rainbow-private-resumable-review','Range':f'bytes={start}-{stop}'})
    with urllib.request.urlopen(request,timeout=45) as reply,expected.open('rb') as reference:
        assert reply.status==206 and reply.headers.get('Content-Range')==f'bytes {start}-{stop}/{total}'
        reference.seek(start);body=reply.read();assert len(body)==stop-start+1 and reference.read(len(body))==body
    return len(body)
with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
    blocks=list(pool.map(test,range(0,total,size)))
assert sum(blocks)==total
print(name, len(blocks),'private HTTP ranges matched every byte of',total,flush=True)
(root/'range-download.json').write_text(json.dumps({'tip':tip,'path':name,'bytes':total,'rangeCount':len(blocks),'allRangesFetchedAndCompared':True},indent=2)+'\n')
