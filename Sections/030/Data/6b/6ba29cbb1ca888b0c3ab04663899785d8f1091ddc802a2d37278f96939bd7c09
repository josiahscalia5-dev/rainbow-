arc length across the trough (u), y: 0\n232\tvarying vec4 vProj;\n233\tvarying vec3 vL;\n234\tvarying float vS;\n235\tvoid main() {\n236\t  vec4 wp = modelMatrix * vec4(position, 1.0);\n237\t  vProj = uProjVP * wp;\n238\t  vL = position;\n239\t  vS = aR.x;\n240\t  gl_Position = projectionMatrix * viewMatrix * wp;\n241\t}`;\n242\tconst RIVER_FRAG = /* glsl */ `\n243\tuniform sampler2D uPlate;\n244\tuniform vec4 uPjPost;\n245\tuniform vec2 uPjRes;\n246\tuniform float uAway;\n247\tuniform sampler2D uRiv;\n248\tuniform vec4 uRivA;          // lateral half-width, along start, along length, lateral scale\n249\tuniform float uTime;\n250\tuniform vec4 uArr;           // arrow spacing, first arrow (along), half width, arm thickness\n251\tuniform float uZ0;\n252\tvarying vec4 vProj;\n253\tvarying vec3 vL;\n254\tvarying float vS;\n255\t${PROJ05_INVERSE}\n256\tfloat h21(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }\n257\tfloat vn(vec2 p) { vec2 i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);\n258\t  return mix(mix(h21(i), h21(i + vec2(1, 0)), f.x), mix(h21(i + vec2(0, 1)), h21(i + vec2(1, 1)), f.x), f.y); }\n259\t// chevron pointing down the slide: distance to the two arms\n260\tfloat chev(vec2 p, float hw, float th) {\n261\t  p.x = abs(p.x);\n262\t  vec2 a = vec2(0.0, 0.0), b = vec2(hw, -hw * 2.3);   // long arms along the flow (painted arrows seen low)\n263\t  vec2 pa = p - a, ba = b - a;\n264\t  float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);\n265\t  return length(pa - ba * h) - th;\n266\t}\n267\tvoid main() {\n268\t  float along = -vL.z;                                     // down the slide from Benny's checkpoint water point\n269\t  float flow = along - uTime * 0.9;                        // the design drifts down the slide with the current\n270\t  float lat = vS * uRivA.w + 0.9 * (vn(vec2(along * 0.07, 7.0)) - 0.5) * smoothstep(0.4, 1.6, abs(vS));\n271\t  float fl = flow + 2.2 * (vn(vec2(along * 0.05, vS * 0.15 + 1.0)) - 0.5);\n272