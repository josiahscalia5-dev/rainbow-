#!/usr/bin/env python3
"""Probe a reference image without external dependencies.

Reads PNG/JPEG/GIF/WebP headers (stdlib only) and reports format, dimensions,
and suitability findings as JSON on stdout.

Usage:
    probe_image.py <image-path> [--min-side N]

Exit codes:
    0  image is usable (warnings possible)
    1  image is hard-rejected (unknown format / too small / unreadable)

Hard-reject thresholds live in HARD_MIN_SIDE; soft warnings in SOFT_*.
"""

from __future__ import annotations

import json
import os
import struct
import sys

HARD_MIN_SIDE = 64        # below this, no meaningful reconstruction target
SOFT_MIN_SIDE = 256       # below this, warn: fine detail will be guesswork
SOFT_MAX_ASPECT = 3.0     # beyond this, warn: subject likely cropped/panoramic
SOFT_MAX_BYTES = 25 * 1024 * 1024

_JPEG_SOF_MARKERS = frozenset(
    m for m in range(0xC0, 0xD0) if m not in (0xC4, 0xC8, 0xCC)
)


def _parse_png(data: bytes):
    if data[:8] != b"\x89PNG\r\n\x1a\n" or data[12:16] != b"IHDR":
        return None
    width, height = struct.unpack(">II", data[16:24])
    return "png", width, height


def _parse_gif(data: bytes):
    if data[:6] not in (b"GIF87a", b"GIF89a"):
        return None
    width, height = struct.unpack("<HH", data[6:10])
    return "gif", width, height


def _parse_jpeg(data: bytes):
    if data[:2] != b"\xff\xd8":
        return None
    i = 2
    n = len(data)
    while i + 9 < n:
        if data[i] != 0xFF:
            i += 1
            continue
        marker = data[i + 1]
        if marker == 0xFF:
            i += 1
            continue
        if marker in (0x01, 0xD8) or 0xD0 <= marker <= 0xD7:
            i += 2
            continue
        if marker == 0xDA:  # start of scan: no SOF found before image data
            break
        (seg_len,) = struct.unpack(">H", data[i + 2 : i + 4])
        if marker in _JPEG_SOF_MARKERS:
            height, width = struct.unpack(">HH", data[i + 5 : i + 9])
            return "jpeg", width, height
        i += 2 + seg_len
    return None


def _parse_webp(data: bytes):
    if data[:4] != b"RIFF" or data[8:12] != b"WEBP":
        return None
    chunk = data[12:16]
    if chunk == b"VP8 " and len(data) >= 30:
        width, height = struct.unpack("<HH", data[26:30])
        return "webp", width & 0x3FFF, height & 0x3FFF
    if chunk == b"VP8L" and len(data) >= 25 and data[20] == 0x2F:
        (bits,) = struct.unpack("<I", data[21:25])
        return "webp", (bits & 0x3FFF) + 1, ((bits >> 14) & 0x3FFF) + 1
    if chunk == b"VP8X" and len(data) >= 30:
        width = int.from_bytes(data[24:27], "little") + 1
        height = int.from_bytes(data[27:30], "little") + 1
        return "webp", width, height
    return None


def probe(path: str, min_side_hard: int = HARD_MIN_SIDE) -> dict:
    report = {
        "ok": False,
        "path": path,
        "format": None,
        "width": None,
        "height": None,
        "aspectRatio": None,
        "minSide": None,
        "megapixels": None,
        "fileSizeBytes": None,
        "warnings": [],
        "errors": [],
    }
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as fh:
            head = fh.read(64 * 1024)
    except OSError as exc:
        report["errors"].append(f"cannot read file: {exc}")
        return report

    report["fileSizeBytes"] = size
    parsed = None
    for parser in (_parse_png, _parse_jpeg, _parse_webp, _parse_gif):
        parsed = parser(head)
        if parsed:
            break
    if not parsed:
        report["errors"].append(
            "unrecognized image format (supported: PNG, JPEG, WebP, GIF)"
        )
        return report

    fmt, width, height = parsed
    if not width or not height:
        report["errors"].append(f"{fmt} header reports empty dimensions")
        return report

    min_side = min(width, height)
    aspect = round(max(width, height) / min_side, 3)
    report.update(
        {
            "format": fmt,
            "width": width,
            "height": height,
            "aspectRatio": aspect,
            "minSide": min_side,
            "megapixels": round(width * height / 1e6, 2),
        }
    )

    if min_side < min_side_hard:
        report["errors"].append(
            f"minimum side {min_side}px is below hard floor {min_side_hard}px"
        )
        return report
    if min_side < SOFT_MIN_SIDE:
        report["warnings"].append(
            f"minimum side {min_side}px < {SOFT_MIN_SIDE}px: fine details will be "
            "low-confidence; consider a larger reference"
        )
    if aspect > SOFT_MAX_ASPECT:
        report["warnings"].append(
            f"aspect ratio {aspect}:1 is extreme; subject may be cropped or panoramic"
        )
    if size > SOFT_MAX_BYTES:
        report["warnings"].append(
            f"file is {size / 1e6:.1f}MB; consider downscaling before vision passes"
        )

    report["ok"] = True
    return report


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip(), file=sys.stderr)
        return 1
    path = argv[0]
    min_side = HARD_MIN_SIDE
    if "--min-side" in argv:
        min_side = int(argv[argv.index("--min-side") + 1])
    report = probe(path, min_side)
    print(json.dumps(report, indent=2))
    return 0 if report["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
