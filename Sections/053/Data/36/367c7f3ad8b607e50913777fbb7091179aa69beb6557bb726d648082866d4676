from pathlib import Path
from PIL import Image,ImageDraw
import numpy as np,json,subprocess,sys
root=Path(__file__).parent;hd=Path('/tmp/rainbow-review-package.Ag1cgebC/proof')
for s in sys.argv[1:]:
 n=root/'proof'/s/'NEW';b=Path('/tmp/rainbow-final-fidelity.RuUP0xJ2')/'repos'/s/'experiments/codex'/('fidelity-'+s)/'CLAUDIA_BEFORE';log=n/'route.json'
 if not log.exists():continue
 frames=json.load(open(log))['frames']
 rasters=[]
 for f in (b/'ride.mp4',n/'ride.mp4'):
  data=subprocess.check_output(['ffmpeg','-loglevel','error','-threads','1','-i',str(f),'-vf','scale=162:288','-threads','1','-f','rawvideo','-pix_fmt','rgb24','-'])
  rasters.append(np.frombuffer(data,dtype=np.uint8).reshape((-1,288,162,3)))
 before,after=rasters;assert before.shape==after.shape and len(before)==len(frames)
 choose={'08':[0,.25,.50,.75,1.08,1.33,1.67], '06':[.25,.85,1.6,2.7,3.6,4.25,4.9],'07':[.2,4.65,5.4,7.4,9.0,10.4,11.8],'04':[.25,1.15,1.9,2.6,3.2,3.7],'05':[.25,2.5,4.4,5.4,6.0,6.7]}[s]
 fr=[min(len(frames)-1,round(t*12)) for t in choose]
 canvas=Image.new('RGB',(138*len(fr),2*(246+15)));d=ImageDraw.Draw(canvas)
 for k,images in enumerate(rasters):
  for i,j in enumerate(fr):
   d.text((138*i+2,261*k+1),['Claudia ','Codex '][k]+f'{j/12:.2f}s',fill='white')
   canvas.paste(Image.fromarray(images[j]).resize((138,246)),(138*i,261*k+15))
 canvas.save(root/('film-'+s+'.jpg'),quality=88)
 # Per consecutive decoded frame and matched frame residual, below HUD. They flag inspection points, never reference scores.
 a=before[:,37:].astype(np.int16);v=after[:,37:].astype(np.int16)
 ma=lambda arr:np.abs(arr).mean(axis=(1,2,3))
 oldStep=ma(a[1:]-a[:-1]);newStep=ma(v[1:]-v[:-1]);changed=ma(v-a)
 rows=[{'frame':i,'time':round(frames[i]['time'],4),'matchedMeanRGBDelta':round(float(changed[i]),3),'beforeStepMeanDelta':round(float(oldStep[i-1]),3) if i else None,'newStepMeanDelta':round(float(newStep[i-1]),3) if i else None} for i in range(len(a))]
 (root/('film-'+s+'.json')).write_text(json.dumps(rows,indent=2)+'\n')
 print(s,len(a),float(changed.max()),flush=True)
