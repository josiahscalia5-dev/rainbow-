// Temporary QA adapter. The exported Blender profiles drive the existing painted
// water, and the actual bank meshes give its lip relief. Restore reverses both.
import * as THREE from 'three';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

function getSections(mesh) {
  const points = mesh.geometry.attributes.position;
  const sections = new Map();
  const world = new THREE.Vector3();
  mesh.updateWorldMatrix(true, false);
  for (let i = 0; i < points.count; i++) {
    world.fromBufferAttribute(points, i).applyMatrix4(mesh.matrixWorld);
    const depth = Math.round(-world.z * 1000) / 1000;
    const previous = sections.get(depth) ?? [Infinity, -Infinity];
    previous[0] = Math.min(previous[0], world.x);
    previous[1] = Math.max(previous[1], world.x);
    sections.set(depth, previous);
  }
  // Solidify produces extra edge samples along the length. Pool them inside
  // one source cross-section before calculating inner and outer endpoints.
  const sorted = [...sections].sort((a,b) => a[0]-b[0]);
  const grouped = [];
  for (const [s, bounds] of sorted) {
    const prev = grouped.at(-1);
    if (prev && s-prev[0] < 0.08) {
      prev[1][0] = Math.min(prev[1][0], bounds[0]);
      prev[1][1] = Math.max(prev[1][1], bounds[1]);
    } else grouped.push([s, [...bounds]]);
  }
  if (grouped.length < 80) throw new Error('Bank cross-sections missing from GLB');
  return grouped;
}
function interpolate(rows, depth) {
  if (depth <= rows[0][0]) return rows[0][1];
  const hi = rows.findIndex(row => row[0] >= depth);
  if (hi < 0) return rows.at(-1)[1];
  const low = rows[hi-1], high = rows[hi];
  const f = (depth-low[0])/(high[0]-low[0]);
  return low[1].map((v,i) => THREE.MathUtils.lerp(v, high[1][i], f));
}
export async function prepareExperiment() {
  const r = window.__rainbow;
  const group = r.qa3d().scene.getObjectByName('match07_projection');
  const water = group.getObjectByName('m07_water');
  const original = water.material;
  const imported = await new GLTFLoader().loadAsync('/__s07_banks.glb');
  const assets = ['left_bank','right_bank'].map(name => imported.scene.getObjectByName(name));
  if (assets.some(m => !m || !m.isMesh)) throw new Error('Missing named Blender bank meshes');
  const sections = assets.map(getSections);
  const count = 256, min = -2.45, max = 26.15;
  const data = new Float32Array(count*4);
  for (let i=0; i<count; i++) {
    const along = min+(max-min)*i/(count-1);
    data.set([...interpolate(sections[0], along),...interpolate(sections[1], along)],4*i);
  }
  const tex = new THREE.DataTexture(data,count,1,THREE.RGBAFormat,THREE.FloatType);
  tex.minFilter=tex.magFilter=THREE.NearestFilter; tex.needsUpdate=true;
  const declarations = `
    uniform sampler2D uBankSections;
    float bankWeight(float along) {
      float dist = distance(cameraPosition,uProjPos);
      return smoothstep(2.2,5.5,dist)*(1.0-smoothstep(24.0,31.0,dist))
             *smoothstep(-2.1,-0.45,along)*(1.0-smoothstep(19.5,26.1,along));
    }
    vec4 bankSections(float along) {
      float t = clamp((along+2.45)/28.6,0.0,1.0)*255.0;
      float lo=floor(t), hi=min(lo+1.0,255.0);
      return mix(texture2D(uBankSections,vec2((lo+0.5)/256.0,0.5)),
                 texture2D(uBankSections,vec2((hi+0.5)/256.0,0.5)),t-lo);
    }`;
  const marker='float R = uNearW.x, mw = uNearW.y;';
  if (!original.fragmentShader.includes(marker)) throw new Error('Unexpected retained water shader');
  const adjustment = `
    float influence = bankWeight(along);
    if (influence > 0.0) {
      vec4 oldEdges = vCtr + vec4(-R,-R+mw,R-mw,R);
      vec4 e = mix(oldEdges,bankSections(along),influence);
      float mid = 0.5*(e.y+e.z);
      d = vL.x - mid; a=abs(d);
      R = d < 0.0 ? mid-e.x : e.w-mid;
      mw = max(0.05,d < 0.0 ? e.y-e.x : e.w-e.z);
    }`;
  const makeMaterial=(relief) => {
    const mat = original.clone();
    mat.uniforms={...original.uniforms,uBankSections:{value:tex}};
    mat.fragmentShader=original.fragmentShader.replace('vec3 nearWater() {',declarations+'\nvec3 nearWater() {').replace(marker,marker+'\n'+adjustment);
    if (relief) {
      mat.fragmentShader=mat.fragmentShader.replace('void main() {', 'void main() {\n float reliefWeight=bankWeight(-vL.z); if(reliefWeight < 0.015) discard;')
        .replace('gl_FragColor = vec4(pjInverse(t), 1.0);','gl_FragColor = vec4(pjInverse(t), reliefWeight);');
      mat.transparent=true;mat.depthWrite=false;
    }
    mat.needsUpdate=true; return mat;
  };
  const shaped=makeMaterial(false), relief=makeMaterial(true);
  const meshGroup=new THREE.Group();meshGroup.name='Image2Blender Screen 07 banks';
  for (const asset of assets) {
    const mesh=new THREE.Mesh(asset.geometry,relief);
    mesh.name=asset.name;mesh.matrixAutoUpdate=false;mesh.matrix.copy(asset.matrixWorld);
    mesh.frustumCulled=false;meshGroup.add(mesh);
  }
  group.add(meshGroup);meshGroup.visible=false;
  return {
    set(active) {water.material=active ? shaped : original;meshGroup.visible=active;},
    evidence:{geometryNames:assets.map(x=>x.name),vertices:assets.map(x=>x.geometry.attributes.position.count),sectionCounts:sections.map(x=>x.length),
              unmodifiedTextureFiles:['near_bank.png','near_foam.png'],foamMeshesInGLB:['left_foam','right_foam'],foamMeshesAddedToGame:0}};
}
