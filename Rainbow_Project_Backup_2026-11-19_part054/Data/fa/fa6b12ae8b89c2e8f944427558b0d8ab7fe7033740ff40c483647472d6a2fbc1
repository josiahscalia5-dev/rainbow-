from pathlib import Path
from datetime import datetime,timezone
import json,subprocess as sp,sys
p=Path(__file__).parent
others=p
def load(f):return json.loads(f.read_text())
for s in sys.argv[1:]:
 loc=p
 info=load(p/'baseline.json' if s=='06' else others/('baseline-'+s+'.json'))
 repo=loc/'repo' if s=='06' else loc/'repos'/s
 paths=['src/world/match06.ts','assets/textures/match06/mask06_crest_release.png'] if s=='06' else [info['source'],'assets/textures/match04/bay04_approved_metal.png']
 desc={'06':'Replace the hidden provisional crest fill with physical river texture','07':'Fit the shared outlet foam apron to low rounded clusters','04':'Fit one modeled ring bay to the measured Screen 04 entrance metal','05':'Test world-anchored satin lighting on the final S-bend','08':'Parameterize chamber water glints along the measured river curve'}[s]
 def git(*a):return sp.check_output(['git',*a],cwd=repo,text=True,stderr=sp.PIPE).strip()
 def remote(branch):
  ref='refs/heads/'+branch;ans=git('ls-remote','--heads','origin',ref).split()
  return ans[0] if ans else None
 specialist=info['specialists']['06'] if s=='06' else info['specialist']
 assert remote(info['lead']['branch'])==info['lead']['commit']
 assert remote(specialist['branch'])==specialist['commit']
 assert remote(info['parent']['branch'])==info['parent']['commit']
 assert git('branch','--show-current')==info['branch']
 if git('rev-parse','HEAD')==info['parent']['commit']:
  assert remote(info['branch']) is None
  for path in paths:assert (repo/path).read_bytes()==(loc/'games'/s/path).read_bytes()
  git('add','--',*paths);git('diff','--cached','--check')
  assert set(git('diff','--cached','--name-only').splitlines())==set(paths)
  git('commit','-qm',desc)
 tip=git('rev-parse','HEAD');assert git('rev-parse','HEAD^')==info['parent']['commit']
 curr=remote(info['branch']);assert curr is None or curr==tip
 if curr is None:git('push','origin','HEAD:refs/heads/'+info['branch'])
 assert remote(info['branch'])==tip
 output={'commit':tip,'branch':info['branch'],'parent':info['parent']['commit'],'retained':specialist,'sourceFiles':paths,'utc':datetime.now(timezone.utc).isoformat(),'purpose':'Isolated experimental source, pending visual review.'}
 (p/('checkpoint-'+s+'.json')).write_text(json.dumps(output,indent=2)+'\n')
 print(s,tip,'verified',flush=True)
