def listing(sha):
 res={}
 for rec in git('ls-tree','-r','-z',sha,bin=True).split(b'\0'):
  if not rec:continue
  meta,raw=rec.split(b'\t',1);mode,kind,blob=meta.decode().split()
  assert kind=='blob';res[raw.decode()]=(mode,blob)
 return res
