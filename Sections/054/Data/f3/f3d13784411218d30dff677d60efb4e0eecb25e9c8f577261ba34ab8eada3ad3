from pathlib import Path
from PIL import Image
import numpy as np,json,sys
from scipy.ndimage import gaussian_filter,label
root=Path(__file__).resolve().parent
old=Path('/tmp/rainbow-final-fidelity.RuUP0xJ2/repos')
early=Path('/tmp/rainbow-reconstruction.etSm9SmK/repos')
def read(f):return np.asarray(Image.open(f).convert('RGB'),dtype=np.int16)
def write(f,obj):f.write_text(json.dumps(obj,indent=2)+'\n')
def water_highlights(im):
    # Same native crop, with holes for non-cyan material. The tolerance is a texture statistic, not a design score.
    a=im[1040:1490,128:736]; red,green,blue=a.transpose(2,0,1)
    mask=(green-red>38)&(blue-red>40)&(green>78)&(blue>100)
    lum=.2126*red+.7152*green+.0722*blue
    weights=gaussian_filter(mask.astype(float),12)
    local=gaussian_filter(lum*mask,12)/np.maximum(weights,.002)
    glint=mask&(weights>.8)&(lum-local>8)&(lum>150)
    blanks=np.concatenate([np.zeros((1,glint.shape[1]),bool),glint,np.zeros((1,glint.shape[1]),bool)],axis=0)
    lengths=[]
    for col in blanks.T:
        changes=np.flatnonzero(col[1:]!=col[:-1]);lengths.extend((changes[1::2]-changes[::2]).tolist())
    runs=[n for n in lengths if n>=4]
    return {'cyanMaskPixels':int(mask.sum()),'highlightPixels':int(glint.sum()),'verticalRunsAtLeast4px':len(runs),'verticalRun95thPx':float(np.percentile(runs,95)) if runs else 0,'verticalRunsOver30px':sum(x>30 for x in runs),'longestVerticalRunPx':max(runs,default=0)}
for s in sys.argv[1:]:
    baseline=old/s/'experiments/codex'/('fidelity-'+s)
    parent=early/s/'experiments/codex'/s/'NEW' if s=='05' else baseline/'CODEX_NEW'
    new=root/'round2/proof'/s/'NEW'
    if s in ['05','08']:
        poses=['last-left-bend','last-right-bend','last-in-stage'] if s=='05' else ['forward-03','hard-left','hard-right','platform-and-spouts']
        report={'method':'Native x 128..735, y 1040..1489. Restrict to cyan pixels where green-red >38, blue-red >40, green >78 and blue >100. Count vertical contiguous runs at least 4 px, with luma >150 and >8 brighter than local cyan-weighted luma (Gaussian sigma 12 px, support above 0.8). Directions projected into the image depend on the bend. These counts describe bright paint in this crop, not approval or similarity.','poses':{}}
        for pose in poses:
            report['poses'][pose]={lab:water_highlights(read(src/(pose+'.png'))) for lab,src in [('retained',baseline/'CLAUDIA_BEFORE'),('parent',parent),('new',new)]}
        write(root/('water-detail-'+s+'.json'),report)
    if s=='04':
        report={'method':'Restricted fixed upper ring crop x 532..851, y 208..534 at the final pose. Count pixels with green within 18 of red and 35 above blue, with red and green over 105, before and after. This distinguishes the olive reflection photographed here without rating an unpictured pose.','roles':{}}
        for lab,src in [('retained',baseline/'CLAUDIA_BEFORE'),('previous',parent),('new',new)]:
            a=read(src/'last-in-stage.png')[208:535,532:852];red,green,blue=a.transpose(2,0,1)
            report['roles'][lab]={'yellowGreenPixels':int(((np.abs(green-red)<18)&(green-blue>35)&(np.minimum(red,green)>105)).sum()),'cropPixels':len(red.ravel())}
        write(root/'ring-detail-04.json',report)
