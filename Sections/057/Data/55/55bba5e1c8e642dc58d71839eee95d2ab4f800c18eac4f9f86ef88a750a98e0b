from pathlib import Path
import json,sys
from PIL import Image
import numpy as np
root=Path(__file__).parent
c=Path('/tmp/rainbow-reconstruction.etSm9SmK/repos/08/experiments/codex/08/NEW')
n=root/'proof/08/NEW'
out={}
for row in ['opening','forward-03','forward-06','hard-left','hard-right','platform-and-spouts','last-in-stage','across-transition']:
 if not (n/(row+'.png')).exists():continue
 ras=lambda f:np.asarray(Image.open(f).convert('RGB'),dtype=int)
 a,b=ras(c/(row+'.png')),ras(n/(row+'.png'))
 # Same bottom quarter in both frames. Almost entirely river in the early swim and hard-turn views.
 reg=lambda x:x[-384:]
 mg=lambda x:((x[:,:,0]>x[:,:,1]+36)&(x[:,:,0]>x[:,:,2]-74)&(x[:,:,2]>x[:,:,1]+20)).sum()
 out[row]={'lowerQuarterPixels':384*864,'magentaPixelsEarlierCandidate':int(mg(reg(a))),'magentaPixelsNew':int(mg(reg(b))),'totalChangedPixels':int(np.any(a!=b,axis=2).sum())}
bf=root/'chamber-geometry/BEFORE.json';nf=root/'chamber-geometry/NEW.json'
if bf.exists() and nf.exists():
 x,y=(json.load(open(f)) for f in [bf,nf]);delta=[k for k in x if x[k]!=y[k]]
 out['meshAudit']={'namedMeshes':len(x),'geometryOrTransformChanged':delta,'beforeFloor':x['m08_floor'],'newFloor':y['m08_floor']}
(root/'chamber08.json').write_text(json.dumps(out,indent=2)+'\n')
