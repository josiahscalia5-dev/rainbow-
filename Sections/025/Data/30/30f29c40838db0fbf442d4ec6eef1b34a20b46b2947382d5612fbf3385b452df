e().normalize();\n515\t    this.U = f.up.clone().addScaledVector(this.T, -f.up.dot(this.T)).normalize();\n516\t    this.Rt = new THREE.Vector3().crossVectors(this.T, this.U).normalize();\n517\t    this.R = path.radius(sF);\n518\t    const rel = this.c0.clone().sub(eye);\n519\t    this.D0 = rel.dot(this.T);\n520\t    this.q = rel.negate().addScaledVector(this.T, this.D0); // eye − c0 minus its axial part\n521\t  }\n522\t  private interp(x: number, a: 0 | 1) {\n523\t    const k = this.knots, b = (1 - a) as 0 | 1;\n524\t    if (k.length < 2) return x;\n525\t    for (let i = 1; i < k.length; i++) {\n526\t      if (x <= k[i][a] || i === k.length - 1) {\n527\t        const t = (x - k[i - 1][a]) / (k[i][a] - k[i - 1][a]);\n528\t        return k[i - 1][b] + t * (k[i][b] - k[i - 1][b]);\n529\t      }\n530\t    }\n531\t    return x;\n532\t  }\n533\t  /** virtual depth Z of tunnel coordinate u (see `knots`) */\n534\t  zOfU(u: number) { return this.interp(u, 0); }\n535\t  /** tunnel coordinate u of virtual depth Z */\n536\t  uOfZ(Z: number) { return this.interp(Z, 1); }\n537\t  /** 0 = forced perspective (closed), 1 = folded away outside the real tube: the rider camera within\n538\t   *  `near`…`far` units (along the axis) of the section start opens it, so the ride into 06 is untouched */\n539\t  openFor(cam: THREE.Vector3, near = 18, far = 34) {\n540\t    const d = this.c0.clone().sub(cam).dot(this.T);\n541\t    return 1 - THREE.MathUtils.smoothstep(d, near, far);\n542\t  }\n543\t  zOf(Z: number) { return Z / (1 + Z / this.L); }\n544\t  kOf(Z: number) { return (this.D0 + this.zOf(Z)) / (this.D0 + Z); }\n545\t  /** dz/dZ: axial compression of small objects at virtual depth Z */\n546\t  cOf(Z: number) { const a = 1 + Z / this.L; return 1 / (a * a); }\n547\t  /** real position of the virtual point (depth Z, cross-section offset o from the tube centre line) */\n548\t  point(Z: number, o: THREE.Vector3, out = new THREE.Vector3()) {\n549\t    const k = this.kOf(Z);\n550\t    return out.copy(this.c0).addScaledVector(this.T, this.zOf(Z)).add(this.q).addScaledVector(o.clone().sub(this.q), k);\n551\t  }\n552\t  /** virtual depth Z at which the projected radius equals `frac` of the section start's */\n553\t  zForScreen(frac: number) { return this.D0 / frac - this.D0; }\n554\t  /**\n555\t   * Instance matrix for an object placed in the virtual straight tunnel (depth Z, offset o, rotation\n556\t   * basis X/Y/Z, scale s), blended toward its `open` placement (`openPos`, `openScale` multiplier).\n557\t   */\n558\t  matrix(Z: number, o: THREE.Vector3, basis: THREE.Matrix4, s: THREE.Vector3, open: number, openPos: THREE.Vector3, openScale: number, out = new THREE.Matrix4()) {\n559\t    const k = THREE.MathUtils.lerp(this.kOf(Z), openScale, open);\n560\t    const c = THREE.MathUtils.lerp(this.cOf(Z), 1, open);\n561\t    const p = this.point(Z, o).lerp(openPos, open);\n562\t    // A = k·I + (c − k)·T Tᵀ : in-plane scale k, axial scale c\n563\t    const T = this.T;\n564\t    const A = new THREE.Matrix4().set(\n565\t      k + (c - k) * T.x * T.x, (c - k) * T.x * T.y, (c - k) * T.x * T.z, 0,\n566\t      (c - k) * T.y * T.x, k + (c - k) * T.y * T.y, (c - k) * T.y * T.z, 0,\n567\t      (c - k) * T.z * T.x, (c - k) * T.z * T.y, k + (c - k) * T.z * T.z, 0,\n568\t      0, 0, 0, 1,\n569\t    );\n570\t    return out.copy(A).multiply(basis).multiply(new THREE.Matrix4().makeScale(s.x, s.y, s.z)).setPosition(p);\n571\t  }\n572\t  /** wall geometry: uv.y = sF + Z (virtual s, so slot rows continue), radial normals, morph target \"open\" */\n573\t  geometry(radial = 72, steps = 72, inset = 0.004): THREE.BufferGeometry {\n574\t    const rows = steps + 1;\n575\t    const n = rows * (radial + 1);\n576\t    const pos = new Float32Array(n * 3), nor = new Float32Array(n * 3), uv = new Float32Array(n * 2);\n577\t    const ax = new Float32Array(n * 3), au = new Float32Array(n * 3), ext = new Float32Array(n), opn = new Float32Array(n * 3);\n578\t    const d = new THREE.Vector3(), o = new THREE.Vector3(), p = new THREE.Vector3(), cr = new THREE.Vector3();\n579\t    const r0 = this.R * (1 - inset);\n580\t    for (let i = 0; i < rows; i++) {\n581\t      // uniform in projected radius (1/D): dense near the vanishing point where the rings crowd\n582\t      const t = i / steps;\n583\t      const Dv = 1 / (1 / this.D0 - t * (1 / this.D0 - 1 / (this.D0 + this.zEnd)));\n584\t      const Z = Math.max(0, Dv - this.D0);\n585\t      const z = this.zOf(Z);\n586\t      const sReal = this.sF + z;\n587\t      const fr = this.path.frame(sReal);\n588\t      tubeCenterAt(this.path, sReal, cr);\n589\t      const rOpen = this.path.radius(sReal) * 1.1 + 0.4;\n590\t      for (let j = 0; j <= radial; j++) {\n591\t        const th = -1.5 * Math.PI + (j / radial) * Math.PI * 2;\n592\t        d.copy(this.Rt).multiplyScalar(Math.cos(th)).addScaledVector(this.U, Math.sin(th));\n593\t        o.copy(d).multiplyScalar(r0);\n594\t        this.point(Z, o, p);\n595\t        const k = i * (radial + 1) + j;\n596\t        p.toArray(pos, k * 3);\n597\t        d.toArray(nor, k * 3);\n598\t        uv[k * 2] = j / radial; uv[k * 2 + 1] = this.sF + this.uOfZ(Z);\n599\t        this.T.toArray(ax, k * 3); this.U.toArray(au, k * 3);\n600\t        ext[k] = Z - z;\n601\t        // open: just outside the real (flaring) tube wall at the same depth\n602\t        o.copy(fr.right).multiplyScalar(Math.cos(th)).addScaledVector(fr.up, Math.sin(th)).multiplyScalar(rOpen).add(cr);\n603\t        o.toArray(opn, k * 3);\n604\t      }\n605\t    }\n606\t    const idx: number[] = [];\n607\t    for (let i = 0; i < rows - 1; i++) {\n608\t      for (let j = 0; j < radial; j++) {\n609\t        const a = i * (radial + 1) + j, b = a + radial + 1;\n610\t        idx.push(a, b, a + 1, b, b + 1, a + 1);\n611\t      }\n612\t    }\n613\t    const g = new THREE.BufferGeometry();\n614\t    g.setAttribute('position', new THREE.BufferAttribute(pos, 3));\n615\t    g.setAttribute('normal', new THREE.BufferAttribute(nor, 3));\n616\t    g.setAttribute('uv', new THREE.BufferAttribute(uv, 2));\n617\t    g.setAttribute('tubeAxis', new THREE.BufferAttribute(ax, 3));\n618\t    g.setAttribute('tubeUp', new THREE.BufferAttribute(au, 3));\n619\t    g.setAttribute('fgExtra', new THREE.BufferAttribute(ext, 1));\n620\t    g.morphAttributes.position = [new THREE.BufferAttribute(opn, 3)];\n621\t    g.setIndex(idx);\n622\t    g.computeBoundingSphere();\n623\t    return g;\n624\t  }\n625\t\n626\t  /**\n627\t   * The virtual tunnel's water surface: a flat chord across the section at `level` (relative to the tube\n628\t   * centre, along U) — uv.x 0..1 across, uv.y = sF + u. Because the section is a depth compression along\n629\t   * eye rays, this chord sits exactly on the real stream at the section start and rises above it further\n630\t   * in, so it takes over from the real water ribbon without a seam. Morph \"open\": dropped below the\n631\t   * real tube bottom.\n632\t   */\n633\t  chordGeometry(level: number, cols = 12, steps = 64, widthFrac = 1): THREE.BufferGeometry {\n634\t    const rows = steps + 1;\n635\t    const n = rows * (cols + 1);\n636\t    const pos = new Float32Array(n * 3), nor = new Float32Array(n * 3), uv = new Float32Array(n * 2);\n637\t    const ext = new Float32Array(n), opn = new Float32Array(n * 3);\n638\t    const o = new THREE.Vector3(), p = new THREE.Vector3(), cr = new THREE.Vector3();\n639\t    const w = Math.sqrt(Math.max(0, this.R * this.R - level * level)) * 0.995 * widthFrac;\n640\t    for (let i = 0; i < rows; i++) {\n641\t      const t = i / steps;\n642\t      const Dv = 1 / (1 / this.D0 - t * (1 / this.D0 - 1 / (this.D0 + this.zEnd)));\n643\t      const Z = Math.max(0, Dv - this.D0);\n644\t      const z = this.zOf(Z);\n645\t      const sReal = this.sF + z;\n646\t      const fr = this.path.frame(sReal);\n647\t      tubeCenterAt(this.path, sReal, cr);\n648\t      const rr = this.path.radius(sReal);\n649\t      for (let j = 0; j <= cols; j++) {\n650\t        const x 