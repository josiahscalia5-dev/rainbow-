** far water body: outer bank of each far bend (units from the axis; the floor chord is ≈6.53, foam rim outside) */\n26\tconst EXTENT_FAR = 6.25;\n27\t\n28\t/**\n29\t * Designed far path: lateral of the VISIBLE cyan core (units along ft.Rt, + = right) at virtual depth Z beyond the\n30\t * seam. Fitted to the reference core (between the two pink bands) back-projected through the locked 05 eye\n31\t * (f 1278 px, VP (500,479), eye 3.56 u above the far water plane): y 538 → core x 506–553 (Z≈24), 532 → 525–560\n32\t * (Z≈32), 526 → 529–565 (Z≈43), 511 → 513–561 (Z≈88), 508 → 518–555 (Z≈103), then back left into the VP:\n33\t * coins/core ≈505 at y 496 (Z≈215), ≈490 at y 490 (Z≈330). The first knots continue the real exit bend\n34\t * (route lateral ≈0.3 at Z≈6) straight into the right swing (the reference's dip to the left at y≈550 sits where\n35\t * the locked course has its exit bend, so it is not chased: that would add a wiggle at the seam).\n36\t */\n37\texport const FAR05_CORE: [number, number][] = [\n38\t  [8, 0.55], [12, 0.75], [17, 1.0], [24, 1.8], [32, 2.75], [43, 3.4], [60, 3.6], [88, 4.0], [110, 4.35], [140, 4.45],\n39\t  [175, 4.1], [212, 2.6], [260, 0.8], [310, -1.6], [350, -2.5], [400, -2.8],\n40\t];\n41\t\n42\tfunction smoothstep(a: number, b: number, x: number) {\n43\t  const t = Math.min(1, Math.max(0, (x - a) / (b - a)));\n44\t  return t * t * (3 - 2 * t);\n45\t}\n46\t/** same smooth minimum as the ribbon shader */\n47\tfunction smin(a: number, b: number, k: number) {\n48\t  const h = Math.max(k - Math.abs(a - b), 0) / k;\n49\t  return Math.min(a, b) - h * h * k * 0.25;\n50\t}\n51\t/** C¹ monotone-free cubic Hermite through knots (Catmull-Rom tangents, flat ends) */\n52\tfunction hermite(k: [number, number][], x: number) {\n53\t  const n = k.length;\n54\t  if (x <= k[0][0]) return k[0][1];\n55\t  if (x >= k[n - 1][0]) return k[n - 1][1];\n56\t  let i = 0;\n57\t  while (x > k[i + 1][0]) i++;\n58\t  const tan = (j: number) => (j === 0 || j === n - 1 ? 0 : (k[j + 1][1] - k[j - 1][1]) / (k[j + 1][0] - k[j - 1][0]));\n59\t  const [x0, p0] = k[i], [x1, p1] = k[i + 1];\n60\t  const h = x1 - x0, t = (x - x0) / h, t2 = t * t, t3 = t2 * t;\n61\t  return (2 * t3 - 3 * t2 + 1) * p0 + (t3 - 2 * t2 + t) * h * tan(i) + (-2 * t3 + 3 * t2) * p1 + (t3 - t2) * h * tan(i + 1);\n62\t}\n63\t\n64\t/** one row of the river layout, all laterals in units from the tunnel axis along ft.Rt */\n65\texport interface FarRiverRow {\n66\t  /** route (water body) centre */\n67\t  xB: number;\n68\t  /** water body half width */\n69\t  hw: number;\n70\t  /** left / right pink band centre and half width */\n71\t  cL: number; wL: number; cR: number; wR: number;\n72\t  /** visible cyan core centre (between the bands) — flow lines and the far coins follow it */\n73\t  core: number;\n74\t}\n75\t\n76\t/**\n77\t * The real 05 ribbon's band layout (waterRibbon.ts FRAG, 05 block with sw = 1, freeK = 0, Benny far away,\n78\t * time-dependent wobble/noise left out) for a route centre xB, half width hw, core swing M (from the route\n79\t * centre) and band S offset sb, at arc length s (only feeds the slow sin() modulations).\n80\t */\n81\texport function bandLayout(xB: number, hw: number, M: number, sb: number, s: number): FarRiverRow {\n82\t  const Mb = M + sb;\n83\t  let offL = hw * (0.62 + 0.03 * Math.sin(s * 0.13 + 1.7));\n84\t  let offR = hw * (0.62 + 0.03 * Math.sin(s * 0.11 + 4.2));\n85\t  let wL = hw * 0.19 * (1 + 0.15 * Math.sin(s * 0.19 + 0.4));\n86\t  let wR = hw * 0.19 * (1 + 0.15 * Math.sin(s * 0.17 + 2.9));\n87\t  const roomL = Mb + hw - 0.5 - offL, roomR = hw - 0.5 - Mb - offR;\n88\t  wL = smin(wL, Math.max(roomL, 0.6 * wL), 0.5);\n89\t  wR = smin(wR, Math.max(roomR, 0.6 * wR), 0.5);\n90\t  offL = smin(offL, Mb + hw - wL - 0.5, 1.2);\n91\t  offR = smin(offR, hw - wR - 0.5 - Mb, 1.2);\n92\t  const cL = xB + Mb - offL, cR = xB + Mb + offR;\n93\t  return { xB, hw, cL, wL, cR, wR, core: 0.5 * (cL + wL + cR - wR) };\n94\t}\n95\t\n96\t/** the ribbon shader's 05 band S (sbend) */\n97\tconst sbend05 = (s: number) => 1.05 * Math.sin(s * 0.31 - 0.834) + 0.18 * Math.sin(s * 0.62 + 0.6);\n98\t\n99\texport interface FarRiverLayout {\n100\t  row(Z: number): FarRiverRow;\n101\t  /** half chord of the tube floor at the water level */\n102\t  chord: number;\n103\t}\n104\t\n105\t/**\n106\t * Far design row for a water-body centre xB: the body hugs the outer wall of each bend (half width\n107\t * EXTENT_FAR − |xB|); the two pink bands are thin lines near the banks (ref 05 far field: 3–10 px bands, the cyan\n108\t * core fills the river), the inner-bank band sits a little further in.\n109\t */\n110\tfunction designFromXB(xB: number, Z: number): FarRiverRow {\n111\t  const hw = EXTENT_FAR - Math.sqrt(xB * xB + 0.09);\n112\t  const bend = Math.min(1, Math.abs(xB) / 2.5);\n113\t  const aIn = 0.25 + 0.2 * bend, aOut = 0.25 - 0.08 * bend;\n114\t  const aL = xB >= 0 ? aIn : aOut, aR = xB >= 0 ? aOut : aIn;\n115\t  const w = Math.min(0.65, Math.max(0.26, 0.13 * hw)) * (1 - 0.35 * smoothstep(60, 200, Z));\n116\t  const cL = xB - hw * (1 - aL), cR = xB + hw * (1 - aR);\n117\t  return { xB, hw, cL, wL: w, cR, wR: w, core: 0.5 * (cL + cR) };\n118\t}\n119\t\n120\t/**\n121\t * Layout of the far river at virtual depth Z. For small Z it is the REAL ribbon exactly as the eye would see it\n122\t * there without the far section: at the seam the route is in its exit bend (heading ≈26° off the axis), so a\n123\t * screen row cuts the ribbon diagonally — each band centre / bank edge curve l(s) of the real ribbon is intersected\n124\t * with the row (axial = Z), widths divided by cos(heading). It blends (Z 2 → 10) into the designed FAR05_CORE path.\n125\t */\n126\texport function farRiverLayout(course: Course, ft: ForcedTunnel, level: number): FarRiverLayout {\n127\t  const q = new THREE.Vector3();\n128\t  const at = (s: number, l: number) => {\n129\t    const f = course.sample(s);\n130\t    q.copy(f.pos).addScaledVector(f.right, l).sub(ft.c0);\n131\t    return { ax: q.dot(ft.T), x: q.dot(ft.Rt), rx: f.right.dot(ft.Rt) };\n132\t  };\n133\t  // the real ribbon's band layout at s, relative to the route centre (ribbon frame, vCore = coreLateral)\n134\t  const relLay = (s: number) => bandLayout(0, course.widthAt(s) / 2, coreLateral(course, s), sbend05(s), s);\n135\t  const cross = (Z: number, lOf: (s: number) => number) => {\n136\t    let a = ft.sF - 8, b = ft.sF + 16;\n137\t    for (let i = 0; i < 36; i++) { const m = 0.5 * (a + b); if (at(m, lOf(m)).ax < Z) a = m; else b = m; }\n138\t    const s = 0.5 * (a + b), p = at(s, lOf(s));\n139\t    return { s, x: p.x, rx: Math.max(0.3, p.rx) };\n140\t  };\n141\t  const realRow = (Z: number): FarRiverRow => {\n142\t    const eL = cross(Z, (s) => -course.widthAt(s) / 2), eR = cross(Z, (s) => course.widthAt(s) / 2);\n143\t    const bl = cross(Z, (s) => relLay(s).cL), br = cross(Z, (s) => relLay(s).cR);\n144\t    const wL = relLay(bl.s).wL / bl.rx, wR = relLay(br.s).wR / br.rx;\n145\t    return { xB: 0.5 * (eL.x + eR.x), hw: 0.5 * (eR.x - eL.x), cL: bl.x, wL, cR: br.x, wR, core: 0.5 * (bl.x + wL + br.x - wR) };\n146\t  };\n147\t  const designRow = (Z: number): FarRiverRow => {\n148\t    const target = hermite(FAR05_CORE, Z);\n149\t    let a = -5, b = 5;\n150\t    for (let i = 0; i < 36; i++) { const m = 0.5 * (a + b); if (designFromXB(m, Z).core < target) a = m; else b = m; }\n151\t    return designFromXB(0.5 * (a + b), Z);\n152\t  };\n153\t  const chord = Math.sqrt(Math.max(0, ft.R * ft.R - level * level)) * 0.995;\n154\t  return {\n155\t    chord,\n156\t    row(Z) {\n157\t      const w = smoothstep(2, 10, Z);\n158\t      if (w <= 0) return realRow(Z);\n159\t      const d = designRow(Z);\n160\t      if (w >= 1) return d;\n161\t      const r = realRow(Math.min(Z, 8));\n162\t      const o = {} as FarRiverRow;\n163\t      for (const k of Object.keys(d) as (keyof FarRiverRow)[]) o[k] = r[k] + (d[k] - r[k]) * w;\n164\t      return o;\n165\t    },\n166\t  };\n167\t}\n168\t\n169\t/**\n170\t * The far river surface in the virtual tunnel: one row per screen step (uniform in 1/depth, like the far wall),\n171\t * spanning the whole tube floor chord at `level` so it covers the real ribbon's continuation behind the seam.\n172\t * Columns: 3 over each bank, `cols` over the water body (whose centre/width change per row); the body has the\n173\t * ribbon's trough profile (EDGE_LIFT·|u|³) so it lands on the real ribbon at the seam, the banks sit a little\n174\t * higher (foam rims). Attributes for farRiverMaterial: aRivLat (lateral, units from the axis), aRivA (xB, hw,\n175\t * cL, cR), aRivB (wL, wR, core, Z), fgExtra (virtual − real depth). Morph \"open\": dropped below the real tube\n176\t * bottom (as the old chord), so the ride into 06 is untouched.\n177\t */\n178\texport function farRiverGeometry(ft: ForcedTunnel, lay: FarRiverLayout, level: number, cols = 16, steps = 120): THREE.BufferGeometry {\n179\t  const bank = 3;\n180\t  const per = cols + 1 + 2 * bank;\n181\t  const rows = steps + 1;\n182\t  const n = rows * per;\n183\t  const pos = new Float32Array(n * 3), nor = new Float32Array(n * 3), uv = new Float32Array(n * 2);\n184\t  const lat = new Float32Array(n), A = new Float32Array(n * 4), B = new Float32Array(n * 4), ext = new Float32Array(n), opn = new Float32Array(n * 3);\n185\t  const o = new THREE.Vector3(), p = new THREE.Vector3(), cr = new THREE.Vector3();\n186\t  const ch = lay.chord;\n187\t  for (let i = 0; i < rows; i++) {\n188\t    const t = i / steps;\n189\t    const Dv = 1 / (1 / ft.D0 - t * (1 / ft.D0 - 1 / (ft.D0 + ft.zEnd)));\n190\t    const Z = Math.max(0, Dv - ft.D0);\n191\t    const z = ft.zOf(Z);\n192\t    const sReal = ft.sF + z;\n193\t    const fr = ft.path.frame(sReal);\n194\t    tubeCenterAt(ft.path, sReal, cr);\n195\t    const rr = ft.path.radius(sReal);\n196\t    const r = lay.row(Z);\n197\t    const e0 = Math.max(-ch + 0.05, r.xB - r.hw), e1 = Math.min(ch - 0.05, r.xB + r.hw);\n198\t    for (let j = 0; j < per; j++) {\n199\t      let x: number, h: number;\n200\t      if (j < bank) { const f = j / bank; x = -ch + (e0 + ch) * f; h = EDGE_LIFT + 0.1 * Math.sin(Math.PI * f); }\n201\t      else if (j > bank + cols) { const f = (j - bank - cols) / bank; x = e1 + (ch - e1) * f; h = EDGE_LIFT + 0.1 * Math.sin(Math.PI * f); }\n202\t      else {\n203\t        const f = (j - bank) / cols; x = e0 + (e1 - e0) * f;\n204\t        const u = Math.min(1, Math.abs(x - r.xB) / Math.max(0.5, r.hw));\n205\t        h = EDGE_LIFT * u * u * u;\n206\t      }\n207\t      o.copy(ft.Rt).multiplyScalar(x).addScaledVector(ft.U, level + h);\n208\t      ft.point(Z, o, p);\n209\t      const k = i * per + j;\n210\t      p.toArray(pos, k * 3);\n211\t      ft.U.toArray(nor, k * 3);\n212\t      uv[k * 2] = (x + ch) / (2 * ch); uv[k * 2 + 1] = ft.sF + ft.uOfZ(Z);\n213\t      lat[k] = x;\n214\t      A[k * 4] = r.xB; A[k * 4 + 1] = r.hw; A[k * 4 + 2] = r.cL; A[k * 4 + 3] = r.cR;\n215\t      B[k * 4] = r.wL; B[k * 4 + 1] = r.wR; B[k * 4 + 2] = r.core; B[k * 4 + 3] = Z;\n216\t      ext[k] = Z - z;\n217\t      o.copy(cr).addScaledVector(fr.right, x * (rr / ft.R)).addScaledVector(fr.up, -rr - 0.6);\n218\t      o.toArray(opn, k * 3);\n219\t    }\n220\t  }\n221\t  const idx: number[] = [];\n222\t  for (let i = 0; i < rows - 1; i++) {\n223\t    for (let j = 0; j < per - 1; j++) {\n224\t      const a = i * per + j, b = a + per;\n225\t      idx.push(a, a + 1, b, b, a + 1, b + 1);\n226\t    }\n227\t  }\n228\t  const g = new THREE.BufferGeometry();\n229\t  g.setAttribute('position', new THREE.BufferAttribute(pos, 3));\n230\t  g.setAttribute('normal', new THREE.BufferAttribute(nor, 3));\n231\t  g.setAttribute('uv', new THREE.BufferAttribute(uv, 2));\n232\t  g.setAttribute('aRivLat', new THREE.BufferAttribute(lat, 1));\n233\t  g.setAttribute('aRivA', new THREE.BufferAttribute(A, 4));\n234\t  g.setAttribute('aRivB', new THREE.BufferAttribute(B, 4));\n235\t  g.setAttribute('fgExtra', new THREE.BufferAttribute(ext, 1));\n236\t  