"""Assemble one isolated review with native pictures, lossless sources and matched footage."""
import hashlib, json, os, shutil, sys
from pathlib import Path
import numpy as np
from PIL import Image
from scipy.ndimage import gaussian_filter

root, prior_qa, donor, coat, world = map(Path,sys.argv[1:6])
role=sys.argv[6]
spec=json.loads((root/"source.json").read_text())
out=root/"repo"/"experiments"/spec["branch"]
def transfer(p,d):
    d=out/d;d.parent.mkdir(parents=True,exist_ok=True)
    if d.exists():return
    try:os.link(p,d)
    except OSError:shutil.copyfile(p,d)
def read(p):return json.loads(p.read_text())
def write(name,data):
    p=out/name;p.parent.mkdir(parents=True,exist_ok=True);p.write_text(json.dumps(data,indent=2)+'\n')
def rgb(p):return np.asarray(Image.open(p).convert("RGB"),dtype=np.int16)
game=root/'games/06';art=game/spec['officialArtwork']
before=root/'proof/06/BEFORE';new=(root if role=='scenery' else root/'final')/'proof/06/NEW'
assert hashlib.sha256(art.read_bytes()).hexdigest()==spec['references'][spec['officialArtwork']]
transfer(art,'APPROVED.jpg')
for source,tag in [(before,'CLAUDIA_BEFORE'),(new,'CODEX_NEW')]:
    for p in source.iterdir():
        if p.is_file() and p.name!='opening-repeat.png':transfer(p,tag+'/'+p.name)
for x in ('queries.json','flags.json','capture.cjs'):transfer(root/x,'reproduce/'+x)
for x in ('compare-opening.py','score-rgba.mjs','validate-structure-captures.py'):transfer(prior_qa/x,'reproduce/'+x)
transfer(game/'scripts/gameplay-test.mjs','reproduce/fixture/06/gameplay-test.mjs')
transfer(root/'source.json','checks/source.json')
transfer(world/'checkpoint/source-checkpoint.json','checks/protected-checkpoint.json')
transfer(root/'authoring/motion.json','checks/motion.json')
for x in ('build.txt','continuity.txt','protected-artwork.txt'):transfer(root/'diagnostics'/x,'checks/'+x)
ref,old,native=map(rgb,[art,before/'opening.png',new/'opening.png'])
areas={}
for key,rect in {'whole':[0,0,864,1536],'underCrest':[295,575,560,710],'goldAndWall':[335,242,858,557],'bennyArea':[205,730,635,1172]}.items():
    x,y,r,b=rect;areas[key]={'xyxy':rect}
    for name,src in [('Claudia',old),('Codex',native)]:
        error=abs(src[y:b,x:r]-ref[y:b,x:r]).mean(2)
        areas[key][name]={'meanAbsoluteRGB':round(float(error.mean()),4),'within20Percent':round(float((error<=20).mean()*100),4)}
write('checks/opening-regions.json',areas)
if role=='scenery':
    transfer(root/'authoring/Screen06_Arched_Washer_Passage.blend','editable/Screen06_Arched_Washer_Passage.blend')
    transfer(donor/'inputs/layout.json','editable/world-layout.json')
    transfer(root/'authoring/model-verification.json','checks/model-verification.json')
    transfer(donor/'inputs/panel-source.json','checks/approved-wall-source.json')
    write('checks/fal.json',{'connection':'ready','connectedAccount':'Josiah Scalia','scope':'personal account',
            'originalTopUpReportedByOwnerUSD':10,'remainingUSD':None,'costOfThisExperimentUSD':0,
            'newPaidJobs':0,'existingRequestHistoryChecked':7,'historyFamily':'fal-ai/nano-banana-2/edit',
            'existingScreen06MeshFound':False,'review':'The available prior images depict the Screen 04 entrance or Screen 08 chamber. The repository records the Screen 06 clean plate as prepared only.'})
else:
    final=root/'final/authoring'
    assert np.array_equal(native,rgb(final/'character-full.png'))
    beforeMask=abs(old-rgb(coat/'authoring/hidden-fur_body.png')).sum(2)>30
    clean=np.zeros(beforeMask.shape,bool);clean[1080:1176,327:535]=True
    currentMask=abs(native-rgb(final/'hide-fur_body.png')).sum(2)>30
    clean &= beforeMask & currentMask
    previous=rgb(coat/'repo/experiments/codex/s06-benny-layered-coat/CODEX_NEW/opening.png')
    colors={}
    for tag,data in [('approved',ref),('retained',old),('previousCoat',previous),('presentTrial',native)]:
        yy=.2126*data[:,:,0]+.7152*data[:,:,1]+.0722*data[:,:,2]
        smooth=gaussian_filter(yy,1.15);locks=smooth-gaussian_filter(yy,4.)
        colors[tag]={'medianRGB':np.median(data[clean],0).tolist(),'bodyCoreMeanAbsoluteRGB':round(float(abs(data[clean]-ref[clean]).mean()),3),'furFineDetailRMS':round(float(np.sqrt(np.mean((yy[clean]-smooth[clean])**2))),3),'lockContrastRMS':round(float(np.sqrt(np.mean(locks[clean]**2))),3)}
    bounds={}
    for name in ['Benny','hat','hat_brim','fur_pom','fur_body','fur_armL','fur_armR']:
        mask=abs(native-rgb(final/('hide-'+name+'.png'))).sum(2)>30
        yy,xx=np.where(mask)
        bounds[name]={'visibleXYXY':[int(xx.min()),int(yy.min()),int(xx.max()),int(yy.max())],'width':int(xx.max()-xx.min()+1),'height':int(yy.max()-yy.min()+1)}
    baseVis=abs(old-rgb(coat/'authoring/hidden-Benny.png')).sum(2)>30
    newVis=abs(native-rgb(final/'hide-Benny.png')).sum(2)>30
    overall=baseVis|newVis
    report={'coreXYXY':[327,1080,535,1176],'commonBodyPixels':int(clean.sum()),'bodyCore':colors,'renderedNativeBounds':bounds,
            'originalHandRead':{'wholeWidthHeight':[435,459],'cuffBottomY':1026,'uncertaintyPx':8},
            'retainedBounds':read(coat/'authoring/native-parts.json'),
            'fullActorFootprintMeanAbsRGB':{tag:round(float(abs(im[overall]-ref[overall]).mean()),3) for tag,im in [('retained',old),('previousCoat',previous),('presentTrial',native)]}}
    write('checks/pink-and-hat.json',report);transfer(root/'authoring/fit.json','checks/fit.json')
    transfer(root/'capture-character.cjs','reproduce/capture-character.cjs')
    for name,p in [('APPROVED',art),('CLAUDIA_BEFORE',before/'opening.png'),('CODEX_NEW',new/'opening.png')]:
        destination=out/'character'/(name+'.png');destination.parent.mkdir(exist_ok=True)
        Image.open(p).convert('RGB').crop((154,658,704,1293)).save(destination)
    for name in ['hard-left','hard-right','middle']:
        for prefix,folder in [('CLAUDIA_BEFORE',before),('CODEX_NEW',new)]:
            # The original image has no approved steering pose. Preserve full-size screen pairs.
            assert (out/prefix/(name+'.png')).is_file()
print(str(out))
