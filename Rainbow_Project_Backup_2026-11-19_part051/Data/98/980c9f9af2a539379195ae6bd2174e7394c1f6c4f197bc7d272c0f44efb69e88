// Keep the community inspection proxy scoped to this disposable browser.
const net=require('node:net');
const listen=net.Server.prototype.listen;
net.Server.prototype.listen=function(...args){
 const options=args[0],port=Number(process.env.BRIDGE_PORT);
 if(typeof options==='number' && options===port && typeof args[1]!=='string')args.splice(1,0,'127.0.0.1');
 else if(options && typeof options==='object' && Number(options.port)===port)args[0]={...options,host:'127.0.0.1'};
 return listen.apply(this,args);
};
