.startsWith(`--${k}=`)); return a ? a.slice(k.length + 3) : d; };\nconst q = arg('q'), t0 = Number(arg('t0', '43')), t1 = Number(arg('t1', '47')), every = Number(arg('every', '1'));\nconst out = arg('out', 'qa/gameplay_video/camtrace.json');\nconst steerPlan = arg('steerplan') ? arg('steerplan').split(',').map((p) => p.split(':').map(Number)) : [];\nconst lock = JSON.parse(readFileSync('assets/textures/match08/cam08_locked.json', 'utf8'));\nconst { chromium } = loadPlaywright();\nconst vite = await startVite(5238);\nconst browser = await chromium.launch({ args: CHROMIUM_ARGS });\nconst page = await browser.newPage({ viewport: { width: 90, height: 160 } });\nawait page.goto(`${vite.url}/?qa=1&dpr=1&bloom=0${q ? '&' + q : ''}`);\nawait page.waitForFunction(() => window.__rainbow?.ready === true || window.__error, null, { timeout: 240000 });\nconst rows = await page.evaluate(({ t0, t1, every, steerPlan, lock }) => {\napk-web-check.mjs\naspect-test.mjs\nautosave-cron.sh\nautosave-daemon.sh\nautosave-hook.sh\nautosave-status.py\ncamera-lock-05.mjs\ncamera-lock-overlay.py\ncapture.mjs\ncinematic-test.mjs\nclaude-bootstrap.sh\ncloud-env-setup.sh\ncompare.py\ncontinuity-test.ts\nexport-models.mjs\nexport-river-05.ts\nexport_claude_sessions.py\nflow05-dump.ts\ngameplay-test.mjs\ninstall-autosave-scheduler.sh\nlandmarks05.py\nlib\nmatch-cam-fit.mjs\nmatch-cam-try.mjs\nmatch-geo.mjs\nmatch-probe.mjs\nperf05.mjs\nproj05-lid-fit.mjs\nproj05-lid-raycast.mjs\nproj05-move.mjs\nproj05-probe.mjs\nproj05-tunnel-probe.mjs\nrainbow-autosave.py\nreference.sha256\nresume-newest-work.sh\nscreen_report.py\nsetup-android-sdk.sh\nsetup-blender.sh\nsetup-image-blaster.sh\nsetup-worldlabs-plugin.sh\ntriptych.py\nverify-assets.py\nwater-lab.mjs\n{\n  \"name\": \"rainbow-washer-game\",\n  \"private\": true,\n  \"version\": \"0.1.0\",\n  \"description\": \"RAINBOW — 11-screen real-time 3D portrait mobile game (Three.js + TypeScript + Vite + Capacitor)\",\n  \"type\": \"module\",\n  \"scripts\": {\