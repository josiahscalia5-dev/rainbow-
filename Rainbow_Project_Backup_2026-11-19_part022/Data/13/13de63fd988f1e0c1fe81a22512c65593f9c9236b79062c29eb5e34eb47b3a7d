um } = loadPlaywright();\nconst vite = await startVite(5241);\nconst browser = await chromium.launch({ args: CHROMIUM_ARGS });\nconst log = { q: Q, frames: [] };\ntry {\n  const page = await browser.newPage({ viewport: { width: 864, height: 1536 }, deviceScaleFactor: 1 });\n  page.on('pageerror', (e) => console.error('pageerror', e.message));\n  await page.goto(`${vite.url}/?qa=1&dpr=1${Q ? '&' + Q : ''}`);\n  await page.waitForFunction(() => window.__rainbow?.ready === true || window.__error, null, { timeout: 240000 });\n  const shot = async (file, extra) => {\n    await page.evaluate(() => window.__rainbow.drawList());\n    await page.screenshot({ path: file });\n    const st = await page.evaluate(() => window.__rainbow.state());\n    log.frames.push({ file, ...extra, s: st.s, cam: st.cam, lat: st.lat });\n  };\n  if (D.length) {\n    await page.evaluate(() => window.__rainbow.goto('05'));\n    const s0 = (await page.evaluate(() => window.__rainbow.state())).s;\n    for (const d of D) {\n      // ride with the real simulation until s >= s0 + d (shader clock stays frozen: only the camera moves)\n      await page.evaluate(([target]) => { const R = window.__rainbow; let k = 0; while (R.state().s < target && k++ < 20000) R.step(1, 1 / 60); }, [s0 + d]);\n      await shot(`${OUT}/move_${String(d).padStart(2, '0')}.png`, { d });\n      console.log('move', d, JSON.stringify(log.frames.at(-1)));\n    }\n  }\n  if (opt.still) {\n    mkdirSync(`${OUT}/still`, { recursive: true });\n    const n = Math.round(Number(opt.still) * fps);\n    await page.evaluate(() => window.__rainbow.goto('05'));\n    for (let i = 0; i < n; i++) {\n      await page.evaluate(([t]) => { const R = window.__rainbow; R.freezeAt(t); R.step(1, 1e-4); }, [12 + i / fps]);\n      await shot(`${OUT}/still/${String(i).padStart(4, '0')}.png`, { t: 12 + i / fps });\n    }\n    console.log('still frames', n);\n  }\n  if (opt.steer) {\n    // Benny steers from the locked checkpoint: hold left / right, frames at 0.25 / 0.5 / 0.8 s (real simulation)\n    for (const dir of String(opt.steer).split(',').map(Number)) {\n      await page.evaluate(() => window.__rainbow.goto('05'));\n      let tPrev = 0;\n      for (const t of [0.25, 0.5, 0.8]) {\n        await page.evaluate(([dir, n]) => { const R = window.__rainbow; R.setSteer(dir); R.step(n, 1 / 60); }, [dir, Math.round((t - tPrev) * 60)]);\n        tPrev = t;\n        await shot(`${OUT}/steer_${dir < 0 ? 'L' : 'R'}_${String(Math.round(t * 100)).padStart(3, '0')}.png`, { steer: dir, t });\n        console.log('steer', dir, t, JSON.stringify(log.frames.at(-1).lat));\n      }\n    }\n  }\n  if (opt.zigzag) {\n    // a steering clip with the clock running: left, right, left (flow + Benny moving across the water)\n    mkdirSync(`${OUT}/zigzag`, { recursive: true });\n    const n = Math.round(Number(opt.zigzag) * fps);\n    await page.evaluate(() => window.__rainbow.goto('05'));\n    for (let i = 0; i < n; i++) {\n      const ph = (i / n) * 3;\n      const dir = ph < 0.5 ? -1 : ph < 1.5 ? 1 : ph < 2.5 ? -1 : 1;\n      await page.evaluate(([t, dt, dir]) => { const R = window.__rainbow; R.setSteer(dir); R.freezeAt(t); R.step(Math.round(dt * 60), 1 / 60); R.freezeAt(t + dt); R.step(1, 1e-4); }, [12 + i / fps, 1 / fps, dir]);\n      await shot(`${OUT}/zigzag/${String(i).padStart(4, '0')}.png`, { t: 12 + (i + 1) / fps, steer: dir });\n    }\n    console.log('zigzag frames', n);\n  }\n  if (opt.clip) {\n    mkdirSync(`${OUT}/clip`, { recursive: true });\n    const n = Math.round(Number(opt.clip) * fps);\n    await page.evaluate(() => window.__rainbow.goto('05'));\n    for (let i = 0; i < n; i++) {\n      await page.evaluate(([t, dt]) => { const R = window.__rainbow; R.freezeAt(t); R.step(Math.round(dt * 60), 1 / 60); R.freezeAt(t + dt); }, [12 + i / fps, 1 / fps]);\n      await shot(`${OUT}/clip/${String(i).padStart(4, '0')}.png`, { t: 12 + (i + 1) / fps });\n    }\n    console.log('clip frames', n);\n  }\n} finally {\n  writeFileSync(`${OUT}/move_log.json`, JSON.stringify(log, null, 1));\n  await browser.close();\n  await vite.close();\n}\n", "structuredPatch": [{"lines": [" #!/usr/bin/env node", "-// Screen 05 projection test — MOVING CAMERA (2026-11-16). Starts at the locked 05 checkpoint and rides forward with", "-// the real game simulation (Benny + camera rig + course unchanged), capturing full-size frames.", "-//   node scripts/proj05-move.mjs --q='proj05=1' --out=DIR [--d=0,1,2,4,8,16,30,50] [--clip=SECONDS --fps=24]", "-// --d: distances ahead of the checkpoint (units of s) → DIR/move_<d>.png (shader clock frozen at 12: shows layout only)", "-// --clip: a riding clip with the shader clock running (flow animation) → DIR/clip/0000.png … (encode with ffmpeg)", "-// --still=SECONDS: water animation at the LOCKED camera (clock runs, camera still) → DIR/still/0000.png …", "+// Screen 05 motion check: the REAL game from the locked 05 checkpoint, ridden forward by the deterministic simulation", "+// (window.__rainbow.step, steering centred), one screenshot every --at units of arc length ahead.", "+//   node scripts/proj05-move.mjs --q='proj05=1&projlid05=1' --at=0,5,10,20 --out=DIR", "+// Writes DIR/move_<d>.png and DIR/move_log.json (s, Benny lateral, camera). Read-only: the game is unchanged.", " import { mkdirSync, writeFileSync } from 'node:fs';", " import { loadPlaywright, CHROMIUM_ARGS, startVite } from './lib/pw.mjs';", "+", " const opt = Object.fromEntries(process.argv.slice(2).filter((a) => a.startsWith('--')).map((a) => { const [k, ...r] = a.slice(2).split('='); return [k, r.length ? r.join('=') : true]; }));", "+const OUT = typeof opt.out === 'string' ? opt.out : 'qa/pilot05/proj/tunnel/move';", " const Q = typeof opt.q === 'string' ? opt.q : '';", "-const OUT = typeof opt.out === 'string' ? opt.out : 'qa/pilot05/proj/move';", "-const D = typeof opt.d === 'string' ? opt.d.split(',').map(Number) : [];", "-const fps = Number(opt.fps ?? 24);", "+const AT = (typeof opt.at === 'string' ? opt