def frame(file, folder, commit, repo_file=None, identification=''):
    file = Path(file)
    data = file.read_bytes()
    with Image.open(io.BytesIO(data)) as img:
        w, h = img.size
    assert (w,h)==(864,1536), file
    if repo_file:
        oid = subprocess.check_output(['git','--git-dir=objects.git','rev-parse', commit+':'+repo_file],text=True).strip()
        b = hashlib.sha1(b'blob '+str(len(data)).encode()+b'\0'+data).hexdigest()
        assert oid == b, (file,oid,b)
    else:
        oid = None
    images.append(dict(file=folder,source_commit=commit,source_path=repo_file,source_url=http+commit+'/'+quote(repo_file) if repo_file else None,
                       sha256=hashlib.sha256(data).hexdigest(),git_blob=oid,dimensions=[w,h],description=identification))
    entries.append((folder,data))

