37\t  /** hat-local cuff bottom (front ≈ +0.25, back ≈ +0.19 above the ball centre). Wave 4: the beanie sits DOWN on the\n38\t   *  head again (wave 3's 0.40 perched it like a small cap and pushed the pom 60 px above the ref) */\n39\t  brimBottom: 0.22,\n40\t  /** cuff outer radius ≈ the fluffy body half-width (rear refs 05/07/09/10: cuff as wide as the body) */\n41\t  brimR: 0.8,\n42\t  /** folded cuff band height (ref 05: 55 px band on a 295 px wide cuff) */\n43\t  cuffH: 0.265,\n44\t  /** crown dome height above its base (inside the cuff). Wave 4: taller rounded dome (ref 05 rear: ≈ 95 px of knit\n45\t   *  between the cuff and the pom, the old 0.44 showed 76 px) */\n46\t  crownH: 0.53,\n47\t  /** pom-pom core radius; the shell fur adds ≈ 0.1 → ≈ 0.5 × the cuff width (ref 05: ≈ 140–150 px / 295) */\n48\t  pomR: 0.31,\n49\t};\n50\t\n51\t/**\n52\t * Body skin deformation of a point `v` on the r = skin sphere: the lower half is stretched down a little\n53\t * and bulged radially (strongest at the sides/back, faded out on the face so eyes, blush and mouth keep\n54\t * their places) → a big round plush ball below the beanie.\n55\t */\n56\tfunction deformBody(v: THREE.Vector3, out: THREE.Vector3): THREE.Vector3 {\n57\t  const r = BENNY_DIMS.skin;\n58\t  const zf = THREE.MathUtils.smoothstep(v.z / r, 0.1, 0.75);\n59\t  const k = 1 + BENNY_DIMS.pear * Math.exp(-(((v.y + 0.24) / 0.38) ** 2)) * (1 - 0.8 * zf);\n60\t  const y = v.y < 0 ? v.y * (1 + (BENNY_DIMS.stretch * -v.y) / r) : v.y;\n61\t  return out.set(v.x * k, y, v.z * k);\n62\t}\n63\t\n64\tconst FACE_DIR = new THREE.Vector3(0, 0.05, 1).normalize();\n65\t\n66\tfunction named<T extends THREE.Object3D>(o: T, name: string): T {\n67\t  o.name = name;\n68\t  return o;\n69\t}\n70\t\n71\tfunction joint(name: string, x = 0, y = 0, z = 0): THREE.Object3D {\n72\t  const j = new THREE.Object3D();\n73\t  j.name = name;\n74\t  j.position.set(x, y, z);\n75\t  return j;\n76\t}\n77\t\n78\t/** hemisphere dome facing +Z with planar U