{"agentId": "a317a5dd539dbb6de", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-d4bb0ad3-8ycajb", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Spline water ribbon — the traversable stream Benny rides from the Drum A drain to the towel.\n3\t *\n4\t * Geometry: rows every `ds` along the master course, columns across `widthAt(s)`; a slightly\n5\t * concave trough with raised frothy edges plus a short skirt under each edge (thickness).\n6\t * Shader: electric-cyan core with meandering hot-pink flow bands, advected white streaks and\n7\t * sparkles (two-phase flow-map advection so per-stage speeds never shear), Fresnel/haze\n8\t * reflection, specular glints, cellular soap-foam fringe, Benny ripple rings + V-wake, the five\n9\t * glowing chevrons on the 04 slide, a dithered hand-over to the whirlpool surface in 03 and a\n10\t * drain-away for the 11 outro.\n11\t */\n12\timport * as THREE from 'three';\n13\timport type { Course, StageId } from '../world/course';\n14\timport { FRAG_FX_GLSL, FRAG_TAIL, NOISE_GLSL, PALETTE, withFog } from './glsl';\n15\t\n16\t/** wave amplitude per stage (units); blended across boundaries */\n17\tconst AMP: Partial<Record<StageId, number>> = {\n18\t  '02': 0.06, '03': 0.08, '04': 0.03, '05': 0.1, '06': 0.12, '07': 0.1, '08': 0.1, '09': 0.16, '10': 0.08, '11': 0.05,\n19\t};\n20\texport const EDGE_LIFT = 0.28;\n21\t\n22\t/**\n23\t * Per-stage colour-band layout (blended across stage boundaries, baked into `aStyle`):\n24\t *  x gate: 1 = pink bands taper off and part around Benny so the water at and behind him is pure\n25\t *          cyan (ref 05: rows y=1200/1400 are 0% pink); 0 = bands run right past him (refs 04/06/07\n26\t *          keep pink at the sides near the camera)\n27\t *  y off:  band-centre offset from the meandering core centre, fraction of the half width\n28\t *  z wid:  band half width, fraction of the half width\n29\t * Between the two bands is the electric-cyan core; outside them more cyan, then the foam lace.\n30\t */\n31\tconst BAND_STYLE: Partial<Record<StageId, [number, number, number]>> = {\n32\t  '04': [0, 0.6, 0.19],\n33\t  '05': [1, 0.46, 0.13],\n34\t  '06': [0.4, 0.48, 0.1],\n35\t  '07': [0, 0.52, 0.13],\n36\t};\n37\tconst BAND_DEFAULT: [number, number, number] = [0, 0.5, 0.12];\n38\t\n39\tfunction bandStyleAt(course: Course, s: number): [number, number, number] {\n40\t  const o: [number, number, number] = [0, 0, 0];\n41\t  let w = 0;\n42\t  for (const st of course.stages) {\n43\t    const a = smooth(st.s0 - 5, st.s0 + 5, s) * (1 - smooth(st.s1 - 5, st.s1 + 5, s));\n44\t    if (a <= 0) continue;\n45\t    const v = BAND_STYLE[st.id] ?? BAND_DEFAULT;\n46\t    o[0] += v[0] * a; o[1] += v[1] * a; o[2] += v[2] * a; w += a;\n47\t  }\n48\t  if (w <= 0) return [...(BAND_STYLE[course.stageAtS(s).id] ?? BAND_DEFAULT)];\n49\t  return [o[0] / w, o[1] / w, o[2] / w];\n50\t}\n51\t\n52\t/**\n53\t * Ribbon colours in shader (pre-tonemap, linear) space. NeutralToneMapping desaturates anything\n54\t * whose peak channel passes ≈0.76·exposure, so these were solved by inverting Neutral at the game's\n55\t * exposure 0.86 (src/render/env.ts). Flat values after tone mapping: cyanDeep #0065D6, cyan #1D89F0,\n56\t * cyanBright #42C8F7, pinkDeep #E206BE, pink #F741DD (H 308°, not violet), pinkLight #FA93E7. The\n57\t * streaks/crests/glints added on top lift the rendered cyan median to ≈#06A7FF (ref 05 #039FF6).\n58\t * Crests/highlights are allowed to desaturate toward white (that is how the ref highlights look).\n59\t * The shared PALETTE in glsl.ts is untouched (whirlpool, drum and final wave use it).\n60\t */\n61\tconst lin = (r: number, g: number, b: number) => new THREE.Color().setRGB(r, g, b, THREE.LinearSRGBColorSpace);\n62\tconst RIBBON_PAL = {\n63\t  cyanDeep: lin(0.0, 0.15, 0.78),\n64\t  cyan: lin(0.0, 0.31, 1.12),\n65\t  cyanBright: lin(0.04, 0.95, 1.55),\n66\t  pinkDeep: lin(0.9, 0.02, 0.62),\n67\t  pink: lin(1.55, 0.03, 1.2),\n68\t  pinkLight: lin(2.2, 0.5, 1.8),\n69\t};\n70\t\n71\texport function ampAt(course: Course, s: number): number {\n72\t  let v = 0, w = 0;\n73\t  for (const st of course.stages) {\n74\t    const a = smooth(st.s0 - 5, st.s0 + 5, s) * (1 - smooth(st.s1 - 5, st.s1 + 5, s));\n75\t    if (a > 0) { v += (AMP[st.id] ?? 0.08) * a; w += a; }\n76\t  }\n77\t  let amp = w > 0 ? v / w : 0.08;\n78\t  // calm the long straight of the deep plunge (fast sheet flow)\n79\t  const pt = course.marks['07_plunge_top'], pb = course.marks['07_plunge_bottom'];\n80\t  if (pt !== undefined) amp *= 1 - 0.6 * smooth(pt, pt + 8, s) * (1 - smooth(pb - 8, pb, s));\n81\t  return amp;\n82\t}\n83\t\n84\tfunction smooth(a: number, b: number, x: number) {\n85\t  const t = Math.min(1, Math.max(0, (x - a) / (b - a)));\n86\t  return t * t * (3 - 2 * t);\n87\t}\n88\t\n89\t/** CPU mirror of the vertex displacement (keep in sync with VERT). */\n90\texport function ribbonWave(u: number, s: number, t: number, amp: number): number {\n91\t  const au = Math.min(1, Math.abs(u));\n92\t  const trough = EDGE_LIFT * au * au * au;\n93\t  return trough + amp * (0.6 * Math.sin(s * 0.9 - t * 2.4 + u * 1.7) + 0.4 * Math.sin(s * 0.41 + t * 1.5 - u * 2.3));\n94\t}\n95\t\n96\tconst VERT = /* glsl */ `\n97\tattribute vec2 aUV;      // x = u (-1..1 across), y = s (arc length)\n98\tattribute float aHalfW;\n99\tattribute float aSpeed;\n100\tattribute float aAmp;\n101\tattribute float aSkirt;  // 0 surface, 1 skirt bottom\n102\tattribute vec3 aStyle;   // band layout: gate, offset, half width (see BAND_STYLE)\n103\tuniform float uTime;\n104\tuniform vec4 uHide;      // s03Start, s04Start, chuteMark, unused\n105\tvarying vec2 vUV;\n106\tvarying float vHalfW;\n107\tvarying float vSpeed;\n108\tvarying float vSkirt;\n109\tvarying float vHide;\n110\tvarying vec3 vStyle;\n111\tvarying vec3 vPosW;\n112\tvarying vec3 vNormalW;\n113\t#include <fog_pars_vertex>\n114\tvoid main() {\n115\t  vStyle = aStyle;\n116\t  float u = aUV.x;\n117\t  float s = aUV.y;\n118\t  float h = aAmp * (0.6 * sin(s * 0.9 - uTime * 2.4 + u * 1.7) + 0.4 * sin(s * 0.41 + uTime * 1.5 - u * 2.3));\n119\t  vec3 p = position + normal * h * (1.0 - aSkirt);\n120\t  vec4 wp = modelMatrix * vec4(p, 1.0);\n121\t  vPosW = wp.xyz;\n122\t  vNormalW = normalize(mat3(modelMatrix) * normal);\n123\t  vUV = aUV;\n124\t  vHalfW = aHalfW;\n125\t  vSpeed = aSpeed;\n126\t  vSkirt = aSkirt;\n127\t  // hand the stream over to the whirlpool surface during 03 (dithered fade both ways)\n128\t  float inside03 = smoothstep(uHide.x + 0.5, uHide.x + 3.5, s) * (1.0 - smoothstep(uHide.y - 9.0, uHide.y - 1.5, s));\n129\t  vHide = 1.0 - inside03;\n130\t  vec4 mvPosition = viewMatrix * wp;\n131\t  gl_Position = projectionMatrix * mvPosition;\n132\t  #include <fog_vertex>\n133\t}\n134\t`;\n135\t\n136\tconst FRAG = /* glsl */ `\n137\tuniform float uTime;\n138\tuniform vec3 uCyanDeep;\n139\tuniform vec3 uCyan;\n140\tuniform vec3 uCyanBright;\n141\tuniform vec3 uPinkDeep;\n142\tuniform vec3 uPink;\n143\tuniform vec3 uPinkLight;\n144\tuniform vec3 uFoam;\n145\tuniform vec3 uFoamLav;\n146\tuniform vec3 uHaze;\n147\tuniform vec3 uLightDir;\n148\tuniform vec3 uBenny;      // s, lateral (units), strength\n149\tuniform float uBennyR;    // Benny's waterline radius (units)\n150\tuniform vec3 uChevron;    // start s, spacing, enabled\n151\tuniform vec2 uOutro;      // amount, chamber start s\n152\tvarying vec2 vUV;\n153\tvarying float vHalfW;\n154\tvarying float vSpeed;\n155\tvarying float vSkirt;\n156\tvarying float vHide;\n157\tvarying vec3 vStyle;\n158\tvarying vec3 vPosW;\n159\tvarying vec3 vNormalW;\n160\t#include <fog_pars_fragment>\n161\t${NOISE_GLSL}\n162\t${FRAG_FX_GLSL}\n163\t\n164\t// Stationary channel shape (refs 05–07): lateral offset (units) of the electric-cyan core centre\n165\t// relative to the course centreline. Two incommensurate sines + slow noise so the S-curves do not\n166\t// visibly repeat; λ≈26 u differs from the course's own 05 geometry meander (λ≈36 u), so the two beat\n167\t// rather than cancel. It only drifts slowly downstream (+s) at a constant rate (no shear between\n168\t// stage speeds); the strand texture below is what is advected at the local stage speed.\n169\tfloat meander(float s, float hw) {\n170\t  float a = s - uTime * 0.7;\n171\t  float m = 0.2 * sin(a * 0.24) + 0.08 * sin(a * 0.53 + 1.3) + 0.12 * (vnoise(vec2(a * 0.05, 4.7)) - 0.5);\n172\t  return m * min(hw, 4.5);\n173\t}\n174\t\n175\t// Combed flow lines (ref 05: dense thin bright streaks parallel to the flow, 2–4 px apart in the\n176\t// mid-ground). Anti-aliased stripes across the flow (K lines per unit), each line broken into long\n177\t// random streak segments along v; the stripes fade out once they get closer than ≈3 px.\n178\tfloat combed(float x, float v, float K, float seed) {\n179\t  float p = x * K;\n180\t  float id = floor(p);\n181\t  float fw = fwidth(p);\n182\t  float hs = hash12(vec2(id, seed));\n183\t  // thin bright core with a soft glow; the line wanders a little inside its slot\n184\t  float d = abs(fract(p) - 0.5 - (hs - 0.5) * 0.4);\n185\t  float line = (1.0 - smoothstep(0.03, 0.06 + fw, d)) * 0.75 + (1.0 - smoothstep(0.0, 0.2 + fw, d)) * 0.35;\n186\t  // each line breaks into tapered streak segments of varying brightness\n187\t  float seg = smoothstep(0.5, 0.9, vnoise(vec2(id * 3.7 + seed, v * 0.2 + hs * 9.0)));\n188\t  return line * seg * (0.45 + 0.55 * hs) * (1.0 - smoothstep(0.22, 0.4, fw));\n189\t}\n190\t\n191\t// advected strand texture (\"combed\" glossy water lines parallel to the flow)\n192\t// x = lateral units relative to the meander centre, v = advected arc length, aa = 0..1 detail fade\n193\t// returns: x = height 0..1 (shading + bump), y = white glint lines, z = mid strands, w = fine strands\n194\tvec4 strands(float x, float v, vec2 aa) {\n195\t  float a = vnoise(vec2(x * 2.4, v * 0.08));\n196\t  float b = vnoise(vec2(x * 7.0 + a * 1.6, v * 0.19 + 5.0));\n197\t  #ifdef LOW_Q\n198\t  float c = b;\n199\t  #else\n200\t  float c = vnoise(vec2(x * 17.0 + b * 2.2, v * 0.42 + 3.0));\n201\t  #endif\n202\t  b = mix(0.5, b, aa.x);\n203\t  c = mix(0.5, c, aa.y);\n204\t  float h = a * 0.42 + b * 0.34 + c * 0.24;\n205\t  h = smoothstep(0.18, 0.82, h);              // more contrast: deep azure troughs, bright crests\n206\t  float line = smoothstep(0.72, 0.86, c) * aa.y + smoothstep(0.7, 0.86, b) * aa.x * 0.85;\n207\t  // the combed lines follow the large-scale strand warp so they bend with the flow\n208\t  float xw = x + (a - 0.5) * 0.5;\n209\t  line = max(line, combed(xw, v, 6.0, 0.0) * 0.85);\n210\t  #ifndef LOW_Q\n211\t  line = max(line, combed(xw + (b - 0.5) * 0.12, v * 1.3, 15.0, 11.0) * 0.55);\n212\t  #endif\n213\t  return vec4(h, line, b, c);\n214\t}\n215\t\n216\tvoid main() {\n217\t  float u = vUV.x;\n218\t  float s = vUV.y;\n219\t  // dithered hide (03 hand-over)\n220\t  if (vHide < 0.5) discard;\n221\t  float cutFoam = 1.0 - smoothstep(0.5, 0.85, vHide);\n222\t  // 11 outro: the stream drains away in the chamber, leaving puddles\n223\t  if (uOutro.x > 0.0 && s > uOutro.y - 2.0) {\n224\t    float n = vnoise(vec2(u * 3.0, s * 0.35)) * 0.7 + 0.3;\n225\t    if (n < uOutro.x * 1.15) discard;\n226\t  }\n227\t\n228\t  // ---- channel layout: winding cyan core between two hot-pink S-bands, cyan again outside ----\n229\t  float hw = vHalfW;\n230\t  float lat = u * hw;                         // lateral units in the ribbon frame\n231\t  float M = meander(s, hw);\n232\t  float x = lat - M;                          // lateral units in the core's frame\n233\t\n234\t  // detail fade with distance (cells per pixel), keeps far water from shimmering\n235\t  float fwx = fwidth(x);\n236\t  float fws = fwidth(s);\n237\t  // (a noise cell must stay ≳6–8 px wide; the combed lines of ref 05 are 2–4 px apart in the\n238\t  // mid-ground, so fading earlier than this flattens the water into a plain fill)\n239\t  vec2 aa = vec2(1.0 - smoothstep(0.12, 0.26, max(fwx * 7.0, fws * 0.19)),\n240\t                 1.0 - smoothstep(0.09, 0.2, max(fwx * 17.0, fws * 0.42)));\n241\t  // hair-fine combed strands for close-up water (refs: dense parallel flow lines)\n242\t  float aaH = 1.0 - smoothstep(0.14, 0.3, fwx * 46.0);\n243\t  #ifdef LOW_Q\n244\t  aa.y = 0.0;\n245\t  aaH = 0.0;\n246\t  #endif\n247\t\n248\t  // two-phase flow-map advection of the strands (period 4 s; offset scales with stage speed)\n249\t  float ph0 = fract(uTime * 0.25);\n250\t  float ph1 = fract(uTime * 0.25 + 0.5);\n251\t  float w0 = 1.0 - abs(1.0 - 2.0 * ph0);\n252\t  vec4 F = mix(strands(x, s - vSpeed * ph1 * 4.0 + 23.0, aa), strands(x, s - vSpeed * ph0 * 4.0, aa), w0);\n253\t\n254\t  // Benny parts the bands like a bow wave (vStyle.x, ref 05): just ahead of him they narrow and\n255\t  // swing outward, so the water at and behind him (the near field) is pure cyan; behind him they\n256\t  // continue only as thin streaks pushed out toward the foam banks\n257\t  float gate = 1.0, part = 0.0;\n258\t  if (vStyle.x > 0.0) {\n259\t    float db = s - uBenny.x;\n260\t    gate = mix(1.0, 0.4 + 0.6 * smoothstep(0.0, 4.5, db), vStyle.x);\n261\t    part = vStyle.x * hw * (0.3 - 0.3 * smoothstep(-1.0, 9.0, db));\n262\t  }\n263\t  float hwc = min(hw, 4.5);\n264\t  float aaw = fwidth(lat) * 0.85 + 0.01;      // ≈1 px edges: no lavender cyan/pink blend zone\n265\t  // flowing, combed band edges (the advected strand texture), scaled down on narrow streams\n266\t  float pert = ((F.z - 0.5) * 0.5 + (F.w - 0.5) * 0.22) * hwc * 0.22;\n267\t  float offL = hw * (vStyle.y + 0.07 * sin(s * 0.13 + 1.7)) + part;\n268\t  float offR = hw * (vStyle.y + 0.07 * sin(s * 0.11 + 4.2)) + part;\n269\t  float wL = hw * vStyle.z * (1.0 + 0.4 * sin(s * 0.19 + 0.4)) * gate;\n270\t  float wR = hw * vStyle.z * (1.0 + 0.4 * sin(s * 0.17 + 2.9)) * gate;\n271\t  float sdL = x + offL + pert;\n272\t  float sdR = x - offR + pert;\n273\t  float dL = abs(sdL);\n274\t  float dR = abs(sdR);\n275\t  float on = smoothstep(0.02, 0.2, gate);\n276\t  float pL = (1.0 - smoothstep(wL - aaw, wL + aaw, dL)) * on;\n277\t  float pR = (1.0 - smoothstep(wR - aaw, wR + aaw, dR)) * on;\n278\t  // a thin cyan thread splits a band into two streaks along some stretches (ref 05 mid-ground)\n279\t  float rimW = 0.05 * hwc + aaw;\n280\t  float thrW = 0.028 * hwc;\n281\t  float splitOn = smoothstep(0.55, 0.7, vnoise(vec2(s * 0.07, 13.0)));\n282\t  float sL = (1.0 - smoothstep(thrW, thrW + aaw, abs(x + offL + pert * 1.4 + 0.25 * wL * sin(s * 0.5)))) * splitOn;\n283\t  float sR = (1.0 - smoothstep(thrW, thrW + aaw, abs(x - offR + pert * 1.4 - 0.25 * wR * sin(s * 0.45 + 1.0)))) * (1.0 - splitOn);\n284\t  // only split bands that are wide enough (smooth ramp: a hard step cut the band across the flow)\n285\t  pL *= 1.0 - sL * smoothstep(rimW * 1.8, rimW * 2.8, wL);\n286\t  pR *= 1.0 - sR * smoothstep(rimW * 1.8, rimW * 2.8, wR);\n287\t  // hair-thin pink filaments drifting through the cyan core (mid/far field only)\n288\t  float fil = 0.0;\n289\t  #ifndef LOW_Q\n290\t  float fc = hw * 0.18 * sin(s * 0.21 + 0.8);\n291\t  fil = (1.0 - smoothstep(0.025 * hwc, 0.025 * hwc + aaw, abs(x - fc + pert * 0.7)))\n292\t      * smoothstep(0.62, 0.78, vnoise(vec2(s * 0.09, 21.0))) * gate * aa.x;\n293\t  #endif\n294\t  float pinkM = max(max(pL, pR), fil);\n295\t  // glossy rims: light-pink just inside each band edge, bright cyan just outside it\n296\t  float rimIn = max(pL * smoothstep(wL - rimW, wL - aaw, dL), pR * smoothstep(wR - rimW, wR - aaw, dR));\n297\t  float rimOut = max((1.0 - pL) * (1.0 - smoothstep(wL + aaw, wL + rimW * 1.6, dL)),\n298\t                     (1.0 - pR) * (1.0 - smoothstep(wR + aaw, wR + rimW * 1.6, dR))) * on;\n299\t\n300\t  float h = F.x;\n301\t  float hair = 0.5;\n302\t  if (aaH > 0.0) {\n303\t    float sv = s - vSpeed * fract(uTime * 0.5) * 2.0;\n304\t    float hA = vnoise(vec2(x * 46.0 + F.w * 3.0, sv * 0.9));\n305\t    float hB = vnoise(vec2(x * 46.0 + F.w * 3.0, (sv + vSpeed) * 0.9 + 17.0));\n306\t    hair = mix(0.5, mix(hB, hA, 1.0 - abs(1.0 - 2.0 * fract(uTime * 0.5))), aaH);\n307\t  }\n308\t  // deep azure troughs → electric cyan → light-cyan crests (crests stay a minority of the area)\n309\t  vec3 cyanCol = mix(uCyanDeep, uCyan, smoothstep(0.22, 0.62, h));\n310\t  cyanCol = mix(cyanCol, uCyanBright, smoothstep(0.64, 0.95, h) * 0.7 + rimOut * 0.45);\n311\t  // satin ribbon: a soft light streak runs along each band, off-centre toward the core\n312\t  float rel = pL >= pR ? sdL / max(wL, 1e-3) : -sdR / max(wR, 1e-3);   // -1 outer edge .. +1 core side\n313\t  float satin = exp(-pow((rel - 0.3) * 2.2, 2.0));\n314\t  vec3 pinkCol = mix(uPinkDeep, uPink, smoothstep(0.3, 0.72, h + satin * 0.2));\n315\t  pinkCol = mix(pinkCol, uPinkLight, clamp(smoothstep(0.6, 0.92, h) * 0.7 + satin * 0.35 + rimIn * 0.45, 0.0, 1.0));\n316\t  vec3 col = mix(cyanCol, pinkCol, pinkM);\n317\t  col *= 0.88 + 0.24 * hair;\n318\t  vec3 streakCol = mix(vec3(0.6, 1.25, 1.6), vec3(1.6, 0.8, 1.6), pinkM);\n319\t  col += streakCol * smoothstep(0.82, 0.94, hair) * 0.3 * aaH;\n320\t\n321\t  // ---- glossy lighting ----\n322\t  vec3 N0 = normalize(vNormalW);\n323\t  if (!gl_FrontFacing) N0 = -N0;\n324\t  #ifdef LOW_Q\n325\t  vec3 N = normalize(N0 + 0.25 * vec3(h - 0.5, 0.0, F.z - 0.5));\n326\t  #else\n327\t  float bumpAmt = 0.07 * (1.0 - smoothstep(0.1, 0.5, fws));\n328\t  vec3 N = bumpNormal(vPosW, N0, h * bumpAmt);\n329\t  #endif\n330\t  vec3 V = normalize(cameraPosition - vPosW);\n331\t  float nv = clamp(dot(N, V), 0.0, 1.0);\n332\t  float fres = pow(1.0 - nv, 4.0);\n333\t  vec3 R = reflect(-V, N);\n334\t  // tinted (not white) reflection so the glossy far water stays saturated, not pastel\n335\t  vec3 reflTint = mix(uCyanBright, uPinkLight, pinkM);\n336\t  vec3 refl = mix(reflTint, vec3(1.5), smoothstep(0.6, 1.0, R.y) * 0.5);\n337\t  col = mix(col, refl, fres * 0.22);\n338\t  vec3 L = normalize(uLightDir);\n339\t  vec3 H = normalize(L + V);\n340\t  float spec = pow(clamp(dot(N, H), 0.0, 1.0), 120.0);\n341\t  float sheen = pow(clamp(dot(R, L), 0.0, 1.0), 10.0);\n342\t  col += vec3(1.0) * spec * 1.2 + reflTint * sheen * 0.12;\n343\t  // advected glossy streak lines along the flow\n344\t  col += streakCol * F.y * 0.8;\n345\t\n346\t  // ---- foreground ripple crests across the flow (ref 05 near field: arcs of white crest glints\n347\t  // over deep-azure troughs). Only where s is resolved finely (near the camera).\n348\t  float nearK = 1.0 - smoothstep(0.02, 0.05, fws);\n349\t  if (nearK > 0.0) {\n350\t    float ph = s * 5.5 - uTime * 6.0 + 1.3 * sin(lat * 0.8 + s * 0.15) + 2.0 * vnoise(vec2(lat * 0.9, s * 0.5));\n351\t    float crest = pow(0.5 + 0.5 * sin(ph), 40.0) * smoothstep(0.5, 0.8, vnoise(vec2(lat * 3.2, s * 1.1 + 3.0)));\n352\t    col *= 1.0 - 0.14 * nearK * (0.5 - 0.5 * sin(ph));\n353\t    col += mix(vec3(0.9, 1.4, 1.7), vec3(1.7, 1.1, 1.7), pinkM) * crest * nearK * 0.9;\n354\t  }\n355\t\n356\t  // ---- white star glints (4-point, twinkling, carried by the flow) ----\n357\t  #ifdef LOW_Q\n358\t  vec2 g = vec2(lat * 1.2, (s - vSpeed * uTime * 0.6) * 0.8);\n359\t  float hs = hash12(floor(g));\n360\t  float sparkle = step(0.9, hs) * smoothstep(0.22, 0.0, length(fract(g) - 0.5)) * (0.5 + 0.5 * sin(uTime * 7.0 + hs * 40.0));\n361\t  col += vec3(1.3) * sparkle;\n362\t  #else\n363\t  // wide cells so the long horizontal arms are not clipped at the cell border in the mid-ground\n364\t  float glint = starGlint(vec2(lat * 0.55, (s - vSpeed * uTime * 0.55) * 0.42), 0.42, 22.0, 2.4, uTime);\n365\t  col += vec3(2.0, 2.2, 2.3) * glint * (1.0 - smoothstep(0.3, 0.8, fws));\n366\t  #endif\n367\t\n368\t  // ---- soap-foam lace where the water meets the foam banks ----\n369\t  float edgeN = (vnoise(vec2(s * 1.3, u * 2.0)) - 0.5) * 0.1;\n370\t  float eu = abs(lat) - vHalfW;               // units from the edge (negative inside)\n371\t  float edge = smoothstep(-0.75, -0.3, eu + edgeN * vHalfW);\n372\t  if (edge > 0.0) {\n373\t    float c = cells(vec2(lat * 3.2, (s - vSpeed * uTime