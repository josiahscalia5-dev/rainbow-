      "uuid": {
        "description": "Material UUID",
        "type": "string"
      },
      "uniform": {
        "type": "string",
        "description": "Uniform name, e.g. uTime, uColor"
      },
      "value": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              },
              "w": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          }
        ],
        "description": "Hex string for Color, {x,y,z} for vectors, number/boolean for scalars"
      }
    },
    "required": [
      "uniform",
      "value"
    ]
  },
