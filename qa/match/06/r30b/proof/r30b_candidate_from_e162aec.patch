+try { const page = await browser.newPage({ viewport: { width: 432, height: 768 }, deviceScaleFactor: 1 });
+  await page.goto(`${vite.url}/?qa=1&dpr=1&${Q}`); await page.waitForFunction(() => window.__rainbow?.ready === true, null, { timeout: 300000 });
