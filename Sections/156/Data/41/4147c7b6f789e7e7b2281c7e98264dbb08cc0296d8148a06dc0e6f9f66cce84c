{"agentId": "a16eaaa7abf16d292", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-47b10cec-03c7co", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * `?match08=1` — Screen 08 approved-picture test (2026-11-17, qa/match/08/NOTES.md).\n3\t * REAL 3D proxy geometry of the Final Spin Chamber, solved from the user's approved Screen 08 and the locked game\n4\t * camera (tools/match08/fit_proxies.py → assets/textures/match08/proj08.json): inlet pipe, gold arch, chamber walls,\n5\t * door wall, floor/river plane, platform (top tilted toward the camera as painted), towel and the four half-dome spouts.\n6\t * Every surface is textured by camera projection of the CLEAN environment-only artwork (Benny, HUD, coins removed;\n7\t * qa/imageblaster/08/) from that locked camera, so the locked view shows the approved scenery and a moving camera sees\n8\t * it on geometry (parallax). Surfaces the projector cannot see (behind props) get a plain fallback colour instead of\n9\t * a smeared copy (projector depth test). The shader undoes the game's post chain (PROJ05_INVERSE) and takes no fog.\n10\t * Without the switch nothing in this file runs and the game is unchanged.\n11\t */\n12\timport * as THREE from 'three';\n13\timport { PROJ05_INVERSE, flag05 } from '../vfx/waterRibbon';\n14\t\n15\tinterface Layout {\n16\t  camera: { matrixWorld: number[]; fov: number; size: [number, number] };\n17\t  floorY: number;\n18\t  chamber: { cx: number; cy: number; r: number; zBack: number; zDoor: number };\n19\t  arch: { z: number; outer: { cx: number; cy: number; r: number }; inner: { cx: number; cy: number; r: number }; depth: number };\n20\t  pipe: { cx: number; cy: number; r: number; z0: number; z1: number };\n21\t  backwall: { z: number; holeR: number };\n22\t  platform: { cx: number; cz: number; r: number; topY: number; rimBottomY: number; floorY: number; tiltDeg: number };\n23\t  towel: { cx: number; cz: number; w: number; h: number; y0: number; d: number };\n24\t  spouts: Record<string, { c: [number, number, number]; rx: number; ry: number }>;\n25\t}\n26\t\n27\texport interface Match08 {\n28\t  group: THREE.Group;\n29\t  /** the approved picture's splash ring around Benny (camera-facing card; Game places it at Benny + splashOffset) */\n30\t  splash: THREE.Mesh;\n31\t  splashOffset: THREE.Vector3;\n32\t  /** render the projector depth map once (needs the renderer); call after the group is in the scene */\n33\t  bakeDepth(renderer: THREE.WebGLRenderer): void;\n34\t  /** live post values for the inverse (exposure from the renderer, render size for the vignette inverse) */\n35\t  sync(renderer: THREE.WebGLRenderer, w: number, h: number): void;\n36\t}\n37\t\n38\tconst VERT = /* glsl */ `\n39\tuniform mat4 uProjVP;\n40\tvarying vec4 vProj;\n41\tvarying vec3 vW;\n42\tvarying vec3 vN;\n43\tvoid main() {\n44\t  vec4 wp = modelMatrix * vec4(position, 1.0);\n45\t  vProj = uProjVP * wp;\n46\t  vW = wp.xyz;\n47\t  vN = normalize(mat3(modelMatrix) * normal);\n48\t  gl_Position = projectionMatrix * viewMatrix * wp;\n49\t}`;\n50\t\n51\tconst FRAG = /* glsl */ `\n52\tuniform sampler2D uPlate;\n53\tuniform sampler2D uDepth;\n54\tuniform float uUseDepth;\n55\tuniform vec2 uNearFar;\n56\tuniform vec3 uFallback;\n57\tuniform sampler2D uPatch;   // material patch cut from the approved artwork (wall slots / gold band / towel)\n58\tuniform float uPatchK;      // patch repeats per world unit\n59\tuniform vec3 uProjPos;      // projector (approved view) position\n60\tuniform vec4 uPjPost;\n61\tuniform vec2 uPjRes;\n62\tuniform sampler2D uFill;    // m08fill: world-anchored wall tile cut from the picture's near pipe wall (unwrap08.py)\n63\tuniform float uFillMode;    // 0 off (triplanar patch), 1 drum wall (around the chamber axis), 2 flat disc (x/y)\n64\tuniform vec2 uFillSize;     // tile size in world units (around, along)\n65\tuniform vec3 uDrum;         // chamber axis x, y and radius\n66\tuniform mat4 uProjVP;\n67\tuniform float uSwim;        // m08swim (floor only): the painted river's banks spread to cover Benny's whole swim lane\n68\tuniform sampler2D uRiv;     // 64 x 1: painted river centre x (r) and full width (g) along z\n69\tuniform vec4 uRivZ;         // z at texel 0, z at texel 63, lane half-width to cover, floor y\n70\tuniform sampler2D uOcc;     // m08occ (door wall only): plate with towel + platform painted out (occ08.py), alpha = usable\n71\tuniform float uOccOn;\n72\tuniform sampler2D uTMask;   // m08towelm (towel only): the painted towel's outline in plate coordinates (towelmask08.py)\n73\tuniform float uTMaskOn;\n74\tuniform vec4 uClipIn;       // m08far collar only: discard inside this x/y circle (the chamber's cross-section) ...\n75\tuniform vec4 uClipOut;      // ... and outside this one (the pushed arch's outline); w > 0.5 = on\n76\tuniform vec4 uCeil;         // m08ceil (door wall only): painted door centre x, y on the door plane, plane z, w > 0.5 = on\n77\tuniform vec4 uCeilW;        // m08ceil source window: angle start, angle width (rad), radius band start, end (world u)\n78\tuniform sampler2D uRingT;   // m08ring: periodic slot-ring tile (ring08.py): u = angle, v = radius (repeat-wrapped)\n79\tuniform vec4 uRing;         // m08ring: angle start, angle period (rad), radius start, radius period (u)\n80\tuniform float uRingOn;\n81\tuniform vec2 uCeilD;        // m08drum (chamber drum only): x > 0.5 = on, y = fade length (u) from the door plane toward the arch\n82\tuniform sampler2D uNearT;   // m08near (floor only): crisp near-river tile from the approved picture's own near band (near08.py)\n83\tuniform vec4 uNear;         // z at tile v = 0, world length of one tile period along the river, tile lateral half range A, w > 0.5 = on\n84\tuniform vec4 uNearM;        // projection magnification ramp start / end, lateral fade start / end (|lane position|, 1 = bank)\n85\tuniform vec2 uNearC;        // tile a of the lane centre and of the half lane (the painted water incl. foam spans c +- h)\n86\tuniform vec4 uNq;           // m08nq (r14): x > 0.5 = painted-scale tile (nq08.py), y = middle 1:1 half width, z = lane it was laid for, w = tile half width (u)\n87\tuniform vec4 uCup;         // m08cup (spout cups only): cup centre xyz, w > 0.5 = on\n88\tuniform vec3 uCupM;         // m08cup mirror plane normal (horizontal, perpendicular to the projector's view of the cup)\n89\tuniform sampler2D uCupMk;   // m08cupw: painted outline of the upper cups (cupw08.py, R = upper-right, eroded 2 px)\n90\tuniform vec4 uCupW;         // m08cupw: copy direction across the arch edge (plate uv per px), distance (px), w > 0.5 = on\n91\tvarying vec4 vProj;\n92\tvarying vec3 vW;\n93\tvarying vec3 vN;\n94\t${PROJ05_INVERSE}\n95\t// triplanar, mirrored-repeat sampling of the patch: surfaces the approved picture never showed (or showed edge-on)\n96\tvec3 patchColor() {\n97\t  vec3 n = abs(normalize(vN)); n /= max(n.x + n.y + n.z, 1e-4);\n98\t  vec3 p = vW * uPatchK;\n99\t  return texture2D(uPatch, p.zy).rgb * n.x + texture2D(uPatch, p.xz).rgb * n.y + texture2D(uPatch, p.xy).rgb * n.z;\n100\t}\n101\tfloat linZ(float d) { float n = uNearFar.x, f = uNearFar.y; float z = d * 2.0 - 1.0; return 2.0 * n * f / (f + n - z * (f - n)); }\n102\tvec3 fillColor() {\n103\t  vec2 q;\n104\t  if (uFillMode < 1.5) {\n105\t    // angle from straight down: the wrap of atan lies under the floor, never seen\n106\t    float a = atan(vW.x - uDrum.x, -(vW.y - uDrum.y));\n107\t    float n = floor(6.2831853 * uDrum.z / uFillSize.x + 0.5);  // whole tiles around the drum: no seam\n108\t    q = vec2(a / 6.2831853 * n, vW.z / uFillSize.y);\n109\t  } else q = vW.xy / uFillSize;\n110\t  return texture2D(uFill, q).rgb;\n111\t}\n112\t// m08ceil: the painted end wall is concentric around the door (chrome rim, gold bulb ring, slot rows), so a door-wall point\n113\t// the approved view could not see (behind the arch ring: the ceiling above the door) takes the user's pixels from the SAME\n114\t// radius in a clean window of the painted wall beside the door (left of the door, between the spout cup and its stream),\n115\t// repeated (mirrored, a whole number of times around) by angle; beyond the window's slot band the slot rows repeat outward.\n116\t// The rings therefore continue across the old seam instead of meeting a generic tile.\n117\tvec3 ceilColorAt(vec2 pxy) {\n118\t  vec2 d = pxy - uCeil.xy;\n119\t  float r = length(d), a = atan(d.y, d.x);\n120\t  float fu = mod((a - uCeilW.x) / uCeilW.y, 2.0);\n121\t  float as = uCeilW.x + (fu < 1.0 ? fu : 2.0 - fu) * uCeilW.y;\n122\t  float rs = r;\n123\t  if (r > uCeilW.w) { float w2 = uCeilW.w - uCeilW.z, fr = mod(r - uCeilW.w, 2.0 * w2); rs = fr < w2 ? uCeilW.w - fr : uCeilW.z + (fr - w2); }\n124\t  vec4 q = uProjVP * vec4(uCeil.xy + rs * vec2(cos(as), sin(as)), uCeil.z, 1.0);\n125\t  vec3 c = texture2D(uPlate, q.xy / q.w * 0.5 + 0.5).rgb;\n126\t  // m08ring (r12): the slot band and beyond repeat the same window PERIODICALLY (no mirror lines -> no chevrons / diamonds);\n127\t  // explicit gradients from the continuous point (the atan wrap would break the implicit mip selection)\n128\t  vec2 ex = dFdx(pxy), ey = dFdy(pxy);\n129\t  float r2 = max(r * r, 1e-6), r1 = max(r, 1e-3);\n130\t  vec2 gx = vec2((d.x * ex.y - d.y * ex.x) / r2 / uRing.y, dot(d, ex) / r1 / uRing.w);\n131\t  vec2 gy = vec2((d.x * ey.y - d.y * ey.x) / r2 / uRing.y, dot(d, ey) / r1 / uRing.w);\n132\t  vec3 rc = textureGrad(uRingT, vec2((a - uRing.x) / uRing.y, (r - uRing.z) / uRing.w), gx, gy).rgb;\n133\t  return mix(c, rc, uRingOn * smoothstep(uCeilW.z, uCeilW.z + 0.15, r));\n134\t}\n135\tvec3 riv(float z) {\n136\t  float f = clamp((z - uRivZ.x) / (uRivZ.y - uRivZ.x), 0.0, 1.0) * 63.0;\n137\t  float i0 = floor(f);\n138\t  vec3 a = texture2D(uRiv, vec2((i0 + 0.5) / 64.0, 0.5)).rgb, b = texture2D(uRiv, vec2((min(i0 + 1.0, 63.0) + 0.5) / 64.0, 0.5)).rgb;\n139\t  return mix(a, b, f - i0);\n140\t}\n141\t// m08swim: lateral remap of a floor point. The middle of the painted river stays as painted, its banks (water edge,\n142\t// foam) are spread out to the lane half-width, the floor beyond is pushed out and eased back over 2.5 u. World-anchored\n143\t// (depends on the floor point only) and faded in with the camera's distance from the approved viewpoint.\n144\tvec3 swimRemap(vec3 w, float mv) {\n145\t  vec3 r = riv(w.z);\n146\t  // (b > 0, m08rw only: a wider lane to cover near the camera, where the painted gold arch legs hug the banks)\n147\t  float hp = 0.5 * r.y, h = mix(hp, max(hp, r.z > 0.0 ? r.z : uRivZ.z), mv);\n148\t  if (h <= hp + 1e-3) return w;\n149\t  float d = w.x - r.x, ad = abs(d), a = 0.45 * hp, e = h - hp, o;\n150\t  if (ad <= a) o = ad;\n151\t  else if (ad <= h) o = a + (ad - a) * (hp - a) / (h - a);\n152\t  else o = ad - e * max(0.0, 1.0 - (ad - h) / 2.5);\n153\t  return vec3(r.x + sign(d) * o, w.y, w.z);\n154\t}\n155\tvoid main() {\n156\t  if (uClipIn.w > 0.5 && (distance(vW.xy, uClipIn.xy) < uClipIn.z || distance(vW.xy, uClipOut.xy) > uClipOut.z)) discard;\n157\t  // m08towelm: the towel proxy is cut to the painted towel's outline (the depth bake does the same, so the door wall\n158\t  // behind receives the window pixels that the rectangle used to carry at towel depth)\n159\t  if (uTMaskOn > 0.5 && vProj.w > 0.0 && texture2D(uTMask, vProj.xy / vProj.w * 0.5 + 0.5).r < 0.5) discard;\n160\t  // m08fill fades in as the camera leaves the approved viewpoint (the approved view keeps its exact old pixels)\n161\t  vec3 pc = patchColor();\n162\t  if (uFillMode > 0.5) pc = mix(pc, fillColor(), smoothstep(0.2, 1.5, distance(cameraPosition, uProjPos)));\n163\t  if (uCeil.w > 0.5) pc = mix(pc, ceilColorAt(vW.xy), smoothstep(0.2, 1.5, distance(cameraPosition, uProjPos)));\n164\t  // m08drum: a drum point the approved view could not see (the top corners next to the door, behind the arch ring) continues\n165\t  // the SAME painted rings as the door wall: the projector ray through it is followed to the door plane and coloured there\n166\t  // as m08ceil colours the door wall (identical at the drum / door-wall junction, so no seam); fades out toward the arch\n167\t  if (uCeilD.x > 0.5) {\n168\t    vec3 dp = uProjPos + (vW - uProjPos) * ((uCeil.z - uProjPos.z) / (vW.z - uProjPos.z));\n169\t    float wz = 1.0 - smoothstep(uCeil.z + 0.5 * uCeilD.y, uCeil.z + uCeilD.y, vW.z);\n170\t    pc = mix(pc, ceilColorAt(dp.xy), wz * smoothstep(0.2, 1.5, distance(cameraPosition, uProjPos)));\n171\t  }\n172\t  vec3 t = pc;\n173\t  // stretch guard: the projection is used where the current view sees the surface no more face-on than the approved\n174\t  // view did (ratio of the two incidence cosines); in the approved view itself the ratio is 1 -> pure projection\n175\t  vec3 nn = normalize(vN);\n176\t  float cp = abs(dot(nn, normalize(uProjPos - vW))), cc = abs(dot(nn, normalize(cameraPosition - vW)));\n177\t  float keep = 1.0 - smoothstep(2.5, 6.0, cc / max(cp, 1e-3));\n178\t  vec4 pj = vProj;\n179\t  float pw = 0.0;  // weight of the direct projection in t (m08cup fills the rest from the cup's mirrored side)\n180\t  if (uSwim > 0.5) {\n181\t    float ms = smoothstep(0.2, 1.5, distance(cameraPosition, uProjPos));\n182\t    if (ms > 0.0) pj = uProjVP * vec4(swimRemap(vW, ms), 1.0);\n183\t  }\n184\t  if (pj.w > 0.0) {\n185\t    vec3 ndc = pj.xyz / pj.w;\n186\t    vec2 uv = ndc.xy * 0.5 + 0.5;\n187\t    if (uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0) {\n188\t      float vis = 1.0;\n189\t      if (uUseDepth > 0.5) {\n190\t        float zf = linZ(ndc.z * 0.5 + 0.5);\n191\t        float zs = linZ(texture2D(uDepth, uv).r);\n192\t        vis = 1.0 - smoothstep(0.015 * zs, 0.04 * zs + 0.05, zf - zs);\n193\t        // m08fill: once the camera has left the approved viewpoint, a soft hand-over to the fill (5 x 5 taps over ~3 %\n194\t        // of the frame) instead of a hard shadow line; at the viewpoint itself the exact single-tap test (view unchanged)\n195\t        float mv = uFillMode > 0.5 ? smoothstep(0.2, 1.5, distance(cameraPosition, uProjPos)) : 0.0;\n196\t        if (mv > 0.0) {\n197\t          float sv = 0.0;\n198\t          for (int i = -2; i <= 2; i++) for (int j = -2; j <= 2; j++) {\n199\t            float zt = linZ(texture2D(uDepth, uv + vec2(float(i), float(j) * 0.5625) * 0.007).r);\n200\t            sv += 1.0 - smoothstep(0.015 * zt, 0.04 * zt + 0.05, zf - zt);\n201\t          }\n202\t          vis = mix(vis, smoothstep(0.0, 1.0, sv / 25.0), mv);\n203\t        }\n204\t      }\n205\t      // m08occ: what the approved view could not see behind the towel / platform comes from the occlusion plate (the\n206\t      // painted door / window continued), not from the fallback tile with its straight edges; off the viewpoint only\n207\t      vec3 base = pc;\n208\t      if (uOccOn > 0.5) {\n209\t        vec4 oc = texture2D(uOcc, uv);\n210\t        base = mix(pc, oc.rgb, oc.a * smoothstep(0.2, 1.5, distance(cameraPosition, uProjPos)));\n211\t      }\n212\t      t = mix(base, texture2D(uPlate, uv).rgb, vis * keep);\n213\t      pw = vis * keep;\n214\t    }\n215\t  }\n216\t  // m08cup: the cups are round (rotationally symmetric), so a cup point the approved view could not see (its top hidden\n217\t  // behind the gold arch, or its outer part beyond the picture's edge) takes the painted pixels of its mirror point\n218\t  // across the vertical plane through the cup axis and the projector; off the approved viewpoint only\n219\t  if (uCup.w > 0.5) {\n220\t    float mc = smoothstep(0.2, 1.5, distance(cameraPosition, uProjPos));\n221\t    // (r12: turning the hidden point about the cup axis instead (+-45 / +-90 deg) put wall pixels on the cup top: the\n222\t    // proxy dome is taller than the painted cup -> mirror only)\n223\t    vec3 wm = vW - 2.0 * dot(vW - uCup.xyz, uCupM) * uCupM;\n224\t    vec4 pm = uProjVP * vec4(wm, 1.0);\n225\t    if (mc > 0.0 && pw < 0.999 && pm.w > 0.0) {\n226\t      vec3 nd = pm.xyz / pm.w;\n227\t      vec2 um = nd.xy * 0.5 + 0.5;\n228\t      if (um.x >= 0.0 && um.x <= 1.0 && um.y >= 0.0 && um.y <= 1.0) {\n229\t        float zf = linZ(nd.z * 0.5 + 0.5), zs = linZ(texture2D(uDepth, um).r);\n230\t        float vm = 1.0 - smoothstep(0.015 * zs, 0.04 * zs + 0.05, zf - zs);\n231\t        t = mix(t, texture2D(uPlate, um).rgb, vm * (1.0 - pw) * mc);\n232\t      }\n233\t    }\n234\t    // m08cupw (r13, upper-right cup only): what counts as painted cup is the traced cup outline (eroded 2 px), not the\n235\t    // depth edge (whose arch-edge pixels drew hard gold lines -> X seams); order: own pixel, mirror pixel, the painted cap /\n236\t    // band copied across the arch edge from just inside it (two distances), gold patch. Off the approved viewpoint only.\n237\t    if (uCupW.w > 0.5 && mc > 0.0 && vProj.w > 0.0 && pm.w > 0.0) {\n238\t      vec2 u0 = vProj.xy / vProj.w * 0.5 + 0.5, um = pm.xy / pm.w * 0.5 + 0.5;\n239\t      vec2 s1 = u0 + uCupW.xy * uCupW.z, s2 = u0 + uCupW.xy * (2.0 * uCupW.z), s3 = u0 + uCupW.xy * (3.0 * uCupW.z);\n240\t      float m0 = texture2D(uCupMk, u0).r, m1 = texture2D(uCupMk, um).r;\n241\t      float m2 = texture2D(uCupMk, s1).r, m3 = texture2D(uCupMk, s2).r, m4 = texture2D(uCupMk, s3).r;\n242\t      vec3 cm1 = texture2D(uPlate, um).rgb;\n243\t      vec3 cs = mix(mix(texture2D(uPlate, s3).rgb, texture2D(uPlate, s2).rgb, m3), texture2D(uPlate, s1).rgb, m2);\n244\t      float ms = max(m2, max(m3, m4));\n245\t      // mirror first (keeps the band at its height; tried: the copy first on the cap -> stepped band copies on the cap's\n246\t      // right side, the painted band is tilted), then the copy across the edge; last resort the previous colour (a gold\n247\t      // patch fallback drew a gold outline round the cup where the proxy outline lies outside the eroded painted outline)\n248\t      vec3 cw = mix(mix(mix(t, cs, ms), cm1, m1), texture2D(uPlate, u0).rgb, m0);\n249\t      t = mix(t, cw, mc);\n250\t    }\n251\t  }\n252\t  // m08near: where the moving camera sees the floor projection magnified (it shows plate pixels the approved view saw far\n253\t  // away and small: smeared streaks), the crisp painted near river takes over, world-anchored along the painted river\n254\t  // (lateral = position across the swim lane, banks on the painted foam fringe; along = repeating with z). Off the\n255\t  // approved viewpoint only (approved view unchanged).\n256\t  if (uNear.w > 0.5) {\n257\t    // (measured on the plain projection: the swim remap is piecewise, its kinks would make the hand-over jump)\n258\t    vec2 pu = vProj.xy / max(vProj.w, 1e-4) * 0.5 * uPjRes;\n259\t    float det = abs(dFdx(pu).x * dFdy(pu).y - dFdx(pu).y * dFdy(pu).x);\n260\t    float mag = vProj.w > 0.0 ? inversesqrt(max(det, 1e-8)) : 99.0;\n261\t    float mn = smoothstep(0.2, 1.5, distance(cameraPosition, uProjPos));\n262\t    vec3 r = riv(vW.z);\n263\t    float hp = 0.5 * r.y, h = mix(hp, max(hp, uRivZ.z), mn);\n264\t    float sl = (vW.x - r.x) / h;\n265\t    vec2 tuv = vec2(0.5 + (uNearC.x + uNearC.y * sl) / (2.0 * uNear.z), (uNear.x - vW.z) / uNear.y);\n266\t    if (uNq.x > 0.5) {\n267\t      // m08nq (r14): the painted-scale tile is laid out in world units across the lane (middle 1:1, the rest of the lane\n268\t      // scaled only if the lane differs from the one the tile was laid for), so glints / streaks keep their painted size\n269\t      float d = vW.x - r.x, ad = abs(d);\n270\t      float xb = ad <= uNq.y ? ad : uNq.y + (ad - uNq.y) * (uNq.z - uNq.y) / max(h - uNq.y, 1e-3);\n271\t      tuv = vec2(0.5 + sign(d) * xb / (2.0 * uNq.w), (uNear.x - vW.z) / uNear.y);\n272\t    }\n273\t    float wn = mn * smoothstep(uNearM.x, uNearM.y, mag) * (1.0 - smoothstep(uNearM.z, uNearM.w, abs(sl)));\n274\t    if (wn > 0.0) t = mix(t, texture2D(uNearT, tuv).rgb, wn);\n275\t  }\n276\t  gl_FragColor = vec4(pjInverse(t), 1.0);\n277\t}`;\n278\t\n279\t/** several (nu × nv) vertex grids f(u, v) → one indexed geometry (m08arch: fine tessellation for per-vertex pushes) */\n2