            pointers[h]=(match[1].decode(),int(match[2]))
proc.stdin.close();assert proc.wait()==0
def sha_file(f):
    with f.open('rb') as stream:return hashlib.file_digest(stream,'sha256').hexdigest()
# Prior local game checkouts and LFS caches are read only.
oid_set={v[0] for v in pointers.values()};named_paths=defaultdict(set)
for tree in selected.values():
    for path,(_,h) in tree.items():
        if h in pointers:named_paths[(PurePosixPath(path).name,pointers[h][1])].add(pointers[h][0])
file_names={name for name,size in named_paths}
rawfiles={}
for root in Path('/tmp').glob('rainbow-*'):
    if root==p:continue
    for folder,sub,files in os.walk(root,followlinks=False):
        sub[:]=[i for i in sub if i not in {'node_modules','blender-cache','blender-config','mcp-cache','npm-cache','gradle-cache','gradle-dist','sdk','isolated-jdk21','runtime-deps','spector-browser','toolchain','jdk-source','vite','bridge-source','reviewed','__pycache__'}]
        if folder.endswith('/.git'): sub[:]=[i for i in sub if i=='lfs']
        for n in files:
            f=Path(folder)/n
            if n in oid_set and n not in rawfiles:
                if f.is_file() and sha_file(f)==n:rawfiles[n]=f
            elif n in file_names:
                try:size=f.stat().st_size
                except OSError:continue
                needed=named_paths.get((n,size),set())-rawfiles.keys()
                if needed:
                    got=sha_file(f)
                    if got in needed:rawfiles[got]=f
# Only unresolved LFS objects actually used by a selected revision are retrieved.
lfs=p/'hydrated';lfs.mkdir(exist_ok=True)
def hydrate(item):
    h,(sha,size)=item
    if sha in rawfiles:return sha,rawfiles[sha]
    out=lfs/sha
    if not out.exists():
        temp=out.with_suffix('.'+h[:12]+'.part')
        with temp.open('wb') as f:
            r=sp.run(basecmd+['-c','lfs.storage='+str(p/'lfs-store'),'lfs','smudge','--','review-asset'],input=(pool/h).read_bytes(),stdout=f,stderr=sp.PIPE)
        if r.returncode or temp.stat().st_size!=size or sha_file(temp)!=sha:raise RuntimeError('Failed to hydrate required source binary '+sha[:12])
        temp.replace(out)
    assert out.stat().st_size==size and sha_file(out)==sha
    return sha,out
