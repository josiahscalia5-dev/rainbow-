 THREE.Vector3[] = [];\n41\t  for (let i = 0; i < n; i++) cp.push(course.sample(S(i)).pos.clone());\n42\t  for (let i = 0; i < n; i++) {\n43\t    const s = S(i);\n44\t    const taper = THREE.MathUtils.smoothstep(s, s0, s0 + opts.taper) * (1 - THREE.MathUtils.smoothstep(s, s1 - opts.taper, s1));\n45\t    const W = opts.window * taper;\n46\t    const k = Math.round(W / ds);\n47\t    let x = 0, z = 0, wsum = 0;\n48\t    for (let j = i - k; j <= i + k; j++) {\n49\t      const jj = THREE.MathUtils.clamp(j, 0, n - 1);\n50\t      const w = k === 0 ? 1 : 1 - Math.abs(j - i) / (k + 1);\n51\t      x += cp[jj].x * w; z += cp[jj].z * w; wsum += w;\n52\t    }\n53\t    axis.push(new THREE.Vector3(x / wsum, cp[i].y, z / wsum));\n54\t  }\n55\t  // exact straight stretches (05 current): the axis is pulled onto the course's straight centre line\n56\t  // (foot of the perpendicular from the stream point), so the tunnel is truly straight — no yaw\n57\t  // wiggle, no roll — and the rings converge on one vanishing point. Blends in over 12 units after\n58\t  // the 04 junction; height/roll/radius/depth return to the 06 arch tube just past its foot (wRun),\n59\t  // the lateral position over the last ~20 units of the stretch (wXZ) so the hand-over to the\n60\t  // filtered 06 axis has no yaw kink and 06 itself is unchanged.\n61\t  const wRun = new Array<number>(n).fill(0);\n62\t  const wXZ = new Array<number>(n).fill(0);\n63\t  const runDepth = new Array<number>(n).fill(0);\n64\t  for (const r of course.straightAxes ?? []) {\n65\t    if (r.s1 <= s0 || r.s0 >= s1) continue;\n66\t    const ab = r.b.clone().sub(r.a);\n67\t    const ab2 = ab.lengthSq();\n68\t    for (let i = 0; i < n; i++) {\n69\t      const s = S(i);\n70\t      const wIn = THREE.MathUtils.smoothstep(s, r.s0, r.s0 + 12);\n71\t      const w = wIn * (1 - THREE.MathUtils.smoothstep(s, r.s1 - 6, r.s1 + 2));\n72\t      const wl = wIn * (1 - THREE.MathUtils.smoothstep(s, r.s1 - 18, r.s1 + 2));\n73\t      if (wl <= wXZ[i]) continue;\n74\t      wXZ[i] = wl;\n75\t      wRun[i] = w;\n76\t      runDepth[i] = r.floorDepth;\n77\t      const u = cp[i].clone().sub(r.a).dot(ab) / ab2;\n78\t      const onLine = r.a.clone().addScaledVector(ab, u);\n79\t      axis[i].x += (onLine.x - axis[i].x) * wl;\n80\t      axis[i].z += (onLine.z - axis[i].z) * wl;\n81\t      axis[i].y += (onLine.y - axis[i].y) * w;\n82\t    }\n83\t  }\n84\t  const WU = new THREE.Vector3(0, 1, 0);\n85\t  const frames: Frame[] = axis.map((p, i) => {\n86\t    const a = axis[Math.max(0, i - 2)], b = axis[Math.min(n - 1, i + 2)];\n87\t    const tan = b.clone().sub(a).normalize();\n88\t    const cu = course.sample(S(i)).up.clone().lerp(WU, wRun[i]); // no banking roll on straight stretches\n89\t    const up = cu.addScaledVector(tan, -cu.dot(tan)).normalize();\n90\t    const right = new THREE.Vector3().crossVectors(tan, up).normalize();\n91\t    return { pos: p, tan, up, right };\n92\t  });\n93\t  // radius/depth so the floor stays below the stream edges, dilated + smoothed for a steady tube\n94\t  const rawR: number[] = [], rawD: number[] = [], needR: number[] = [], needD: number[] = [];\n95\t  for (let i = 0; i < n; i++) {\n96\t    const s = S(i);\n97\t    const off = cp[i].clone().sub(frames[i].pos);\n98\t    const d = off.dot(frames[i].right);\n99\t    const X = Math.abs(d) + course.widthAt(s) / 2 + 0.25;\n100\t    const r = Math.max(opts.baseRadius(s), X + 0.7);\n101\t    rawR.push(r);\n102\t    rawD.push(Math.max(0.9, r - Math.sqrt(Math.max(0, r * r - X * X)) + 0.2));\n103\t    // straight stretches: also account for the stream's height above/below the (straight) axis point\n104\t    needR.push(X + 0.7);\n105\t    needD.push(r - Math.sqrt(Math.max(0, r * r - X * X)) + 0.2 - off.dot(frames[i].up));\n106\t  }\n107\t  const dilate = (arr: number[], k: number) => arr.map((_, i) => { let m = -Infinity; for (let j = i - k; j <= i + k; j++) m = Math.max(m, arr[THREE.MathUtils.clamp(j, 0, n - 1)]); return m; });\n108\t  const box = (arr: number[], k: number) => arr.map((_, i) => { let a = 0; for (let j = i - k; j <= i + k; j++) a += arr[THREE.MathUtils.clamp(j, 0, n - 1)]; return a / (2 * k + 1); });\n109\t  const R = box(dilate(rawR, 30), 16);\n110\t  const D = box(dilate(rawD, 30), 16);\n111\t  if (wRun.some((w) => w > 0)) {\n112\t    // on a straight stretch the tunnel keeps its own constant radius (the next stage's wider hall is\n113\t    // not dilated back into it) and the stream sits `floorDepth` above the tunnel bottom (wide current)\n114\t    const nR = box(dilate(needR, 30), 16);\n115\t    const nD = box(dilate(needD, 30), 16);\n116\t    for (let i = 0; i < n; i++) {\n117\t      const w = wRun[i];\n118\t      if (w <= 0) continue;\n119\t      R[i] += (Math.max(opts.baseRadius(S(i)), nR[i]) - R[i]) * w;\n120\t      D[i] += (Math.max(runDepth[i], nD[i], 0.9) - D[i]) * w;\n121\t    }\n122\t  }\n123\t  const idx = (s: number) => {\n124\t    const x = THREE.MathUtils.clamp((s - s0) / ds, 0, n - 1);\n125\t    const i = Math.min(n - 2, Math.floor(x));\n126\t    return { i, f: x - i };\n127\t  };\n128\t  const lerpArr = (arr: number[], s: number) => { const { i, f } = idx(s); return arr[i] + (arr[i + 1] - arr[i]) * f; };\n129\t  return {\n130\t    frame(s) {\n131\t      const { i, f } = idx(s);\n132\t      const A = frames[i], B = frames[i + 1];\n133\t      const pos = A.pos.clone().lerp(B.pos, f);\n134\t      const tan = A.tan.clone().lerp(B.tan, f).normalize();\n135\t      const up = A.up.clone().lerp(B.up, f);\n136\t      up.addScaledVector(tan, -up.dot(tan)).normalize();\n137\t      return { pos, tan, up, right: new THREE.Vector3().crossVectors(tan, up).normalize() };\n138\t    },\n139\t    radius: (s) => lerpArr(R, s),\n140\t    depth: (s) => lerpArr(D, s),\n141\t  };\n142\t}\n143\t\n144\texport function tubeCenterAt(path: TubePath, s: number, out = new THREE.Vector3()) {\n145\t  const f = path.frame(s);\n146\t  return out.copy(f.pos).addScaledVector(f.up, path.radius(s) - path.depth(s));\n147\t}\n148\t\n149\texport interface TubeGeoOptions {\n150\t  radial?: number;\n151\t  step?: number;\n152\t  vScale?: number;\n153\t  /** angular range (radians, measured from the bottom) — default full circle */\n154\t  arc?: number;\n155\t  /** radius offset (negative = inset toward the axis) */\n156\t  inset?: number;\n157\t  /**\n158\t   * Store the front-face (outward) normal. The faces wind outward, so BackSide/DoubleSide materials\n159\t   * flip this to the inward normal and light the inside of the tube correctly. The legacy default\n160\t   * (false) stores -d, which those materials flip to point AWAY from the viewer (dot(N,V) <= 0 →\n161\t   * full fresnel, un-tinted pale reflections); kept only so the 02 chute / 04 pipe look is unchanged.\n162\t   */\n163\t  frontNormals?: boolean;\n164\t  /** also store the local tube frame per vertex (`tubeAxis`, `tubeUp`) for withTubeStrips('attribute') */\n165\t  axisAttr?: boolean;\n166\t}\n167\t\n168\texport function buildTubeGeometry(path: TubePath, s0: number, s1: number, o: TubeGeoOptions = {}): THREE.BufferGeometry {\n169\t  const radial = o.radial ?? 48;\n170\t  const step = o.step ?? 0.6;\n171\t  const vScale = o.vScale ?? 1;\n172\t  const arc = o.arc ?? Math.PI * 2;\n173\t  const ns = o.frontNormals ? 1 : -1;\n174\t  const rings = Math.max(2, Math.ceil((s1 - s0) / step) + 1);\n175\t  const pos = new Float32Array(rings * (radial + 1) * 3);\n176\t  const nor = new Float32Array(rings * (radial + 1) * 3);\n177\t  const uv = new Float32Array(rings * (radial + 1) * 2);\n178\t  const ax = o.axisAttr ? new Float32Array(rings * (radial + 1) * 3) : null;\n179\t  const au = o.axisAttr ? new Float32Array(rings * (radial + 1) * 3) : null;\n180\t  const c = new THREE.Vector3();\n181\t  const d = new THREE.Vector3();\n182\t  for (let i = 0; i < rings; i++) {\n183\t    const s = s0 + ((s1 - s0) * i) / (rings - 1);\n184\t    const f = path.frame(s);\n185\t    const r = path.radius(s) + (o.inset ?? 0);\n186\t    c.copy(f.pos).addScaledVector(f.up, path.radius(s) - path.depth(s));\n187\t    for (let j = 0; j <= radial; j++) {\n188\t      const th = -Math.PI / 2 - arc / 2 + (j / radial) * arc; // centred on the bottom\n189\t      d.copy(f.right).multiplyScalar(Math.cos(th)).addScaledVector(f.up, Math.sin(th));\n190\t      const k = i * (radial + 1) + j;\n191\t      if (ax && au) { f.tan.toArray(ax, k * 3); f.up.toArray(au, k * 3); }\n192\t      pos[k * 3] = c.x + d.x * r;\n193\t      pos[k * 3 + 1] = c.y + d.y * r;\n194\t      pos[k * 3 + 2] = c.z + d.z * r;\n195\t      nor[k * 3] = ns * d.x; nor[k * 3 + 1] = ns * d.y; nor[k * 3 + 2] = ns * d.z;\n196\t      uv[k * 2] = j / radial;\n197\t      uv[k * 2 + 1] = s / vScale;\n198\t    }\n199\t  }\n200\t  const idx: number[] = [];\n201\t  for (let i = 0; i < rings - 1; i++) {\n202\t    for (let j = 0; j < radial; j++) {\n203\t      const a = i * (radial + 1) + j, b = a + radial + 1;\n204\t      idx.push(a, b, a + 1, b, b + 1, a + 1);\n205\t    }\n206\t  }\n207\t  const g = new THREE.BufferGeometry();\n208\t  g.setAttribute('position', new THREE.BufferAttribute(pos, 3));\n209\t  g.setAttribute('normal', new THREE.BufferAttribute(nor, 3));\n210\t  g.setAttribute('uv', new THREE.BufferAttribute(uv, 2));\n211\t  if (ax && au) {\n212\t    g.setAttribute('tubeAxis', new THREE.BufferAttribute(ax, 3));\n213\t    g.setAttribute('tubeUp', new THREE.BufferAttribute(au, 3));\n214\t  }\n215\t  g.setIndex(idx);\n216\t  g.computeBoundingSphere();\n217\t  return g;\n218\t}\n219\t\n220\t/**\n221\t * Washer-tube ring collar (ref 05: \"flat gold band with a double contour\"): a broad FLAT inner band that\n222\t * barely stands off the wall, a dark groove, then a thin raised lip on the near edge (−z, the side the\n223\t * rider looks at) whose small camera-facing side catches a bright line. The protrusion is shallow on\n224\t * purpose: a deep collar shows a big camera-facing annulus (the old \"thick orange pipe\" look, 21% gold)\n225\t * and pokes through the stream where it hugs the wall (06 arch).\n226\t * Lathe around local Z; radial values are fractions of the tube radius, axial values are world units\n227\t * (the instance scales z by 1). Interior corners are duplicated so every facet keeps a crisp normal.\n228\t */\n229\texport function collarGeometry(depth = 0.022, lip = 0.012, width = 1.1, segments = 96): THREE.BufferGeometry {\n230\t  const w = width / 2;\n231\t  const d = depth;\n232\t  const lipW = Math.min(0.16, width * 0.15), groove = Math.min(0.07, width * 0.06);\n233\t  // traversed from +z to -z so LatheGeometry's faces/normals point INWARD (toward the tunnel axis)\n234\t  const prof: [number, number][] = [\n235\t    [1.03, w], [1 - d * 0.5, w], // far side (hidden from the rider)\n236\t    [1 - d, w - 0.05], // far chamfer\n237\t    [1 - d, -w + lipW + groove + 0.02], // the flat band\n238\t    [1 - d * 0.55, -w + lipW + groove * 0.5], // dark groove (recessed toward the wall)\n239\t    [1 - d - lip, -w + lipW], [1 - d - lip, -w + 0.05], // raised lip\n240\t    [1 - d * 0.35, -w], // lip's camera-facing side → thin bright contour", "tool_use_id": "toolu_01VrEuwBAVSuS3fYjdwggZi2", "type": "tool_result"}], "role": "user"}, "parentUuid": "c4b1bf3f-f5d8-4b0b-b6c0-a74b2141ab83", "permissionDecision": {"decision": "accept", "reasonType": "rule", "ruleSource": "cliArg", "source": "config"}, "promptId": "4c3de2a5-f8a1-42ce-bcf3-da46637f8373", "sessionId": "9403ef16-db4f-520b-8577-610f580574f8", "sourceToolAssistantUUID": "c4b1bf3f-f5d8-4b0b-b6c0-a74b2141ab83", "timestamp": "2026-11-15T23:46:19.697Z", "type": "user", "userType": "external", "uuid": "d40a5aa1-6150-4bd5-8146-3309108d94e6", "version": "2.1.325"}
