{"agentId": "a9780416a29e85217", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "claude/rainbow-account-transfer-npxahd", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Screen 05 projection tests for the TUNNEL (2026-11-16, qa/pilot05/proj/tunnel/NOTES.md), same method as the water\n3\t * (`?proj05=1`): the user's APPROVED Screen 05 picture, unwrapped into the tunnel's own coordinates and baked into\n4\t * textures (tools/proj05/tunnel_rings.py + tunnel_bake.py → assets/textures/tunnel05/), so the design is anchored to the\n5\t * 3D tunnel, not pasted over the screen.\n6\t *   `?projwall05=1`  the purple metal WALLS: one texture row per wall bay between two gold rings (AB, BC, CD … as the\n7\t *                    approved picture shows them from the locked 05 camera); u = angle round the tube, v = depth within\n8\t *                    the bay. Bays the picture does not show (in front of ring A, behind the camera) repeat the AB row.\n9\t *   `?projring05=1`  the gold RINGS: the band of the approved ring B unwrapped (u = angle round the ring, v = how far the\n10\t *                    band stands out of the wall), on every 05 ring; the existing far glow still melts the far rings\n11\t *                    into the warm throat.\n12\t * The shader undoes the post chain (grade → sRGB → Neutral tone map → exposure) so the screen shows the approved\n13\t * colours; bloom is measured and fed back into the bake. Default build: none of this runs — the wall and ring\n14\t * materials are wrapped only when a switch is on, every default shader program is unchanged.\n15\t */\n16\timport * as THREE from 'three';\n17\timport { PROJ05_INVERSE, on05, proj05Pending } from './waterRibbon';\n18\t// the tunnel bake follows its own switches OR the master `?match05=1` (on05)\n19\tconst flag05 = on05;\n20\timport { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';\n21\t\n22\texport const PROJWALL05: boolean = flag05('projwall05');\n23\texport const PROJRING05: boolean = flag05('projring05');\n24\t/** `?projframe05=1` (2026-11-16): the near gold frame (bottom corners + bottom lip) wears the approved gold band */\n25\texport const PROJFRAME05: boolean = flag05('projframe05');\n26\t/** `?projlid05=1` (2026-11-16): the approved paddles L1 L2 R1 R2 as Blender-built 3D trays on the real 05 wall */\n27\texport const PROJLID05: boolean = flag05('projlid05');\n28\t/**\n29\t * `?env05=1` (2026-11-17, washer-environment-modeler, qa/pilot05/full_reference_match/env/NOTES.md): the 05 rings placed\n30\t * where the approved picture shows them from the locked camera (src/world/environment.ts) and the walls / rings baked by\n31\t * CAMERA PROJECTION in their own coordinates (tools/env05/proj_bake.py → assets/textures/env05/): wall atlas with own\n32\t * rows for the near bays (N1, N2), and one ring atlas row per ring (A, B, C … G, N) sampled by (angle round the ring,\n33\t * axial position across the band). Off = every program and texture exactly as before.\n34\t */\n35\texport const ENV05: boolean = flag05('env05');\n36\t\n37\t/**\n38\t * The approved paddle is a D-shaped TRAY (studied at 4× zoom: a thick polished gold rim whose INNER face shows above a\n39\t * lavender floor, a thin straight lip along the bottom). Half lathe toward local +X like wallLidGeometry: the D's\n40\t * straight edge lies on local Z (along the tube); the open side faces −Y (the camera / the stream), the closed back +Y\n41\t * (into the wall). Thickness h = tray depth (fraction of the size), centred on its thickness like the wall lids.\n42\t */\n43\texport function trayLidGeometry(h: number, segments = 28): THREE.BufferGeometry {\n44\t  const prof: [number, number][] = [\n45\t    [0, 0.68 * h], [0.78, 0.68 * h], [0.84, 0.62 * h],         // floor (recessed from the open side), fillet\n46\t    [0.855, 0.3 * h], [0.865, 0.06 * h], [0.9, 0.0],            // inner rim face down to the lip\n47\t    [0.965, 0.0], [1.0, 0.06 * h], [1.025, 0.4 * h],            // rounded lip, outer bulge\n48\t    [1.0, 0.85 * h], [0.95, h], [0, h],                          // closed back against the wall\n49\t  ];\n50\t  const geo = new THREE.LatheGeometry(prof.map(([x, y]) => new THREE.Vector2(x, y)), segments, 0, Math.PI);\n51\t  geo.translate(0, -h * 0.5, 0);\n52\t  return geo;\n53\t}\n54\t\n55\t/**\n56\t * `?projlid05=1` (Blender pipeline, qa/pilot05/proj/tunnel/NOTES.md): the approved picture's four large paddles L1 L2 R1\n57\t * R2 (+ the small far pair L3 R3 on the far wall) as real 3D tray-blocks on the real 05 wall (assets/models/lids05.glb, built in Blender by tools/proj05/lid_blender.py\n58\t * from the approved outlines lifted onto the wall through the locked 05 camera). From the checkpoint their outline is the\n59\t * approved one; riding on, they show their real depth. They carry the approved paddle pixels (camera-projected UVs,\n60\t * assets/textures/tunnel05/lid05.png inside the GLB), shown through the post-chain inverse like the walls. The default\n61\t * paddle pairs and the far slab pucks are left out under the switch.\n62\t */\n63\tlet lids05Scene: THREE.Object3D | null = null;\n64\tconst lids05Ready: Promise<void> | null = PROJLID05\n65\t  ? new GLTFLoader().loadAsync(new URL('../../assets/models/lids05.glb', import.meta.url).href).then((gltf) => {\n66\t    gltf.scene.traverse((o) => {\n67\t      const m = o as THREE.Mesh;\n68\t      if (!m.isMesh) return;\n69\t      const map = (m.material as THREE.MeshStandardMaterial).map;\n70\t      if (!map) return;\n71\t      map.colorSpace = THREE.NoColorSpace;          // the texels ARE display values: the shader undoes the post chain\n72\t      map.needsUpdate = true;\n73\t      m.material = lidProjMaterial(map);\n74\t      m.frustumCulled = false;\n75\t    });\n76\t    lids05Scene = gltf.scene;\n77\t    lids05Scene.name = 'tube05_lids_blender';\n78\t  }).catch((e) => { console.error('[rainbow] projlid05: lids05.glb failed', e); })\n79\t  : null;\n80\tif (lids05Ready) proj05Pending.push(lids05Ready);\n81\t\n82\tfunction lidProjMaterial(map: THREE.Texture): THREE.MeshBasicMaterial {\n83\t  const mat = new THREE.MeshBasicMaterial({ map, side: THREE.DoubleSide, fog: false });\n84\t  mat.onBeforeCompile = (shader) => {\n85\t    Object.assign(shader.uniforms, shared);\n86\t    shader.fragmentShader = shader.fragmentShader\n87\t      .replace('void main() {', `uniform vec4 uPjPost; uniform vec2 uPjRes;\n88\t${PROJ05_INVERSE}\n89\tvoid main() {`)\n90\t      .replace('#include <dithering_fragment>', `#include <dithering_fragment>\n91\tgl_FragColor = vec4(pjInverse(texture2D(map, vMapUv).rgb), 1.0);   // ?projlid05=1: the approved paddle pixels`);\n92\t  };\n93\t  mat.customProgramCacheKey = () => 'ptlid05';\n94\t  mat.onBeforeRender = (renderer) => livePost(renderer);\n95\t  return mat;\n96\t}\n97\t\n98\t/** the group environment.ts adds under `?projlid05=1`; the Blender paddles join it once the GLB has loaded */\n99\texport function lids05Group(): THREE.Group {\n100\t  const g = new THREE.Group();\n101\t  g.name = 'tube05_lids05';\n102\t  const attach = () => { if (lids05Scene) g.add(lids05Scene); };\n103\t  if (lids05Scene) attach(); else lids05Ready?.then(attach);\n104\t  return g;\n105\t}\n106\t\n107\t/** atlas rows of wall05.png (tools/proj05/tunnel_bake.py: ROWS) */\n108\texport const PT_ROW = { AB: 0, BC: 1, CD: 2, DE: 3, EF: 4, FG: 5, GX: 6, N1: 7, N2: 8 } as const;\n109\tconst N_ROWS = ENV05 ? 9 : 7;\n110\t/** `?env05=1` ring atlas rows (assets/textures/env05/env05.json: ring.rows) */\n111\texport const E5_RING_ROW = { A: 0, B: 1, C: 2, D: 3, E: 4, F: 5, G: 6, N: 7 } as const;\n112\tconst N_SEG = 8;\n113\t\n114\tconst empty = new THREE.DataTexture(new Uint8Array([128, 40, 150, 255]), 1, 1);\n115\tempty.needsUpdate = true;\n116\t\n117\tconst shared = {\n118\t  uPjPost: { value: new THREE.Vector4(0.86, 1.36, 1.15, 0.18) },\n119\t  uPjRes: { value: new THREE.Vector2(864, 1536) },\n120\t  uPtWall: { value: empty as THREE.Texture },\n121\t  uPtWallSize: { value: new THREE.Vector2(1, 1) },\n122\t  uPtRows: { value: Array.from({ length: N_ROWS }, () => new THREE.Vector2(0, 1)) },\n123\t  uPtRing: { value: empty as THREE.Texture },\n124\t  uPtRingSize: { value: new THREE.Vector2(1, 1) },\n125\t  uPtFrame: { value: empty as THREE.Texture },\n126\t  /** frame05.png: (texture height, band rows NV, left y0, right y0); lip y0 in uPtFrameLip */\n127\t  uPtFrameRows: { value: new THREE.Vector4(1, 1, 0, 0) },\n128\t  uPtFrameLip: { value: 0 },\n129\t  /** `?env05=1`: ring atlas, (texture height, rows height) */\n130\t  uE5Ring: { value: empty as THREE.Texture },\n131\t  uE5RingSize: { value: new THREE.Vector3(1, 1, 1) },\n132\t  /** QA only (scripts/proj05-tunnel-probe.mjs --coords): 1 = write the texture coordinates instead of the colour */\n133\t  uPtDbg: { value: 0 },\n134\t};\n135\t/** QA accessor for the probe script */\n136\texport const proj05TunnelShared = shared;\n137\t\n138\tfunction loadTextures() {\n139\t  const loader = new THREE.TextureLoader();\n140\t  const load = (url: string) =>\n141\t    new Promise<THREE.Texture>((res, rej) =>\n142\t      loader.load(url, (t) => {\n143\t        t.flipY = false;\n144\t        t.colorSpace = THREE.NoColorSpace;          // the texels ARE display values: the shader undoes the post chain\n145\t        t.generateMipmaps = false;\n146\t        t.minFilter = THREE.LinearFilter;\n147\t        t.magFilter = THREE.LinearFilter;\n148\t        t.wrapS = THREE.RepeatWrapping;             // round the tube\n149\t        t.wrapT = THREE.ClampToEdgeWrapping;\n150\t        t.needsUpdate = true;\n151\t        res(t);\n152\t      }, undefined, rej));\n153\t  const jobs: Promise<unknown>[] = [];\n154\t  if (PROJWALL05 || ENV05) {\n155\t    jobs.push(Promise.all([\n156\t      load(ENV05 ? new URL('../../assets/textures/env05/wall05e.png', import.meta.url).href : new URL('../../assets/textures/tunnel05/wall05.png', import.meta.url).href),\n157\t      fetch(ENV05 ? new URL('../../assets/textures/env05/env05.json', import.meta.url).href : new URL('../../assets/textures/tunnel05/tunnel05.json', import.meta.url).href).then((r) => r.json()),\n158\t    ]).then(([t, meta]) => {\n159\t      shared.uPtWall.value = t;\n160\t      shared.uPtWallSize.value.set(meta.wall.w, meta.wall.h);\n161\t      (Object.keys(PT_ROW) as (keyof typeof PT_ROW)[]).forEach((k) => {\n162\t        const r = meta.wall.rows[k];\n163\t        if (r) shared.uPtRows.value[PT_ROW[k]].set(r.y0, r.h);\n164\t      });\n165\t    }));\n166\t  }\n167\t  if (ENV05) {\n168\t    jobs.push(Promise.all([\n169\t      load(new URL('../../assets/textures/env05/ring05e.png', import.meta.url).href),\n170\t      fetch(new URL('../../assets/textures/env05/env05.json', import.meta.url).href).then((r) => r.json()),\n171\t    ]).then(([t, meta]) => {\n172\t      shared.uE5Ring.value = t;\n173\t      shared.uE5RingSize.value.set(meta.ring.w, meta.ring.h, meta.ring.rowH);\n174\t    }));\n175\t  }\n176\t  if (PROJRING05) {\n177\t    jobs.push(load(new URL('../../assets/textures/tunnel05/ring05.png', import.meta.url).href).then((t) => {\n178\t      shared.uPtRing.value = t;\n179\t      shared.uPtRingSize.value.set(t.image.width, t.image.height);\n180\t    }));\n181\t  }\n182\t  if (PROJFRAME05) {\n183\t    jobs.push(Promise.all([\n184\t      load(new URL('../../assets/textures/tunnel05/frame05.png', import.meta.url).href),\n185\t      fetch(new URL('../../assets/textures/tunnel05/frame05.json', import.meta.url).href).then((r) => r.json()),\n186\t    ]).then(([t, meta]) => {\n187\t      t.wrapS = THREE.ClampToEdgeWrapping;          // the frame bands are open arcs, not closed rings\n188\t      t.needsUpdate = true;\n189\t      shared.uPtFrame.value = t;\n190\t      shared.uPtFrameRows.value.set(meta.h, meta.rows.left.h, meta.rows.left.y0, meta.rows.right.y0);\n191\t      shared.uPtFrameLip.value = meta.rows.lip.y0;\n192\t    }));\n193\t  }\n194\t  return Promise.all(jobs).catch((e) => { console.error('[rainbow] proj05 tunnel textures failed', e); });\n195\t}\n196\t// the game waits for these before `ready` (vfx/index.ts), so a capture never shows the 1×1 placeholder\n197\tif (PROJWALL05 || PROJRING05 || PROJFRAME05 || ENV05) proj05Pending.push(loadTextures());\n198\t\n199\tconst size = new THREE.Vector2();\n200\tfunction livePost(renderer: THREE.WebGLRenderer) {\n201\t  const rt = renderer.getRenderTarget();\n202\t  if (rt) size.set(rt.width, rt.height); else renderer.getDrawingBufferSize(size);\n203\t  shared.uPjRes.value.copy(size);\n204\t  shared.uPjPost.value.x = renderer.toneMappingExposure;\n205\t}\n206\t\n207\t/** one wall bay: tunnel coordinate range [v0, v1) (the wall's uv.y) → atlas row, t at v0 and at v1 */\n208\texport interface WallSeg { v0: number; v1: number; row: number; t0: number; t1: number }\n209\t\n210\t/**\n211\t * `?projwall05=1`: wrap a perforatedMetal wall material (real 05 wall or the forced-perspective far wall; both carry\n212\t * `vPerfUv` = (angle round the tube 0..1 from the top, tunnel coordinate)). `segs` (≤ 8) lists the bays; anything outside\n213\t * them repeats the AB row every `tile.period` units from `tile.anchor`.\n214\t */\n215\texport function withProj05Wall<T extends THREE.MeshStandardMaterial>(mat: T, segs: WallSeg[], tile: { anchor: number; period: number }, key: string): T {\n216\t  const seg = Array.from({ length: N_SEG }, (_, i) => (segs[i] ? new THREE.Vector4(segs[i].v0, segs[i].v1, 0, 0) : new THREE.Vector4(1e9, 1e9, 0, 0)));\n217\t  const segT = Array.from({ length: N_SEG }, (_, i) => (segs[i] ? new THREE.Vector3(segs[i].row, segs[i].t0, segs[i].t1) : new THREE.Vector3(0, 0, 0)));\n218\t  const uniforms = { ...shared, uPtSeg: { value: seg }, uPtSegT: { value: segT }, uPtTile: { value: new THREE.Vector2(tile.anchor, tile.period) } };\n219\t  const prev = mat.onBeforeCompile;\n220\t  mat.onBeforeCompile = (shader, r) => {\n221\t    prev.call(mat, shader, r);\n222\t    Object.assign(shader.uniforms, uniforms);\n223\t    shader.fragmentShader = shader.fragmentShader\n224\t      .replace('void main() {', `uniform sampler2D uPtWall; uniform vec2 uPtWallSize; uniform vec2 uPtRows[${N_ROWS}];\n225\tuniform vec4 uPtSeg[${N_SEG}]; uniform vec3 uPtSegT[${N_SEG}]; uniform vec2 uPtTile; uniform float uPtDbg;\n226\tuniform vec4 uPjPost; uniform vec2 uPjRes;\n227\t${PROJ05_INVERSE}\n228\tvoid main() {`)\n229\t      .replace('#include <dithering_fragment>', `#include <dithering_fragment>\n230\t{ // ?projwall05=1: the approved wall of this bay (texture anchored to the tunnel)\n231\t  float pv = vPerfUv.y;\n232\t  float prow = 0.0;\n233\t  float pt = fract((pv - uPtTile.x) / uPtTile.y);\n234\t  for (int i = 0; i < ${N_SEG}; i++) {\n235\t    vec4 sg = uPtSeg[i];\n236\t    if (pv >= sg.x && pv < sg.y) { prow = uPtSegT[i].x; pt = mix(uPtSegT[i].y, uPtSegT[i].z, (pv - sg.x) / (sg.y - sg.x)); }\n237\t  }\n238\t  vec2 rw = uPtRows[int(prow + 0.5)];\n239\t  vec2 puv = vec2(fract(vPerfUv.x + 0.25), (rw.x + clamp(pt * rw.y, 0.5, rw.y - 0.5)) / uPtWallSize.y);\n240\t  vec3 pc = texture2D(uPtWall, puv).rgb;\n241\t  gl_FragColor = uPtDbg > 0.5 ? vec4(puv, 7.0, 77.0) : vec4(pjInverse(pc), 1.0);\n242\t}`);\n243\t  };\n244\t  const prevKey = mat.customProgramCacheKey.bind(mat);\n245\t  mat.customProgramCacheKey = () => prevKey() + '|ptwall-' + key;\n246\t  const prevRender = mat.onBeforeRender;\n247\t  mat.onBeforeRender = (renderer, ...rest) => { livePost(renderer); prevRender.call(mat, renderer, ...rest); };\n248\t  return mat;\n249\t}\n250\t\n251\t/**\n252\t * `?projring05=1`: wrap a withBandShading ring material. `flip` = the ring's local x points to screen LEFT (the real 05\n253\t * rings, basis (−right, up, tan)); the forced-perspective far rings use (right, up, tan). `height` = the band's height\n254\t * (BandOpts.height, fraction of the ring radius): v = how far the surface stands out of the wall, 0 wall … 1 crown.\n255\t */\n256\texport function withProj05Ring<T extends TH