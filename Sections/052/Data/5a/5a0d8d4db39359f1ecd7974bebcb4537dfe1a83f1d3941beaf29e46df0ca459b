const path=require('node:path'),fs=require('node:fs');
const {chromium}=require('playwright');
const {open,pose}=require('./capture.cjs');
(async()=>{
  const id=process.argv[2],res=Number(process.argv[3]);
  const rows=id==='06'?[['release-0.6','forward',.6],['release-1.1','forward',1.1],['release-2.2','forward',2.2]]:[['plunge-bottom','drop',.97],['two-thirds-down','drop',2/3],['mouth','exit',-.45]];
  const dir=path.join(__dirname,'focus');fs.mkdirSync(dir,{recursive:true});
  const b=await chromium.launch({executablePath:'/usr/bin/chromium',args:['--use-angle=swiftshader','--enable-unsafe-swiftshader','--disable-background-networking']});
  try{
    for(const variant of ['NEW','BEFORE']){
      const errors=[],p=await open(b,id,variant,{width:res,height:res*16/9},errors);
      const metadata=[];
      for(const row of rows){
        metadata.push(await pose(p,id,row));
        await p.screenshot({path:path.join(dir,variant+'-'+row[0]+'.png'),animations:'disabled'});
      }
      if(errors.length)throw Error(errors.join(' | '));
      fs.writeFileSync(path.join(dir,variant+'.json'),JSON.stringify(metadata));
      await p.close();
    }
  }finally{await b.close();}
})().catch(e=>{console.error(e);process.exitCode=1});
