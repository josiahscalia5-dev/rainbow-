const fs=require('node:fs'),path=require('node:path'),{chromium}=require('playwright');
(async()=>{const browser=await chromium.launch({executablePath:'/usr/bin/chromium',args:['--use-angle=swiftshader','--enable-unsafe-swiftshader','--disable-background-networking','--ignore-gpu-blocklist']});
try{const page=await browser.newPage({viewport:{width:864,height:1536},deviceScaleFactor:1}),dir=path.join(__dirname,'clear08');
fs.mkdirSync(dir,{recursive:true});await page.route('**/*',r=>['','127.0.0.1','localhost'].includes(new URL(r.request().url()).hostname)?r.continue():r.abort());
await page.goto('http://127.0.0.1:5608/?qa=1&dpr=1&'+require('./queries.json')['08'],{timeout:120000});await page.waitForFunction(()=>window.__rainbow?.ready,null,{timeout:150000});await page.evaluate(()=>document.fonts.ready);
const shots=[];for(const [name,steer] of [['hard-left-after-feedback',-1],['hard-right-after-feedback',1]]){
 const a=await page.evaluate(steer=>{const r=window.__rainbow;r.run(false);r.goto('08');const target=r.state().s+12;let n=0;
 r.setSteer(steer);while(r.state().s<target-.001&&n<1000){r.step(1);n++}r.setSteer(null);r.freezeAt(12+n/60);r.drawList();return {n,steer,state:r.state(),camera:r.camera()};
 },steer);await page.waitForTimeout(700);await page.waitForFunction(()=>{
  const element=document.querySelector('#hud .flash'),color=getComputedStyle(element).backgroundColor;
  return /rgba\([^)]*, 0\)$/.test(element.style.background)&&/rgba\([^)]*, 0\)$/.test(color);
 },null,{polling:100,timeout:20000});
 const overlay=await page.evaluate(()=>getComputedStyle(document.querySelector('#hud .flash')).backgroundColor);
 if(!/rgba\([^)]*, 0\)$/.test(overlay)&&overlay!=='transparent')throw Error('Feedback is still active '+overlay);
 await page.screenshot({path:path.join(dir,name+'.png'),timeout:100000,animations:'allow'});
 const after=await page.evaluate(()=>({target:document.querySelector('#hud .flash').style.background,computed:getComputedStyle(document.querySelector('#hud .flash')).backgroundColor}));
 if(!/rgba\([^)]*, 0\)$/.test(after.target)||!/rgba\([^)]*, 0\)$/.test(after.computed))throw Error('HUD changed during capture');
 shots.push({name,...a,overlay,after});}
 fs.writeFileSync(path.join(dir,'post-feedback.json'),JSON.stringify(shots,null,1));
}finally{await browser.close()}})().catch(e=>{console.error(e.stack);process.exitCode=1});
