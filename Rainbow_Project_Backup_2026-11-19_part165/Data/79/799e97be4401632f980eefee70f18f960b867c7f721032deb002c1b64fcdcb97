T\n        c = v @ self.P.T\n        ndc = c[..., :3] / c[..., 3:4]\n        px = np.stack([(ndc[..., 0] + 1) / 2 * W, (1 - ndc[..., 1]) / 2 * H], -1)\n        return px, -v[..., 2]\n\n\ndef ring_points(M, prof, nphi=720):\n    \"\"\"world points of a band ring with instance matrix M (local XY = ring plane, Z = axis): (nphi, nprof, 3)\"\"\"\n    phi = np.linspace(0, 2 * math.pi, nphi, endpoint=False)\n    rho, z = prof[:, 0], prof[:, 1]\n    X = np.stack([rho[None, :] * np.sin(phi)[:, None], -rho[None, :] * np.cos(phi)[:, None], np.broadcast_to(z, (nphi, len(z))), np.ones((nphi, len(z)))], -1)\n    return (X @ M.T)[..., :3]\n\n\ndef polar_edges(px, nth=720, origin=O):\n    \"\"\"min / max radius about origin per theta bin of projected points px (..., 2) -> (r_in, r_out) arrays (nan = none)\"\"\"\n    dx = px[..., 0] - origin[0]; dy = origin[1] - px[..., 1]\n    th = (np.degrees(np.arctan2(dy, dx)) % 360.0).ravel(); r = np.hypot(dx, dy).ravel()\n    b = np.minimum((th / 360.0 * nth).astype(int), nth - 1)\n    rin = np.full(nth, np.inf); rout = np.full(nth, -np.inf)\n    np.minimum.at(rin, b, r); np.maximum.at(rout, b, r)\n    rin[~np.isfinite(rin)] = np.nan; rout[~np.isfinite(rout)] = np.nan\n    return rin, rout\n\n\ndef mask_edges(mask, nth=720, origin=O, rmax=1300.0, dr=0.5):\n    \"\"\"inner / outer radius of a screen mask along rays about origin (first / last hit), nan where the ray misses\"\"\"\n    th = (np.arange(nth) + 0.5) / nth * 2 * math.pi\n    r = np.arange(0, rmax, dr)\n    X = origin[0] + r[None, :] * np.cos(th)[:, None]; Y = origin[1] - r[None, :] * np.sin(th)[:, None]\n    ok = (X >= 0) & (X <= W - 1) & (Y >= 0) & (Y <= H - 1)\n    xi = np.clip(np.round(X).astype(int), 0, W - 1); yi = np.clip(np.round(Y).astype(int), 0, H - 1)\n    hit = mask[yi, xi] & ok\n    rin = np.full(nth, np.nan); rout = np.full(nth, np.nan)\n    anyh = hit.any(1)\n    rin[anyh] = r[np.argmax(hit[anyh], 1)]\n    rout[anyh] = r[hit.shape[1] - 1 - np.argmax(hit[anyh][:, ::-1], 1)]\n    return rin, rout\n\n\ndef approved_edges(model, name, nth=720):\n    th = (np.arange(nth) + 0.5) / nth * 2 * math.pi\n    def ev(c): return c[0] + c[1] * np.cos(th) + c[2] * np.sin(th) + c[3] * np.cos(2 * th) + c[4] * np.sin(2 * th)\n    return ev(model[\"rings\"][name][\"in\"]), ev(model[\"rings\"][name][\"out\"])\n\n\ndef circle_fit(th, r, origin=O):\n    \"\"\"least-squares circle through the points (origin + r(theta)) -> cx, cy, R\"\"\"\n    x = origin[0] + r * np.cos(th); y = origin[1] - r * np.sin(th)\n    A = np.stack([x, y, np.ones_like(x)], -1); b = x * x + y * y\n    (a, bb, c), *_ = np.linalg.lstsq(A, b, rcond=None)\n    cx, cy = a / 2, bb / 2\n    return cx, cy, math.sqrt(c + cx * cx + cy * cy)\n\"\"\"env05 refinement: fit the sideways / upward displacement of a REAL ring under the env05 warp (weight\nsmoothstep(sin th, -0.28, 0.05), as src/world/environment.ts e05Weight) to the approved band edges.\nusage: python3 -I tools/env05/warp_fit.py <tunnel.json of an env05 probe> <ring name A|B> <mesh index> <h> [axial shift]\"\"\"\nimport json, math, sys, os\nimport numpy as np\nfrom scipy.optimize import least_squares\nsys.path.insert(0, os.path.dirname(__file__))\nfrom ringproj import *\ntj = json.load(open(sys.argv[1])); name = sys.argv[2]; k = int(sys.argv[3]); h = float(sys.argv[4])\nmodel = json.load(open(\"qa/pilot05/proj/tunnel/model/ring_model.json\"))\nfrom PIL import Image\nwater = np.asarray(Image.open(\"qa/pilot05/proj/target/water_mask.png\").convert(\"L\")) > 127\ncam = Cam(tj); M = mat4(tj[\"ringInstances\"][k]); r = np.linalg.norm(M[:3, 0])\nnegR, U, T = M[:3, 0] / r, M[:3, 1] / r, M[:3, 2]\nNT = 720; th = (np.arange(NT) + 0.5) / NT * 2 * math.pi\nain, aout = approved_edges(model, name, NT)\ndef vis(rr):\n    x = O[0] + rr * np.cos(th); y = O[1] - rr * np.sin(th)\n    ok = (x >= 2) & (x <= W - 3) & (y >= 205) & (y <= H - 3)\n    return ok & ~water[np.clip(np.round(y).astype(int), 0, H - 1), np.clip(np.round(x).astype(int), 0, W - 1)]\nvin, vout = vis(ain), vis(aout)\nbn = dict(tj[\"tunnel\"][\"band05near\"]); prof = band_profile(**dict(bn, height=h))\nphi = np.linspace(0, 2 * math.pi, 1440, endpoint=False)\nX = np.stack([prof[None, :, 0] * np.sin(phi)[:, None], -prof[None, :, 0] * np.cos(phi)[:, None]], -1)   # object xy\ntho = np.arctan2(X[..., 1], -X[..., 0])\ns = np.sin(tho); w = np.clip((s + 0.28) / 0.33, 0, 1); w = w * w * (3 - 2 * w)\ndef edges(p):\n    side, up, dz = p\n    P = M[:3, 3] + negR * (r * X[..., 0])[..., None] + U * (r * X[..., 1])[..., None] + T * (prof[None, :, 1] + dz)[..., None]\n    P = P - negR * (side * w)[..., None] + U * (up * w)[..., None]\n    px, dep = cam.project(P)\n    return polar_edges(px, NT)\ndef res(p):\n    gin, gout = edges(p)\n    return np.concatenate([np.where(vin & np.isfinite(gin), gin - ain, 0), np.where(vout & np.isfinite(gout), gout - aout, 0)])\np0 = [float(x) for x in (sys.argv[5:8] if len(sys.argv) > 7 else [0, 0, 0])]\nn = vin.sum() + vout.sum()\ne0 = np.abs(res(p0)).sum() / n\nsol = least_squares(res, p0, bounds=([-3, -3, -6], [3, 3, 6]), diff_step=1e-3, loss=\"soft_l1\", f_scale=4.0)\nprint(name, \"extra (side, up, axial) relative to this probe:\", np.round(sol.x, 3), f\"edge err {e0:.1f} -> {np.abs(res(sol.x)).sum() / n:.1f} px\")\npairs = dict(p.split(\"=\") for p in (sys.argv[4] if len(sys.argv) > 4 else \"A=r22,B=r23,C=f0,D=f1,E=f2,F=f3,G=f4\").split(\",\"))\nmodel = json.load(open(\"qa/pilot05/proj/tunnel/model/ring_model.json\"))\na = np.fromfile(idf, np.float32).reshape(H, W, 4)\ntag = np.where(a[..., 3] >= 10, np.round(a[..., 3]).astype(int), 0)\ncls = np.where(tag > 0, np.round(a[..., 2]).astype(int), 0)\nNT = 720\nth = (np.arange(NT) + 0.5) / NT * 2 * math.pi\nrows = {}\nfor name, key in pairs.items():\n    c = 3 if key[0] == \"r\" else 4\n    inst = int(key[1:]) if key[0] == \"r\" else 20 + int(key[1:])\n    m = (cls == c) & (tag == inst)\n    gin, gout = mask_edges(m, NT)\n    ain, aout = approved_edges(model, name, NT)\n    rep = model[\"report\"].get(f\"{name}_in\", {})\n    meas = rep.get(\"source\") in (\"measured\", \"scan from r 330\")\n    # compare where the game ring is visible on the ray and the ray is inside the frame at the approved edge, not behind HUD\n    ok = np.isfinite(gin) & np.isfinite(gout)\n    ax = O[0] + aout * np.cos(th); ay = O[1] - aout * np.sin(th)\n    inframe = (ax >= 0) & (ax < W) & (ay >= 200) & (ay < H)\n    k = ok & inframe\n    row = {\"key\": key, \"px\": int(m.sum()), \"approved_source\": rep.get(\"source\"), \"rays_compared\": int(k.sum())}\n    if k.sum() > 20:\n        for lab, rin, rout in ((\"approved\", ain, aout), (\"game\", gin, gout)):\n            cx, cy, R = circle_fit(th[k], 0.5 * (rin[k] + rout[k]))\n            row[lab] = {\"centre\": [round(cx, 1), round(cy, 1)], \"r_mid\": round(R, 1), \"band_px_median\": round(float(np.median(rout[k] - rin[k])), 1),\n                        \"r_in_mean\": round(float(rin[k].mean()), 1), \"r_out_mean\": round(float(rout[k].mean()), 1)}\n        row[\"d_r_in_mean\"] = round(float((gin[k] - ain[k]).mean()), 1)\n        row[\"d_r_out_mean\"] = round(float((gout[k] - aout[k]).mean()), 1)\n        row[\"abs_d_edges_mean\"] = round(float((np.abs(gin[k] - ain[k]) + np.abs(gout[k] - aout[k])).mean() / 2), 1)\n    rows[name] = row\njson.dump(rows, open(outp, \"w\"), indent=1)\nprint(f\"{'ring':4s} {'game':5s} {'rays':>5s} | {'APPROVED centre':>16s} {'r_mid':>6s} {'band':>5s} | {'GAME centre':>16s} {'r_mid':>6s} {'band':>5s} | dr_in dr_out |d|\")\nfor n, r in rows.items():\n    if \"approved\" not in r: print(n, r[\"key\"], r[\"rays_compared\"], \"not comparable\"); continue\n    A, G = r[\"approved\"], r[\"game\"]\n    print(f\"{n:4s} {r[\"key\"]:5s} {r['rays_compared']:5d} | {str(A['centre']):>16s} {A['r_mid']:6.1f} {A['band_px_median']:5.1f} | {str(G['centre']):>16s} {G['r_mid']:6.1f} {G['band_px_median']:5.1f} | {r['d_r_in_mean']:5.1f} {r['d_r_out_mean']:5.1f} {r['abs_d_edges_mean']:5.1f}\")", "is_error": false