ids={v[1] for tree in selected.values() for v in tree.values()}
run=lambda cmd,**kw:sp.run(cmd,stdout=sp.PIPE,stderr=sp.PIPE,check=True,**kw)
basecmd=['git','-C',str(repo)]
def checked_ids(ids):
