        origin=alt if alt.exists() else OLD/'archives'/sid/name
        assert sha(origin)==record['sha256']
        link_file(origin,dest/'claudia-archive'/name)
    if sid=='04':
        ring_name='3_NEW_a00_approved_view.png'
