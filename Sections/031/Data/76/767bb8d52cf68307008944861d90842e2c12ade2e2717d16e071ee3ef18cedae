{"agentId": "a0204aae384750b81", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-4f6c3e0e-5kxgr0", "isSidechain": true, "message": {"content": [{"content": "1\t/** Shared GLSL snippets for Rainbow water/foam/bubble shaders (WebGL2, mobile-safe). */\n2\timport * as THREE from 'three';\n3\t\n4\texport const NOISE_GLSL = /* glsl */ `\n5\tfloat hash12(vec2 p) {\n6\t  vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n7\t  p3 += dot(p3, p3.yzx + 33.33);\n8\t  return fract((p3.x + p3.y) * p3.z);\n9\t}\n10\tfloat vnoise(vec2 p) {\n11\t  vec2 i = floor(p);\n12\t  vec2 f = fract(p);\n13\t  vec2 u = f * f * (3.0 - 2.0 * f);\n14\t  return mix(mix(hash12(i), hash12(i + vec2(1.0, 0.0)), u.x),\n15\t             mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0, 1.0)), u.x), u.y);\n16\t}\n17\tfloat fbm3(vec2 p) {\n18\t  float a = 0.5, s = 0.0;\n19\t  for (int i = 0; i < 3; i++) { s += a * vnoise(p); p = p * 2.03 + vec2(17.1, 9.2); a *= 0.5; }\n20\t  return s;\n21\t}\n22\t// cheap cellular \"soap foam\" pattern: 0 at cell centres -> 1 at borders\n23\tfloat cells(vec2 p) {\n24\t  vec2 i = floor(p);\n25\t  vec2 f = fract(p);\n26\t  float md = 8.0;\n27\t  for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++) {\n28\t    vec2 g = vec2(float(x), float(y));\n29\t    vec2 o = vec2(hash12(i + g), hash12(i + g + 19.7));\n30\t    vec2 r = g + o - f;\n31\t    md = min(md, dot(r, r));\n32\t  }\n33\t  return sqrt(md);\n34\t}\n35\tvec3 iridescent(float t) {\n36\t  return 0.5 + 0.5 * cos(6.28318 * (t + vec3(0.0, 0.33, 0.67)));\n37\t}\n38\t`;\n39\t\n40\t/**\n41\t * Fragment-only helpers (use screen-space derivatives, so never include in a vertex shader).\n42\t *  - bumpNormal: Mikkelsen-style \"bump mapping without tangents\" from a scalar height field\n43\t *  - starGlint:  4-point star glint anchored to a world-space cell grid but sized in PIXELS, so the\n44\t *                cross stays star-shaped under grazing foreshortening (refs 05–07 white glints)\n45\t */\n46\texport const FRAG_FX_GLSL = /* glsl */ `\n47\tvec3 bumpNormal(vec3 pos, vec3 n, float h) {\n48\t  vec3 dpx = dFdx(pos);\n49\t  vec3 dpy = dFdy(pos);\n50\t  float dhx = dFdx(h);\n51\t  float dhy = dFdy(h);\n52\t  vec3 r1 = cross(dpy, n);\n53\t  vec3 r2 = cross(n, dpx);\n54\t  float det = dot(dpx, r1);\n55\t  vec3 grad = sign(det) * (dhx * r1 + dhy * r2);\n56\t  return normalize(abs(det) * n - grad);\n57\t}\n58\t// g: cell coordinates (world-anchored); density: probability a cell holds a star; L: arm length px;\n59\t// stretch: horizontal (g.x) arm length relative to the vertical one (ref 05 glints are wide flares)\n60\tfloat starGlint(vec2 g, float density, float L, float stretch, float time) {\n61\t  vec2 gi = floor(g);\n62\t  float hs = hash12(gi + 7.31);\n63\t  if (hs < 1.0 - density) return 0.0;\n64\t  vec2 cpp = max(fwidth(g), vec2(1e-4));           // cells per pixel\n65\t  vec2 c = vec2(hash12(gi + 3.1), hash12(gi + 5.7)) * 0.5 + 0.25;\n66\t  vec2 px = (fract(g) - c) / cpp;                   // offset in pixels\n67\t  vec2 lim = 0.24 / cpp;                            // never cross the cell border\n68\t  float l = L * (0.55 + 0.9 * fract(hs * 37.0));\n69\t  float ax = exp(-abs(px.y) * 0.75) * max(0.0, 1.0 - abs(px.x) / min(l * stretch, lim.x));\n70\t  float ay = exp(-abs(px.x) * 0.8) * max(0.0, 1.0 - abs(px.y) / min(l, lim.y));\n71\t  float core = exp(-dot(px, px) * 0.05) * 1.6;\n72\t  float tw = 0.55 + 0.45 * pow(0.5 + 0.5 * sin(time * 5.0 + hs * 60.0), 2.0);\n73\t  return ((ax * ax + ay * ay) * 1.6 + core) * tw;\n74\t}\n75\t// 4-point flare on a FLOW-aligned cell grid g = (across-flow, along-flow) cell coordinates (world-anchored,\n76\t// advected). The pixel offset from the star centre is solved through the screen Jacobian of g, and the\n77\t// long arm is laid along the SCREEN direction of +g.y (the current), so the flares streak with the flow\n78\t// on every bend (ref 05 mid-field) instead of collapsing into horizontal dashes under grazing\n79\t// foreshortening. horiz 0..1 turns the long arm toward screen-horizontal (ref 05 near-field flares lie\n80\t// across the flow). Arms taper to zero before the cell border (no clipped arms). Derivatives are taken\n81\t// before any early-out (Android-safe).\n82\tfloat flowGlint(vec2 g, float density, float L, float stretch, float horiz, float time) {\n83\t  vec2 gx = dFdx(g);\n84\t  vec2 gy = dFdy(g);\n85\t  vec2 gi = floor(g);\n86\t  float hs = hash12(gi + 7.31);\n87\t  float det = gx.x * gy.y - gy.x * gx.y;\n88\t  if (hs < 1.0 - density || abs(det) < 1e-12) return 0.0;\n89\t  vec2 dg = fract(g) - (vec2(hash12(gi + 3.1), hash12(gi + 5.7)) * 0.2 + 0.4);\n90\t  vec2 p = vec2(gy.y * dg.x - gy.x * dg.y, gx.x * dg.y - gx.y * dg.x) / det;   // pixels\n91\t  vec2 f = vec2(-gy.x, gx.x);                    // screen direction of +g.y (unnormalised, sign-free)\n92\t  f *= sign(f.x + 1e-6) / max(length(f), 1e-9);\n93\t  vec2 a = normalize(mix(f, vec2(1.0, 0.0), horiz) + vec2(1e-5, 0.0));\n94\t  vec2 b = vec2(-a.y, a.x);\n95\t  float pa = dot(p, a), pb = dot(p, b);\n96\t  vec2 ca = a.x * gx + a.y * gy, cb = b.x * gx + b.y * gy;   // cell units per pixel along a / b\n97\t  float la = 0.38 / max(max(abs(ca.x), abs(ca.y)), 1e-6);\n98\t  float lb = 0.38 / max(max(abs(cb.x), abs(cb.y)), 1e-6);\n99\t  float l = L * (0.55 + 0.9 * fract(hs * 37.0));\n100\t  float armA = exp(-abs(pb) * 0.85) * max(0.0, 1.0 - abs(pa) / min(l * stretch, la));\n101\t  float armB = exp(-abs(pa) * 0.85) * max(0.0, 1.0 - abs(pb) / min(l, lb));\n102\t  float core = exp(-dot(p, p) * 0.06) * 1.5;\n103\t  float tw = 0.55 + 0.45 * pow(0.5 + 0.5 * sin(time * 5.0 + hs * 60.0), 2.0);\n104\t  return ((armA * armA + armB * armB) * 1.6 + core) * tw;\n105\t}\n106\t`;\n107\t\n108\t/**\n109\t * Rainbow water palette (sRGB hex → linear THREE.Color, ready for uniforms).\n110\t * Base hues are scaled below the NeutralToneMapping knee (~0.76 linear) so the renderer does not\n111\t * desaturate them toward pastel; only highlights/sparkles/foam exceed 1.0 (and feed bloom).\n112\t */\n113\tconst knee = (hex: string, k = 0.74) => new THREE.Color(hex).multiplyScalar(k);\n114\texport const PALETTE = {\n115\t  cyanDeep: knee('#0a62f0', 0.72),\n116\t  cyan: knee('#08c0ff'),\n117\t  cyanBright: knee('#56f0ff', 0.8),\n118\t  pink: knee('#ff149f'),\n119\t  pinkLight: knee('#ff4cc0', 0.78),\n120\t  magenta: new THREE.Color('#e01ea0'),\n121\t  foam: new THREE.Color('#ffffff'),\n122\t  foamLav: new THREE.Color('#efe2ff'),\n123\t  haze: new THREE.Color('#ffd6f4'),\n124\t};\n125\t\n126\t/** fog-aware uniforms merged into every water ShaderMaterial */\n127\texport function withFog<T extends Record<string, THREE.IUniform>>(u: T): T & typeof THREE.UniformsLib.fog {\n128\t  return THREE.UniformsUtils.merge([THREE.UniformsLib.fog, u]) as T & typeof THREE.UniformsLib.fog;\n129\t}\n130\t\n131\t/** standard tail: tonemapping + colour space + fog (call with gl_FragColor already set) */\n132\texport const FRAG_TAIL = /* glsl */ `\n133\t  #include <tonemapping_fragment>\n134\t  #include <colorspace_fragment>\n135\t  #include <fog_fragment>\n136\t`;\n137\t", "tool_use_id": "toolu_01Hw1L7AGf5xD9uYxF9na2fF", "type": "tool_result"}], "role": "user"}, "parentUuid": "5cba5ae6-0924-405c-b658-0fa7ab378d15", "permissionDecision": {"decision": "accept", "reasonType": "rule", "ruleSource": "cliArg", "source": "config"}, "promptId": "5bbfcd9b-e5e5-49ad-a5a6-02d14ab044a9", "sessionId": "7c0df0fc-7d43-5a1e-bb66-c0bb31003a42", "sourceToolAssistantUUID": "5cba5ae6-0924-405c-b658-0fa7ab378d15", "timestamp": "2026-11-16T00:42:02.598Z", "type": "user", "userType": "external", "uuid": "a3de32d3-b4a3-4768-a1cd-630d89c099d5", "version": "2.1.325"}
