import json,subprocess,hashlib,shutil,os,re
from pathlib import Path
prev=Path('/tmp/rainbow-visual-audit.X0POSzUq');git=['git','--git-dir='+str(prev/'objects.git')]
heads=json.load(open('heads.json'));old=json.load(open(prev/'heads.json'))
def run(*a):return subprocess.check_output(git+list(a),text=True)
subprocess.run(git+['fetch','--quiet','--depth=1','--filter=blob:none','--no-tags','--no-write-fetch-head','origin']+[v['commit'] for v in heads.values()],check=True)
todo={}
def select(oid,path):todo.setdefault(oid,[]).append(path)
def tree(c):return {l.split('\t')[1]:l.split()[2] for l in run('ls-tree','-r',c).splitlines()}
oldtree=json.load(open(prev/'trees.json'));manifest_path=prev/'read/lead/scripts/reference.sha256'
manifest={l.split()[1]:l.split()[0] for l in manifest_path.read_text().splitlines()}
verified={}
for k,v in heads.items():
 c=v['commit'];t=tree(c)
 verified[k]=all(t.get(p)==oldtree['lead'].get(p) and hashlib.sha256((prev/'read/lead'/p).read_bytes()).hexdigest()==h for p,h in manifest.items())
 msg=run('show','-s','--format=%ci %s',c).strip();print(k,msg,verified[k],flush=True)
 if k=='codex':continue
 if k=='lead':
  for p,oid in t.items():
   if p in ['CLAUDE.md','AGENTS.md','backups/AGENTS_STATUS.json','backups/TOOL_MANIFEST.json','docs/NEW_CLAUDE_ACCOUNT_HANDOFF.md','docs/briefs/2026-11-18-r17/COORDINATION.md','docs/briefs/2026-11-18-r17/RESUME_R17.md'] or re.search(r'backups/wip/[^/]*s07[^/]*-c17/(INFO.json|tracked.patch)$',p) or re.search(r'backups/wip/[^/]*s07[^/]*-c17/untracked/.+(PROGRESS|NOTES)\.md$',p):
    select(oid,Path('docs/lead')/p)
  continue
 target=Path('games')/k
 shutil.copytree(prev/'copies'/k,target,ignore=shutil.ignore_patterns('node_modules','.vite'),copy_function=os.link)
 for p in set(oldtree[k])-set(t):
  f=target/p
  if f.is_file():f.unlink()
 for p,oid in t.items():
  if (p.startswith(('src/','public/','assets/','references/','character_references/')) or p in ('index.html','package.json','package-lock.json','vite.config.ts')) and oid!=oldtree[k].get(p):select(oid,target/p)
  if p=='scripts/gameplay-test.mjs' or p.startswith('qa/match/'+k[:2]+'/r17/') and (p.endswith(('PROGRESS.md','NOTES.md','KEPT_START.txt')) or p.endswith('motion.json') and ('/new/' in p.lower() or '3_new' in p.lower() or k=='04r')):select(oid,Path('docs')/k/p)
 os.symlink(prev/'runtime-deps/node_modules',target/'node_modules',target_is_directory=True)
miss=subprocess.run(git+['cat-file','--batch-check=%(objectname) %(objecttype)'],env={**os.environ,'GIT_NO_LAZY_FETCH':'1'},input='\n'.join(todo)+'\n',text=True,check=True,stdout=subprocess.PIPE).stdout
missing=[l.split()[0] for l in miss.splitlines() if l.endswith(' missing')]
for off in range(0,len(missing),45):
 subprocess.run(git+['-c','fetch.negotiationAlgorithm=noop','fetch','--quiet','--no-tags','--no-write-fetch-head','--filter=blob:none','--stdin','origin'],input='\n'.join(missing[off:off+45])+'\n',text=True,check=True)
for oid,files in todo.items():
 data=subprocess.check_output(git+['cat-file','blob',oid])
 if data.startswith(b'version https://git-lfs.github.com/spec/v1'):
  sha=data.decode().split('sha256:')[1].split()[0]
  data=subprocess.check_output(['git','-C',str(prev/'objects.git'),'lfs','smudge','--',str(files[0])],input=data,stderr=subprocess.PIPE)
  assert hashlib.sha256(data).hexdigest()==sha
 for f in files:
  f.parent.mkdir(parents=True,exist_ok=True);f.unlink(missing_ok=True);f.write_bytes(data)
assert all(verified.values())
Path('reference-checks.json').write_text(json.dumps({'verifiedRefs':verified,'manifest':manifest},indent=2))
