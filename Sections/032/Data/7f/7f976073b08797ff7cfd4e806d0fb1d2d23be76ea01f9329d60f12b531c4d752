_crown:e4d4e4` sets the base-colour factor of meshes whose name\n104\t  // starts with the given prefix (the GLB's own factors are the default; materials are shared by every clone)\n105\t  if (typeof location !== 'undefined') {\n106\t    const tint = new URLSearchParams(location.search).get('bennyTint');\n107\t    for (const kv of tint ? tint.split(',') : []) {\n108\t      const [prefix, hex] = kv.split(':');\n109\t      if (!prefix || !/^[0-9a-f]{6}$/i.test(hex ?? '')) continue;\n110\t      scene.traverse((o) => {\n111\t        const m = o as THREE.Mesh;\n112\t        if (m.isMesh && m.name.startsWith(prefix)) (m.material as THREE.MeshStandardMaterial).color?.set(`#${hex}`);\n113\t      });\n114\t    }\n115\t  }\n116\t\n117\t  const get = (n: string) => scene.getObjectByName(n)!;\n118\t  const body = get('body');\n119\t  const pom = get('pom');\n120\t  const eyeL = get('eyeL');\n121\t  const eyeR = get('eyeR');\n122\t  const eyesGroup = get('eyes');\n123\t  const pomRest = pom.quaternion.clone();\n124\t\n125\t  // ---- animation mixer: idle ↔ swim blend, tumble / peek on demand ----\n126\t  const mixer = new THREE.AnimationMixer(scene);\n127\t  const act = (name: string) => {\n128\t    const c = clips.find((k) => k.name === name);\n129\t    return c ? mixer.clipAction(c) : null;\n130\t  };\n131\t  const aIdle = act('idle'), aSwim = act('swim'), aTumble = act('tumble'), aPeek = act('peek');\n132\t  for (const a of [aIdle, aSwim, aTumble, aPeek]) a?.play();\n133\t  const setW = (a: THREE.AnimationAction | null, w: number) => a && a.setEffectiveWeight(w);\n134\t\n135\t  let expression: 'happy' | 'dizzy' | 'peek' = 'happy';\n136\t  const setExpression = (e: 'happy' | 'dizzy' | 'peek') => {\n137\t    expression = e;\n138\t    for (const s of ['L', 'R']) {\n139\t      const h = scene.getObjectByName(`eye${s}_happy`);\n140\t      const d = scene.getObjectByName(`eye${s}_dizzy`);\n141\t      if (h) h.visible = e !== 'dizzy';\n142\t      if (d) d.visible = e === 'dizzy';\n143\t    }\n144\t    for (const k of ['happy', 'dizzy', 'peek']) {\n145\t      const m = scene.getObjectByName(`mouth_${k}`);\n146\t      if (m) m.visible = k === e;\n147\t    }\n148\t    eyesGroup.scale.setScalar(e === 'peek' ? 1.06 : 1);\n149\t  };\n150\t  setExpression('happy');\n151\t\n152\t  // ---- secondary motion state ----\n153\t  let pomAngX = 0, pomVelX = 0, pomAngZ = 0, pomVelZ = 0;\n154\t  let lastY = 0, lastVy = 0;\n155\t  let blinkT = 1.7;\n156\t  let lean = 0;\n157\t  let lift = 0;\n158\t  const liftMax = rideLift();\n159\t  let pitch = 0;\n160\t  const pitchMax = ridePitch();\n161\t  const tmp = new THREE.Vector3();\n162\t  const qLean = new THREE.Quaternion();\n163\t  const qPom = new THREE.Quaternion();\n164\t  const eAxis = new THREE.Euler();\n165\t\n166\t  const update: BennyRuntime['update'] = (dt, st) => {\n167\t    dt = Math.min(dt, 1 / 20);\n168\t    // clip weights\n169\t    const tumble = !!st.tumble;\n170\t    const swim = tumble ? 0 : THREE.MathUtils.clamp(st.swim, 0, 1);\n171\t    const peek = expression === 'peek' && !tumble ? 1 : 0;\n172\t    setW(aTumble, tumble ? 1 : 0);\n173\t    setW(aPeek, peek);\n174\t    setW(aSwim, peek ? 0 : swim);\n175\t    setW(aIdle, tumble || peek ? 0 : 1 - swim);\n176\t    if (aSwim) aSwim.timeScale = 0.8 + Math.min(1.2, st.speed / 14);\n177\t    mixer.update(dt);\n178\t\n179\t    // ride height (see BENNY_RIDE_LIFT): eased so mode switches never pop\n180\t    const liftTarget = tumble || peek ? 0 : liftMax * THREE.MathUtils.smoothstep(swim, 0.5, 0.9);\n181\t    lift += (liftTarget - lift) * (1 - Math.exp(-dt * 7));\n182\t    scene.position.y = lift;\n183\t    // ride lean into the current (see BENNY_RIDE_PITCH), on the same ease as the lift\n184\t    const pitchScale = typeof root.userData.ridePitch === 'number' ? THREE.MathUtils.clamp(root.userData.ridePitch, 0, 1) : 1;\n185\t    const pitchTarget = tumble || peek ? 0 : pitchMax * pitchScale * THREE.MathUtils.smoothstep(swim, 0.5, 0.9);\n186\t    pitch += (pitchTarget - pitch) * (1 - Math.exp(-dt * 7));\n187\t\n188\t    // steering lean (roll) + slight yaw into the turn\n189\t    lean += (THREE.MathUtils.clamp(st.steer, -1, 1) * 0.28 - lean) * Math.min(1, dt * 6);\n190\t    qLean.setFromEuler(eAxis.set(pitch, -lean * 0.6, -lean));\n191\t    body.quaternion.multiply(qLean);\n192\t\n193\t    // pom-pom spring: driven by vertical acceleration, steering and speed jitter\n194\t    root.getWorldPosition(tmp);\n195\t    const vy = (tmp.y - lastY) / Math.max(dt, 1e-3);\n196\t    const ay = THREE.MathUtils.clamp((vy - lastVy) / Math.max(dt, 1e-3), -80, 80);\n197\t    lastY = tmp.y; lastVy = vy;\n198\t    const k = 120, c = 9;\n199\t    const targetX = -ay * 0.004 + Math.sin(st.time * 11) * 0.03 * Math.min(1, st.speed / 12);\n200\t    const targetZ = lean * 0.9;\n201\t    pomVelX += (k * (targetX - pomAngX) - c * pomVelX) * dt;\n202\t    pomAngX += pomVelX * dt;\n203\t    pomVelZ += (k * (targetZ - pomAngZ) - c * pomVelZ) * dt;\n204\t    pomAngZ += pomVelZ * dt;\n205\t    qPom.setFromEuler(eAxis.set(THREE.MathUtils.clamp(pomAngX, -0.6, 0.6), 0, THREE.MathUtils.clamp(pomAngZ, -0.6, 0.6)));\n206\t    pom.quaternion.copy(pomRest).multiply(qPom);\n207\t\n208\t    // blink (cartoon squash of the eyes); no blinking while dizzy\n209\t    blinkT -= dt;\n210\t    let blink = 1;\n211\t    if (expression !== 'dizzy') {\n212\t      if (blinkT < 0.14) blink = Math.abs(blinkT - 0.07) / 0.07;\n213\t      if (blinkT <= 0) blinkT = 2.2 + Math.random() * 2.6;\n214\t    }\n215\t    eyeL.scale.y = eyeR.scale.y = Math.max(0.08, blink);\n216\t\n217\t    for (const f of furs) {\n218\t      f.uniforms.uTime.value = st.time;\n219\t      f.uniforms.uWind.value.set(0, 0, -Math.min(0.6, st.speed / 25));\n220\t    }\n221\t  };\n222\t\n223\t  // ---- QA segmentation mask (`?bennyMask`, or window.__bennyQA.mask(true) in ?qa pages) ----\n224\t  if (typeof location !== 'undefined') {\n225\t    const qs = new URLSearchParams(location.search);\n226\t    const qa = { mask: (on: boolean) => setMask(scene, furs, on), info: () => qaInfo(root, body), b05 };\n227\t    if (qs.has('qa') || qs.has('bennyMask')) (window as unknown as { __bennyQA?: typeof qa }).__bennyQA = qa;\n228\t    if (qs.has('bennyMask')) qa.mask(true);\n229\t  }\n230\t\n231\t  return { root, setExpression, update, radius: 0.8 };\n232\t}\n233\t\n234\t/**\n235\t * Flat ID colours for pixel measurement in real game captures (no lighting, fog or textures):\n236\t * body fur / arms / feet / face = red, beanie crown = cyan, ribbed cuff = blue, pom-pom = green, star = black.\n237\t * Classify the frame with  R>150,G<60,B<60 (body) · G>150,R<60,B<60 (pom) · B>150,R<60,G<60 (cuff) ·\n238\t * R<60,G>150,B>150,|G−B|<40 (crown) · all<40 inside the hat (star).\n239\t */\n240\tconst MASK_COLS: [RegExp, string][] = [\n241\t  [/^fur_pom/, '#00ff00'],\n242\t  [/^hat_crown/, '#00ffff'],\n243\t  [/^hat_brim/, '#0000ff'],\n244\t  [/^hat_star/, '#000000'],\n245\t];\n246\tfunction maskColour(name: string): string {\n247\t  for (const [re, c] of MASK_COLS) if (re.test(name)) return c;\n248\t  return '#ff0000';\n249\t}\n250\tfunction setMask(scene: THREE.Object3D, furs: FurHandle[], on: boolean): void {\n251\t  for (const f of furs) {\n252\t    f.uniforms.uMaskCol.value.set(maskColour(f.mesh.name));\n253\t    const d = f.material.defines ?? (f.material.defines = {});\n254\t    if (on) d.BENNY_MASK = ''; else delete d.BENNY_MASK;\n255\t    f.material.needsUpdate = true;\n256\t  }\n257\t  scene.traverse((o) => {\n258\t    const m = o as THREE.Mesh;\n259\t    if (!m.isMesh || (m as unknown as THREE.InstancedMesh).isInstancedMesh) return;\n260\t    const ud = m.userData as { qaOrig?: THREE.Material | THREE.Material[]; qaVis?: boolean };\n261\t    if (on && !ud.qaOrig) {\n262\t      ud.qaOrig = m.material;\n263\t      ud.qaVis = m.visible;\n264\t      // face decals sit on the red body: hide them so their alpha edges do not leak texture colours\n265\t      if (/^(blush|mouth_)/.test(m