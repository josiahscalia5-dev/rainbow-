thout knots Z = u.\n467\t   */\n468\t  constructor(readonly path: TubePath, readonly sF: number, eye: THREE.Vector3, readonly L: number, readonly zEnd: number, readonly knots: [number, number][] = [], axis?: THREE.Vector3) {\n469\t    const f = path.frame(sF);\n470\t    this.c0 = tubeCenterAt(path, sF);\n471\t    // `axis`: direction of the straight run the camera looks down (the path's tangent at sF may already\n472\t    // be easing toward the next stage's axis, which would put the far vanishing point off the real one)\n473\t    this.T = (axis ?? f.tan).clone().normalize();\n474\t    this.U = f.up.clone().addScaledVector(this.T, -f.up.dot(this.T)).normalize();\n475\t    this.Rt = new THREE.Vector3().crossVectors(this.T, this.U).normalize();\n476\t    this.R = path.radius(sF);\n477\t    const rel = this.c0.clone().sub(eye);\n478\t    this.D0 = rel.dot(this.T);\n479\t    this.q = rel.negate().addScaledVector(this.T, this.D0); // eye − c0 minus its axial part\n480\t  }\n481\t  private interp(x: number, a: 0 | 1) {\n482\t    const k = this.knots, b = (1 - a) as 0 | 1;\n483\t    if (k.length < 2) return x;\n484\t    for (let i = 1; i < k.length; i++) {\n485\t      if (x <= k[i][a] || i === k.length - 1) {\n486\t        const t = (x - k[i - 1][a]) / (k[i][a] - k[i - 1][a]);\n487\t        return k[i - 1][b] + t * (k[i][b] - k[i - 1][b]);\n488\t      }\n489\t    }\n490\t    return x;\n491\t  }\n492\t  /** virtual depth Z of tunnel coordinate u (see `knots`) */\n493\t  zOfU(u: number) { return this.interp(u, 0); }\n494\t  /** tunnel coordinate u of virtual depth Z */\n495\t  uOfZ(Z: number) { return this.interp(Z, 1); }\n496\t  /** 0 = forced perspective (closed), 1 = folded away outside the real tube: the rider camera within\n497\t   *  `near`…`far` units (along the axis) of the section start opens it, so the ride into 06 is untouched */\n498\t  openFor(cam: THREE.Vector3, near = 18, far = 34) {\n499\t    const d = this.c0.clone().sub(cam).dot(this.T);\n500\t    return 1 