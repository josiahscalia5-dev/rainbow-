{"agentId": "a3f810ba4510d393b", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-4f6c3e0e-5kxgr0", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Tunnel geometry generated from course-aligned \"tube paths\", so walls, rings and nozzles follow the\n3\t * 04 slide, the 06 arch and the full 07 plunge with no seams.\n4\t *  - courseTubePath:   tube centred on the course itself (chute, gold ring pipe)\n5\t *  - straightTubePath: tube on a low-pass-filtered axis of the course (05–07): the tunnel stays\n6\t *    straight with concentric rings converging to one vanishing point (refs 05/07) while the stream\n7\t *    winds inside it. Radius/depth adapt so the floor always stays below the winding stream, and the\n8\t *    axis converges exactly onto the course at both ends (04 pipe junction, 08 chamber inlet).\n9\t */\n10\timport * as THREE from 'three';\n11\timport type { Course } from './course';\n12\t\n13\texport interface Frame { pos: THREE.Vector3; tan: THREE.Vector3; up: THREE.Vector3; right: THREE.Vector3 }\n14\t\n15\texport interface TubePath {\n16\t  frame(s: number): Frame;\n17\t  radius(s: number): number;\n18\t  /** distance from the water point on the axis down to the tube bottom */\n19\t  depth(s: number): number;\n20\t}\n21\t\n22\texport function courseTubePath(course: Course, radius: (s: number) => number, depth: number | ((s: number) => number) = 0.9): TubePath {\n23\t  return {\n24\t    frame: (s) => course.sample(s),\n25\t    radius,\n26\t    depth: typeof depth === 'number' ? () => depth : depth,\n27\t  };\n28\t}\n29\t\n30\texport function straightTubePath(\n31\t  course: Course,\n32\t  s0: number,\n33\t  s1: number,\n34\t  opts: { window: number; taper: number; baseRadius: (s: number) => number },\n35\t): TubePath {\n36\t  const ds = 0.5;\n37\t  const n = Math.ceil((s1 - s0) / ds) + 1;\n38\t  const S = (i: number) => Math.min(s1, s0 + i * ds);\n39\t  const axis: THREE.Vector3[] = [];\n40\t  const cp: THREE.Vector3[] = [];\n41\t  for (let i = 0; i < n; i++) cp.push(course.sample(S(i)).pos.clone());\n42\t  for (let i = 0; i < n; i++) {\n43\t    const s = S(i);\n44\t    const taper = THREE.MathUtils.smoothstep(s, s0, s0 + opts.taper) * (1 - THREE.MathUtils.smoothstep(s, s1 - opts.taper, s1));\n45\t    const W = opts.window * taper;\n46\t    const k = Math.round(W / ds);\n47\t    let x = 0, z = 0, wsum = 0;\n48\t    for (let j = i - k; j <= i + k; j++) {\n49\t      const jj = THREE.MathUtils.clamp(j, 0, n - 1);\n50\t      const w = k === 0 ? 1 : 1 - Math.abs(j - i) / (k + 1);\n51\t      x += cp[jj].x * w; z += cp[jj].z * w; wsum += w;\n52\t    }\n53\t    axis.push(new THREE.Vector3(x / wsum, cp[i].y, z / wsum));\n54\t  }\n55\t  // exact straight stretches (05 current): the axis is pulled onto the course's straight centre line\n56\t  // (foot of the perpendicular from the stream point), so the tunnel is truly straight — no yaw\n57\t  // wiggle, no roll — and the rings converge on one vanishing point. Blends in over 12 units after\n58\t  // the 04 junction; height/roll/radius/depth return to the 06 arch tube just past its foot (wRun),\n59\t  // the lateral position over the last ~20 units of the stretch (wXZ) so the hand-over to the\n60\t  // filtered 06 axis has no yaw kink and 06 itself is unchanged.\n61\t  const wRun = new Array<number>(n).fill(0);\n62\t  const wXZ = new Array<number>(n).fill(0);\n63\t  const runDepth = new Array<number>(n).fill(0);\n64\t  for (const r of course.straightAxes ?? []) {\n65\t    if (r.s1 <= s0 || r.s0 >= s1) continue;\n66\t    const ab = r.b.clone().sub(r.a);\n67\t    const ab2 = ab.lengthSq();\n68\t    for (let i = 0; i < n; i++) {\n69\t      const s = S(i);\n70\t      const wIn = THREE.MathUtils.smoothstep(s, r.s0, r.s0 + 12);\n71\t      const w = wIn * (1 - THREE.MathUtils.smoothstep(s, r.s1 - 6, r.s1 + 2));\n72\t      const wl = wIn * (1 - THREE.MathUtils.smoothstep(s, r.s1 - 18, r.s1 + 2));\n73\t      if (wl <= wXZ[i]) continue;\n74\t      wXZ[i] = wl;\n75\t      wRun[i] = w;\n76\t      runDepth[i] = r.floorDepth;\n77\t      const u = cp[i].clone().sub(r.a).dot(ab) / ab2;\n78\t      const onLine = r.a.clone().addScaledVector(ab, u);\n79\t      axis[i].x += (onLine.x - axis[i].x) * wl;\n80\t      axis[i].z += (onLine.z - axis[i].z) * wl;\n81\t      axis[i].y += (onLine.y - axis[i].y) * w;\n82\t    }\n83\t  }\n84\t  const WU = new THREE.Vector3(0, 1, 0);\n85\t  const frames: Frame[] = axis.map((p, i) => {\n86\t    const a = axis[Math.max(0, i - 2)], b = axis[Math.min(n - 1, i + 2)];\n87\t    const tan = b.clone().sub(a).normalize();\n88\t    const cu = course.sample(S(i)).up.clone().lerp(WU, wRun[i]); // no banking roll on straight stretches\n89\t    const up = cu.addScaledVector(tan, -cu.dot(tan)).normalize();\n90\t    const right = new THREE.Vector3().crossVectors(tan, up).normalize();\n91\t    return { pos: p, tan, up, right };\n92\t  });\n93\t  // radius/depth so the floor stays below the stream edges, dilated + smoothed for a steady tube\n94\t  const rawR: number[] = [], rawD: number[] = [], needR: number[] = [], needD: number[] = [];\n95\t  for (let i = 0; i < n; i++) {\n96\t    const s = S(i);\n97\t    const off = cp[i].clone().sub(frames[i].pos);\n98\t    const d = off.dot(frames[i].right);\n99\t    const X = Math.abs(d) + course.widthAt(s) / 2 + 0.25;\n100\t    const r = Math.max(opts.baseRadius(s), X + 0.7);\n101\t    rawR.push(r);\n102\t    rawD.push(Math.max(0.9, r - Math.sqrt(Math.max(0, r * r - X * X)) + 0.2));\n103\t    // straight stretches: also account for the stream's height above/below the (straight) axis point\n104\t    needR.push(X + 0.7);\n105\t    needD.push(r - Math.sqrt(Math.max(0, r * r - X * X)) + 0.2 - off.dot(frames[i].up));\n106\t  }\n107\t  const dilate = (arr: number[], k: number) => arr.map((_, i) => { let m = -Infinity; for (let j = i - k; j <= i + k; j++) m = Math.max(m, arr[THREE.MathUtils.clamp(j, 0, n - 1)]); return m; });\n108\t  const box = (arr: number[], k: number) => arr.map((_, i) => { let a = 0; for (let j = i - k; j <= i + k; j++) a += arr[THREE.MathUtils.clamp(j, 0, n - 1)]; return a / (2 * k + 1); });\n109\t  const R = box(dilate(rawR, 30), 16);\n110\t  const D = box(dilate(rawD, 30), 16);\n111\t  if (wRun.some((w) => w > 0)) {\n112\t    // on a straight stretch the tunnel keeps its own constant radius (the next stage's wider hall is\n113\t    // not dilated back into it) and the stream sits `floorDepth` above the tunnel bottom (wide current)\n114\t    const nR = box(dilate(needR, 30), 16);\n115\t    const nD = box(dilate(needD, 30), 16);\n116\t    for (let i = 0; i < n; i++) {\n117\t      const w = wRun[i];\n118\t      if (w <= 0) continue;\n119\t      R[i] += (Math.max(opts.baseRadius(S(i)), nR[i]) - R[i]) * w;\n120\t      D[i] += (Math.max(runDepth[i], nD[i], 0.9) - D[i]) * w;\n121\t    }\n122\t  }\n123\t  const idx = (s: number) => {\n124\t    const x = THREE.MathUtils.clamp((s - s0) / ds, 0, n - 1);\n125\t    const i = Math.min(n - 2, Math.floor(x));\n126\t    return { i, f: x - i };\n127\t  };\n128\t  const lerpArr = (arr: number[], s: number) => { const { i, f } = idx(s); return arr[i] + (arr[i + 1] - arr[i]) * f; };\n129\t  return {\n130\t    frame(s) {\n131\t      const { i, f } = idx(s);\n132\t      const A = frames[i], B = frames[i + 1];\n133\t      const pos = A.pos.clone().lerp(B.pos, f);\n134\t      const tan = A.tan.clone().lerp(B.tan, f).normalize();\n135\t      const up = A.up.clone().lerp(B.up, f);\n136\t      up.addScaledVector(tan, -up.dot(tan)).normalize();\n137\t      return { pos, tan, up, right: new THREE.Vector3().crossVectors(tan, up).normalize() };\n138\t    },\n139\t    radius: (s) => lerpArr(R, s),\n140\t    depth: (s) => lerpArr(D, s),\n141\t  };\n142\t}\n143\t\n144\texport function tubeCenterAt(path: TubePath, s: number, out = new THREE.Vector3()) {\n145\t  const f = path.frame(s);\n146\t  return out.copy(f.pos).addScaledVector(f.up, path.radius(s) - path.depth(s));\n147\t}\n148\t\n149\texport interface TubeGeoOptions {\n150\t  radial?: number;\n151\t  step?: number;\n152\t  vScale?: number;\n153\t  /** angular range (radians, measured from the bottom) — default full circle */\n154\t  arc?: number;\n155\t  /** radius offset (negative = inset toward the axis) */\n156\t  inset?: number;\n157\t  /**\n158\t   * Store the front-face (outward) normal. The faces wind outward, so BackSide/DoubleSide materials\n159\t   * flip this to the inward normal and light the inside of the tube correctly. The legacy default\n160\t   * (false) stores -d, which those materials flip to point AWAY from the viewer (dot(N,V) <= 0 →\n161\t   * full fresnel, un-tinted pale reflections); kept only so the 02 chute / 04 pipe look is unchanged.\n162\t   */\n163\t  frontNormals?: boolean;\n164\t  /** also store the local tube frame per vertex (`tubeAxis`, `tubeUp`) for withTubeStrips('attribute') */\n165\t  axisAttr?: boolean;\n166\t}\n167\t\n168\texport function buildTubeGeometry(path: TubePath, s0: number, s1: number, o: TubeGeoOptions = {}): THREE.BufferGeometry {\n169\t  const radial = o.radial ?? 48;\n170\t  const step = o.step ?? 0.6;\n171\t  const vScale = o.vScale ?? 1;\n172\t  const arc = o.arc ?? Math.PI * 2;\n173\t  const ns = o.frontNormals ? 1 : -1;\n174\t  const rings = Math.max(2, Math.ceil((s1 - s0) / step) + 1);\n175\t  const pos = new Float32Array(rings * (radial + 1) * 3);\n176\t  const nor = new Float32Array(rings * (radial + 1) * 3);\n177\t  const uv = new Float32Array(rings * (radial + 1) * 2);\n178\t  const ax = o.axisAttr ? new Float32Array(rings * (radial + 1) * 3) : null;\n179\t  const au = o.axisAttr ? new Float32Array(rings * (radial + 1) * 3) : null;\n180\t  const c = new THREE.Vector3();\n181\t  const d = new THREE.Vector3();\n182\t  for (let i = 0; i < rings; i++) {\n183\t    const s = s0 + ((s1 - s0) * i) / (rings - 1);\n184\t    const f = path.frame(s);\n185\t    const r = path.radius(s) + (o.inset ?? 0);\n186\t    c.copy(f.pos).addScaledVector(f.up, path.radius(s) - path.depth(s));\n187\t    for (let j = 0; j <= radial; j++) {\n188\t      const th = -Math.PI / 2 - arc / 2 + (j / radial) * arc; // centred on the bottom\n189\t      d.copy(f.right).multiplyScalar(Math.cos(th)).addScaledVector(f.up, Math.sin(th));\n190\t      const k = i * (radial + 1) + j;\n191\t      if (ax && au) { f.tan.toArray(ax, k * 3); f.up.toArray(au, k * 3); }\n192\t      pos[k * 3] = c.x + d.x * r;\n193\t      pos[k * 3 + 1] = c.y + d.y * r;\n194\t      pos[k * 3 + 2] = c.z + d.z * r;\n195\t      nor[k * 3] = ns * d.x; nor[k * 3 + 1] = ns * d.y; nor[k * 3 + 2] = ns * d.z;\n196\t      uv[k * 2] = j / radial;\n197\t      uv[k * 2 + 1] = s / vScale;\n198\t    }\n199\t  }\n200\t  const idx: number[] = [];\n201\t  for (let i = 0; i < rings - 1; i++) {\n202\t    for (let j = 0; j < radial; j++) {\n203\t      const a = i * (radial + 1) + j, b = a + radial + 1;\n204\t      idx.push(a, b, a + 1, b, b + 1, a + 1);\n205\t    }\n206\t  }\n207\t  const g = new THREE.BufferGeometry();\n208\t  g.setAttribute('position', new THREE.BufferAttribute(pos, 3));\n209\t  g.setAttribute('normal', new THREE.BufferAttribute(nor, 3));\n210\t  g.setAttribute('uv', new THREE.BufferAttribute(uv, 2));\n211\t  if (ax && au) {\n212\t    g.setAttribute('tubeAxis', new THREE.BufferAttribute(ax, 3));\n213\t    g.setAttribute('tubeUp', new THREE.BufferAttribute(au, 3));\n214\t  }\n215\t  g.setIndex(idx);\n216\t  g.computeBoundingSphere();\n217\t  return g;\n218\t}\n219\t\n220\t/**\n221\t * Washer-tube ring collar (ref 05: \"flat gold band with a double contour\"): a broad FLAT inner band that\n222\t * barely stands off the wall, a dark groove, then a thin raised lip on the near edge (−z, the side the\n223\t * rider looks at) whose small camera-facing side catches a bright line. The protrusion is shallow on\n224\t * purpose: a deep collar shows a big camera-facing annulus (the old \"thick orange pipe\" look, 21% gold)\n225\t * and pokes through the stream where it hugs the wall (06 arch).\n226\t * Lathe around local Z; radial values are fractions of the tube radius, axial values are world units\n227\t * (the instance scales z by 1). Interior corners are duplicated so every facet keeps a crisp normal.\n228\t */\n229\texport function collarGeometry(depth = 0.022, lip = 0.012, width = 1.1, segments = 96): THREE.BufferGeometry {\n230\t  const w = width / 2;\n231\t  const d = depth;\n232\t  const lipW = Math.min(0.16, width * 0.15), groove = Math.min(0.07, width * 0.06);\n233\t  // traversed from +z to -z so LatheGeometry's faces/normals point INWARD (toward the tunnel axis)\n234\t  const prof: [number, number][] = [\n235\t    [1.03, w], [1 - d * 0.5, w], // far side (hidden from the rider)\n236\t    [1 - d, w - 0.05], // far chamfer\n237\t    [1 - d, -w + lipW + groove + 0.02], // the flat band\n238\t    [1 - d * 0.55, -w + lipW + groove * 0.5], // dark groove (recessed toward the wall)\n239\t    [1 - d - lip, -w + lipW], [1 - d - lip, -w + 0.05], // raised lip\n240\t    [1 - d * 0.35, -w], // lip's camera-facing side → thin bright contour\n241\t    [1.03, -w],\n242\t  ];\n243\t  const pts: THREE.Vector2[] = [];\n244\t  prof.forEach(([x, y], i) => {\n245\t    pts.push(new THREE.Vector2(x, y));\n246\t    if (i > 0 && i < prof.length - 1) pts.push(new THREE.Vector2(x, y)); // crisp facet normals\n247\t  });\n248\t  const g = new THREE.LatheGeometry(pts, segments);\n249\t  g.rotateX(Math.PI / 2); // lathe axis Y → tube axis Z\n250\t  return g;\n251\t}\n252\t\n253\t/**\n254\t * Ref 05 ring (wave 4): a ROUNDED gold band with a double contour — a thick half-round main band (the\n255\t * camera-facing body catches a bright highlight on its crown and falls to copper in its shadowed lower\n256\t * half) and, on the camera side (−z), a thin half-round lip separated by a narrow dark groove. Radial\n257\t * values are fractions of the ring radius (1 = wall), axial values world units. Lathe around local Z,\n258\t * traversed +z → −z so the faces point inward.\n259\t */\n260\texport function roundBandGeometry(height = 0.095, width = 0.78, lipHeight = 0.045, lipWidth = 0.26, groove = 0.07, segments = 96): THREE.BufferGeometry {\n261\t  const w = (width + groove + lipWidth) / 2;\n262\t  const yc = w - width / 2, a = width / 2;\n263\t  const yl = -w + lipWidth / 2, al = lipWidth / 2;\n264\t  const pts: THREE.Vector2[] = [];\n265\t  const dup = (x: number, y: number) => { pts.push(new THREE.Vector2(x, y), new THREE.Vector2(x, y)); };\n266\t  pts.push(new THREE.Vector2(1.03, w));\n267\t  dup(1.0, w);\n268\t  for (let i = 1; i < 12; i++) {\n269\t    const f = (i / 12) * Math.PI;\n270\t    pts.push(new THREE.Vector2(1 - height * Math.sin(f), yc + a * Math.cos(f)));\n271\t  }\n272\t  dup(1.0, yc - a);\n273\t  pts.push(new THREE.Vector2(1.0 - height * 0.04, yc - a - groove * 0.5));\n274\t  dup(1.0, yl + al);\n275\t  for (let i = 1; i < 7; i++) {\n276\t    const f = (i / 7) * Math.PI;\n277\t    pts.push(new THREE.Vector2(1 - lipHeight * Math.sin(f), yl + al * Math.cos(f)));\n278\t  }\n279\t  dup(1.0, -w);\n280\t  pts.push(new THREE.Vector2(1.03, -w));\n281\t  const g = new THREE.LatheGeometry(pts, segments);\n282\t  g.rotateX(Math.PI / 2); // lathe axis Y → tube axis Z\n283\t  return g;\n284\t}\n285\t\n286\texport type BandOpts = { height?: number; width?: number; lipHeight?: number; lipWidth?: number; groove?: number; segments?: number };\n287\t\n288\texport type RingOpts = { tube?: number; double?: boolean; inset?: number; extra?: number; collar?: { depth?: number; lip?: number; width?: number; segments?: number }; band?: BandOpts };\n289\t\n290\texport function bandGeometry(b: BandOpts): THREE.BufferGeometry {\n291\t  return roundBandGeometry(b.height, b.width, b.lipHeight, b.lipWidth, b.groove, b.segments);\n292\t}\n293\t\n294\t/** Instanced thick gold ring ribs placed perpendicular to the tube every `spacing` units. */\n295\texport function buildRings(\n296\t  path: TubePath,\n297\t  s0: number,\n298\t  s1: number,\n299\t  spacing: number,\n300\t  material: THREE.Material,\n301\t  opts: RingOpts = {},\n302\t): THREE.InstancedMesh {\n303\t  const list: number[] = [];\n304\t  for (let s = s0; s <= s1 + 1e-6; s += spacing) list.push(s);\n305\t  return buildRingsAt(path, list, material, opts, spacing);\n306\t}\n307\t\n308\t/** Same rings at an explicit list of path positions (e.g. one evenly spaced set per tunnel section). */\n309\texport function buildRingsAt(path: TubePath, list: number[], material: THREE.Material, opts: RingOpts = {}, spacing = 9): THREE.InstancedMesh {\n310\t  const tube = opts.tube ?? 0.075;\n311\t  const collar = opts.band ?? opts.collar;\n312\t  const geo = opts.band ? bandGeometry(opts.band) : opts.collar ? collarGeometry(opts.collar.depth, opts.collar.lip, opts.collar.width, opts.collar.segments) : new THREE.TorusGeometry(1, tube, 14, 72);\n313\t  const n = Math.max(1, list.length) * (opts.double ? 2 : 1);\n314\t  const mesh = new THREE.InstancedMesh(geo, material, n);\n315\t  const m = new THREE.Matrix4();\n316\t  const q = new THREE.Quaternion();\n317\t  const basis = new THREE.Matrix4();\n318\t  const c = new THREE.Vector3();\n319\t  let k = 0;\n320\t  for (const s of list) {\n321\t    for (let dbl = 0; dbl < (opts.double ? 2 : 1); dbl++) {\n322\t      const ss = s + dbl * spacing * 0.16;\n323\t      const f = path.frame(ss);\n324\t      const r = path.radius(ss) - (opts.inset ?? 0.05) + (opts.extra ?? 0);\n325\t      c.copy(f.pos).addScaledVector(f.up, path.radius(ss) - path.depth(ss));\n326\t      basis.makeBasis(f.right, f.up, f.tan);\n327\t      q.setFromRotationMatrix(basis);\n328\t      const sc = dbl ? r * 0.985 : r;\n329\t      // a collar keeps its axial width in world units; a torus scales uniformly\n330\t      m.compose(c, q, new THREE.Vector3(sc, sc, collar ? 1 : sc * (dbl ? 0.6 : 1)));\n331\t      mesh.setMatrixAt(k++, m);\n332\t    }\n333\t  }\n334\t  mesh.count = k;\n335\t  mesh.instanceMatrix.needsUpdate = true;\n336\t  mesh.frustumCulled = false;\n337\t  return mesh;\n338\t}\n339\t\n340\t/**\n341\t * Washer wall lids / nozzle hoods (ref 05): copper \"D\" hoods — a half disc with a tall polished rim band,\n342\t * a softly domed top and a recessed underside with an inner lip — sticking out of BOTH side walls a bit\n343\t * above eye level (≈2 and 10 o'clock seen from the rider), one symmetric pair per ring bay, so they\n344\t * shrink toward the vanishing point in two rows and the rider sees the bright rim band and the dish\n345\t * underneath. The straight edge of the D runs along the tube and is sunk into the wall; the hood droops\n346\t * toward the stream like a spray nozzle. `skip(s, centre)` drops a lid where the stream runs too close\n347\t * (06 arch climbs the wall). One instanced mesh (1 draw call).\n348\t */\n349\texport function buildWallLids(\n350\t  path: TubePath,\n351\t  s0: number,\n352\t  s1: number,\n353\t  spacing: number,\n354\t  material: THREE.Material,\n355\t  opts: {\n356\t    angleDeg?: number; droopDeg?: number; size?: number; thickness?: number; stretch?: number; sink?: number;\n357\t    skip?: (s: number, centre: THREE.Vector3, size: number) => boolean;\n358\t    /** explicit lid positions along the path (default: s0, s0 + spacing, … s1) */\n359\t    positions?: number[];\n360\t    /**\n361\t     * 'hood' (legacy 06/07 D-hood), 'dome' (half puck with a domed cap) or 'slab' (ref 05 wave 4: a flat\n362\t     * copper-gold half-disc lid standing out of the wall — flat underside, rounded edges, a straight\n363\t     * polished rim band and a flat top, like the ref's wall-mounted nozzle lids)\n364\t     */\n365\t    shape?: 'hood' | 'dome' | 'slab';\n366\t  } = {},\n367\t): THREE.InstancedMesh {\n368\t  const geo = wallLidGeometry(opts.shape ?? 'hood', opts.thickness ?? 0.42);\n369\t  const list: number[] = opts.positions ?? [];\n370\t  if (!opts.positions) for (let s = s0; s <= s1 + 1e-6; s += spacing) list.push(s);\n371\t  const n = Math.max(1, list.length) * 2;\n372\t  const mesh = new THREE.InstancedMesh(geo, material, n);\n373\t  const size = opts.size ?? 1.6;\n374\t  const ang = THREE.MathUtils.degToRad(opts.angleDeg ?? 18);\n375\t  const tilt = ang + THREE.MathUtils.degToRad(opts.droopDeg ?? 20);\n376\t  const c = new THREE.Vector3(), dir = new THREE.Vector3(), X = new THREE.Vector3(), Y = new THREE.Vector3(), Z = new THREE.Vector3();\n377\t  const basis = new THREE.Matrix4(), m = new THREE.Matrix4(), q = new THREE.Quaternion(), p = new THREE.Vector3();\n378\t  let k = 0;\n379\t  for (const s of list) {\n380\t    for (const side of [1, -1]) {\n381\t      const f = path.frame(s);\n382\t      const r = path.radius(s);\n383\t      tubeCenterAt(path, s, c);\n384\t      dir.copy(f.right).multiplyScalar(Math.cos(ang) * side).addScaledVector(f.up, Math.sin(ang)).normalize();\n385\t      const sz = size * Math.min(1.4, r / 7.6);\n386\t      // in the cross-section: +X points inward (radially, then drooped toward the stream), +Y is the\n387\t      // hood's top normal, +Z runs along the tube (the D's straight edge)\n388\t      X.copy(f.right).multiplyScalar(-Math.cos(tilt) * side).addScaledVector(f.up, -Math.sin(tilt)).normalize();\n389\t      Y.copy(f.right).multiplyScalar(-Math.sin(tilt) * side).addScaledVector(f.up, Math.cos(tilt)).normalize();\n390\t      Z.crossVectors(X, Y).normalize();\n391\t      basis.makeBasis(X, Y, Z);\n392\t      q.setFromRotationMatrix(basis);\n393\t      p.copy(c).addScaledVector(dir, r - sz * (opts.sink ?? 0.12));\n394\t      if (opts.skip?.(s, p.clone().addScaledVector(X, sz * 0.5), sz)) continue;\n395\t      m.compose(p, q, new THREE.Vector3(sz, sz, sz * (opts.stretch ?? 1.25)));\n396\t      mesh.setMatrixAt(k++, m);\n397\t    }\n398\t  }\n399\t  mesh.count = k;\n400\t  mesh.instanceMatrix.needsUpdate = true;\n401\t  mesh.frustumCulled = false;\n402\t  return mesh;\n403\t}\n404\t\n405\t/** Profile of a wall lid (lathe, half revolution toward local +X), centred on its thickness. */\n406\texport function wallLidGeometry(shape: 'hood' | 'dome' | 'slab', h: number, segments?: number): THREE.BufferGeometry {\n407\t  // bottom → top so the lathe normals face outward\n408\t  const prof: [number, number][] = shape === 'dome'\n409\t    ? [\n410\t      [0, 0.06], [0.62, 0.05], [0.7, 0.0], [0.86, -0.04], [1.04, -0.05], [1.08, 0.0], [1.0, 0.06],\n411\t      [0.98, h * 0.55], [0.96, h * 0.82], [0.88, h * 1.02], [0.72, h * 1.18], [0.48, h * 1.3], [0.24, h * 1.36], [0, h * 1.38],\n412\t    ]\n413\t    : shape === 'slab'\n414\t      ? [\n415\t        // flat underside with a shallow recess and an inner ring, rounded lower edge, straight rim band,\n416\t        // rounded upper edge, flat (very slightly crowned) top\n417\t        // (edge rounding scales with the thickness so thin pucks stay valid)\n418\t        [0, 0.15 * h], [0.55, 0.15 * h], [0.62, 0.0], [0.86, 0.0], [0.95, 0.12 * h], [0.995, 0.3 * h], [1.0, 0.42 * h],\n419\t        [1.0, 0.58 * h], [0.995, 0.7 * h], [0.95, 0.88 * h], [0.86, h], [0.45, h * 1.06], [0, h * 1.08],\n420\t      ]\n421\t      : [\n422\t        [0, 0.09], [0.74, 0.07], [0.82, 0.0], [0.9, -0.03], [0.97, -0.01], [1, 0.05], [1, h * 0.78], [0.95, h * 0.97], [0.82, h * 1.04], [0, h * 1.08],\n423\t      ];\n424\t  // half revolution (phi 0..π → local +X): the open cut face lies in the wall plane x = 0\n425\t  const geo = new THREE.LatheGeometry(prof.map(([x, y]) => new THREE.Vector2(x, y)), segments ?? (shape === 'hood' ? 28 : 24), 0, Math.PI);\n426\t  geo.translate(0, -h * 0.5, 0);\n427\t  return geo;\n428\t}\n429\t\n430\t/** Orientation of a wall lid in a tube cross-section (see buildWallLids): radial direction to the wall\n431\t *  point, inward X (drooped), top normal Y, Z along the tube. */\n432\texport function wallLidBasis(f: Frame, side: number, angDeg: number, droopDeg: number) {\n433\t  const ang = THREE.MathUtils.degToRad(angDeg);\n434\t  const tilt = ang + THREE.MathUtils.degToRad(droopDeg);\n435\t  const dir = f.right.clone().multiplyScalar(Math.cos(ang) * side).addScaledVector(f.up, Math.sin(ang)).normalize();\n436\t  const X = f.right.clone().multiplyScalar(-Math.cos(tilt) * side).addScaledVector(f.up, -Math.sin(tilt)).normalize();\n437\t  const Y = f.right.clone().multiplyScalar(-Math.sin(tilt) * side).addScaledVector(f.up, Math.cos(tilt)).normalize();\n438\t  const Z = new THREE.Vector3().crossVectors(X, Y).normalize();\n439\t  return { dir, X, Y, Z };\n440\t}\n441\t\n442\t/**\n443\t * Forced-perspective far section of the straight 05 tunnel (ref 05: ≈10 concentric rings converging on\n444\t * one small hot spot — far more tunnel than the 72-unit straight holds before the 06 hall). A short real\n445\t * funnel, calibrated for the locked 05 checkpoint camera `eye`, reproduces what a straight tunnel of the\n446\t * same radius running on for `zEnd` more units would look like from there: a virtual depth Z maps to the\n447\t * real depth z = Z / (1 + Z/L) and every cross-section is scaled by k(Z) = (D0 + z)/(D0 + Z) about the\n448\t * eye's line of sight, so walls, slots, rings and lids project where the long tunnel would put them.\n449\t * Normals stay those of the straight cylinder, so it shades like the real tube. A `fgExtra` attribute\n450\t * (Z − z) lets the distance glow use the virtual depth. Morph target 0 (\"open\") moves every vertex just\n451\t * outside the real tube wall at the same depth: the section opens like an iris as the rider arrives.\n452\t */\n453\texport class ForcedTunnel {\n454\t  readonly c0: THREE.Vector3;\n455\t  readonly T: THREE.Vector3;\n456\t  readonly U: THREE.Vector3;\n457\t  readonly Rt: THREE.Vector3;\n458\t  readonly R: number;\n459\t  readonly D0: number;\n460\t  /** eye offset from the section's centre line, in the cross-section plane */\n461\t  readonly q: THREE.Vector3;\n462\t  /**\n463\t   * `knots` ([u, Z] pairs, increasing, starting at [0, 0]): the virtual tunnel coordinate u (continues\n464\t   * the real s, so slot rows / ring bays repeat every bay in u) → virtual depth Z, piecewise linear. Ref 05\n465\t   * draws the far bays longer than the near ones (ring radii 288,192,122,85,66,54,45 px): one ring per\n466\t   * knot reproduces that while every bay keeps its slot rows and lid pair. Without knots Z = u.\n467\t   */\n468\t  constructor(readonly path: TubePath, readonly sF: number, eye: THREE.Vector3, readonly L: number, readonly zEnd: number, readonly knots: [number, number][] = [], axis?: THREE.Vector3) {\n469\t    const f = path.frame(sF);\n470\t    this.c0 = tubeCenterAt(path, sF);\n471\t    // `axis`: direction of the straight run the camera looks down (the path's tangent at sF may already\n472\t    // be easing toward the next stage's axis, which would put the far vanishing point off the real one)\n473\t    this.T = (axis ?? f.tan).clone().normalize();\n474\t    this.U = f.up.clone().addScaledVector(this.T, -f.up.dot(this.T)).normalize();\n475\t    this.Rt = new THREE.Vector3().crossVectors(this.T, this.U).normalize();\n476\t    this.R = path.radius(sF);\n477\t    const rel = this.c0.clone().sub(eye);\n478\t    this.D0 = rel.dot(this.T);\n479\t    this.q = rel.negate().addScaledVector(this.T, this.D0); // eye − c0 minus its axial part\n480\t  }\n481\t  private interp(x: number, a: 0 | 1) {\n482\t    const k = this.knots, b = (1 - a) as 0 | 1;\n483\t    if (k.length < 2) return x;\n484\t    for (let i = 1; i < k.length; i++) {\n485\t      if (x <= k[i][a] || i === k.length - 1) {\n486\t        const t = (x - k[i - 1][a]) / (k[i][a] - k[i - 1][a]);\n487\t        return k[i - 1][b] + t * (k[i][b] - k[i - 1][b]);\n488\t      }\n489\t    }\n490\t    return x;\n491\t  }\n492\t  /** virtual depth Z of tunnel coordinate u (see `knots`) */\n493\t  zOfU(u: number) { return this.interp(u, 0); }\n494\t  /** tunnel coordinate u of virtual depth Z */\n495\t  uOfZ(Z: number) { return this.interp(Z, 1); }\n496\t  /** 0 = forced perspective (closed), 1 = folded away outside the real tube: the rider camera within\n49