{"agentId": "aab010bb38c09ff18", "cwd": "/home/user/rainbow-/.claude/worktrees/agent-aab010bb38c09ff18", "entrypoint": "remote_mobile", "gitBranch": "ccr-61131b9d-uj0oqb", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * RAINBOW master course — ONE continuous route through the washer world.\n3\t *\n4\t * Units: 1 unit ≈ 5 cm at Benny's scale (Benny body radius ≈ 0.8). +Y is up (absolute altitude).\n5\t * The route starts inside Drum A (scene 01/02), drains through a chute into the whirlpool basin (03),\n6\t * drops down the five-arrow slide (04), winds through the perforated current tube (05), crests the\n7\t * rinse arch (06), winds through the washer tube and then PLUNGES ~62 units straight down (07) before\n8\t * the bottom of that same tube flares into the Final Spin Chamber inlet (08). 08–10 stay in that same\n9\t * chamber; the route ends under the purple towel on the platform, where the 11 cinematic plays.\n10\t *\n11\t * Every stage is a range of arc-length `s` on a single centripetal Catmull-Rom spline, so position\n12\t * and tangent are continuous by construction; `validateContinuity()` measures it anyway.\n13\t */\n14\timport * as THREE from 'three';\n15\t\n16\texport type StageId = '01' | '02' | '03' | '04' | '05' | '06' | '07' | '08' | '09' | '10' | '11';\n17\texport type TubeKind = 'none' | 'chute' | 'gold' | 'perf';\n18\texport type StageProp = 'width' | 'tube' | 'speed' | 'bank';\n19\t\n20\texport interface StageDef {\n21\t  id: StageId;\n22\t  title: string;\n23\t  /** arc-length range on the course */\n24\t  s0: number;\n25\t  s1: number;\n26\t  /** water ribbon width (units) */\n27\t  width: number;\n28\t  /** enclosing tube radius (0 = open environment such as a drum/basin/chamber) */\n29\t  tube: number;\n30\t  tubeKind: TubeKind;\n31\t  /** auto-propulsion speed (units / s) */\n32\t  speed: number;\n33\t  /** coin counter shown in the locked reference screenshot of this stage */\n34\t  refCoins: number;\n35\t  interactive: boolean;\n36\t  /** banking strength multiplier */\n37\t  bank: number;\n38\t}\n39\t\n40\texport interface CourseSample {\n41\t  s: number;\n42\t  pos: THREE.Vector3;\n43\t  tan: THREE.Vector3;\n44\t  up: THREE.Vector3;\n45\t  right: THREE.Vector3;\n46\t}\n47\t\n48\texport const STAGE_TITLES: Record<StageId, string> = {\n49\t  '01': 'INSIDE THE WASHING MACHINE',\n50\t  '02': 'WHIRLPOOL TUMBLE',\n51\t  '03': 'WHIRLPOOL TWIRL',\n52\t  '04': 'THROUGH THE FIVE ARROWS',\n53\t  '05': 'FLOW INTO THE CURRENT',\n54\t  '06': 'CREST THE RINSE ARCH',\n55\t  '07': 'DIVE THE WASHER TUBE',\n56\t  '08': 'FINAL SPIN CHAMBER',\n57\t  '09': 'RIDE THE FINAL WAVE',\n58\t  '10': 'SLIDE INTO HIDING',\n59\t  '11': 'SAFELY HOME',\n60\t};\n61\t\n62\t/** Fixed world anchors shared by environment builders (absolute coordinates). */\n63\texport const WORLD = {\n64\t  drumA: { center: new THREE.Vector3(0, 0, 0), radius: 5, zBack: -6.5, zDoor: 3.5, doorRadius: 3.2, waterY: -2.5 },\n65\t  basin: { center: new THREE.Vector3(2, -16, -19), rimRadius: 11.5, rimY: -10.6, drainRadius: 4.3, drainY: -20.2 },\n66\t  /** Final Spin Chamber (08–11): drum with axis along Z, door at the far (-Z) end */\n67\t  chamber: { center: new THREE.Vector3(12, -101.1, 0), radius: 13.5, zBack: -280, zDoor: -332, floorY: -113.6, doorRadius: 6.2 },\n68\t  platform: { center: new THREE.Vector3(12, -110.6, -325.0), radius: 6.2, topY: -110.6 },\n69\t  plunge: { topY: -52, bottomY: -113.6 },\n70\t};\n71\t\n72\t/** funnel surface height of the whirlpool basin as a function of radius from its axis */\n73\texport function funnelY(r: number): number {\n74\t  const b = WORLD.basin;\n75\t  const t = THREE.MathUtils.clamp((r - b.drainRadius * 0.6) / (b.rimRadius - b.drainRadius * 0.6), 0, 1);\n76\t  return b.drainY + (b.rimY - b.drainY) * Math.pow(t, 0.72);\n77\t}\n78\t\n79\tconst V = (x: number, y: number, z: number) => new THREE.Vector3(x, y, z);\n80\tconst smooth = (a: number, b: number, x: number) => {\n81\t  const t = THREE.MathUtils.clamp((x - a) / (b - a), 0, 1);\n82\t  return t * t * (3 - 2 * t);\n83\t};\n84\t\n85\t/**\n86\t * A stretch whose tunnel axis is an exact straight line a→b (the stream winds inside it). The\n87\t * course lies on the line at both ends of the stretch; tube.ts aligns the tunnel axis to it.\n88\t */\n89\texport interface StraightAxis {\n90\t  /** arc-length range of the stretch on the course */\n91\t  s0: number;\n92\t  s1: number;\n93\t  a: THREE.Vector3;\n94\t  b: THREE.Vector3;\n95\t  /** stream-to-tunnel-bottom depth on the line (water sits this high in the tube) */\n96\t  floorDepth: number;\n97\t}\n98\t\n99\tinterface RouteData {\n100\t  points: THREE.Vector3[];\n101\t  marks: Record<string, number>;\n102\t  straight: { from: string; to: string; a: THREE.Vector3; b: THREE.Vector3; floorDepth: number }[];\n103\t}\n104\t\n105\t/**\n106\t * 05 current (ref 05): the tunnel is a straight line; the STREAM winds inside it. The meander is the\n107\t * lateral (world +X) offset of the course centreline from that line, as a function of the distance\n108\t * `u` along the line (0 … L05). It is applied to the route AFTER smoothPolyline, so it is exact (the\n109\t * smoothing would shave ~25 % off the amplitude) and still C¹ at both ends (offset and slope → 0).\n110\t *\n111\t * Shape tuned against the reference's cyan core: a small first crest under Benny at the 05\n112\t * checkpoint (u≈uCrest, offset a0 to the LEFT, heading parallel to the tunnel axis), then crests\n113\t * that grow toward the far end (screen: Benny → (560,700) → (450,600) → (520,520) → VP).\n114\t * Coins (gameplay/coins.ts) sit on this centreline (lat 0), so they wind with the same S.\n115\t */\n116\texport const S05 = {\n117\t  /** length of the straight tunnel line (units) */\n118\t  L: 72,\n119\t  /** wavelength along the line (crest → crest of the same side) */\n120\t  lambda: 32,\n121\t  /** u of the first (left) crest, where Benny rides at the 05 checkpoint */\n122\t  uCrest: 14,\n123\t  /** crest amplitude at uCrest and at uCrest + 1.5 λ (linear growth in between) */\n124\t  a0: 0.45,\n125\t  a1: 1.85,\n126\t  /** half extent of the stream (|offset| + half width) in the current: fills the tube floor */\n127\t  extent: 6.0,\n128\t};\n129\t\n130\t/**\n131\t * 05 meander AHEAD of Benny's crest (u > uCrest): [u, offset] knots fitted to the APPROVED reference (wave 6\n132\t * camera lock, qa/pilot05/wave6/camera_lock/landmarks.json). The reference's coin trail was back-projected\n133\t * through the live locked 05 camera onto the river (coin height 1.2 u) and converted to offsets from the\n134\t * tunnel line; coins sit at (1 + latK·CORE_SWING) ≈ 1.62 × the course offset, so knot = coin offset / 1.62.\n135\t * Ref coins (px → u, coin offset): (474,726)→21.6,−0.31 · (548,661)→26.3,+0.60 · (482,612)→32.2,−0.37 ·\n136\t * (431,574)→43.0,−1.85 · (466,546)→55.5,−1.28 · (495,533)→67.0,−0.26. The previous sine (λ 32) put the right\n137\t * swing at u≈30–33 and +1.45 wide, so the 3rd coin sat ≈100 px right of the reference.\n138\t * Interpolation: C¹ cubic Hermite (non-uniform Catmull-Rom tangents), slope 0 at the crest and at L.\n139\t */\n140\tconst MEANDER05_KNOTS: [number, number][] = [[26.3, 0.37], [32.2, -0.23], [43, -1.14], [55.5, -0.79]];\n141\t\n142\t/** the original (wave 1–5) sine meander; kept verbatim up to U05_KEEP so the 04→05 join, the '05_crest'\n143\t *  checkpoint search window (u ≤ uCrest + λ/4) and therefore the LOCKED 05 camera are bit-identical */\n144\tfunction meander05Sine(u: number): number {\n145\t  const { L, lambda, uCrest, a0, a1 } = S05;\n146\t  const grow = THREE.MathUtils.clamp((u - uCrest) / (1.5 * lambda), 0, 1);\n147\t  const amp = (a0 + (a1 - a0) * grow) * smooth(0, 10, u) * (1 - smooth(L - 12, L, u));\n148\t  return -amp * Math.cos((2 * Math.PI * (u - uCrest)) / lambda);\n149\t}\n150\tconst U05_KEEP = S05.uCrest + S05.lambda / 4;\n151\t\n152\t/** C¹ cubic Hermite through knots (non-uniform Catmull-Rom tangents; end slopes given) */\n153\tfunction hermiteKnots(k: [number, number][], u: number, m0: number, mN = 0): number {\n154\t  const n = k.length;\n155\t  if (u >= k[n - 1][0]) return k[n - 1][1];\n156\t  let i = 0;\n157\t  while (u > k[i + 1][0]) i++;\n158\t  const tan = (j: number) => (j === 0 ? m0 : j === n - 1 ? mN : (k[j + 1][1] - k[j - 1][1]) / (k[j + 1][0] - k[j - 1][0]));\n159\t  const [u0, p0] = k[i], [u1, p1] = k[i + 1];\n160\t  const h = u1 - u0, t = (u - u0) / h, t2 = t * t, t3 = t2 * t;\n161\t  return (2 * t3 - 3 * t2 + 1) * p0 + (t3 - 2 * t2 + t) * h * tan(i) + (-2 * t3 + 3 * t2) * p1 + (t3 - t2) * h * tan(i + 1);\n162\t}\n163\t/** from U05_TAIL to the 06 join the ORIGINAL curve is used verbatim, so the 05→06 junction (and the 06 up-vector\n164\t *  smoothing, which looks ±12 samples back into 05) is bit-identical to the approved 06 */\n165\tconst U05_TAIL = 67;\n166\tconst slopeOf = (f: (u: number) => number, u: number) => (f(u + 1e-3) - f(u - 1e-3)) / 2e-3;\n167\tconst KNOTS05: [number, number][] = [[U05_KEEP, meander05Sine(U05_KEEP)], ...MEANDER05_KNOTS, [U05_TAIL, meander05Sine(U05_TAIL)]];\n168\tconst SLOPE05_KEEP = slopeOf(meander05Sine, U05_KEEP);\n169\tconst SLOPE05_TAIL = slopeOf(meander05Sine, U05_TAIL);\n170\t\n171\t/**\n172\t * 05 EXIT BEND (u 56–67, sin², C¹: zero value and slope at both ends): the original course swung right\n173\t * here before the 06 arch too (old sine +1.71 u at u 62). Its amplitude is solved (secant on Course.length)\n174\t * so the route keeps EXACTLY its old length 435.193. Why the length must stay: besides geometry, the water\n175\t * wave/flow phase, Benny's float bob, foam lumps and bubbles are keyed on absolute s, so a shorter 05\n176\t * (−0.78 u) shifted every later screen (06: Benny 0.034 lower, a ring grazing the frame bottom, different\n177\t * bubbles/foam). The 06/07 rings, lids and slot rows are additionally anchored to the 06 stage start\n178\t * (environment.ts STAGE ANCHORS) as a safety net.\n179\t */\n180\tconst EXIT05_BEND = { u0: 56, u1: U05_TAIL, amp: 1.353668 };\n181\t\n182\t/** lateral offset (units, + = world +X = rider's right when heading -Z) of the 05 stream from its tunnel line */\n183\texport function meander05(u: number): number {\n184\t  if (u <= 0 || u >= S05.L) return 0;\n185\t  if (u <= U05_KEEP || u >= U05_TAIL) return meander05Sine(u);\n186\t  const { u0, u1, amp } = EXIT05_BEND;\n187\t  const bend = u > u0 && u < u1 ? amp * Math.sin((Math.PI * (u - u0)) / (u1 - u0)) ** 2 : 0;\n188\t  return hermiteKnots(KNOTS05, u, SLOPE05_KEEP, SLOPE05_TAIL) + bend;\n189\t}\n190\t\n191\t/** Generates the dense control polyline of the route (absolute coordinates). */\n192\tfunction buildRoute(): RouteData {\n193\t  const pts: THREE.Vector3[] = [];\n194\t  const marks: Record<string, number> = {};\n195\t  const straight: RouteData['straight'] = [];\n196\t  const push = (p: THREE.Vector3) => {\n197\t    if (pts.length && p.distanceTo(pts[pts.length - 1]) < 0.25) return;\n198\t    pts.push(p);\n199\t  };\n200\t  const mark = (k: string) => (marks[k] = pts.length - 1);\n201\t  const seg = (n: number, f: (t: number) => THREE.Vector3, skipFirst = true) => {\n202\t    for (let i = skipFirst ? 1 : 0; i <= n; i++) push(f(i / n));\n203\t  };\n204\t\n205\t  // ---- 01: Benny hidden in the towel, drum A front-left floor (camera looks toward the door) ----\n206\t  const dA = WORLD.drumA;\n207\t  const hc = V(0, -0.4, 0); // swirl axis\n208\t  const th0 = Math.atan2(-2.0, 1.6);\n209\t  push(V(1.6, -2.4, -2.2));\n210\t  mark('01');\n211\t  // ---- 02: whirlpool tumble — helix around the drum axis toward the back drain ----\n212\t  const thEnd = -Math.PI / 2 - Math.PI * 2;\n213\t  seg(26, (t) => {\n214\t    const th = th0 + (thEnd - th0) * t;\n215\t    const r = 2.56 + (3.9 - 2.56) * smooth(0, 1, t);\n216\t    const z = -2.2 + (-5.4 + 2.2) * t;\n217\t    return V(hc.x + r * Math.cos(th), hc.y + r * Math.sin(th), z);\n218\t  });\n219\t  mark('02_drain');\n220\t  // chute from drum A back drain down into the whirlpool basin rim\n221\t  const b = WORLD.basin;\n222\t  const spiralStart = V(b.center.x - 9.6, funnelY(9.6) + 0.25, b.center.z);\n223\t  const c0 = pts[pts.length - 1].clone();\n224\t  const chuteCtrl = [c0, V(-0.6, -5.6, -7.6), V(-3.2, -7.8, -10.4), V(-6.6, -9.8, -14.2), spiralStart.clone().add(V(0, 0.15, 2.4))];\n225\t  const chute = new THREE.CatmullRomCurve3(chuteCtrl, false, 'centripetal');\n226\t  seg(14, (t) => chute.getPoint(t));\n227\t  push(spiralStart);\n228\t  mark('03');\n229\t  // ---- 03: whirlpool twirl — 3/4 inward turn down the funnel that dives into the drain CENTRE ----\n230\t  // decreasing angle from the -X side (θ=-π/2) round the far and right sides to the near (+Z) side;\n231\t  // r shrinks as (1-t)^1.6 so the last stretch heads radially inward = straight -Z into the drain hole.\n232\t  seg(60, (t) => {\n233\t    const th = -Math.PI / 2 - Math.PI * 1.5 * (1 - (1 - t) * (1 - t)); // angle eases out → radial finish\n234\t    const r = 9.6 * Math.pow(1 - t, 0.9);\n235\t    return V(b.center.x + r * Math.sin(th), funnelY(r) + 0.25, b.center.z + r * Math.cos(th));\n236\t  });\n237\t  mark('04');\n238\t  // ---- 04: five-arrow slide — steep straight drop (≈32°) inside the gold ring pipe ----\n239\t  const s4 = pts[pts.length - 1].clone();\n240\t  const pitch4 = THREE.MathUtils.degToRad(32);\n241\t  const d4 = V(0, -Math.sin(pitch4), -Math.cos(pitch4));\n242\t  // pull-down arc from the drain lip into the steep slide pitch\n243\t  const R4a = 9;\n244\t  seg(7, (t) => {\n245\t    const a = pitch4 * t;\n246\t    return s4.clone().add(V(0, -R4a * (1 - Math.cos(a)), -R4a * Math.sin(a)));\n247\t  });\n248\t  const s4b = pts[pts.length - 1].clone();\n249\t  seg(16, (t) => s4b.clone().addScaledVector(d4, 34 * t));\n250\t  // pull out of the slide into the horizontal current\n251\t  const s4c = pts[pts.length - 1].clone();\n252\t  const R4 = 12;\n253\t  seg(8, (t) => {\n254\t    const a = -pitch4 + pitch4 * t;\n255\t    return s4c.clone().add(V(0, R4 * (Math.cos(-pitch4) - Math.cos(a)), R4 * (Math.sin(-pitch4) - Math.sin(a))));\n256\t  });\n257\t  mark('05');\n258\t  // ---- 05: long STRAIGHT perforated current tube (ref 05: concentric rings, ONE vanishing point);\n259\t  // the wide stream winds in S-curves inside it. Here only the straight line s5 → s5+L05 (slight\n260\t  // descent) is laid; the lateral S-offset meander05(u) is added after smoothing (see the end of\n261\t  // buildRoute). Offset and slope vanish at both ends, so 04 and 06 join tangentially and s6 (hence\n262\t  // 06/07/plunge/08) is unchanged. tube.ts builds the 05 tunnel on the line.\n263\t  const s5 = pts[pts.length - 1].clone();\n264\t  const L05 = V(0, -3, -S05.L);\n265\t  // 48 points (1.5-unit spacing) as before: the junction smoothing, hence the 04/05 and 05/06 stage\n266\t  // boundaries and the 06 checkpoint, stay exactly where they were\n267\t  seg(48, (t) => s5.clone().addScaledVector(L05, t));\n268\t  straight.push({ from: '05', to: '06', a: s5.clone(), b: s5.clone().add(L05), floorDepth: 3.3 });\n269\t  mark('06');\n270\t  // ---- 06: rinse arch — rises ~12 units, crests, curls down and to the right into the 07 tube ----\n271\t  const s6 = pts[pts.length - 1].clone();\n272\t  seg(34, (t) =>\n273\t    V(\n274\t      s6.x - 4 * Math.sin(Math.PI * t) + (WORLD.chamber.center.x - s6.x) * smooth(0.4, 1, t),\n275\t      s6.y + 12.5 * Math.pow(Math.sin(Math.PI * Math.min(t / 0.82, 1)), 1.15) - 4.5 * smooth(0.5, 1, t),\n276\t      s6.z - 46 * t,\n277\t    ),\n278\t  );\n279\t  mark('07');\n280\t  // ---- 07: winding washer tube (the visible stretch) ----\n281\t  const s7 = pts[pts.length - 1].clone();\n282\t  seg(32, (t) =>\n283\t    V(s7.x + 3.2 * Math.sin(3 * Math.PI * t) * Math.sin(Math.PI * t), s7.y + (WORLD.plunge.topY - s7.y) * t, s7.z - 60 * t),\n284\t  );\n285\t  mark('07_plunge_top');\n286\t  // ---- 07: THE DEEP PLUNGE — pull-down arc, long -70° straight, pull-up arc into the 08 inlet ----\n287\t  const p0 = pts[pts.length - 1].clone();\n288\t  const R = 14;\n289\t  const amax = THREE.MathUtils.degToRad(70);\n290\t  seg(12, (t) => {\n291\t    const a = amax * t;\n292\t    return p0.clone().add(V(0, -R * (1 - Math.cos(a)), -R * Math.sin(a)));\n293\t  });\n294\t  const p1 = pts[pts.length - 1].clone();\n295\t  const dPl = V(0, -Math.sin(amax), -Math.cos(amax));\n296\t  // straight length chosen so the bottom lands exactly on the chamber floor altitude\n297\t  const drop = p0.y - WORLD.plunge.bottomY;\n298\t  const Lstraight = (drop - 2 * R * (1 - Math.cos(amax))) / Math.sin(amax);\n299\t  seg(Math.ceil(Lstraight / 2), (t) => p1.clone().addScaledVector(dPl, Lstraight * t));\n300\t  mark('07_plunge_mid_end');\n301\t  const p2 = pts[pts.length - 1].clone();\n302\t  seg(12, (t) => {\n303\t    const a = -amax + amax * t;\n304\t    return p2.clone().add(V(0, R * (Math.cos(-amax) - Math.cos(a)), R * (Math.sin(-amax) - Math.sin(a))));\n305\t  });\n306\t  mark('07_plunge_bottom');\n307\t  const p3 = pts[pts.length - 1].clone();\n308\t  const zIn = WORLD.chamber.zBack;\n309\t  seg(4, (t) => V(p3.x, p3.y, p3.z + (zIn - p3.z) * t));\n310\t  mark('08');\n311\t  // ---- 08–10: Final Spin Chamber — winding stream toward the platform & towel ----\n312\t  const s8 = pts[pts.length - 1].clone();\n313\t  const plat = WORLD.platform;\n314\t  seg(14, (t) => V(s8.x + 3.6 * Math.sin(2 * Math.PI * t) * Math.sin(Math.PI * t), s8.y, s8.z - 15 * t));\n315\t  mark('09');\n316\t  const s9 = pts[pts.length - 1].clone();\n317\t  seg(14, (t) => V(s9.x - 3.2 * Math.sin(Math.PI * t), s9.y + 0.1 * t, s9.z - 15 * t));\n318\t  mark('10');\n319\t  const s10 = pts[pts.length - 1].clone();\n320\t  const end = V(plat.center.x, plat.topY + 0.45, plat.center.z + 0.6);\n321\t  seg(10, (t) =>\n322\t    V(s10.x + (end.x - s10.x) * t, s10.y + (end.y - s10.y) * smooth(0.3, 1, t), s10.z + (end.z - s10.z) * t),\n323\t  );\n324\t  mark('11');\n325\t  smoothPolyline(pts, marks['03'], 2.2, 3);\n326\t  // 05 meander: exact latera