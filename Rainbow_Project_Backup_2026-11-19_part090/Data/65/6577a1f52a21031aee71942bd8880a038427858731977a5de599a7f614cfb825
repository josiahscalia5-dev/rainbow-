"""Commit only the explicit experiment sources on the active isolated branch."""
import hashlib, json, shutil, subprocess, sys
from pathlib import Path
root = Path(sys.argv[1])
mode = sys.argv[2]
spec=json.loads((root/'baseline.json').read_text())
game,repo=root/'games/06',root/'repo'
def git(*args):
    return subprocess.check_output(['git','-C',str(repo),*args]).decode().strip()
paths=([
    'src/world/match06.ts','src/world/archedPassage06.ts','assets/arched-passage06',
    'tools/blender/arched-passage06'
] if mode=='scenery' else [
    'src/game/Game.ts','src/characters/benny/referencePink06.ts','src/characters/benny/coat06.ts',
    'src/characters/benny/fur.ts','tools/benny-reference-pink',
    *['assets/textures/match06/benny-reference-'+kind+'.png' for kind in ['pink','pom','stitches','cuff']]
])
parent=spec.get('parent',spec['retained'])['commit']
assert git('branch','--show-current')==spec['branch'] and git('rev-parse','HEAD')==parent
files=[]
for name in paths:
    src=game/name
    for file in (sorted(src.rglob('*')) if src.is_dir() else [src]):
        if not file.is_file():continue
        path=file.relative_to(game).as_posix()
        assert '__pycache__' not in path
        dest=repo/path;dest.parent.mkdir(parents=True,exist_ok=True)
        shutil.copyfile(file,dest);files.append(path)
git('add','--',*files)
assert set(git('diff','--cached','--name-only').splitlines())==set(files)
message='Fit the bent Screen 06 washer, profiled gold rings and rolled water banks' if mode=='scenery' else 'Fit Benny’s pink coat, knitted star beanie and pom to the approved Screen 06 portrait'
git('commit','--quiet','-m',message)
spec.update(commit=git('rev-parse','HEAD'),sourcePaths=files)
(root/'source.json').write_text(json.dumps(spec,indent=2)+'\n')
print(spec['branch'],spec['commit'],len(files),'explicit source files')
