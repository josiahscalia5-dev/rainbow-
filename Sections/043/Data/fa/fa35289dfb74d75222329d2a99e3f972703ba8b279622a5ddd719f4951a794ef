n (ref 05: ±60–120 px). Bounded by CORE_SWING · max|offset05| (≈0.9 · 1.85 = 1.7 u at the\n66\t * far crest; ≤1.25 u within 35 u of the 05 checkpoint), inside the ≥2 u core half width, so a coin on\n67\t * the route centre (lat 0) still sits on cyan. 0 outside 05.\n68\t * gameplay/coins.ts may place the 05 coins at this lateral to put them exactly on the core centre.\n69\t */\n70\texport const CORE_SWING = 0.9;\n71\texport function coreLateral(course: Course, s: number): number {\n72\t  const st = course.stage('05');\n73\t  if (s <= st.s0 || s >= st.s1) return 0;\n74\t  return CORE_SWING * course.offset05(s) * course.sample(s).right.x;\n75\t}\n76\t\n77\t/** the ribbon shader's 05 band S (`sbend` in FRAG), CPU copy */\n78\texport const sbend05 = (s: number) => 1.05 * Math.sin(s * 0.31 - 0.834) + 0.18 * Math.sin(s * 0.62 + 0.6);\n79\t\n80\t/**\n81\t * W10 (?water05=1 only, else exactly 0): extra lateral shift (ribbon units) of the 05 core + band pair near the exit\n82\t * bend just before the far-block seam. The route jogs ≈1.7 u right there (s 174–181), which drew the visible cyan\n83\t * core 478 → 547 px across only 18 screen rows (y 587 → 569) — the right-hand \"blob\" at the vanishing point. The\n84\t * approved river keeps climbing smoothly up-right there, so the VISIBLE core (route + core swing + band S) is held at\n85\t * T(s) relative to the tunnel line (−0.67 u at s 172 → −0.3 u at the seam), then hands back to the normal layout by\n86\t * s 189 (hidden behind the far block at the checkpoint; 06 unchanged). Coins (gameplay/coins.ts) are NOT moved: the\n87\t * s 173.6 coin stays on the cyan core, the s 181.6 one lies over the far block.\n88\t */\n89\texport function coreShiftW10(course: Course, s: number): number {\n90\t  if (!WATER05) return 0;\n91\t  const w = smooth(171, 175, s) * (1 - smooth(182, 189, s));\n92\t  if (w <= 0) return 0;\n93\t  const rx = Math.max(0.5, course.sample(s).right.x);\n94\t  const visible = course.offset05(s) + (coreLateral(course