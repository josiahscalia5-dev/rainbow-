from html.parser import HTMLParser
from pathlib import Path
from zipfile import ZipFile
import hashlib,json
from PIL import Image
from publish import OUTPUT,TITLES
class Links(HTMLParser):
 def __init__(self):super().__init__();self.refs=[]
 def handle_starttag(self,tag,attrs):
  for k,val in attrs:
   if k in ('href','src','poster'):self.refs.append(val)
count=0
for file in sorted(OUTPUT.rglob('*.html')):
 parser=Links();parser.feed(file.read_text())
 for ref in parser.refs:
  if ref.startswith('https://'):continue
  assert (file.parent/ref).is_file(),(file.name,ref);count+=1
for sid in TITLES:
 folder=OUTPUT/('Screen-'+sid);z=OUTPUT/('Screen-'+sid+'.zip')
 with ZipFile(z) as archive:
  assert archive.testzip() is None,z
  for rel in ['APPROVED.jpg','BEFORE/opening.png','NEW/opening.png','BEFORE/ride.mp4','NEW/ride.mp4','index.html','REPORT.md']:
   assert hashlib.sha256(archive.read(folder.name+'/'+rel)).digest()==hashlib.sha256((folder/rel).read_bytes()).digest()
 for rel in ['APPROVED.jpg','BEFORE/opening.png','NEW/opening.png']:
  with Image.open(folder/rel) as im:assert im.size==(864,1536)
print('Verified',count,'relative review links, five complete ZIPs and fifteen full-size opening images')
