from pathlib import Path
import datetime,hashlib,json,os,signal,subprocess,time
from zipfile import ZipFile
from guides import CURRENT,HEAD,IDS,OUT,ROOT,GITHUB,REFS,load
from verify_archives import audit
def equal_sha(path,want):
    with path.open('rb') as fh: actual=hashlib.file_digest(fh,'sha256').hexdigest()
    assert actual==want,(path,actual,want)
def run(task):
    subprocess.run(task,check=True)
def wait_files(names):
    while not all((ROOT/n).is_file() for n in names):
        if (ROOT/'hd-validation.log').exists() and 'Traceback' in (ROOT/'hd-validation.log').read_text():raise RuntimeError('HD verification needs inspection')
        time.sleep(4)
wait_files(['hd-checked-'+s+'.json' for s in IDS]+['checked-images.json','original-h264-decoded.json'])
run(['python3','package_media.py','videos'])
run(['python3','verify_archives.py','videos'])
# The final image master gained matching JPEG settings and native diagnostic crops after the source parts were built.
checks=load(ROOT/'checked-images.json')
image_info=load(ROOT/'image-package.json')
if checks[0]['sha256']!=image_info['sha256']:
    checks[0]=audit(OUT/'Rainbow_Visual_Images.zip','master-images')
    (ROOT/'checked-images.json').write_text(json.dumps(checks,indent=2)+'\n')
assert checks[0]['sha256']==image_info['sha256']
for c in checks+load(ROOT/'checked-videos.json'):equal_sha(OUT/c['file'],c['sha256'])
run(['python3','mobile_fallback.py'])
# A final read-only check against the live private repository and the protected reference manifest.
raw=subprocess.check_output(['git','ls-remote','--heads',GITHUB+'.git'],text=True)
live={name.removeprefix('refs/heads/'):sha for sha,name in (line.split() for line in raw.splitlines())}
names=[x['branch'] for x in REFS['protectedBranches'].values()]+[REFS['codexBranches'][sid]['branch'] for sid in IDS]+[k for k in HEAD if k.startswith('codex/screen05') or k=='codex/s07-magenta-bank-shape']
receipts={n:{'atPackagingStart':HEAD[n],'atPackagingEnd':live.get(n)} for n in names}
assert all(x['atPackagingStart']==x['atPackagingEnd'] for x in receipts.values())
g=['git','-C',str(ROOT/'history.git')]
lead=REFS['protectedBranches']['lead']['branch']
man=subprocess.check_output(g+['show',HEAD[lead]+':scripts/reference.sha256'],text=True)
hashes={path.lstrip('*'):h for h,path in (line.split(maxsplit=1) for line in man.splitlines() if line.strip() and not line.lstrip().startswith('#'))}
refs={}
with ZipFile(OUT/'Rainbow_Visual_Images.zip') as z:
    for sid in IDS:
        src=load(CURRENT/('Screen-'+sid)/'provenance.json')['referencePath']
        assert hashlib.sha256(z.read('Screen_'+sid+'/SCREEN'+sid+'_APPROVED.jpg')).hexdigest()==hashes[src]
        refs[src]=hashes[src]
    src='references/water/05_water_isolated_original.png'
    assert hashlib.sha256(z.read('Screen_05/SCREEN05_APPROVED_WATER_DETAIL.png')).hexdigest()==hashes[src];refs[src]=hashes[src]
for sid in (*IDS,'skill'):
    altered=subprocess.check_output(['git','-C','/tmp/rainbow-reconstruction.etSm9SmK/repos/'+sid,'status','--porcelain','--untracked-files=no'],text=True,env={**os.environ,'GIT_OPTIONAL_LOCKS':'0'})
    assert not altered,sid
all_hd=sum([load(ROOT/('hd-checked-'+s+'.json')) for s in IDS],[])
verification={'verifiedUTC':datetime.datetime.now(datetime.timezone.utc).isoformat(),'liveBranches':receipts,'originalArtworkHashes':refs,'images':image_info,'videos':load(ROOT/'video-package.json'),
              'archiveChecks':checks+load(ROOT/'checked-videos.json'),'currentMatchedViews':70,'highDetailRideFramesChecked':sum(int(r['nb_frames']) for r in all_hd),
              'earlierFullRecordingsDecoded':len(load(ROOT/'original-h264-decoded.json')),'physicalAndroidPerformance':'Unmeasured. This is an evidence package.'}
(OUT/'PACKAGE_VERIFICATION.json').write_text(json.dumps(verification,indent=2)+'\n')
print('Final master ZIPs verified',image_info['bytes'],verification['videos']['bytes'],'bytes. Protected and evidence refs',len(receipts),'HD frames',verification['highDetailRideFramesChecked'],flush=True)
