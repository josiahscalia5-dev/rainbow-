import asyncio,json,os,pathlib,socket,subprocess,sys,time
from mcp import ClientSession,StdioServerParameters
from mcp.client.stdio import stdio_client
root=pathlib.Path.cwd()
source=root/'bridge-source'
assert subprocess.check_output(['git','-C',str(source),'rev-parse','HEAD'],text=True).strip()=='2cea8d566dde07fbac28a61d698909d69724e853'
port=17573
host='127.0.0.1'
base={'PATH':os.environ['PATH'],'LANG':'C.UTF-8','BLENDER_MCP_HOST':host,'BLENDER_MCP_PORT':str(port),'XDG_CONFIG_HOME':str(root/'bridge-config'),'XDG_CACHE_HOME':str(root/'bridge-cache'),'PYTHONDONTWRITEBYTECODE':'1','PULSE_SERVER':'127.0.0.1:1','SDL_AUDIODRIVER':'dummy'}
code="import sys; sys.path.insert(0, "+repr(str(source/'addon'))+"); from blender_mcp_addon.cli import cli_execute; cli_execute(['--host','"+host+"','--port','"+str(port)+"'])"
blender_cmd=[str(root/'blender-test/blender-5.3.0-linux-x64/blender'),'-b','-noaudio','--factory-startup','--disable-autoexec','--python-exit-code','1','--python',str(root/'screen07-readonly.py'),'--python-expr',code]
async def main():
 log=(root/'bridge-scratch.log').open('w')
 proc=subprocess.Popen(blender_cmd,stdout=log,stderr=log,env=base,cwd=root)
 try:
  for _ in range(100):
   if proc.poll() is not None:raise RuntimeError('Background Blender exited during startup')
   try:
    with socket.create_connection((host,port),timeout=.15):break
   except OSError:await asyncio.sleep(.12)
  else:raise TimeoutError('Background socket did not open')
  env={**base,'PYTHONPATH':os.pathsep.join([str(source/'mcp'),str(root/'bridge-docutils.whl')])}
  par=StdioServerParameters(command=sys.executable,args=['-m','blmcp'],env=env,cwd=root)
  with (root/'bridge-client.log').open('w') as clog:
   async with stdio_client(par,errlog=clog) as (reader,writer):
    async with ClientSession(reader,writer) as sess:
     info=await sess.initialize(); listing=await sess.list_tools()
     names=[x.name for x in listing.tools]
     assert 'execute_blender_code' in names
     statement="import bpy\nresult = {'blender_version': bpy.app.version_string, 'camera': bpy.context.scene.camera.name, 'images': {im.name: list(im.size) for im in bpy.data.images if im.name in {'07_dive_the_washer_tube.png', 'plate07_hybrid.png', 'tile_river_clean.png', 'tile_wall_ring.png'}}}"
     res=await sess.call_tool('execute_blender_code',{'code':statement})
     data={'official_tag':'v1.0.3','protocol':info.protocolVersion,'tool_listed':True,'is_error':res.isError,'contents':[json.loads(x.text) if x.type=='text' else x.type for x in res.content]}
     print(json.dumps(data),flush=True)
     assert not res.isError and 'Saved Screen 07 camera' in json.dumps(data) and 'tile_river_clean.png' in json.dumps(data)
     (root/'screen07-bridge-report.json').write_text(json.dumps(data,indent=2))
 finally:
  if proc.poll() is None:
   proc.terminate()
   try:proc.wait(timeout=3)
   except subprocess.TimeoutExpired:proc.kill();proc.wait()
  log.close()
asyncio.run(asyncio.wait_for(main(),35))
