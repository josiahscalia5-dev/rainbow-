TIVE[id] ?? [864, 1536];\n    const page = await browser.newPage({ viewport: { width: w, height: h }, deviceScaleFactor: 1 });\n    page.on('console', (m) => { if (m.type() === 'error') log.errors.push(`[${id}] ${m.text()}`); });\n    page.on('pageerror', (e) => log.errors.push(`[${id}] pageerror ${e.message}`));\n    await page.goto(`${vite.url}/?qa=1&dpr=1${typeof opt.q === \"string\" ? \"&\" + opt.q : \"\"}`);\n    await page.waitForFunction(() => window.__rainbow?.ready === true || window.__error, null, { timeout: 240000 });\n    const err = await page.evaluate(() => window.__error);\n    if (err) throw new Error(err);\n    if (!log.renderer) log.renderer = await page.evaluate(() => { const g = document.querySelector('canvas').getContext('webgl2'); const d = g?.getExtension('WEBGL_debug_renderer_info'); return d ? g.getParameter(d.UNMASKED_RENDERER_WEBGL) : 'unknown'; });\n    const st = await page.evaluate((cid) => window.__rainbow.goto(cid), id);\n    // let a few frames render (fonts, bloom) — time is frozen so the image is deterministic\n    await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => r())));\n    await page.evaluate(() => document.fonts.ready);\n    await page.waitForTimeout(250);\n    const name = /^\\d\\d$/.test(id) ? `${id}.png` : `${id}.png`;\n    await page.screenshot({ path: `${outDir}/${name}`, timeout: 180000 });\n    const stats = await page.evaluate(() => window.__rainbow.stats());\n    // The first frame after load also counts one-time GPU work (three converts each cube env map to PMREM on\n    // first use). Render once more (after the screenshot) and report that per-frame cost as calls/tris.\n    const firstFrame = { calls: stats.calls, triangles: stats.triangles };\n    await page.evaluate(() => window.__rainbow.drawList?.());\n    const steady = await page.evaluate(() => window.__rainbow.stats());\n    Object.assign(stats, { calls: steady.calls, triangles: steady.triangles, firstFrameCalls: firstFrame.calls, firstFrameTriangles: firstFrame.triangles });\n    const state = await page.evaluate(() => window.__rainbow.state());\n    log.shots.push({ id, file: `${outDir}/${name}`, size: [w, h], checkpoint: st, state, stats });\n    console.log(id, '→', `${outDir}/${name}`, JSON.stringify({ stage: state.stage, s: state.s, y: state.bennyY, calls: stats.calls, tris: stats.triangles, modules: stats.modules }));\n    await page.close();\n  }\n} finally {\n  writeFileSync(opt.plunge ? 'qa/continuity/capture_log.json' : `qa/capture_log${size ? '_' + size.join('x') : ''}.json`, JSON.stringify(log, null, 2));\n  await browser.close();\n  await vite.close();\n}\nif (log.errors.length) console.error('console errors:', log.errors.slice(0, 10));\n// Resolve the Playwright that is pre-installed in this environment (global node_modules),\n// falling back to a local install. Chromium launch flags give WebGL2 via SwiftShader headless.\nimport { createRequire } from 'node:module';\nimport { execSync } from 'node:child_process';\nimport { join } from 'node:path';\n\nexport function loadPlaywright() {\n  try {\n    return createRequire(import.meta.url)('playwright');\n  } catch {\n    const root = execSync('npm root -g').toString().trim();\n    return createRequire(join(root, 'noop.js'))('playwright');\n  }\n}\n\nexport const CHROMIUM_ARGS = ['--use-angle=swiftshader', '--enable-unsafe-swiftshader', '--ignore-gpu-blocklist'];\n\n/**\n * Cross-process render slots (2026-11-16, full reference match): several specialists capture the game at the same time on\n * 4 shared cores with software WebGL; unlimited parallel captures time out and change timing-dependent HUD pixels. Every\n * script that starts the dev server waits here for one of RAINBOW_RENDER_SLOTS (default 2) slots and frees it on close /\n * exit. A slot whose owner process is gone is taken over; after 40 minutes of waiting the script runs anyway.\n */\nasync function acquireRenderSlot() {\n  const { mkdirSync, writeFileSync, readFileSync, rmSync } = await import('node:fs');\n  const slots = Math.max(1, Number(process.env.RAINBOW_RENDER_SLOTS ?? 2));\n  const t0 = Date.now();\n  const alive = (pid) => { try { process.kill(pid, 0); return true; } catch { return false; } };\n  for (;;) {\n    for (let i = 0; i < slots; i++) {\n      const dir = `/tmp/rainbow-render-slot-${i}`;\n      try {\n        mkdirSync(dir);\n        writeFileSync(`${dir}/pid`, String(process.pid));\n        const free = () => { try { rmSync(dir, { recursive: true, force: true }); } catch { /* */ } };\n        process.on('exit', free);\n        for (const sig of ['SIGINT', 'SIGTERM']) process.on(sig, () => { free(); process.exit(1); });\n        return free;\n      } catch {\n        let pid = NaN;\n        try { pid = Number(readFileSync(`${dir}/pid`, 'utf8')); } catch { /* being created */ }\n        if (Number.isFinite(pid) && !alive(pid)) { try { rmSync(dir, { recursive: true, force: true }); } catch { /* */ } }\n      }\n    }\n    if (Date.now() - t0 > 40 * 60 * 1000) return () => {};\n    await new Promise((r) => setTimeout(r, 1500));\n  }\n}\n\n/** start a Vite dev server for the project and return { url, close } */\nexport async function startVite(port = 5199) {\n  const free = await acquireRenderSlot();\n  const { createServer } = await import('vite');\n  const server = await createServer({ server: { port, strictPort: false, host: '127.0.0.1', hmr: false, watch: { ignored: ['**/*'] } }, logLevel: 'error' });\n  await server.listen();\n  const addr = server.resolvedUrls?.local?.[0] ?? `http://127.0.0.1:${port}/`;\n  return { url: addr.replace(/\\/$/, ''), close: async () => { try { await server.close(); } finally { free(); } } };\n}\n\nexport async function waitDone(page, timeoutMs = 180000) {\n  await page.waitForFunction(() => window.__done === true, null, { timeout: timeoutMs });\n  const err = await page.evaluate(() => window.__error);\n  if (err) throw new Error(err);\n}\n#!/usr/bin/env node\n// Screen 05 projection test — MOVING CAMERA (2026-11-16). Starts at the locked 05 checkpoint and rides forward with\n// the real game simulation (Benny + camera rig + course unchanged), capturing full-size frames.\n//   node scripts/proj05-move.mjs --q='proj05=1' --out=DIR [--d=0,1,2,4,8,16,30,50] [--clip=SECONDS --fps=24]\n// --d: distances ahead of the checkpoint (units of s) → DIR/move_<d>.png (shader clock frozen at 12: shows layout only)\n// --clip: a riding clip with the shader clock running (flow animation) → DIR/clip/0000.png … (encode with ffmpeg)\n// --still=SECONDS: water animation at the LOCKED camera (clock runs, camera still) → DIR/still/0000.png …\nimport { mkdirSync, writeFileSync } from 'node:fs';\nimport { loadPlaywright, CHROMIUM_ARGS, startVite } from './lib/pw.mjs';\nconst opt = Object.fromEntries(process.argv.slice(2).filter((a) => a.startsWith('--')).map((a) => { const [k, ...r] = a.slice(2).split('='); return [k, r.length ? r.join('=') : true]; }));\nconst Q = typeof opt.q === 'string' ? opt.q : '';\nconst OUT = typeof opt.out === 'string' ? opt.out : 'qa/pilot05/proj/move';\nconst D = typeof opt.d === 'string' ? opt.d.split(',').map(Number) : [];\nconst fps = Number(opt.fps ?? 24);\nmkdirSync(OUT, { recursive: true });\nconst { chromium } = loadPlaywright();\nconst vite = await startVite(5241);\nconst browser = await chromium.launch({ args: CHROMIUM_ARGS });\nconst log = { q: Q, frames: [] };\ntry {\n  const page = await browser.newPage({ viewport: { width: 864, height: 1536 }, deviceScaleFactor: 1 });\n  page.on('pageerror', (e) => console.error('pageerror', e.message));\n  await page.goto(`${vite.url}/?qa=1&dpr=1${Q ? '&' + Q : ''}`);\n  await page.waitForFunction(() => window.__rainbow?.ready === true || window.__error, null, { timeout: 240000 });\n  const shot = async (file, extra) => {\n    await page.evaluate(() => window.__rainbow.drawList());\n    await page.screenshot({ path: file });\n    const st = await page.evaluate(() => window.__rainbow.state());\n    log.frames.push({ file, ...extra, s: st.s, cam: st.cam, lat: st.lat });\n  };\n  if (D.length) {\n    await page.evaluate(() => window.__rainbow.goto('05'));\n    const s0 = (await page.evaluate(() => window.__rainbow.state())).s;\n    for (const d of D) {\n      // ride with the real simulation until s >= s0 + d (shader clock stays frozen: only the camera moves)\n      await page.evaluate(([target]) => { const R = window.__rainbow; let k = 0; while (R.state().s < target && k++ < 20000) R.step(1, 1 / 60); }, [s0 + d]);\n      await shot(`${OUT}/move_${String(d).padStart(2, '0')}.png`, { d });\n      console.log('move', d, JSON.stringify(log.frames.at(-1)));\n    }\n  }\n  if (opt.still) {\n    mkdirSync(`${OUT}/still`, { recursive: true });\n    const n = Math.round(Number(opt.still) * fps);\n    await page.evaluate(() => window.__rainbow.goto('05'));\n    for (let i = 0; i < n; i++) {\n      await page.evaluate(([t]) => { const R = window.__rainbow; R.freezeAt(t); R.step(1, 1e-4); }, [12 + i / fps]);\n      await shot(`${OUT}/still/${String(i).padStart(4, '0')}.png`, { t: 12 + i / fps });\n    }\n    console.log('still frames', n);\n  }\n  if (opt.steer) {\n    // Benny steers from the locked checkpoint: hold left / right, frames at 0.25 / 0.5 / 0.8 s (real simulation)\n    for (const dir of String(opt.steer).split(',').map(Number)) {\n      await page.evaluate(() => window.__rainbow.goto('05'));\n      let tPrev = 0;\n      for (const t of [0.25, 0.5, 0.8]) {\n        await page.evaluate(([dir, n]) => { const R = window.__rainbow; R.setSteer(dir); R.step(n, 1 / 60); }, [dir, Math.round((t - tPrev) * 60)]);\n        tPrev = t;\n        await shot(`${OUT}/steer_${dir < 0 ? 'L' : 'R'}_${String(Math.round(t * 100)).padStart(3, '0')}.png`, { steer: dir, t });\n        console.log('steer', dir, t, JSON.stringify(log.frames.at(-1).lat));\n{\n  \"name\": \"rainbow-washer-game\",\n  \"private\": true,\n  \"version\": \"0.1.0\",\n  \"description\": \"RAINBOW — 11-screen r