 2048\n22\tWROWS = [(\"AB\", 256), (\"BC\", 128), (\"CD\", 64), (\"DE\", 32), (\"EF\", 16), (\"FG\", 16), (\"GX\", 16), (\"N1\", 256), (\"N2\", 128)]\n23\tGUT = 8\n24\tRROWS = [\"A\", \"B\", \"C\", \"D\", \"E\", \"F\", \"G\", \"N\"]\n25\tRH = 48\n26\tMK = \"qa/pilot05/full_reference_match/masks\"\n27\t\n28\t# ---------------------------------------------------------------- base atlases (the previous bake, re-laid out)\n29\told = np.asarray(Image.open(f\"{OLD}/wall05.png\").convert(\"RGB\"), np.float32)\n30\tometa = json.load(open(f\"{OLD}/tunnel05.json\"))\n31\tatlas_h = sum(h for _, h in WROWS) + GUT * (len(WROWS) + 1)\n32\twall = np.zeros((atlas_h, TW, 3), np.float32)\n33\trows = {}\n34\ty0 = GUT\n35\tfor name, h in WROWS:\n36\t    src = ometa[\"wall\"][\"rows\"][\"AB\" if name in (\"N1\", \"N2\") else name]\n37\t    blk = old[src[\"y0\"]:src[\"y0\"] + src[\"h\"]]\n38\t    if blk.shape[0] != h:\n39\t        blk = np.asarray(Image.fromarray(np.clip(blk, 0, 255).astype(np.uint8)).resize((TW, h), Image.BICUBIC), np.float32)\n40\t    wall[y0:y0 + h] = blk\n41\t    wall[y0 - GUT:y0] = blk[0]; wall[y0 + h:y0 + h + GUT] = blk[-1]\n42\t    rows[name] = {\"y0\": y0, \"h\": h}\n43\t    y0 += h + GUT\n44\toring = np.asarray(Image.open(f\"{OLD}/ring05.png\").convert(\"RGB\"), np.float32)          # u = image angle, v radial out→in\n45\toring48 = np.asarray(Image.fromarray(np.clip(oring, 0, 255).astype(np.uint8)).resize((TW, RH), Image.BICUBIC), np.float32)\n46\tring = np.zeros((RH * len(RROWS), TW, 3), np.float32)\n47\tfor i, n in enumerate(RROWS):\n48\t    # real rings (A, B, N): object angle 0 = screen LEFT (basis −right) → half a turn from the image angle\n49\t    ring[i * RH:(i + 1) * RH] = np.roll(oring48, TW // 2, axis=1) if n in (\"A\", \"B\", \"N\") else oring48\n50\tbase_wall, base_ring = wall.copy(), ring.copy()\n51\t\n52\t\n53\tdef push_pull(val, wt, levels=9):\n54\t    \"\"\"fill zero-weight texels of val (h, w, c) from coarser levels (weighted pyramid), u periodic\"\"\"\n55\t    pyr = [(val * wt[..., None], wt)]\n56\t    for _ in range(levels):\n57\t        v, w = pyr[-1]\n58\t        if min(w.shape) < 4: break\n59\t        hh, ww = w.shape[0] // 2 * 2, w.shape[1] // 2 * 2\n60\t        v2 = v[:hh, :ww].reshape(hh // 2, 2, ww // 2, 2, -1).sum((1, 3)); w2 = w[:hh, :ww].reshape(hh // 2, 2, ww // 2, 2).sum((1, 3))\n61\t        pyr.append((v2, w2))\n62\t    v, w = pyr[-1]\n63\t    est = v / np.maximum(w, 1e-6)[..., None]\n64\t    for v, w in reversed(pyr[:-1]):\n65\t        up = np.repeat(np.repeat(est, 2, 0), 2, 1)\n66\t        up = np.pad(up, ((0, v.shape[0] - up.shape[0]), (0, v.shape[1] - up.shape[1]), (0, 0)), mode=\"edge\")\n67\t        a = np.clip(w, 0, 1)[..., None]\n68\t        est = a * (v / np.maximum(w, 1e-6)[..., None]) + (1 - a) * up\n69\t    return est\n70\t\n71\t\n72\tdef splat(tex_shape, U, V, col, wrap_u=True):\n73\t    \"\"\"bilinear splat of colours col (n, 3) at texture coords (U, V in 0..1) → acc (h, w, 3), wsum (h, w)\"\"\"\n74\t    h, w = tex_shape\n75\t    x = U * w - 0.5; y = V * h - 0.5\n76\t    x0 = np.floor(x).astype(int); y0 = np.floor(y).astype(int)\n77\t    fx = x - x0; fy = y - y0\n78\t    acc = np.zeros((h, w, 3)); ws = np.zeros((h, w))\n79\t    for dx, dy, wt in ((0, 0, (1 - fx) * (1 - fy)), (1, 0, fx * (1 - fy)), (0, 1, (1 - fx) * fy), (1, 1, fx * fy)):\n80\t        xx = (x0 + dx) % w if wrap_u else np.clip(x0 + dx, 0, w - 1)\n81\t        yy = np.clip(y0 + dy, 0, h - 1)\n82\t        np.add.at(ws, (yy, xx), wt)\n83\t        for c in range(3): np.add.at(acc[..., c], (yy, xx), wt * col[:, c])\n84\t    return acc, ws\n85\t\n86\t\n87\tdef load_coords(path):\n88\t    a = np.fromfile(path, np.float32).reshape(H, W, 4)\n89\t    wallm = np.abs(a[..., 3] - 77) < 1e-3; ringm = np.abs(a[..., 3] - 78) < 1e-3\n90\t    return a, wallm, ringm\n91\t\n92\t\n93\tap = np.asarray(Image.open(\"references/05_flow_into_the_current.png\").convert(\"RGB\"), np.float32)\n94\tidx = np.asarray(Image.open(f\"{MK}/region_index.png\"))\n95\trid = {k: v[\"id\"] for k, v in json.load(open(f\"{MK}/regions.json\"))[\"regions\"].items()}\n96\tsrc_wall = (idx == rid[\"purple_walls\"]) | (idx == rid[\"distant_tunnel_and_glow\"])\n97\tsrc_ring = (idx == rid[\"gold_rings_and_front_frame\"]) | (idx == rid[\"distant_tunnel_and_glow\"])\n98\tsrc_ring[1100:] = False                                           # the bottom gold frame is the camera-held near frame\n99\treport = {}\n100\t\n101\t\n102\tdef bake(tex, base, coordm, srcm, a, wrap_u=True):\n103\t    \"\"\"own texels = approved pixels; elsewhere base + the own-minus-base offset diffused with a falloff\"\"\"\n104\t    h, w = tex.shape[:2]\n105\t    m = coordm & srcm\n106\t    yy, xx = np.nonzero(m)\n107\t    acc, ws = splat((h, w), a[yy, xx, 0], a[yy, xx, 1], ap[yy, xx], wrap_u)\n108\t    own = ws > 0.2\n109\t    ownc = acc / np.maximum(ws, 1e-6)[..., None]\n110\t    # texels the camera sees between splat hits (minified areas): interpolate the own colours (push-pull) within the\n111\t    # visible footprint (all coord hits, incl. invalid approved pixels, dilated by 1)\n112\t    seen = binary_dilation(splat((h, w), a[coordm][:, 0], a[coordm][:, 1], np.zeros((coordm.sum(), 3)), wrap_u)[1] > 0, iterations=1)\n113\t    pp = push_pull(np.where(own[..., None], ownc, 0), own.astype(np.float64))\n114\t    near_own = distance_transform_edt(~own) <= 2.5\n115\t    fill_pp = seen & ~own & near_own\n116\t    res = base.copy()\n117\t    off = np.where(own[..., None], ownc - base, 0)\n118\t    offd = push_pull(off, own.astype(np.float64))\n119\t    dist = distance_transform_edt(~own)\n120\t    res = base + offd * np.exp(-dist / 10.0)[..., None]\n121\t    res[fill_pp] = pp[fill_pp]\n122\t    res[own] = ownc[own]\n123\t    return np.clip(res, 0, 255), own, seen\n124\t\n125\t\n126\tcoords = args.get(\"coords\")\n127\tif coords:\n128\t    a, wallm, ringm = load_coords(coords)\n129\t    wall, own_w, seen_w = bake(wall, base_wall, wallm, src_wall, a)\n130\t    ring, own_r, seen_r = bake(ring, base_ring, ringm, src_ring, a)\n131\t    report.update(wall_own_texels=int(own_w.sum()), wall_seen_texels=int(seen_w.sum()), ring_own_texels=int(own_r.sum()), ring_seen_texels=int(seen_r.sum()),\n132\t                  wall_pixels_used=int((wallm & src_wall).sum()), wall_pixels_seen=int(wallm.sum()), ring_pixels_used=int((ringm & src_ring).sum()), ring_pixels_seen=int(ringm.sum()))\n133\t\n134\t# ---------------------------------------------------------------- colour feedback (bloom spill etc.)\n135\tfb_path = os.path.join(out, \"feedback.npz\")\n136\tfb = dict(np.load(fb_path)) if os.path.exists(fb_path) and \"reset_feedback\" not in args else {\"wall\": np.zeros_like(wall), \"ring\": np.zeros_like(ring)}\n137\tif args.get(\"capture\") and args.get(\"coords_all\"):\n138\t    cap = np.asarray(Image.open(args[\"capture\"]).convert(\"RGB\"), np.float32)\n139\t    a2, wm2, rm2 = load_coords(args[\"coords_all\"])\n140\t    hud = idx == rid[\"hud_and_text\"]\n141\t    damp = float(args.get(\"damp\", 0.8))\n142\t    for key, m, srcm, tex in ((\"wall\", wm2, src_wall, wall), (\"ring\", rm2, src_ring, ring)):\n143\t        mm = m & srcm & ~hud\n144\t        yy, xx = np.nonzero(mm)\n145\t        r = ap[yy, xx] - cap[yy, xx]\n146\t        acc, ws = splat(tex.shape[:2], a2[yy, xx, 0], a2[yy, xx, 1], r)\n147\t        ok = ws > 0.2\n148\t        d = np.where(ok[..., None], acc / np.maximum(ws, 1e-6)[..., None], 0)\n149\t        # low-pass the residual (bloom is smooth; per-texel noise would add speckle)\n150\t        num = np.stack([gaussian_filter(d[..., c] * ok, 1.5, mode=(\"nearest\", \"wrap\")) for c in range(3)], -1)\n151\t        den = gaussian_filter(ok.astype(float), 1.5, mode=(\"nearest\", \"wrap\"))\n152\t        d = np.where((den > 0.05)[..., None], num / np.maximum(den, 1e-6)[..., None], 0)\n153\t        fb[key] = np.clip(fb[key] + damp * d, -90, 90)\n154\t        report[f\"feedback_{key}_mean_abs_residual\"] = round(float(np.abs(r).mean()), 2)\n155\t    np.savez_compressed(fb_path, **fb)\n156\tif \"wall\" in fb and fb[\"wall\"].shape == wall.shape: wall = np.clip(wall + fb[\"wall\"], 0, 255)\n157\tif \"ring\" in fb and fb[\"ring\"].shape == ring.shape: ring = np.clip(ring + fb[\"ring\"], 0, 255)\n158\t\n159\tImage.fromarray((wall + 0.5).astype(np.uint8)).save(os.path.join(out, \"wall05e.png\"), optimize=True)\n160\tImage.fromarray((ring + 0.5).astype(np.uint8)).save(os.path.join(out, \"ring05e.png\"), optimize=True)\n161\tmeta = {\"wall\": {\"w\": TW, \"h\": atlas_h, \"rows\": rows, \"gutter\": GUT}, \"ring\": {\"w\": TW, \"h\": RH * len(RROWS), \"rowH\": RH, \"rows\": RROWS},\n162\t        \"note\": \"env05 camera-projection bake (tools/env05/proj_bake.py); wall u = angle round the tube (+0.25), ring u = object angle, v = axial\"}\n163\tjson.dump(meta, open(os.path.join(out, \"env05.json\"), \"w\"), indent=1)\n164\tjson.dump(report, open(os.path.join(out, \"bake_report.json\"), \"w\"), indent=1)\n165\tprint(json.dumps(report))\n166\t", "tool_use_id": "toolu_015QvjfPGTi85vQXefK3vBuZ", "type": "tool_result"}], "role": "user"}, "parentUuid": "54f663ff-b42f-4bbe-94b5-7dcde1f2ed71", "permissionDecision": {"decision": "accept", "reasonType": "rule", "ruleSource": "cliArg", "source": "config"}, "promptId": "ac454479-370a-42c2-ab54-e334c92d8eef", "sessionId": "4504d324-f312-5957-a7e6-3580c7fc5f29", "sourceToolAssistantUUID": "54f663ff-b42f-4bbe-94b5-7dcde1f2ed71", "timestamp": "2026-11-17T01:16:26.161Z", "type": "user", "userType": "external", "uuid": "6b8d0a0c-a3f4-48e6-8344-a81fc946d13a", "version": "2.1.326"}
