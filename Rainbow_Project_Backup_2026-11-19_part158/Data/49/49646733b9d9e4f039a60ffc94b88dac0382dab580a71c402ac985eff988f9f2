 Rules\n* Other screens (01–04, 06–11) must not regress. Re-capture any screen your change can affect.\n* `npm run typecheck` must pass before you finish. `npm run test:continuity` must stay `ok` with verticalDrop ≈ 61.2 and gaps ≈ 0.\n* Capture: `node scripts/capture.mjs 05 --out=qa/pilot05/<you>`. Vite picks a free port, so parallel captures are safe.\n  If a capture fails because another specialist's file is mid-edit, wait ~30 s and retry. Do NOT touch their file.\n* Do not commit or push. The 5-minute autosave does that. Never touch `references/` or `character_references/`.\n* Finish with `qa/pilot05/<you>/NOTES.md`: what changed (file:function), the before/after numbers you measured, and what is left.\n/**\n * Route continuity + altitude test (run: npm run test:continuity).\n * Writes qa/continuity_report.json and docs/path_graph.md (altitude chart), exits 1 on failure.\n */\nimport { writeFileSync, mkdirSync } from 'node:fs';\nimport { Course, validateContinuity, WORLD } from '../src/world/course';\n\nconst c = new Course();\nconst r = validateContinuity(c);\nmkdirSync('qa', { recursive: true });\nmkdirSync('docs', { recursive: true });\nwriteFileSync('qa/continuity_report.json', JSON.stringify({ length: c.length, marks: c.marks, ...r }, null, 2));\n\n// altitude chart (ASCII) + per-stage table\nconst rows: string[] = [];\nrows.push('# Rainbow route graph — absolute altitudes & continuity');\nrows.push('');\nrows.push(`Generated by \\`npm run test:continuity\\`. Route length **${c.length.toFixed(1)} units** (1 unit ≈ 5 cm at Benny scale).`);\nrows.push('One centripetal Catmull-Rom spline from scene 01 to the towel at the end of 10; scene 11 is the');\nrows.push('victory cinematic at the route end. Result: **' + (r.ok ? 'PASS' : 'FAIL') + '**.');\nrows.push('');\nrows.push('| Stage | Title | s0 → s1 | length | altitude in → out | width | tube | speed |');\nrows.push('|---|---|---|---|---|---|---|---|');\nfor (const st of c.stages) {\n  const y0 = c.sample(st.s0).pos.y, y1 = c.sample(st.s1).pos.y;\n  rows.push(`| ${st.id} | ${st.title} | ${st.s0.toFixed(1)} → ${st.s1.toFixed(1)} | ${(st.s1 - st.s0).toFixed(1)} | ${y0.toFixed(1)} → ${y1.toFixed(1)} | ${st.width} | ${st.tube ? st.tubeKind + ' r=' + st.tube : 'open'} | ${st.speed} |`);\n}\nrows.push('');\nrows.push('## Boundary continuity (sampled ±0.02 units across each boundary)');\nrows.push('');\nrows.push('| From → To | s | position gap | tangent Δ° | up Δ° | altitude |');\nrows.push('|---|---|---|---|---|---|');\nfor (const b of r.boundaries) rows.push(`| ${b.from} → ${b.to} | ${b.s} | ${b.posGap} | ${b.tangentAngleDeg} | ${b.upAngleDeg} | ${b.altitude} |`);\nrows.push('');\nrows.push(`Max tangent change per 0.25-unit step: **${r.maxStepTangentDeg}°**; max position step: **${r.maxStepPos}** (no jumps).`);\nrows.push('');\nrows.push('## 07 → 08 deep plunge');\nrows.push('');\nconst p = r.plunge;\nrows.push(`* 07 entry altitude: **${p.entryAltitude07}**`);\nrows.push(`* plunge top (end of visible winding stretch): s=${p.plungeTop.s}, y=**${p.plungeTop.y}**`);\nrows.push(`* plunge middle: s=${p.plungeMid.s}, y=**${p.plungeMid.y}**`);\nrows.push(`* plunge bottom (pull-up complete): s=${p.plungeBottom.s}, y=**${p.plungeBottom.y}**`);\nrows.push(`* 08 inlet (chamber back wall z=${WORLD.chamber.zBack}): s=${p.inlet08.s}, y=**${p.inlet08.y}**`);\nrows.push(`* total vertical drop top→inlet: **${p.verticalDrop} units (≈${(p.verticalDrop * 0.05).toFixed(2)} m at Benny scale)**, steepest pitch ${p.minPitchDeg}°`);\nrows.push('');\nrows.push('## Altitude profile (y vs s)');\nrows.push('');\nrows.push('```');\nconst W = 72, H = 22;\nlet ymin = Infinity, ymax = -Infinity;\nfor (let s = 0; s <= c.length; s += 1) { const y = c.sample(s).pos.y; ymin = Math.min(ymin, y); ymax = Math.max(ymax, y); }\nconst grid = Array.from({ length: H }, () => Array(W).fill(' '));\nfor (let x = 0; x < W; x++) {\n  const s = (x / (W - 1)) * c.length;\n  const y = c.sample(s).pos.y;\n  const row = Math.round(((ymax - y) / (ymax - ymin)) * (H - 1));\n  grid[row][x] = '█';\n}\nfor (const st of c.stages) {\n  },\n  \"plungeMid\": {\n   \"s\": 349.77,\n   \"y\": -83.56\n  },\n  \"plungeBottom\": {\n   \"s\": 389.13,\n   \"y\": -113.49\n  },\n  \"inlet08\": {\n   \"s\": 389.22,\n   \"y\": -113.5\n  },\n  \"verticalDrop\": 61.19,\n  \"minPitchDeg\": -70\n },\n \"maxStepTangentDeg\": 6.241,\n \"boundaries\": [\n  \"01->02 gap=0 dT=0.249 y=-2.4\",\n  \"02->03 gap=-0.0001 dT=0.673 y=-11.87\",\n  \"03->04 gap=0 dT=0.932 y=-19.41\",\n  \"04->05 gap=0 dT=0.246 y=-40.63\",\n  \"05->06 gap=0 dT=0.281 y=-43.35\",\n  \"06->07 gap=0 dT=0.114 y=-48.53\",\n  \"07->08 gap=0 dT=0.339 y=-113.5\",\n  \"08->09 gap=0 dT=0.12 y=-113.59\",\n  \"09->10 gap=0 dT=0.08 y=-113.47\",\n  \"10->11 gap=0 dT=0.003 y=-110.16\"\n ]\n}", "is_error": false, "tool_use_id": "toolu_01T5NcqbuNgqqNSgtLpuNqKj", "type": "tool_result"}], "role": "user"}, "parentUuid": "957313dd-a7f7-4e13-ba16-e87420e36627", "permissionDecision": {"decision": "accept", "reasonType": "rule", "ruleSource": "cliArg", "source": "config"}, "promptId": "4ff2b1f3-ea47-407c-a3fb-eea465cffd0a", "sandboxed": false, "sessionId": "51775b34-51ba-5918-b385-cd11374f9ebd", "sourceToolAssistantUUID": "957313dd-a7f7-4e13-ba16-e87420e36627", "timestamp": "2026-11-15T19:53:56.765Z", "type": "user", "userType": "external", "uuid": "e5a9ec51-5661-4e0a-b1b3-3ab658e29cea", "version": "2.1.325"}
