from pathlib import Path
import json,shutil,os
p=Path(__file__).parent;dest=p/'payload';man=dest/'02_VERSIONS/Claudia_Lead/SOURCE_TREE.json';data=json.loads(man.read_text());count=0
for name,item in data['files'].items():
    target=dest/'01_GAME'/name;source=dest/item['file']
    if target!=source and not target.exists():
        target.parent.mkdir(parents=True,exist_ok=True)
        try:os.link(source,target)
        except OSError:shutil.copyfile(source,target)
        count+=1
    item['file']=target.relative_to(dest).as_posix()
man.write_text(json.dumps(data,separators=(',',':'),ensure_ascii=False)+'\n')
print('Additional source paths restored in runnable lead tree',count)
