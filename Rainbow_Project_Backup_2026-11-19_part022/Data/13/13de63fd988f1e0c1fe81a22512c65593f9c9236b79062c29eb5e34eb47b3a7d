_modules/.vite/deps/three.js');\n28\t    const walls = [], farWalls = [];\n29\t    scene.traverse((o) => {\n30\t      let k = '';\n31\t      try { k = o.material?.customProgramCacheKey?.() ?? ''; } catch { /* */ }\n32\t      if (o.isMesh && /strips-attribute-wall05v/.test(k)) farWalls.push(o);\n33\t      else if (o.isMesh && /strips-attribute-wall05/.test(k)) walls.push(o);\n34\t    });\n35\t    let onFar = 0;\n36\t    const rc = new THREE.Raycaster();\n37\t    const camP = new THREE.Vector3().setFromMatrixPosition(camera.matrixWorld);\n38\t    const nm = new THREE.Matrix3();\n39\t    const out = {};\n40\t    let miss = 0;\n41\t    for (const [name, L] of Object.entries(mesh2d.lids)) {\n42\t      const P = [], N = [], D = [];\n43\t      for (const [x, y] of L.verts_px) {\n44\t        rc.setFromCamera({ x: (x / 864) * 2 - 1, y: -((y / 1536) * 2 - 1) }, camera);\n45\t        // the real wall first; beyond its end (the deep parts of L2 / R2) the forced-perspective far wall\n46\t        let h = rc.intersectObjects(walls, false)[0];\n47\t        if (!h) { h = rc.intersectObjects(farWalls, false)[0]; if (h) onFar++; }\n48\t        if (!h) { miss++; P.push(null); N.push(null); D.push(rc.ray.direction.toArray()); continue; }\n49\t        nm.getNormalMatrix(h.object.matrixWorld);\n50\t        const n = h.face.normal.clone().applyMatrix3(nm).normalize();\n51\t        if (n.dot(rc.ray.direction) > 0) n.negate();              // toward the camera (into the tube)\n52\t        P.push(h.point.toArray()); N.push(n.toArray()); D.push(rc.ray.direction.toArray());\n53\t      }\n54\t      out[name] = { P, N, D };\n55\t    }\n56\t    return {\n57\t      walls: walls.length, farWalls: farWalls.length, onFar, miss,\n58\t      camera: { position: camP.toArray(), matrixWorld: camera.matrixWorld.toArray(), projection: camera.projectionMatrix.toArray(), fov: camera.fov, aspect: camera.aspect },\n59\t      lids: out,\n60\t    };\n61\t  }, mesh2d);\n62\t  writeFileSync(`${DIR}/raycast.json`, JS