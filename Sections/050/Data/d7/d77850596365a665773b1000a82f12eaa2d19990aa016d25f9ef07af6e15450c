from pathlib import Path
import os,subprocess,shutil,tarfile
root=Path(__file__).resolve().parent
p=Path('/tmp/rainbow-final-fidelity.RuUP0xJ2')
repo=p/'repos/06';base=p/'games/06';sample=root/'rainbow-build';sample.mkdir(exist_ok=True)
g=['git','-C',str(repo)]
files = subprocess.check_output(g+['ls-tree','-r','-z','HEAD','android','capacitor.config.ts']).split(b'\0')
items = []
for entry in filter(None, files):
    meta,path=entry.split(b'\t');mode,typ,sha=meta.decode().split()
    assert typ=='blob'
    items.append((mode,sha,path.decode()))
missing = [sha for mode,sha,path in items if subprocess.run(g[:1]+['--no-lazy-fetch']+g[1:]+['cat-file','-e',sha],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode]
if missing:
    proc=subprocess.run(g+['fetch','--quiet','--no-tags','--no-write-fetch-head','--stdin','origin'],input=('\n'.join(set(missing))+'\n').encode(),stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    if proc.returncode:print('Using individual reachable Git blobs',flush=True)
for mode,sha,path in items:
    f=sample/path;f.parent.mkdir(parents=True,exist_ok=True)
    f.write_bytes(subprocess.check_output(g+['cat-file','blob',sha]));f.chmod(0o755 if mode=='100755' else 0o644)
print('Hydrated native project',len(items),flush=True)
for item in ['package.json','package-lock.json','tsconfig.json']:shutil.copyfile(base/item,sample/item)
for item,target in [('node_modules',base/'node_modules'),('dist',p/'production/06')]:
 link=sample/item
 if not link.exists():link.symlink_to(target.resolve(),target_is_directory=True)
env=dict(os.environ,ANDROID_HOME=str(root/'sdk'),ANDROID_SDK_ROOT=str(root/'sdk'),GRADLE_USER_HOME=str(root/'gradle-cache'),ANDROID_USER_HOME=str(root/'device-state'),CI='1')
for nm,cmd,cwd in [('capacitor', [str(sample/'node_modules/.bin/cap'),'sync','android'],sample),('gradle',['bash','gradlew','assembleDebug','--no-daemon','--max-workers=2','--console=plain'],sample/'android')]:
 with (root/(nm+'.log')).open('w') as out:r=subprocess.run(cmd,cwd=cwd,env=env,stdout=out,stderr=subprocess.STDOUT)
 print(nm,r.returncode,flush=True)
 if r.returncode:break
