from pathlib import Path
from zipfile import ZipFile
from guides import OUT,ROOT,IDS,load
import hashlib
def sh(file):
    with file.open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
proof=load(OUT/'PACKAGE_VERIFICATION.json'); plan=(OUT/'FIVE_SCREEN_REPAIR_PLAN.md').read_bytes()
for rec in (proof['images'],proof['videos']):
    package=OUT/rec['path']
    assert sh(package)==rec['sha256'] and package.stat().st_size<200_000_000
    with ZipFile(package) as z:
        assert z.read('FIVE_SCREEN_REPAIR_PLAN.md')==plan
        assert 'Per-screen repair plan' in z.read('README_FIRST.md').decode()
        assert all(f.compress_type in (0,8) and not(f.flag_bits&1) for f in z.infolist())
        if 'Videos' in package.name:
            for r in load(ROOT/'individual-videos.json'):
                target=OUT/r['directPath']; name='Screen_'+r['screen']+'/'+target.name
                assert sh(target)==hashlib.sha256(z.read(name)).hexdigest()==r['sha256']
assert not list(OUT.rglob('*.partial'))
phone=load(ROOT/'phone-review-check.json')
assert [r['width'] for r in phone]==[360,393]
print('Direct zip downloads',[(p['path'],round(p['bytes']/1e6,1)) for p in (proof['images'],proof['videos'])])
print('35 H.264 files, 10 direct matched rides, 449 image files; original artworks verified:',len(proof['originalArtworkHashes']))
