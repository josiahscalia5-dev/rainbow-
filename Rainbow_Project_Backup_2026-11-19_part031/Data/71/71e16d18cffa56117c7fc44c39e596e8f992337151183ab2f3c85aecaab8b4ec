{"agentId": "a37bba196b0b06729", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-8b6fc834-7kd55l", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * RAINBOW master course — ONE continuous route through the washer world.\n3\t *\n4\t * Units: 1 unit ≈ 5 cm at Benny's scale (Benny body radius ≈ 0.8). +Y is up (absolute altitude).\n5\t * The route starts inside Drum A (scene 01/02), drains through a chute into the whirlpool basin (03),\n6\t * drops down the five-arrow slide (04), winds through the perforated current tube (05), crests the\n7\t * rinse arch (06), winds through the washer tube and then PLUNGES ~62 units straight down (07) before\n8\t * the bottom of that same tube flares into the Final Spin Chamber inlet (08). 08–10 stay in that same\n9\t * chamber; the route ends under the purple towel on the platform, where the 11 cinematic plays.\n10\t *\n11\t * Every stage is a range of arc-length `s` on a single centripetal Catmull-Rom spline, so position\n12\t * and tangent are continuous by construction; `validateContinuity()` measures it anyway.\n13\t */\n14\timport * as THREE from 'three';\n15\t\n16\texport type StageId = '01' | '02' | '03' | '04' | '05' | '06' | '07' | '08' | '09' | '10' | '11';\n17\texport type TubeKind = 'none' | 'chute' | 'gold' | 'perf';\n18\texport type StageProp = 'width' | 'tube' | 'speed' | 'bank';\n19\t\n20\texport interface StageDef {\n21\t  id: StageId;\n22\t  title: string;\n23\t  /** arc-length range on the course */\n24\t  s0: number;\n25\t  s1: number;\n26\t  /** water ribbon width (units) */\n27\t  width: number;\n28\t  /** enclosing tube radius (0 = open environment such as a drum/basin/chamber) */\n29\t  tube: number;\n30\t  tubeKind: TubeKind;\n31\t  /** auto-propulsion speed (units / s) */\n32\t  speed: number;\n33\t  /** coin counter shown in the locked reference screenshot of this stage */\n34\t  refCoins: number;\n35\t  interactive: boolean;\n36\t  /** banking strength multiplier */\n37\t  bank: number;\n38\t}\n39\t\n40\texport interface CourseSample {\n41\t  s: number;\n42\t  pos: THREE.Vector3;\n43\t  tan: THREE.Vector3;\n44\t  up: THREE.Vector3;\n45\t  right: THREE.Vector3;\n46\t}\n47\t\n48\texport const STAGE_TITLES: Record<StageId, string> = {\n49\t  '01': 'INSIDE THE WASHING MACHINE',\n50\t  '02': 'WHIRLPOOL TUMBLE',\n51\t  '03': 'WHIRLPOOL TWIRL',\n52\t  '04': 'THROUGH THE FIVE ARROWS',\n53\t  '05': 'FLOW INTO THE CURRENT',\n54\t  '06': 'CREST THE RINSE ARCH',\n55\t  '07': 'DIVE THE WASHER TUBE',\n56\t  '08': 'FINAL SPIN CHAMBER',\n57\t  '09': 'RIDE THE FINAL WAVE',\n58\t  '10': 'SLIDE INTO HIDING',\n59\t  '11': 'SAFELY HOME',\n60\t};\n61\t\n62\t/** Fixed world anchors shared by environment builders (absolute coordinates). */\n63\texport const WORLD = {\n64\t  drumA: { center: new THREE.Vector3(0, 0, 0), radius: 5, zBack: -6.5, zDoor: 3.5, doorRadius: 3.2, waterY: -2.5 },\n65\t  basin: { center: new THREE.Vector3(2, -16, -19), rimRadius: 11.5, rimY: -10.6, drainRadius: 4.3, drainY: -20.2 },\n66\t  /** Final Spin Chamber (08–11): drum with axis along Z, door at the far (-Z) end */\n67\t  chamber: { center: new THREE.Vector3(12, -101.1, 0), radius: 13.5, zBack: -280, zDoor: -332, floorY: -113.6, doorRadius: 6.2 },\n68\t  platform: { center: new THREE.Vector3(12, -110.6, -325.0), radius: 6.2, topY: -110.6 },\n69\t  plunge: { topY: -52, bottomY: -113.6 },\n70\t};\n71\t\n72\t/** funnel surface height of the whirlpool basin as a function of radius from its axis */\n73\texport function funnelY(r: number): number {\n74\t  const b = WORLD.basin;\n75\t  const t = THREE.MathUtils.clamp((r - b.drainRadius * 0.6) / (b.rimRadius - b.drainRadius * 0.6), 0, 1);\n76\t  return b.drainY + (b.rimY - b.drainY) * Math.pow(t, 0.72);\n77\t}\n78\t\n79\tconst V = (x: number, y: number, z: number) => new THREE.Vector3(x, y, z);\n80\tconst smooth = (a: number, b: number, x: number) => {\n81\t  const t = THREE.MathUtils.clamp((x - a) / (b - a), 0, 1);\n82\t  return t * t * (3 - 2 * t);\n83\t};\n84\t\n85\t/**\n86\t * A stretch whose tunnel axis is an exact straight line a→b (the stream winds inside it). The\n87\t * course lies on the line at both ends of the stretch; tube.ts aligns the tunnel axis to it.\n88\t */\n89\texport interface StraightAxis {\n90\t  /** arc-length range of the stretch on the course */\n91\t  s0: number;\n92\t  s1: number;\n93\t  a: THREE.Vector3;\n94\t  b: THREE.Vector3;\n95\t  /** stream-to-tunnel-bottom depth on the line (water sits this high in the tube) */\n96\t  floorDepth: number;\n97\t}\n98\t\n99\tinterface RouteData {\n100\t  points: THREE.Vector3[];\n101\t  marks: Record<string, number>;\n102\t  straight: { from: string; to: string; a: THREE.Vector3; b: THREE.Vector3; floorDepth: number }[];\n103\t}\n104\t\n105\t/** Generates the dense control polyline of the route (absolute coordinates). */\n106\tfunction buildRoute(): RouteData {\n107\t  const pts: THREE.Vector3[] = [];\n108\t  const marks: Record<string, number> = {};\n109\t  const straight: RouteData['straight'] = [];\n110\t  const push = (p: THREE.Vector3) => {\n111\t    if (pts.length && p.distanceTo(pts[pts.length - 1]) < 0.25) return;\n112\t    pts.push(p);\n113\t  };\n114\t  const mark = (k: string) => (marks[k] = pts.length - 1);\n115\t  const seg = (n: number, f: (t: number) => THREE.Vector3, skipFirst = true) => {\n116\t    for (let i = skipFirst ? 1 : 0; i <= n; i++) push(f(i / n));\n117\t  };\n118\t\n119\t  // ---- 01: Benny hidden in the towel, drum A front-left floor (camera looks toward the door) ----\n120\t  const dA = WORLD.drumA;\n121\t  const hc = V(0, -0.4, 0); // swirl axis\n122\t  const th0 = Math.atan2(-2.0, 1.6);\n123\t  push(V(1.6, -2.4, -2.2));\n124\t  mark('01');\n125\t  // ---- 02: whirlpool tumble — helix around the drum axis toward the back drain ----\n126\t  const thEnd = -Math.PI / 2 - Math.PI * 2;\n127\t  seg(26, (t) => {\n128\t    const th = th0 + (thEnd - th0) * t;\n129\t    const r = 2.56 + (3.9 - 2.56) * smooth(0, 1, t);\n130\t    const z = -2.2 + (-5.4 + 2.2) * t;\n131\t    return V(hc.x + r * Math.cos(th), hc.y + r * Math.sin(th), z);\n132\t  });\n133\t  mark('02_drain');\n134\t  // chute from drum A back drain down into the whirlpool basin rim\n135\t  const b = WORLD.basin;\n136\t  const spiralStart = V(b.center.x - 9.6, funnelY(9.6) + 0.25, b.center.z);\n137\t  const c0 = pts[pts.length - 1].clone();\n138\t  const chuteCtrl = [c0, V(-0.6, -5.6, -7.6), V(-3.2, -7.8, -10.4), V(-6.6, -9.8, -14.2), spiralStart.clone().add(V(0, 0.15, 2.4))];\n139\t  const chute = new THREE.CatmullRomCurve3(chuteCtrl, false, 'centripetal');\n140\t  seg(14, (t) => chute.getPoint(t));\n141\t  push(spiralStart);\n142\t  mark('03');\n143\t  // ---- 03: whirlpool twirl — 3/4 inward turn down the funnel that dives into the drain CENTRE ----\n144\t  // decreasing angle from the -X side (θ=-π/2) round the far and right sides to the near (+Z) side;\n145\t  // r shrinks as (1-t)^1.6 so the last stretch heads radially inward = straight -Z into the drain hole.\n146\t  seg(60, (t) => {\n147\t    const th = -Math.PI / 2 - Math.PI * 1.5 * (1 - (1 - t) * (1 - t)); // angle eases out → radial finish\n148\t    const r = 9.6 * Math.pow(1 - t, 0.9);\n149\t    return V(b.center.x + r * Math.sin(th), funnelY(r) + 0.25, b.center.z + r * Math.cos(th));\n150\t  });\n151\t  mark('04');\n152\t  // ---- 04: five-arrow slide — steep straight drop (≈32°) inside the gold ring pipe ----\n153\t  const s4 = pts[pts.length - 1].clone();\n154\t  const pitch4 = THREE.MathUtils.degToRad(32);\n155\t  const d4 = V(0, -Math.sin(pitch4), -Math.cos(pitch4));\n156\t  // pull-down arc from the drain lip into the steep slide pitch\n157\t  const R4a = 9;\n158\t  seg(7, (t) => {\n159\t    const a = pitch4 * t;\n160\t    return s4.clone().add(V(0, -R4a * (1 - Math.cos(a)), -R4a * Math.sin(a)));\n161\t  });\n162\t  const s4b = pts[pts.length - 1].clone();\n163\t  seg(16, (t) => s4b.clone().addScaledVector(d4, 34 * t));\n164\t  // pull out of the slide into the horizontal current\n165\t  const s4c = pts[pts.length - 1].clone();\n166\t  const R4 = 12;\n167\t  seg(8, (t) => {\n168\t    const a = -pitch4 + pitch4 * t;\n169\t    return s4c.clone().add(V(0, R4 * (Math.cos(-pitch4) - Math.cos(a)), R4 * (Math.sin(-pitch4) - Math.sin(a))));\n170\t  });\n171\t  mark('05');\n172\t  // ---- 05: long STRAIGHT perforated current tube (ref 05: concentric rings, ONE vanishing point);\n173\t  // the wide stream winds in gentle S-curves inside it. Centreline = the straight line s5 → s5+L05\n174\t  // (slight descent); the lateral S-offset and its slope vanish at both ends, so 04 and 06 join it\n175\t  // tangentially and s6 (hence 06/07/plunge/08) is unchanged. tube.ts builds the 05 tunnel on L05.\n176\t  const s5 = pts[pts.length - 1].clone();\n177\t  const L05 = V(0, -3, -72);\n178\t  const S05 = { amp: 2.0, waves: 2 }; // ≈1.6 after smoothPolyline; λ ≈ 36 units\n179\t  seg(48, (t) => {\n180\t    const env = smooth(0, 0.16, t) * (1 - smooth(0.84, 1, t));\n181\t    return s5.clone().addScaledVector(L05, t).add(V(S05.amp * env * Math.sin(2 * Math.PI * S05.waves * t), 0, 0));\n182\t  });\n183\t  straight.push({ from: '05', to: '06', a: s5.clone(), b: s5.clone().add(L05), floorDepth: 3.3 });\n184\t  mark('06');\n185\t  // ---- 06: rinse arch — rises ~12 units, crests, curls down and to the right into the 07 tube ----\n186\t  const s6 = pts[pts.length - 1].clone();\n187\t  seg(34, (t) =>\n188\t    V(\n189\t      s6.x - 4 * Math.sin(Math.PI * t) + (WORLD.chamber.center.x - s6.x) * smooth(0.4, 1, t),\n190\t      s6.y + 12.5 * Math.pow(Math.sin(Math.PI * Math.min(t / 0.82, 1)), 1.15) - 4.5 * smooth(0.5, 1, t),\n191\t      s6.z - 46 * t,\n192\t    ),\n193\t  );\n194\t  mark('07');\n195\t  // ---- 07: winding washer tube (the visible stretch) ----\n196\t  const s7 = pts[pts.length - 1].clone();\n197\t  seg(32, (t) =>\n198\t    V(s7.x + 3.2 * Math.sin(3 * Math.PI * t) * Math.sin(Math.PI * t), s7.y + (WORLD.plunge.topY - s7.y) * t, s7.z - 60 * t),\n199\t  );\n200\t  mark('07_plunge_top');\n201\t  // ---- 07: THE DEEP PLUNGE — pull-down arc, long -70° straight, pull-up arc into the 08 inlet ----\n202\t  const p0 = pts[pts.length - 1].clone();\n203\t  const R = 14;\n204\t  const amax = THREE.MathUtils.degToRad(70);\n205\t  seg(12, (t) => {\n206\t    const a = amax * t;\n207\t    return p0.clone().add(V(0, -R * (1 - Math.cos(a)), -R * Math.sin(a)));\n208\t  });\n209\t  const p1 = pts[pts.length - 1].clone();\n210\t  const dPl = V(0, -Math.sin(amax), -Math.cos(amax));\n211\t  // straight length chosen so the bottom lands exactly on the chamber floor altitude\n212\t  const drop = p0.y - WORLD.plunge.bottomY;\n213\t  const Lstraight = (drop - 2 * R * (1 - Math.cos(amax))) / Math.sin(amax);\n214\t  seg(Math.ceil(Lstraight / 2), (t) => p1.clone().addScaledVector(dPl, Lstraight * t));\n215\t  mark('07_plunge_mid_end');\n216\t  const p2 = pts[pts.length - 1].clone();\n217\t  seg(12, (t) => {\n218\t    const a = -amax + amax * t;\n219\t    return p2.clone().add(V(0, R * (Math.cos(-amax) - Math.cos(a)), R * (Math.sin(-amax) - Math.sin(a))));\n220\t  });\n221\t  mark('07_plunge_bottom');\n222\t  const p3 = pts[pts.length - 1].clone();\n223\t  const zIn = WORLD.chamber.zBack;\n224\t  seg(4, (t) => V(p3.x, p3.y, p3.z + (zIn - p3.z) * t));\n225\t  mark('08');\n226\t  // ---- 08–10: Final Spin Chamber — winding stream toward the platform & towel ----\n227\t  const s8 = pts[pts.length - 1].clone();\n228\t  const plat = WORLD.platform;\n229\t  seg(14, (t) => V(s8.x + 3.6 * Math.sin(2 * Math.PI * t) * Math.sin(Math.PI * t), s8.y, s8.z - 15 * t));\n230\t  mark('09');\n231\t  const s9 = pts[pts.length - 1].clone();\n232\t  seg(14, (t) => V(s9.x - 3.2 * Math.sin(Math.PI * t), s9.y + 0.1 * t, s9.z - 15 * t));\n233\t  mark('10');\n234\t  const s10 = pts[pts.length - 1].clone();\n235\t  const end = V(plat.center.x, plat.topY + 0.45, plat.center.z + 0.6);\n236\t  seg(10, (t) =>\n237\t    V(s10.x + (end.x - s10.x) * t, s10.y + (end.y - s10.y) * smooth(0.3, 1, t), s10.z + (end.z - s10.z) * t),\n238\t  );\n239\t  mark('11');\n240\t  smoothPolyline(pts, marks['03'], 2.2, 3);\n241\t  return { points: pts, marks, straight };\n242\t}\n243\t\n244\t/**\n245\t * Arc-length Gaussian smoothing of the polyline from index `from` to the end (endpoints fixed).\n246\t * Removes tangent kinks where independently generated segments meet; the 02 tumble helix\n247\t * (before `from`) is left untouched.\n248\t */\n249\tfunction smoothPolyline(pts: THREE.Vector3[], from: number, sigma: number, passes: number) {\n250\t  for (let pass = 0; pass < passes; pass++) {\n251\t    const cum: number[] = [0];\n252\t    for (let i = 1; i < pts.length; i++) cum.push(cum[i - 1] + pts[i].distanceTo(pts[i - 1]));\n253\t    const out = pts.map((p) => p.clone());\n254\t    for (let i = from + 1; i < pts.length - 1; i++) {\n255\t      const acc = new THREE.Vector3();\n256\t      let wsum = 0;\n257\t      for (let j = i - 12; j <= i + 12; j++) {\n258\t        if (j < from || j >= pts.length) continue;\n259\t        const d = cum[j] - cum[i];\n260\t        const w = Math.exp(-(d * d) / (2 * sigma * sigma));\n261\t        acc.addScaledVector(pts[j], w);\n262\t        wsum += w;\n263\t      }\n264\t      out[i].copy(acc.divideScalar(wsum));\n265\t    }\n266\t    for (let i = from + 1; i < pts.length - 1; i++) pts[i].copy(out[i]);\n267\t  }\n268\t}\n269\t\n270\texport class Course {\n271\t  readonly curve: THREE.CatmullRomCurve3;\n272\t  readonly length: number;\n273\t  readonly stages: StageDef[];\n274\t  readonly marks: Record<string, number>; // arc-length of named marks\n275\t  /** straight tunnel stretches (05 current) — see StraightAxis */\n276\t  readonly straightAxes: StraightAxis[];\n277\t  private readonly N: number;\n278\t  private readonly ds: number;\n279\t  private readonly P: Float32Array;\n280\t  private readonly T: Float32Array;\n281\t  private readonly U: Float32Array;\n282\t\n283\t  constructor() {\n284\t    const route = buildRoute();\n285\t    this.curve = new THREE.CatmullRomCurve3(route.points, false, 'centripetal');\n286\t    // arc-length table over curve parameter u\n287\t    const M = route.points.length * 24;\n288\t    const us: number[] = [0];\n289\t    const ls: number[] = [0];\n290\t    let prev = this.curve.getPoint(0);\n291\t    for (let i = 1; i <= M; i++) {\n292\t      const u = i / M;\n293\t      const p = this.curve.getPoint(u);\n294\t      ls.push(ls[i - 1] + p.distanceTo(prev));\n295\t      us.push(u);\n296\t      prev = p;\n297\t    }\n298\t    this.length = ls[M];\n299\t    const uAtS = (s: number) => {\n300\t      let lo = 0, hi = M;\n301\t      while (hi - lo > 1) {\n302\t        const mid = (lo + hi) >> 1;\n303\t        if (ls[mid] < s) lo = mid; else hi = mid;\n304\t      }\n305\t      const f = (s - ls[lo]) / Math.max(1e-6, ls[hi] - ls[lo]);\n306\t      return us[lo] + (us[hi] - us[lo]) * f;\n307\t    };\n308\t    const sAtIndex = (i: number) => {\n309\t      const u = i / (route.points.length - 1);\n310\t      const k = Math.round(u * M);\n311\t      return ls[k];\n312\t    };\n313\t    this.marks = {};\n314\t    for (const [k, i] of Object.entries(route.marks)) this.marks[k] = sAtIndex(i);\n315\t    this.straightAxes = route.straight.map((r) => ({ s0: this.marks[r.from], s1: this.marks[r.to], a: r.a, b: r.b, floorDepth: r.floorDepth }));\n316\t\n317\t    // ---- stages ----\n318\t    const m = this.marks;\n319\t    const def = (id: StageId, s0: number, s1: number, o: Partial<StageDef>): StageDef => ({\n320\t      id, title: STAGE_TITLES[id], s0, s1, width: 5, tube: 0, tubeKind: 'none', speed: 11, refCoins: 0,\n321\t      interactive: true, bank: 1, ...o,\n322\t    });\n323\t    this.stages = [\n324\t      def('01', 0, 0.01, { width: 6, interactive: false, speed: 0 }),\n325\t      def('02', 0.01, m['03'], { width: 5, interactive: false, speed: 9, bank: 0 }),\n326\t      def('03', m['03'], m['04'], { width: 7, speed: 9, refCoins: 1330, bank: 2.2 }),\n327\t      def('04', m['04'], m['05'], { width: 4.4, tube: 4.8, tubeKind: 'gold', speed: 14, refCoins: 1330 }),\n328\t      // 05: level current (ref 05 shows no tilt) → weak curvature banking\n329\t      def('05', m['05'], m['06'], { width: 9, tube: 7.6, tubeKind: 'perf', speed: 11, refCoins: 1420, bank: 0.25 }),\n330\t      def('06', m['06'], m['07'], { width: 7, tube: 15, tubeKind: 'perf', speed: 11, refCoins: 1680, bank: 0.6 }),\n331\t      def('07', m['07'], m['08'], { width: 5.6, tube: 7.2, tubeKind: 'perf', speed: 12, refCoins: 1940 }),\n332\t      def('08', m['08'], m['09'], { width: 4.8, speed: 9.5, refCoins: 2040 }),\n333\t      def('09', m['09'], m['10'], { width: 6.4, speed: 9.5, refCoins: 2280 }),\n334\t      def('10', m['10'], m['11'], { width: 3.8, speed: 7.5, refCoins: 2500 }),\n335\t      def('11', m['11'], this.length, { width: 3, interactive: false, speed: 0, refCoins: 2500 }),\n336\t    ];\n337\t\n338\t    // ---- dense frame table (pos, tangent, banked up) ----\n339\t    this.N = Math.ceil(this.length / 0.25) + 1;\n340\t    this.ds = this.length / (this.N - 1); // exact spacing so the last interval is not short\n341\t    this.P = new Float32Array(this.N * 3);\n342\t    this.T = new Float32Array(this.N * 3);\n343\t    this.U = new Float32Array(this.N * 3);\n344\t    const pos: THREE.Vector3[] = [];\n345\t    const tan: THREE.Vector3[] = [];\n346\t    for (let i = 0; i < this.N; i++) {\n347\t      const s = Math.min(this.length, i * this.ds);\n348\t      const u = uAtS(s);\n349\t      pos.push(this.curve.getPoint(u));\n350\t      tan.push(this.curve.getTangent(u).normalize());\n351\t    }\n352\t    // up: world-up projected off the tangent + curvature banking, then smoothed\n353\t    const WU = new THREE.Vector3(0, 1, 0);\n354\t    const ups: THREE.Vector3[] = [];\n355\t    let prevUp = WU.clone();\n356\t    for (let i = 0; i < this.N; i++) {\n357\t      const t = tan[i];\n358\t      let up = WU.clone().addScaledVector(t, -WU.dot(t));\n359\t      if (up.lengthSq() < 1e-4) up = prevUp.clone().addScaledVector(t, -prevUp.dot(t));\n360\t      up.normalize();\n361\t      // banking from lateral curvature\n362\t      const i0 = Math.max(0, i - 4), i1 = Math.min(this.N - 1, i + 4);\n363\t      const k = tan[i1].clone().sub(tan[i0]).divideScalar((i1 - i0) * this.ds);\n364\t      const right = new THREE.Vector3().crossVectors(t, up).normalize();\n365\t      const st = this.stageAtS(i * this.ds);\n366\t      const bankAngle = THREE.MathUtils.clamp(-k.dot(right) * 6 * st.bank, -0.85, 0.85);\n367\t      up.applyAxisAngle(t, bankAngle);\n368\t      ups.push(up);\n369\t      prevUp = up;\n370\t    }\n371\t    // smooth up vectors (box filter) & re-orthogonalize\n372\t    const sm: THREE.Vector3[] = ups.map((_, i) => {\n373\t      const acc = new THREE.Vector3();\n374\t      for (let j = -8; j <= 8; j++) acc.add(ups[THREE.MathUtils.clamp(i + j, 0, this.N - 1)]);\n375\t      const t = tan[i];\n376\t      return acc.addScaledVector(t, -acc.dot(t)).normalize();\n377\t    });\n378\t    for (let i = 0; i < this.N; i++) {\n379\t      pos[i].toArray(this.P, i * 3);\n380\t      tan[i].toArray(this.T, i * 3);\n381\t      sm[i].toArray(this.U, i * 3);\n382\t    }\n383\t  }\n384\t\n385\t  stageAtS(s: number): StageDef {\n386\t    for (const st of this.stages) if (s < st.s1) return st;\n387\t    return this.stages[this.stages.length - 1];\n388\t  }\n389\t\n390\t  stage(id: StageId): StageDef {\n391\t    return this.stages.find((s) => s.id === id)!;\n392\t  }\n393\t\n394\t  /**\n395\t   * smoothly blended per-stage property (blend ±blend units around stage boundaries).\n396\t   * Accepts either argument order: prop(s, 'width') or prop('width', s).\n397\t   */\n398\t  prop(s: number, key: StageProp, blend?: number): number;\n399\t  prop(key: StageProp, s: number, blend?: number): number;\n400\t  prop(a: number | StageProp, b: number | StageProp, blend = 6): number {\n401\t    const s = (typeof a === 'number