{"agentId": "aab9f1d4212f4d68f", "cwd": "/home/user/rainbow-/.claude/worktrees/agent-aab9f1d4212f4d68f", "entrypoint": "remote_mobile", "gitBranch": "claude/rainbow-s08-camclear", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * `?match08=1` — Screen 08 approved-picture test (2026-11-17, qa/match/08/NOTES.md).\n3\t * REAL 3D proxy geometry of the Final Spin Chamber, solved from the user's approved Screen 08 and the locked game\n4\t * camera (tools/match08/fit_proxies.py → assets/textures/match08/proj08.json): inlet pipe, gold arch, chamber walls,\n5\t * door wall, floor/river plane, platform (top tilted toward the camera as painted), towel and the four half-dome spouts.\n6\t * Every surface is textured by camera projection of the CLEAN environment-only artwork (Benny, HUD, coins removed;\n7\t * qa/imageblaster/08/) from that locked camera, so the locked view shows the approved scenery and a moving camera sees\n8\t * it on geometry (parallax). Surfaces the projector cannot see (behind props) get a plain fallback colour instead of\n9\t * a smeared copy (projector depth test). The shader undoes the game's post chain (PROJ05_INVERSE) and takes no fog.\n10\t * Without the switch nothing in this file runs and the game is unchanged.\n11\t */\n12\timport * as THREE from 'three';\n13\timport { PROJ05_INVERSE } from '../vfx/waterRibbon';\n14\t\n15\tinterface Layout {\n16\t  camera: { matrixWorld: number[]; fov: number; size: [number, number] };\n17\t  floorY: number;\n18\t  chamber: { cx: number; cy: number; r: number; zBack: number; zDoor: number };\n19\t  arch: { z: number; outer: { cx: number; cy: number; r: number }; inner: { cx: number; cy: number; r: number }; depth: number };\n20\t  pipe: { cx: number; cy: number; r: number; z0: number; z1: number };\n21\t  backwall: { z: number; holeR: number };\n22\t  platform: { cx: number; cz: number; r: number; topY: number; rimBottomY: number; floorY: number; tiltDeg: number };\n23\t  towel: { cx: number; cz: number; w: number; h: number; y0: number; d: number };\n24\t  spouts: Record<string, { c: [number, number, number]; rx: number; ry: number }>;\n25\t}\n26\t\n27\texport interface Match08 {\n28\t  group: THREE.Group;\n29\t  /** the approved picture's splash ring around Benny (camera-facing card; Game places it at Benny + splashOffset) */\n30\t  splash: THREE.Mesh;\n31\t  splashOffset: THREE.Vector3;\n32\t  /** render the projector depth map once (needs the renderer); call after the group is in the scene */\n33\t  bakeDepth(renderer: THREE.WebGLRenderer): void;\n34\t  /** live post values for the inverse (exposure from the renderer, render size for the vignette inverse) */\n35\t  sync(renderer: THREE.WebGLRenderer, w: number, h: number): void;\n36\t}\n37\t\n38\tconst VERT = /* glsl */ `\n39\tuniform mat4 uProjVP;\n40\tvarying vec4 vProj;\n41\tvarying vec3 vW;\n42\tvarying vec3 vN;\n43\tvoid main() {\n44\t  vec4 wp = modelMatrix * vec4(position, 1.0);\n45\t  vProj = uProjVP * wp;\n46\t  vW = wp.xyz;\n47\t  vN = normalize(mat3(modelMatrix) * normal);\n48\t  gl_Position = projectionMatrix * viewMatrix * wp;\n49\t}`;\n50\t\n51\tconst FRAG = /* glsl */ `\n52\tuniform sampler2D uPlate;\n53\tuniform sampler2D uDepth;\n54\tuniform float uUseDepth;\n55\tuniform vec2 uNearFar;\n56\tuniform vec3 uFallback;\n57\tuniform sampler2D uPatch;   // material patch cut from the approved artwork (wall slots / gold band / towel)\n58\tuniform float uPatchK;      // patch repeats per world unit\n59\tuniform vec3 uProjPos;      // projector (approved view) position\n60\tuniform vec4 uPjPost;\n61\tuniform vec2 uPjRes;\n62\tvarying vec4 vProj;\n63\tvarying vec3 vW;\n64\tvarying vec3 vN;\n65\t${PROJ05_INVERSE}\n66\t// triplanar, mirrored-repeat sampling of the patch: surfaces the approved picture never showed (or showed edge-on)\n67\tvec3 patchColor() {\n68\t  vec3 n = abs(normalize(vN)); n /= max(n.x + n.y + n.z, 1e-4);\n69\t  vec3 p = vW * uPatchK;\n70\t  return texture2D(uPatch, p.zy).rgb * n.x + texture2D(uPatch, p.xz).rgb * n.y + texture2D(uPatch, p.xy).rgb * n.z;\n71\t}\n72\tfloat linZ(float d) { float n = uNearFar.x, f = uNearFar.y; float z = d * 2.0 - 1.0; return 2.0 * n * f / (f + n - z * (f - n)); }\n73\tvoid main() {\n74\t  vec3 pc = patchColor();\n75\t  vec3 t = pc;\n76\t  // stretch guard: the projection is used where the current view sees the surface no more face-on than the approved\n77\t  // view did (ratio of the two incidence cosines); in the approved view itself the ratio is 1 -> pure projection\n78\t  vec3 nn = normalize(vN);\n79\t  float cp = abs(dot(nn, normalize(uProjPos - vW))), cc = abs(dot(nn, normalize(cameraPosition - vW)));\n80\t  float keep = 1.0 - smoothstep(2.5, 6.0, cc / max(cp, 1e-3));\n81\t  if (vProj.w > 0.0) {\n82\t    vec3 ndc = vProj.xyz / vProj.w;\n83\t    vec2 uv = ndc.xy * 0.5 + 0.5;\n84\t    if (uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0) {\n85\t      float vis = 1.0;\n86\t      if (uUseDepth > 0.5) {\n87\t        float zs = linZ(texture2D(uDepth, uv).r), zf = linZ(ndc.z * 0.5 + 0.5);\n88\t        vis = 1.0 - smoothstep(0.015 * zs, 0.04 * zs + 0.05, zf - zs);\n89\t      }\n90\t      t = mix(pc, texture2D(uPlate, uv).rgb, vis * keep);\n91\t    }\n92\t  }\n93\t  gl_FragColor = vec4(pjInverse(t), 1.0);\n94\t}`;\n95\t\n96\texport async function buildMatch08(): Promise<Match08> {\n97\t  const L: Layout = await fetch(new URL('../../assets/textures/match08/proj08.json', import.meta.url).href).then((r) => r.json());\n98\t  const plate = await new THREE.TextureLoader().loadAsync(new URL('../../assets/textures/match08/plate08_hybrid.png', import.meta.url).href);\n99\t  plate.colorSpace = THREE.NoColorSpace; // raw display values: the shader inverts the post chain itself\n100\t  plate.minFilter = THREE.LinearMipmapLinearFilter;\n101\t  plate.anisotropy = 8;\n102\t\n103\t  // the projector = the locked game camera the picture was matched to\n104\t  const [W, H] = L.camera.size;\n105\t  const proj = new THREE.PerspectiveCamera(L.camera.fov, W / H, 0.2, 160);\n106\t  proj.matrixWorld.fromArray(L.camera.matrixWorld);\n107\t  proj.matrixWorld.decompose(proj.position, proj.quaternion, proj.scale);\n108\t  proj.matrixWorldInverse.copy(proj.matrixWorld).invert();\n109\t  proj.updateProjectionMatrix();\n110\t  const projVP = new THREE.Matrix4().multiplyMatrices(proj.projectionMatrix, proj.matrixWorldInverse);\n111\t\n112\t  const depthRT = new THREE.WebGLRenderTarget(1024, Math.round((1024 * H) / W), { depthBuffer: true });\n113\t  depthRT.depthTexture = new THREE.DepthTexture(depthRT.width, depthRT.height, THREE.UnsignedIntType);\n114\t  const shared = {\n115\t    uPlate: { value: plate },\n116\t    uDepth: { value: depthRT.depthTexture as THREE.Texture },\n117\t    uUseDepth: { value: 0 },\n118\t    uNearFar: { value: new THREE.Vector2(proj.near, proj.far) },\n119\t    uProjVP: { value: projVP },\n120\t    uPjPost: { value: new THREE.Vector4(0.86, 1.36, 1.15, 0.18) },\n121\t    uPjRes: { value: new THREE.Vector2(W, H) },\n122\t    uProjPos: { value: proj.position.clone() },\n123\t  };\n124\t  // material patches cut from the approved artwork (tools: qa/match/08/NOTES.md), mirrored so the tiling has no seams\n125\t  const loadPatch = async (name: string) => {\n126\t    const t = await new THREE.TextureLoader().loadAsync(new URL(`../../assets/textures/match08/patch_${name}.png`, import.meta.url).href);\n127\t    t.colorSpace = THREE.NoColorSpace; t.wrapS = t.wrapT = THREE.MirroredRepeatWrapping; t.anisotropy = 4; return t;\n128\t  };\n129\t  const [pWall, pGold, pTowel] = await Promise.all([loadPatch('wall'), loadPatch('gold'), loadPatch('towel')]);\n130\t  const mat = (fallback: string, patch: THREE.Texture, k: number) => new THREE.ShaderMaterial({\n131\t    vertexShader: VERT, fragmentShader: FRAG, side: THREE.DoubleSide, fog: false,\n132\t    uniforms: { ...shared, uFallback: { value: new THREE.Color(fallback) }, uPatch: { value: patch }, uPatchK: { value: k } },\n133\t  });\n134\t  // patch scale: wall slots ≈ 2.4 u per patch, gold band ≈ 1.2 u, towel ≈ 1 u\n135\t  const M = { wall: mat('#c25bd0', pWall, 1 / 2.4), floor: mat('#9c55c8', pWall, 1 / 2.4), gold: mat('#e8a24a', pGold, 1 / 1.2), plat: mat('#b78ad6', pWall, 1 / 2.4), towel: mat('#6c3bc4', pTowel, 1 / 1.0) };\n136\t\n137\t  const group = new THREE.Group();\n138\t  group.name = 'match08_projection';\n139\t  const add = (g: THREE.BufferGeometry, m: THREE.Material, name: string) => { const o = new THREE.Mesh(g, m); o.name = 'm08_' + name; group.add(o); return o; };\n140\t  const C = L.chamber;\n141\t\n142\t  // inlet pipe around the camera, ending at the arch (the picture's near walls outside the arch)\n143\t  const pipeLen = L.pipe.z0 - L.pipe.z1;\n144\t  const pipe = new THREE.CylinderGeometry(L.pipe.r, L.pipe.r, pipeLen, 128, 8, true);\n145\t  pipe.rotateX(Math.PI / 2).translate(L.pipe.cx, L.pipe.cy, (L.pipe.z0 + L.pipe.z1) / 2);\n146\t  add(pipe, M.wall, 'pipe');\n147\t  // gold arch: annulus at the chamber entrance, extruded toward the door\n148\t  const ring = new THREE.Shape(); ring.absarc(0, 0, L.arch.outer.r, 0, Math.PI * 2, false);\n149\t  const hole = new THREE.Path(); hole.absarc(L.arch.inner.cx - L.arch.outer.cx, L.arch.inner.cy - L.arch.outer.cy, L.arch.inner.r, 0, Math.PI * 2, true);\n150\t  ring.holes.push(hole);\n151\t  const archG = new THREE.ExtrudeGeometry(ring, { depth: L.arch.depth, bevelEnabled: false, curveSegments: 96 });\n152\t  archG.translate(L.arch.outer.cx, L.arch.outer.cy, L.arch.z - L.arch.depth);\n153\t  add(archG, M.gold, 'arch');\n154\t  // back wall around the pipe mouth (closes the gap between pipe and chamber; seen only when moving in)\n155\t  const bw = new THREE.Shape(); bw.absarc(C.cx, C.cy, C.r, 0, Math.PI * 2, false);\n156\t  const bh = new THREE.Path(); bh.absarc(L.pipe.cx, L.pipe.cy, L.backwall.holeR, 0, Math.PI * 2, true); bw.holes.push(bh);\n157\t  add(new THREE.ShapeGeometry(bw, 64).translate(0, 0, L.backwall.z), M.wall, 'backwall')