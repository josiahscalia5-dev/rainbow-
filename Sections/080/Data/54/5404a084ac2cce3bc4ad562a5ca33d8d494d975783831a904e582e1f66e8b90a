        print('Batch direct object fetch:',safe[-350:].replace('\n',' '),flush=True)
        fallback=checked_ids(ids);break
if fallback:
    recover=p/'github-blob-recovery';recover.mkdir(exist_ok=True)
    def get_blob(h):
        f=recover/h
        for attempt in range(3):
            if not f.is_file():
                with f.open('wb') as of:
                    ret=sp.run(['gh','api','-H','Accept: application/vnd.github.raw+json','repos/josiahscalia5-dev/rainbow-/git/blobs/'+h],stdout=of,stderr=sp.PIPE)
                if ret.returncode:
                    f.unlink(missing_ok=True);continue
            data=f.read_bytes()
            if data.startswith(b'{') and hashlib.sha1(b'blob '+str(len(data)).encode()+b'\0'+data).hexdigest()!=h:
                try:
                    import base64
                    j=json.loads(data)
                    assert j.get('sha')==h and j['encoding']=='base64'
                    data=base64.b64decode(j['content']);f.write_bytes(data)
                except (ValueError,AssertionError,KeyError):pass
            if hashlib.sha1(b'blob '+str(len(data)).encode()+b'\0'+data).hexdigest()==h:
                stored=run(basecmd+['hash-object','-w','--stdin'],input=data).stdout.decode().strip();assert stored==h
                return h
            f.unlink(missing_ok=True)
        raise RuntimeError('Could not recover tracked blob '+h)
    print('Recovering remaining exact Git objects through private GitHub',len(fallback),flush=True)
    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as group:
        for i,_ in enumerate(group.map(get_blob,fallback),1):
