{"agentId": "a89e3313925c9aec9", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "claude/approved-screen-implementation-g3loqu", "isSidechain": true, "message": {"content": [{"content": "#!/usr/bin/env node\n// Screen 05 tunnel probe (walls + gold rings bake, `?projwall05=1` / `?projring05=1`) — exact, read-only\n// measurements of the REAL game at the locked 05 checkpoint (time frozen, as scripts/capture.mjs).\n//   node scripts/proj05-tunnel-probe.mjs [--q='switches'] [--out=qa/pilot05/proj/tunnel/probe] [--raw=DIR] [--all]\n// Writes into OUT:\n//   tunnel.json     camera (world + projection matrix), the 05 tunnel numbers (checkpoint eye s, ring positions, far\n//                   block knots / virtual depths, band widths) and the list of probed meshes\n// and into RAW (21 MB each, keep them out of git):\n//   tunnel_id.f32   864×1536×4 float32, top row first. Per pixel, the first surface the camera sees:\n//                     real 05 wall   (uv.x round the tube, uv.y = s,            1, 10)\n//                     far wall       (uv.x,                uv.y = sF + u,       2, 10)\n//                     real ring      (phi object space,    z across the band,   3, 20 + instance)\n//                     far ring       (phi,                 z,                   4, 20 + instance)\n//                     real lid / far lid (object x, y, 5 / 6, 40 + instance); anything else: its own colour, alpha ≤ 1\n//                   Benny, coins, bubbles, foam, splash and spray are hidden unless --all is given (then they occlude,\n//                   and pixels blended with something transparent no longer carry an exact alpha → not usable).\n//   tunnel_coords.f32  (--coords, with --q='projwall05=1&projring05=1'): the same frame, but the tunnel shaders write the\n//                   baked-texture coordinates they sample: wall (u, v in wall05.png, 7, 77), ring (u, v in ring05.png, 8, 78)\n// Uses window.__rainbow.qa3d() (QA accessor; rendering is unchanged). Nothing in the game is modified.\nimport { mkdirSync, writeFileSync } from 'node:fs';\nimport { loadPlaywright, CHROMIUM_ARGS, startVite } from './lib/pw.mjs';\n\nconst opt = Object.fromEntries(process.argv.slice(2).filter((a) => a.startsWith('--')).map((a) => { const [k, ...r] = a.slice(2).split('='); return [k, r.length ? r.join('=') : true]; }));\nconst OUT = typeof opt.out === 'string' ? opt.out : 'qa/pilot05/proj/tunnel/probe';\nconst RAW = typeof opt.raw === 'string' ? opt.raw : OUT;\nconst Q = typeof opt.q === 'string' ? opt.q : '';\nconst ALL = !!opt.all;\nconst COORDS = !!opt.coords;   // with ?projwall05=1 / ?projring05=1: the baked-texture coordinates the shaders use (tunnel_coords.f32)\nmkdirSync(OUT, { recursive: true });\nmkdirSync(RAW, { recursive: true });\nconst W = 864, H = 1536;\n\nconst { chromium } = loadPlaywright();\nconst vite = await startVite(5233);\nconst browser = await chromium.launch({ args: CHROMIUM_ARGS });\ntry {\n  const page = await browser.newPage({ viewport: { width: W, height: H }, deviceScaleFactor: 1 });\n  page.on('pageerror', (e) => console.error('pageerror', e.message));\n  page.on('console', (m) => { if (m.type() === 'error') console.error('console', m.text()); });\n  const hide = ALL ? '' : '&hide=benny,coins&waterhide=crown,spray,bubbles,splash05,splashCrown,foamRim05,foamFlank,foamRafts';\n  await page.goto(`${vite.url}/?qa=1&dpr=1${hide}${Q ? '&' + Q : ''}`);\n  await page.waitForFunction(() => window.__rainbow?.ready === true || window.__error, null, { timeout: 240000 });\n  const meta = await page.evaluate(async (COORDS) => {\n    const R = window.__rainbow;\n    R.goto('05');\n    await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(() => r())));\n    const { scene, camera, renderer, composer } = R.qa3d();\n    const far = scene.getObjectByName('tube05_far_river');\n    const MBM = far.material.constructor;\n    const RT = composer.renderTarget1.constructor;\n    const rt = new RT(innerWidth, innerHeight, { type: 1015 /* FloatType */, format: 1023 /* RGBA */, depthBuffer: true });\n    const idMat = (expr, tag) => {\n      const m = new MBM({ color: 0xffffff, fog: false });\n      m.side = 2;\n      m.onBeforeCompile = (sh) => {\n        sh.vertexShader = sh.vertexShader\n          .replace('#include <common>', '#include <common>\\nvarying vec2 vPUv; varying vec3 vPPos; varying float vPInst;')\n          .replace('#include <begin_vertex>', '#include <begin_vertex>\\nvPUv = uv; vPPos = position;\\n#ifdef USE_INSTANCING\\nvPInst = float(gl_InstanceID);\\n#else\\nvPInst = 0.0;\\n#endif');\n        sh.fragmentShader = sh.fragmentShader\n          .replace('#include <common>', '#include <common>\\nvarying vec2 vPUv; varying vec3 vPPos; varying float vPInst;')\n          .replace('#include <dithering_fragment>', `gl_FragColor = ${expr};`);\n      };\n      m.customProgramCacheKey = () => 'tunnel-probe-' + tag;\n      return m;\n    };\n    const mats = {\n      wall: idMat('vec4(vPUv.x, vPUv.y, 1.0, 10.0)', 'wall'),\n      farWall: idMat('vec4(vPUv.x, vPUv.y, 2.0, 10.0)', 'farwall'),\n      ring: idMat('vec4(atan(vPPos.y, vPPos.x), vPPos.z, 3.0, 20.0 + floor(vPInst + 0.5))', 'ring'),\n      farRing: idMat('vec4(atan(vPPos.y, vPPos.x), vPPos.z, 4.0, 20.0 + floor(vPInst + 0.5))', 'farring'),\n      lid: idMat('vec4(vPPos.x, vPPos.y, 5.0, 40.0 + floor(vPInst + 0.5))', 'lid'),\n      farLid: idMat('vec4(vPPos.x, vPPos.y, 6.0, 40.0 + floor(vPInst + 0.5))', 'farlid'),\n    };\n    const keyOf = (o) => { try { return typeof o.material?.customProgramCacheKey === 'function' ? o.material.customProgramCacheKey() : ''; } catch { return ''; } };\n    const classify = (o) => {\n      const k = keyOf(o);\n      if (/strips-attribute-wall05v/.test(k)) return 'farWall';\n      if (/strips-attribute-wall05/.test(k)) return 'wall';\n      if (/band-ring05v/.test(k)) return 'farRing';\n      if (/band-ring05/.test(k)) return 'ring';\n      if (/lid-lid05v/.test(k)) return 'farLid';\n      if (/lid-lid05/.test(k)) return 'lid';\n      return null;\n    };\n    const all = [];\n    scene.traverse((o) => { if (o.isMesh || o.isPoints || o.isLine || o.isSprite) all.push(o); });\n    const saved = all.map((o) => ({ o, mat: o.material, cls: classify(o) }));\n    const probed = {};\n    // --coords: no material is replaced; the projwall05 / projring05 shaders themselves write (texture u, v, 7 | 8, 77 | 78)\n    const ptShared = COORDS ? (await import('/src/vfx/proj05Tunnel.ts')).proj05TunnelShared : null;\n    if (ptShared) ptShared.uPtDbg.value = 1;\n    else for (const s of saved) if (s.cls) { s.o.material = mats[s.cls]; probed[s.cls] = (probed[s.cls] ?? 0) + 1; }\n    const bg = scene.background;\n    scene.background = null;\n    renderer.setRenderTarget(rt);\n    renderer.setClearColor(0x000000, 0);\n    renderer.clear(true, true, true);\n    renderer.render(scene, camera);\n    renderer.setRenderTarget(null);\n    const buf = new Float32Array(rt.width * rt.height * 4);\n    renderer.readRenderTargetPixels(rt, 0, 0, rt.width, rt.height, buf);\n    for (const s of saved) s.o.material = s.mat;\n    if (ptShared) ptShared.uPtDbg.value = 0;\n    scene.background = bg;\n    window.__probe = buf;\n    // ring instances: world matrices of the real rings (centre, radius, axial position along the tube)\n    const ringMesh = saved.find((s) => s.cls === 'ring')?.o;\n    const farRingMesh = saved.find((s) => s.cls === 'farRing')?.o;\n    const inst = (mesh) => { if (!mesh) return []; mesh.updateMatrixWorld(); const out = []; for (let i = 0; i < mesh.count; i++) out.push(Array.from(mesh.instanceMatrix.array.slice(i * 16, i * 16 + 16))); return out; };\n    const dbg = (await import('/src/world/far05.ts')).far05Debug;\n    const cam = (await import('/src/game/cameraRig.ts')).STAGE_CAM;\n    camera.updateMatrixWorld();\n    const c = R.course;\n    return {\n      w: rt.width, h: rt.height, probed,\n      camera: { matrixWorld: camera.matrixWorld.toArray(), projection: camera.projectionMatrix.toArray(), fov: camera.fov, aspect: camera.aspect, position: camera.position.toArray() },\n      stage05: { s0: c.stage('05').s0, s1: c.stage('05').s1, crest: c.marks['05_crest'] }, stage06: { s0: c.stage('06').s0 },\n      stageCam05: cam['05'],\n      tunnel: {\n        sCam05: dbg.sCam05, s05: dbg.s05, sGlow05: dbg.sGlow05, sF05: dbg.sF05, bay05: dbg.bay05, rings05: dbg.rings05, ringDv: dbg.ringDv, knots: dbg.knots,\n        realSeamRing: dbg.realSeamRing, D0: dbg.ft?.D0, L: dbg.ft?.L, zEnd: dbg.ft?.zEnd, R: dbg.ft?.R, band05: dbg.band05, band05near: dbg.band05near, eye: dbg.eye?.toArray?.(),\n      },\n      ringInstances: inst(ringMesh), farRingInstances: inst(farRingMesh),\n      state: R.state(),\n    };\n  }, COORDS);\n  const b64 = await page.evaluate(() => {\n    const u8 = new Uint8Array(window.__probe.buffer);\n    let s = '';\n    for (let i = 0; i < u8.length; i += 32768) s += String.fromCharCode.apply(null, u8.subarray(i, i + 32768));\n    return btoa(s);\n  });\n  // WebGL reads bottom row first → flip to top row first\n  const raw = Buffer.from(b64, 'base64');\n  const rowB = W * 4 * 4;\n  const flipped = Buffer.alloc(raw.length);\n  for (let y = 0; y < H; y++) raw.copy(flipped, y * rowB, (H - 1 - y) * rowB, (H - y) * rowB);\n  const tag = `${COORDS ? 'coords' : 'id'}${ALL ? '_all' : ''}`;\n  writeFileSync(`${RAW}/tunnel_${tag}.f32`, flipped);\n  if (!COORDS) writeFileSync(`${OUT}/tunnel${ALL ? '_all' : ''}.json`, JSON.stringify({ ...meta, q: Q, all: ALL }, null, 1));\n  console.log('probed', JSON.stringify(meta.probed), 'tunnel', JSON.stringify(meta.tunnel));\n} finally {\n  await browser.close();\n  await vite.close();\n}\n\"\"\"Screen 05 walls + rings bake, step 3 — colour feedback: what the game shows (a locked capture with `?projwall05=1`\nand / or `?projring05=1`) minus what the baked texture asked for, per texel, so the next bake can pre-compensate the\npart of the post chain the shader cannot undo (bloom spill).\nusage: python3 -I tools/proj05/tunnel_residual.py <capture.png> <tunnel_coords[_all].f32> <assets_dir> <out correction.npz> [gain]\nThe coordinates come from scripts/proj05-tunnel-probe.mjs --coords (the shaders' own texture coordinates per pixel).\nWrites / updates correction.npz {wall, ring}: additive corrections in texture space (smoothed; 0 where never seen).\"\"\"\nimport os, sys\nimport numpy as np\nfrom PIL import Image\nfrom scipy.ndimage import gaussian_filter, map_coordinates\n\ncap_p, co_p, assets, out_p = sys.argv[1:5]\ngain = float(sys.argv[5]) if len(sys.argv) > 5 else 0.8\na = np.fromfile(co_p, dtype=np.float32).reshape(1536, 864, 4)\ncap = np.asarray(Image.open(cap_p).convert(\"RGB\")).astype(np.float32)\nprev = dict(np.load(out_p)) if os.path.exists(out_p) else {}\nres = {}\nfor name, fn, code, alpha in ((\"wall\", \"wall05.png\", 7, 77), (\"ring\", \"ring05.png\", 8, 78)):\n    tex = np.asarray(Image.open(os.path.join(assets, fn)).convert(\"RGB\")).astype(np.float32)\n    h, w = tex.shape[:2]\n    m = (np.abs(a[..., 2] - code) < 1e-3) & (np.abs(a[..., 3] - alpha) < 1e-3)\n    m[:204, :] = False                       # the HUD bar and the title are drawn over the canvas: not the tunnel's colour\n    corr = prev.get(name, np.zeros_like(tex))\n    if m.sum() < 100:\n        res[name] = corr; print(name, \"not in this capture\"); continue\n    u = a[..., 0][m] * w - 0.5; v = a[..., 1][m] * h - 0.5\n    t = np.stack([map_coordinates(tex[..., c], [v, u], order=1, mode=\"grid-wrap\") for c in range(3)], -1)\n    d = cap[m] - t\n    print(name, \"px\", int(m.sum()), \"mean diff RGB\", d.mean(0).round(2), \"mean abs\", float(np.abs(d).mean().round(2)), \"within 10:\", float((np.abs(d).mean(1) < 10).mean().round(3)))\n    # splat the residual into texture space (nearest texel), then a normalised blur\n    xi = np.clip(np.round(u).astype(int) % w, 0, w - 1); yi = np.clip(np.round(v).astype(int), 0, h - 1)\n    acc = np.zeros_like(tex); cnt = np.zeros((h, w), np.float32)\n    np.add.at(acc, (yi, xi), d); np.add.at(cnt, (yi, xi), 1)\n    sig = (2.0, 4.0)\n    num = np.stack([gaussian_filter(acc[..., c], sig, mode=(\"nearest\", \"wrap\")) for c in range(3)], -1)\n    den = gaussian_filter(cnt, sig, mode=(\"nearest\", \"wrap\"))\n    step = np.where(den[..., None] > 0.05, num / np.maximum(den, 1e-4)[..., None], 0.0)\n    # far outside the seen area: fade the correction out smoothly\n    seen = gaussian_filter((cnt > 0).astype(np.float32), (4.0, 12.0), mode=(\"nearest\", \"wrap\"))\n    step *= np.clip(seen * 3.0, 0, 1)[..., None]\n    res[name] = corr - gain * step\nnp.savez_compressed(out_p, **res)\n\"\"\"Screen 05 full reference match — whole-frame and per-region comparison of a REAL game capture with the APPROVED image.\nMasks: qa/pilot05/full_reference_match/masks/region_index.png (tools/match05/regions.py; every pixel in exactly one region).\nPer region and for the whole frame: pixels, mean |dRGB| (0-255, mean over channels), share within 10 / 20 levels,\nluminance SSIM (Gaussian sigma 1.5), mean signed RGB (capture - approved: colour contamination).\nThese are pixel statistics, NOT a universal \"visual similarity percentage\"; each number is reported next to its mask.\nusage: python3 -I tools/match05/metrics.py <capture.png> <out_prefix> [--proof <before.png>]\n  -> <out_prefix>REGION_METRICS.json, <out_prefix>FULL_FRAME_METRICS.json\n  --proof also writes 04_DIFFERENCE.png and 05_OVERLAY.png next to the prefix\"\"\"\nimport json, sys, os\nimport numpy as np\nfrom PIL import Image, ImageDraw\nfrom scipy.ndimage import gaussian_filter\nM = \"qa/pilot05/full_reference_match/masks\"\ncap, pre = sys.argv[1], sys.argv[2]\nap = np.asarray(Image.open(\"references/05_flow_into_the_current.png\").convert(\"RGB\"), float)\nc = np.asarray(Image.open(cap).convert(\"RGB\"), float)\nidx = np.asarray(Image.open(f\"{M}/region_index.png\"))\nnames = {v[\"id\"]: k for k, v in json.load(open(f\"{M}/regions.json\"))[\"regions\"].items()}\nd = np.abs(c - ap).mean(-1)\ndef ssim_map(a, b):\n    la, lb = (a * [0.2126, 0.7152, 0.0722]).sum(-1), (b * [0.2126, 0.7152, 0.0722]).sum(-1)\n    s = 1.5; C1, C2 = (0.01 * 255) ** 2, (0.03 * 255) ** 2\n    ma, mb = gaussian_filter(la, s), gaussian_filter(lb, s)\n    va, vb = gaussian_filter(la * la, s) - ma * ma, gaussian_filter(lb * lb, s) - mb * mb\n    cab = gaussian_filter(la * lb, s) - ma * mb\n    return ((2 * ma * mb + C1) * (2 * cab + C2)) / ((ma * ma + mb * mb + C1) * (va + vb + C2))\nsm = ssim_map(ap, c)\ndef st(m):\n    return dict(px=int(m.sum()), share_of_frame=round(float(m.mean()), 4), mean_abs=round(float(d[m].mean()), 2),\n                within_10=round(float((d[m] <= 10).mean()), 4), within_20=round(float((d[m] <= 20).mean()), 4),\n                ssim_lum=round(float(sm[m].mean()), 4), mean_signed_rgb=[round(float(v), 1) for v in (c[m] - ap[m]).mean(0)])\nreg = {names[i]: st(idx == i) for i in sorted(names)}\nfull = dict(capture=cap, whole_frame=st(np.ones_like(idx, bool)),\n            note=\"whole frame = all 864x1536 pixels, nothing excluded; pixel statistics, not a perceptual score\",\n            mse=round(float(((c - ap) ** 2).mean()), 1), psnr_db=round(float(10 * np.log10(255 ** 2 / ((c - ap) ** 2).mean())), 2))\njson.dump(dict(capture=cap, regions=reg), open(pre + \"REGION_METRICS.json\", \"w\"), indent=1)\njson.dump(full, open(pre + \"FULL_FRAME_METRICS.json\", \"w\"), indent=1)\nprint(\"FULL\", full[\"whole_frame\"])\nfor k, v in reg.items(): print(f\"{k:28s} px {v['px']:7d}  mean {v['mean_abs']:6.2f}  <=10 {v['within_10']:.3f}  <=20 {v['within_20']:.3f}  ssim {v['ssim_lum']:.3f}  signed {v['mean_signed_rgb']}\")\nif \"--proof\" in sys.argv:\n    outd = os.path.dirname(pre) or \".\"\n    # 04 difference: grey approved underlay; green <= 10, yellow 10-20, orange 20-40, red > 40 levels\n    g = np.stack([ap.mean(-1)] * 3, -1) * 0.35\n    col = np.zeros_like(g)\n    col[d <= 10] = (40, 200, 70); col[(d > 10) & (d <= 20)] = (235, 220, 40); col[(d > 20) & (d <= 40)] = (245, 140, 30); col[d > 40] = (235, 40, 40)\n    o = (g + 0.65 * col).clip(0, 255).astype(np.uint8)\n    im = Image.fromarray(o); dr = ImageDraw.Draw(im)\n    dr.rectangle([0, 1440, 863, 1535], fill=(0, 0, 0))\n    leg = [((40, 200, 70), \"within 10 levels of APPROVED\"), ((235, 220, 40), \"10-20 levels\"), ((245, 140, 30), \"20-40 levels\"), ((235, 40, 40), \"more than 40 levels\")]\n    for i, (cc, t) in enumerate(leg):\n        x = 12 + (i % 2) * 430; y = 1450 + (i // 2) * 40\n        dr.rectangle([x, y, x + 26, y + 26], fill=cc); dr.text((x + 36, y + 7), t, fill=(255, 255, 255))\n    dr.text((12, 1522), \"IMAGE 4 - DIFFERENCE: NEW vs APPROVED, mean |dRGB| per pixel (0-255)\", fill=(255, 255, 255))\n    im.save(os.path.join(outd, \"04_DIFFERENCE.png\"))\n    Image.fromarray(((ap + c) / 2).astype(np.uint8)).save(os.path.join(outd, \"05_OVERLAY.png\"))\nqa/pilot05/proj/tunnel/:\ntotal 36\ndrwxr-xr-x  6 root root 4096 Nov 16 23:23 .\ndrwxr-xr-x 16 root root 4096 Nov 16 23:31 ..\n-rw-r--r--  1 root root 8416 Nov 16 23:23 NOTES.md\ndrwxr-xr-x  3 root root 4096 Nov 16 23:23 frame\ndrwxr-xr-x  4 root root 4096 Nov 16 23:23 lid\ndrwxr-xr-x  2 root root 4096 Nov 16 23:23 model\ndrwxr-xr-x  2 root root 4096 Nov 16 23:23 probe\n\nqa/pilot05/proj/tunnel/model:\ntotal 10348\ndrwxr-xr-x 2 root root    4096 Nov 16 23:23 .\ndrwxr-xr-x 6 root root    4096 Nov 16 23:23 ..\n-rw-r--r-- 1 root root    1077 Nov 16 23:23 bake_report.json\n-rw-r--r-- 1 root root 6167080 Nov 16 23:23 correction.npz\n-rw-r--r-- 1 root root  442496 Nov 16 23:23 frame_correction.npy\n-rw-r--r-- 1 root root  131200 Nov 16 23:23 ring05_srcmap.npy\n-rw-r--r-- 1 root root    3651 Nov 16 23:23 ring_model.json\n-rw-r--r-- 1 root root 2661832 Nov 16 23:23 ring_model_overlay.png\n-rw-r--r-- 1 root root 1212544 Nov 16 23:23 wall05_srcmap.npy", "is_error": false, "tool_use_id": "toolu_012a2gQ623he5SV8hDeHa8qY", "type": "tool_result"}], "role": "user"}, "parentUuid": "8525a