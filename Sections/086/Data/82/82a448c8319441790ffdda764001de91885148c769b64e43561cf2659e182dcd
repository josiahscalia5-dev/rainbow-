    arcs=''.join(f'<li><a href="claudia-archive/{escape(n,quote=True)}">{escape(n)}</a></li>' for n in archives)
    body=f"""<h1>Screen {sid}<br>{TITLES[sid]}</h1><p><strong>{escape(facts['status'])}.</strong> {escape(facts['decision'])}</p><p>{escape(facts['motion'])}</p><p>{escape(facts['remaining'])}</p>
<h2>Opening comparison</h2><p>{escape(stats)}</p><p>{escape(archive_note)}</p>
{native_fig('APPROVED','APPROVED.jpg')}{native_fig('CLAUDIA BEFORE','BEFORE/opening.png')}{native_fig('CODEX NEW','NEW/opening.png')}
<h2>Continuous swimming</h2>
<figure><figcaption>Claudia before · <a href="BEFORE/ride.mp4">Open clip</a></figcaption><video controls playsinline preload="none" poster="BEFORE/inlet.png" src="BEFORE/ride.mp4"></video></figure>
<figure><figcaption>Codex new · <a href="NEW/ride.mp4">Open clip</a></figcaption><video controls playsinline preload="none" poster="NEW/inlet.png" src="NEW/ride.mp4"></video></figure>
<h2>Matched moving views</h2>{movement}<h2>Claudia’s saved captures</h2><ul>{arcs}</ul>
<p><a href="REPORT.md">Experiment report</a> · <a href="opening-metrics.json">Opening measurements</a> · <a href="motion-checks.json">Motion verification</a> · <a href="provenance.json">Checkpoint and settings</a></p>"""
    crops={'05':('hard-left',(0,420,245,770),'left wall slots'),
           '07':('hard-right',(40,245,250,465),'third gold paddle')}
    if sid in crops:
        chosen,box,subject=crops[sid]
        detail=dest/'detail';detail.mkdir(exist_ok=True)
        for variant in ('BEFORE','NEW'):
            with Image.open(dest/variant/(chosen+'.png')) as frame:
                frame.crop(box).save(detail/(variant+'.png'))
        (detail/'coordinates.json').write_text(json.dumps({'sourcePose':chosen,'cropBoundsXYXY':box,'nativePixelScale':1},indent=2)+'\n')
        body += f'<h2>{escape(subject.capitalize())}</h2><p>Native detail from {escape(NAMES[chosen])}. <a href="detail/BEFORE.png">Claudia before</a> · <a href="detail/NEW.png">Codex new</a></p>'
    if sid=='07' and (dest/'model').is_dir():
        body += '<h2>Editable paddle</h2><p><a href="model/screen-07-fitted-paddle.blend">Blender scene</a> · <a href="model/screen-07-fitted-paddle.glb">GLB mesh</a> · <a href="paddle-geometry-check.json">Paddle footprint</a></p>'
    if (dest/'fitted-body-only').is_dir():
        body += '<p><a href="fitted-body-only/README.md">Fitted body before repairing the supporting wall</a> · <a href="fitted-body-only/forward-10.png">Forward +10</a> · <a href="wall-diagnostic/body-forward-10-hidden.png">Object hidden for diagnosis</a> · <a href="fitted-body-only/ride.mp4">Full ride</a></p>'
    if (dest/'masked-material').is_dir():
        body += '<p><a href="masked-material/README.md">Rejected material-only pass</a> · <a href="masked-material/forward-10.png">Forward +10</a> · <a href="masked-material/ride.mp4">Full ride</a></p>'
    if (dest/'initial-trial').exists():
        body += '<h2>Rejected first pass</h2><p><a href="initial-trial/README.md">Reason</a> · <a href="initial-trial/opening.png">Opening</a> · <a href="initial-trial/forward-10.png">Forward +10</a> · <a href="initial-trial/hard-right.png">Hard right</a> · <a href="initial-trial/ride.mp4">Full ride</a></p>'
    passes=(('initial-trial','First pass'),('masked-material','Material repair on the original paddle'),('fitted-body-only','Fitted paddle before repairing its supporting wall'))
    previous=[]
    for sub,label in passes:
        group=dest/sub
        if not (group/'opening.png').exists():
            continue
        explanation=(group/'README.md').read_text().split('\n\n',1)[-1].strip()
        body_trial=f'<h1>Screen {sid}<br>{escape(label)}</h1><p>{escape(explanation)}</p>'
        score=read(group/'opening-metrics.json')
        body_trial+=f'<p>At the approved pose RGB agreement was {score["approvedVsBefore"]["within20Percent"]:.3f}% before and {score["approvedVsCandidate"]["within20Percent"]:.3f}% in this pass. <a href="opening-metrics.json">Full measurements</a></p>'
        body_trial+=native_fig('APPROVED','../APPROVED.jpg')+native_fig('CLAUDIA BEFORE','../BEFORE/opening.png')+native_fig('CODEX NEW · rejected pass','opening.png')
        body_trial+='<h2>Continuous swimming</h2><p><a href="../BEFORE/ride.mp4">Claudia before</a> · <a href="ride.mp4">This pass</a></p><h2>Matched moving views</h2>'
        for rel in sorted(group.glob('*.png')):
            if rel.stem in ('opening','opening-repeat') or rel.stem not in NAMES:
                continue
            body_trial+=f'<div class="view"><strong>{escape(NAMES[rel.stem])}</strong><br><a href="../BEFORE/{rel.name}">Claudia before</a> <a href="{rel.name}">Codex trial</a></div>'
