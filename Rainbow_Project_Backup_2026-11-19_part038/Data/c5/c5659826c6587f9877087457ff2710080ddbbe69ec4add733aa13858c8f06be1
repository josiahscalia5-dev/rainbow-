ription": "Create a doc, or apply several operations to one doc atomically.", "eager_input_streaming": true, "input_schema": {"properties": {"batch": {"type": "array"}, "container": {"properties": {"create": {"type": "object"}, "id": {"type": "string"}, "kind": {"type": "string"}}, "required": ["kind"], "type": "object"}, "opId": {"type": "string"}, "verbose": {"type": "boolean"}}, "type": "object"}, "name": "mcp__Claude_Docs__batch"}, "server": "Claude_Docs"}, {"description": "Docs guides: topic.instructions repeats the server instructions. Read it only if your client dropped them. Also topic.<name>, refusal.<code>. After a doc's birth → [\"topic.index\"].", "name": "mcp__Claude_Docs__guide", "schema": {"description": "Docs guides: topic.instructions repeats the server instructions. Read it only if your client dropped them. Also topic.<name>, refusal.<code>. After a doc's birth → [\"topic.index\"].", "eager_input_streaming": true, "input_schema": {"properties": {"items": {"description": "topic.<name> (instructions, index, editing, tabs, comments, charts, chart-definition, diagram, uploads, sharing, skill) or refusal.<code>; several per call is fine.", "type": "array"}}, "type": "object"}, "name": "mcp__Claude_Docs__guide"}, "server": "Claude_Docs"}, {"description": "Edit a tab's contents, rename a doc or tab, or change a stored value.", "name": "mcp__Claude_Docs__update", "schema": {"description": "Edit a tab's contents, rename a doc or tab, or change a stored value.", "eager_input_streaming": true, "input_schema": {"properties": {"answering": {"maxLength": 64, "type": "string"}, "container": {"properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "version": {"type": "string"}}, "required": ["kind", "id"], "type": "object"}, "engine": {"type": "string"}, "opId": {"type": "string"}, "payload": {"anyOf": [{"type": "object"}, {"type": "string"}]}, "ref": {"properties": {"id": {"type": "string"}, "object": {"enum": ["project", "file", "node", "utterance",