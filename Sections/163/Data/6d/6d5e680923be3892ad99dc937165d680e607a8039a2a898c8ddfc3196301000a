{"agentId": "ad34d9e07f4d9f7fc", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-694bda6a-x58ntq", "isSidechain": true, "message": {"content": [{"content": "#!/usr/bin/env node\n// Playwright capture of the REAL running game (WebGL) at the native reference sizes.\n//   node scripts/capture.mjs                 → screenshots/01.png … 11.png (+ qa/capture_log.json)\n//   node scripts/capture.mjs 03 07           → only those\n//   node scripts/capture.mjs --plunge        → qa/continuity/07a…07d.png descent proof frames\n//   node scripts/capture.mjs --size=1080x1920 → extra Android-size set into screenshots/1080x1920/\n//   node scripts/capture.mjs --out=DIR       → custom output dir\nimport { mkdirSync, writeFileSync } from 'node:fs';\nimport { loadPlaywright, CHROMIUM_ARGS, startVite } from './lib/pw.mjs';\n\nconst args = process.argv.slice(2);\nconst opt = Object.fromEntries(args.filter((a) => a.startsWith('--')).map((a) => { const [k, ...r] = a.slice(2).split('='); return [k, r.length ? r.join('=') : true]; }));\nlet ids = args.filter((a) => !a.startsWith('--'));\nconst NATIVE = { '03': [727, 1536] };\nconst plunge = ['07a_plunge_top', '07b_plunge_mid', '07c_plunge_bottom', '07d_entering_08'];\nif (opt.plunge) ids = plunge;\nif (!ids.length) ids = ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11'];\nconst size = typeof opt.size === 'string' ? opt.size.split('x').map(Number) : null;\nconst outDir = typeof opt.out === 'string' ? opt.out : opt.plunge ? 'qa/continuity' : size ? `screenshots/${size[0]}x${size[1]}` : 'screenshots';\nmkdirSync(outDir, { recursive: true });\nmkdirSync('qa', { recursive: true });\n\nconst { chromium } = loadPlaywright();\nconst vite = await startVite(5201);\nconst browser = await chromium.launch({ args: CHROMIUM_ARGS });\nconst log = { when: new Date().toISOString(), renderer: null, shots: [], errors: [] };\ntry {\n  for (const id of ids) {\n    const [w, h] = size ?? NATIVE[id] ?? [864, 1536];\n    const page = await browser.newPage({ viewport: { width: w, height: h }, deviceScaleFactor: 1 });\n    page.on('console', (m) => { if (m.type() === 'error') log.errors.push(`[${id}] ${m.text()}`); });\n    page.on('pageerror', (e) => log.errors.push(`[${id}] pageerror ${e.message}`));\n    await page.goto(`${vite.url}/?qa=1&dpr=1${typeof opt.q === \"string\" ? \"&\" + opt.q : \"\"}`);\n    await page.waitForFunction(() => window.__rainbow?.ready === true || window.__error, null, { timeout: 240000 });\n    const err = await page.evaluate(() => window.__error);\n    if (err) throw new Error(err);\n    if (!log.renderer) log.renderer = await page.evaluate(() => { const g = document.querySelector('canvas').getContext('webgl2'); const d = g?.getExtension('WEBGL_debug_renderer_info'); return d ? g.getParameter(d.UNMASKED_RENDERER_WEBGL) : 'unknown'; });\n    const st = await page.evaluate((cid) => window.__rainbow.goto(cid), id);\n    // let a few frames render (fonts, bloom) — time is frozen so the image is deterministic\n    await page.evaluate(() => new Promise((r) => requestAnimationFrame(() => r())));\n    await page.evaluate(() => document.fonts.ready);\n    await page.waitForTimeout(250);\n    const name = /^\\d\\d$/.test(id) ? `${id}.png` : `${id}.png`;\n    await page.screenshot({ path: `${outDir}/${name}`, timeout: 180000 });\n    const stats = await page.evaluate(() => window.__rainbow.stats());\n    // The first frame after load also counts one-time GPU work (three converts each cube env map to PMREM on\n    // first use). Render once more (after the screenshot) and report that per-frame cost as calls/tris.\n    const firstFrame = { calls: stats.calls, triangles: stats.triangles };\n    await page.evaluate(() => window.__rainbow.drawList?.());\n    const steady = await page.evaluate(() => window.__rainbow.stats());\n    Object.assign(stats, { calls: steady.calls, triangles: steady.triangles, firstFrameCalls: firstFrame.calls, firstFrameTriangles: firstFrame.triangles });\n    const state = await page.evaluate(() => window.__rainbow.state());\n    log.shots.push({ id, file: `${outDir}/${name}`, size: [w, h], checkpoint: st, state, stats });\n    console.log(id, '→', `${outDir}/${name}`, JSON.stringify({ stage: state.stage, s: state.s, y: state.bennyY, calls: stats.calls, tris: stats.triangles, modules: stats.modules }));\n    await page.close();\n  }\n} finally {\n  writeFileSync(opt.plunge ? 'qa/continuity/capture_log.json' : `qa/capture_log${size ? '_' + size.join('x') : ''}.json`, JSON.stringify(log, null, 2));\n  await browser.close();\n  await vite.close();\n----\n#!/usr/bin/env node\n// Builds the canonical character GLBs from the procedural builders and renders turntables.\n//   node scripts/export-models.mjs [benny] [girl] [--turntable-only] [--anim=walk --t=0.4]\nimport { writeFileSync, mkdirSync } from 'node:fs';\nimport { loadPlaywright, CHROMIUM_ARGS, startVite, waitDone } from './lib/pw.mjs';\n\nconst args = process.argv.slice(2);\nconst models = args.filter((a) => !a.startsWith('--'));\nconst list = models.length ? models : ['benny', 'girl'];\nconst turntableOnly = args.includes('--turntable-only');\nconst extra = args.filter((a) => a.startsWith('--') && a.includes('=')).map((a) => a.slice(2)).join('&');\nconst fileName = { benny: 'benny.glb', girl: 'rainbow_girl.glb' };\n\nconst { chromium } = loadPlaywright();\nconst vite = await startVite();\nconst browser = await chromium.launch({ args: CHROMIUM_ARGS });\nmkdirSync('assets/models', { recursive: true });\nmkdirSync('docs/characters', { recursive: true });\ntry {\n  for (const m of list) {\n    const page = await browser.newPage({ viewport: { width: 1600, height: 560 } });\n    page.on('console', (msg) => { if (msg.type() === 'error') console.error(`[${m}] ${msg.text()}`); });\n    if (!turntableOnly) {\n      await page.goto(`${vite.url}/tools/model-lab.html?model=${m}&mode=export`);\n      await waitDone(page);\n      const b64 = await page.evaluate(() => window.__glbBase64);\n      const info = await page.evaluate(() => window.__info);\n      writeFileSync(`assets/models/${fileName[m]}`, Buffer.from(b64, 'base64'));\n      console.log(`exported assets/models/${fileName[m]}`, JSON.stringify(info));\n    }\n    await page.goto(`${vite.url}/tools/model-lab.html?model=${m}&mode=turntable${extra ? '&' + extra : ''}`);\n    await waitDone(page);\n    const suffix = extra ? '_' + extra.replace(/[^a-z0-9]+/gi, '_') : '';\n    const out = `docs/characters/${m}_turntable${suffix}.png`;\n    await page.locator('#lab').screenshot({ path: out });\n    console.log('turntable', out, JSON.stringify(await page.evaluate(() => window.__info)));\n    await page.close();\n  }\n} finally {\n  await browser.close();\n  await vite.close();\n}", "is_error": false, "tool_use_id": "toolu_01Mq9PZcHSi2kkV22LDNFX5f", "type": "tool_result"}], "role": "user"}, "parentUuid": "a58fef93-c778-4add-91e8-ba5a33dccab3", "permissionDecision": {"decision": "accept", "reasonType": "rule", "ruleSource": "cliArg", "source": "config"}, "promptId": "2a3d94b0-6fde-4dc8-a6d5-3b10092b2d88", "sandboxed": false, "sessionId": "a8bc3320-c4fc-501b-8658-2d5f41052d69", "sourceToolAssistantUUID": "a58fef93-c778-4add-91e8-ba5a33dccab3", "timestamp": "2026-11-17T00:07:00.352Z", "type": "user", "userType": "external", "uuid": "c51f23be-b0e7-45cd-b2a0-f8befd62297e", "version": "2.1.326"}
