st tmpV = new THREE.Vector3();\n161\t  const doorAOpen = -1.9, doorCOpen = -1.95;\n162\t\n163\t  // ---------------------------------------------------------------- intro (01–02)\n164\t  const introUpdate = (dt: number) => {\n165\t    const t = st.t;\n166\t    const wc = (water as unknown as { controls?: { drumSwirl: number; drumAgitation: number; outro: number } }).controls;\n167\t    if (wc) {\n168\t      wc.drumAgitation = 0.35 + 0.65 * sm(T.spin - 0.5, T.spin + 0.8, t);\n169\t      wc.drumSwirl = sm(T.spin, T.spin + 1.2, t) * (1 - sm(T.drain + 0.5, T.rideStart, t));\n170\t      wc.outro = 0;\n171\t    }\n172\t    const dA = WORLD.drumA;\n173\t    const start = course.sample(0).pos;\n174\t    // --- girl: drop the load, close the door, walk away at normal pace (never looks back)\n175\t    const spots = env.roomA.spots;\n176\t    if (t < T.walk0) {\n177\t      placeGirl('A', new THREE.Vector3(1.2, spots.nearDoor.y, 7.6), Math.PI);\n178\t      girl.play(t < T.dropEnd ? 'dropLoad' : 'closeDoor', { fade: 0.25 });\n179\t    } else {\n180\t      const k = THREE.MathUtils.clamp((t - T.walk0 - 0.35) / 4.6, 0, 1);\n181\t      const from = new THREE.Vector3(1.2, spots.nearDoor.y, 7.6);\n182\t      const p = from.clone().lerp(spots.exitLeft, k);\n183\t      const dir = spots.exitLeft.clone().sub(from);\n184\t      const yawWalk = Math.atan2(dir.x, dir.z);\n185\t      const turn = sm(T.walk0, T.walk0 + 0.6, t);\n186\t      placeGirl('A', p, lerp(Math.PI, yawWalk, turn));\n187\t      girl.play('walk', { fade: 0.3 });\n188\t    }\n189\t    // --- door A\n190\t    env.doorA.rotation.y = lerp(doorAOpen, 0, sm(T.doorClose0, T.doorClose1, t));\n191\t    // --- towel bundle flies from her hands into the drum, Benny hidden inside\n192\t    const handW = girl.handR.getWorldPosition(tmpV).clone();\n193\t    const k = sm(0.35, T.dropEnd, t);\n194\t    const towelRest = start.clone().add(new THREE.Vector3(0.15, -1.25, 0.05));\n195\t    const arc = handW.clone().lerp(towelRest, k);\n196\t    arc.y += Math.sin(k * Math.PI) * 1.2;\n197\t    let sB = 0;\n198\t    if (t >= T.spin && st.stage === '01') { st.stage = '02'; hud.setStage('02'); }\n199\t    if (t < T.spin) {\n200\t      env.drumTowel.mesh.position.copy(t < 0.35 ? handW : arc);\n201\t      env.drumTowel.mesh.rotation.set(0, 0.4, 0);\n202\t      env.drumTowel.setBundle(1);\n203\t      env.drumTowel.mesh.scale.setScalar(0.62);\n204\t      // Benny inside the bundle; peeks out only once she has turned away\n205\t      const peek = sm(T.peek, T.peek + 0.7, t);\n206\t      benny.root.visible = peek > 0.02;\n207\t      benny.setExpression('peek');\n208\t      bennyPose(0, 0, st.clock, pose);\n209\t      benny.root.position.copy(start).add(new THREE.Vector3(0, -1.0 + 1.35 * peek, 0));\n210\t      benny.root.quaternion.setFromEuler(new THREE.Euler(0, Math.PI + 0.25, 0)); // facing the camera (inside drum)\n211\t      benny.update(dt, { swim: 0, steer: 0, speed: 0, time: st.clock });\n212\t    } else {\n213\t      // spin: tumble along the 02 helix, then the chute\n214\t      const u = sm(T.spin, T.rideStart, t);\n215\t      const s03 = course.stage('03').s0;\n216\t      sB = s03 * (t < T.drain ? 0.55 * sm(T.spin, T.drain, t) : 0.55 + 0.45 * sm(T.drain, T.rideStart, t));\n217\t      void u;\n218\t      benny.root.visible = true;\n219\t      benny.setExpression(t < T.drain + 1.2 ? 'dizzy' : 'happy');\n220\t      const f = bennyPose(sB, 0, st.clock, pose);\n221\t      // inside Drum A the swirl carries him along the helix itself (no ribbon surface there yet)\n222\t      const inDrum = 1 - sm(T.drain - 0.4, T.drain + 0.6, t);\n223\t      // the swirl lifts him toward the middle of the drum while he tumbles (ref 02), then he drops to the drain\n224\t      const hp = course.sample(sB).pos;\n225\t      const toAxis = sm(T.spin, T.spin + 1.0, t) * (1 - sm(T.drain - 1.6, T.drain - 0.2, t)) * 0.45;\n226\t      hp.x *= 1 - toAxis; hp.y = hp.y + (0.2 - hp.y) * toAxis;\n227\t      benny.root.position.copy(pose.pos).lerp(hp, inDrum);\n228\t      const tumble = sm(T.rideStart - 1.0, T.rideStart, t);\n229\t      // tumble = rolling cartwheels seen by the camera: face the lens, roll around the view axis\n230\t      const toCam = cam02(benny.root.position).pos.clone().sub(benny.root.position).normalize();\n231\t      const face = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 0, 1), toCam);\n232\t      const roll = new THREE.Quaternion().setFromAxisAngle(toCam, Math.sin(t * 1.7) * 0.9 + t * 1.1);\n233\t      const wobble = new THREE.Quaternion().setFromEuler(new THREE.Euler(Math.sin(t * 2.3) * 0.35, Math.sin(t * 1.9) * 0.4, 0));\n234\t      const spinQ = roll.multiply(face).multiply(wobble);\n235\t      benny.root.quaternion.copy(spinQ).slerp(pose.quat, tumble);\n236\t      benny.update(dt, { swim: 0.4, steer: 0, speed: 8, time: st.clock, tumble: tumble < 0.99 });\n237\t      // towel lags behind and unravels in the drum\n238\t      const sT = Math.max(0, sB - 2.6);\n239\t      const ft = course.sample(Math.min(sT, course.marks['02_drain'] - 1));\n240\t      env.drumTowel.mesh.position.copy(ft.pos).addScaledVector(ft.up, -0.4);\n241\t      env.drumTowel.mesh.rotation.set(t * 0.8, t * 0.5, 0.3);\n242\t      env.drumTowel.setBundle(lerp(1, 0.45, sm(T.spin, T.cp02, t)));\n243\t      env.drumTowel.mesh.scale.setScalar(lerp(0.62, 0.8, sm(T.spin, T.cp02, t)));\n244\t      void f;\n245\t    }\n246\t    st.s = sB;\n247\t    // --- floating laundry\n248\t    const sw = t < T.spin ? 0 : (t - T.spin) * 1.6;\n249\t    env.laundry.sock.position.set(Math.cos(2.3 + sw) * 2.2 - 0.6, -1.5 + Math.sin(st.clock * 1.3) * 0.15 + Math.sin(2.3 + sw) * (t < T.spin ? 0 : 1.6), 0.6 - sw * 0.25);\n250\t    env.laundry.sock.rotation.set(0.3 + sw, 0.6, 0.9 + st.clock * 0.3);\n251\t    env.laundry.shirt.position.set(-2.0 + Math.cos(0.4 + sw) * (t < T.spin ? 0 : 2.0), -1.6 + Math.sin(st.clock * 1.1 + 1) * 0.15 + (t < T.spin ? 0 : Math.sin(0.4 + sw) * 2.2), 0.9 - sw * 0.2);\n252\t    env.laundry.shirt.rotation.set(-1.15 + sw * 0.7, 0.2 + sw, 0.15);\n253\t    env.laundry.shirt.scale.setScalar(0.62);\n254\t    env.laundry.sock.scale.setScalar(0.62);\n255\t    // --- cameras\n256\t    if (t < T.spin + 0.6) {\n257\t      // 01: inside the drum looking out through the door, Benny peeking in the foreground\n258\t      camera.position.set(0.85, -1.05, -6.05);\n259\t      camera.up.set(0, 1, 0);\n260\t      camera.lookAt(-0.05, -0.2, dA.zDoor);\n261\t      setFov(64);\n262\t    } else if (t < T.drain) {\n263\t      // 02: tumbling with the swirl; the door ring above (deterministic blend from the 01 shot)\n264\t      const c2 = cam02(benny.root.position);\n265\t      const k2 = sm(T.spin + 0.6, T.spin + 1.6, t);\n266\t      const p01 = new THREE.Vector3(0.85, -1.05, -6.05), l01 = new THREE.Vector3(-0.05, -0.2, dA.zDoor);\n267\t      camera.position.copy(p01.lerp(c2.pos, k2));\n268\t      camera.up.set(0, 1, 0);\n269\t      camera.lookAt(l01.lerp(c2.look, k2));\n270\t      setFov(lerp(64, 68, k2));\n271\t    } else {\n272\t      // chute chase cam, blending into the ride camera framing for 03\n273\t      const kk = sm(T.drain, T.rideStart, t);\n274\t      const back = course.pointAt(Math.max(0, sB - 3.6), 0, 1.7);\n275\t      const look = course.pointAt(sB + 4, 0, 0.2);\n276\t      const rp = new THREE.Vector3(), rt = new THREE.Vector3(), ru = new THREE.Vector3();\n277\t      rideCam.desired(Math.max(course.stage('03').s0, sB), 0, rp, rt, ru);\n278\t      camera.position.lerp(back.lerp(rp, kk * kk), 0.15);\n279\t      camera.up.set(0, 1, 0);\n280\t      camera.lookAt(look.lerp(rt, kk * kk));\n281\t      setFov(lerp(66, 64, kk));\n282\t    }\n283\t    if (t >= T.rideStart) startRide();\n284\t  };\n285\t\n286\t  /** 02 camera: between Benny and the drum's back wall, looking past him to the door ring */\n287\t  const cam02 = (b: THREE.Vector3) => {\n288\t    const dA = WORLD.drumA;\n289\t    const door = new THREE.Vector3(0, 0.3, dA.zDoor);\n290\t    const away = b.clone().sub(door).normalize();\n291\t    const pos = b.clone().addScaledVector(away, 3.0).add(new THREE.Vector3(0, 0.35, 0));\n292\t    const rr = Math.hypot(pos.x, pos.y);\n293\t    if (rr > 2.7) { pos.x *= 2.7 / rr; pos.y *= 2.7 / rr; }\n294\t    pos.y = Math.max(pos.y, dA.waterY + 1.0);\n295\t    pos.z = THREE.MathUtils.clamp(pos.z, dA.zBack + 0.4, dA.zDoor - 1);\n296\t    const look = b.clone().lerp(door, 0.22).add(new THREE.Vector3(0, 0.45, 0));\n297\t    return { pos, look };\n298\t  };\n299\t\n300\t  const setFov = (f: number) => {\n301\t    if (Math.abs(camera.fov - f) > 0.01) { camera.fov = f; camera.updateProjectionMatrix(); }\n302\t  };\n303\t\n304\t  const startRide = () => {\n305\t    st.mode = 'ride';\n306\t    st.t = 0;\n307\t    st.s = course.stage('03').s0;\n308\t    st.lat = 0;\n309\t    hud.setVisible(true);\n310\t    setStage('03');\n311\t    rideCam.pos.copy(camera.position);\n312\t    rideCam.target.copy(camera.position).add(camera.getWorldDirection(new THREE.Vector3()).multiplyScalar(10));\n313\t    rideCam.fov = camera.fov;\n314\t    hud.showHint('Drag or hold left / right to steer');\n315\t    setTimeout(() => hud.showHint(null), 3500);\n316\t  };\n317\t\n318\t  // ---------------------------------------------------------------- ride (03–10)\n319\t  const rideUpdate = (dt: number) => {\n320\t    input.update(dt);\n321\t    const stg = course.stageAtS(st.s);\n322\t    const speed = course.prop('speed', st.s);\n323\t    st.s = Math.min(course.stage('11').s0, st.s + speed * dt);\n324\t    const halfW = course.widthAt(st.s) / 2;\n325\t    const safe = halfW - 0.75;\n326\t    st.vlat += (input.steer * 7.5 - st.vlat) * Math.min(1, dt * 8);\n327\t    st.lat = THREE.MathUtils.clamp(st.lat + st.vlat * dt, -halfW + 0.55, halfW - 0.55);\n328\t    // foam-wall bump → lose a heart (with cooldown), bounce back toward the centre\n329\t    st.bumpCooldown = Math.max(0, st.bumpCooldown - dt);\n330\t    if (Math.abs(st.lat) > safe) st.edgeTime += dt; else st.edg