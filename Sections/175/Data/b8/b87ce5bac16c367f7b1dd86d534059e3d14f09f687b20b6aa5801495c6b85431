{"agentId": "a7f5400f41865fcfd", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-e546a360-cxmton", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Gold $ coins anchored to the course (s, lateral, height). Real pickups: distance test against\n3\t * Benny each frame; collected coins pop + sparkle and the counter increments by COIN_VALUE.\n4\t * Layout follows the coin trails visible in the references (03 spiral trail, 04 left edge,\n5\t * 05/07 snaking centre line, 06 on the arch crest, 08–10 toward the towel).\n6\t */\n7\timport * as THREE from 'three';\n8\timport type { Course, StageId } from '../world/course';\n9\timport { canvasTexture } from '../world/materials';\n10\timport { coreLateral } from '../vfx/waterRibbon';\n11\t\n12\texport const COIN_VALUE = 10;\n13\t\n14\t/** scale: coin size factor (1 = 1.0 u diameter); tilt: radians the coin leans back (top away from the camera) */\n15\texport interface CoinDef { s: number; lat: number; h: number; stage: StageId; scale?: number; tilt?: number }\n16\t\n17\t/**\n18\t * 05 (ref 05, measured): ≈10 coins on the electric-cyan core winding to the VP. The nearest one is\n19\t * ≈95 px wide just above Benny's pom (474, 726), then 64 → 55 → 42 → 28 → 19 px: the spacing in depth\n20\t * grows with distance, so the gaps here grow too (C05.gap0 + k·C05.gapGrow). Coins lean back by C05.tilt\n21\t * so their face reads as a slightly flattened disc with the rim visible underneath, as in the ref.\n22\t * Before the 05 checkpoint the trail keeps a plain C05.gap0 spacing (gameplay only, never in frame).\n23\t */\n24\texport const C05 = { first: 5.7, gap0: 5.0, gapGrow: 1.5, gapMax: 8, scale: 0.9, h: 1.2, tilt: 0.8, preGap: 3.6, latK: 0.7 };\n25\t\n26\tfunction coins05(course: Course, add: (stage: StageId, s: number, lat: number, h?: number, extra?: Partial<CoinDef>) => void) {\n27\t  const a = course.stage('05');\n28\t  const sCp = course.marks['05_crest'];\n29\t  const extra = { scale: C05.scale, tilt: C05.tilt };\n30\t  const ss: number[] = [];\n31\t  // gameplay trail before the checkpoint ends 1 u behind Benny's checkpoint spot (never between him and the camera view)\n32\t  for (let s = sCp - 1; s > a.s0 + 6; s -= C05.preGap) ss.unshift(s);\n33\t  for (let k = 0, s = sCp + C05.first; s < a.s1 - 3; k++) { ss.push(s); s += Math.min(C05.gapMax, C05.gap0 + k * C05.gapGrow); }\n34\t  // latK < 1: the trail winds with the cyan core but stays inside its middle (the core half width is\n35\t  // ≥ 2 u), so the far coins converge on the VP like the ref instead of swinging out to the pink bands\n36\t  for (const s of ss) add('05', s, C05.latK * coreLateral(course, s), C05.h, extra);\n37\t}\n38\t\n39\texport function coinLayout(course: Course): CoinDef[] {\n40\t  const out: CoinDef[] = [];\n41\t  const add = (stage: StageId, s: number, lat: number, h = 0.9, extra: Partial<CoinDef> = {}) => out.push({ s, lat, h, stage, ...extra });\n42\t  const st = (id: StageId) => course.stage(id);\n43\t  // 03 — spiral trail ahead of Benny toward the drain\n44\t  { const a = st('03'); for (let i = 0; i < 9; i++) add('03', a.s0 + 6 + i * 2.7, 0.9 - i * 0.12); }\n45\t  // 04 — along the left edge of the slide\n46\t  { const a = st('04'); for (let i = 0; i < 8; i++) add('04', a.s0 + 9 + i * 3.6, -1.35); }\n47\t  // 05 — on the winding cyan core (see C05)\n48\t  coins05(course, add);\n49\t  // 06 — up and over the crest (left of centre like the ref)\n50\t  { const a = st('06'); const n = 18; for (let i = 0; i < n; i++) { const s = a.s0 + 4 + i * ((a.s1 - a.s0 - 6) / n); add('06', s, -1.3 + 0.7 * Math.sin(i * 0.4)); } }\n51\t  // 07 — winding trail, continuing down the plunge\n52\t  { const a = st('07'); const n = 24; for (let i = 0; i < n; i++) { const s = a.s0 + 6 + i * ((a.s1 - a.s0 - 10) / n); add('07', s, 1.0 * Math.sin(i * 0.5 + 1)); } }\n53\t  // 08 — S toward the platform\n54\t  { const a = st('08'); for (let i = 0; i < 8; i++) add('08', a.s0 + 3 + i * 1.9, -0.6 + 0.9 * Math.sin(i * 0.8)); }\n55\t  // 09 — arc along the left (inside of the bend, under the wave)\n56\t  { const a = st('09'); for (let i = 0; i < 9; i++) add('09', a.s0 + 1.5 + i * 1.7, -1.7 + i * 0.12); }\n57\t  // 10 — straight line into the towel tunnel\n58\t  { const a = st('10'); for (let i = 0; i < 5; i++) add('10', a.s0 + 1.5 + i * 2.0, -0.15); }\n59\t  return out;\n60\t}\n61\t\n62\texport interface CoinSystem {\n63\t  group: THREE.Group;\n64\t  defs: CoinDef[];\n65\t  collected: Uint8Array;\n66\t  /** returns number of coins picked up this frame */\n67\t  update(time: number, dt: number, bennyS: number, bennyLat: number): number;\n68\t  /** mark coins before s as collected (deterministic QA checkpoint state) or reset all */\n69\t  resetUntil(s: number): void;\n70\t}\n71\t\n72\texport function createCoins(course: Course): CoinSystem {\n73\t  const defs = coinLayout(course);\n74\t  const faceTex = canvasTexture(256, 256, (c, w, h) => {\n75\t    const g = c.createRadialGradient(w * 0.38, h * 0.32, 10, w / 2, h / 2, w * 0.55);\n76\t    g.addColorStop(0, '#ffe680');\n77\t    g.addColorStop(0.45, '#ffcf2a');\n78\t    g.addColorStop(1, '#e89200');\n79\t    c.fillStyle = g;\n80\t    c.beginPath(); c.arc(w / 2, h / 2, w / 2, 0, Math.PI * 2); c.fill();\n81\t    // raised inner rim: dark groove + bright lip\n82\t    c.lineWidth = 9;\n83\t    c.strokeStyle = '#c98200'; c.beginPath(); c.arc(w / 2 + 2, h / 2 + 2, w * 0.4, 0, Math.PI * 2); c.stroke();\n84\t    c.strokeStyle = '#fff0a0'; c.beginPath(); c.arc(w / 2 - 1, h / 2 - 1, w * 0.4, 0, Math.PI * 2); c.stroke();\n85\t    // embossed \"$\" drawn as vector strokes (font-independent: identical on every Android device):\n86\t    // light bevel up-left, dark bevel down-right, deep-gold glyph on top\n87\t    const dollar = (dx: number, dy: number, col: string, lw: number) => {\n88\t      c.save(); c.translate(dx, dy);\n89\t      c.strokeStyle = col; c.lineCap = 'round'; c.lineJoin = 'round';\n90\t      c.lineWidth = lw;\n91\t      c.beginPath();\n92\t      c.moveTo(166, 90);\n93\t      c.bezierCurveTo(150, 66, 90, 64, 90, 98);\n94\t      c.bezierCurveTo(90, 128, 166, 124, 166, 160);\n95\t      c.bezierCurveTo(166, 196, 104, 198, 88, 168);\n96\t      c.stroke();\n97\t      c.lineWidth = lw * 0.62;\n98\t      c.beginPath(); c.moveTo(128, 50); c.lineTo(128, 206); c.stroke();\n99\t      c.restore();\n100\t    };\n101\t    dollar(3, 4, '#7a3c00', 32); // drop shadow\n102\t    dollar(0, 0, '#b86400', 30); // dark outline\n103\t    dollar(0, 0, '#ffe55a', 18); // bright raised glyph\n104\t    dollar(-3, -3, '#fff8d0', 6); // top-left bevel highlight\n105\t  });\n106\t  // the cylinder cap's UVs run sideways once the coin is stood up (rotateX): turn the face art upright\n107\t  faceTex.center.set(0.5, 0.5);\n108\t  faceTex.rotation = -Math.PI / 2;\n109\t  // milled (ridged) gold edge, as on the ref coins\n110\t  const edgeTex = canvasTexture(256, 8, (c, w, h) => {\n111\t    for (let x = 0; x < w; x += 4) { c.fillStyle = (x / 4) % 2 ? '#c08000' : '#ffe070'; c.fillRect(x, 0, 4, h); }\n112\t  });\n113\t  const geo = new THREE.CylinderGeometry(0.5, 0.5, 0.2, 48, 1);\n114\t  geo.rotateX(Math.PI / 2); // faces along ±Z\n115\t  // Gold is carried mostly by EMISSIVE art (blue ≈ 0) so the pink-white candy environment and the\n116\t  // Neutral tone mapping cannot wash it to pale peach (ref face ≈ #F4C400); a dark-gold metal base\n117\t  // keeps a reflective sheen on top.\n118\t  const side = new THREE.MeshStandardMaterial({ color: '#6a4a00', metalness: 0.75, roughness: 0.3, emissive: '#ffffff', emissiveMap: edgeTex, emissiveIntensity: 1.0 });\n119\t  const face = new THREE.MeshStandardMaterial({ map: faceTex, color: '#7a5200', metalness: 0.7, roughness: 0.3, emissive: '#ffffff', emissiveMap: faceTex, emissiveIntensity: 1.15 });\n120\t  const mesh = new THREE.InstancedMesh(geo, [side, face, face], defs.length);\n121\t  mesh.frustumCulled = false;\n122\t  const group = new THREE.Group();\n123\t  