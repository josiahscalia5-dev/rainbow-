from pathlib import Path
from PIL import Image
import json,hashlib,shutil,subprocess as sp
p=Path(__file__).parent
out=Path('/workspace/library-files/Rainbow-Nov19-FittedCuff')
out.mkdir(exist_ok=True)
candidate=p/'qa-final/proof/06/NEW'
claudia=Path('/tmp/rainbow-final-fidelity.RuUP0xJ2/repos/06/experiments/codex/fidelity-06/CLAUDIA_BEFORE')
files=[(p/'S06-CODEX-character-native.png','S06-FITTED-CUFF-character-native.png'),(claudia/'hard-left.png','S06-CLAUDIA-hard-left.png')]
for pose in ['opening','crest-release','hard-left','hard-right']:
 files.append((candidate/(pose+'.png'),'S06-FITTED-CUFF-'+pose+'.png'))
if (candidate/'route.json').is_file():
 movie=candidate/'ride.mp4'
 route=json.loads((candidate/'route.json').read_text())['frames']
 v=json.loads(sp.check_output(['ffprobe','-v','error','-select_streams','v:0','-show_entries','stream=codec_name,width,height,nb_frames','-of','json',str(movie)]))['streams'][0]
 assert v['codec_name']=='h264' and v['width']==648 and v['height']==1152 and int(v['nb_frames'])==len(route)
 files.append((movie,'S06-FITTED-CUFF-swim.mp4'))
for f,name in files:
 if not f.is_file():continue
 if f.suffix=='.png':
  with Image.open(f) as img:img.verify()
 dst=out/name
 if not dst.exists():
  partial=dst.with_suffix('.partial');shutil.copyfile(f,partial);partial.replace(dst)
 assert hashlib.sha256(f.read_bytes()).digest()==hashlib.sha256(dst.read_bytes()).digest()
print(len(list(out.glob('*'))),'phone files verified')
