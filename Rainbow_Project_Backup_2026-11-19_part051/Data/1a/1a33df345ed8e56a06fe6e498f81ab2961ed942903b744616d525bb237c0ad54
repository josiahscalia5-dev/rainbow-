          "string",
          "number",
          "boolean"
        ]
      }
    },
    "required": [
      "property",
      "value"
    ]
  },
  "set_uniform": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "name": {
        "description": "Material name",
        "type": "string"
