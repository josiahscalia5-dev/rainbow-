e is modified.\nimport { mkdirSync, writeFileSync } from 'node:fs';\nimport { loadPlaywright, CHROMIUM_ARGS, startVite } from './lib/pw.mjs';\n\nconst opt = Object.fromEntries(process.argv.slice(2).filter((a) => a.startsWith('--')).map((a) => { const [k, ...r] = a.slice(2).split('='); return [k, r.length ? r.join('=') : true]; }));\nconst OUT = typeof opt.out === 'string' ? opt.out : 'qa/pilot05/proj/tunnel/probe';\nconst RAW = typeof opt.raw === 'string' ? opt.raw : OUT;\nconst Q = typeof opt.q === 'string' ? opt.q : '';\nconst ALL = !!opt.all;\nconst COORDS = !!opt.coords;   // with ?projwall05=1 / ?projring05=1: the baked-texture coordinates the shaders use (tunnel_coords.f32)\nmkdirSync(OUT, { recursive: true });\nmkdirSync(RAW, { recursive: true });\nconst W = 864, H = 1536;\n\nconst { chromium } = loadPlaywright();\nconst vite = await startVite(5233);\nconst browser = await chromium.launch({ args: CHROMIUM_ARGS });\ntry {\n  const page = await browser.newPage({ viewport: { width: W, height: H }, deviceScaleFactor: 1 });\n  page.on('pageerror', (e) => console.error('pageerror', e.message));\n  page.on('console', (m) => { if (m.type() === 'error') console.error('console', m.text()); });\n  const hide = ALL ? '' : '&hide=benny,coins&waterhide=crown,spray,bubbles,splash05,splashCrown,foamRim05,foamFlank,foamRafts';\n9://   tunnel_id.f32   864×1536×4 float32, top row first. Per pixel, the first surface the camera sees:\n14://                     real lid / far lid (object x, y, 5 / 6, 40 + instance); anything else: its own colour, alpha ≤ 1\n52:    const idMat = (expr, tag) => {\n58:          .replace('#include <begin_vertex>', '#include <begin_vertex>\\nvPUv = uv; vPPos = position;\\n#ifdef USE_INSTANCING\\nvPInst = float(gl_InstanceID);\\n#else\\nvPInst = 0.0;\\n#endif');\n63:      m.customProgramCacheKey = () => 'tunnel-probe-' + tag;\n71:      lid: idMat('vec4(vPPos.x, vPPos.y, 5.0, 40.0 + floor(vPInst + 0.5))', 'lid'),\n72:      farLid: idMat('vec4(vPPos.x, vP