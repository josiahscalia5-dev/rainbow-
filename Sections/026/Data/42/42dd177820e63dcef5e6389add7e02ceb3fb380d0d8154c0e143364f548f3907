{"agentId": "a3f810ba4510d393b", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-4f6c3e0e-5kxgr0", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Washer-world materials: procedural perforated magenta metal (round holes for drums, circumferential\n3\t * slots for tunnels), thick reflective gold, chrome, glass — all PBR (MeshStandardMaterial) so they pick\n4\t * up the candy PMREM environment, with shader patches for the perforations and glow.\n5\t */\n6\timport * as THREE from 'three';\n7\t\n8\texport interface PerforatedOptions {\n9\t  /** base metal colour */\n10\t  color?: THREE.ColorRepresentation;\n11\t  /** colour of the hole interiors */\n12\t  holeColor?: THREE.ColorRepresentation;\n13\t  /** 0 = round holes (drum), 1 = slots elongated along u (tunnel rings) */\n14\t  slot?: number;\n15\t  /** pattern repeats: holes around u (per 0..1) and per uv-unit along v */\n16\t  repeatU?: number;\n17\t  repeatV?: number;\n18\t  /** hole size relative to its cell (0..1) */\n19\t  holeSize?: number;\n20\t  emissive?: THREE.ColorRepresentation;\n21\t  emissiveIntensity?: number;\n22\t  metalness?: number;\n23\t  roughness?: number;\n24\t  side?: THREE.Side;\n25\t  /** bright stripe highlights running along v (tunnel light streaks) */\n26\t  streaks?: number;\n27\t  /** number of procedural lengthwise streaks around u (default 9) */\n28\t  streakCount?: number;\n29\t  /**\n30\t   * explicit slot half-size in CELL units [along u, along v] (overrides holeSize/slot); the cell is\n31\t   * 1/repeatU of the circumference by 1/repeatV along the tube, so world proportions follow from both\n32\t   */\n33\t  slotHalf?: [number, number];\n34\t  /** stagger every other slot row by half a cell (default true) */\n35\t  stagger?: boolean;\n36\t  /** pattern offset along v in cells (aligns slot rows between the ring bands) */\n37\t  offsetV?: number;\n38\t  /**\n39\t   * Washer-tube upgrade (05–07): pressed-metal corrugation + bevelled slot lips perturb the normal so\n40\t   * the glossy metal catches light around every slot (refs 05–07). Height amplitudes in world units.\n41\t   */\n42\t  relief?: { corrugation: number; bevel: number; bevelWidth?: number };\n43\t  /** emissive glow colour hugging every hole edge (refs: hot-pink glowing slot outlines) */\n44\t  rimColor?: THREE.ColorRepresentation;\n45\t  rimStrength?: number;\n46\t  /** warm \"light at the end of the tunnel\": emissive that grows with view distance */\n47\t  farGlow?: FarGlow;\n48\t  /** dedicated reflection environment (e.g. washerTubeEnv()) instead of scene.environment */\n49\t  envMap?: THREE.Texture | null;\n50\t  envMapIntensity?: number;\n51\t  /**\n52\t   * forced-perspective section (05 far tunnel): the geometry carries a per-vertex `fgExtra` attribute =\n53\t   * virtual minus real depth, so the distance glow / mid tint behave as if the tunnel ran on for hundreds\n54\t   * of units (see buildForcedTunnel in tube.ts)\n55\t   */\n56\t  virtualDepth?: boolean;\n57\t  /**\n58\t   * paint a far stream on the tunnel floor (forced-perspective section only): band centred on the\n59\t   * bottom (uv.x = 0.5), half width in uv.x, visible beyond `from` virtual units\n60\t   */\n61\t  river?: { halfWidth: number; from: number; core: THREE.ColorRepresentation; band: THREE.ColorRepresentation; foam: THREE.ColorRepresentation };\n62\t}\n63\t\n64\texport interface FarGlow {\n65\t  color: THREE.ColorRepresentation; near: number; far: number; strength: number;\n66\t  /** optional mid-distance tint of the metal colour (refs: walls turn violet deeper in the tunnel) */\n67\t  mid?: { color: THREE.ColorRepresentation; near: number; far: number; amount: number };\n68\t}\n69\t\n70\t/** GLSL for the distance glow, shared by the tube wall, rings and lids. With FG_VIRTUAL the distance is the\n71\t *  forced-perspective (virtual) depth: real view distance + the per-vertex/per-instance `fgExtra`. */\n72\tconst FAR_GLOW_PARS = `uniform vec3 uFarGlowColor; uniform vec3 uFarGlowRange; uniform vec3 uMidTint; uniform vec3 uMidRange;\n73\t#ifdef FG_VIRTUAL\n74\tvarying float vFgExtra;\n75\tfloat fgDist(){ return length(vViewPosition) + vFgExtra; }\n76\t#else\n77\tfloat fgDist(){ return length(vViewPosition); }\n78\t#endif\n79\tfloat farGlowK(){ float k = smoothstep(uFarGlowRange.x, uFarGlowRange.y, fgDist()); return uFarGlowRange.z * k * k; }\n80\tfloat midTintK(){ return uMidRange.z * smoothstep(uMidRange.x, uMidRange.y, fgDist()); }`;\n81\t/** vertex side of FG_VIRTUAL: `fgExtra` is a plain attribute on tube geometry, an instanced one on rings/lids */\n82\tconst FG_VIRTUAL_VERT_PARS = `#ifdef FG_VIRTUAL\n83\tattribute float fgExtra; varying float vFgExtra;\n84\t#endif`;\n85\tconst FG_VIRTUAL_VERT = `#ifdef FG_VIRTUAL\n86\tvFgExtra = fgExtra;\n87\t#endif`;\n88\t/** `solid` = 0 inside perforation holes (they stay dark), 1 on metal */\n89\tconst FAR_GLOW_APPLY = (solid = '1.0') => `{ float sol = ${solid}; float mt = midTintK() * sol; diffuseColor.rgb = mix(diffuseColor.rgb, uMidTint, mt); totalEmissiveRadiance *= 1.0 - mt * 0.5;\n90\t  float fg = farGlowK(); diffuseColor.rgb = mix(diffuseColor.rgb, uFarGlowColor, min(1.0, fg * 0.5) * sol); totalEmissiveRadiance += uFarGlowColor * fg * mix(0.35, 1.0, sol); }`;\n91\t\n92\tfunction farGlowUniforms(g: FarGlow) {\n93\t  return {\n94\t    uFarGlowColor: { value: new THREE.Color(g.color) },\n95\t    uFarGlowRange: { value: new THREE.Vector3(g.near, g.far, g.strength) },\n96\t    uMidTint: { value: new THREE.Color(g.mid?.color ?? '#ffffff') },\n97\t    uMidRange: { value: new THREE.Vector3(g.mid?.near ?? 0, g.mid?.far ?? 1, g.mid?.amount ?? 0) },\n98\t  };\n99\t}\n100\t\n101\t/**\n102\t * Adds the warm distance glow to any MeshStandardMaterial (rings, lids). The far end of the tube melts\n103\t * into a bright warm vanishing point like refs 05/07 without adding scene lights (mobile-friendly).\n104\t */\n105\texport function withFarGlow<T extends THREE.MeshStandardMaterial>(mat: T, g: FarGlow, key: string, virtualDepth = false): T {\n106\t  const uniforms = farGlowUniforms(g);\n107\t  const prev = mat.onBeforeCompile;\n108\t  if (virtualDepth) mat.defines = { ...(mat.defines ?? {}), FG_VIRTUAL: '' };\n109\t  mat.onBeforeCompile = (shader, r) => {\n110\t    prev.call(mat, shader, r);\n111\t    Object.assign(shader.uniforms, uniforms);\n112\t    if (virtualDepth) {\n113\t      shader.vertexShader = shader.vertexShader\n114\t        .replace('#include <common>', '#include <common>\\n' + FG_VIRTUAL_VERT_PARS)\n115\t        .replace('#include <project_vertex>', '#include <project_vertex>\\n' + FG_VIRTUAL_VERT);\n116\t    }\n117\t    shader.fragmentShader = shader.fragmentShader\n118\t      .replace('#include <common>', '#include <common>\\n' + FAR_GLOW_PARS)\n119\t      .replace(\n120\t        '#include <emissivemap_fragment>',\n121\t        `#include <emissivemap_fragment>\n122\t${FAR_GLOW_APPLY()}`,\n123\t      );\n124\t  };\n125\t  const prevKey = mat.customProgramCacheKey.bind(mat);\n126\t  mat.customProgramCacheKey = () => prevKey() + '|fg2-' + key + (virtualDepth ? '-v' : '');\n127\t  mat.userData.farGlow = uniforms;\n128\t  return mat;\n129\t}\n130\t\n131\t/**\n132\t * Analytic strip lights for the washer tubes (refs 05–07). Narrow light strips run the full length of\n133\t * the tunnel at evenly spaced angles around its axis. Their radiance depends only on the azimuth of the\n134\t * reflected view ray around the LOCAL tube axis, so (unlike a cube map, whose meridians pinch together\n135\t * and blur at the pole every grazing wall reflection looks into) they stay crisp at any distance and\n136\t * follow the tube through the 06 arch and the 07 plunge. The term is added to the IBL radiance, so the\n137\t * normal PBR BRDF weights it: glossy magenta panels get lengthwise white-pink streaks, every gold band\n138\t * gets evenly spaced \"marquee\" spots, and both line up radially like in the reference.\n139\t * Axis source: 'attribute' = per-vertex `tubeAxis`/`tubeUp` (buildTubeGeometry({ axisAttr: true })),\n140\t * 'instance' = local Z (axis) / local Y (up) of each instance matrix (rings, lids).\n141\t */\n142\texport interface TubeStrips {\n143\t  count: number;\n144\t  /** angular half-width of one strip (radians, before roughness widening) */\n145\t  width: number;\n146\t  intensity: number;\n147\t  color: THREE.ColorRepresentation;\n148\t  /** brightness of every other strip (default 0.7) */\n149\t  alt?: number;\n150\t}\n151\t\n152\texport function withTubeStrips<T extends THREE.MeshStandardMaterial>(mat: T, s: TubeStrips, source: 'attribute' | 'instance', key: string): T {\n153\t  const uniforms = {\n154\t    uStripColor: { value: new THREE.Color(s.color).multiplyScalar(s.intensity) },\n155\t    uStripP: { value: new THREE.Vector4(s.count, s.width, 0, s.alt ?? 0.7) },\n156\t  };\n157\t  const prev = mat.onBeforeCompile;\n158\t  mat.onBeforeCompile = (shader, r) => {\n159\t    prev.call(mat, shader, r);\n160\t    Object.assign(shader.uniforms, uniforms);\n161\t    const axis = source === 'instance'\n162\t      ? `vTubeAxis = normalize((viewMatrix * modelMatrix * instanceMatrix * vec4(0.0, 0.0, 1.0, 0.0)).xyz);\n163\tvTubeUp = normalize((viewMatrix * modelMatrix * instanceMatrix * vec4(0.0, 1.0, 0.0, 0.0)).xyz);`\n164\t      : `vTubeAxis = normalize((viewMatrix * modelMatrix * vec4(tubeAxis, 0.0)).xyz);\n165\tvTubeUp = normalize((viewMatrix * modelMatrix * vec4(tubeUp, 0.0)).xyz);`;\n166\t    shader.vertexShader = shader.vertexShader\n167\t      .replace('#include <common>', `#include <common>\n168\tvarying vec3 vTubeAxis; varying vec3 vTubeUp;\n169\t${source === 'attribute' ? 'attribute vec3 tubeAxis; attribute vec3 tubeUp;' : ''}`)\n170\t      .replace('#include <project_vertex>', `#include <project_vertex>\n171\t${axis}`);\n172\t    shader.fragmentShader = shader.fragmentShader\n173\t      .replace('#include <common>', `#include <common>\n174\tvarying vec3 vTubeAxis; varying vec3 vTubeUp; uniform vec3 uStripColor; uniform vec4 uStripP;\n175\tvec3 tubeStripRadiance(vec3 V, vec3 N, float rough){\n176\t  vec3 R = reflect(-V, N);\n177\t  vec3 A = normalize(vTubeAxis);\n178\t  vec3 E1 = normalize(vTubeUp - A * dot(vTubeUp, A));\n179\t  vec3 E2 = cross(A, E1);\n180\t  vec3 P = R - A * dot(R, A);\n181\t  float pl = length(P);\n182\t  float t = atan(dot(P, E2), dot(P, E1)) * uStripP.x / 6.2831853; // strip index space\n183\t  float fw = min(fwidth(t), fwidth(fract(t + 0.5)));\n184\t  float w0 = uStripP.y * uStripP.x / 6.2831853;            // half-width in pitch units\n185\t  float w = w0 + rough * rough * 1.5 + fw * 0.6;\n186\t  float dA = fract(t + 0.5) - 0.5;\n187\t  float k = exp(-dA * dA / (w * w)) * mix(1.0, w0 / w, 0.75);\n188\t  k *= mod(floor(t + 0.5), 2.0) > 0.5 ? uStripP.w : 1.0;\n189\t  return uStripColor * k * smoothstep(0.02, 0.12, pl);\n190\t}`)\n191\t      .replace('#include <lights_fragment_maps>', `#include <lights_fragment_maps>\n192\t#if defined( RE_IndirectSpecular )\n193\tradiance += tubeStripRadiance(geometryViewDir, geometryNormal, material.roughness);\n194\t#endif`);\n195\t  };\n196\t  const prevKey = mat.customProgramCacheKey.bind(mat);\n197\t  mat.customProgramCacheKey = () => prevKey() + '|strips-' + source + '-' + key;\n198\t  mat.userData.tubeStrips = uniforms;\n199\t  return mat;\n200\t}\n201\t\n202\texport function perforatedMetal(o: PerforatedOptions = {}): THREE.MeshStandardMaterial {\n203\t  const mat = new THREE.MeshStandardMaterial({\n204\t    color: o.color ?? '#d13fd6',\n205\t    metalness: o.metalness ?? 0.72,\n206\t    roughness: o.roughness ?? 0.26,\n207\t    emissive: new THREE.Color(o.emissive ?? '#9a1fa8'),\n208\t    emissiveIntensity: o.emissiveIntensity ?? 0.26,\n209\t    side: o.side ?? THREE.BackSide,\n210\t    envMapIntensity: o.envMapIntensity ?? 1.0,\n211\t  });\n212\t  if (o.envMap) mat.envMap = o.envMap;\n213\t  const relief = o.relief;\n214\t  // mean hole coverage of one cell (capsule area / cell area): sub-pixel slot rows fade to this instead\n215\t  // of aliasing into moiré stripes down the tunnel\n216\t  const hs = o.slotHalf ?? [((o.holeSize ?? 0.42) * ((o.slot ?? 1) ? 0.62 : 0.5)), ((o.holeSize ?? 0.42) * ((o.slot ?? 1) ? 0.24 : 0.5))];\n217\t  const rr = Math.min(hs[0], hs[1]);\n218\t  const holeCover = THREE.MathUtils.clamp(4 * hs[0] * hs[1] - (4 - Math.PI) * rr * rr, 0, 1);\n219\t  const river = o.river;\n220\t  const uniforms = {\n221\t    uHoleColor: { value: new THREE.Color(o.holeColor ?? '#2b0640') },\n222\t    uSlot: { value: o.slot ?? 1 },\n223\t    uRepeat: { value: new THREE.Vector2(o.repeatU ?? 64, o.repeatV ?? 1.2) },\n224\t    uHoleSize: { value: o.holeSize ?? 0.42 },\n225\t    uStreaks: { value: o.streaks ?? 0.35 },\n226\t    uStreakN: { value: o.streakCount ?? 9 },\n227\t    uSlotHalf: { value: new THREE.Vector2(o.slotHalf?.[0] ?? -1, o.slotHalf?.[1] ?? -1) },\n228\t    uStagger: { value: o.stagger === false ? 0 : 0.5 },\n229\t    uOffsetV: { value: o.offsetV ?? 0 },\n230\t    uRelief: { value: new THREE.Vector3(relief?.corrugation ?? 0, relief?.bevel ?? 0, relief?.bevelWidth ?? 0.09) },\n231\t    uRimColor: { value: new THREE.Color(o.rimColor ?? '#ffd1ff') },\n232\t    uRimStrength: { value: o.rimStrength ?? 0.55 },\n233\t    uHoleCover: { value: holeCover },\n234\t    uRiver: { value: new THREE.Vector2(river?.halfWidth ?? 0, river?.from ?? 0) },\n235\t    uRiverCore: { value: new THREE.Color(river?.core ?? '#000000') },\n236\t    uRiverBand: { value: new THREE.Color(river?.band ?? '#000000') },\n237\t    uRiverFoam: { value: new THREE.Color(river?.foam ?? '#000000') },\n238\t    ...(o.farGlow ? farGlowUniforms(o.farGlow) : {}),\n239\t  };\n240\t  const defines: Record<string, string> = {};\n241\t  if (relief) defines.PERF_RELIEF = '';\n242\t  if (o.farGlow) defines.PERF_FARGLOW = '';\n243\t  if (o.farGlow && o.virtualDepth) defines.FG_VIRTUAL = '';\n244\t  if (river && o.farGlow && o.virtualDepth) defines.PERF_RIVER = '';\n245\t  mat.defines = defines;\n246\t  mat.userData.perfUniforms = uniforms;\n247\t  mat.onBeforeCompile = (shader) => {\n248\t    Object.assign(shader.uniforms, uniforms);\n249\t    shader.vertexShader = shader.vertexShader\n250\t      .replace('#include <common>', '#include <common>\\nvarying vec2 vPerfUv;\\n' + FG_VIRTUAL_VERT_PARS)\n251\t      .replace('#include <uv_vertex>', '#include <uv_vertex>\\nvPerfUv = uv;\\n' + FG_VIRTUAL_VERT);\n252\t    shader.fragmentShader = shader.fragmentShader\n253\t      .replace(\n254\t        '#include <common>',\n255\t        `#include <common>\n256\tvarying vec2 vPerfUv;\n257\tuniform vec3 uHoleColor; uniform float uSlot; uniform vec2 uRepeat; uniform float uHoleSize; uniform float uStreaks;\n258\tuniform vec3 uRelief; uniform vec3 uRimColor; uniform float uRimStrength; uniform float uStreakN; uniform vec2 uSlotHalf; uniform float uStagger; uniform float uOffsetV;\n259\tuniform float uHoleCover; uniform vec2 uRiver; uniform vec3 uRiverCore; uniform vec3 uRiverBand; uniform vec3 uRiverFoam;\n260\t#ifdef PERF_FARGLOW\n261\t${FAR_GLOW_PARS}\n262\t#endif\n263\tvec2 perfCell(vec2 uv){\n264\t  vec2 g = uv * uRepeat;\n265\t  g.y += uOffsetV;\n266\t  g.x += mod(floor(g.y), 2.0) * uStagger;   // staggered rows\n267\t  return g;\n268\t}\n269\t// signed distance to the slot/hole (cell units, <0 inside)\n270\tfloat perfSdf(vec2 g){\n271\t  vec2 f = fract(g) - 0.5;\n272\t  vec2 hs = uSlotHalf.x > 0.0 ? uSlotHalf : mix(vec2(uHoleSize*0.5), vec2(uHoleSize*0.62, uHoleSize*0.24), uSlot);\n273\t  vec2 q = abs(f) - hs + min(hs.x, hs.y);\n274\t  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - min(hs.x, hs.y);\n275\t}\n276\tfloat perfMask(vec2 uv, out float rim){\n277\t  vec2 g = perfCell(uv);\n278\t  vec2 f = fract(g) - 0.5;\n279\t  float d = perfSdf(g);\n280\t  float aa = fwidth(d) * 1.2 + 1e-4;\n281\t  rim = smoothstep(0.06, 0.0, abs(d - 0.02)) * step(0.0, f.y);  // light catching the lower lip\n282\t  return 1.0 - smoothstep(-aa, aa, d); // 1 inside