#!/usr/bin/env python3
"""Deterministic gate for BlenderSculptSpec JSON (stdlib only).

Validates the spec authored in Phase 2 of the image-to-blender skill before any
build pass may run. Structural problems are always errors; --strict-quality
additionally enforces depth minimums so shallow specs cannot reach the build
phase (adapted from img2threejs's strict-quality gate).

Usage:
    validate_spec.py <spec.json> [--strict-quality]

Exit codes:
    0  spec passes (warnings possible)
    1  spec fails; errors listed in JSON report on stdout
    2  unreadable file / invalid JSON

Spec schema is documented in ../references/spec-format.md — keep both in sync.
"""

from __future__ import annotations

import json
import re
import sys

ID_RE = re.compile(r"^[a-z][a-z0-9_]*$")

CLASSES = ("object", "character", "scene")
COMPLEXITIES = ("simple", "moderate", "complex")
ROLES = ("primary", "secondary", "detail")
STRATEGIES = ("primitive", "curve", "metaball", "geonodes", "boolean", "asset")
TEXTURE_STRATEGIES = ("flat", "procedural", "polyhaven")

PASS_IDS = ("blockout", "structure", "form", "materials", "detail", "lighting")
REQUIRED_PASSES = {
    "object": set(PASS_IDS),
    "character": set(PASS_IDS),
    "scene": {"blockout", "form", "materials", "lighting"},
}
MAX_CRITERIA_PER_PASS = 5

# --strict-quality depth floors, keyed by meta.complexity
MIN_COMPONENTS = {"simple": 1, "moderate": 3, "complex": 6}
MIN_DETAILS = {"simple": 0, "moderate": 6, "complex": 12}
MIN_ANATOMY_LANDMARKS = 5


def _ids(items) -> list[str]:
    return [item.get("id") for item in items if isinstance(item, dict)]


def validate(spec: dict, strict: bool) -> dict:
    errors: list[str] = []
    warnings: list[str] = []

    def err(msg: str) -> None:
        errors.append(msg)

    def warn(msg: str) -> None:
        warnings.append(msg)

    # ---- top level -------------------------------------------------------
    for key in ("meta", "components", "materials", "passes"):
        if key not in spec:
            err(f"missing top-level key: {key}")
    if errors:
        return _report(spec, strict, errors, warnings)

    meta = spec["meta"]
    components = spec["components"]
    materials = spec["materials"]
    passes = spec["passes"]
    inventory = spec.get("detailInventory", [])

    for name, value, kind in (
        ("components", components, list),
        ("materials", materials, list),
        ("passes", passes, list),
        ("detailInventory", inventory, list),
        ("meta", meta, dict),
    ):
        if not isinstance(value, kind):
            err(f"{name} must be a {kind.__name__}")
    if errors:
        return _report(spec, strict, errors, warnings)

    # ---- meta ------------------------------------------------------------
    name = meta.get("name", "")
    if not (isinstance(name, str) and ID_RE.match(name)):
        err(f"meta.name must match {ID_RE.pattern!r} (got {name!r})")
    subject_class = meta.get("class")
    if subject_class not in CLASSES:
        err(f"meta.class must be one of {CLASSES} (got {subject_class!r})")
    complexity = meta.get("complexity")
    if complexity not in COMPLEXITIES:
        err(f"meta.complexity must be one of {COMPLEXITIES} (got {complexity!r})")
    if not meta.get("referenceImage"):
        warn("meta.referenceImage is empty; record the source image path")
    if strict and meta.get("stylization") not in ("faithful", "stylized"):
        warn("meta.stylization not set; agree on faithful vs stylized with the user")

    # ---- components ------------------------------------------------------
    comp_ids = _ids(components)
    dupes = {c for c in comp_ids if comp_ids.count(c) > 1}
    if dupes:
        err(f"duplicate component ids: {sorted(dupes)}")
    mat_ids = _ids(materials)
    mat_dupes = {m for m in mat_ids if mat_ids.count(m) > 1}
    if mat_dupes:
        err(f"duplicate material ids: {sorted(mat_dupes)}")

    comp_set = set(comp_ids)
    roots = 0
    for comp in components:
        cid = comp.get("id")
        label = f"component {cid!r}"
        if not (isinstance(cid, str) and ID_RE.match(cid)):
            err(f"{label}: id must match {ID_RE.pattern!r}")
            continue
        parent = comp.get("parent")
        if parent is None:
            roots += 1
        elif parent not in comp_set:
            err(f"{label}: parent {parent!r} does not exist")
        elif parent == cid:
            err(f"{label}: is its own parent")
        if comp.get("role") not in ROLES:
            err(f"{label}: role must be one of {ROLES}")
        if comp.get("strategy") not in STRATEGIES:
            err(f"{label}: strategy must be one of {STRATEGIES}")
        if not comp.get("buildNotes"):
            warn(f"{label}: buildNotes empty; the build pass will improvise")
        material = comp.get("material")
        if material is not None and material not in mat_ids:
            err(f"{label}: material {material!r} not defined in materials")
    if components and roots == 0:
        err("component tree has no root (every component has a parent)")

    # cycle detection over parent links
    parent_of = {
        c.get("id"): c.get("parent")
        for c in components
        if isinstance(c.get("id"), str)
    }
    for start in parent_of:
        seen = set()
        node = start
        while node is not None:
            if node in seen:
                err(f"component parent cycle involving {start!r}")
                break
            seen.add(node)
            node = parent_of.get(node)

    # ---- materials -------------------------------------------------------
    used_materials = {c.get("material") for c in components if c.get("material")}
    for mat in materials:
        mid = mat.get("id")
        label = f"material {mid!r}"
        if not (isinstance(mid, str) and ID_RE.match(mid)):
            err(f"{label}: id must match {ID_RE.pattern!r}")
            continue
        bsdf = mat.get("bsdf")
        if not isinstance(bsdf, dict) or "baseColor" not in bsdf:
            err(f"{label}: bsdf.baseColor is required")
        if mat.get("textureStrategy") not in TEXTURE_STRATEGIES:
            err(f"{label}: textureStrategy must be one of {TEXTURE_STRATEGIES}")
        if mid not in used_materials:
            warn(f"{label}: defined but not referenced by any component")

    # ---- detail inventory ------------------------------------------------
    targets = {f"component:{c}" for c in comp_set} | {f"material:{m}" for m in mat_ids}
    for item in inventory:
        iid = item.get("id", "<missing id>")
        maps_to = item.get("mapsTo")
        if maps_to not in targets:
            err(
                f"detailInventory {iid!r}: mapsTo {maps_to!r} must reference an "
                "existing 'component:<id>' or 'material:<id>'"
            )
        if not item.get("description"):
            warn(f"detailInventory {iid!r}: description empty")

    # ---- passes ----------------------------------------------------------
    pass_ids = _ids(passes)
    pass_dupes = {p for p in pass_ids if pass_ids.count(p) > 1}
    if pass_dupes:
        err(f"duplicate pass ids: {sorted(pass_dupes)}")
    unknown = [p for p in pass_ids if p not in PASS_IDS]
    if unknown:
        err(f"unknown pass ids {unknown}; allowed: {list(PASS_IDS)}")
    if subject_class in REQUIRED_PASSES:
        missing = REQUIRED_PASSES[subject_class] - set(pass_ids)
        if missing:
            err(f"class {subject_class!r} requires passes: {sorted(missing)}")
    for pass_entry in passes:
        pid = pass_entry.get("id", "<missing id>")
        criteria = pass_entry.get("criteria")
        if not (isinstance(criteria, list) and criteria):
            err(f"pass {pid!r}: criteria must be a non-empty list")
            continue
        if len(criteria) > MAX_CRITERIA_PER_PASS:
            err(
                f"pass {pid!r}: {len(criteria)} criteria > {MAX_CRITERIA_PER_PASS}; "
                "keep each pass reviewable"
            )
        if strict and complexity in ("moderate", "complex") and len(criteria) < 2:
            err(f"pass {pid!r}: {complexity} subjects need >=2 criteria per pass")

    if "reviewHistory" in spec and not isinstance(spec["reviewHistory"], list):
        err("reviewHistory must be a list when present")

    # ---- strict-quality depth gates -------------------------------------
    if strict and complexity in COMPLEXITIES:
        if len(components) < MIN_COMPONENTS[complexity]:
            err(
                f"strict: {complexity} subject needs >={MIN_COMPONENTS[complexity]} "
                f"components (got {len(components)}); the tree is too shallow"
            )
        if len(inventory) < MIN_DETAILS[complexity]:
            err(
                f"strict: {complexity} subject needs >={MIN_DETAILS[complexity]} "
                f"detailInventory entries (got {len(inventory)})"
            )
        for comp in components:
            if comp.get("role") == "primary" and not comp.get("criticalFeatures"):
                err(
                    f"strict: primary component {comp.get('id')!r} has no "
                    "criticalFeatures; name what makes it recognizable"
                )
        if subject_class == "character":
            anatomy = spec.get("anatomy")
            if not isinstance(anatomy, dict) or not anatomy.get("headsTall"):
                err("strict: character spec requires anatomy.headsTall")
            elif len(anatomy.get("landmarks", [])) < MIN_ANATOMY_LANDMARKS:
                err(
                    f"strict: character anatomy needs >={MIN_ANATOMY_LANDMARKS} "
                    "landmarks"
                )
        if subject_class == "scene":
            layout = spec.get("layout")
            if not isinstance(layout, dict) or not layout.get("camera"):
                err("strict: scene spec requires layout.camera (viewpoint description)")
            elif not layout.get("zones"):
                err("strict: scene spec requires layout.zones (>=1 spatial zone)")

    return _report(spec, strict, errors, warnings)


def _report(spec: dict, strict: bool, errors: list, warnings: list) -> dict:
    return {
        "ok": not errors,
        "mode": "strict-quality" if strict else "basic",
        "errors": errors,
        "warnings": warnings,
        "stats": {
            "components": len(spec.get("components") or []),
            "materials": len(spec.get("materials") or []),
            "details": len(spec.get("detailInventory") or []),
            "passes": len(spec.get("passes") or []),
            "reviews": len(spec.get("reviewHistory") or []),
        },
    }


def main(argv: list[str]) -> int:
    args = [a for a in argv if not a.startswith("--")]
    if not args:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    strict = "--strict-quality" in argv
    try:
        with open(args[0], "r", encoding="utf-8") as fh:
            spec = json.load(fh)
    except (OSError, json.JSONDecodeError) as exc:
        print(json.dumps({"ok": False, "errors": [f"cannot load spec: {exc}"]}))
        return 2
    if not isinstance(spec, dict):
        print(json.dumps({"ok": False, "errors": ["spec root must be an object"]}))
        return 2
    report = validate(spec, strict)
    print(json.dumps(report, indent=2))
    return 0 if report["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
