 float k = min(1.0, uMaxPx / max(px, 1e-3));\n36\t  r *= k;\n37\t  vPx = px * k;\n38\t  vFade = smoothstep(uNear, uNear * 1.8, depth) * step(0.0005, r);\n39\t  vP = position.xy;\n40\t  vSeed = aSeed;\n41\t  vec4 mvPosition = cv + vec4(position.xy * r, 0.0, 0.0);\n42\t  gl_Position = projectionMatrix * mvPosition;\n43\t  #include <fog_vertex>\n44\t}\n45\t`;\n46\tconst BIG_FRAG = /* glsl */ `\n47\tuniform float uTime;\n48\tvarying vec2 vP;\n49\tvarying float vSeed;\n50\tvarying float vFade;\n51\tvarying float vPx;\n52\t#include <fog_pars_fragment>\n53\t${NOISE_GLSL}\n54\tvoid main() {\n55\t  float d2 = dot(vP, vP);\n56\t  if (d2 > 1.0 || vFade < 0.01) discard;\n57\t  float d = sqrt(d2);\n58\t  float z = sqrt(1.0 - d2);\n59\t  float f = 1.0 - z;                                   // 0 centre → 1 silhouette\n60\t  // swirling thin film: magenta / violet / cyan bands with a little gold (ref 05)\n61\t  float sw = vnoise(vP * 2.2 + vec2(uTime * 0.3 + vSeed * 13.0, vSeed * 7.0));\n62\t  float hue = f * 0.85 + sw * 0.75 + vP.x * 0.25 - vP.y * 0.2 + vSeed;\n63\t  vec3 film = iridescent(hue);\n64\t  film = vec3(film.r, film.g * 0.55 + 0.1, min(1.0, film.b * 1.1 + 0.1));   // less green\n65\t  film *= 0.74;                                        // stay under the tone-mapping knee: saturated\n66\t  float rim = smoothstep(0.5, 0.97, d);\n67\t  float edge = smoothstep(0.88, 0.97, d) * (1.0 - smoothstep(0.975, 1.0, d));\n68\t  // window highlights: a soft bright pane up-left, a small one down-right, sparkle dots on the rim\n69\t  vec2 q1 = (vP - vec2(-0.36, 0.42)) * vec2(2.2, 3.0);\n70\t  float hl = exp(-dot(q1, q1) * 2.2) * 1.2;\n71\t  vec2 q2 = vP - vec2(0.42, -0.45);\n72\t  hl += exp(-dot(q2, q2) * 55.0) * 0.7;\n73\t  float ang = atan(vP.y, vP.x);\n74\t  hl += smoothstep(0.8, 0.93, d) * (1.0 - smoothstep(0.95, 1.0, d)) * pow(max(0.0, sin(ang * 4.0 + vSeed * 31.0)), 30.0) * 0.9;\n75\t  // tiny bubbles: keep only the ring + one glint (no shimmering detail below ~14 px)\n76\t  float small = 1.0 - smoothstep(10.0, 22.0, vPx);\n77\t  hl *= 1.0 - 0.5 * small;\n78\t  vec3 col = film * (0.55 + 0.75 * rim) + vec3(1.0) * edge * 0.45 + vec3(1.05) * hl;\n79\t  float a = 0.14 + 0.1 * sw + rim * 0.6 + edge * 0.35 + hl;\n80\t  gl_FragColor = vec4(col, clamp(a, 0.0, 0.95) * vFade);\n81\t  ${FRAG_TAIL}\n82\t}\n83\t`;\n84\t\n85\tconst PT_VERT = /* glsl */ `\n86\tattribute float aSize;\n87\tattribute float aSeed;\n88\tuniform float uScale;\n89\tuniform float uMaxPx;\n90\tvarying float vSeed;\n91\tvarying float vPx;\n92\t#include <fog_pars_vertex>\n93\tvoid main() {\n94\t  vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);\n95\t  float px = aSize * uScale / max(-mvPosition.z, 0.01);\n96\t  gl_PointSize = aSize > 0.0 ? clamp(px, 2.0, uMaxPx) : 0.0;\n97\t  vPx = gl_PointSize;\n98\t  vSeed = aSeed;\n99\t  gl_Position = projectionMatrix * mvPosition;\n100\t  #include <fog_vertex>\n101\t}\n102\t`;\n103\tconst PT_FRAG = /* glsl */ `\n104\tuniform float uTime;\n105\tvarying float vSeed;\n106\tvarying float vPx;\n107\t#include <fog_pars_fragment>\n108\t${NOISE_GLSL}\n109\tvoid main() {\n110\t  vec2 c = gl_PointCoord - 0.5;\n111\t  float d = length(c) * 2.0;\n112\t  if (d > 1.0) discard;\n113\t  float ring = smoothstep(0.5, 0.85, d) * (1.0 - smoothstep(0.9, 1.0, d));\n114\t  vec3 irid = iridescent(d * 0.7 + vSeed + atan(c.y, c.x) * 0.12);\n115\t  irid = vec3(irid.r, irid.g * 0.55 + 0.1, irid.b) * 0.8;\n116\t  float hl = smoothstep(0.26, 0.0, length(c - vec2(-0.17, -0.17)));\n117\t  vec3 col = mix(vec3(1.0), irid, 0.6) * ring * 1.2 + vec3(1.0) * hl * 1.4 + irid * 0.25;\n118\t  // tiny sprites must not read as solid white dots: keep rim + glint, fade the very smallest\n119\t  float alpha = clamp(ring * 0.8 + hl + 0.12, 0.0, 1.0) * (0.35 + 0.65 * smoothstep(3.0, 8.0, vPx));\n120\t  gl_FragColor = vec4(col, alpha);\n121\t  ${FRAG_TAIL}\n122\t}\n123\t`;\n124\t\n125\tinterface BubbleState {\n126\t  s: number;\n127\t  pos: THREE.Vector3;\n128\t  vel: THREE.Vector3;\n129\t  size: number;\n130\t  phase: number;\n131\t  age: number;\n132\t  life: number;\n133\t}\n134\t\n135\texport interface BubbleSystem {\n136\t  group: THREE.Group;\n137\t  big: THREE.InstancedMesh;\n138\t  small: THREE.Points;\n139\t  update(time: number, dt: number, focusS: number, camera: THREE.Camera, density?: number): void;\n140\t  counts: { big: number; small: number };\n141\t  /** QA: on-screen centres and diameters (px) of the bubbles currently drawn */\n142\t  qaScreen(camera: THREE.PerspectiveCamera, w: number, h: number): { big: number[][]; small: number[][] };\n143\t}\n144\t\n145\t// seeded RNG: re-seeded on every respawn-all (checkpoint jump), so QA frames are deterministic\n146\tlet rngState = 0x0b0b;\n147\tfunction rand() {\n148\t  rngState = (rngState + 0x6d2b79f5) >>> 0;\n149\t  let t = rngState;\n150\t  t = Math.imul(t ^ (t >>> 15), t | 1);\n151\t  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n152\t  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n153\t}\n154\tfunction rnd(a: number, b: number) {\n155\t  return a + rand() * (b - a);\n156\t}\n157\t\n158\t/** ride counts (visible at once in a 05-like frame) and caps, per quality tier */\n159\tconst RIDE = {\n160\t  // wave 4 (user): ≈15–20 larger soap bubbles at the sides, only a few small ones\n161\t  high: { big: 19, small: 12 },\n162\t  low: { big: 14, small: 8 },\n163\t};\n164\t/** half width (NDC x) of the no-bubble lane around the projected cyan core / coin line */\n165\tconst CORE_LANE = 0.19;\n166\tconst CORE_N = 24;\n167\t/** ride big bubbles: target on-screen diameter range (px in the 864×1536 frame), ref 05 ≈25–65 px */\n168\tconst BIG_PX: [number, number] = [25, 65];\n169\t/** max on-screen diameters (px at the capture/device resolution) */\n170\tconst MAX_PX_RIDE = 66;\n171\tconst MAX_PX_DRUM = 120;\n172\tconst MAX_PX_SMALL = 22;\n173\t\n174\texport function createBubbles(course: Course, opts: { quality: 'high' | 'low'; sStart: number }): BubbleSystem {\n175\t  const quality = opts.qualit