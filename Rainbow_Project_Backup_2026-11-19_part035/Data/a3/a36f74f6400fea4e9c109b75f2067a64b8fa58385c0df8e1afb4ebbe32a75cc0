{"agentId": "af52c8cdde18a37b5", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-4f6c3e0e-5kxgr0", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Foam banks along the stream (refs 03–10) + whirlpool rim foam.\n3\t *  - berm: ONE continuous lumpy lather bank per side, swept along the course (custom shader:\n4\t *    two-scale cellular soap bubbles with derivative bump lighting, lavender crevices, pores,\n5\t *    faint iridescent rim). This is what makes the banks read as continuous foam, not cotton balls.\n6\t *  - puffs: instanced bubble puffs sitting ON the berm crest (silhouette lumps), in ~40-unit chunks\n7\t *    so only chunks near Benny are drawn; quality 'low' halves density and uses 20-tri puffs.\n8\t *  - foam rings on the whirlpool rim and along its spiral bands (rotating with the swirl)\n9\t *  - flank banks (05, wave 4): one CONTINUOUS cloud bank per side that continues the berm down both\n10\t *    sides of the frame to Benny's level (ref 05: banks hugging BOTH edges y≈540–1300): a lather sheet\n11\t *    (berm shader, 1 draw) + world-anchored instanced puffs (1 draw), fitted to the frame edges from\n12\t *    the camera each frame. Replaces wave 3's floating \"flank\"/\"wake\" raft clumps, which read as round\n13\t *    islands on open water. Fixed pools, no per-frame allocation.\n14\t */\n15\timport * as THREE from 'three';\n16\timport { type Course, WORLD, funnelY } from '../world/course';\n17\timport { EDGE_LIFT, coreLateral } from './waterRibbon';\n18\timport { SPIRAL_C, FUNNEL_LIFT } from './whirlpool';\n19\timport { FRAG_FX_GLSL, FRAG_TAIL, NOISE_GLSL, withFog } from './glsl';\n20\t\n21\t/** c = (ambient occlusion 0..1, seed 0..1, tint -1..1) → instanceColor (see PUFF_VERT) */\n22\tinterface Puff { p: THREE.Vector3; r: number; ao: number; tint: number }\n23\t\n24\t// ---------------------------------------------------------------------------------- berm profile\n25\t/** berm spans e ∈ [BERM_IN, BERM_OUT] units outward from the ribbon edge (negative = over the water) */\n26\texport const BERM_IN = -0.6;\n27\texport const BERM_OUT = 1.2;\n28\tconst hash1 = (n: number) => { const x = Math.sin(n * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); };\n29\tconst noise1 = (x: number) => { const i = Math.floor(x), f = x - i, u = f * f * (3 - 2 * f); return hash1(i) * (1 - u) + hash1(i + 1) * u; };\n30\t/** 0..1 lumpiness of the bank at (s, side) — CPU only, baked into the mesh and the puff placement */\n31\texport function bermLump(s: number, side: number): number {\n32\t  return 0.55 * noise1(s * 0.33 + side * 31.7) + 0.45 * noise1(s * 1.05 + side * 7.3);\n33\t}\n34\t/** CPU cellular \"bubble dome\" field (0..1) so the bank silhouette is a pile of round lumps */\n35\texport function bermDomes(s: number, e: number, side: number): number {\n36\t  const gs = s / 0.95, ge = e / 0.62 + side * 11.3;\n37\t  const i0 = Math.floor(gs), j0 = Math.floor(ge);\n38\t  let best = 0;\n39\t  for (let di = -1; di <= 1; di++) for (let dj = -1; dj <= 1; dj++) {\n40\t    const i = i0 + di, j = j0 + dj;\n41\t    const ox = hash1(i * 17.13 + j * 3.71), oy = hash1(i * 5.31 + j * 19.7 + 4.2);\n42\t    const r = 0.45 + 0.4 * hash1(i * 7.7 + j * 13.1 + 9.9);\n43\t    const dx = (i + ox - gs) / r, dy = (j + oy - ge) / r;\n44\t    best = Math.max(best, 1 - (dx * dx + dy * dy));\n45\t  }\n46\t  return Math.max(0, best);\n47\t}\n48\t\n49\t/** height (along course up) of the bank surface at e units outward from the edge */\n50\texport function bermHeight(e: number, hw: number, lump: number): number {\n51\t  const uIn = Math.max(0, (hw + BERM_IN) / hw);\n52\t  const hIn = EDGE_LIFT * uIn * uIn * uIn - 0.07;\n53\t  const ep = 0.08 + 0.22 * lump;\n54\t  const hp = EDGE_LIFT + 0.14 + 0.5 * lump;\n55\t  const hOut = -0.95;\n56\t  if (e <= ep) {\n57\t    const t = Math.min(1, Math.max(0, (e - BERM_IN) / (ep - BERM_IN)));\n58\t    return hIn + (hp - hIn) * (1 - (1 - t) * (1 - t));\n59\t  }\n60\t  const t = Math.min(1, (e - ep) / (BERM_OUT - ep));\n61\t  return hp + (hOut - hp) * t * t;\n62\t}\n63\t\n64\t/** full bank surface height incl. bubble domes (shared by the mesh and the puff placement) */\n65\texport function bermSurface(s: number, e: number, side: number, hw: number): number {\n66\t  const domeK = Math.min(1, Math.max(0, (e + 0.3) / 0.35)) * Math.min(1, Math.max(0, (BERM_OUT - 0.1 - e) / 0.4));\n67\t  return bermHeight(e, hw, bermLump(s, side)) + 0.2 * domeK * Math.sqrt(bermDomes(s, e, side));\n68\t}\n69\t\n70\tconst BERM_VERT = /* glsl */ `\n71\tattribute vec3 aFoam;    // x = e (units outward from the stream edge), y = s, z = side (-1 / 1)\n72\tuniform float uTime;\n73\tvarying vec3 vFoam;\n74\tvarying vec3 vPosW;\n75\tvarying vec3 vNormalW;\n76\t#include <fog_pars_vertex>\n77\tvoid main() {\n78\t  // gentle breathing of the lather (never at the water line)\n79\t  float k = smoothstep(-0.2, 0.3, aFoam.x);\n80\t  vec3 p = position + normal * (0.03 * k * sin(uTime * 1.6 + aFoam.y * 2.1 + aFoam.z * 3.0));\n81\t  vec4 wp = modelMatrix * vec4(p, 1.0);\n82\t  vPosW = wp.xyz;\n83\t  vNormalW = normalize(mat3(modelMatrix) * normal);\n84\t  vFoam = aFoam;\n85\t  vec4 mvPosition = viewMatrix * wp;\n86\t  gl_Position = projectionMatrix * mvPosition;\n87\t  #include <fog_vertex>\n88\t}\n89\t`;\n90\t\n91\tconst BERM_FRAG = /* glsl */ `\n92\tuniform float uTime;\n93\tuniform vec2 uOutro;     // amount, chamber start s\n94\tuniform vec3 uLightDir;\n95\tvarying vec3 vFoam;\n96\tvarying vec3 vPosW;\n97\tvarying vec3 vNormalW;\n98\t#include <fog_pars_fragment>\n99\t${NOISE_GLSL}\n100\t${FRAG_FX_GLSL}\n101\tvoid main() {\n102\t  float s = vFoam.y;\n103\t  if (uOutro.x > 0.0 && s > uOutro.y - 2.0) {\n104\t    float n = vnoise(vec2(vFoam.x * 3.0, s * 0.35)) * 0.7 + 0.3;\n105\t    if (n < uOutro.x * 1.15) discard;\n106\t  }\n107\t  vec2 p = vec2(vFoam.x * vFoam.z * 1.1, s - uTime * 0.25);\n108\t  // detail fade with distance (cells per pixel)\n109\t  float fw = max(fwidth(p.x), fwidth(p.y));\n110\t  float k1 = 1.0 - smoothstep(0.12, 0.3, fw * 1.6);\n111\t  float k2 = 1.0 - smoothstep(0.12, 0.3, fw * 3.8);\n112\t  float c1 = mix(0.45, cells(p * 1.6), k1);\n113\t  #ifdef LOW_Q\n114\t  float c2 = c1;\n115\t  #else\n116\t  float c2 = mix(0.45, cells(p * 3.8 + 11.0), k2);\n117\t  #endif\n118\t  // bubble domes: bright cell centres, deep crevices between bubbles\n119\t  float bub = (1.0 - c1 * c1) * 0.6 + (1.0 - c2 * c2) * 0.4;\n120\t  vec3 N0 = normalize(vNormalW);\n121\t  if (!gl_FrontFacing) N0 = -N0;\n122\t  #ifdef LOW_Q\n123\t  vec3 N = N0;\n124\t  #else\n125\t  vec3 N = bumpNormal(vPosW, N0, bub * 0.1);\n126\t  #endif\n127\t  vec3 L = normalize(uLightDir);\n128\t  vec3 V = normalize(cameraPosition - vPosW);\n129\t  float diff = 0.55 + 0.45 * max(dot(N, L), 0.0);\n130\t  vec3 white = vec3(1.0, 1.0, 1.0);\n131\t  vec3 lav = vec3(0.7, 0.68, 0.98);\n132\t  vec3 col = mix(lav, white, 0.3 + 0.7 * clamp(N.y * 0.5 + 0.5, 0.0, 1.0)) * diff;\n133\t  col = mix(col, lav * 0.8, smoothstep(0.6, 0.95, c1) * 0.7 * k1);\n134\t  col = mix(col, lav * 0.9, smoothstep(0.65, 0.95, c2) * 0.4 * k2);\n135\t  // tiny pores (open bubbles)\n136\t  #ifndef LOW_Q\n137\t  vec2 pp = p * 7.0 + 5.0;\n138\t  float pc = cells(pp);\n139\t  float kp = 1.0 - smoothstep(0.1, 0.25, fw * 7.0);\n140\t  col = mix(col, vec3(0.58, 0.56, 0.88), (1.0 - smoothstep(0.1, 0.2, pc)) * step(0.62, hash12(floor(pp))) * 0.75 * kp);\n141\t  #endif\n142\t  float spec = pow(max(dot(reflect(-V, N), L), 0.0), 28.0);\n143\t  float fres = pow(1.0 - clamp(dot(N, V), 0.0, 1.0), 3.0);\n144\t  col += vec3(1.0) * spec * 0.45 + iridescent(fres * 1.4 + c1 * 0.6) * fres * 0.18;\n145\t  gl_FragColor = vec4(col * 0.96, 1.0);\n146\t  ${FRAG_TAIL}\n147\t}\n148\t`;\n149\t\n150\t// ---------------------------------------------------------------------------------- puffs\n151\t/**\n152\t * Soap-foam puff (ref 05 \"cloud banks\": white-lavender clumps, #FCF6FF lit tops, soft lavender\n153\t * undersides and crevices, a few darker pores, faint soap-film rim). instanceColor carries\n154\t * (x = ambient occlusion 0..1, y = seed, z = tint -1..1), not a colour.\n155\t */\n156\tconst PUFF_VERT = /* glsl */ `\n157\tuniform float uTime;\n158\tvarying vec3 vNormalW;\n159\tvarying vec3 vPosW;\n160\tvarying vec3 vLocal;\n161\tvarying vec3 vInst;\n162\t#include <fog_pars_vertex>\n163\tvoid main() {\n164\t  vInst = instanceColor;\n165\t  float br = 1.0 + 0.035 * sin(uTime * 1.7 + instanceColor.y * 40.0);\n166\t  vec4 wp = modelMatrix * instanceMatrix * vec4(position * br, 1.0);\n167\t  vPosW = wp.xyz;\n168\t  vNormalW = normalize(mat3(modelMatrix) * mat3(instanceMatrix) * normal);\n169\t  vLocal = normal;\n170\t  vec4 mvPosition = viewMatrix * wp;\n171\t  gl_Position = projectionMatrix * mvPosition;\n172\t  #include <fog_vertex>\n173\t}\n174\t`;\n175\tconst PUFF_FRAG = /* glsl */ `\n176\tuniform vec3 uLightDir;\n177\tvarying vec3 vNormalW;\n178\tvarying vec3 vPosW;\n179\tvarying vec3 vLocal;\n180\tvarying vec3 vInst;\n181\t#include <fog_pars_fragment>\n182\t${NOISE_GLSL}\n183\tvoid main() {\n184\t  vec3 N = normalize(vNormalW);\n185\t  vec3 V = normalize(cameraPosition - vPosW);\n186\t  vec3 L = normalize(uLightDir);\n187\t  float wrap = clamp(dot(N, L) * 0.55 + 0.5, 0.0, 1.0);\n188\t  float upF = clamp(N.y * 0.5 + 0.5, 0.0, 1.0);\n189\t  float lit = smoothstep(0.18, 0.88, wrap * 0.65 + upF * 0.35);\n190\t  vec3 lav = vec3(0.47, 0.44, 0.88);\n191\t  vec3 top = mix(vec3(1.1, 1.04, 1.16), vec3(1.04, 1.06, 1.16), clamp(vInst.z, 0.0, 1.0));\n192\t  top = mix(top, vec3(1.12, 1.02, 1.12), clamp(-vInst.z, 0.0, 1.0));\n193\t  vec3 col = mix(lav, top, lit);\n194\t  #ifndef LOW_Q\n195\t  // pores: small open bubbles on the puff skin (puff-local, two planar projections, no seam)\n196\t  vec3 an = abs(vLocal);\n197\t  vec2 pc = (an.x > an.z ? vLocal.zy : vLocal.xy) * 2.6 + vInst.y * 17.0;\n198\t  float cp = cells(pc);\n199\t  float kp = 1.0 - smoothstep(0.2, 0.45, fwidth(pc.x) + fwidth(pc.y));\n200\t  float pore = (1.0 - smoothstep(0.1, 0.2, cp)) * step(0.6, hash12(floor(pc) + vInst.y * 31.0));\n201\t  col = mix(col, lav * 0.95, pore * kp * 0.6 * lit);\n202\t  #endif\n203\t  // soap-film rim (cool lavender, a touch of pink) + soft glint\n204\t  float fres = pow(1.0 - clamp(dot(N, V), 0.0, 1.0), 2.4);\n205\t  col = mix(col, vec3(0.8, 0.68, 1.0), fres * 0.42);\n206\t  float spec = pow(max(dot(reflect(-V, N), L), 0.0), 26.0);\n207\t  col += vec3(1.0) * spec * 0.3;\n208\t  col *= mix(0.68, 1.0, vInst.x);\n209\t  gl_FragColor = vec4(col, 1.0);\n210\t  ${FRAG_TAIL}\n211\t}\n212\t`;\n213\t\n214\tfunction rng(seed: number) {\n215\t  let a = seed >>> 0;\n216\t  return () => {\n217\t    a = (a + 0x6d2b79f5) >>> 0;\n218\t    let t = a;\n219\t    t = Math.imul(t ^ (t >>> 15), t | 1);\n220\t    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n221\t    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n222\t  };\n223\t}\n224\t\n225\tfunction makePuffMaterial(quality: 'high' | 'low') {\n226\t  const uniforms = withFog({\n227\t    uTime: { value: 0 },\n228\t    uLightDir: { value: new THREE.Vector3(0.3, 1.0, 0.45).normalize() },\n229\t  });\n230\t  const mat = new THREE.ShaderMaterial({\n231\t    uniforms,\n232\t    vertexShader: PUFF_VERT,\n233\t    fragmentShader: PUFF_FRAG,\n234\t    fog: true,\n235\t    defines: quality === 'low' ? { LOW_Q: 1 } : {},\n236\t  });\n237\t  return { mat, uniforms };\n238\t}\n239\t\n240\t/**\n241\t * 05 flank-bank bubble: a camera-facing sphere IMPOSTOR (2 triangles) shaded like the soap puffs\n242\t * (white-lavender lit top, lavender underside, soap-film rim that reads as the crevice between piled\n243\t * bubbles, a few pores, a glint). instanceColor = (ambient occlusion, seed, tint) as for the puffs.\n244\t * The quad is pushed to the sphere's front so the lather apron and neighbours cut it like a sphere.\n245\t */\n246\tconst BANK_BUB_VERT = /* glsl */ `\n247\tvarying vec2 vP;\n248\tvarying vec3 vInst;\n249\t#include <fog_pars_vertex>\n250\tvoid main() {\n251\t  vec4 c = modelMatrix * instanceMatrix * vec4(0.0, 0.0, 0.0, 1.0);\n252\t  float r = length((instanceMatrix * vec4(1.0, 0.0, 0.0, 0.0)).xyz);\n253\t  vec4 mvPosition = viewMatrix * c;\n254\t  mvPosition.xyz += normalize(-mvPosition.xyz) * r * 0.6;\n255\t  mvPosition.xy += position.xy * r;\n256\t  vP = position.xy;\n257\t  vInst = instanceColor;\n258\t  gl_Position = projectionMatrix * mvPosition;\n259\t  #include <fog_vertex>\n260\t}\n261\t`;\n262\tconst BANK_BUB_FRAG = /* glsl */ `\n263\tuniform vec3 uLightDir;\n264\tuniform float uTime;\n265\tvarying vec2 vP;\n266\tvarying vec3 vInst;\n267\t#include <fog_pars_fragment>\n268\t${NOISE_GLSL}\n269\tvoid main() {\n270\t  float d2 = dot(vP, vP);\n271\t  if (d2 > 1.0) discard;\n272\t  float z = sqrt(1.0 - d2);\n273\t  vec3 Nv = vec3(vP, z);\n274\t  vec3 N = normalize((vec4(Nv, 0.0) * viewMatrix).xyz);   // view → world (rotation transpose)\n275\t  vec3 L = normalize(uLightDir);\n276\t  float wrap = clamp(dot(N, L) * 0.55 + 0.5, 0.0, 1.0);\n277\t  float upF = clamp(N.y * 0.5 + 0.5, 0.0, 1.0);\n278\t  float lit = smoothstep(0.15, 0.85, wrap * 0.6 + upF * 0.4);\n279\t  vec3 lav = vec3(0.5, 0.47, 0.9);\n280\t  vec3 top = mix(vec3(1.1, 1.05, 1.16), vec3(1.04, 1.07, 1.16), clamp(vInst.z, 0.0, 1.0));\n281\t  top = mix(top, vec3(1.12, 1.03, 1.13), clamp(-vInst.z, 0.0, 1.0));\n282\t  vec3 col = mix(lav, top, lit);\n283\t  // pores: one or two small open bubbles on the larger puffs\n284\t  vec2 pc = vP * 2.2 + vInst.y * 17.0;\n285\t  float cp = cells(pc);\n286\t  float kp = 1.0 - smoothstep(0.25, 0.5, fwidth(pc.x) * 2.0);\n287\t  col = mix(col, lav * 0.95, (1.0 - smoothstep(0.1, 0.2, cp)) * step(0.7, hash12(floor(pc) + vInst.y * 31.0)) * kp * 0.55 * lit);\n288\t  // soap-film rim: lavender with a hint of pink, darkest right at the silhouette (crevices in a pile)\n289\t  float fres = pow(1.0 - z, 1.8);\n290\t  col = mix(col, vec3(0.74, 0.62, 0.98), fres * 0.55);\n291\t  vec3 Lv = (viewMatrix * vec4(L, 0.0)).xyz;\n292\t  float spec = pow(max(dot(reflect(vec3(0.0, 0.0, -1.0), Nv), Lv), 0.0), 24.0);\n293\t  col += vec3(1.0) * spec * 0.32;\n294\t  col *= mix(0.7, 1.0, vInst.x);\n295\t  gl_FragColor = vec4(col, 1.0);\n296\t  ${FRAG_TAIL}\n297\t}\n298\t`;\n299\t\n300\tfunction makeBankBubbleMaterial() {\n301\t  const uniforms = withFog({\n302\t    uTime: { value: 0 },\n303\t    uLightDir: { value: new THREE.Vector3(0.3, 1.0, 0.45).normalize() },\n304\t  });\n305\t  const mat = new THREE.ShaderMaterial({ uniforms, vertexShader: BANK_BUB_VERT, fragmentShader: BANK_BUB_FRAG, fog: true });\n306\t  return { mat, uniforms };\n307\t}\n308\t\n309\t/** unit sphere puff with smooth normals (detail 0 icosahedra get flat normals by default) */\n310\tfunction puffGeometry(detail: number) {\n311\t  const g = new THREE.IcosahedronGeometry(1, detail);\n312\t  const p = g.attributes.position as THREE.BufferAttribute;\n313\t  const n = g.attributes.normal as THREE.BufferAttribute;\n314\t  const v = new THREE.Vector3();\n315\t  for (let i = 0; i < p.count; i++) { v.fromBufferAttribute(p, i).normalize(); n.setXYZ(i, v.x, v.y, v.z); }\n316\t  return g;\n317\t}\n318\t\n319\texport interface FoamSystem {\n320\t  group: THREE.Group;\n321\t  whirlGroup: THREE.Group;\n322\t  berm: THREE.Mesh;\n323\t  /** 05 flank-bank puffs (instanced, on top of `flank`) */\n324\t  rafts: THREE.InstancedMesh;\n325\t  /** 05 flank-bank lather sheet (shares the berm material) */\n326\t  flank: THREE.Mesh;\n327\t  /** Benny's waterline position on the course (call from water.wake() each riding frame) */\n328\t  rider(s: number, lat: number, strength: number): void;\n329\t  /** camera: needed in 05, where the flank banks are fitted to the frame edges */\n330\t  update(time: number, dt: number, focusS: number, outro?: number, camera?: THREE.Camera): void;\n331\t  /** QA: current flank-bank placement (kind L/R, row ds, inner-edge lateral, bank width) */\n332\t  qaRafts(): { visible: boolean; puffs: number; shown: number; clumps: { kind: string; ds: number; lat: number; k: number; y?: number; env?: number; s?: number }[] };\n333\t  instanceCount: number;\n334\t}\n335\t\n336\t// ---------------------------------------------------------------------------------- flank banks (05)\n337\t/**\n338\t * In 05 the stream fills the tube floor wall to wall (S05.extent), so from the locked chase camera the\n339\t * real stream edges and their berm leave the frame below y≈800 and the near field shows only open water.\n340\t * Ref 05 has white cloud banks hugging BOTH sides all the way down to Benny's level (left x≈0–330 over\n341\t * y≈540–1300, right x≈560–864). Wave 4: one continuous bank per side, fitted to the frame edges each\n342\t * frame from the camera (so it holds for any device aspect), not floating islands:\n343\t *  - a lather sheet (berm shader) from just below the frame bottom (ds −3.4) up the side of the frame\n344\t *    until it merges into the berm (ds +15); its inner edge sits BANK_PX px in from the frame edge\n345\t *    (lumpy, slow noise along s) and dips just under the water so the stream cuts a natural waterline;\n346\t *  - instanced puffs (rim, crest, heaps) anchored to world cells along s, so the bank stays put on the\n347\t *    water like the berm and Benny rides past it; they give the lumpy cloud silhouette.\n348\t * Never closer than BANK_CLEAR_RIDER to Benny (near him) or BANK_CLEAR_CORE to the cyan core / coin line.\n349\t */\n350\tconst BANK_DS0 = -3.4;\n351\tconst BANK_DS1 = 15;\n352\t/** puffs stop here (further ahead the berm and its own puffs take over) */\n353\tconst BANK_PUFF_DS1 = 12.5;\n354\t/** inner edge of a clump at its widest: px in from the frame edge (of an 864-px wide frame), L / R */\n355\tconst BANK_PX: [number, number] = [180, 200];\n356\t/** lateral size of a clump (px): a clump whose inner edge lies further in than this floats off the frame\n357\t * edge with water beyond it (ref 05 lower clumps x≈50–200 and 610–790) */\n358\tconst CLUMP_PX = 135;\n359\t/**\n360\t * The flank lather SHEET (berm shader) read as flat white paper with straight cut edges at the clump ends;\n361\t * the ref clumps are piled bubbles only, so wave 5 hides it and the impostor bubbles carry the clumps.\n362\t */\n363\tconst FLANK_SHEET = false;\n364\t/**\n365\t * Wave 5: world-anchored clump envelope per side, [seed, frequency along s, threshold]. The near-field bank is a\n366\t * chain of separate LOW clumps with open water between them (ref 05: left clumps y≈1016–1108 and\n367\t * 1202–1330, right y≈800–950 and 1217–1300), not a continuous strip up the frame edge (wave 4 read as\n368\t * a white wall: the outer 40 px were foam on 74 % / 100 % of the rows y 700–1400). The seeds put the\n369\t * clumps of the QA frame (s≈132.4) where the ref has them; along 05 clumps cover ≈40 % of the length.\n370\t */\n371\tconst BANK_ENV: [number, number, number][] = [[478.345, 0.85, 0.5], [127.503, 0.45, 0.54]];\n372\tconst BANK_CLEAR_RIDER = 1.3;\n373\tconst BANK_CLEAR_CORE = 1.45;\n374\t\n375\t/**\n376\t * wave 5: 0.4 in 05 (smooth ramps at the stage ends), 1 elsewhere. In 05 the stream-edge rim toward the VP\n377\t * is a LOW band of piled bubbles (ref ≈40–60 px); the full-height berm read as tall white heaps.\n378\t */\n379\tfunction bermScale05(course: Course): (s: number) => number {\n380\t  const st = course.stage('05');\n381\t  const sm = (a: number, b: number, x: number) => { const u = Math.min(1, Math.max(0, (x - a) / (b - a))); return u * u * (3 - 2 * u); };\n382\t  return (s) => 1 - 0.6 * sm(st.s0 - 6, st.s0 - 1, s) * (1 - sm(st.s1 - 1, st.s1 + 4, s));\n383\t}\n384\t/** squash the part of the bank above the stream's edge water level by k (k = 1: unchanged) */\n385\tconst squashBerm = (h: number, k: number) => (k < 1 && h > EDGE_LIFT ? EDGE_LIFT + (h - EDGE_LIFT) * k : h);\n386\t\n387\t/** continuous lather bank along both stream edges (skips the 03 whirlpool interior) */\n388\tfunction createBerm(course: Course, s0: number, s1: number, skip: [number, number], quality: 'high' | 'low') {\n389\t  const hk = bermScale05(course);\n390\t  const ds = quality === 'high' ? 0.32 : 0.8;\n391\t  const E = quality === 'high' ? [BERM_IN, -0.4, -0.25, -0.1, 0.04, 0.18, 0.34, 0.52, 0.75, 0.98, BERM_OUT] : [BERM_IN, -0.2, 0.15, 0.55, BERM_OUT];\n392\t  const rows = Math.ceil((s1 - s0) / ds) + 1;\n393\t  const C = E.length;\n394\t  const n = rows * C * 2;\n395\t  const pos = new Float32Array(n * 3);\n396\t  const foam = new Float32Array(n * 3);\n397\t  const tmp = new THREE.Vector3();\n398\t  let k = 0;\n399\t  const rowS: number[] = [];\n400\t  for (let i = 0; i < rows; i++) {\n401\t    const s = Math.min(s1, s0 + i * ds);\n402\t    rowS.push(s);\n403\t    const f = course.sample(s);\n404\t    const hw = course.widthAt(s) / 2;\n405\t    for (const side of [-1, 1]) {\n406\t      for (let j = 0; j < C; j++) {\n407\t        // left side is mirrored so every row runs inner → outer; bubble domes everywhere except\n408\t        // at the water line (keeps the lace edge flush with the stream)\n409\t        const e = E[j];\n410\t        const k05 = hk(s);\n411\t        const h = squashBerm(bermSurface(s, e, side, hw), k05);\n412\t        // 05: the outer (dry) side is laterally compressed too, so the rim is a narrow band of bubbles\n413\t        const eS = e > 0 ? e * (0.1 + 0.9 * k05) : e;\n414\t        tmp.copy(f.pos).addScaledVector(f.right, side * (hw + eS)).addScaledVector(f.up, h);\n415\t        tmp.toArray(pos, k * 3);\n416\t        foam[k * 3] = e;\n417\t        foam[k * 3 + 1] = s;\n418\t        foam[k * 3 + 2] = side;\n419\t        k++;\n420\t      }\n421\t    }\n422\t  }\n423\t  const idx: number[] = [];\n424\t  const rowStride = C * 2;\n425\t  for (let i = 0; i < rows - 1; i++) {\n426\t    const sa = rowS[i], sb = rowS[i + 1];\n427\t    if (sb > skip[0] && sa < skip[1]) continue;\n428\t    for (let sideI = 0; sideI < 2; sideI++) {\n429\t      for (let j = 0; j < C - 1; j++) {\n430\t        const a = i * rowStride + sideI * C + j, b = a + 1, c = a + rowStride, d = c + 1;\n431\t        // CCW seen from above on both sides (side +1 runs +right, side −1 runs −right)\n432\t        if (sideI === 1) idx.push(a, b, c, b, d, c);\n433\t        else idx.push(a, c, b, b, c, d);\n434\t      }\n435\t    }\n436\t  }\n437\t  const geo = new THREE.BufferGeometry();\n438\t  geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));\n439\t  geo.setAttribute('aFoam', new THREE.BufferAttribute(foam, 3));\n440\t  geo.setIndex(idx);\n441\t  geo.computeVertexNormals();\n442\t  const uniforms = withFog({\n443\t    uTime: { value: 0 },\n444\t    uOutro: { value: new THREE.Vector2(0, course.stage('08').s0) },\n445\t    uLightDir: { value: new THREE.Vector3(0.3, 1.0, 0.45).normalize() },\n446\t  });\n447\t  const mat = new THREE.ShaderMaterial({\n448\t    uniforms,\n449\t    vertexShader: BERM_VERT,\n450\t    fragmentShader: BERM_FRAG,\n451\t    fog: true,\n452\t    side: THREE.DoubleSide,\n453\t    defines: quality === 'low' ? { LOW_Q: 1 } : {},\n454\t  });\n455\t  const mesh = new THREE.Mesh(geo, mat);\n456\t  mesh.name = 'foam_berm';\n457\t  mesh.frustumCulled = false;\n458\t  return { mesh, uniforms };\n459\t}\n460\t\n461\texport function createFoam(\n462\t  course: Course,\n463\t  opts: { s0: number; s1: number; quality: 'high' | 'low'; height?: (s: number, lat: number, t: number) => number },\n464\t): FoamSystem {\n465\t  const { s0, s1, quality } = opts;\n466\t  const heightAt = opts.height ?? (() => 0);\n467\t  const rand = rng(1337);\n468\t  const density = quality === 'high' ? 1 : 0.5;\n469\t  // LOD: 80-tri puffs in the chunks around Benny, 20-tri puffs further out (low tier: 20-tri only)\n470\t  const geoHi = puffGeometry(quality === 'high' ? 1 : 0);\n471\t  const geoLo = quality === 'high' ? puffGeometry(0) : geoHi;\n472\t  const puff = makePuffMaterial(quality);\n473\t  const mat = puff.mat;\n474\t  const group = new THREE.Group();\n475\t  group.name = 'foam_banks';\n476\t  const st03 = course.stage('03'), st04 = course.stage('04');\n477\t  const chunkLen = 24;\n478\t  const chunks: { mesh: THREE.InstancedMesh; sa: number; sb: number }[] = [];\n479\t  let total = 0;\n480\t  const tmpM = new THREE.Matrix4();\n481\t  const tmpQ = new THREE.Quaternion();\n482\t  const tmpS = new THREE.Vector3();\n483\t  const tmpE = new THREE.Euler();\n484\t  const tmpC = new THREE.Color();\n485\t\n486\t  const build = (list: Puff[], parent: THREE.Object3D, sa: number, sb: number) => {\n487\t    if (!list.length) return;\n488\t    const mesh = new THREE.InstancedMesh(geoHi, mat, list.length);\n489\t    list.forEach((pf, i) => {\n490\t      tmpQ.setFromEuler(tmpE.set(rand() * 6, rand() * 6, rand() * 6));\n491\t      tmpS.set(pf.r, pf.r * (0.78 + rand() * 0.22), pf.r);\n492\t      tmpM.compose(pf.p, tmpQ, tmpS);\n493\t      mesh.setMatrixAt(i, tmpM);\n494\t      mesh.setColorAt(i, tmpC.setRGB(pf.ao, rand(), pf.tint));\n495\t    });\n496\t    mesh.instanceMatrix.needsUpdate = true;\n497\t    if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;\n498\t    mesh.computeBoundingSphere();\n499\t    parent.add(mesh);\n500\t    chunks.push({ mesh, sa, sb });\n501\t    total += list.length;\n502\t  };\n503\t\n504\t  // ---- continuous lather bank (berm) along both edges ----\n505\t  const skip: [number, number] = [st03.s0 + 4, st04.s0 - 6];\n506\t  const berm = createBerm(course, s0, s1, skip, quality);\n507\t  group.add(berm.mesh);\n508\t\n509\t  // ---- cloud banks of puffs hugging both stream edges (ref 05: 10–40 px white-lavender clumps) ----\n510\t  const inSkip = (s: number) => s > skip[0] && s < skip[1];\n511\t  // wave 5: in 05 the stream-edge rim toward the VP is a LOW rim of piled bubbles (ref ≈40–60 px), not\n512\t  // tall heaps: crest puffs × 0.85, heaps × 0.6 and never stacked. Only sizes change, so the shared\n513\t  // rand() sequence (and every other stage's foam) stays identical.\n514\t  const st05b = course.stage('05');\n515\t  const bermK = bermScale05(course);\n516\t  const low05 = (s: number) => s > st05b.s0 - 4 && s < st05b.s1 + 2;\n517\t  const addPuff = (list: Puff[], s: number, e: number, side: number, r: number, lift: number, ao: number) => {\n518\t    const ss = Math.min(s1, Math.max(s0, s));\n519\t    if (inSkip(ss)) return;\n520\t    const f = course.sample(ss);\n521\t    const hw = course.widthAt(ss) / 2;\n522\t    const k05 = bermK(ss);\n523\t    const h = squashBerm(bermSurface(ss, e, side, hw), k05) + lift;\n524\t    const eS = e > 0 ? e * (0.1 + 0.9 * k05) : e;\n525\t    const p = f.pos.clone().addScaledVector(f.right, side * (hw + eS)).addScaledVector(f.up, h);\n526\t    list.push({ p, r, ao, tint: rand() * 2 - 1 });\n527\t  };\n528\t  const step = quality === 'high' ? 0.36 : 0.62;\n529\t  for (let sa = s0; sa < s1; sa += chunkLen) {\n530\t    const sb = Math.min(s1, sa + chunkLen);\n531\t    const list: Puff[] = [];\n532\t    // skip most of 03 (the whirlpool has its own foam), keep the chute→rim hand-over\n533\t    for (let s = sa; s < sb; s += step) {\n534\t      if (inSkip(s)) continue;\n535\t      for (const side of [-1, 1]) {\n536\t        // crest puffs: the body of the bank\n537\t        const nC = quality === 'high' && rand() < 0.55 ? 2 : 1;\n538\t        for (let k = 0; k < nC; k++) {\n539\t          const r = (0.11 + rand() * 0.13) * (low05(s) ? 0.85 : 1);\n540\t          addPuff(list, s + (rand() - 0.5) * step, -0.32 + rand() * 0.82, side, r, r * (0.05 + rand() * 0.3), 0.8 + 0.2 * rand());\n541\t        }\n542\t        // small puffs right at the water line (the lacy edge of the bank)\n543\t        if (rand() < 0.65) {\n544\t          const r = 0.06 + rand() * 0.06;\n545\t          addPuff(list, s + (rand() - 0.5) * step, -0.58 + rand() * 0.28, side, r, r * 0.15, 0.9);\n546\t        }\n547\t      }\n548\t      // heaps: clusters of big puffs stacked on the crest → lumpy cloud-bank silhouette\n549\t      if (rand() < (quality === 'high' ? 0.16 : 0.1)) {\n550\t        const side = rand() < 0.5 ? -1 : 1;\n551\t        const n = 5 + ((rand() * 6) | 0);\n552\t        const ec = -0.1 + rand() * 0.55;\n553\t        const lo = low05(s);\n554\t        for (let k = 0; k < n; k++) {\n555\t          const r = (0.15 + rand() * 0.18) * (lo ? 0.6 : 1);\n556\t          const stack = k > 2 && rand() < 0.4 && !lo ? r * 0.65 : 0;\n557\t          const lift = r * (0.1 + rand() * 0.45) + stack;\n558\t          addPuff(list, s + (rand() - 0.5) * 1.8, ec + (rand() - 0.5) * 0.55, side, r, lift, 0.72 + 0.28 * Math.min(1, lift / (r * 0.9)));\n559\t        }\n560\t      }\n561\t    }\n562\t    build(list, group, sa - 2, sb + 2);\n563\t  }\n564\t\n565\t  // ---- whirlpool: rim ring + spiral band foam (rotates with the swirl) ----\n566\t  const whirlGroup = new THREE.Group();\n567\t  whirlGroup.name = 'foam_whirlpool';\n568\t  const b = WORLD.basin;\n569\t  whirlGroup.position.set(b.center.x, 0, b.center.z);\n570\t  const wl: Puff[] = [];\n571\t  // rim: cloud clusters of soap foam with a thin continuous fringe between them\n572\t  const nClusters = Math.round(26 * density);\n573\t  for (let k = 0; k < nClusters; k++) {\n574\t    const th0 = rand() * Math.PI * 2;\n575\t    const n = 10 + ((rand() * 16) | 0);\n576\t    for (let i = 0; i < n; i++) {\n577\t      const th = th0 + (rand() - 0.5) * 0.35;\n578\t      const r = b.rimRadius - 0.7 + (rand() - 0.4) * 1.3;\n579\t      const sz = 0.18 + rand() * 0.42;\n580\t      wl.push({ p: new THREE.Vector3(r * Math.sin(th), funnelY(r) + FUNNEL_LIFT + sz * 0.35 + rand() * 0.55, r * Math.cos(th)), r: sz, ao: 0.75 + 0.25 * rand(), tint: rand() * 2 - 1 });\n581\t    }\n582\t  }\n583\t  const nRim = Math.round(200 * density);\n584\t  for (let i = 0; i < nRim; i++) {\n585\t    const th = rand() * Math.PI * 2;\n586\t    const r = b.rimRadius - 0.4 + (rand() - 0.5) * 0.6;\n587\t    const sz = 0.1 + rand() * 0.18;\n588\t    wl.push({ p: new THREE.Vector3(r * Math.sin(th), funnelY(r) + FUNNEL_LIFT + sz * 0.3, r * Math.cos(th)), r: sz, ao: 0.85 + 0.15 * rand(), tint: rand() * 2 - 1 });\n589\t  }\n590\t  // along 3 spiral flow lines (constant th - C ln r) to echo the white foam bands\n591\t  const nBand = Math.round(60 * density);\n592\t  for (let i = 0; i < nBand; i++) {\n593\t    const band = ((i % 3) * Math.PI * 2) / 3 + 0.4;\n594\t    const r = 3.0 + rand() * (b.rimRadius - 3.6);\n595\t    const th = band + SPIRAL_C * Math.log(r) + (rand() - 0.5) * 0.12;\n596\t    const sz = 0.07 + rand() * 0.13;\n597\t    wl.push({ p: new THREE.Vector3(r * Math.sin(th), funnelY(r) + FUNNEL_LIFT + sz * 0.3, r * Math.cos(th)), r: sz, ao: 0.85 + 0.15 * rand(), tint: rand() * 2 - 1 });\n598\t  }\n599\t  const whirlStart = chunks.length;\n600\t  build(wl, whirlGroup, st03.s0 - 30, st04.s0 + 25);\n601\t  group.add(whirlGroup);\n602\t\n603\t  // ---- 05 flank banks: lather sheet + world-anchored bubble puffs fitted to the frame edges ----\n604\t  const st05 = course.stage('05');\n605\t  const sm = (a: number, b: number, x: number) => {\n606\t    const t = Math.min(1, Math.max(0, (x - a) / (b - a)));\n607\t    return t * t * (3 - 2 * t);\n608\t  };\n609\t  const R = quality === 'high' ? 40 : 22; // sheet rows per side\n610\t  const C = quality === 'high' ? 7 : 5; // sheet columns (inner edge → beyond the frame edge)\n611\t  const bankPos = new Float32Array(2 * R * C * 3);\n612\t  const bankFoam = new Float32Array(2 * R * C * 3);\n613\t  const bankIdx: number[] = [];\n614\t  for (let sd = 0; sd < 2; sd++) {\n615\t    for (let i = 0; i < R - 1; i++) {\n616\t      for (let j = 0; j < C - 1; j++) {\n617\t        const a = (sd * R + i) * C + j, b = a + 1, c = a + C, d = c + 1;\n618\t        quadIdx(bankIdx, sd, a, b, c, d);\n619\t      }\n620\t    }\n621\t  }\n622\t  const bankGeo = new THREE.BufferGeometry();\n623\t  bankGeo.setAttribute('position', new THREE.BufferAttribute(bankPos, 3).setUsage(THREE.DynamicDrawUsage));\n624\t  bankGeo.setAttribute('aFoam', new THREE.BufferAttribute(bankFoam, 3).setUsage(THREE.DynamicDrawUsage));\n625\t  bankGeo.setAttribute('normal', new THREE.BufferAttribute(new Float32Array(2 * R * C * 3), 3).setUsage(THREE.DynamicDrawUsage));\n626\t  bankGeo.setIndex(bankIdx);\n627\t  const flank = new THREE.Mesh(bankGeo, berm.mesh.material);\n628\t  flank.name = 'foam_flank';\n629\t  flank.frustumCulled = false;\n630\t  flank.visible = false;\n631\t  group.add(flank);\n632\t  /** row data per side (signed laterals + water heights at both bank borders), for the puffs between rows */\n633\t  const rowDs = new Float32Array(R);\n634\t  for (let i = 0; i < R; i++) rowDs[i] = BANK_DS0 + (BANK_DS1 - BANK_DS0) * Math.pow(i / (R - 1), 1.5);\n635\t  const rowIn = [new Float32Array(R), new Float32Array(R)];\n636\t  const rowOut = [new Float32Array(R), new Float32Array(R)];\n637\t  const rowHIn = [new Float32Array(R), new Float32Array(R)];\n638\t  const rowHOut = [new Float32Array(R), new Float32Array(R)];\n639\t  /** 0..1 lumpiness of the flank bank (inner-edge width): slow, so the edge never zig-zags between rows */\n640\t  const bankLump = (s: number, side: number) => 0.7 * noise1(s * 0.5 + side * 17.3) + 0.3 * noise1(s * 1.15 + side * 5.1);\n641\t  /** 0..1 clump envelope (sd 0 = left, 1 = right): 0 = no bank (open water up to the frame edge) */\n642\t  const bankEnv = (s: number, sd: number) => {\n643\t    const [seed, f, t0] = BANK_ENV[sd];\n644\t    return sm(t0, t0 + 0.12, 0.65 * noise1(s * f + seed) + 0.35 * noise1(s * f * 2.3 + seed * 1.7 + 11.0));\n645\t  };\n646\t  const rowEnv = [new Float32Array(R), new Float32Array(R)];\n647\t  /** lather apron height above the water: f = 0 inner edge (just under the water) … 1 outer */\n648\t  const bankProf = (f: number, s: number, side: number) => {\n649\t    const top = 0.035 + 0.05 * noise1(s * 1.4 + side * 9.1 + 40);\n650\t    const u = Math.min(1, f / 0.3);\n651\t    return -0.05 + (0.05 + top) * (1 - (1 - u) * (1 - u));\n652\t  };\n653\t\n654\t  // bubble puffs: camera-facing sphere impostors (2 triangles each), CELL-spaced world cells along s,\n655\t  // P puffs per cell, a ring buffer of NC cells per side\n656\t  const CELL = quality === 'high' ? 0.16 : 0.3;\n657\t  const P = quality === 'high' ? 8 : 5;\n658\t  const NC = Math.ceil((BANK_PUFF_DS1 - BANK_DS0) / CELL) + 3;\n659\t  const nRaft = 2 * NC * P;\n660\t  const rr = rng(4242);\n661\t  const bub = makeBankBubbleMaterial();\n662\t  const rafts = new THREE.InstancedMesh(new THREE.PlaneGeometry(2, 2), bub.mat, nRaft);\n663\t  rafts.name = 'foam_rafts';\n664\t  rafts.frustumCulled = false;\n665\t  rafts.renderOrder = 1;\n666\t  for (let i = 0; i < nRaft; i++) {\n667\t    const kind = i % P; // 0–1 rim, 2–3 body, 4 heap, 5 outer, 6–7 body (high) / 4 body (low)\n668\t    rafts.setColorAt(i, tmpC.setRGB(kind < 2 ? 0.86 + 0.1 * rr() : 0.8 + 0.2 * rr(), rr(), rr() * 2 - 1));\n669\t    rafts.setMatrixAt(i, tmpM.makeScale(0, 0, 0));\n670\t  }\n671\t  if (rafts.instanceColor) rafts.instanceColor.needsUpdate = true;\n672\t  rafts.visible = false;\n673\t  group.add(rafts);\n674\t  total += nRaft;\n675\t  /** per puff kind: across range [f0, f0 + df], radius [r0, r0 + dr], lift (× r above the apron), probability */\n676\t  const KIND: [number, number, number, number, number, number][] = quality === 'high'\n677\t    ? [[0.0, 0.08, 0.04, 0.045, 0.1, 1], [0.04, 0.12, 0.05, 0.04, 0.2, 1], [0.12, 0.5, 0.06, 0.06, 0.35, 1], [0.2, 0.55, 0.065, 0.06, 0.35, 1], [0.15, 0.5, 0.09, 0.05, 0.4, 0.6], [0.6, 0.4, 0.07, 0.05, 0.3, 1], [0.05, 0.9, 0.045, 0.04, 0.2, 1], [0.3, 0.65, 0.05, 0.05, 0.25, 1]]\n678\t    : [[0.0, 0.1, 0.045, 0.05, 0.15, 1], [0.12, 0.5, 0.065, 0.06, 0.35, 1], [0.15, 0.5, 0.09, 0.05, 0.4, 0.7], [0.55, 0.45, 0.07, 0.05, 0.3, 1], [0.1, 0.8, 0.055, 0.05, 0.25, 1]];\n679\t\n680\t  const rider = { s: 0, lat: 0, str: 0, target: 0, fed: false };\n681\t  const fr = { s: 0, pos: new THREE.Vector3(), tan: new THREE.Vector3(), up: new THREE.Vector3(), right: new THREE.Vector3() };\n682\t  const pP = new THREE.Vector3();\n683\t  const pv = new THREE.Vector3();\n684\t  const camPos = new THREE.Vector3();\n685\t  const qa: { kind: string; ds: number; lat: number; k: number; y?: number; env?: number; s?: number }[] = [];\n686\t  let shown = 0;\n687\t  let hBase = 0;\n688\t  /** NDC x of the water point at `lat` on the current row frame `fr` */\n689\t  const ndcX = (cam: THREE.Camera, lat: number) => pv.copy(fr.pos).addScaledVector(fr.right, lat).addScaledVector(fr.up, hBase).project(cam).x;\n690\t  /** lateral on the current row whose water point projects to NDC x = target (secant; the map is ~linear) */\n691\t  const solveLat = (cam: THREE.Camera, target: number, l0: number, l1: number) => {\n692\t    let x0 = ndcX(cam, l0) - target, x1 = ndcX(cam, l1) - target;\n693\t    for (let it = 0; it < 5 && Math.abs(x1) > 1e-4; it++) {\n694\t      const d = x1 - x0;\n695\t      if (Math.abs(d) < 1e-7) break;\n696\t      const l2 = Math.max(-14, Math.min(14, l1 - (x1 * (l1 - l0)) / d));\n697\t      l0 = l1; x0 = x1;\n698\t      l1 = l2; x1 = ndcX(cam, l1) - target;\n699\t    }\n700\t    return l1;\n701\t  };\n702\t  const hideRafts = () => {\n703\t    for (let i = 0; i < nRaft; i++) rafts.setMatrixAt(i, tmpM.makeScale(0, 0, 0));\n704\t    rafts.instanceMatrix.needsUpdate = true;\n705\t  };\n706\t\n707\t  const updateRafts = (time: number, dt: number, focusS: number, outro: number, camera?: THREE.Camera) => {\n708\t    if (!rider.fed) rider.target = 0;\n709\t    rider.fed = false;\n710\t    rider.str = dt > 0 ? rider.str + (rider.target - rider.str) * Math.min(1, dt * 4) : rider.target;\n711\t    const w = sm(st05.s0 + 2, st05.s0 + 7, focusS) * (1 - sm(st05.s1 - 7, st05.s1 - 2, focusS)) * rider.str * (1 - outro);\n712\t    qa.length = 0;\n713\t    shown = 0;\n714\t    const cam = camera as THREE.PerspectiveCamera | undefined;\n715\t    const on = w > 0.01 && !!cam && cam.isPerspectiveCamera;\n716\t    if (!on) {\n717\t      if (rafts.visible) hideRafts();\n718\t      rafts.visible = false;\n719\t      