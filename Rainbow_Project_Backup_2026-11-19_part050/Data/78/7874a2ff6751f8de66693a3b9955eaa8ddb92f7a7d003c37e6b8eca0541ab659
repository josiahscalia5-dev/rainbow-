import copy
import csv
import hashlib
import io
import json
from pathlib import Path
from zipfile import ZIP_DEFLATED, ZipFile

root = Path(__file__).parent
source = Path("/workspace/library-files/Rainbow-ChatGPT-Review")
downloads = root / "files-repository" / "Downloads"
downloads.mkdir(parents=True)
phone = root / "phone"
phone.mkdir()
groups = {"Rainbow_Visual_Images": ((4, 6, 8), (5, 7)),
          "Rainbow_Gameplay_Videos": ((4, 5, 6, 8), (7,))}
receipts = {}
for prefix, parts in groups.items():
    expected = {}
    encountered = {}
    saved = []
    with ZipFile(source / (prefix + ".zip")) as original:
        members = [m for m in original.infolist() if not m.is_dir()]
        for part, screens in enumerate(parts, 1):
            dest = downloads / f"{prefix}_Part{part:02}.zip"
            paths = tuple(f"Screen_{s:02}/" for s in screens)
            with ZipFile(dest, "x", compression=ZIP_DEFLATED, compresslevel=6) as out:
                for member in members:
                    if "/" in member.filename and not member.filename.startswith(paths):
                        continue
                    data = original.read(member)
                    expected[member.filename] = hashlib.sha256(data).hexdigest()
                    out.writestr(copy.copy(member), data)
                listed = ", ".join(f"{s:02}" for s in screens)
                out.writestr("START_HERE.md", f"# Rainbow review files\n\nThis independent ZIP contains screens {listed} from {prefix.replace('_', ' ')}. Open README_FIRST.md for camera conditions, comparison labels, source commits and limitations. Both parts together contain the complete collection. All original files keep their names and contents.\n")
            assert dest.stat().st_size < 100 * 1024 * 1024
            with ZipFile(dest) as check:
                assert check.testzip() is None
                for member in check.infolist():
                    if member.filename == "START_HERE.md":
                        continue
                    with check.open(member) as f:
                        digest = hashlib.file_digest(f, "sha256").hexdigest()
                    assert digest == expected[member.filename]
                    encountered[member.filename] = digest
            with dest.open("rb") as f:
                saved.append({"name":dest.name,"bytes":dest.stat().st_size,
                              "sha256":hashlib.file_digest(f, "sha256").hexdigest(),"screens":screens})
        assert set(encountered) == {m.filename for m in members} and encountered == expected
        receipts[prefix] = {"files":len(members),"parts":saved}
        print(prefix, len(members), [(p["name"],p["bytes"]) for p in saved], flush=True)
(root / "split-verification.json").write_text(json.dumps(receipts, indent=2))

views = {4:"PASSING_ARROWS", 5:"LAST_RIGHT_BEND", 6:"CREST_RELEASE",
         7:"TWO_THIRDS_DOWN", 8:"PLATFORM_AND_SPOUTS"}
selected = []
dest = phone / "Rainbow_Images_Phone_Review.zip"
with ZipFile(source / "Rainbow_Visual_Images.zip") as original, ZipFile(dest, "x", compression=ZIP_DEFLATED) as out:
    for stage, view in views.items():
        stage_dir = f"Screen_{stage:02}"
        key = f"SCREEN{stage:02}"
        paths = [f"{stage_dir}/{key}_APPROVED.jpg",
                 f"{stage_dir}/Current/{key}_CLAUDIA_{view}.jpg",
                 f"{stage_dir}/Current/{key}_CODEX_CANDIDATE_{view}.jpg"]
        for path in paths:
            info = original.getinfo(path)
            out.writestr(copy.copy(info), original.read(info))
        selected.extend(paths)
    rows = csv.DictReader(io.StringIO(original.read("FILE_INDEX.csv").decode("utf-8-sig")))
    index = io.StringIO()
    writer = csv.DictWriter(index, fieldnames=rows.fieldnames)
    writer.writeheader()
    for row in rows:
        if row["file_inside_this_zip"] in selected:
            writer.writerow(row)
    out.writestr("FILE_INDEX.csv", index.getvalue())
    out.writestr("FIVE_SCREEN_REPAIR_PLAN.md", original.read("FIVE_SCREEN_REPAIR_PLAN.md"))
    out.writestr("README_FIRST.md", """# Rainbow phone image review

Each screen folder contains the unchanged approved artwork and one matched pair of actual gameplay screenshots. CLAUDIA is the retained version. CODEX_CANDIDATE is an experiment awaiting the owner's review. All 15 picture files are byte-for-byte copies from the verified image collection and preserve its full pixel dimensions.

Screen 04 shows Benny passing the arrows. Screen 05 shows the final right bend. Screen 06 shows release from the rinse crest. Screen 07 shows Benny two thirds of the way down the tube. Screen 08 shows the platform and pouring spouts.

Use the artwork to judge materials, shape, color and continuity. The moving views have no approved frame at the same camera position. Compare the retained and candidate versions at their matched positions. FILE_INDEX.csv records the sources. The complete collection also has the matched openings, other steering views and historical experiments.
""")
assert dest.stat().st_size <= 10 * 1024 * 1024
with ZipFile(dest) as check, ZipFile(source / "Rainbow_Visual_Images.zip") as original:
    assert check.testzip() is None
    assert all(check.read(path) == original.read(path) for path in selected)
print("Phone image ZIP", len(selected), "unchanged image files,", dest.stat().st_size, "bytes", flush=True)
