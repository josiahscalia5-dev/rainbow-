{"agentId": "aaef40383ee292ad9", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "claude/rainbow-restore-env-setup-bxn85h", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Runtime Benny: loads the canonical assets/models/benny.glb, upgrades fur_* meshes to shell fur,\n3\t * and drives expressions + procedural secondary motion on top of the GLB clips.\n4\t */\n5\timport * as THREE from 'three';\n6\timport { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';\n7\timport type { BennyRuntime } from '../types';\n8\timport { makeFur, type FurHandle, type FurParams } from './fur';\n9\timport { BENNY05, FUR05, applyBenny05, dampedClips, loadBenny05Maps } from './benny05';\n10\t\n11\tconst BENNY_URL = new URL('../../../assets/models/benny.glb', import.meta.url).href;\n12\t\n13\tlet cached: Promise<THREE.Group> | null = null;\n14\t\n15\tfunction loadScene(): Promise<THREE.Group> {\n16\t  if (!cached) cached = new GLTFLoader().loadAsync(BENNY_URL).then((g) => {\n17\t    const s = g.scene as THREE.Group;\n18\t    s.userData.animations = g.animations;\n19\t    return s;\n20\t  });\n21\t  return cached;\n22\t}\n23\t\n24\t/** fur tier: explicit option, else `?quality=low|high`, else low on Android/iOS (same rule as the water) */\n25\tfunction defaultFurQuality(): 'high' | 'low' {\n26\t  if (typeof location === 'undefined') return 'high';\n27\t  const qp = new URLSearchParams(location.search).get('quality');\n28\t  const mobile = typeof navigator !== 'undefined' && /Android|iPhone|iPad/i.test(navigator.userAgent);\n29\t  return qp === 'low' || (qp !== 'high' && mobile) ? 'low' : 'high';\n30\t}\n31\t\n32\texport async function loadBenny(opts: { furQuality?: 'high' | 'low' } = {}): Promise<BennyRuntime> {\n33\t  const src = await loadScene();\n34\t  const clips: THREE.AnimationClip[] = src.userData.animations ?? [];\n35\t  // `?benny05=1` / `?match05=1` only: the maps baked from the approved Screen 05 (benny05.ts)\n36\t  const maps05 = BENNY05 ? await loadBenny05Maps() : undefined;\n37\t  return createBennyRuntime(src.clone(true), clips, { furQuality: opts.furQuality ?? defaultFurQuality(), maps05 });\n38\t}\n39\t\n40\t/**\n41\t * Ride height. The game places the root at water surface + radius·0.55 (≈ 0.44), which buried the lower\n42\t * third of the plush ball in the opaque stream. While riding (swim ≥ 0.5, not tumbling) the model is\n43\t * lifted inside the root so he sits ON the water like refs 04–10: only the bottom of the fur and the\n44\t * kicking feet are under the surface. Cinematics (01 peek, 02 tumble, 11 hide) keep the root as placed.\n45\t * Wave 4: 0.30 → 0.22 together with the ride lean, which shows more of his back: keeps the pom-pom top at the\n46\t * ref-05 height (≈ 765 px, under the first coin) and the cuff bottom where the ref has it.\n47\t * Wave 5: 0.22 → 0.12. Measured in the live 05 capture with the re-exported GLB (flat-ID mask): 0.22 put the pom top at\n48\t * 748 and the bottom at 1178; 0.12 gives bbox x 231–612 / y 766–1188, cuff bottom 1029, hat incl. pom 62 % / body 38 %\n49\t * (ref 05: x 230–612 / y 767–≈1185, cuff bottom ≈ 1028).\n50\t */\n51\texport const BENNY_RIDE_LIFT = 0.12;\n52\t/** QA A/B hook: `?bennyLift=<units>` overrides the ride lift (e.g. 0 = the game's raw placement) */\n53\tfunction rideLift(): number {\n54\t  if (typeof location === 'undefined') return BENNY_RIDE_LIFT;\n55\t  const v = parseFloat(new URLSearchParams(location.search).get('bennyLift') ?? '');\n56\t  return Number.isFinite(v) ? THREE.MathUtils.clamp(v, 0, 0.6) : BENNY_RIDE_LIFT;\n57\t}\n58\t\n59\t/**\n60\t * Ride lean (rad, about his X axis, + = top forward). While riding he leans into the current like a swimmer, so the\n61\t * rear chase cameras (04–10: ≈ 25° above him) see the beanie and the plush back the way the references paint\n62\t * them (≈ 10–12° above: knit stripes and cuff read as level bands, the dome as a tall cap, not a flat disc).\n63\t * Eased in with the