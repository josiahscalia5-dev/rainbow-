"""Build the two isolated trial records and bind each displayed asset to its source."""
from pathlib import Path
import hashlib, json, shutil, subprocess as sp, sys

main = Path(__file__).parent.resolve()
sid = sys.argv[1]
fitted = len(sys.argv)>2 and sys.argv[2]=='cuff'
assert sid in ('04','06')
root = main/('entrance-gold' if sid == '04' else ('benny-cuff' if fitted else 'benny-material'))
repo = root/'repos'/sid
previous = Path('/tmp/rainbow-final-fidelity.RuUP0xJ2/repos')/sid/'experiments/codex'/('fidelity-'+sid)
skill = Path('/tmp/rainbow-reconstruction.etSm9SmK/repos/skill/.agents/skills/rainbow-visual-motion-matcher/scripts')
skill_sha = '3b57658f78fd5d7dce498d2743f1a09a173a570a'
def load(p): return json.loads(p.read_text())
def write(p, value):
    p.parent.mkdir(parents=True,exist_ok=True)
    p.write_text(json.dumps(value,indent=2,ensure_ascii=False)+'\n')
def copy(a, b):
    b.parent.mkdir(parents=True,exist_ok=True)
    shutil.copyfile(a,b)
def tree(a,b):
    for f in sorted(a.rglob('*')):
        if f.is_file(): copy(f,b/f.relative_to(a))
def sha(f):
    with f.open('rb') as input_file: return hashlib.file_digest(input_file,'sha256').hexdigest()
base = load(root/('baseline-'+sid+'.json'))
src = load(root/('checkpoint-'+sid+'.json'))
probe = load(root/('quality-'+sid+'.json'))
review = load(root/('decision-'+sid+'.json'))
original = main/'from-original-github'/base['approved']['path']
exact = load(main/'original-github-artwork.json')['screens'][sid]
assert exact['retained'] == src['retained'] and exact['sha256'] == sha(original) == sha(previous/'APPROVED.jpg')
assert sp.check_output(['git','-C',str(repo),'rev-parse','HEAD'],text=True).strip() == src['commit']
out = repo/'experiments/codex'/src['branch'].split('/')[-1]
repro = out/'reproduce'
m = out/'measurements'
copy(original, out/'APPROVED.jpg')
tree(previous/'CLAUDIA_BEFORE',out/'CLAUDIA_BEFORE')
copy(root/'proof'/sid/'BEFORE/opening-repeat.png',out/'CLAUDIA_BEFORE/opening-repeat.png')
tree(root/'proof'/sid/'NEW',out/'CODEX_NEW')
assert probe['matchedCameraAndGameState'] and probe['retainedOpeningRepeatedExactly']
assert probe['safeRun']['coins']==91 and probe['safeRun']['score']==2240 and probe['safeRun']['hearts']==5
assert len(probe['gameplayAssertions'])==8 and all(probe['gameplayAssertions'].values())
write(m/'matched-gameplay-and-opening.json',probe)
write(m/'original-artwork-on-github.json',exact)
copy(root/('film-'+sid+'.json'),m/'every-decoded-frame.json')
copy(previous/'measurements/clip-timestamps.json',m/'clip-timestamps.json')
copy(root/'capture.cjs',repro/'capture.cjs')
copy(root/'fixture'/sid/'gameplay-test.mjs',repro/'fixture'/sid/'gameplay-test.mjs')
copy(main/'verify-original-artwork.py',repro/'verify-original-artwork.py')
for f in ['flags.json','queries.json']: copy(root/f,repro/f)
for f in ['compare-opening.py','score-rgba.mjs']: copy(skill/f,repro/f)
if sid == '04':
    for k in ['opening','forward-20','last-in-stage']:
        copy(previous/'CODEX_NEW'/(k+'.png'),out/'PRIOR_CANDIDATE'/(k+'.png'))
    copy(previous/'CODEX_NEW/poses.json',out/'PRIOR_CANDIDATE/poses.json')
    copy(main/'verification/games/04r/assets/textures/match04/ring_paint04.json',repro/'claudia-groove-fit.json')
    copy(root/'fit-entrance-gold.py',repro/'fit-entrance-gold.py')
    copy(root/'physical-bay.json',m/'physical-bay-and-original-colors.json')
else:
    geom=load(root/'character-geometry-proof.json');assert geom['identical'] and len(geom['compared'])==3
    for f in ['character-geometry-proof.json','verified-original.json','character-pixels.json']:copy(root/f,m/f)
    copy(root/'actor-geometry.cjs',repro/'actor-geometry.cjs')
    copy(root/'compare-character-native.py',repro/'compare-character-native.py')
    if fitted:
        tree(main/'character-check/moving',out/'character-review/retained-steering')
        copy(main/'character-check/rendered/06/without-benny.png',m/'opening-without-benny.png')
        for f in ['cuff-fit.json','cuff-appearance.json','cuff-calibration.json','stage-material-scope.json','adjacent-screen-check.json','android-receipt.json']:copy(root/f,m/f)
        for f in ['calibration-0.08.png','calibration-0.28.png']:copy(root/f,out/'cuff-calibration'/f)
        for f in ['bake-fitted-cuff.py','calibrate-cuff.cjs','measure-cuff.py','verify-native-exit.py']:copy(root/f,repro/f)
        copy(root/'qa-final/stage-material-scope.cjs',repro/'stage-material-scope.cjs')
        copy(root/'cuff-calibration.json',out/'cuff-calibration/cuff-calibration.json')
    else:
        copy(root/'fiber-source.json',m/'fiber-source.json')
        copy(root/'bake-original-fibers.py',repro/'bake-original-fibers.py')
    copy(main/'character-check/original-vs-retained-benny.json',out/'character-review/original-vs-retained-all-five.json')
    copy(main/'character-check/original-landmarks.json',out/'character-review/hand-read-original-landmarks.json')
    for f in sorted((main/'character-check').glob('S??-*-character-native.png')):copy(f,out/'character-review'/f.name)
    copy(root/'S06-CODEX-character-native.png',out/'character-review/S06-CODEX-character-native.png')
write(out/'provenance.json',{'verifiedBeforeEdits':base,'originalFile':exact,'sourceCommit':src,'queries':load(root/'queries.json')[sid],'experimentalFlags':load(root/'flags.json')[sid],'motionMatcherCommit':skill_sha,'disposition':review['status'],'ownerDecision':'Pending owner review.','nativeResolution':[864,1536]})
write(out/'review.json',review)
o=probe['opening'];cl=o['approvedVsBefore'];new=o['approvedVsCandidate'];diff=o['beforeVsCandidate']['exactDifferences']
report = [
    '# Screen '+sid+' · '+review['title'],
    '**'+review['status']+'**. '+review['short'],*review['paragraphs'],
    '## Review the playable result',
    'APPROVED.jpg contains the exact original file bytes from GitHub. Open it, CLAUDIA_BEFORE/opening.png and CODEX_NEW/opening.png separately at 864 × 1536. The two ride.mp4 files show the actual game from inlet to exit and across the next transition.',
    review['watch'],review['proposals'],
    f"The entire opening measured {cl['within20Percent']:.4f}% for Claudia and {new['within20Percent']:.4f}% for the experiment. This counts pixels whose mean absolute difference from the original across RGB channels is at most 20 on the 0–255 scale. Pixelmatch at threshold 0.1 counted {cl['pixelmatchMismatches']:,} and {new['pixelmatchMismatches']:,} differing pixels respectively. Between the retained and experimental openings, {diff:,} pixels had at least one changed channel. The repeated retained frame was pixel-identical.",
    f"All {probe['poseCount']} tested native positions matched in camera, steering and shader time. All {probe['routeMatchedFrames']} H.264 video frames matched on gameplay inputs, coins, health, course position and camera. The simulation advances at 60 steps per second and the clips sample 12 frames per second at 648 × 1152.",
    'The full-course run passed eight assertions, collected 91 coins, went from 1,330 to 2,240 and entered Stage 11 with five hearts and zero collisions. TypeScript and the production Vite build passed. These runs used desktop Chromium WebGL 2. Sustained Android performance still requires a physical device.',
    '## Reproduce',
    'Use an isolated checkout with the project lockfile and a local Vite server. Set RAINBOW_BASE_URL to that server and run the following commands inside reproduce. The recorder uses Playwright 1.57.0, Chromium and FFmpeg. The flags and queries files hold the exact visual switches.',
    '\x60\x60\x60sh\nnode capture.cjs stills '+sid+':BEFORE '+sid+':NEW\nnode capture.cjs ride '+sid+':BEFORE '+sid+':NEW\nnode capture.cjs full-safe '+sid+':NEW\nnode capture.cjs repeat '+sid+':BEFORE\n\x60\x60\x60',
    'The exact comparison conditions, reference hash and initial branch check are in provenance.json. The individual capture files and measurements are listed in checksums.json. The original artwork supplies one approved angle. Moving views are proposals awaiting the owner’s decision.',
    'Original artwork on Claudia’s specialist checkpoint. [Open the immutable GitHub source]('+exact['url']+')'
]
if fitted:
    report.extend([
        '## Reproduce the cuff and compare it at its real position',
        'The two photographed calibration frames in cuff-calibration record the real retained cuff under linear albedo 0.08 and 0.28. They were captured with the opening camera, native resolution, shader clock and live lighting. To generate another pair from the running game, start in reproduce and run node calibrate-cuff.cjs. Copy the resulting three calibration files together.',
        '\x60\x60\x60sh\npython reproduce/bake-fitted-cuff.py APPROVED.jpg cuff-calibration /tmp/benny06-cuff-rebuilt.png\npython reproduce/measure-cuff.py --original APPROVED.jpg --retained CLAUDIA_BEFORE/opening.png --new CODEX_NEW/opening.png --output /tmp/benny06-cuff-measure.json\n\x60\x60\x60',
        'The stage-scoped code changes only the material on the pre-existing rolled cuff while the game is in Screen 06. The Android debug package was signed and all 77 bundled web files, including the new knit texture, were verified. No physical Android device was connected.'
    ])
(out/'REPORT.md').write_text('\n\n'.join(report)+'\n')
write(out/'checksums.json',{f.relative_to(out).as_posix():sha(f) for f in sorted(out.rglob('*')) if f.is_file() and f!=out/'checksums.json'})
publisher=(main/'publish-verified.py').read_text().replace("work=root if sid=='06' else root/'round2'","work=root").replace("repo=root/'repo' if sid=='06' else work/'repos'/sid","repo=root/'repos'/sid")
(root/'publish-verified.py').write_text(publisher)
print(sid, len(load(out/'checksums.json')), 'separate evidence files')
