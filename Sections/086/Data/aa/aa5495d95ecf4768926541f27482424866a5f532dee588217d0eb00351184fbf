from pathlib import Path
import json,subprocess
from PIL import Image,ImageDraw
import numpy as np
base=Path('/workspace/library-files/Rainbow-Reconstruction-Experiments')
spots={
 '04': [('passing-arrows','forward-20','Follow the pink-to-cyan boundary beyond the arrows. The candidate makes the foreground sweep wider.'),('deep','last-in-stage','Inspect the uniform copper corridor and repeated arrows in the distance.')],
 '05': [('forward-03','hard-left','Watch the dark slots and their bevel on the purple washer wall. The dedicated HARD_LEFT still gives the closest readable view.'),('last-left-bend','last-in-stage','Look for long cyan and magenta streaks in the late S bend. Watch the abrupt environment handoff immediately afterward.')],
 '06': [('crest-release','forward-06','Check the pale patch at crest release and foam passing across the lower part of Benny.'),('forward-10','forward-20','Follow the distant gold-ring centers. Claudia’s tube faces forward here, and the candidate sweeps to the right.'),('deep','arch-exit','Inspect cyan stretch, visible foam and repeated rings at the deeper passage.')],
 '07': [('forward-06','forward-20','Inspect the third gold paddle and the magenta banks. In the retained view, wall markings spill onto the paddle. A small amber line can remain on the candidate’s rear edge.'),('plunge-lip','halfway-down','Watch the hard-edged lip and the growing white sides as the river descends.'),('two-thirds-down','plunge-bottom','Tall foam and vertical cyan streaks can dominate this part of the drop. The current paddle candidate preserves the plunge.')],
 '08': [('forward-03','forward-06','Inspect the broad cyan smear just downstream of the opening.'),('platform-and-spouts','last-in-stage','Follow the foreground magenta turn while checking the door, towel, platform and four spouts for stable placement.')]}
titles={'04':'Through the Five Arrows','05':'Flow into the Current','06':'Crest the Rinse Arch','07':'Dive the Washer Tube','08':'Final Spin Chamber'}
out={}
for sid,lines in spots.items():
 d=base/('Screen-'+sid)
 poses={r['name']:r for r in json.load(open(d/'BEFORE/poses.json')) if 'state' in r}
 route=json.load(open(d/'BEFORE/route.json'))['frames']; nxt=route[-1]['stage']
 times={n:min(route,key=lambda x:abs(x['s']-p['state']['s'])) for n,p in poses.items()}
 rec=[]
 for a,b,note in lines:
  rec.append(dict(view1=a,view2=b,first=times[a]['i'],last=times[b]['i'],t1=times[a]['time'],t2=times[b]['time'],note=note))
 k=next(x for x in route if x['stage']!=sid)
 rec.append(dict(view1='last-in-stage',view2='across-transition',first=k['i'],last=route[-1]['i'],t1=k['time'],t2=route[-1]['time'],note='First visible frame in Screen '+nxt+'. Compare continuity with the outgoing stage.'))
 out[sid]=rec
 inds=sorted(set([r['first'] for r in rec]+[r['last'] for r in rec]))
 sheet=Image.new('RGB',(len(inds)*79,2*162),'#102030');draw=ImageDraw.Draw(sheet)
 for row,v in enumerate(('BEFORE','NEW')):
  raw=subprocess.check_output(['ffmpeg','-v','error','-threads','1','-i',str(d/v/'ride.mp4'),'-threads','1','-pix_fmt','rgb24','-f','rawvideo','pipe:1'])
  frames=np.frombuffer(raw,np.uint8).reshape(-1,576,324,3)
  for col,i in enumerate(inds):
   sheet.paste(Image.fromarray(frames[i]).resize((79,140),Image.Resampling.LANCZOS),(col*79,row*162+18));draw.text((col*79,row*162),f'{i/12:.2f}',fill='white')
 sheet.save('bookmark-inspection-'+sid+'.jpg',quality=90)
Path('bookmarks.json').write_text(json.dumps(out,indent=2)+'\n')
print('Located every bookmark by stage position and checked the actual frames')
