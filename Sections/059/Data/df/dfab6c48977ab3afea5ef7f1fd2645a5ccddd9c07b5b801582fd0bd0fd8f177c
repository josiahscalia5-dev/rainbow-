## Materials — version-safe Principled BSDF

Node names are locale-dependent and input names changed across Blender 4.x —
always look nodes up by type and guard input names:

```python
def principled(mat):
    return next(n for n in mat.node_tree.nodes if n.type == 'BSDF_PRINCIPLED')

def set_input(node, value, *names):
    """Try input names in order (new name first, legacy aliases after)."""
    for name in names:
        if name in node.inputs:
            node.inputs[name].default_value = value
            return True
    print("WARN: no input among", names)
    return False

mat = bpy.data.materials.get("ceramic_glaze") or bpy.data.materials.new("ceramic_glaze")
# new materials already have a node tree (use_nodes defaults True as of
# recent Blender) -- don't set mat.use_nodes yourself; it's deprecated and
# slated for removal, and setting it now just prints a warning for nothing
bsdf = principled(mat)
set_input(bsdf, (0.92, 0.88, 0.83, 1.0), "Base Color")
set_input(bsdf, 0.0, "Metallic")
set_input(bsdf, 0.22, "Roughness")
# renamed-input examples:
# set_input(bsdf, 0.5, "Specular IOR Level", "Specular")
# set_input(bsdf, 0.1, "Transmission Weight", "Transmission")

obj = bpy.data.objects["body"]
obj.data.materials.clear()
obj.data.materials.append(mat)
```

Procedural bump (textureStrategy `procedural`):

```python
nt = mat.node_tree
noise = nt.nodes.new('ShaderNodeTexNoise')
noise.inputs['Scale'].default_value = 45
bump = nt.nodes.new('ShaderNodeBump')
bump.inputs['Strength'].default_value = 0.02
nt.links.new(noise.outputs['Fac'], bump.inputs['Height'])
nt.links.new(bump.outputs['Normal'], principled(mat).inputs['Normal'])
