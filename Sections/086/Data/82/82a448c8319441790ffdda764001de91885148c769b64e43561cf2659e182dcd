        assert sha(ring_file)==ring_record['sha256']
        archive_name='gold-ring-specialist-opening.png'
        link_file(ring_file,dest/'claudia-archive'/archive_name)
        archives[archive_name]={**ring_record,'branch':'claude/rainbow-s04-ringtex-c17'}
    (dest/'claudia-archive/provenance.json').write_text(json.dumps(archives,indent=2)+'\n')
    for name in ('capture.cjs','queries.json','flags.json','analyze.py'):
        link_file(ROOT/name,dest/'reproduce'/name)
    if sid=='05':
        link_file(ROOT/'slot-detail.py',dest/'reproduce/slot-detail.py')
    for file in (SKILL/'scripts').iterdir():
        link_file(file,dest/'reproduce'/file.name)

    provenance={**rev,'experimentSource':commit,'referencePath':'references/'+ref.name,'referenceSHA256':refhash,
                'matchRule':'All 864 × 1536 pixels, including HUD and Benny. Mean absolute RGB channel error ≤20 in 8-bit RGB. Pixelmatch 7.1.0 threshold 0.1, includeAA false.',
                'capture':{'renderer':'Three.js in Chromium 156, SwiftShader','control':'Playwright 1.57, fixed 1/60 simulation steps','resolution':'864 × 1536 stills, 324 × 576 H.264 clips at 12 frames per second','baseline':'Retained features at the recorded Claudia specialist tip','passed':'Production build and the existing eight gameplay assertions in both variants'},
                'retainedQuery':read(ROOT/'queries.json')[sid],'experimentFlag':read(ROOT/'flags.json')[sid]}
    (dest/'provenance.json').write_text(json.dumps(provenance,indent=2)+'\n')
    original=metrics['approvedVsBefore'];new=metrics['approvedVsCandidate'];repeat=metrics['beforeVsRepeat'];between=metrics['beforeVsCandidate']
    stats=f"RGB agreement at the approved pose was {original['within20Percent']:.3f}% before and {new['within20Percent']:.3f}% in the experiment. Pixelmatch counted {original['pixelmatchMismatches']:,} and {new['pixelmatchMismatches']:,} mismatches respectively over {original['pixels']:,} pixels. The independent opening repeat changed {repeat['exactDifferences']:,} pixels. The before and new openings differed at {between['exactDifferences']:,} pixels."
    archive_note="The before image reproduces the retained specialist tip on the same renderer as the experiment. Claudia’s original archived captures and their paths are included separately."
    if sid=='04':
        archive_note+=' The separate gold-ring specialist’s saved opening is also available in Claudia’s archive. The scenery experiment begins at the Screen 04 scenery specialist’s tip.'
    if sid=='05':
        archive_note+=' Claudia’s retained transition pass saved end-of-stage views. Its matched opening was recaptured from that commit.'
    if (src/'archive-opening-check.json').exists():
        ac=read(src/'archive-opening-check.json'); archive_note+=f" Claudia’s archived opening and the fresh before differed at {ac['exactDifferences']:,} decoded pixels."
    report=[f'# Screen {sid} · {TITLES[sid]}',f"**{facts['status']}.** {facts['decision']}",facts['change'],facts['motion'],facts['remaining'],
        f"**Interpretation for review.** {facts['inference']}",stats,"The RGB agreement counts full-frame pixels whose mean absolute RGB difference is at most 20 on an 8-bit scale. Pixelmatch 7.1.0 uses a threshold of 0.1 and excludes antialias mismatches. Each moving pair uses the same game state, camera, steering and shader clock. The moving views have no photographed reference score.",archive_note,
        f"Both complete rides retained five hearts through the {sid} to {mv['ride']['nextStage']} handoff. Each clip spans {mv['ride']['frames']} encoded frames at 12 fps. Both variants passed all eight existing gameplay assertions, collected 91 coins and advanced the total from 1,330 to 2,240. Hard-steer collision diagnostics are separate from the successful rides. Android phone frame times and thermal behavior still require a device test.",
        f"**Checkpoint** `{rev['base']['branch']}` at `{rev['base']['commit']}`. The isolated experimental source is `{commit}` on `{rev['branch']}`.",
        '''## Reproduce

Use this branch in an isolated checkout with its locked game dependencies. Start its Vite server on loopback with its usual project config. Run from the project root with Playwright 1.57 and a compatible Chromium executable available to Node. Set `RAINBOW_BASE_URL` to the local game URL and `RAINBOW_CHROMIUM` to the browser executable. The capture scripts write into their own evidence folder. A system FFmpeg is needed for H.264 clips.''',
        f"""\x60\x60\x60sh
node experiments/codex/{sid}/reproduce/capture.cjs stills {sid}:BEFORE {sid}:NEW
node experiments/codex/{sid}/reproduce/capture.cjs repeat {sid}:BEFORE
node experiments/codex/{sid}/reproduce/capture.cjs ride {sid}:BEFORE {sid}:NEW
python3 experiments/codex/{sid}/reproduce/analyze.py {sid}
\x60\x60\x60""",
        "The approved original, native opening and movement images, continuous clips, gameplay assertions, per-frame journey logs, GPU counts, comparison metrics and archived specialist evidence are in this directory."]
    if sid=='04':
        report=[entry.replace('python3 experiments/codex/04/reproduce/analyze.py 04','node experiments/codex/04/reproduce/capture.cjs full-safe 04:BEFORE 04:NEW\npython3 experiments/codex/04/reproduce/analyze.py 04') for entry in report]
        report.insert(8,'The standard coin-seeking 03–11 suite took one heart in Screen 04 on the retained checkpoint and the experiment. A separate full-game ride with the same coin targets and 0.85 units of wall clearance collected all 91 coins and finished at 2,240 with five hearts on both variants. The logged collision and complete intact-heart rides are in each variant directory.')
    (dest/'REPORT.md').write_text('\n\n'.join(report)+'\n')
    movement=''
