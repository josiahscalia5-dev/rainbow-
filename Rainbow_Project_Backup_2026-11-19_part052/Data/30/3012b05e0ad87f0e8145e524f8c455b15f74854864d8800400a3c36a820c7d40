from pathlib import Path
import base64,hashlib,json,subprocess as sp,sys
from tempfile import TemporaryDirectory
from datetime import datetime,timezone

root=Path(sys.argv[1]);screen=sys.argv[2];meta=json.loads((root/'source.json').read_text())
repo=root/'repo';branch=meta['branch'];folder='experiments/'+branch;local=repo/folder

def git(*args,inp=None):return sp.check_output(['git','-C',str(repo),*args],input=inp,stderr=sp.PIPE)
def api(path):return json.loads(sp.check_output(['gh','api','repos/josiahscalia5-dev/rainbow-/git/'+path],stderr=sp.PIPE))
def sha(p):
    with p.open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()

manifest=json.loads((local/'SHA256.json').read_text())
assert set(manifest)=={p.relative_to(local).as_posix() for p in local.rglob('*') if p.is_file() and p.name!='SHA256.json'}
assert all(sha(local/k)==v for k,v in manifest.items())
assert git('ls-remote','--heads','origin','refs/heads/'+meta['retained']['branch']).decode().split()[0]==meta['retained']['commit']
ref='refs/heads/'+branch;prev=git('ls-remote','--heads','origin',ref).decode().split()
head=git('rev-parse','HEAD').decode().strip()
if head==meta['commit']:
    assert not prev
    git('add','--',folder);git('diff','--cached','--check','--','.',':(exclude)*.pdf')
    assert all(p.startswith(folder+'/') for p in git('diff','--cached','--name-only').decode().splitlines())
    git('commit','-q','-m','Save matched gameplay, full-size pictures and the visual decision for Screen '+screen)
tip=git('rev-parse','HEAD').decode().strip()
assert git('rev-parse','HEAD^').decode().strip()==meta['commit']
if not prev:
    git('push','--quiet','origin','HEAD:'+ref)
elif prev[0]!=tip:
    raise ValueError('A different experiment already occupies the remote branch')
assert git('ls-remote','--heads','origin',ref).decode().split()==[tip,ref]
tree=api('commits/'+tip)['tree']['sha']
for part in folder.split('/'):
    tree=next(x['sha'] for x in api('trees/'+tree)['tree'] if x['path']==part and x['type']=='tree')
items=api('trees/'+tree+'?recursive=1');assert not items['truncated']
remote={i['path']:i['sha'] for i in items['tree'] if i['type']=='blob'}
assert set(remote)==set(manifest)|{'SHA256.json'}
for name,blob in remote.items():
    assert git('rev-parse',tip+':'+folder+'/'+name).decode().strip()==blob
cert=[]
with TemporaryDirectory(dir=root,prefix='private-lfs-download-') as cache:
    for name in ['CLAUDIA_BEFORE/ride.mp4','CODEX_NEW/ride.mp4']:
        pointer=git('cat-file','blob',remote[name])
        assert pointer.startswith(b'version https://git-lfs.github.com/spec/v1')
        raw=git('-c','lfs.storage='+cache,'lfs','smudge','--',folder+'/'+name,inp=pointer)
        assert hashlib.sha256(raw).hexdigest()==manifest[name]
        cert.append({'asset':name,'size':len(raw),'sha256':manifest[name]})
for name in ['APPROVED.jpg','Review_on_Android.pdf','CODEX_NEW/'+('crest-release' if screen=='06' else 'plunge-bottom')+'.png']:
    rec=api('blobs/'+remote[name]);raw=base64.b64decode(rec['content']);assert hashlib.sha256(raw).hexdigest()==manifest[name]
result={'branch':branch,'commit':tip,'source':meta['commit'],'protectedBase':meta['retained'],'evidenceFiles':len(remote),'LFS_verifiedRemoteBytes':cert,'downloadTested':['APPROVED.jpg','Review_on_Android.pdf','CODEX_NEW moving picture'],'verifiedUTC':datetime.now(timezone.utc).isoformat()}
(root/'published.json').write_text(json.dumps(result,indent=2)+'\n')
print(screen,'published and verified',tip,len(remote),'evidence files')
