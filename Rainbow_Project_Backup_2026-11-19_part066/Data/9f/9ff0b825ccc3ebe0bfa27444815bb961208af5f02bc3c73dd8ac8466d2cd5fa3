import json,sys,subprocess
from pathlib import Path
from PIL import Image,ImageDraw
import numpy as np

root=Path.cwd()
def sheet(items, file, columns=4):
    width,height=125,222
    result=Image.new('RGB',(columns*width,((len(items)+columns-1)//columns)*(height+17)),(20,20,28));d=ImageDraw.Draw(result)
    for i,(label,im) in enumerate(items):
        x,y=i%columns*width,i//columns*(height+17)
        small=im.copy().convert('RGB');small.thumbnail((width,height))
        result.paste(small,(x,y));d.text((x+2,y+height+1),label,fill=(245,245,248))
    result.save(file,quality=80)
for sid in sys.argv[1:]:
    p=root/'captures'/sid;st=json.loads((p/'stills.json').read_text())['shots']
    sheet([(s['name'],Image.open(p/(s['name']+'.png'))) for s in st],root/'inspection'/f'stills-{sid}.jpg')
    clip=p/'clip.json'
    if not clip.exists():continue
    meta=json.loads(clip.read_text());f=meta['frames']
    out=subprocess.check_output(['ffprobe','-v','error','-show_entries','stream=codec_name,width,height,avg_frame_rate,nb_frames,duration','-of','json',str(p/'ride.mp4')]);probe=json.loads(out)['streams'][0]
    assert int(probe['nb_frames'])==len(f) and int(probe['width'])==meta['width']
    assert all(b['s']>=a['s'] for a,b in zip(f,f[1:])), 'Route did not advance monotonically'
    assert min(v['hearts'] for v in f)>0 and f[-1]['stage']!=sid
    dims=(108,192)
    data=subprocess.check_output(['ffmpeg','-v','error','-i',str(p/'ride.mp4'),'-vf','scale=108:192','-threads','1','-f','rawvideo','-pix_fmt','rgb24','-'])
    arr=np.frombuffer(data,np.uint8).reshape(-1,dims[1],dims[0],3)
    assert len(arr)==len(f)
    diffs=np.abs(arr[1:].astype(np.int16)-arr[:-1].astype(np.int16)).mean(axis=(1,2,3))
    ranked=np.argsort(diffs)[-3:][::-1]+1
    indices=sorted(set([0,int(.15*len(f)),int(.35*len(f)),int(.5*len(f)),int(.68*len(f)),int(.82*len(f)),len(f)-3,len(f)-1]+ranked.tolist()))
    sheet([(f"{i/meta['fps']:.2f}s  {f[i]['stage']}",Image.fromarray(arr[i])) for i in indices],root/'inspection'/f'clip-{sid}.jpg')
    transitions=[{'frame':i,'from':f[i-1]['stage'],'to':v['stage'],'s':v['s']} for i,v in enumerate(f) if i and v['stage']!=f[i-1]['stage']]
    rec={'media':probe,'first':f[0],'last':f[-1],'stageChanges':transitions,'minHearts':min(v['hearts'] for v in f),'steerMin':min(v['steer'] for v in f),'steerMax':max(v['steer'] for v in f),'largestConsecutiveChanges':[{'frame':int(i),'meanAbsoluteRgb':float(diffs[i-1]),'stage':f[i]['stage'],'s':f[i]['s']} for i in ranked]}
    (p/'clip-check.json').write_text(json.dumps(rec,indent=2))
    print(sid,probe['nb_frames'],probe['duration'],transitions)
