n      scene.add(clone);\n      clone.updateMatrixWorld(true);\n      renderer.setRenderTarget(depthRT);\n      renderer.clear();\n      renderer.render(scene, proj);\n      renderer.setRenderTarget(prevRT);\n      shared.uUseDepth.value = 1;\n    },\n    sync(renderer, w, h) {\n      shared.uPjPost.value.x = renderer.toneMappingExposure;\n      shared.uPjRes.value.set(w, h);\n    },\n  };\n}\n=== bennypts04.mjs\n// read-only: world-space vertices (subsampled) of Benny's visible meshes at the 04 checkpoint + the course frame there,\n// for the offline camera solve (tools/match04/solve_cam04.py). usage: node tools/match04/bennypts04.mjs [query] > out.json\nimport { loadPlaywright, CHROMIUM_ARGS, startVite } from '../../scripts/lib/pw.mjs';\nconst q = process.argv[2] || '';\nconst { chromium } = loadPlaywright();\nconst vite = await startVite(5267);\nconst browser = await chromium.launch({ args: CHROMIUM_ARGS });\ntry {\n  const page = await browser.newPage({ viewport: { width: 864, height: 1536 }, deviceScaleFactor: 1 });\n  await page.goto(`${vite.url}/?qa=1&dpr=1&${q}`);\n  await page.waitForFunction(() => window.__rainbow?.ready === true || window.__error, null, { timeout: 240000 });\n  await page.evaluate(() => window.__rainbow.goto('04'));\n  const out = await page.evaluate(() => {\n    const R = window.__rainbow; const { scene, camera } = R.qa3d();\n    let benny = null; scene.traverse((o) => { if (!benny && o.name === 'Benny') benny = o; });\n    benny.updateWorldMatrix(true, true);\n    const V = camera.position.constructor; const t = new V(); const pts = [];\n    benny.traverse((o) => { if (!o.isMesh || !o.visible || !o.geometry) return; let vis = true; let p = o; while (p) { if (!p.visible) vis = false; p = p.parent; } if (!vis) return;\n      const pa = o.geometry.attributes.position; const step = Math.max(1, Math.floor(pa.count / 400));\n      for (let i = 0; i < pa.count; i += step) { t.fromBufferAttribute(pa, i); if (o.isSkinnedMesh) o.applyBoneTransform(i, t); t.applyMatrix4(o.matrixWorld); pts.push([+t.x.toFixed(4), +t.y.toFixed(4), +t.z.toFixed(4)]); } });\n    const s = R.state().s; const f = R.course.sample(s);\n    return { s, root: benny.position.toArray(), water: f.pos.toArray(), tan: f.tan.toArray(), up: f.up.toArray(), right: f.right.toArray(), cam: R.camera(), pts };\n  });\n  console.log(JSON.stringify(out));\n} finally { await browser.close(); await vite.close?.(); }\n=== solve_cam04.py\n\"\"\"Screen 04 (?match04=1): solve the approved picture's camera offline at the game's FOV 62.\nUnknowns: camera position relative to Benny's water point (world, 3), yaw + pitch of the view (level, no roll).\nTargets measured on references/04_through_the_five_arrows.png (864x1536): Benny's visible box (fur arms to pom-pom,\nfur bottom at the water) and the tunnel's vanishing point = image of the straight slide direction D (course.ts 04).\nusage: python3 -I tools/match04/solve_cam04.py <bennypts.json from bennypts04.mjs> <out cam04.json>\"\"\"\nimport json, sys, math\nimport numpy as np\nfrom scipy.optimize import minimize\n\nd = json.load(open(sys.argv[1]))\nP = np.array(d[\"pts\"], float); water = np.array(d[\"water\"], float)\nW, H, FOV = 864, 1536, 62.0\nt = math.tan(math.radians(FOV) / 2); asp = W / H\nD = np.array([0.0, -0.53, -0.848]); D /= np.linalg.norm(D)\nT_BOX = np.array([195, 965, 590, 1400.0]); T_VP = np.array([490, 690.0])\n\ndef basis(yaw, pitch):\n    f = np.array([math.sin(yaw) * math.cos(pitch), math.sin(pitch), -math.cos(yaw) * math.cos(pitch)])\n    r = np.cross(f, [0, 1, 0]); r /= np.linalg.norm(r); u = np.cross(r, f)\n    return np.stack([r, u, -f], 1)          # columns = camera x, y, z (three.js: looks down -z)\n\ndef proj(R, C, X):\n    q = (np.atleast_2d(X) - C) @ R\n    return np.stack([(q[:, 0] / -q[:, 2] / (t * asp) + 1) / 2 * W, (1 - q[:, 1] / -q[:, 2] / t) / 2 * H], 1)\n\ndef unpack(x): return water + x[:3], basis(x[3], x[4])\ndef err(x):\n    C, R = unpack(x); p = proj(R, C, P)\n    box = np.array([p[:, 0].min(), p[:, 1].min(), p[:, 0].max(), p[:, 1].max()])\n    vp = proj(R, np.zeros(3), D[None] * 1e3)[0]\n    return ((box - T_BOX) ** 2).sum() + 2 * ((vp - T_VP) ** 2).sum()\n\nbest = None\nfor x0 in ([0.5, 5, 4, 0, -0.6], [0, 4, 3, 0.1, -0.8], [1, 6, 5, -0.1, -0.5]):\n    r = minimize(err, x0, method=\"Nelder-Mead\", options=dict(maxiter=20000, xatol=1e-6, fatol=1e-6))\n    if best is None or r.fun < best.fun: best = r\nC, R = unpack(best.x); p = proj(R, C, P)\nMW = np.eye(4); MW[:3, :3] = R; MW[:3, 3] = C\nf = -R[:, 2]\nout = {\"note\": \"Screen 04 locked approved-view camera (tools/match04/solve_cam04.py)\", \"fov\": FOV, \"size\": [W, H],\n       \"mw\": MW.T.reshape(-1).tolist(), \"pos\": C.tolist(), \"fwd\": f.tolist(), \"off04\": (C - water).tolist(),\n       \"water\": water.tolist(), \"s\": d[\"s\"], \"err\": float(best.fun),\n       \"box\": [float(p[:, 0].min()), float(p[:, 1].min()), float(p[:, 0].max()), float(p[:, 1].max())],\n       \"vp\": proj(R, np.zeros(3), D[None] * 1e3)[0].tolist()}\njson.dump(out, open(sys.argv[2], \"w\"), indent=1)\nprint(json.dumps({k: out[k] for k in (\"off04\", \"fwd\", \"err\", \"box\", \"vp\")}))\n=== fit_proxies04.py\n\"\"\"Screen 04 (?match04=1): fit the 3D proxy geometry to the APPROVED picture from the locked camera (cam04.json).\nTunnel = straight cylinder parallel to the slide direction D (course.ts 04: 32 deg drop, x = 2) whose mouth is the\npainted big gold ring (plane perpendicular to D). Unknowns: inner radius R, axis lateral offset ax (world x), axis height\nh above the path line (along the slide's up U), mouth distance sA along D from Benny's water point, outer radius Ro.\nMeasured on the picture (864x1536): inner ring top (440,468), widest left (72,780) / right (790,780);\nouter ring top (440,415), widest left (22,780) / right (842,780). Water = flat plane at the path level.\nusage: python3 -I tools/match04/fit_proxies04.py <cam04.json> <out proj04.json>\"\"\"\nimport json, sys, math\nimport numpy as np\nfrom scipy.optimize import minimize\n\ncam = json.load(open(sys.argv[1]))\nW, H = cam[\"size\"]; t = math.tan(math.radians(cam[\"fov\"]) / 2); asp = W / H\nMW = np.array(cam[\"mw\"], float).reshape(4, 4).T; C = MW[:3, 3]; Rm = MW[:3, :3]\nwater = np.array(cam[\"water\"], float)\nD = np.array([0.0, -0.53, -0.848]); D /= np.linalg.norm(D)\nX = np.array([1.0, 0, 0]); U = np.cross(X, D); U /= np.linalg.norm(U)   # slide up (perpendicular to D, upward)\nif U[1] < 0: U = -U\nPATHX = 2.0                                                         # the slide's world x (course.ts)\nbase = np.array([PATHX, water[1], water[2]])                        # Benny's water point, on the path line\n\ndef proj(Xw):\n    q = (np.atleast_2d(Xw) - C) @ Rm\n    return np.stack([(q[:, 0] / -q[:, 2] / (t * asp) + 1) / 2 * W, (1 - q[:, 1] / -q[:, 2] / t) / 2 * H], 1)\n\nth = np.linspace(0, 2 * np.pi, 720, endpoint=False)\ndef circle(centre, r):\n    return centre[None] + r * (np.cos(th)[:, None] * X[None] + np.sin(th)[:, None] * U[None])\ndef extremes(p):\n    i_top, i_l, i_r = p[:, 1].argmin(), p[:, 0].argmin(), p[:, 0].argmax()\n    return np.array([p[i_top], p[i_l], p[i_r]])\n\nT_IN = np.array([[440, 468], [72, 780], [790, 780.0]])\nT_OUT = np.array([[440, 415], [22, 780], [842, 780.0]])\ndef axis_at(x): return base + (x[1] - PATHX) * X * 0 + x[1] * X * 0 + np.array([x[1], 0, 0]) - np.array([PATHX, 0, 0]) * 0\ndef centre(x):  # x = [R, ax, h, sA]\n    return np.array([x[1], 0, 0]) + np.array([0, base[1], base[2]]) + x[2] * U + x[3] * D\ndef err_in(x):\n    if x[0] <= 0.5: return 1e9\n    p = extremes(proj(circle(centre(x), x[0])))\n    return ((p - T_IN) ** 2).sum()\nbest = None\nfor x0 in ([4.8, 2.0, 4.0, 10], [4.0, 2.2, 3.0, 8], [6, 2, 5, 14], [3.5, 2, 2.5, 6]):\n    r = minimize(err_in, x0, method=\"Nelder-Mead\", options=dict(maxiter=40000, xatol=1e-7, fatol=1e-7))\n    if best is None or r.fun < best.fun: best = r\nR, ax, h, sA = best.x; cen = centre(best.x)\nro = minimize(lambda v: ((extremes(proj(circle(cen, v[0]))) - T_OUT) ** 2).sum(), [R * 1.15], method=\"Nelder-Mead\").x[0]\nout = {\"note\": \"Screen 04 proxy layout (tools/match04/fit_proxies04.py)\", \"camera\": {\"matrixWorld\": cam[\"mw\"], \"fov\": cam[\"fov\"], \"size\": [W, H], \"pos\": C.tolist()},\n       \"D\": D.tolist(), \"U\": U.tolist(), \"X\": X.tolist(), \"water\": base.tolist(),\n       \"tube\": {\"r\": float(R), \"ax\": float(ax), \"h\": float(h), \"mouthS\": float(sA), \"mouth\": cen.tolist(), \"outerR\": float(ro)},\n       \"fit\": {\"inner_px\": extremes(proj(circle(cen, R))).tolist(), \"outer_px\": extremes(proj(circle(cen, ro))).tolist(), \"err_in\": float(best.fun)},\n       \"checks\": {\"cam_height_over_water_U\": float((C - base) @ U), \"cam_lateral\": float(C[0] - PATHX), \"cam_above_axis\": float((C - base) @ U - h),\n                  \"cam_axis_dist\": float(math.hypot((C - base) @ U - h, C[0] - ax)), \"vp_px\": proj(C + D * 1e3)[0].tolist(),\n                  \"path_chord_halfwidth_at_water\": float(math.sqrt(max(R * R - h * h, 0)))}}\njson.dump(out, open(sys.argv[2], \"w\"), indent=1)\nprint(json.dumps({k: out[k] for k in (\"tube\", \"fit\", \"checks\")}, indent=0))"}, "type": "user", "userType": "external", "uuid": "feaf6a30-8967-43a9-ade3-d6ad5cfa89f6", "version": "2.1.326"}
