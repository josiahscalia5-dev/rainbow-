ce(0, 5) }));\nprocess.exit(out.pass ? 0 : 1);\n", "replaceAll": false, "structuredPatch": [{"lines": [" //      real-time 11 victory frame (Benny hidden, FINAL SPIN COMPLETE) follows.", " //   C. flowplan WITHOUT videos: the real-time 01 opening plays exactly as before (fallback scenes preserved).", " //   D. default game with an intro video and NO flowplan: unchanged (held at 01, continues into 02/03).", "+//   E. both videos + flowplan, full coin-seeking run 04–08: exactly 91 coins / 2,240 at the victory (account 4).", " import { existsSync, mkdirSync, writeFileSync } from 'node:fs';", " import { execSync } from 'node:child_process';", " import { loadPlaywright, CHROMIUM_ARGS, startVite } from './lib/pw.mjs';"], "newLines": 7, "newStart": 7, "oldLines": 6, "oldStart": 7}], "userModified": false}, "type": "user", "userType": "external", "uuid": "d8c5bcf6-5ebf-4cf6-b73b-89b60dff93aa", "version": "2.1.326"}
