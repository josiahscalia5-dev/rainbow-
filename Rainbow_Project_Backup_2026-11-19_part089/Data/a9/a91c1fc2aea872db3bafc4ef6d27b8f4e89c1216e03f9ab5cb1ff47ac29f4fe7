from pathlib import Path
import csv,hashlib,json,subprocess,sys
import numpy as np

root=Path.cwd()
lib=Path('/workspace/library-files/Rainbow-Reconstruction-Experiments')
def meta(f):
    j=json.loads(subprocess.check_output(['ffprobe','-v','error','-select_streams','v:0','-show_entries','stream=codec_name,width,height,duration,nb_frames,r_frame_rate,pix_fmt','-of','json',str(f)]))['streams'][0]
    assert j['codec_name']=='h264' and j['pix_fmt'] in ('yuv420p','yuvj420p'),(f,j)
    return {k:j[k] for k in ['width','height','duration','nb_frames','r_frame_rate','codec_name','pix_fmt']}
def compare_video(before,new,n):
    # Compare low-frequency composition for every independently rendered HD replay frame.
    cmd=['ffmpeg','-v','error','-threads','1','-i']
    args=['-vf','scale=108:192:flags=area','-vsync','0','-threads','1','-pix_fmt','rgb24','-f','rawvideo','pipe:1']
    processes=[subprocess.Popen(cmd+[str(p)]+args,stdout=subprocess.PIPE,stderr=subprocess.PIPE) for p in (before,new)]
    stats=[];size=108*192*3
    try:
        for i in range(n):
            frames=[p.stdout.read(size) for p in processes]
            assert all(len(f)==size for f in frames)
            a,b=[np.frombuffer(f,np.uint8).astype(float) for f in frames]
            stats.append((float(np.abs(a-b).mean()),float(np.corrcoef(a,b)[0,1])))
        assert all(not p.stdout.read(1) for p in processes)
        assert all(p.wait()==0 for p in processes)
    finally:
        for p in processes:
            if p.poll() is None:p.kill();p.wait()
    return {'meanChannelErrorAt108x192':round(float(np.mean([a for a,b in stats])),3),'largestFrameMeanError':round(max(a for a,b in stats),3),'minimumFrameCorrelation':round(min(b for a,b in stats),5)}
def hashfile(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()
rows=json.load(open('videos.json'))
if sys.argv[1:] and sys.argv[1]=='originals':
    seen={};records=[]
    for r in rows:
        p=Path(r['file']); ident=hashfile(p); m=meta(p)
        rec={**r,**m,'sha256':ident,'bytes':p.stat().st_size,'name':'Screen_'+r['screen']+'/'+r['section']+'/'+r['stem']+'.mp4'}
        rec['canonical']=seen.get(ident,rec['name']);seen.setdefault(ident,rec['name'])
        records.append(rec)
    Path('original-videos.json').write_text(json.dumps(records,indent=2)+'\n')
    print('Verified H.264 original records',len(records),'unique clips',len(seen))
else:
    for sid in sys.argv[1:] or ['04','05','06','07','08']:
        out=[]
        for kind in ['BEFORE','NEW']:
            src=next(x for x in rows if x['screen']==sid and x['section']=='Recorded_Originals' and (('CLAUDIA_' in x['stem'])==(kind=='BEFORE')))
            d=Path('proof')/sid/kind
            old=json.load(open(lib/('Screen-'+sid)/kind/'route.json'));new=json.load(open(d/'route.json'))
            assert old['area']==new['area'] and len(old['frames'])==len(new['frames'])
            keys=['i','time','shaderTime','s','stage','lat','steer','hearts','coins','camera']
            assert all(all(a[k]==b[k] for k in keys) for a,b in zip(old['frames'],new['frames'])),sid
            assert all(fr['hearts']==5 for fr in new['frames']) and new['frames'][-1]['stage']!=sid
            file=d/'ride.mp4';m=meta(file)
            assert (m['width'],m['height'],m['r_frame_rate'],int(m['nb_frames']))==(648,1152,'12/1',len(old['frames']))
            check=compare_video(src['file'],file,len(old['frames']))
            assert check['minimumFrameCorrelation']>.92,(sid,kind,check)
            lab='CLAUDIA_RETAINED' if kind=='BEFORE' else 'CODEX_CANDIDATE'
            name='Screen_'+sid+'/SCREEN'+sid+'_'+lab+'_ENTRANCE_TO_EXIT.mp4'
            rec={**src,'stem':Path(name).stem,'section':'','file':str(file.resolve()),'name':name,'canonical':name,**m,'sha256':hashfile(file),'bytes':file.stat().st_size,
                 'description':'High-detail replay of the saved ride. Identical camera and gameplay state at every sampled frame.',
                 'conditionsMatchedAcrossEveryFrame':keys,'originalClipSHA256':hashfile(src['file']),'comparisonToSavedRide':check}
            out.append(rec)
        Path('hd-checked-'+sid+'.json').write_text(json.dumps(out,indent=2)+'\n')
        print(sid,[(r['nb_frames'],r['comparisonToSavedRide']['minimumFrameCorrelation']) for r in out],flush=True)
