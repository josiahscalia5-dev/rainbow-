from pathlib import Path
import json
import subprocess
from html import escape
from publish import OUTPUT, ROOT, TITLES, document, read

ids=('07','06','04','05','08')
base='https://github.com/josiahscalia5-dev/rainbow-'
best_views={'04':('forward-10','Forward +10'),'05':('hard-left','Hard left'),'06':('forward-10','Forward +10'),'07':('hard-right','Hard right'),'08':('hard-left','Hard left')}
rows=[];evidence=[];md=['# Rainbow playable scenery experiments','The five specialists were tested independently from the latest verified Claudia checkpoints. Each mobile package opens with three separate native images and includes full steering pairs and two continuous stage rides.']
for sid in ids:
    folder=OUTPUT/('Screen-'+sid)
    latest=read(ROOT/('final-push-'+sid+'.json'))
    decision=read(ROOT/('verdict-'+sid+'.json'))
    m=read(folder/'opening-metrics.json')
    motion=read(folder/'motion-checks.json')
    before=m['approvedVsBefore']['within20Percent'];new=m['approvedVsCandidate']['within20Percent']
    view,view_title=best_views[sid]
    row=f'<section><h2>{sid} · <a href="Screen-{sid}/index.html">{escape(TITLES[sid])}</a></h2><p><strong>{escape(decision["status"])}.</strong> {escape(decision["decision"])}</p><p>{escape(decision["remaining"])}</p><p><a href="Screen-{sid}/APPROVED.jpg">Approved</a> · <a href="Screen-{sid}/BEFORE/opening.png">Claudia before</a> · <a href="Screen-{sid}/NEW/opening.png">Codex new</a></p><p>{view_title} · <a href="Screen-{sid}/BEFORE/{view}.png">Claudia before</a> · <a href="Screen-{sid}/NEW/{view}.png">Codex new</a></p><p><a href="Screen-{sid}/BEFORE/ride.mp4">Before ride</a> · <a href="Screen-{sid}/NEW/ride.mp4">New ride</a> · <a href="Screen-{sid}.zip">Download this screen</a> · <a href="{base}/commit/{latest["commit"]}">Verified GitHub commit</a></p></section>'
    rows.append(row)
    rendered=[x for x in motion['stills'] if 'skipped' not in x]
    budgets={}
    for key in ('calls','triangles','textures'):
        changes=[x['newDraws'][key]-x['beforeDraws'][key] for x in rendered]
        budgets[key]={'minimumChange':min(changes),'maximumChange':max(changes)}
    evidence.append({'rendererChanges':budgets,'screen':sid,'verdict':decision,'commit':latest,'openingRGBBefore':before,'openingRGBNew':new,'matchedNativeViews':len([x for x in motion['stills'] if 'skipped' not in x]),'rideFrames':motion['ride']['frames']})
    md.extend([f"## {sid} · {TITLES[sid]}",f"**{decision['status']}.** {decision['decision']} {decision['remaining']}",
              f"[Separate originals and moving views](Screen-{sid}/index.html) · [Before ride](Screen-{sid}/BEFORE/ride.mp4) · [New ride](Screen-{sid}/NEW/ride.mp4) · [Verified GitHub commit]({base}/commit/{latest['commit']})"])
measure_rows=''.join(f'<tr><td>{r["screen"]}</td><td>{r["openingRGBBefore"]:.3f}%</td><td>{r["openingRGBNew"]:.3f}%</td><td>{r["matchedNativeViews"]}</td></tr>' for r in evidence)
props=read(ROOT/'protected-end.json')
body='<h1>Rainbow scenery review</h1><p>Each screen opens with the original artwork, Claudia’s retained gameplay, and the experimental gameplay at 864 × 1536. The paired rides run from inlet through the stage handoff.</p>'+''.join(rows)+f'<h2>Opening measurements</h2><table><thead><tr><th>Screen</th><th>Before</th><th>New</th><th>Matched views</th></tr></thead><tbody>{measure_rows}</tbody></table><p>RGB agreement counts every native pixel whose average absolute channel error is at most 20 out of 255. Each screen’s report includes Pixelmatch mismatches and independent repeat measurements. Unpictured moving views are assessed visually.</p><p>All ten selected rides crossed their stage boundary with five hearts. The handoff images match exactly in each before/new pair. Both variants on every screen passed eight gameplay assertions, collected 91 coins and advanced from 1,330 to 2,240. The stock Screen 04 coin route lost one heart in both builds. A separate full-game route finished with five hearts and the same score. Draw calls were unchanged across the captured viewpoints. Screen 05 uses one additional texture. Screen 07 uses two additional textures and draws 368 fewer triangles when the fitted paddle is visible. Physical Android frame times and sustained performance remain to be measured.</p><p><a href="verification.json">Checkpoint and evidence verification</a></p>'
(OUTPUT/'index.html').write_text(document('Rainbow scenery review',body))
(OUTPUT/'README.md').write_text('\n\n'.join(md)+'\n')
(OUTPUT/'verification.json').write_text(json.dumps({'experiments':evidence,'protectedRefs':props},indent=2)+'\n')
print('Mobile index verified',len(rows))
