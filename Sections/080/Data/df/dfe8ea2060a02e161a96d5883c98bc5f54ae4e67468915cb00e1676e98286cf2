from pathlib import Path
import json,subprocess as sp,os,zipfile,hashlib
root=Path(__file__).resolve().parent;pkg=root/'payload';repo=root/'delivery-tree.git'
proof=json.loads((root/'delivery-proof.json').read_text())
target=json.loads((root/'remote.json').read_text())['refs']['codex/s06-benny-fitted-knit-cuff']
branch='codex/downloads/full-code-and-screens-20261119-'+proof['sha256'][:8]
if not repo.exists():
 sp.run(['git','init','-q','--bare',str(repo)],check=True)
 (repo/'objects/info/alternates').write_text(str((root/'sources.git/objects').resolve())+'\n')
cmd=['git','--no-lazy-fetch','-C',str(repo)]
env=dict(os.environ,GIT_INDEX_FILE=str(root/'review-git-index'),GIT_AUTHOR_NAME='Codex',GIT_AUTHOR_EMAIL='codex@users.noreply.github.com',GIT_COMMITTER_NAME='Codex',GIT_COMMITTER_EMAIL='codex@users.noreply.github.com')
with zipfile.ZipFile(root/'ready-for-delivery.zip') as z:
 entries=sorted((i.filename,('100755' if i.external_attr>>16&0o111 else '100644')) for i in z.infolist())
 paths='\n'.join(str(pkg/f) for f,_ in entries)+'\n'
 raw=sp.run(cmd+['hash-object','-w','--no-filters','--stdin-paths'],input=paths.encode(),env=env,stdout=sp.PIPE,stderr=sp.PIPE,check=True).stdout.decode().splitlines()
 assert len(raw)==len(entries) and all(len(h)==40 for h in raw)
 index=b''.join((mode+' '+oid+'\t'+f+'\0').encode() for (f,mode),oid in zip(entries,raw))
 sp.run(cmd+['update-index','-z','--index-info'],input=index,env=env,stdout=sp.DEVNULL,check=True)
 tree=sp.check_output(cmd+['write-tree'],env=env).decode().strip()
 msg='Package the five Rainbow screens, full game source and verified motion evidence for phone review.\n'
 commit=sp.check_output(cmd+['commit-tree',tree,'-p',target],input=msg.encode(),env=env).decode().strip()
 objects=sp.check_output(cmd+['ls-tree','-rz',commit],env=env).split(b'\0')
 assert len([x for x in objects if x])==proof['files']
 (root/'private-review-tree.json').write_text(json.dumps({'tree':tree,'commit':commit,'branch':branch,'base':target,'files':len(raw)},indent=2)+'\n')
 print('Prepared one isolated review tree',len(raw),'files,',commit,flush=True)

