{"cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-57af22a4-lsg7y7", "isSidechain": false, "message": {"content": [{"content": "205\t\n206\t/** linear radiance for a stylised palette entry: the values are solved so that, after Neutral tone mapping\n207\t *  (exposure 0.86), sRGB output and the grade pass (sat 1.36 / con 1.15), they land on the display colour\n208\t *  sampled from the approved reference (comment = target display sRGB) */\n209\tconst lin3 = (r: number, g: number, b: number) => new THREE.Vector3(r, g, b);\n210\t\n211\t/**\n212\t * Ref 05 ring look (wave 7): a stylised polished band instead of the env-map PBR result (which clipped to one\n213\t * flat orange). The band profile (roundBandGeometry: main half-round band, groove, camera-side lip) is read\n214\t * from the object-space axial coordinate, so every ring — near, real far, forced-perspective far — gets the\n215\t * same cross-section: dark rose contour at both edges → rose-copper → orange line → peach-gold body → pale\n216\t * white-yellow highlight line on the crown, a darker orange-copper groove, and a rose lip with a light crown.\n217\t * Warm-white \"marquee\" spots sit at `count` fixed azimuths (top spot at 12 o'clock) so the spots of all rings\n218\t * line up radially toward the VP like the reference. Deeper rings fade to rose-copper (ref rings #2/#3); the\n219\t * FarGlow (if the material has one) then melts them into the warm throat. Measured reference cross-section\n220\t * (ring #1, y 188→230 at x≈499): dark (161,32,91) · rose lip (219,96,104) · groove (202,67,51) · peach body\n221\t * (241,154,124) with white spots · rose (206,96,104) · dark (122,30,84); side view (y≈450): orange (251,135,29)\n222\t * then pale yellow crown (252,205,130).\n223\t */\n224\texport interface BandShade {\n225\t  /** band profile (same numbers as the BandOpts given to bandGeometry) */\n226\t  width: number; lipWidth: number; groove: number;\n227\t  /** spots per turn, spot half-width (fraction of the pitch), spot strength */\n228\t  spots?: [number, number, number];\n229\t  /** view distance range over which the crown highlight fades to rose-copper (deeper rings) */\n230\t  fade?: [number, number];\n231\t  /** optional per-channel tone exponents on the final band colour (linear): >1 deepens mid-tones, highlights stay\n232\t   *  bright. Screen 05 test G1 (?gold05=1); undefined = shader unchanged */\n233\t  tone?: [number, number, number];\n234\t}\n235\texport function withBandShading<T extends THREE.MeshStandardMaterial>(mat: T, b: BandShade, key: string): T {\n236\t  const w = (b.width + b.groove + b.lipWidth) / 2;\n237\t  const uniforms = {\n238\t    uBandG: { value: new THREE.Vector4(w - b.width / 2, b.width / 2, -w + b.lipWidth / 2, b.lipWidth / 2) },\n239\t    // ref ring #1: spot pitch ≈85 px at r 273 (≈20/turn), white core ≈12 px inside a yellow halo\n240\t    uBandS: { value: new THREE.Vector4(...(b.spots ?? [20, 0.055, 1.6]), 0) },\n241\t    uBandF: { value: new THREE.Vector2(...(b.fade ?? [44, 110])) },\n242\t    uBcDark: { value: lin3(0.2934, 0.0886, 0.1533) }, // (150,35,85)\n243\t    uBcRose: { value: lin3(0.5899, 0.2114, 0.2222) }, // (215,95,100)\n244\t    uBcOrange: { value: lin3(0.7352, 0.2871, 0.1269) }, // (240,120,40)\n245\t    uBcCrown: { value: lin3(0.6246, 0.22, 0.199) }, // (222,98,88) rose-gold body between the spots (ref (215–230,90–100,80–95))\n246\t    uBcPeak: { value: lin3(0.9077, 0.602, 0.3465) }, // (252,190,120) highlight line\n247\t    uBcHalo: { value: lin3(0.9439, 0.6846, 0.2725) }, // (255,205,90) yellow halo around each spot\n248\t    uBcGroove: { value: lin3(0.5618, 0.1695, 0.1159) }, // (214,79,44) orange-red groove line (ref ring #1 top y 200–202)\n249\t    uBcSpot: { value: lin3(1.6, 1.5, 1.3) }, // warm white, blooms a little\n250\t    // wave 8: the rings READ gold because their sides are a broad pale-yellow crown between saturated orange\n251\t    // lines (ref ring #2 left side, x 199→239: dark · peach-orange lip (245,115,80) · orange-red line (234,89,4)\n252\t    // · pale yellow (252,206,130) with white maxima · orange (246,151,70) · peach); only the near top arc\n253\t    // (ring #1, ≈11–1 o'clock) is rose-red between big white spots\n254\t    uBcPale: { value: lin3(0.931, 0.6926, 0.3911) }, // (252,206,130)\n255\t    uBcGold: { value: lin3(0.8111, 0.4073, 0.193) }, // (246,151,70)\n256\t    uBcLine: { value: lin3(0.6601, 0.1926, 0.0761) }, // (234,89,4)\n257\t    uBcLipS: { value: lin3(0.7599, 0.2745, 0.1948) }, // (245,115,80)\n258\t  };\n259\t  const prev = mat.onBeforeCompile;\n260\t  mat.onBeforeCompile = (shader, r) => {\n261\t    prev.call(mat, shader, r);\n262\t    Object.assign(shader.uniforms, uniforms);\n263\t    shader.vertexShader = shader.vertexShader\n264\t      .replace('#include <common>', '#include <common>\\nvarying vec3 vBandP; varying vec3 vBandAx;')\n265\t      .replace('#include <begin_vertex>', `#include <begin_vertex>\n266\tvBandP = position;\n267\t#ifdef USE_INSTANCING\n268\tvBandAx = (viewMatrix * modelMatrix * instanceMatrix * vec4(0.0, 0.0, 1.0, 0.0)).xyz;\n269\t#else\n270\tvBandAx = (viewMatrix * modelMatrix * vec4(0.0, 0.0, 1.0, 0.0)).xyz;\n271\t#endif`);\n272\t    const fg = shader.fragmentShader.includes('float farGlowK()');\n273\t    shader.fragmentShader = shader.fragmentShader\n274\t      .replace('void main() {', `varying vec3 vBandP; varying vec3 vBandAx;\n275\tuniform vec4 uBandG; uniform vec4 uBandS; uniform vec2 uBandF;\n276\tuniform vec3 uBcDark; uniform vec3 uBcRose; uniform vec3 uBcOrange; uniform vec3 uBcCrown; uniform vec3 uBcPeak; uniform vec3 uBcGroove; uniform vec3 uBcSpot; uniform vec3 uBcHalo;\n277\tuniform vec3 uBcPale; uniform vec3 uBcGold; uniform vec3 uBcLine; uniform vec3 uBcLipS;\n278\t// The rider sees every band at a grazing angle, i.e. mostly its camera-facing flank: the colour therefore\n279\t// follows the view-space normal — facing (ndv) for body → orange line → rose → dark silhouette contour, the\n280\t// normal's axial component (nzv: -1 camera-facing base … 0 crown) for the highlight line — and the axial\n281\t// coordinate only for the thin dark contour lines where band and lip meet the wall and for the groove.\n282\tvec3 bandShade(float deep, vec3 N, vec3 V){\n283\t  float z = vBandP.z;\n284\t  float m = (z - uBandG.x) / uBandG.y;          // main band: -1 camera side … +1 far side\n285\t  float l = (z - uBandG.z) / uBandG.w;          // lip\n286\t  float fm = fwidth(m) + 1e-3, fl = fwidth(l) + 1e-3;\n287\t  // sign-robust: the forced-perspective rings are placed with a mirrored basis (inverted winding), so the\n288\t  // rendered side can face away; shade the camera-facing orientation of whatever side is drawn\n289\t  float nv = dot(N, V);\n290\t  float ndv = abs(nv);\n291\t  vec3 ax = normalize(vBandAx);\n292\t  ax *= sign(dot(ax, -V) + 1e-4);                // tube axis pointing away from the camera\n293\t  float nzv = dot(N * sign(nv + 1e-4), ax);      // -1 = flank facing the camera … 0 = crown\n294\t  // wave 8: only the near top arc (±30°, gone by ±55°) keeps the rose-red body of ref ring #1's top; the sides\n295\t  // and the deeper rings read gold: pale-yellow crown framed by orange (ref ring #2/#3 sides)\n296\t  float topArc = (1.0 - smoothstep(0.52, 0.96, abs(atan(vBandP.y, vBandP.x) - 1.5707963))) * (1.0 - deep);\n297\t  vec3 body = mix(mix(uBcGold, uBcPale, smoothstep(0.42, 0.62, ndv)), uBcCrown, topArc);\n298\t  body = mix(body, mix(uBcOrange, uBcGold, 0.5), deep * 0.55);      // deeper rings: orange with bright spots\n299\t  vec3 c = mix(uBcDark, mix(uBcLipS, uBcRose, topArc), smoothstep(0.03, 0.12, ndv));\n300\t  c = mix(c, uBcOrange, smoothstep(0.13, 0.22, ndv));\n301\t  c = mix(c, body, smoothstep(0.26, 0.4, ndv));\n302\t  float hl = exp(-pow((nzv + 0.8) / 0.07, 2.0)) * smoothstep(0.3, 0.5, ndv);\n303\t  c = mix(c, uBcPeak, hl * (0.95 - 0.6 * deep) * (0.35 + 0.65 * topArc));\n304\t  // saturated orange-red line just inside the