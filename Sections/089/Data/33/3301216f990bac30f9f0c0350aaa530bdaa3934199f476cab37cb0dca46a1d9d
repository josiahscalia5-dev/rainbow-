const fs=require('node:fs');
const path=require('node:path');
const http=require('node:http');
const assert=require('node:assert/strict');
const {chromium}=require('playwright');

(async()=>{
 const dist='/workspace/library-files/Rainbow-ChatGPT-Review';
 const permitted=new Set();
 const walk=(dir)=>{
   for(const e of fs.readdirSync(dir,{withFileTypes:true})){
     const file=path.join(dir,e.name);
     if(e.isDirectory())walk(file);
     else if(e.isFile())permitted.add('/'+path.relative(dist,file));
   }
 };
 walk(dist);
 const server=http.createServer((req,res)=>{
   const url=new URL(req.url,'http://localhost').pathname;
   if(!permitted.has(url)){res.writeHead(404);res.end();return;}
   const f=path.join(dist,url);const mime={'.html':'text/html','.zip':'application/zip','.mp4':'video/mp4','.md':'text/plain','.txt':'text/plain','.jpg':'image/jpeg','.png':'image/png'};
   res.writeHead(200,{'Content-Type':mime[path.extname(f)]||'application/octet-stream','Content-Length':fs.statSync(f).size});
   if(req.method==='HEAD'){res.end();return;}
   fs.createReadStream(f).pipe(res);
 });
 await new Promise(r=>server.listen(0,'127.0.0.1',r));
 const browser=await chromium.launch({executablePath:'/usr/bin/chromium',args:['--disable-background-networking']});
 const summary=[];
 try{
   for(const width of [360,393]){
     const page=await browser.newPage({viewport:{width,height:830},hasTouch:true,isMobile:true});
     await page.goto('http://127.0.0.1:'+server.address().port+'/Android_Fallback.html');
     const refs=await page.evaluate(()=>({width:window.innerWidth,scroll:document.documentElement.scrollWidth,links:[...document.querySelectorAll('a')].map(x=>x.getAttribute('href'))}));
     assert.equal(refs.width,width);assert.equal(refs.scroll,width);
     assert.equal(refs.links.filter(x=>x.endsWith('.mp4')).length,10);
     assert.equal(refs.links.filter(x=>x.includes('Small_Image_Batches/')).length,5);
     for(const url of refs.links){
       const response=await page.request.head('http://127.0.0.1:'+server.address().port+'/'+url);
       assert.equal(response.status(),200,url);assert.equal(+response.headers()['content-length'],fs.statSync(path.join(dist,url)).size);
     }
     summary.push({width,downloadLinks:refs.links.length});await page.close();
   }
 }finally{await browser.close();await new Promise(r=>server.close(r));}
 fs.writeFileSync('phone-review-check.json',JSON.stringify(summary,null,2)+'\n');console.log(summary);
})().catch(e=>{console.error(e.message);process.exitCode=1;});
