from pathlib import Path
import subprocess,json,hashlib,io
from PIL import Image
import numpy as np
a=Path('/tmp/rainbow-visual-audit.X0POSzUq/objects.git');commit='d22ec46b72146d69703d4271cd54c1c852164dff'
root=Path(__file__).parent;g=['git','--git-dir='+str(a)]
files=subprocess.check_output(g+['ls-tree','-r','--name-only',commit,'qa/da3/2026-11-18'],text=True).splitlines();records=[]
for f in files:
 raw=subprocess.check_output(g+['show',commit+':'+f])
 if f.endswith('.png'):
  im=Image.open(io.BytesIO(raw));im.load()
  records.append({'path':f,'size':im.size,'range':list(im.convert('L').getextrema()),'sha256':hashlib.sha256(raw).hexdigest()})
 elif f.endswith(('.json','.md')):
  (root/f.replace('/','_')).write_bytes(raw)
project=Path('/tmp/rainbow-final-fidelity.RuUP0xJ2');cameras={}
for sid in ['04','05','06','07','08']:
 gen=project/'games'/sid/'assets/textures'
 hits=sorted(set(list((gen/('match'+sid)).glob('*cam*json'))+list((gen/('match'+sid)).glob('proj*.json'))))
 cameras[sid]=[{'path':f.relative_to(project/'games'/sid).as_posix(),'fields':list(json.loads(f.read_text()))[:6]} for f in hits]
(root/'scene-evidence.json').write_text(json.dumps({'lead':commit,'depthImages':records,'cameraFiles':cameras},indent=2))
print('decoded depth evidence',len(records),'camera files',sum(map(len,cameras.values())))
