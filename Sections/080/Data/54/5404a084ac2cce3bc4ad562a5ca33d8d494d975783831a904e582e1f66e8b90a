    trial=sp.run(basecmd+['-c','fetch.negotiationAlgorithm=noop','fetch','origin','--quiet','--no-tags','--no-write-fetch-head','--recurse-submodules=no','--filter=blob:none','--stdin'],input=('\n'.join(batch)+'\n').encode(),stdout=sp.PIPE,stderr=sp.PIPE)
    if trial.returncode:
