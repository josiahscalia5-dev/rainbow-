Math.PI / 2);\n63\t  drumGeo.translate(0, 0, (dA.zDoor + dA.zBack) / 2);\n64\t  const drumMat = perforatedMetal({ color: '#f04fc8', emissive: '#c22aa6', emissiveIntensity: 0.3, slot: 0, repeatU: 54, repeatV: 15, holeSize: 0.44, streaks: 0.15 });\n65\t  zones.drumA.add(new THREE.Mesh(drumGeo, drumMat));\n66\t  // back wall with the drain opening\n67\t  const backShape = new THREE.Shape();\n68\t  backShape.absarc(0, 0, dA.radius, 0, Math.PI * 2, false);\n69\t  const drainHole = new THREE.Path();\n70\t  drainHole.absarc(-0.3, -3.05, 1.85, 0, Math.PI * 2, true);\n71\t  backShape.holes.push(drainHole);\n72\t  const backGeo = new THREE.ShapeGeometry(backShape, 48);\n73\t  backGeo.translate(0, 0, dA.zBack);\n74\t  const backMat = perforatedMetal({ color: '#e544c4', slot: 0, repeatU: 9, repeatV: 9, holeSize: 0.4, side: THREE.DoubleSide, streaks: 0 });\n75\t  zones.drumA.add(new THREE.Mesh(backGeo, backMat));\n76\t  // front wall annulus\n77\t  const frontShape = new THREE.Shape();\n78\t  frontShape.absarc(0, 0, dA.radius, 0, Math.PI * 2, false);\n79\t  const doorHole = new THREE.Path();\n80\t  doorHole.absarc(0, 0, dA.doorRadius, 0, Math.PI * 2, true);\n81\t  frontShape.holes.push(doorHole);\n82\t  const frontGeo = new THREE.ShapeGeometry(frontShape, 64);\n83\t  frontGeo.translate(0, 0, dA.zDoor);\n84\t  zones.drumA.add(new THREE.Mesh(frontGeo, perforatedMetal({ color: '#f15ccd', slot: 0, repeatU: 8, repeatV: 8, holeSize: 0.0, side: THREE.DoubleSide, streaks: 0, metalness: 0.85, roughness: 0.18 })));\n85\t  // gold door ring (thick) + chrome inner lip\n86\t  const ringA = new THREE.Mesh(new THREE.TorusGeometry(dA.doorRadius + 0.35, 0.48, 24, 96), goldMat);\n87\t  ringA.position.set(0, 0, dA.zDoor - 0.1);\n88\t  zones.drumA.add(ringA);\n89\t  const ringA2 = new THREE.Mesh(new THREE.TorusGeometry(dA.doorRadius + 1.15, 0.22, 16, 96), goldSoft);\n90\t  ringA2.position.set(0, 0, dA.zDoor - 0.15);\n91\t  zones.drumA.add(ringA2);\n92\t  // lifters (gold baffles)\n93\t  for (const 