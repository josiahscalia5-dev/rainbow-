{"agentId": "a6cf99da60850f11a", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "claude/rainbow-3d-account-transfer-syorak", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Runtime Benny: loads the canonical assets/models/benny.glb, upgrades fur_* meshes to shell fur,\n3\t * and drives expressions + procedural secondary motion on top of the GLB clips.\n4\t */\n5\timport * as THREE from 'three';\n6\timport { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';\n7\timport type { BennyRuntime } from '../types';\n8\timport { makeFur, type FurHandle, type FurParams } from './fur';\n9\t\n10\tconst BENNY_URL = new URL('../../../assets/models/benny.glb', import.meta.url).href;\n11\t\n12\tlet cached: Promise<THREE.Group> | null = null;\n13\t\n14\tfunction loadScene(): Promise<THREE.Group> {\n15\t  if (!cached) cached = new GLTFLoader().loadAsync(BENNY_URL).then((g) => {\n16\t    const s = g.scene as THREE.Group;\n17\t    s.userData.animations = g.animations;\n18\t    return s;\n19\t  });\n20\t  return cached;\n21\t}\n22\t\n23\t/** fur tier: explicit option, else `?quality=low|high`, else low on Android/iOS (same rule as the water) */\n24\tfunction defaultFurQuality(): 'high' | 'low' {\n25\t  if (typeof location === 'undefined') return 'high';\n26\t  const qp = new URLSearchParams(location.search).get('quality');\n27\t  const mobile = typeof navigator !== 'undefined' && /Android|iPhone|iPad/i.test(navigator.userAgent);\n28\t  return qp === 'low' || (qp !== 'high' && mobile) ? 'low' : 'high';\n29\t}\n30\t\n31\texport async function loadBenny(opts: { furQuality?: 'high' | 'low' } = {}): Promise<BennyRuntime> {\n32\t  const src = await loadScene();\n33\t  const clips: THREE.AnimationClip[] = src.userData.animations ?? [];\n34\t  return createBennyRuntime(src.clone(true), clips, { furQuality: opts.furQuality ?? defaultFurQuality() });\n35\t}\n36\t\n37\t/**\n38\t * Ride height. The game places the root at water surface + radius·0.55 (≈ 0.44), which buried the lower\n39\t * third of the plush ball in the opaque stream. While riding (swim ≥ 0.5, not tumbling) the model is\n40\t * lifted inside the root so he sits ON the water like refs 04–10: only the bottom of the fur and the\n41\t * kicking feet are under the surface. Cinematics (01 peek, 02 tumble, 11 hide) keep the root as placed.\n42\t * Wave 4: 0.30 → 0.22 together with the ride lean, which shows more of his back: keeps the pom-pom top at the\n43\t * ref-05 height (≈ 765 px, under the first coin) and the cuff bottom where the ref has it.\n44\t */\n45\texport const BENNY_RIDE_LIFT = 0.22;\n46\t/** QA A/B hook: `?bennyLift=<units>` overrides the ride lift (e.g. 0 = the game's raw placement) */\n47\tfunction rideLift(): number {\n48\t  if (typeof location === 'undefined') return BENNY_RIDE_LIFT;\n49\t  const v = parseFloat(new URLSearchParams(location.search).get('bennyLift') ?? '');\n50\t  return Number.isFinite(v) ? THREE.MathUtils.clamp(v, 0, 0.6) : BENNY_RIDE_LIFT;\n51\t}\n52\t\n53\t/**\n54\t * Ride lean (rad, about his X axis, + = top forward). While riding he leans into the current like a swimmer, so the\n55\t * rear chase cameras (04–10: ≈ 25° above him) see the beanie and the plush back the way the references paint\n56\t * them (≈ 10–12° above: knit stripes and cuff read as level bands, the dome as a tall cap, not a flat disc).\n57\t * Eased in with the ride lift; cinematics (01 peek, 02 tumble, 11 hide) keep him upright. The game can scale it\n58\t * per shot with `benny.root.userData.ridePitch` (0…1, default 1), e.g. 0 in the 03 twirl where he faces the camera.\n59\t */\n60\texport const BENNY_RIDE_PITCH = 0.22;\n61\tfunction ridePitch(): number {\n62\t  if (typeof location === 'undefined') return BENNY_RIDE_PITCH;\n63\t  const v = parseFloat(new URLSearchParams(location.search).get('bennyPitch') ?? '');\n64\t  return Number.isFinite(v) ? THREE.MathUtils.clamp(THREE.MathUtils.degToRad(v), -0.5, 0.5) : BENNY_RIDE_PITCH;\n65\t}\n66\t\n67\t/** Build the runtime around an already-loaded (or freshly built) Benny scene graph. */\n68\texport function createBennyRuntime(\n69\t  scene: THREE.Object3D,\n70\t  clips: THREE.AnimationClip[],\n71\t  opts: { furQuality?: 'high' | 'low' } = {},\n72\t): BennyRuntime {\n73\t  const root = new THREE.Group();\n74\t  root.name = 'Benny';\n75\t  root.add(scene);\n76\t\n77\t  // ---- fur upgrade ----\n78\t  const furs: FurHandle[] = [];\n79\t  const toReplace: THREE.Mesh[] = [];\n80\t  scene.traverse((o) => {\n81\t    const m = o as THREE.Mesh;\n82\t    if (m.isMesh && m.name.startsWith('fur_') && m.userData?.fur) toReplace.push(m);\n83\t  });\n84\t  for (const m of toReplace) {\n85\t    const p = { ...(m.userData.fur as FurParams) };\n86\t    if (opts.furQuality === 'low') p.shells = Math.max(6, Math.round(p.shells * 0.6));\n87\t    const h = makeFur(m, p);\n88\t    m.parent!.add(h.mesh);\n89\t    m.parent!.remove(m);\n90\t    furs.push(h);\n91\t  }\n92\t\n93\t  const get = (n: string) => scene.getObjectByName(n)!;\n94\t  const body = get('body');\n95\t  const pom = get('pom');\n96\t  const eyeL = get('eyeL');\n97\t  const eyeR = get('eyeR');\n98\t  const eyesGroup = get('eyes');\n99\t  const pomRest = pom.quaternion.clone();\n100\t\n101\t  // ---- animation mixer: idle ↔ swim blend, tumble / peek on demand ----\n102\t  const mixer = new THREE.AnimationMixer(scene);\n103\t  const act = (name: string) => {\n104\t    const c = clips.find((k) => k.name === name);\n105\t    return c ? mixer.clipAction(c) : null;\n106\t  };\n107\t  const aIdle = act('idle'), aSwim = act('swim'), aTumble = act('tumble'), aPeek = act('peek');\n108\t  for (const a of [aIdle, aSwim, aTumble, aPeek]) a?.play();\n109\t  const setW = (a: THREE.AnimationAction | null, w: number) => a && a.setEffectiveWeight(w);\n110\t\n111\t  let expression: 'happy' | 'dizzy' | 'peek' = 'happy';\n112\t  const setExpression = (e: 'happy' | 'dizzy' | 'peek') => {\n113\t    expression = e;\n114\t    for