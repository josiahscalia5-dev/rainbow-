{"agentId": "a37bba196b0b06729", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-8b6fc834-7kd55l", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Gold $ coins anchored to the course (s, lateral, height). Real pickups: distance test against\n3\t * Benny each frame; collected coins pop + sparkle and the counter increments by COIN_VALUE.\n4\t * Layout follows the coin trails visible in the references (03 spiral trail, 04 left edge,\n5\t * 05/07 snaking centre line, 06 on the arch crest, 08–10 toward the towel).\n6\t */\n7\timport * as THREE from 'three';\n8\timport type { Course, StageId } from '../world/course';\n9\timport { canvasTexture } from '../world/materials';\n10\t\n11\texport const COIN_VALUE = 10;\n12\t\n13\texport interface CoinDef { s: number; lat: number; h: number; stage: StageId }\n14\t\n15\texport function coinLayout(course: Course): CoinDef[] {\n16\t  const out: CoinDef[] = [];\n17\t  const add = (stage: StageId, s: number, lat: number, h = 0.9) => out.push({ s, lat, h, stage });\n18\t  const st = (id: StageId) => course.stage(id);\n19\t  // 03 — spiral trail ahead of Benny toward the drain\n20\t  { const a = st('03'); for (let i = 0; i < 9; i++) add('03', a.s0 + 6 + i * 2.7, 0.9 - i * 0.12); }\n21\t  // 04 — along the left edge of the slide\n22\t  { const a = st('04'); for (let i = 0; i < 8; i++) add('04', a.s0 + 9 + i * 3.6, -1.35); }\n23\t  // 05 — snaking centre line\n24\t  { const a = st('05'); const n = 18; for (let i = 0; i < n; i++) { const s = a.s0 + 8 + i * ((a.s1 - a.s0 - 12) / n); add('05', s, 1.2 * Math.sin(i * 0.55)); } }\n25\t  // 06 — up and over the crest (left of centre like the ref)\n26\t  { const a = st('06'); const n = 18; for (let i = 0; i < n; i++) { const s = a.s0 + 4 + i * ((a.s1 - a.s0 - 6) / n); add('06', s, -1.3 + 0.7 * Math.sin(i * 0.4)); } }\n27\t  // 07 — winding trail, continuing down the plunge\n28\t  { const a = st('07'); const n = 24; for (let i = 0; i < n; i++) { const s = a.s0 + 6 + i * ((a.s1 - a.s0 - 10) / n); add('07', s, 1.0 * Math.sin(i * 0.5 + 1)); } }\n29\t  // 08 — S toward the platform\n30\t  { const a = st('08'); for (let i = 0; i < 8; i++) add('08', a.s0 + 3 + i * 1.9, -0.6 + 0.9 * Math.sin(i * 0.8)); }\n31\t  // 09 — arc along the left (inside of the bend, under the wave)\n32\t  { const a = st('09'); for (let i = 0; i < 9; i++) add('09', a.s0 + 1.5 + i * 1.7, -1.7 + i * 0.12); }\n33\t  // 10 — straight line into the towel tunnel\n34\t  { const a = st('10'); for (let i = 0; i < 5; i++) add('10', a.s0 + 1.5 + i * 2.0, -0.15); }\n35\t  return out;\n36\t}\n37\t\n38\texport interface CoinSystem {\n39\t  group: THREE.Group;\n40\t  defs: CoinDef[];\n41\t  collected: Uint8Array;\n42\t  /** returns number of coins picked up this frame */\n43\t  update(time: number, dt: number, bennyS: number, bennyLat: number): number;\n44\t  /** mark coins before s as collected (deterministic QA checkpoint state) or reset all */\n45\t  resetUntil(s: number): void;\n46\t}\n47\t\n48\texport function createCoins(course: Course): CoinSystem {\n49\t  const defs = coinLayout(course);\n50\t  const faceTex = canvasTexture(256, 256, (c, w, h) => {\n51\t    const g = c.createRadialGradient(w * 0.38, h * 0.32, 10, w / 2, h / 2, w * 0.55);\n52\t    g.addColorStop(0, '#fffbd8');\n53\t    g.addColorStop(0.5, '#ffdc3a');\n54\t    g.addColorStop(1, '#f0a400');\n55\t    c.fillStyle = g;\n56\t    c.beginPath(); c.arc(w / 2, h / 2, w / 2, 0, Math.PI * 2); c.fill();\n57\t    c.strokeStyle = '#ffe680'; c.lineWidth = 10;\n58\t    c.beginPath(); c.arc(w / 2, h / 2, w * 0.38, 0, Math.PI * 2); c.stroke();\n59\t    c.font = '800 170px \"Baloo 2\", Arial Black, sans-serif';\n60\t    c.textAlign = 'center'; c.textBaseline = 'middle';\n61\t    c.fillStyle = '#c47800';\n62\t    c.fillText('$', w / 2 + 4, h / 2 + 12);\n63\t    c.fillStyle = '#fff1a8';\n64\t    c.fillText('$', w / 2 - 2, h / 2 + 6);\n65\t  });\n66\t  const geo = new THREE.CylinderGeometry(0.5, 0.5, 0.14, 40, 1);\n67\t  geo.rotateX(Math.PI / 2); // faces along ±Z\n68\t  const side = new THREE.MeshStandardMaterial({ color: '#ffd23c', metalness: 0.9, roughness: 0.22, emissive: '#d08a00', emissiveIntensity: 0.55 });\n69\t  const face = new THREE.MeshStandardMaterial({ map: faceTex, metalness: 0.55, roughness: 0.3, emissive: '#ffffff', emissiveIntensity: 0.55, emissiveMap: faceTex });\n70\t  const mesh = new THREE.InstancedMesh(geo, [side, face, face], defs.length);\n71\t  mesh.frustumCulled = false;\n72\t  const group = new THREE.Group();\n73\t  group.name = 'coins';\n74\t  group.add(mesh);\n75\t  const collected = new Uint8Array(defs.length);\n76\t  const popT = new Float32Array(defs.length).fill(-1);\n77\t  const m = new THREE.Matrix4(), q = new THREE.Quaternion(), basis = new THREE.Matrix4();\n78\t  const p = new THREE.Vector3(), sc = new THREE.Vector3();\n79\t  const spin = new THREE.Quaternion(), axis = new THREE.Vector3();\n80\t  const back = new THREE.Vector3();\n81\t\n82\t  const place = (time: number) => {\n83\t    defs.forEach((d, i) => {\n84\t      const f = course.sample(d.s);\n85\t      let scale = 1;\n86\t      if (collected[i]) {\n87\t        if (popT[i] < 0) { sc.setScalar(0); m.compose(p.set(0, -9999, 0), q.identity(), sc); mesh.setMatrixAt(i, m); return; }\n88\t        const k = THREE.MathUtils.clamp((time - popT[i]) / 0.35, 0, 1);\n89\t        if (k >= 1) { popT[i] = -1; sc.setScalar(0); m.compose(p.set(0, -9999, 0), q.identity(), sc); mesh.setMatrixAt(i, m); return; }\n90\t        scale = 1 + k * 0.8;\n91\t        p.copy(f.pos).addScaledVector(f.right, d.lat).addScaledVector(f.up, d.h + k * 1.6);\n92\t      } else {\n93\t        p.copy(f.pos).addScaledVector(f.right, d.lat).addScaledVector(f.up, d.h + 0.08 * Math.sin(time * 3 + i));\n94\t      }\n95\t      back.copy(f.tan).negate();\n96\t      const right = new THREE.Vector3().crossVectors(f.up, back).normalize();\n97\t      basis.makeBasis(right, f.up, back);\n98\t      q.setFromRotationMatri