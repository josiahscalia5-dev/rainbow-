import hashlib
import json
from pathlib import Path
import subprocess
import sys
from zipfile import BadZipFile, ZipFile, is_zipfile

root = Path(__file__).parent
name = sys.argv[1]
entry = json.loads((root / "snapshot-plan.json").read_text())[name]
expected = json.loads((root / (name + ".manifest.json")).read_text())
target = root / (name + ".redownload.zip")
repo = "josiahscalia5-dev/rainbow-"
link = f"https://github.com/{repo}/archive/refs/heads/{entry['branch']}.zip"
web = subprocess.run(
    ["curl", "--silent", "--show-error", "--fail", "--location",
     "--max-time", "210", "--output", str(target), "--write-out", "%{http_code}", link],
    capture_output=True, text=True)
print(name, "web download HTTP", web.stdout.strip(), flush=True)
via = "github.com archive link"
if web.returncode or not is_zipfile(target):
    via = "authenticated GitHub archive API"
    endpoint = f"repos/{repo}/zipball/{entry['commits'][-1]}"
    with target.open("wb") as out:
        response = subprocess.run(["gh", "api", endpoint], stdout=out, stderr=subprocess.PIPE)
    if response.returncode or not is_zipfile(target):
        raise RuntimeError(f"{name} authenticated GitHub ZIP retrieval failed (CLI {response.returncode})")
seen = {}
with ZipFile(target) as archive:
    files = [i for i in archive.infolist() if not i.is_dir()]
    prefixes = {i.filename.partition("/")[0] for i in files}
    if len(prefixes) != 1:
        raise BadZipFile("Expected one GitHub archive wrapper")
    for info in files:
        prefix, sep, rel = info.filename.partition("/")
        if not sep or rel in seen or rel not in expected:
            raise BadZipFile("Unexpected or duplicate evidence member")
        with archive.open(info) as stream:
            digest = hashlib.file_digest(stream, "sha256").hexdigest()
        if digest != expected[rel]:
            raise BadZipFile("Remote evidence differs: " + rel)
        seen[rel] = digest
    assert seen == expected
    assert archive.testzip() is None
size = target.stat().st_size
with target.open("rb") as f:
    checksum = hashlib.file_digest(f, "sha256").hexdigest()
receipt = {"url": link, "branch": entry["branch"], "commit": entry["commits"][-1],
           "files": len(seen), "bytes": size, "sha256": checksum, "access_checked_via": via}
(root / (name + ".remote-check.json")).write_text(json.dumps(receipt, indent=2))
print(name, size, "bytes,", len(seen), "files matched,", via, flush=True)
