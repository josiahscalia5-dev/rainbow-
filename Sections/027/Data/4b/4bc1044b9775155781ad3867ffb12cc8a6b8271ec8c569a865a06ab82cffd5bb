        up.lerp(af.up, w).normalize();\n75\t      }\n76\t    }\n77\t    up.addScaledVector(dir, -up.dot(dir)).normalize();\n78\t    const right = new THREE.Vector3().crossVectors(dir, up).normalize();\n79\t    const benny = f.pos.clone().addScaledVector(f.right, lat);\n80\t    const anchor = benny.clone().addScaledVector(right, -lat * (1 - p.latFollow));\n81\t    // offsets use an 'upright' up: banking only tilts the camera as much as `roll` allows\n82\t    const upPos = new THREE.Vector3(0, 1, 0).lerp(up, Math.max(p.roll, Math.abs(dir.y))).normalize();\n83\t    // position: ON the curved course behind Benny (stays inside bending/pitching tubes, e.g. the\n84\t    // 07 pull-up arc); aim: along his heading so he stays centred in winding streams\n85\t    const fbk = this.course.sample(Math.max(0, s - p.back));\n86\t    const upB = new THREE.Vector3(0, 1, 0).lerp(fbk.up, Math.max(p.roll, Math.abs(fbk.tan.y))).normalize();\n87\t    const straightPos = anchor.clone().addScaledVector(dir, -p.back).addScaledVector(upPos, p.up);\n88\t    const curvedPos = fbk.pos.clone().addScaledVector(fbk.right, lat * p.latFollow).addScaledVector(upB, p.up);\n89\t    // use the curved position where the path bends in pitch (plunge arcs), straight elsewhere\n90\t    const pitchBend = THREE.MathUtils.clamp(Math.abs(fbk.tan.y - f.tan.y) * 6, 0, 1);\n91\t    outPos.copy(straightPos).lerp(curvedPos, Math.max(pitchBend, 0.35));\n92\t    outTarget.copy(anchor).addScaledVector(dir, p.ahead).addScaledVector(upPos, p.lookUp);\n93\t    outUp.set(0, 1, 0).lerp(up, p.roll).normalize();\n94\t    // 03 whirlpool: dynamic high angle from the near side, looking down into the vortex toward the\n95\t    // drain and the porthole wall (Benny left, drain lower-right as in the reference)\n96\t    const st3 = this.course.stage('03');\n97\t    const w3 = THREE.MathUtils.smoothstep(s, st3.s0 - 6, st3.s0 + 2) * (1 - THREE.MathUtils.smoothstep(s, st3.s1 - 6, st3.s1 + 1));\n98\t    if (w3 > 0) {\n99\t      const B =