"""Create and verify one native phone review, preserving each input image and movie."""
import hashlib, json, os, shutil, sys, zipfile
from io import BytesIO
from pathlib import Path
from PIL import Image
import fitz
from reportlab.pdfgen.canvas import Canvas
from reportlab.lib.utils import ImageReader

root=Path(sys.argv[1]);mode=sys.argv[2]
spec=json.loads((root/'source.json').read_text());out=root/'repo'/'experiments'/spec['branch']
downloads=Path('/workspace/shared/downloads');downloads.mkdir(exist_ok=True,parents=True)
prefix='Rainbow06_Arched_Passage' if mode=='scenery' else 'Rainbow06_Benny_Reference_Pink'
def hashfile(p):
    with p.open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
def phonefile(p,name):
    dest=downloads/(prefix+'_'+name)
    if dest.exists():assert hashfile(p)==hashfile(dest),dest
    else:
        try:os.link(p,dest)
        except OSError:shutil.copyfile(p,dest)
    return dest
def page(pdf,source,caption,label):
    with Image.open(source) as im:
        w,h=im.size; W=505; H=W*h/w;pdf.setPageSize((W,H+56))
        pdf.setFillColorRGB(.11,.06,.16);pdf.rect(0,H,W,56,fill=1,stroke=0)
        pdf.setFillColorRGB(1,1,1);pdf.setFont('Helvetica-Bold',14);pdf.drawString(13,H+34,label)
        pdf.setFont('Helvetica',9.2);pdf.drawString(13,H+15,caption)
        reader=ImageReader(str(source))
        if im.format!='JPEG':
            stream=BytesIO();im.convert('RGB').save(stream,'JPEG',quality=92,subsampling=0);stream.seek(0);reader=ImageReader(stream)
        pdf.drawImage(reader,0,0,width=W,height=H);pdf.showPage()
poses=['opening','crest-release','forward-03','hard-left','hard-right','deep','last-in-stage']
parts=['# Screen 06 phone review','',
       '[Open the phone PDF](Review_on_Android.pdf) · [Download the native review ZIP](Screen06_Review.zip)','',
       '[Watch Claudia’s continuous swim](CLAUDIA_BEFORE/ride.mp4) · [Watch the isolated experiment](CODEX_NEW/ride.mp4)','',
       'These are separate full-size pictures. Swipe or scroll from the original to the matching game view.','',
       '## APPROVED','', '![Original Screen 06](APPROVED.jpg)','']
pdf=Canvas(str(out/'Review_on_Android.pdf'),pageCompression=1,invariant=1)
pdf.setTitle('Screen 06 | '+('Bent washer passage' if mode=='scenery' else 'Benny in his original pink coat'))
page(pdf,out/'APPROVED.jpg','Original approved Screen 06. The ZIP preserves its exact bytes.','APPROVED')
page_count=1
for pose in poses:
    view=pose.replace('-',' ').capitalize()
    for folder,label in [('CLAUDIA_BEFORE','CLAUDIA BEFORE'),('CODEX_NEW','CODEX NEW')]:
        fname=folder+'/'+pose+'.png';parts+=['## '+label+' · '+view,'','![Native '+view+' · '+label+']('+fname+')','']
        page(pdf,out/fname,'Native gameplay at the same position, steering, camera and shader time.',label+'   /   '+view)
        page_count+=1
    if pose=='opening' and mode=='character':
        for folder,label in [('APPROVED','APPROVED'),('CLAUDIA_BEFORE','CLAUDIA BEFORE'),('CODEX_NEW','CODEX NEW')]:
            fname='character/'+folder+'.png'
            page(pdf,out/fname,'Native pixel crop from the full-size image. The original character fills this page.',label+'   /   Fur and hat')
            parts+=['## '+label+' · Fur and hat detail','','![Native fur and hat]('+fname+')',''];page_count+=1
other=Path(sys.argv[3]) if len(sys.argv)>3 else None
if other:
    # Each page shows just one native game frame. The two opt-in branches stay independent.
    for pose in ['opening','hard-left','deep','last-in-stage']:
        for folder,label in [('CLAUDIA_BEFORE','CLAUDIA BEFORE'),('CODEX_NEW','SCENERY CANDIDATE')]:
            page(pdf, other/folder/(pose+'.png'),'Separate bent-washer branch. Benny uses his retained appearance.',label+'   /   '+pose.replace('-',' '))
            page_count+=1
pdf.save()
with fitz.open(out/'Review_on_Android.pdf') as document:assert len(document)==page_count
(out/'PHONE_REVIEW.md').write_text('\n'.join(parts)+'\n')
inventory=['README_FIRST.md','REPORT.md','PHONE_REVIEW.md','Review_on_Android.pdf','APPROVED.jpg','CLAUDIA_BEFORE','CODEX_NEW','checks','character']
files=[q for n in inventory if (p:=out/n).exists() for q in ([p] if p.is_file() else sorted(p.rglob('*'))) if q.is_file()]
checks={p.relative_to(out).as_posix():hashfile(p) for p in files}
archive=out/'Screen06_Review.zip'
entries={p.relative_to(out).as_posix():p for p in files}
if other:
    for f in sorted((other/'CODEX_NEW').iterdir()):
        if f.is_file():entries['SCENERY_CODEX_NEW/'+f.name]=f
    for key in ['REPORT.md','checks/source.json','checks/motion.json','checks/opening-regions.json','checks/model-verification.json','checks/fal.json']:
        entries['SCENERY_CODEX_NEW/'+key]=other/key
    checks={name:hashfile(p) for name,p in entries.items()}
with zipfile.ZipFile(archive,'w') as z:
    for name,p in entries.items():
        z.write(p,name,compress_type=zipfile.ZIP_STORED if p.suffix in ['.png','.jpg','.mp4','.pdf'] else zipfile.ZIP_DEFLATED)
    z.writestr('REVIEW_SHA256.json',json.dumps(checks,indent=2)+'\n')
with zipfile.ZipFile(archive) as z:
    assert z.testzip() is None and set(z.namelist())==set(checks)|{'REVIEW_SHA256.json'}
    for p,sha in checks.items():
        with z.open(p) as f:assert hashlib.file_digest(f,'sha256').hexdigest()==sha,p
assert archive.stat().st_size<150_000_000
for p,name in [('APPROVED.jpg','Approved.jpg'),('CLAUDIA_BEFORE/opening.png','Claudia_Before.png'),('CODEX_NEW/opening.png','New.png'),('CLAUDIA_BEFORE/ride.mp4','Claudia_Swim.mp4'),('CODEX_NEW/ride.mp4','New_Swim.mp4'),('Review_on_Android.pdf','Phone_Review.pdf'),('Screen06_Review.zip','Native_Review.zip')]:
    phonefile(out/p,name)
if mode=='character':
    for role,name in [('APPROVED','Approved_Fur.png'),('CLAUDIA_BEFORE','Before_Fur.png'),('CODEX_NEW','New_Fur.png')]:phonefile(out/'character'/(role+'.png'),name)
if other:
    combined=downloads/'Rainbow06_Benny_and_Crest_Review.zip'
    if combined.exists():assert hashfile(combined)==hashfile(archive)
    else:
        try:os.link(downloads/(prefix+'_Native_Review.zip'),combined)
        except OSError:shutil.copyfile(archive,combined)
print(page_count,'verified PDF pages,',len(checks),'verified archived files,',archive.stat().st_size,'bytes')
