"""Push the isolated branch and verify its review files and actual LFS objects."""
import base64
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

root = Path(sys.argv[1])
repo = root / "repo"
branch = json.loads((root / "source.json").read_text())["branch"]
ref = "refs/heads/" + branch
folder = "experiments/" + branch
evidence = repo / folder
spec = json.loads((root / "source.json").read_text())
base, source = spec.get("parent",spec["retained"])["commit"], spec["commit"]
remote_repo = "repos/josiahscalia5-dev/rainbow-"


def git(*arguments, stdin=None, environment=None):
    return subprocess.check_output(["git", "-C", str(repo), *arguments], input=stdin, env=environment)


def gh(path, media=None):
    args = ["gh","api"]
    if media:
        args += ["-H","Accept: "+media]
    return subprocess.check_output([*args, remote_repo + "/" + path])


def sha(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def heads():
    data = git("ls-remote","--heads","origin","refs/heads/ccr-*","refs/heads/claude/*","refs/heads/codex/*")
    return {line.split()[1]:line.split()[0] for line in data.decode().splitlines()}


def pointer_at(commit, path):
    blob = git("rev-parse", commit + ":" + path).decode().strip()
    if int(git("cat-file","-s",blob)) > 1024:
        return None
    pointer = git("cat-file","blob",blob)
    if not pointer.startswith(b"version https://git-lfs.github.com/spec/v1\n"):
        return None
    result = re.fullmatch(rb"version https://git-lfs.github.com/spec/v1\noid sha256:([0-9a-f]{64})\nsize ([0-9]+)\n?", pointer)
    if result is None:
        raise ValueError("Malformed LFS pointer at " + path)
    return result[1].decode(), int(result[2]), pointer


def main():
    manifest = json.loads((evidence / "SHA256.json").read_text())
    files = {p.relative_to(evidence).as_posix() for p in evidence.rglob("*") if p.is_file()}
    assert files == set(manifest) | {"SHA256.json"}
    assert all(sha(evidence / path) == value for path,value in manifest.items())
    assert git("branch","--show-current").decode().strip() == branch
    actual = heads()
    prior = {s.split()[1]:s.split()[0] for s in (root / "remote-before-publish.tsv").read_text().splitlines()}
    assert actual["refs/heads/" + spec["retained"]["branch"]] == spec["retained"]["commit"]
    if "parent" in spec: assert actual["refs/heads/"+spec["parent"]["branch"]] == base
    tip = git("rev-parse","HEAD").decode().strip()
    assert git("rev-parse",tip + "^").decode().strip()==source
    assert git("rev-parse",source+"^").decode().strip()==base
    assert ref not in actual or actual[ref] == tip
    all_changed = git("diff","--name-only",base,tip).decode().splitlines()
    for path in all_changed:
        source_files = set(spec["sourcePaths"])
        assert path.startswith(folder + "/") or path in source_files, path
    lfs_objects = {}
    for commit, parent in ((source,base),(tip,source)):
        for path in git("diff","--name-only",parent,commit).decode().splitlines():
            record = pointer_at(commit, path)
            if record:
                oid, size, pointer = record
                local = repo / path
                assert local.stat().st_size==size and sha(local)==oid,(path,commit)
                if oid not in lfs_objects:
                    lfs_objects[oid] = {"size":size,"path":path,"pointer":pointer}
    print("Validated",len(files),"evidence files and",len(lfs_objects),"unique LFS objects across both new commits.",flush=True)
    git("lfs","push","--object-id","origin",*lfs_objects)
    # Re-download before making the branch visible. A disposable LFS store proves
    # that absent local source-scene/model data can be recovered from the private repo.
    recovered = {}
    with tempfile.TemporaryDirectory(dir=root,prefix="private-screen06-lfs-") as tmp:
        for oid, record in lfs_objects.items():
            h = hashlib.sha256()
            length = 0
            process = subprocess.Popen(["git","-C",str(repo),"-c","lfs.storage="+tmp,
                                        "lfs","smudge","--",record["path"]],stdin=subprocess.PIPE,stdout=subprocess.PIPE)
            process.stdin.write(record["pointer"]); process.stdin.close()
            for block in iter(lambda:process.stdout.read(1024*1024),b""):
                h.update(block); length += len(block)
            assert process.wait()==0 and h.hexdigest()==oid and length==record["size"],record["path"]
            recovered[oid] = {"size":length,"path":record["path"]}
    print("Recovered all new LFS binaries in an independent cache.",flush=True)
    if ref not in actual:
        # All new binary objects were already explicitly uploaded and independently recovered.
        # This shallow checkout has an alternative store for the many inherited art objects.
        git("push","--quiet","origin","HEAD:"+ref,environment={**os.environ,"GIT_LFS_SKIP_PUSH":"1"})
    after = heads()
    assert after[ref]==tip
    independently_changed = [key for key in prior if key.startswith(("refs/heads/ccr-","refs/heads/claude/")) and prior[key] != after.get(key)]
    tree = json.loads(gh("git/commits/"+tip))["tree"]["sha"]
    for part in folder.split("/"):
        entries = json.loads(gh("git/trees/"+tree))["tree"]
        tree = next(row["sha"] for row in entries if row["path"]==part and row["type"]=="tree")
    remote_tree = json.loads(gh("git/trees/"+tree+"?recursive=1"))
    assert not remote_tree["truncated"]
    remote_files = {item["path"]:item["sha"] for item in remote_tree["tree"] if item["type"]=="blob"}
    assert set(remote_files)==files
    for path,remote_blob in remote_files.items():
        assert git("rev-parse",tip+":"+folder+"/"+path).decode().strip()==remote_blob,path
    for path in ("APPROVED.jpg","CLAUDIA_BEFORE/opening.png","CODEX_NEW/opening.png","Review_on_Android.pdf"):
        response = json.loads(gh("git/blobs/"+remote_files[path]))
        raw = base64.b64decode(response["content"])
        assert hashlib.sha256(raw).hexdigest()==manifest[path],path
    gallery = gh("contents/"+folder+"/PHONE_REVIEW.md?ref="+tip,"application/vnd.github.html+json")
    if gallery.lstrip().startswith(b"{"):
        j = json.loads(gallery)
        gallery = base64.b64decode(j["content"]) if j.get("encoding")=="base64" else j.get("content","").encode()
    assert len(re.findall(rb"<img\b",gallery))>=5
    for name in (b"APPROVED.jpg",b"CLAUDIA_BEFORE/opening.png",b"CODEX_NEW/opening.png",b"ride.mp4",b"Screen06_Review.zip"):
        assert name in gallery,name
    receipt = {
        "verifiedUTC":datetime.now(timezone.utc).isoformat(),"branch":branch,"tip":tip,"gameSource":source,"parent":base,"protectedBase":spec["retained"]["commit"],
        "verifiedFiles":len(files),"lfsBytesRecovered":sum(x["size"] for x in recovered.values()),"lfs":recovered,
        "githubRenderedInlineImages":len(re.findall(rb"<img\b",gallery)),
        "byteVerifiedPrivateDownloads":["APPROVED.jpg","CLAUDIA_BEFORE/opening.png","CODEX_NEW/opening.png","Review_on_Android.pdf"],
        "protectedTipDifferencesObserved":independently_changed,
    }
    (root/"published.json").write_text(json.dumps(receipt,indent=2)+"\n")
    print("Verified",tip,"on GitHub;",len(files),"evidence files;",receipt["githubRenderedInlineImages"],"inline native images.",flush=True)


if __name__=="__main__":
    main()
