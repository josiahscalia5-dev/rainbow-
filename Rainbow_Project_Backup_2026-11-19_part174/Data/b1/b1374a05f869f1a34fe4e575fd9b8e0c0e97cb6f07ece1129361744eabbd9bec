ing"}, "new_description": {"description": "Replace the environment's description with this (plain single-line text; an empty string clears it).", "maxLength": 1024, "type": "string"}, "new_name": {"description": "Rename the environment to this (plain single-line text, the same rules as create_environment's `name`: it must not match or look like an environment the user can already see). environment_name must still carry the current name.", "maxLength": 64, "minLength": 1, "type": "string"}, "reason": {"description": "One short plain sentence, on one line: what you need and why, in under about 100 characters, e.g. \"Allow example.com so I can download the page you asked for.\" No error codes, command names or full URLs (a host name is fine). The approval prompt shows the exact change but not this, so say the same in your message before you call.", "type": "string"}, "remove_allowed_hosts": {"description": "Entries to remove from the environment's network allowlist, spelled as get_environment lists them. This only narrows access. Every entry must be on the list exactly as get_environment shows it; if one is not, the call fails and nothing is changed.", "items": {"type": "string"}, "type": "array"}, "script_change": {"description": "Required with setup_script: whether this adds a setup script to an environment that has none, replaces the existing one, or removes it. To remove the script, send it in setup_script exactly as get_environment returned it, so the person approving sees what goes away; a script this tool cannot send is removed in Settings. Remove a script only when the user asks, or to undo one you added in this session. Shown to the person approving; the server checks it and rejects the call if it is wrong.", "enum": ["adds a setup script", "replaces the existing setup script", "removes the setup script"], "type": "string"}, "set_environment_variables": {"additionalProperties": {"type": "string"}, "description": "Environment variables to set (name → value). No