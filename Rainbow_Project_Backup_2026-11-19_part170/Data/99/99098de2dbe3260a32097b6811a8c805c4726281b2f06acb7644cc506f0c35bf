er; outerR: number;\n56\t  hideOld: (names: string[]) => void;\n57\t}\n58\t\n59\tconst VERT = /* glsl */ `\n60\tuniform mat4 uProjVP;\n61\tattribute vec2 aK;\n62\tvarying vec4 vProj;\n63\tvarying vec3 vW;\n64\tvarying vec3 vN;\n65\tvarying vec2 vK;\n66\tvoid main() {\n67\t  vec4 wp = modelMatrix * vec4(position, 1.0);\n68\t  vProj = uProjVP * wp;\n69\t  vW = wp.xyz;\n70\t  vK = aK;\n71\t  vN = normalize(mat3(modelMatrix) * normal);\n72\t  gl_Position = projectionMatrix * viewMatrix * wp;\n73\t}`;\n74\t\n75\t// polished gold, art-directed in DISPLAY colours measured on the approved picture (then pjInverse like the plate):\n76\t// groove (110,35,5) / shadow band (168,70,18) / mid (205,97,28) / lit (245,143,38) / hot lip (255,204,77) / glint.\n77\t// Each ring = a broad polished band that brightens toward its lip, a bright rounded lip with hot spots, a thin dark groove;\n78\t// the far rings warm toward the glowing vanishing point; violet / pink water reflections on the lower walls.\n79\tconst GOLD_FRAG = /* glsl */ `\n80\tuniform sampler2D uPlate;\n81\tuniform vec4 uPjPost;\n82\tuniform vec2 uPjRes;\n83\tuniform float uAway;\n84\tuniform vec3 uAxO;\n85\tuniform vec3 uAxD;\n86\tuniform vec3 uAxU;\n87\tuniform vec3 uAxR;\n88\tuniform float uNB;\n89\tuniform float uP;\n90\tuniform float uLipBulb;\n91\tuniform float uBulbR;\n92\tuniform float uLen;\n93\tuniform vec4 uTone;        // band base, lip base, opening base, streak strength\n94\tuniform sampler2D uRingTile; // tile_ring.png: the painted ring colour at every angle (rows 56..176 = band near edge .. lip)\n95\tuniform float uPaint;      // how much of the painted ring colour drives the bands (m04paint)\n96\tuniform float uBulge;      // r13 m04bulge: each band shaded as a ROUNDED tube (bright middle, darker edges) like the painted rings\n97\tuniform float uCopper;     // r13 m04copper: rich polished COPPER-gold ramp (dark maroon grooves -> copper -> warm-gold highlights)\n98\tuniform float uGoldY;      // m04gold: polished YELLOW-gold ramp (bright yellow-white highlights), fewer magenta tints\n99\tuniform float uMouthT;     // m04mouth: the painted mouth ring texture on the opening (tile_mouth.png)\n100\tuniform sampler2D uMouthTex;\n101\tuniform vec3 uMouthRho;    // tile rows: rho at the top row, rho at the bottom row (fitted mouth plane z0); z: rho offset\n102\t                           // (the painted band lies 0.1 u inside the fitted outer radius: lips onto the modeled lips)\n103\tuniform vec3 uProjPos;\n104\tvarying vec4 vProj;\n105\tvarying vec3 vW;\n106\tvarying vec3 vN;\n107\tvarying vec2 vK;            // x: part (0 band, 1 lip, 2 groove, 3 opening face, 4 end glow), y: ring index (-1 = opening)\n108\t${PROJ05_INVERSE}\n109\tfloat h21(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }\n110\tvec3 goldRamp(float x) {\n111\t  x = clamp(x, 0.0, 1.0) * 5.0;\n112\t  vec3 c0 = vec3(0.43, 0.14, 0.02), c1 = vec3(0.66, 0.27, 0.07), c2 = vec3(0.80, 0.38, 0.11);\n113\t  vec3 c3 = vec3(0.96, 0.56, 0.15), c4 = vec3(1.0, 0.80, 0.30), c5 = vec3(1.0, 0.96, 0.80);\n114\t  if (x < 1.0) return mix(c0, c1, x);\n115\t  if (x < 2.0) return mix(c1, c2, x - 1.0);\n116\t  if (x < 3.0) return mix(c2, c3, x - 2.0);\n117\t  if (x < 4.0) return mix(c3, c4, x - 3.0);\n118\t  return mix(c4, c5, x - 4.0);\n119\t}\n120\tvec3 goldRampC(float x) {\n121\t  x = clamp(x, 0.0, 1.0) * 5.0;\n122\t  vec3 c0 = vec3(0.17, 0.04, 0.03), c1 = vec3(0.42, 0.13, 0.06), c2 = vec3(0.66, 0.29, 0.12);\n123\t  vec3 c3 = vec3(0.86, 0.50, 0.22), c4 = vec3(0.98, 0.76, 0.44), c5 = vec3(1.0, 0.95, 0.86);\n124\t  if (x < 1.0) return mix(c0, c1, x);\n125\t  if (x < 2.0) return mix(c1, c2, x - 1.0);\n126\t  if (x < 3.0) return mix(c2, c3, x - 2.0);\n127\t  if (x < 4.0) return mix(c3, c4, x - 3.0);\n128\t  return mix(c4, c5, x - 4.0);\n129\t}\n130\tvec3 goldRampY(float x) {\n131\t  x = clamp(x, 0.0, 1.0) * 5.0;\n132\t  vec3 c0 = vec3(0.52, 0.22, 0.03), c1 = vec3(0.76, 0.40, 0.07), c2 = vec3(0.89, 0.55, 0.12);\n133\t  vec3 c3 = vec3(0.98, 0.72, 0.20), c4 = vec3(1.0, 0.87, 0.42), c5 = vec3(1.0, 0.98, 0.86);\n134\t  if (x < 1.0) return mix(c0, c1, x);\n135\t  if (x < 2.0) return mix(c1, c2, x - 1.0);\n136\t  if (x < 3.0) return mix(c2, c3, x - 2.0);\n137\t  if (x < 4.0) return mix(c3, c4, x - 3.0);\n138\t  return mix(c4, c5, x - 4.0);\n139\t}\n140\t// a few long highlight streaks around the ring (painted smears), different on every ring\n141\tfloat streaks(float ang, float ring) {\n142\t  float s = 0.0;\n143\t  for (int i = 0; i < 4; i++) {\n144\t    float fi = float(i);\n145\t    float c = (h21(vec2(ring, fi * 3.1)) * 2.0 - 1.0) * 2.6;\n146\t    float w = 0.12 + 0.30 * h21(vec2(ring, fi * 5.7));\n147\t    float d = ang - c; d = mod(d + 3.14159, 6.28318) - 3.14159;\n148\t    s += (0.45 + 0.55 * h21(vec2(ring, fi * 9.3))) * exp(-d * d / (w * w));\n149\t  }\n150\t  return s;\n151\t}\n152\tvoid main() {\n153\t  vec3 V = normalize(cameraPosition - vW);\n154\t  vec3 n = normalize(vN);\n155\t  if (dot(n, V) < 0.0) n = -n;\n156\t  vec3 q = vW - uAxO;\n157\t  float al = dot(q, uAxD);\n158\t  vec3 qr = q - uAxD * al;\n159\t  float rr = length(qr);\n160\t  float ang = atan(dot(qr, uAxR), dot(qr, uAxU));         // 0 = tunnel top, < 0 = left\n161\t  vec3 R = reflect(-V, n);\n162\t  float part = vK.x;\n163\t  float dc = distance(cameraPosition, vW);\n164\t  float facing = clamp(dot(n, V), 0.0, 1.0);\n165\t  vec3 col;\n166\t  if (part > 3.5) {\n167\t    // the far glow (painted vanishing point): small warm-white core, orange-gold outside with faint far rings\n168\t    // soft warm-white core, yellow-orange glow, orange toward the rim (matches the far bands), no hard target rings\n169\t    float rad = clamp(rr / 3.6, 0.0, 1.0);\n170\t    col = mix(vec3(1.0, 0.95, 0.78), vec3(1.0, 0.72, 0.24), smoothstep(0.04, 0.30, rad));\n171\t    col = mix(col, uGoldY > 0.5 ? vec3(0.98, 0.70, 0.22) : vec3(0.93, 0.52, 0.15), smoothstep(0.30, 0.95, rad));\n172\t    col *= 1.0 - 0.10 * smoothstep(0.25, 0.0, abs(fract(log(max(rad, 0.01)) / log(0.72)) - 0.5)) * smoothstep(0.35, 0.7, rad);\n173\t  } else {\n174\t    bool mouth = vK.y < -0.5;\n175\t    float ring = floor(vK.y + 0.5);             // integer ring index (the interpolated varying is not exact)\n176\t    float v, tb = 0.0;\n177\t    // gloss that moves with the view: the polished metal reflects the bright far end of the tunnel\n178\t    float gl = pow(max(dot(R, uAxD), 0.0), 6.0);\n179\t    if (mouth) {\n180\t      // the washer opening: thick bright polished gold, a long vertical highlight, glowing rounded lips\n181\t      float st = streaks(ang, 77.0);\n182\t      v = uTone.z + 0.08 * cos(ang) + 0.20 * st + 0.08 * gl;\n183\t      if (part > 0.5 && part < 1.5) v = uTone.z + 0.14 + 0.16 * facing + 0.10 * st;\n184\t      if (part > 1.5 && part < 2.5) v = 0.18;\n185\t    } else {\n186\t      float u = fract(al / uP) * uP;                       // world units inside this ring period (0 = groove step)\n187\t      float t = clamp((u - 0.06) / (uP - 0.6), 0.0, 1.0);  // band: 0 at its near edge .. 1 at its lip\n188\t      float far = smoothstep(10.0, 38.0, dc);\n189\t      float st = streaks(ang, ring);\n190\t      tb = t;\n191\t      float bump = smoothstep(0.0, 0.45, t) * (1.0 - 0.5 * smoothstep(0.7, 1.0, t));\n192\t      v = uTone.x + 0.20 * pow(t, 1.5) + 0.03 * cos(ang) + 0.04 * far + uTone.w * st * bump + 0.05 * gl;\n193\t      v += uBulge * (sin(3.14159 * t) - 0.35);\n194\t      if (part > 0.5 && part < 1.5) v = uTone.y + 0.12 * facing + 0.04 * far + 0.15 * st;\n195\t      if (part > 1.5 && part < 2.5) v = 0.03 + 0.05 * far;\n196\t    }\n197\t    col = uCopper > 0.5 ? goldRampC(v * uCopper) : (uGoldY > 0.5 ? goldRampY(v) : goldRamp(v));\n198\t    if (!mouth && part < 1.5) {\n199\t      // the painted ring colour at this angle (pinks, violets, yellow streaks of the approved rings), with the crisp\n200\t      // structure's brightness: painted palette + modeled lip / groove / highlight shapes\n201\t      float row = part > 0.5 ? 0.92 : mix(0.30, 0.90, tb);\n202\t      vec3 pc = texture2D(uRingTile, vec2(0.5 - ang / 6.2831853, row)).rgb;\n203\t      // painted variation only (this angle's colour minus the painted row average): the pink / violet / yellow streaks\n204\t      // ride on the measured gold ramp, so dark gold stays deep orange (scaling a yellow down would turn it olive)\n205\t      vec3 rm = mix(vec3(0.73, 0.33, 0.11), vec3(0.83, 0.42, 0.18), smoothstep(0.30, 0.45, row));\n206\t      rm = mix(rm, vec3(0.87, 0.49, 0.19), smoothstep(0.45, 0.60, row));\n207\t      rm = mix(rm, vec3(0.89, 0.59, 0.26), smoothstep(0.60, 0.75, row));\n208\t      rm = mix(rm, vec3(0.92, 0.76, 0.38), smoothstep(0.75, 0.92, row));\n209\t      col = clamp(col + uPaint * (pc - rm), 0.0, 1.0);\n210\t    }\n211\t    // violet (left) / pink (right) reflections of the swirl water on the lower walls, painterly variation above\n212\t    float low = smoothstep(1.25, 2.15, abs(ang));\n213\t    vec3 wc = ang < 0.0 ? vec3(0.62, 0.42, 0.86) : vec3(0.95, 0.42, 0.70);\n214\t    float ry = mouth ? 99.0 : ring, fa = ang * 2.2 + ry * 1.7;\n215\t    float hv = mix(h21(vec2(floor(fa), ry)), h21(vec2(floor(fa) + 1.0, ry)), smoothstep(0.0, 1.0, fract(fa)));\n216\t    float pk = (0.42 * low + 0.22 * smoothstep(0.78, 0.98, hv) * (1.0 - low)) * (part > 0.5 && part < 1.5 ? 0.35 : 1.0);\n217\t    vec3 wc2 = mix(wc, vec3(0.88, 0.42, 0.78), 1.0 - low);   // dusky violet-pink tint on the upper walls\n218\t    col = mix(col, wc2 * (0.55 + 0.6 * v), pk * (mouth ? 0.6 : 1.0) * (1.0 - 0.55 * uGoldY));\n219\t    // a few cool blue-violet glints on the bands (painted reflections of the cyan water)\n220\t    if (!mouth && part < 0.5) {\n221\t      float cb = streaks(ang + 1.3, ring + 31.0);\n222\t      col = mix(col, vec3(0.62, 0.66, 1.0), 0.55 * smoothstep(0.7, 1.0, cb) * step(0.55, h21(vec2(ring, 4.4))) * smoothstep(0.1, 0.5, tb));\n223\t    }\n224\t    // hot spots / amber bulbs: a row on the opening's face, smaller glints on every ring lip\n225\t    bool onFace = part > 2.5 && part < 3.5;\n226\t    bool onLip = uLipBulb > 0.5 && part > 0.5 && part < 1.5 && !mouth;\n227\t    if (onFace || onLip) {\n228\t      float nb = onFace ? uNB : floor(uNB * 0.6);\n229\t      float cell = fract(ang / 6.2831853 * nb + 0.5 * mod(max(ring, 0.0), 2.0)) - 0.5;\n230\t      float arc = cell * 6.2831853 * rr / nb;               // world units along the ring\n231\t      float rad = onFace ? abs(rr - uBulbR) : 0.0;\n232\t      float d = length(vec2(arc, rad));\n233\t      float bs = onFace ? 0.075 : 0.05;\n234\t      float on = onFace ? 1.0 : step(0.35, h21(vec2(floor(ang / 6.2831853 * nb + 0.5), ring)));\n235\t      on *= 1.0 - smoothstep(0.4, 1.0, fwidth(arc) / bs);\n236\t      col += vec3(1.0, 0.55, 0.12) * 0.55 * smoothstep(bs * 3.5, 0.0, d) * on;\n237\t      col = mix(col, vec3(1.0, 0.95, 0.75), smoothstep(bs, bs * 0.35, d) * on);\n238\t    }\n239\t    // star glints scattered on the polished gold (painted white sparkles), sparse\n240\t    vec2 gc = vec2(ang / 6.2831853 * 30.0, al * 1.1);\n241\t    vec2 gi = floor(gc), gf = fract(gc) - 0.5;\n242\t    float gh = h21(gi + ring * 7.0);\n243\t    float gfw = max(fwidth(gc.x), fwidth(gc.y));\n244\t    if (gh > 0.93 && gfw < 0.35) {\n245\t      vec2 o = (vec2(h21(gi + 1.3), h21(gi + 2.7)) - 0.5) * 0.6;\n246\t      vec2 p = (gf - o) * vec2(1.0, 0.7);\n247\t      float g = smoothstep(0.08, 0.0, length(p)) + 0.4 * smoothstep(0.02, 0.0, abs(p.x)) * smoothstep(0.28, 0.0, abs(p.y)) + 0.4 * smoothstep(0.02, 0.0, abs(p.y)) * smoothstep(0.28, 0.0, abs(p.x));\n248\t      col += vec3(1.0, 0.92, 0.70) * g * 0.6 * (1.0 - smoothstep(0.15, 0.35, gfw));\n249\t    }\n250\t    if (mouth && uMouthT > 0.5) {\n251\t      // m04mouth: the painted washer opening. The fragment is carried along the projector ray onto the fitted mouth plane\n252\t      // (homothety about the projector), so the approach continues the approved view; (psi, rho) there index the\n253\t      // straig