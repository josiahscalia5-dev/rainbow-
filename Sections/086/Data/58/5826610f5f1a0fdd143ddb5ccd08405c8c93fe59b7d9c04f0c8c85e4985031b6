const path=require('node:path'),fs=require('node:fs'),{pathToFileURL}=require('node:url');
const root=__dirname,deps=process.env.RAINBOW_DEPS;
async function main(){
 const {createServer}=await import(pathToFileURL(path.join(deps,'node_modules/vite/dist/node/index.js')).href);
 const servers=[];
 for(const id of ['07']){
  const game=path.join(root,'alternatives',id), port=5900+Number(id);
  const server=await createServer({root:game,cacheDir:path.join(root,'vite-alt',id),logLevel:'error',server:{host:'127.0.0.1',port,strictPort:true,hmr:false,watch:{ignored:['**/*']},fs:{allow:[game,deps,path.join(root,'vite')]}}});
  await server.listen();servers.push(server);
 }
 fs.writeFileSync(path.join(root,'serve-07.pid'),String(process.pid));console.log('One masked paddle serving only on loopback');
 for(const signal of ['SIGTERM','SIGINT'])process.on(signal,async()=>{await Promise.all(servers.map(s=>s.close()));process.exit(0);});
}
main().catch(e=>{console.error(e.message);process.exitCode=1});
