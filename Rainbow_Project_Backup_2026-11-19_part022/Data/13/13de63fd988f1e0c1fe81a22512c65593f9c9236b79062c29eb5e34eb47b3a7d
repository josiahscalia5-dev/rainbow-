ackage_managers": {"description": "With limited network access: whether common package registries (npm, PyPI, crates.io, Go proxy, apt mirrors, ...) are reachable without listing them. Omit to keep the current value.", "type": "boolean"}, "applies_to": {"description": "The exact `applies_to` returned by get_environment: whose future sessions this edit changes. Shown to the person approving; the call is rejected if it does not match the environment.", "enum": ["my personal environment: all of my future sessions that use it, not only this one", "an organization-wide environment: future sessions of everyone in the organization who uses it, not only mine"], "type": "string"}, "environment_name": {"description": "The exact current `name` returned by get_environment. Shown to the person approving so they know which environment changes; the call is rejected if it does not match.", "type": "string"}, "network_access": {"description": "Change the network access level. \"limited\": only package registries / MCP server hosts (per the two allow_* toggles) and the allowed-hosts list are reachable — switching to it from unrestricted starts from the hosts in add_allowed_hosts with both toggles on unless given. \"unrestricted\": any public host is reachable and the stored allowed-hosts list is discarded. Omit to keep the current level; prefer adding exact hosts over unrestricted.", "enum": ["limited", "unrestricted"], "type": "string"}, "new_description": {"description": "Replace the environment's description with this (plain single-line text; an empty string clears it).", "maxLength": 1024, "type": "string"}, "new_name": {"description": "Rename the environment to this (plain single-line text, the same rules as create_environment's `name`: it must not match or look like an environment the user can already see). environment_name must still carry the current name.", "maxLength": 64, "minLength": 1, "type": "string"}, "reason": {"description": "One short plain sentence, on one line: what you need and why, in under about 100 characters, e.g. \"Allow example.com so I can download the page you asked for.\" No error codes, command names or full URLs (a host name is fine). The approval prompt shows the exact change but not this, so say the same in your message before you call.", "type": "string"}, "remove_allowed_hosts": {"description": "Entries to remove from the environment's network allowlist, spelled as get_environment lists them. This only narrows access. Every entry must be on the list exactly as get_environment shows it; if one is not, the call fails and nothing is changed.", "items": {"type": "string"}, "type": "array"}, "script_change": {"description": "Required with setup_script: whether this adds a setup script to an environment that has none, replaces the existing one, or removes it. To remove the script, send it in setup_script exactly as get_environment returned it, so the person approving sees what goes away; a script this tool cannot send is removed in Settings. Remove a script only when the user asks, or to undo one you added in this session. Shown to the person approving; the server checks it and rejects the call if it is wrong.", "enum": ["adds a setup script", "replaces the existing setup script", "removes the setup script"], "type": "string"}, "set_environment_variables": {"additionalProperties": {"type": "string"}, "description": "Environment variables to set (name → value). Non-secret configuration only; existing variables with the same name are overwritten.", "type": "object"}, "setup_script": {"description": "Full replacement for the environment's setup script: a bash script run as root each time a session's container is built fresh, after the session's repositories are cloned and before Claude starts, whatever repositories the session has — never in this running container; on an organization environment, it runs in every member's sessions on it. Send the whole script, not a fragment: to change an existing script, start from 