from pathlib import Path
import hashlib,json,subprocess,sys
v=Path.cwd()
for sid in sys.argv[1:]:
    root=v/'repos'/sid
    verified=json.load(open(v/('final-push-'+sid+'.json')))
    gst=['git','-C',str(root)]
    store=v/'verified-downloads'/sid
    store.mkdir(parents=True,exist_ok=True)
    base='experiments/codex/'+sid
    cert=[]
    for path in sorted((root/base).rglob('*')):
        if path.suffix not in ['.mp4','.glb','.blend']:continue
        rel=path.relative_to(root).as_posix()
        ptr=subprocess.check_output(gst+['show',verified['commit']+':'+rel])
        assert ptr.startswith(b'version https://git-lfs.github.com/spec/v1')
        expected=ptr.decode().split('oid sha256:')[1].split()[0]
        # Use an empty per-screen LFS store the first time. Capture errors privately.
        data=subprocess.run(gst+['-c','lfs.storage='+str(store),'lfs','smudge','--',rel],input=ptr,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
        if data.returncode: raise RuntimeError('Media retrieval failed for '+rel)
        assert hashlib.sha256(data.stdout).hexdigest()==expected==hashlib.sha256(path.read_bytes()).hexdigest(),rel
        cert.append({'file':rel,'bytes':len(data.stdout),'sha256':expected})
    (v/('lfs-checked-'+sid+'.json')).write_text(json.dumps(cert,indent=2)+'\n')
    print(sid,'remote media matched',len(cert),flush=True)
