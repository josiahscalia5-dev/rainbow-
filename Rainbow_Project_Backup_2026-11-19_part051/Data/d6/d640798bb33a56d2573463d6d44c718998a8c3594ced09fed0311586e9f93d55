from pathlib import Path
import subprocess as sp, hashlib, re, shutil, os, json
base=Path.cwd()
src=base/'jdk-source'
def digest(path):
 with path.open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
def run(args, **kwargs):
 return sp.run(args,check=True,**kwargs)
keyring='/usr/share/keyrings/debian-archive-keyring.gpg'
verified=src/'verified-release'
with (src/'verified-signature.log').open('w') as log:
 run(['sqv','--keyring',keyring,'--cleartext',str(src/'InRelease'),'--output',str(verified)],stderr=log)
sha_block=verified.read_text().split('SHA256:\n',1)[1].split('\n\n',1)[0]
index=src/'Packages.xz'
assert any(l.split()==[digest(index),str(index.stat().st_size),'main/binary-amd64/Packages.xz'] for l in sha_block.splitlines())
import lzma
control=next(rec for rec in lzma.open(index,'rt').read().split('\n\n') if rec.startswith('Package: openjdk-21-jdk-headless\n'))
fields=dict(line.split(': ',1) for line in control.splitlines() if ': ' in line and not line.startswith(' '))
sysversion=sp.check_output(['dpkg-query','-W','-f=\u0024{Version}','openjdk-21-jre-headless'],text=True).strip()
assert sysversion==fields['Version'] and fields['Architecture']=='amd64'
filename=fields['Filename']
assert filename.startswith('pool/updates/main/o/openjdk-21/') and '..' not in filename
url='https://deb.debian.org/debian-security/'+filename
deb=src/Path(filename).name
run(['curl','--fail','--silent','--show-error','--location','--retry','2','--max-time','180','-o',str(deb),url])
assert digest(deb)==fields['SHA256'] and deb.stat().st_size==int(fields['Size'])
unpack=src/'unpacked'
run(['dpkg-deb','-x',str(deb),str(unpack)])
jvmdir='java-21-openjdk-amd64'
jdk=base/'isolated-jdk21'
run(['cp','-a','/usr/lib/jvm/'+jvmdir,str(jdk)])
local=unpack/'usr/lib/jvm'/jvmdir
run(['cp','-a',str(local)+'/.',str(jdk)])
jdkver=sp.check_output([str(jdk/'bin/jlink'),'--version'],text=True).strip()
javac=sp.check_output([str(jdk/'bin/javac'),'-version'],text=True).strip()
assert '21.0.13' in jdkver and '21.0.13' in javac
(base/'jdk-verified.json').write_text(json.dumps({'package':fields['Package'],'version':sysversion,'sha256':fields['SHA256'],'repository':'https://deb.debian.org/debian-security','signature':'Debian archive keyring via sqv','jlink':jdkver,'javac':javac},indent=2))
env=dict(os.environ,JAVA_HOME=str(jdk),PATH=str(jdk/'bin')+os.pathsep+os.environ['PATH'])
run(['python','verified_gradle.py'],cwd=base,env=env)
