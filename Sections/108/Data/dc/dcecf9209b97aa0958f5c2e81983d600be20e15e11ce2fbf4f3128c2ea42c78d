 * 0.8, on);\n}\n#endif`,\n      );\n  };\n  mat.customProgramCacheKey = () => 'perf-v4' + (relief ? '-r' : '') + (o.farGlow ? '-g' : '') + (o.farGlow && o.virtualDepth ? '-v' : '') + (river && o.farGlow && o.virtualDepth ? '-w' : '');\n  return mat;\n}\n\n/**\n * Reflection environment for the washer tubes (05–07): an HDR cube of hot-pink / magenta / violet with\n * pink-white strip lights around the tube and a warm gold-white glow down the tunnel (-Z), so the glossy\n * walls read rich saturated magenta (the shared candy studio has a cyan panel that turned them sky-blue).\n * Built from half-float DataTextures; three converts it to PMREM on first use (no renderer needed here).\n */\nconst tubeEnvs: Partial<Record<'wall' | 'gold', THREE.CubeTexture>> = {};\n/** variant 'gold': same tunnel lighting seen by polished gold (warm-white strips, amber base) so rings and\n *  lids read clean orange-gold with yellow-white highlights instead of salmon (gold × magenta). */", "is_error": false, "tool_use_id": "toolu_0172GDfevFF43erYgHDWy74C", "type": "tool_result"}], "role": "user"}, "parentUuid": "eb89be7a-b88a-47f9-b3f7-c78f5ec0ae35", "permissionDecision": {"decision": "accept", "reasonType": "rule", "ruleSource": "cliArg", "source": "config"}, "promptId": "b754c676-bd1a-4e1f-b0b3-94494ab5c645", "sandboxed": false, "sessionId": "025fdfec-0536-5765-8355-e6c259e1aa5d", "sourceToolAssistantUUID": "eb89be7a-b88a-47f9-b3f7-c78f5ec0ae35", "timestamp": "2026-11-15T21:57:01.008Z", "type": "user", "userType": "external", "uuid": "79ecff3a-6e7f-4a54-b5a4-b2f94add01e7", "version": "2.1.325"}
