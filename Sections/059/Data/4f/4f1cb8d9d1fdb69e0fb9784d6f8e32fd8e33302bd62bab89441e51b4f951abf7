from pathlib import Path
import sys, subprocess, os, time
root=Path(__file__).parent
sid=sys.argv[1]; modes=sys.argv[2:] or ['stills','ride','full-safe','repeat']
env=dict(os.environ,NODE_PATH='/opt/codex/cua_node/lib/node_modules',RAINBOW_BASE_URL='http://127.0.0.1:'+str(7960+int(sid)))
for mode in modes:
    variant='BEFORE' if mode=='repeat' else 'NEW'
    for attempt in range(2):
        res=subprocess.run(['node','capture.cjs',mode,sid+':'+variant],cwd=root,env=env,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True)
        with (root/('qa-'+sid+'.log')).open('a') as log:log.write(mode+' '+str(res.returncode)+' '+res.stdout[-1900:]+'\n')
        if not res.returncode:break
        time.sleep(2)
    if res.returncode:sys.exit(res.returncode)
