 + j, b = a + 1, c = a + vertsPerRow, d = c + 1;\n842\t      idx.push(a, c, b, b, c, d);\n843\t    }\n844\t  }\n845\t  const geo = new THREE.BufferGeometry();\n846\t  geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));\n847\t  geo.setAttribute('normal', new THREE.BufferAttribute(nor, 3));\n848\t  geo.setAttribute('aUV', new THREE.BufferAttribute(uv, 2));\n849\t  geo.setAttribute('aHalfW', new THREE.BufferAttribute(halfW, 1));\n850\t  geo.setAttribute('aSpeed', new THREE.BufferAttribute(speed, 1));\n851\t  geo.setAttribute('aAmp', new THREE.BufferAttribute(amp, 1));\n852\t  geo.setAttribute('aSkirt', new THREE.BufferAttribute(skirt, 1));\n853\t  geo.setAttribute('aStyle', new THREE.BufferAttribute(style, 4));\n854\t  geo.setAttribute('aCore', new THREE.BufferAttribute(core, 1));\n855\t  geo.setAttribute('aTan', new THREE.BufferAttribute(tang, 3));\n856\t  geo.setIndex(idx);\n857\t  geo.computeBoundingSphere();\n858\t\n859\t  const st03 = course.stage('03'), st04 = course.stage('04'), st08 = course.stage('08');\n860\t  const uniforms = withFog({\n861\t    uTime: { value: 0 },\n862\t    uCyanDeep: { value: RIBBON_PAL.cyanDeep.clone() },\n863\t    uCyan: { value: RIBBON_PAL.cyan.clone() },\n864\t    uCyanBright: { value: RIBBON_PAL.cyanBright.clone() },\n865\t    uPinkDeep: { value: RIBBON_PAL.pinkDeep.clone() },\n866\t    uPink: { value: RIBBON_PAL.pink.clone() },\n867\t    uPinkLight: { value: RIBBON_PAL.pinkLight.clone() },\n868\t    uFoam: { value: PALETTE.foam.clone() },\n869\t    uFoamLav: { value: PALETTE.foamLav.clone() },\n870\t    uHaze: { value: PALETTE.haze.clone() },\n871\t    uLightDir: { value: new THREE.Vector3(0.3, 1.0, 0.45).normalize() },\n872\t    uBenny: { value: new THREE.Vector3(0, 0, 0) },\n873\t    uBennyR: { value: 0.7 },\n874\t    uChevron: { value: new THREE.Vector3(st04.s0 + 8.5, 3.6, 1) },\n875\t    uOutro: { value: new THREE.Vector2(0, st08.s0) },\n876\t    uHide: { value: new THREE.Vector4(st03.s0, st04.s0, 0, 0) },\n877\t   