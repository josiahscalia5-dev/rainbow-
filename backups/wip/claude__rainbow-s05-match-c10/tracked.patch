+/**
+ * `&m05unf=1` (waterRibbon.ts M05UNF): the same unfolding as unfoldDelta05 for ANY point at (s, lateral) of the 05 river
+ * frame (lateral fixed, |lateral| ≥ half width → full width): horizontal displacement (x, z) of the point that removes
+ * the crossing rows at the kink. Used for the lather bank's vertices and the rim foam (the ribbon uses unfoldDelta05 on
+ * its own rows, which gives the same result at its row spacing).
+ */
+let tightTab: { s0: number; ds: number; sig: Float32Array } | null = null;
+function tightInit(course: Course) {
+  if (tightTab) return tightTab;
+  const st = course.stage('05');
+  const s0 = st.s0 - 6, s1 = st.s1 + 8, ds = 0.2;
+  const n = Math.ceil((s1 - s0) / ds) + 1;
+  const tight = new Float32Array(n);
+  for (let i = 0; i < n; i++) {
+    const s = s0 + i * ds;
+    if (s < st.s0 - 2 || s > st.s1 + 4) continue;
+    const a = course.sample(Math.max(0, s - 0.4)), b = course.sample(s + 0.4);
+    const t = (course.widthAt(s) / 2) * (Math.acos(Math.min(1, a.tan.dot(b.tan))) / 0.8);
+    const x = Math.min(1, Math.max(0, (t - 0.45) / (0.8 - 0.45)));
+    tight[i] = x * x * (3 - 2 * x);
+  }
+  const K4 = Math.ceil(4 / ds), sig = new Float32Array(n);
+  for (let i = 0; i < n; i++) {
+    let m = 0;
+    for (let k = -K4; k <= K4; k++) { const j = i + k; if (j >= 0 && j < n) m = Math.max(m, tight[j] * (1 - Math.abs(k) / (K4 + 1))); }
+    sig[i] = SIG * m;
+  }
+  tightTab = { s0, ds, sig };
+  return tightTab;
+}
+export function unfoldAt05(course: Course, s: number, lat: number, out: { x: number; z: number }): { x: number; z: number } {
+  out.x = 0; out.z = 0;
+  const t = tightInit(course);
+  const i = Math.round((s - t.s0) / t.ds);
+  if (i < 0 || i >= t.sig.length) return out;
+  const hw = course.widthAt(s) / 2;
+  const l = Math.min(1, Math.abs(lat) / Math.max(1e-3, hw));
+  const sg = t.sig[i] * l * l * l;
+  if (sg < 0.02) return out;
+  const p0 = course.sample(s); const x0 = p0.pos.x + p0.right.x * lat, z0 = p0.pos.z + p0.right.z * lat;
+  const step = Math.min(0.2, sg / 3);
+  const K = Math.ceil((3 * sg) / step);
+  let ax = 0, az = 0, w = 0;
+  for (let k = -K; k <= K; k++) {
+    const ss = s + k * step;
+    const f = course.sample(ss);
+    const hwk = course.widthAt(ss) / 2;
+    const lk = Math.sign(lat) * Math.max(Math.abs(lat), 0) * (hwk / Math.max(1e-3, hw));   // same place across the river
+    const ww = Math.exp(-0.5 * ((k * step) / sg) ** 2);
+    ax += (f.pos.x + f.right.x * lk) * ww; az += (f.pos.z + f.right.z * lk) * ww; w += ww;
+  }
+  out.x = ax / w - x0; out.z = az / w - z0;
+  return out;
+}
