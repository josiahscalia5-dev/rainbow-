const fs = require('node:fs');
const path = require('node:path');
const { chromium } = require('playwright');
const root = __dirname;
const query = require('./queries.json')['07'];
const out = path.join(root, 'paddle-test');
const states = [['opening',0,0], ['early',3,0], ['angled-left',7,-1], ['forward',10,0], ['hard-left',12,-1], ['hard-right',12,1], ['plunge',41,0]];
async function draw(page,mode,name) {
 const res=await page.evaluate(mode=>{
   const r=window.__rainbow, v=window.__paddleDiagnostic;
   v.two.material=mode==='candidate'?v.candidate:v.original;
   v.two.visible=mode!=='hide-two';
   for(const o of v.far)o.visible=mode!=='hide-far';
   return r.drawList().filter(([name])=>name.includes('m07_paddle'));
 },mode);
 await page.waitForTimeout(160);
 await page.screenshot({path:path.join(out,name+'-'+mode+'.png'),animations:'disabled'});
 return res;
}
async function main(){
 fs.mkdirSync(out,{recursive:true});
 const browser=await chromium.launch({executablePath:'/usr/bin/chromium',args:['--use-angle=swiftshader','--enable-unsafe-swiftshader','--ignore-gpu-blocklist','--disable-background-networking']});
 try {
 const page=await browser.newPage({viewport:{width:864,height:1536},deviceScaleFactor:1});
 await page.route('**/*',r=>['','127.0.0.1','localhost'].includes(new URL(r.request().url()).hostname)?r.continue():r.abort());
 await page.goto('http://127.0.0.1:5607/?qa=1&dpr=1&'+query,{timeout:150000});
 await page.waitForFunction(()=>window.__rainbow?.ready,null,{timeout:180000});
 await page.evaluate(()=>document.fonts.ready);
 const setup=await page.evaluate(()=>{
   const r=window.__rainbow;r.run(false);r.goto('07');r.drawList();
   const d=r.qa3d(), two=d.scene.getObjectByName('m07_paddle2'), far=[3,4].map(i=>d.scene.getObjectByName('m07_paddle'+i));
   const orig=two.material;const clone=orig.clone();
   // Keep Claudia's texture objects and camera/depth uniforms. Only the angular transition on this single paddle is under test.
   clone.uniforms=orig.uniforms;
   const token='smoothstep(0.970, 0.995, dot(normalize(cameraPosition - vW), normalize(uProjPos - vW)))';
   if(orig.fragmentShader.split(token).length!==2)throw Error('Unexpected source shader');
   clone.fragmentShader=orig.fragmentShader.replace(token,token.replace('0.970, 0.995','0.987, 0.998'));
   window.__paddleDiagnostic={two,far,original:orig,candidate:clone};
   return {object:two.name,geometry:two.geometry.type,original:[.970,.995],candidate:[.987,.998],materialCloned:true};
 });
 const result={setup,shots:[],errors:[]};
 page.on('pageerror',e=>result.errors.push(e.message));
 for(const [name,dist,steer] of states){
   const measured=await page.evaluate(([dist,steer])=>{
     const r=window.__rainbow;r.run(false);r.goto('07');const target=r.state().s+dist;
     let frames=0;r.setSteer(steer);
     while(r.state().s<target-.001&&frames<1500){r.step(1);frames++}
     r.setSteer(null);if(dist)r.freezeAt(12+frames/60);r.drawList();
     return {frames,state:r.state(),position:r.camera().position};
   },[dist,steer]);
   const drawn=await draw(page,'before',name);
   await draw(page,'candidate',name);
   if(name==='opening'||name==='forward'||name==='hard-left'||name==='hard-right'){
     await draw(page,'hide-two',name);await draw(page,'hide-far',name);
   }
   await draw(page,'repeat',name);
   result.shots.push({name,dist,steer,measured,drawn});
   fs.writeFileSync(path.join(out,'trial.json'),JSON.stringify(result,null,1));
 }
 // In the disposable tab only, run Claudia's actual eight assertions while the candidate is installed.
 await page.evaluate(()=>{const v=window.__paddleDiagnostic;v.two.material=v.candidate;v.two.visible=true;v.far.forEach(o=>o.visible=true)});
 const source=fs.readFileSync(path.join(root,'docs/07/scripts/gameplay-test.mjs'),'utf8'), marker='const result = await page.evaluate(';
 const left=source.indexOf(marker)+marker.length,right=source.indexOf('\n});\n\nresult.errors = errors;',left);
 if(left<marker.length||right<0)throw Error('Test entry point changed');
 const game=await page.evaluate('('+source.slice(left,right)+'\n})()');
 fs.writeFileSync(path.join(out,'gameplay.json'),JSON.stringify(game,null,2));
 if(Object.values(game.checks).filter(x=>x.pass).length!==8||game.checks.realCoinPickups.endCoins!==2240||game.checks.realCoinPickups.collected!==91)throw Error('Game regression');
 } finally {await browser.close();}
}
main().catch(e=>{console.error(e.stack);process.exitCode=1});
