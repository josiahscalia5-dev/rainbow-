    if previous:
        body+='<h2>Earlier passes in this experiment</h2><ul>'+''.join(previous)+'</ul>'
    (dest/'index.html').write_text(document(f'Rainbow · {sid} · {TITLES[sid]}',body))
    manifest={str(p.relative_to(dest)):sha(p) for p in sorted(dest.rglob('*')) if p.is_file() and p.name!='sha256.json'}
    (dest/'sha256.json').write_text(json.dumps(manifest,indent=2)+'\n')
    mob=OUTPUT/('Screen-'+sid)
    copy_assets(dest,mob)
    with zipfile.ZipFile(OUTPUT/('Screen-'+sid+'.zip'),'w',compression=zipfile.ZIP_STORED,allowZip64=True) as z:
        for p in sorted(mob.rglob('*')):
            if p.is_file():
                z.write(p, arcname=str(p.relative_to(OUTPUT)))
    print(sid,'saved',len(manifest),'files',flush=True)

if __name__=='__main__':
    OUTPUT.mkdir(parents=True,exist_ok=True)
    for sid in sys.argv[1:]:
        publish(sid)
