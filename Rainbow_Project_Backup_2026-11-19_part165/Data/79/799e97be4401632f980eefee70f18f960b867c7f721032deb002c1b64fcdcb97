ed thick gold ring ribs placed perpendicular to the tube every `spacing` units. */\n325\texport function buildRings(\n326\t  path: TubePath,\n327\t  s0: number,\n328\t  s1: number,\n329\t  spacing: number,\n330\t  material: THREE.Material,\n331\t  opts: RingOpts = {},\n332\t): THREE.InstancedMesh {\n333\t  const list: number[] = [];\n334\t  for (let s = s0; s <= s1 + 1e-6; s += spacing) list.push(s);\n335\t  return buildRingsAt(path, list, material, opts, spacing);\n336\t}\n337\t\n338\t/** Same rings at an explicit list of path positions (e.g. one evenly spaced set per tunnel section). */\n339\texport function buildRingsAt(path: TubePath, list: number[], material: THREE.Material, opts: RingOpts = {}, spacing = 9): THREE.InstancedMesh {\n340\t  const tube = opts.tube ?? 0.075;\n341\t  const collar = opts.band ?? opts.collar;\n342\t  const geo = opts.band ? bandGeometry(opts.band) : opts.collar ? collarGeometry(opts.collar.depth, opts.collar.lip, opts.collar.width, opts.collar.segments) : new THREE.TorusGeometry(1, tube, 14, 72);\n343\t  const n = Math.max(1, list.length) * (opts.double ? 2 : 1);\n344\t  const mesh = new THREE.InstancedMesh(geo, material, n);\n345\t  const m = new THREE.Matrix4();\n346\t  const q = new THREE.Quaternion();\n347\t  const basis = new THREE.Matrix4();\n348\t  const c = new THREE.Vector3();\n349\t  let k = 0;\n350\t  for (const s of list) {\n351\t    for (let dbl = 0; dbl < (opts.double ? 2 : 1); dbl++) {\n352\t      const ss = s + dbl * spacing * 0.16;\n353\t      const f = path.frame(ss);\n354\t      const r = path.radius(ss) - (opts.inset ?? 0.05) + (opts.extra ?? 0);\n355\t      c.copy(f.pos).addScaledVector(f.up, path.radius(ss) - path.depth(ss));\n356\t      // (right, up, tan) is left-handed (right = tan × up), so the quaternion below is not the intended\n357\t      // frame: band rings (05 only) use the right-handed (−right, up, tan) so their lip really sits on the\n358\t      // camera side (−z); collar/torus rings (04/06/07) keep