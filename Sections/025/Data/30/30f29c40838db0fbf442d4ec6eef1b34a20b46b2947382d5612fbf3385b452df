nst sChute1 = course.stage('03').s0 + 0.3;\n130\t  const chutePath = courseTubePath(course, () => 2.25, 0.55);\n131\t  const chute = new THREE.Mesh(\n132\t    buildTubeGeometry(chutePath, sChute0, sChute1, { radial: 36, step: 0.5, vScale: 1 }),\n133\t    perforatedMetal({ color: '#e94ad0', slot: 0, repeatU: 22, repeatV: 1.6, holeSize: 0.38 }),\n134\t  );\n135\t  zones.drumA.add(chute);\n136\t  zones.drumA.add(buildRings(chutePath, sChute0 + 1.5, sChute1 - 1, 3.2, goldMat, { tube: 0.09 }));\n137\t\n138\t  // =====================================================================================\n139\t  // Whirlpool basin room (03) + backdrop shared with 04\n140\t  // =====================================================================================\n141\t  const B = WORLD.basin;\n142\t  const prof: THREE.Vector2[] = [];\n143\t  for (let i = 0; i <= 40; i++) {\n144\t    const r = B.drainRadius * 1.04 + (B.rimRadius + 0.4 - B.drainRadius * 1.04) * (i / 40);\n145\t    prof.push(new THREE.Vector2(r, funnelY(r) - 0.45));\n146\t  }\n147\t  const funnelGeo = new THREE.LatheGeometry(prof, 96);\n148\t  funnelGeo.translate(B.center.x, 0, B.center.z);\n149\t  zones.basin.add(new THREE.Mesh(funnelGeo, perforatedMetal({ color: '#e04fd0', slot: 0, repeatU: 60, repeatV: 22, holeSize: 0.3, side: THREE.DoubleSide, streaks: 0 })));\n150\t  // thick gold drain lip + inner ring (ref 03: concentric gold rings inside the drain)\n151\t  for (const [rr, tt, dy] of [[B.drainRadius + 0.15, 0.42, 0.1], [B.drainRadius - 0.55, 0.22, -0.9]] as const) {\n152\t    const lip = new THREE.Mesh(new THREE.TorusGeometry(rr, tt, 18, 96), goldMat);\n153\t    lip.rotation.x = Math.PI / 2;\n154\t    lip.position.set(B.center.x, funnelY(B.drainRadius) + dy, B.center.z);\n155\t    zones.basin.add(lip);\n156\t  }\n157\t  const rim = new THREE.Mesh(new THREE.TorusGeometry(B.rimRadius + 0.5, 0.75, 24, 128), goldMat);\n158\t  rim.rotation.x = Math.PI / 2;\n159\t  rim.position.set(B.center.x, B.rimY + 0.25, B.center.z);\n160\t  zones.basin.add(rim);\n161\t  const rim2 = new THREE.Mesh(new THREE.TorusGeometry(B.rimRadius + 2.1, 0.35, 16, 128), goldSoft);\n162\t  rim2.rotation.x = Math.PI / 2;\n163\t  rim2.position.set(B.center.x, B.rimY + 0.35, B.center.z);\n164\t  zones.basin.add(rim2);\n165\t  // glossy pink deck around the basin\n166\t  const deckShape = new THREE.Shape();\n167\t  deckShape.moveTo(-34, -34); deckShape.lineTo(34, -34); deckShape.lineTo(34, 30); deckShape.lineTo(-34, 30); deckShape.lineTo(-34, -34);\n168\t  const deckHole = new THREE.Path();\n169\t  deckHole.absarc(0, 0, B.rimRadius + 0.4, 0, Math.PI * 2, true);\n170\t  deckShape.holes.push(deckHole);\n171\t  const deck = new THREE.Mesh(new THREE.ShapeGeometry(deckShape, 64), new THREE.MeshStandardMaterial({ color: '#f36fd6', metalness: 0.5, roughness: 0.2, emissive: '#c43bb0', emissiveIntensity: 0.35, side: THREE.DoubleSide }));\n172\t  deck.rotation.x = -Math.PI / 2;\n173\t  deck.position.set(B.center.x, B.rimY + 0.3, B.center.z);\n174\t  zones.basin.add(deck);\n175\t  buildBasinBackdrop(zones.basin, goldMat, chromeMat);\n176\t\n177\t  // =====================================================================================\n178\t  // 04 gold ring pipe\n179\t  // =====================================================================================\n180\t  const s04 = course.stage('04').s0, s05 = course.stage('05').s0;\n181\t  const tubeR = (s: number) => course.prop('tube', s);\n182\t  // the pipe mouth is the drain hole itself: narrow at the lip, opening up as it dives\n183\t  // the ring tunnel starts just ahead of Benny on the open slide (ref 04), with a flared mouth\n184\t  const g0 = s04 + 5.0;\n185\t  const r04 = (s: number) => tubeR(s) + 1.8 * (1 - sm(g0, g0 + 6, s));\n186\t  const goldPath = courseTubePath(course, r04, 0.9);\n187\t  const goldPipe = new THREE.Mesh(buildTubeGeometry(goldPath, g0, s05, { radial: 56, step: 0.4 }), goldRibbed(1.25));\n188\t  zones.tubes.add(goldPipe);\n189\t  zones.tubes.add(buildRings(goldPath, g0 + 0.2, s05 - 1, 1.6, goldMat, { tube: 0.05, inset: 0.02 }));\n190\t  // big mouth rings at the drain\n191\t  for (let i = 0; i < 4; i++) {\n192\t    const s = g0 + 0.05 + i * 0.3;\n193\t    zones.tubes.add(buildRings(goldPath, s, s + 0.01, 1, goldMat, { tube: 0.07, extra: 0.4 + i * 0.22 }));\n194\t  }\n195\t\n196\t  // =====================================================================================\n197\t  // 05–07 perforated tubes (incl. the 06 arch hall and the full 07 plunge)\n198\t  // =====================================================================================\n199\t  const s08 = course.stage('08').s0;\n200\t  const pinkFlow = pinkFlowMaterial();\n201\t  // refs 05–07: rich saturated magenta→violet glossy pressed metal, dense glowing slot rows, warm light\n202\t  // far down the tunnel. Own reflection environment (no cyan studio panel) + correct inward normals.\n203\t  // hot magenta near → violet mid-tunnel → warm yellow-white core at the vanishing point\n204\t  const tubeGlow: FarGlow = { color: '#ffd08a', near: 48, far: 105, strength: 1.5 };\n205\t  const wallGlow: FarGlow = { ...tubeGlow, mid: { color: '#8a3cf0', near: 10, far: 42, amount: 0.55 } };\n206\t  const tubeEnv = washerTubeEnv('wall');\n207\t  const goldEnv = washerTubeEnv('gold');\n208\t  // 06/07 ring bays (unchanged): gold bands every 9 units, 4 circumferential slot rows per bay\n209\t  const ringSpacing = 9.0;\n210\t  const slotRowsPerBay = 4;\n211\t  // analytic strip lights along the tunnel (28 around: ref 05 shows ≈12–16 marquee spots per half-ring)\n212\t  const strips: TubeStrips = { count: 28, width: 0.022, intensity: 2.6, color: '#ffd9f6', alt: 0.65 };\n213\t  // glossy (low roughness → the strips stay crisp lengthwise streaks instead of a flat clipped sheen)\n214\t  const wallBase = {\n215\t    // pale pink F0: the saturation comes from the magenta/violet tube environment, so white strip lights\n216\t    // reflect as white-pink streaks (a sa