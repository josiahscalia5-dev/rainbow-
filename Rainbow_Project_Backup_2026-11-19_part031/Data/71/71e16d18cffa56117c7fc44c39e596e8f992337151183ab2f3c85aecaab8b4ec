': { back: 6.2, up: 3.7, ahead: 15, lookUp: 0.6, fov: 62, latFollow: 0.8, roll: 0.3 },\n31\t  '10': { back: 5.8, up: 3.4, ahead: 11, lookUp: 1.2, fov: 62, latFollow: 0.8, roll: 0.2 },\n32\t};\n33\t\n34\tconst KEYS: (keyof CamParams)[] = ['back', 'up', 'ahead', 'lookUp', 'fov', 'latFollow', 'roll'];\n35\t\n36\texport function camParamsAt(course: Course, s: number, blend = 8): CamParams {\n37\t  const acc: CamParams = { back: 0, up: 0, ahead: 0, lookUp: 0, fov: 0, latFollow: 0, roll: 0 };\n38\t  let w = 0;\n39\t  for (const st of course.stages) {\n40\t    const p = STAGE_CAM[st.id];\n41\t    if (!p) continue;\n42\t    const a = THREE.MathUtils.smoothstep(s, st.s0 - blend, st.s0 + blend) * (1 - THREE.MathUtils.smoothstep(s, st.s1 - blend, st.s1 + blend));\n43\t    if (a <= 0) continue;\n44\t    for (const k of KEYS) acc[k] += p[k] * a;\n45\t    w += a;\n46\t  }\n47\t  if (w === 0) return { ...(STAGE_CAM['03'] as CamParams) };\n48\t  for (const k of KEYS) acc[k] /= w;\n49\t  return acc;\n50\t}\n51\t\n52\texport class RideCamera {\n53\t  readonly pos = new THREE.Vector3();\n54\t  readonly target = new THREE.Vector3();\n55\t  readonly up = new THREE.Vector3(0, 1, 0);\n56\t  fov = 70;\n57\t  private init = false;\n58\t  /** optional straight tunnel axis + the s-range where the camera aligns to it */\n59\t  axis: { path: TubePath; s0: number; s1: number } | null = null;\n60\t\n61\t  constructor(private course: Course) {}\n62\t\n63\t  /** desired pose for Benny at (s, lateral) */\n64\t  desired(s: number, lat: number, outPos: THREE.Vector3, outTarget: THREE.Vector3, outUp: THREE.Vector3): CamParams {\n65\t    const p = camParamsAt(this.course, s);\n66\t    const f = this.course.sample(s);\n67\t    const fb = this.course.sample(Math.max(0, s - p.back * 0.5)); // smoothing of heading\n68\t    const dir = f.tan.clone().lerp(fb.tan, 0.35).normalize();\n69\t    let up = f.up.clone();\n70\t    if (this.axis) {\n71\t      const a = this.axis;\n72\t      const w = THREE.MathUtils.smoothstep(s, a.s0, a.s0 + 10) * (1 - THREE.MathUtils.smoothstep(s, a.s1 - 10, a.s1));\n73\t      if (w > 0) {\n74\t        const af = a.path.frame(s);\n75\t        dir.lerp(af.tan, w).normalize();\n76\t        up.lerp(af.up, w).normalize();\n77\t      }\n78\t    }\n79\t    up.addScaledVector(dir, -up.dot(dir)).normalize();\n80\t    const right = new THREE.Vector3().crossVectors(dir, up).normalize();\n81\t    const benny = f.pos.clone().addScaledVector(f.right, lat);\n82\t    const anchor = benny.clone().addScaledVector(right, -lat * (1 - p.latFollow));\n83\t    // offsets use an 'upright' up: banking only tilts the camera as much as `roll` allows\n84\t    const upPos = new THREE.Vector3(0, 1, 0).lerp(up, Math.max(p.roll, Math.abs(dir.y))).normalize();\n85\t    // position: ON the curved course behind Benny (stays inside bending/pitching tubes, e.g. the\n86\t    // 07 pull-up arc); aim: along his heading so he stays centred in winding streams\n87\t    const fbk = this.course.sample(Math.max(0, s - p.back));\n88\t    const upB = new THREE.Vector3(0, 1, 0).lerp(fbk.up, Math.max(p.roll, Math.abs(fbk.tan.y))).normalize();\n89\t    const straightPos = anchor.clone().addScaledVector(dir, -p.back).addScaledVector(upPos, p.up);\n90\t    const curvedPos = fbk.pos.clone().addScaledVector(fbk.right, lat * p.latFollow).addScaledVector(upB, p.up);\n91\t    // use the curved position where the path bends in pitch (plunge arcs), straight elsewhere\n92\t    const pitchBend = THREE.MathUtils.clamp(Math.abs(fbk.tan.y - f.tan.y) * 6, 0, 1);\n93\t    outPos.copy(straightPos).lerp(curvedPos, Math.max(pitchBend, 0.35));\n94\t    outTarget.copy(anchor).addScaledVector(dir, p.ahead).addScaledVector(upPos, p.lookUp);\n95\t    outUp.set(0, 1, 0).lerp(up, p.roll).normalize();\n96\t    // 03 whirlpool: dynamic high angle from the near side, looking down into the vortex toward the\n97\t    // drain and the porthole wall (Benny left, drain lower-right as in the reference)\n98\t    const st3 = this.course.stage('03');\n99\t    const w3 = THREE.MathUtils.smoothstep(s, st3.s0 - 6, st3.s0 + 2) * (1 - THREE.MathUtils.smoothstep(s, st3.s1 - 6, st3.s1 + 1));\n100\t    if (w3 > 0) {\n101\t      const B = WORLD.basin;\n102\t      const wp = benny.clone().add(new THREE.Vector3(2.8, 3.6, 5.6));\n103\t      const drain = new THREE.Vector3(B.center.x, B.drainY, B.center.z);\n104\t      const wt = benny.clone().lerp(drain, 0.2).add(new THREE.Vector3(0.6, -1.0, -2.4));\n105\t      outPos.lerp(wp, w3);\n106\t      outTarget.lerp(wt, w3);\n107\t      outUp.lerp(new THREE.Vector3(0, 1, 0), w3).normalize();\n108\t    }\n109\t    // 05 straight current tube: the '05' preset measured in the straight tunnel's own frame — aimed\n110\t    // along the tunnel axis (not Benny's S-curve heading) so the gold rings stay concentric on ONE\n111\t    // vanishing point, level (no roll), following Benny's lateral S offset by latFollow.\n112\t    const st5 = this.course.stage('05');\n113\t    const p5 = STAGE_CAM['05'] as CamParams;\n114\t    const w5 = this.axis ? THREE.MathUtils.smoothstep(s, st5.s0 + 1, st5.s0 + 8) * (1 - THREE.MathUtils.smoothstep(s, st5.s1 - 9, st5.s1 - 1)) : 0;\n115\t    if (w5 > 0 && this.axis) {\n116\t      const af = this.axis.path.frame(s);\n117\t      const T = af.tan.clone();\n118\t      const U = new THREE.Vector3(0, 1, 0).addScaledVector(T, -T.y).normalize();\n119\t      const Rt = new THREE.Vector3().crossVectors(T, U).normalize();\n120\t      const water = f.pos.clone().addScaledVector(f.right, lat); // Benny's point on the stream\n121\t      const off = water.clone().sub(af.pos).dot(Rt); // his lateral offset from the tunnel axis\n122\t      const cp = water.addScaledVector(T, -p5.back).addScaledVector(U, p5.up).addScaledVector(Rt, -off * (1 - p5.latFollow));\n123\t      const pitch = Math.atan2(p5.up - p5.lookUp, p5.ahead + p5.back);\n124\t      const look = T.multiplyScalar(Math.cos(pitch)).addScaledVector(U, -Math.sin(pitch));\n125\t      outPos.lerp(cp, w5);\n126\t      outTarget.lerp(cp.clone().addScaledVector(look, p5.ahead + p5.back), w5);\n127\t      outUp.lerp(U, w5).normalize();\n128\t    }\n129\t    return p;\n130\t  }\n131\t\n132\t  update(dt: number, s: number, lat: number, cam: THREE.PerspectiveCamera, snap = false) {\n133\t    const dp = new THREE.Vector3(), dt3 = new THREE.Vector3(), du = new THREE.Vector3();\n134\t    const p = this.desired(s, lat, dp, dt3, du);\n135\t    const k = snap || !this.init ? 1 : 1 - Math.exp(-dt * 7);\n136\t    const kt = snap || !this.init ? 1 : 1 - Math.exp(-dt * 9);\n137\t    this.pos.lerp(dp, k);\n138\t    this.target.lerp(dt3, kt);\n139\t    this.up.lerp(du, kt).normalize();\n140\t    this.fov += (p.fov - this.fov) * (snap || !this.init ? 1 : Math.min(1, dt * 3));\n141\t    this.init = true;\n142\t    cam.position.copy(this.pos);\n143\t    cam.up.copy(this.up);\n144\t    cam.lookAt(this.target);\n145\t    if (Math.abs(cam.fov - this.fov) > 0.01) { cam.fov = this.fov; cam.updateProjectionMatrix(); }\n146\t  }\n147\t}\n148\t", "tool_use_id": "toolu_01YV7446vChejngGyGrKWmEU", "type": "tool_result"}], "role": "user"}, "parentUuid": "3077bfba-bedf-4cd7-b321-ee1bd8ee2590", "permissionDecision": {"decision": "accept", "reasonType": "rule", "ruleSource": "cliArg", "source": "config"}, "promptId": "c53ad454-3350-48aa-919e-00238c9cb0b2", "sessionId": "eae80a1c-be41-5f1a-858b-469afcc249da", "sourceToolAssistantUUID": "3077bfba-bedf-4cd7-b321-ee1bd8ee2590", "timestamp": "2026-11-15T19:18:51.837Z", "type": "user", "userType": "external", "uuid": "a9e58e24-25d7-439d-ae8b-75e7c49e9939", "version": "2.1.325"}
