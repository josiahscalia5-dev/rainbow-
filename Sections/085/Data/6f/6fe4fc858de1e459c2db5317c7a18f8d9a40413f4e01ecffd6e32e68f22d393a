from pathlib import Path
import json,subprocess,sys
v=Path.cwd()
for sid in sys.argv[1:]:
    rec=json.load(open('base-'+sid+'.json'));root=v/'repos'/sid
    g=['git','-C',str(root)]
    assert subprocess.check_output(g+['branch','--show-current'],text=True).strip()==rec['branch']
    subprocess.run(['python3','publish.py',sid],check=True)
    rel='experiments/codex/'+sid
    subprocess.run(g+['add','--sparse','--',rel],check=True)
    subprocess.run(g+['diff','--cached','--check'],check=True)
    subprocess.run(g+['commit','--quiet','-m','Save Screen '+sid+' native comparisons, full rides and experiment verdict'],check=True)
    subprocess.run(['python3','push-codex.py','final',sid],check=True)
    subprocess.run(['python3','verify-lfs.py',sid],check=True)
