from pathlib import Path
import os,sys,subprocess as sp
p=Path.cwd();s=sys.argv[1]
env=dict(os.environ,NODE_PATH='/opt/codex/cua_node/lib/node_modules',RAINBOW_BASE_URL='http://127.0.0.1:'+str(8140+int(s)))
game=p/'games'/s
jobs=[('types',[str(game/'node_modules/.bin/tsc'),'--noEmit'],game),('build',[str(game/'node_modules/.bin/vite'),'build','--outDir',str(p/'production'/s),'--logLevel','warn'],game)]
