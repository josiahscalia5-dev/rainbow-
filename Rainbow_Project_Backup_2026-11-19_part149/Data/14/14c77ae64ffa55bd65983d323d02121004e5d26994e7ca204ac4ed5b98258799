{"agentId": "a727bb647d5dd42f7", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-93add0fa-q17ey6", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Washer-world materials: procedural perforated magenta metal (round holes for drums, circumferential\n3\t * slots for tunnels), thick reflective gold, chrome, glass — all PBR (MeshStandardMaterial) so they pick\n4\t * up the candy PMREM environment, with shader patches for the perforations and glow.\n5\t */\n6\timport * as THREE from 'three';\n7\t\n8\texport interface PerforatedOptions {\n9\t  /** base metal colour */\n10\t  color?: THREE.ColorRepresentation;\n11\t  /** colour of the hole interiors */\n12\t  holeColor?: THREE.ColorRepresentation;\n13\t  /** 0 = round holes (drum), 1 = slots elongated along u (tunnel rings) */\n14\t  slot?: number;\n15\t  /** pattern repeats: holes around u (per 0..1) and per uv-unit along v */\n16\t  repeatU?: number;\n17\t  repeatV?: number;\n18\t  /** hole size relative to its cell (0..1) */\n19\t  holeSize?: number;\n20\t  emissive?: THREE.ColorRepresentation;\n21\t  emissiveIntensity?: number;\n22\t  metalness?: number;\n23\t  roughness?: number;\n24\t  side?: THREE.Side;\n25\t  /** bright stripe highlights running along v (tunnel light streaks) */\n26\t  streaks?: number;\n27\t  /** number of procedural lengthwise streaks around u (default 9) */\n28\t  streakCount?: number;\n29\t  /**\n30\t   * explicit slot half-size in CELL units [along u, along v] (overrides holeSize/slot); the cell is\n31\t   * 1/repeatU of the circumference by 1/repeatV along the tube, so world proportions follow from both\n32\t   */\n33\t  slotHalf?: [number, number];\n34\t  /** stagger every other slot row by half a cell (default true) */\n35\t  stagger?: boolean;\n36\t  /** pattern offset along v in cells (aligns slot rows between the ring bands) */\n37\t  offsetV?: number;\n38\t  /**\n39\t   * Washer-tube upgrade (05–07): pressed-metal corrugation + bevelled slot lips perturb the normal so\n40\t   * the glossy metal catches light around every slot (refs 05–07). Height amplitudes in world units.\n41\t   */\n42\t  relief?: { corrugation: number; bevel: number; bevelWidth?: number };\n43\t  /** emissive glow colour hugging every hole edge (refs: hot-pink glowing slot outlines) */\n44\t  rimColor?: THREE.ColorRepresentation;\n45\t  rimStrength?: number;\n46\t  /** warm \"light at the end of the tunnel\": emissive that grows with view distance */\n47\t  farGlow?: FarGlow;\n48\t  /** dedicated reflection environment (e.g. washerTubeEnv()) instead of scene.environment */\n49\t  envMap?: THREE.Texture | null;\n50\t  envMapIntensity?: number;\n51\t  /**\n52\t   * forced-perspective section (05 far tunnel): the geometry carries a per-vertex `fgExtra` attribute =\n53\t   * virtual minus real depth, so the distance glow / mid tint behave as if the tunnel ran on for hundreds\n54\t   * of units (see buildForcedTunnel in tube.ts)\n55\t   */\n56\t  virtualDepth?: boolean;\n57\t  /**\n58\t   * paint a far stream on the tunnel floor (forced-perspective section only): band centred on the\n59\t   * bottom (uv.x = 0.5), half width in uv.x, visible beyond `from` virtual units\n60\t   */\n61\t  river?: { halfWidth: number; from: number; core: THREE.ColorRepresentation; band: THREE.ColorRepresentation; foam: THREE.ColorRepresentation };\n62\t}\n63\t\n64\texport interface FarGlow {\n65\t  color: THREE.ColorRepresentation; near: number; far: number; strength: number;\n66\t  /** optional mid-distance tint of the metal colour (refs: walls turn violet deeper in the tunnel) */\n67\t  mid?: { color: THREE.ColorRepresentation; near: number; far: number; amount: number };\n68\t}\n69\t\n70\t/** GLSL for the distance glow, shared by the tube wall, rings and lids. With FG_VIRTUAL the distance is the\n71\t *  forced-perspective (virtual) depth: real view distance + the per-vertex/per-instance `fgExtra`. */\n72\tconst FAR_GLOW_PARS = `uniform vec3 uFarGlowColor; uniform vec3 uFarGlowRange; uniform vec3 uMidTint; uniform vec3 uMidRange;\n73\t#ifdef FG_VIRTUAL\n74\tvarying float vFgExtra;\n75\tfloat fgDist(){ return length(vViewPosition) + vFgExtra; }\n76\t#else\n77\tfloat fgDist(){ return length(vViewPosition); }\n78\t#endif\n79\tfloat farGlowK(){ float k = smoothstep(uFarGlowRange.x, uFarGlowRange.y, fgDist()); return uFarGlowRange.z * k * k; }\n80\tfloat midTintK(){ return uMidRange.z * smoothstep(uMidRange.x, uMidRange.y, fgDist()); }`;\n81\t/** vertex side of FG_VIRTUAL: `fgExtra` is a plain attribute on tube geometry, an instanced one on rings/lids */\n82\tconst FG_VIRTUAL_VERT_PARS = `#ifdef FG_VIRTUAL\n83\tattribute float fgExtra; varying float vFgExtra;\n84\t#endif`;\n85\tconst FG_VIRTUAL_VERT = `#ifdef FG_VIRTUAL\n86\tvFgExtra = fgExtra;\n87\t#endif`;\n88\t/** `solid` = 0 inside perforation holes (they stay dark), 1 on metal */\n89\tconst FAR_GLOW_APPLY = (solid = '1.0') => `{ float sol = ${solid}; float mt = midTintK() * sol; diffuseColor.rgb = mix(diffuseColor.rgb, uMidTint, mt); totalEmissiveRadiance *= 1.0 - mt * 0.5;\n90\t  float fg = farGlowK(); diffuseColor.rgb = mix(diffuseColor.rgb, uFarGlowColor, min(1.0, fg * 0.5) * sol); totalEmissiveRadiance += uFarGlowColor * fg * mix(0.35, 1.0, sol); }`;\n91\t\n92\tfunction farGlowUniforms(g: FarGlow) {\n93\t  return {\n94\t    uFarGlowColor: { value: new THREE.Color(g.color) },\n95\t    uFarGlowRange: { value: new THREE.Vector3(g.near, g.far, g.strength) },\n96\t    uMidTint: { value: new THREE.Color(g.mid?.color ?? '#ffffff') },\n97\t    uMidRange: { value: new THREE.Vector3(g.mid?.near ?? 0, g.mid?.far ?? 1, g.mid?.amount ?? 0) },\n98\t  };\n99\t}\n100\t\n101\t/**\n102\t * Adds the warm distance glow to any MeshStandardMaterial (rings, lids). The far end of the tube melts\n103\t * into a bright warm vanishing point like refs 05/07 without adding scene lights (mobile-friendly).\n104\t */\n105\texport function withFarGlow<T extends THREE.MeshStandardMaterial>(mat: T, g: FarGlow, key: string, virtualDepth = false): T {\n106\t  const uniforms = farGlowUniforms(g);\n107\t  const prev = mat.onBeforeCompile;\n108\t  if (virtualDepth) mat.defines = { ...(mat.defines ?? {}), FG_VIRTUAL: '' };\n109\t  mat.onBeforeCompile = (shader, r) => {\n110\t    prev.call(mat, shader, r);\n111\t    Object.assign(shader.uniforms, uniforms);\n112\t    if (virtualDepth) {\n113\t      shader.vertexShader = shader.vertexShader\n114\t        .replace('#include <common>', '#include <common>\\n' + FG_VIRTUAL_VERT_PARS)\n115\t        .replace('#include <project_vertex>', '#include <project_vertex>\\n' + FG_VIRTUAL_VERT);\n116\t    }\n117\t    shader.fragmentShader = shader.fragmentShader\n118\t      .replace('#include <common>', '#include <common>\\n' + FAR_GLOW_PARS)\n119\t      .replace(\n120\t        '#include <emissivemap_fragment>',\n121\t        `#include <emissivemap_fragment>\n122\t${FAR_GLOW_APPLY()}`,\n123\t      );\n124\t  };\n125\t  const prevKey = mat.customProgramCacheKey.bind(mat);\n126\t  mat.customProgramCacheKey = () => prevKey() + '|fg2-' + key + (virtualDepth ? '-v' : '');\n127\t  mat.userData.farGlow = uniforms;\n128\t  return mat;\n129\t}\n130\t\n131\t/**\n132\t * Analytic strip lights for the washer tubes (refs 05–07). Narrow light strips run the full length of\n133\t * the tunnel at evenly spaced angles around its axis. Their radiance depends only on the azimuth of the\n134\t * reflected view ray around the LOCAL tube axis, so (unlike a cube map, whose meridians pinch together\n135\t * and blur at the pole every grazing wall reflection looks into) they stay crisp at any distance and\n136\t * follow the tube through the 06 arch and the 07 plunge. The term is added to the IBL radiance, so the\n137\t * normal PBR BRDF weights it: glossy magenta panels get lengthwise white-pink streaks, every gold band\n138\t * gets evenly spaced \"marquee\" spots, and both line up radially like in the reference.\n139\t * Axis source: 'attribute' = per-vertex `tubeAxis`/`tubeUp` (buildTubeGeometry({ axisAttr: true })),\n140\t * 'instance' = local Z (axis) / local Y (up) of each instance matrix (rings, lids).", "tool_use_id": "toolu_01RN4fWZxEKEXgzUz9bFnWdo", "type": "tool_result"}], "role": "user"}, "parentUuid": "4c0732aa-6992-4488-b933-cc9f7980406e", "permissionDecision": {"decision": "accept", "reasonType": "rule", "ruleSource": "cliArg", "source": "config"}, "promptId": "4c3de2a5-f8a1-42ce-bcf3-da46637f8373", "sessionId": "9403ef16-db4f-520b-8577-610f580574f8", "sourceToolAssistantUUID": "4c0732aa-6992-4488-b933-cc9f7980406e", "timestamp": "2026-11-15T23:46:26.738Z", "type": "user", "userType": "external", "uuid": "873f8a8c-c4b4-45c3-b280-c7f90b984d73", "version": "2.1.325"}
