  "scene_tree": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "depth": {
        "description": "Max tree depth (default: 3)",
        "type": "number"
      },
      "types": {
        "description": "Filter by type: Mesh, Light, Group, etc.",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "maxChildren": {
        "description": "Max children per node (default: 15 compact, 100 JSON)",
        "type": "number"
      },
      "compact": {
        "description": "Compact text tree (default: true)",
        "type": "boolean"
      }
    }
  },
  "object_details": {
