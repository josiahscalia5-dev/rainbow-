"""Push a normal, fast-forward Codex branch and verify GitHub returns the same commit."""
from pathlib import Path
from datetime import datetime, timezone
import json
import subprocess
import sys

root = Path.cwd()
phase = sys.argv[1]
for sid in sys.argv[2:]:
    rec = json.loads((root/('base-'+sid+'.json')).read_text())
    g = ['git','-C',str(root/'repos'/sid)]
    branch = rec['branch']
    assert branch.startswith('codex/')
    ref = 'refs/heads/'+branch
    sha = subprocess.check_output(g+['rev-parse','HEAD'],text=True).strip()
    previous = subprocess.check_output(g+['ls-remote','--heads','origin',ref],text=True).strip()
    known = (root/('source-'+sid+'.txt')).read_text().strip()
    prior = root/('source-push-'+sid+'.json')
    prior_sha = json.loads(prior.read_text())['commit'] if prior.is_file() else None
    if previous and previous.split()[0] not in (known,sha,prior_sha):
        raise RuntimeError('Different existing checkpoint on '+branch)
    if previous:
        subprocess.run(g+['merge-base','--is-ancestor',previous.split()[0],sha],check=True)
    subprocess.run(g+['push','origin','HEAD:'+ref],check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    verify = subprocess.check_output(g+['ls-remote','--heads','origin',ref],text=True).strip()
    assert verify.split()==[sha,ref],verify
    (root/(phase+'-push-'+sid+'.json')).write_text(json.dumps({'branch':branch,'commit':sha,
        'verifiedUTC':datetime.now(timezone.utc).isoformat()},indent=2)+'\n')
    print(sid,sha,flush=True)
