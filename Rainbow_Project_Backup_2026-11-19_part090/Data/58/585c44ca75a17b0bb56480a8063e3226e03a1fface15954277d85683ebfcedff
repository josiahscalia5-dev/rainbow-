from pathlib import Path
import os,signal,time
from guides import OUT,ROOT
assert (OUT/'PACKAGE_VERIFICATION.json').is_file()
record=ROOT/'hd-ready';pid=int(record.read_text())
proc=Path('/proc')/str(pid)
if proc.exists() and (proc/'cmdline').read_bytes():
    argv=[Path(x.decode()).name for x in (proc/'cmdline').read_bytes().split(b'\0') if x]
    owner=int(next(x for x in (proc/'status').read_text().splitlines() if x.startswith('Uid:')).split()[1])
    hz=os.sysconf('SC_CLK_TCK')
    boot=int(next(x.split()[1] for x in Path('/proc/stat').read_text().splitlines() if x.startswith('btime ')))
    started=boot+int((proc/'stat').read_text().rpartition(') ')[2].split()[19])/hz
    assert argv==['node','serve-hd.cjs'] and owner==os.getuid() and 0<=record.stat().st_mtime-started<25,(argv,owner)
    os.kill(pid,signal.SIGTERM)
    for _ in range(80):
        if not proc.exists() or not (proc/'cmdline').read_bytes():break
        time.sleep(.1)
    assert not proc.exists() or not (proc/'cmdline').read_bytes()
print('Closed the isolated replay server')
