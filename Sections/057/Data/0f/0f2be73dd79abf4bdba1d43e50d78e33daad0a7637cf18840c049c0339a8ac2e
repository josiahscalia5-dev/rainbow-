from pathlib import Path
import subprocess,shutil,json,sys,hashlib
root=Path(__file__).parent;dest=Path('/workspace/library-files/Rainbow-Crest-and-Swimming-Review');hd=Path('/tmp/rainbow-review-package.Ag1cgebC/proof')
for s in sys.argv[1:]:
 folder=dest/s;folder.mkdir(parents=True,exist_ok=True)
 for x,p in [('Claudia',hd/s/'BEFORE/ride.mp4'),('Codex',root/'proof'/s/'NEW/ride.mp4')]:
  if not p.with_name('route.json').is_file():continue
  out=folder/(x+s+'-swim.mp4')
  if out.exists():continue
  if p.stat().st_size<=10*1024**2:shutil.copyfile(p,out)
  else:
   duration=float(subprocess.check_output(['ffprobe','-v','error','-show_entries','format=duration','-of','csv=p=0',str(p)]))
   target=int(9.25*1024**2*8/duration)
   opts=['ffmpeg','-v','error','-y','-i',str(p),'-an','-c:v','libx264','-threads','2','-preset','fast','-b:v',str(target),'-pix_fmt','yuv420p','-passlogfile',str(root/('mobile-'+s+'-'+x))]
   subprocess.run(opts+['-pass','1','-f','null','/dev/null'],check=True)
   subprocess.run(opts+['-pass','2','-movflags','+faststart',str(out)],check=True)
  assert out.stat().st_size<10*1024**2
  probe=lambda f:json.loads(subprocess.check_output(['ffprobe','-v','error','-select_streams','v:0','-show_entries','stream=width,height,codec_name,nb_frames,avg_frame_rate,duration','-of','json',str(f)]))['streams'][0]
  assert probe(out)==probe(p)
  print(s,x,out.stat().st_size,flush=True)
