def load(path):return json.loads(Path(path).read_text())
def jsonbytes(x):return (json.dumps(x,indent=2,ensure_ascii=False)+'\n').encode()
def csvbytes(keys,items):
    s=io.StringIO(newline='');w=csv.DictWriter(s,fieldnames=keys,extrasaction='ignore',lineterminator='\n');w.writeheader()
    for r in items:w.writerow({k:(json.dumps(r[k],separators=(',',':'),ensure_ascii=False) if isinstance(r.get(k),(dict,list)) else r.get(k,'')) for k in keys})
    return s.getvalue().encode()
def digest(data):return hashlib.sha256(data).hexdigest()
def put(z,name,value):
    if isinstance(value,Path):
        z.write(value,name,compress_type=ZIP_STORED if name.lower().endswith(('.jpg','.png','.webp','.mp4')) else ZIP_DEFLATED)
    else:
        z.writestr(name,value if isinstance(value,bytes) else value.encode(),compress_type=ZIP_DEFLATED,compresslevel=6)
def stage_reports(sid):
    d=CURRENT/('Screen-'+sid);pre='Screen_'+sid+'/Reports/'
    mapping={'OPENING_MEASUREMENTS.json':d/'opening-metrics.json','MOTION_MEASUREMENTS.json':d/'motion-checks.json'}
    for name,src in [('ARCHIVED_OPENING_CHECK.json',d/'archive-opening-check.json'),('PADDLE_GEOMETRY_CHECK.json',d/'paddle-geometry-check.json')]:
        if src.is_file():mapping[name]=src
    for folder in TRIALS.get(sid,{}):
        mapping['REJECTED_'+folder.upper().replace('-','_')+'_OPENING_MEASUREMENTS.json']=d/folder/'opening-metrics.json'
    prov=load(d/'provenance.json');stats={}
    st=[];fr=[]
    for label in ['BEFORE','NEW']:
        poses=load(d/label/'poses.json');ride=load(d/label/'route.json')
        for p in poses:
            if 'skip' in p:
                st.append(dict(variant=label,pose=p['name'],skipped=p['skip']));continue
            st.append(dict(variant=label,pose=p['name'],stage=p['state']['stage'],position_s=p['state']['s'],steer=p['steer'],shaderTime=p['shaderTime'],camera=p['camera'],hearts=p['state']['hearts'],triangles=p['gl']['triangles'],drawCalls=p['gl']['calls']))
        for f in ride['frames']:
            fr.append(dict(variant=label,frame=f['i'],videoSecond=f['time'],shaderTime=f['shaderTime'],stage=f['stage'],position_s=f['s'],lateral=f['lat'],steer=f['steer'],hearts=f['hearts'],score=f['coins'],cameraPosition=f['camera']))
        suite=load(d/label/'gameplay.json')['checks'];picks=suite['realCoinPickups']
        stats[label]={'passedAssertions':{n:r['pass'] for n,r in suite.items()},'startingScore':picks['startCoins'],'collectedCoins':picks['collected'],'finishingScore':picks['endCoins'],'standardFullGameHearts':suite['victory']['finalState']['hearts'],'stageRideMinimumHearts':min(f['hearts'] for f in ride['frames'])}
        if sid=='04':
            c=load(d/label/'full-safe-ride.json')['success'];stats[label]['additionalFullGame']={k:c[k] for k in ('hearts','coins','score','collisions')}
    reports={pre+k:v.read_bytes() for k,v in mapping.items()}
    reports[pre+'CAMERA_POSES.csv']=csvbytes(['variant','pose','stage','position_s','steer','shaderTime','camera','hearts','drawCalls','triangles','skipped'],st)
    reports[pre+'RIDE_FRAMES.csv']=csvbytes(['variant','frame','videoSecond','shaderTime','stage','position_s','lateral','steer','hearts','score','cameraPosition'],fr)
    reports[pre+'GAMEPLAY_CHECKS.json']=jsonbytes(stats)
    reports[pre+'SOURCE.json']=jsonbytes({'retained':prov['base'],'candidateBranch':prov['branch'],'candidateSourceCommit':prov['experimentSource'],
                                          'evidenceCommit':REFS['codexBranches'][sid]['verifiedCommit'],'approvedReference':prov['referencePath'],'approvedSHA256':prov['referenceSHA256'],
                                          'retainedSwitches':prov['retainedQuery'],'candidateSwitch':prov['experimentFlag']})
    if sid=='07':
        from zipfile import ZipFile
        with ZipFile(LIB/'Rainbow-S07-Image2Blender-test.zip') as z:reports[pre+'REJECTED_IMAGE2BLENDER_BANK_MEASUREMENTS.json']=z.read('comparison/measurements.json')
        reports[pre+'REJECTED_ANGLE_ONLY_MEASUREMENTS.json']=(LIB/'Rainbow-Motion-Toolchain/screen-07-paddle/measurements.json').read_bytes()
    if sid=='05':
