from pathlib import Path
from datetime import datetime,timezone
import json,subprocess
r=Path.cwd();prior=json.load(open('heads.json'))
cache=Path('/tmp/rainbow-visual-audit.X0POSzUq')/'objects.git'
text=subprocess.check_output(['git','-C',str(cache),'ls-remote','--heads','origin'],text=True)
raw={k.removeprefix('refs/heads/'):v for v,k in (l.split() for l in text.splitlines())}
latest={k:raw.get(v['branch']) for k,v in prior.items()}
changes={k:{'captured':v['commit'],'current':latest[k]} for k,v in prior.items() if latest[k]!=v['commit']}
new=[r for r in raw if (r.startswith('claude/rainbow-s') and r.rsplit('-c',1)[-1].isdigit() and int(r.rsplit('-c',1)[-1])>17)]
d={'checkedAt':datetime.now(timezone.utc).strftime('%H:%M UTC on November 18, 2026'),'latest':latest,'changes':changes,'post17specialists':new,'branchCount':len(raw),'note':'The named lead, specialists and prior Codex branch had the same remote tips at the two checks.' if not changes else 'The captured baselines are pinned to the first check. Remote changes that appeared during this review are listed in the accompanying record.'}
(r/'remote-end.json').write_text(json.dumps(d,indent=2)); print(d['checkedAt'], 'changed',changes,'post17',new,'branchCount',len(raw))
