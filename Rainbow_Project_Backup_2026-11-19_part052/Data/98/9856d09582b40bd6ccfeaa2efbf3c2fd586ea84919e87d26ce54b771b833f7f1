def sha(p):
 with p.open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
def copy(a,b):
 b.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(a,b)
def report(path,data):path.write_text(json.dumps(data,indent=2,ensure_ascii=False)+'\n')
def runpy(f,*args,env=None):
 sp.run([sys.executable,str(f),*(str(k) for k in args)],check=True,env=env)

