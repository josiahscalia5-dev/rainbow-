from pathlib import Path
from collections import defaultdict, Counter
from concurrent.futures import ThreadPoolExecutor
from PIL import Image
import json, hashlib, io, os, numpy as np, sys

root=Path.cwd()
records=json.load(open('images.json'))
# First package every requested current pair, including twins, under separate filenames.
ordered=sorted(enumerate(records),key=lambda x:(x[1]['rank'],x[0]))
bysha=defaultdict(list)
for i,r in ordered:
    r['n']=i;bysha[r['sha256']].append(r)
work=root/'image-cache';work.mkdir(exist_ok=True)
def convert(item):
    hx,refs=item; p=Path(refs[0]['file']); cache=work/hx; cache.mkdir(exist_ok=True)
    with Image.open(p) as pic:
        rgba=np.asarray(pic.convert('RGBA'),dtype=np.uint8)
        digest=hashlib.sha256(str(pic.size).encode()+rgba.tobytes()).hexdigest()
        sample=np.asarray(pic.convert('RGB'),dtype=np.int16)
        keep=any(r.get('exact') for r in refs) or pic.format=='JPEG' or np.any(rgba[:,:,3]!=255)
        raw_ext={'JPEG':'jpg','PNG':'png','WEBP':'webp'}[pic.format]
        rank=min(r['rank'] for r in refs)
        q=94 if rank<=1 else 92
        diff_mean=0.;p99=0.;saved=None
        if not keep:
            saved=cache/('q'+str(q)+'.jpg')
            if not saved.exists():
                pic.convert('RGB').save(saved,'JPEG',quality=q,subsampling=0,optimize=True,progressive=True)
            if p.stat().st_size<=saved.stat().st_size: keep=True
        if keep: share=p;ext=raw_ext
        else:
            share=saved;ext='jpg'
            with Image.open(share) as copy:
                delta=np.abs(sample-np.asarray(copy.convert('RGB'),dtype=np.int16))
                diff_mean=round(float(delta.mean()),4)
                histogram=np.bincount(delta.reshape(-1),minlength=256)
                p99=int(np.searchsorted(np.cumsum(histogram),delta.size*.99))
        return hx,{'pixelDigest':digest,'share':str(share),'ext':ext,'shareSize':share.stat().st_size,'rawExt':raw_ext,
                    'rawSize':p.stat().st_size,'shareHash':hashlib.sha256(share.read_bytes()).hexdigest(),'quality':'original bytes' if keep else 'JPEG quality '+str(q)+' 4:4:4',
                    'meanError':diff_mean,'p99Error':p99}
use={}
with ThreadPoolExecutor(max_workers=3) as pool:
    for hx,meta in pool.map(convert,bysha.items()):use[hx]=meta
seen={};out=[]
for _,r in ordered:
    m=use[r['sha256']];r.update(m)
    folder='/'.join(x for x in ('Screen_'+r['screen'],r['section']) if x)
    r['nativeName']=folder+'/'+r['stem']+'.'+m['rawExt']
    r['name']=folder+'/'+r['stem']+'.'+m['ext']
    prior=seen.get((r['screen'],m['pixelDigest']))
    mandatory=r['rank']==0
    r['canonical']=r['name'] if prior is None or mandatory else prior['name']
    if prior is None:seen[(r['screen'],m['pixelDigest'])]=r
    if r['name']==r['canonical']:out.append(r)
# Native backups preserve every unique binary source. Current before and new also keep distinct named files.
binary={}
for _,r in ordered:
    prior=binary.get((r['screen'],r['sha256']))
    r['nativeCanonical']=r['nativeName'] if prior is None or r['rank']==0 else prior['nativeName']
    if prior is None:binary[(r['screen'],r['sha256'])]=r
meta={'compactCount':len(out),'sourceRecords':len(records),'compactBytes':sum(r['shareSize'] for r in out),'nativeBytes':sum(r['rawSize'] for r in records if r['nativeName']==r['nativeCanonical']),
      'compactPerStage':dict(Counter(r['screen'] for r in out)),'nativePerStage':{s:sum(r['rawSize'] for r in records if r['screen']==s and r['nativeName']==r['nativeCanonical']) for s in ('04','05','06','07','08')}}
Path('converted.json').write_text(json.dumps(records));Path('image-totals.json').write_text(json.dumps(meta,indent=2)+'\n')
print(meta,flush=True)
