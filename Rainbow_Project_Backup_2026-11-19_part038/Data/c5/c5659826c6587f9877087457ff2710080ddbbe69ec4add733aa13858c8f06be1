{"agentId": "af51923537e86162d", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "claude/rainbow-3d-account-recovery-xex5hc", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Spline water ribbon — the traversable stream Benny rides from the Drum A drain to the towel.\n3\t *\n4\t * Geometry: rows every `ds` along the master course, columns across `widthAt(s)`; a slightly\n5\t * concave trough with raised frothy edges plus a short skirt under each edge (thickness).\n6\t * Shader: electric-cyan core with meandering hot-pink flow bands, advected white streaks and\n7\t * sparkles (two-phase flow-map advection so per-stage speeds never shear), Fresnel/haze\n8\t * reflection, specular glints, cellular soap-foam fringe, Benny ripple rings + V-wake, the five\n9\t * glowing chevrons on the 04 slide, a dithered hand-over to the whirlpool surface in 03 and a\n10\t * drain-away for the 11 outro.\n11\t */\n12\timport * as THREE from 'three';\n13\timport type { Course, StageId } from '../world/course';\n14\timport { FRAG_FX_GLSL, FRAG_TAIL, NOISE_GLSL, PALETTE, withFog } from './glsl';\n15\t\n16\t/** wave amplitude per stage (units); blended across boundaries */\n17\tconst AMP: Partial<Record<StageId, number>> = {\n18\t  '02': 0.06, '03': 0.08, '04': 0.03, '05': 0.1, '06': 0.12, '07': 0.1, '08': 0.1, '09': 0.16, '10': 0.08, '11': 0.05,\n19\t};\n20\texport const EDGE_LIFT = 0.28;\n21\t\n22\t/**\n23\t * Per-stage colour-band layout (blended across stage boundaries, baked into `aStyle`):\n24\t *  x gate: 1 = pink bands taper off and part around Benny so the water at and behind him is pure\n25\t *          cyan (ref 05: rows y=1200/1400 are 0% pink); 0 = bands run right past him (refs 04/06/07\n26\t *          keep pink at the sides near the camera)\n27\t *  y off:  band-centre offset from the meandering core centre, fraction of the half width\n28\t *  z wid:  band half width, fraction of the half width\n29\t * Between the two bands is the electric-cyan core; outside them more cyan, then the foam lace.\n30\t */\n31\ttype Style = [number, number, number, number];\n32\t/*  w free: weight of the shader's own drifting channel meander (meander() in FRAG). 0 in 05, where the\n33\t *          course itself winds (S05/meander05 in course.ts) and the core is pinned to the route (see\n34\t *          coreLateral) so the coins on the route stay on the cyan core. 1 elsewhere (04/06/07 unchanged).\n35\t * 05 layout from ref 05 at the live 05 camera (y=600 ≈ 36 px/u, y=700 ≈ 63, y=800 ≈ 93): in the mid/far\n36\t * field each pink band is ≈20 % of the water width, the cyan core ≈45 %, a thin outer cyan strip ≈7 %\n37\t * → band centre 0.62 hw, half width 0.19 hw. Toward Benny the bands taper to half width (gate, FRAG),\n38\t * which gives the ref's ≈100–130 px bands at y=800 and a pure-cyan near field. */\n39\tconst BAND_STYLE: Partial<Record<StageId, Style>> = {\n40\t  '04': [0, 0.6, 0.19, 1],\n41\t  '05': [1, 0.62, 0.19, 0],\n42\t  '06': [0.4, 0.48, 0.1, 1],\n43\t  '07': [0, 0.52, 0.13, 1],\n44\t};\n45\tconst BAND_DEFAULT: Style = [0, 0.5, 0.12, 1];\n46\t\n47\tfunction bandStyleAt(course: Course, s: number): Style {\n48\t  const o: Style = [0, 0, 0, 0];\n49\t  let w = 0;\n50\t  for (const st of course.stages) {\n51\t    const a = smooth(st.s0 - 5, st.s0 + 5, s) * (1 - smooth(st.s1 - 5, st.s1 + 5, s));\n52\t    if (a <= 0) continue;\n53\t    const v = BAND_STYLE[st.id] ?? BAND_DEFAULT;\n54\t    for (let i = 0; i < 4; i++) o[i] += v[i] * a;\n55\t    w += a;\n56\t  }\n57\t  if (w <= 0) return [...(BAND_STYLE[course.stageAtS(s).id] ?? BAND_DEFAULT)];\n58\t  return [o[0] / w, o[1] / w, o[2] / w, o[3] / w];\n59\t}\n60\t\n61\t/**\n62\t * 05 current: lateral position (units, ribbon `right` axis, + = right) of the centre of the\n63\t * electric-cyan core relative to the route centreline. The core swings WITH the course meander,\n64\t * amplified by CORE_SWING, so the two pink bands trace S-bends ≈(1 + CORE_SWING)× as strong as the\n65\t * route's own (ref 05: ±60–120 px). Bounded by CORE_SWING · max|offset05| (≈0.9 · 1.85 = 1.7 u at the\n66\t * far crest; ≤1.25 u within 35 u of the 05 checkpoint), inside the ≥2 u core half width, so a coin on\n67\t * the route centre (lat 0) still sits on cyan. 0 outside 05.\n68\t * gameplay/coins.ts may place the 05 coins at this lateral to put them exactly on the core centre.\n69\t */\n70\texport const CORE_SWING = 0.9;\n71\texport function coreLateral(course: Course, s: number): number {\n72\t  const st = course.stage('05');\n73\t  if (s <= st.s0 || s >= st.s1) return 0;\n74\t  return CORE_SWING * course.offset05(s) * course.sample(s).right.x;\n75\t}\n76\t\n77\t/**\n78\t * Ribbon colours in shader (pre-tonemap, linear) space. NeutralToneMapping desaturates anything\n79\t * whose peak channel passes ≈0.76·exposure, so these were solved by inverting Neutral at the game's\n80\t * exposure 0.86 (src/render/env.ts). Flat values after tone mapping: cyanDeep #0065D6, cyan #1D89F0,\n81\t * cyanBright #42C8F7, pinkDeep #E206BE, pink #F741DD (H 308°, not violet), pinkLight #FA93E7. The\n82\t * streaks/crests/glints added on top lift the rendered cyan median to ≈#06A7FF (ref 05 #039FF6).\n83\t * Crests/highlights are allowed to desaturate toward white (that is how the ref highlights look).\n84\t * The shared PALETTE in glsl.ts is untouched (whirlpool, drum and final wave use it).\n85\t */\n86\tconst lin = (r: number, g: number, b: number) => new THREE.Color().setRGB(r, g, b, THREE.LinearSRGBColorSpace);\n87\tconst RIBBON_PAL = {\n88\t  cyanDeep: lin(0.0, 0.15, 0.78),\n89\t  cyan: lin(0.0, 0.31, 1.12),\n90\t  cyanBright: lin(0.04, 0.95, 1.55),\n91\t  pinkDeep: lin(0.9, 0.02, 0.62),\n92\t  pink: lin(1.55, 0.03, 1.2),\n93\t  pinkLight: lin(2.2, 0.5, 1.8),\n94\t};\n95\t/**\n96\t * 05 river palette (wave 4), shader-space linear values solved through the full post chain\n97\t * (exposure 0.86 → Neutral → sRGB → grade.ts saturation 1.36 / contrast 1.15; bloom ignored) so the\n98\t * flat colours land on the ref 05 samples instead of clipping: cyan deep ≈#0466CF (troughs),\n99\t * cyan ≈#029AF3 (ref core), bright ≈#33C0FF, streak ≈#8FE6FF; pink deep ≈#BC16A8, pink ≈#F73DEA\n100\t * (ref #F739E5 / band medians #F749F1), light ≈#FA9EF2, streak ≈#FEC0F6. The old RIBBON_PAL pink\n101\t * (1.55, 0.03, 1.2) clips to #FF23FF in that chain and the lighting lifted it to lavender #FF6CFF.\n102\t */\n103\tconst RIVER05_PAL = {\n104\t  cyanDeep: lin(0.04, 0.16, 0.46),\n105\t  cyan: lin(0.06, 0.37, 0.74),\n106\t  cyanBright: lin(0.1, 0.8, 1.8),\n107\t  cyanStreak: lin(0.36, 1.25, 2.1),\n108\t  pinkDeep: lin(0.36, 0.04, 0.3),\n109\t  pink: lin(0.7, 0.08, 0.64),\n110\t  pinkLight: lin(0.92, 0.3, 0.88),\n111\t  pinkStreak: lin(1.1, 0.58, 1.04),\n112\t};\n113\t/** 05 texture advection relative to the stage speed (>1: the current visibly overtakes Benny) */\n114\tconst FLOW05 = 1.3;\n115\t\n116\texport function ampAt(course: Course, s: number): number {\n117\t  let v = 0, w = 0;\n118\t  for (const st of course.stages) {\n119\t    const a = smooth(st.s0 - 5, st.s0 + 5, s) * (1 - smooth(st.s1 - 5, st.s1 + 5, s));\n120\t    if (a > 0) { v += (AMP[st.id] ?? 0.08) * a; w += a; }\n121\t  }\n122\t  let amp = w > 0 ? v / w : 0.08;\n123\t  // calm the long straight of the deep plunge (fast sheet flow)\n124\t  const pt = course.marks['07_plunge_top'], pb = course.marks['07_plunge_bottom'];\n125\t  if (pt !== undefined) amp *= 1 - 0.6 * smooth(pt, pt + 8, s) * (1 - smooth(pb - 8, pb, s));\n126\t  return amp;\n127\t}\n128\t\n129\tfunction smooth(a: number, b: number, x: number) {\n130\t  const t = Math.min(1, Math.max(0, (x - a) / (b - a)));\n131\t  return t * t * (3 - 2 * t);\n132\t}\n133\t\n134\t/** CPU mirror of the vertex displacement (keep in sync with VERT). */\n135\texport function ribbonWave(u: number, s: number, t: number, amp: number): number {\n136\t  const au = Math.min(1, Math.abs(u));\n137\t  const trough = EDGE_LIFT * au * au * au;\n138\t  return trough + amp * (0.6 * Math.sin(s * 0.9 - t * 2.4 + u * 1.7) + 0.4 * Math.sin(s * 0.41 + t * 1.5 - u * 2.3));\n139\t}\n140\t\n141\tconst VERT = /* glsl */ `\n142\tattribute vec2 aUV;      // x = u (-1..1 across), y = s (arc length)\n143\tattribute float aHalfW;\n144\tattribute float aSpeed;\n145\tattribute float aAmp;\n146\tattribute float aSkirt;  // 0 surface, 1 skirt bottom\n147\tattribute vec4 aStyle;   // band layout: gate, offset, half width, free-meander weight (see BAND_STYLE)\n148\tattribute float aCore;   // 05: core-centre lateral swing (units, see coreLateral)\n149\tattribute vec3 aTan;     // course tangent (downstream)\n150\tuniform float uTime;\n151\tuniform vec4 uHide;      // s03Start, s04Start, chuteMark, unused\n152\tvarying vec2 vUV;\n153\tvarying float vHalfW;\n154\tvarying float vSpeed;\n155\tvarying float vSkirt;\n156\tvarying float vHide;\n157\tvarying vec4 vStyle;\n158\tvarying float vCore;\n159\tvarying vec3 vTanW;\n160\tvarying vec3 vPosW;\n161\tvarying vec3 vNormalW;\n162\t#include <fog_pars_vertex>\n163\tvoid main() {\n164\t  vStyle = aStyle;\n165\t  vCore = aCore;\n166\t  vTanW = normalize(mat3(modelMatrix) * aTan);\n167\t  float u = aUV.x;\n168\t  float s = aUV.y;\n169\t  float h = aAmp * (0.6 * sin(s * 0.9 - uTime * 2.4 + u * 1.7) + 0.4 * sin(s * 0.41 + uTime * 1.5 - u * 2.3));\n170\t  vec3 p = position + normal * h * (1.0 - aSkirt);\n171\t  vec4 wp = modelMatrix * vec4(p, 1.0);\n172\t  vPosW = wp.xyz;\n173\t  vNormalW = normalize(mat3(modelMatrix) * normal);\n174\t  vUV = aUV;\n175\t  vHalfW = aHalfW;\n176\t  vSpeed = aSpeed;\n177\t  vSkirt = aSkirt;\n178\t  // hand the stream over to the whirlpool surface during 03 (dithered fade both ways)\n179\t  float inside03 = smoothstep(uHide.x + 0.5, uHide.x + 3.5, s) * (1.0 - smoothstep(uHide.y - 9.0, uHide.y - 1.5, s));\n180\t  vHide = 1.0 - inside03;\n181\t  vec4 mvPosition = viewMatrix * wp;\n182\t  gl_Position = projectionMatrix * mvPosition;\n183\t  #include <fog_vertex>\n184\t}\n185\t`;\n186\t\n187\tconst FRAG = /* glsl */ `\n188\tuniform float uTime;\n189\tuniform vec3 uCyanDeep;\n190\tuniform vec3 uCyan;\n191\tuniform vec3 uCyanBright;\n192\tuniform vec3 uPinkDeep;\n193\tuniform vec3 uPink;\n194\tuniform vec3 uPinkLight;\n195\tuniform vec3 uFoam;\n196\tuniform vec3 uFoamLav;\n197\tuniform vec3 uHaze;\n198\tuniform vec3 uLightDir;\n199\tuniform vec3 uBenny;      // s, lateral (units), strength\n200\tuniform float uBennyR;    // Benny's waterline radius (units)\n201\tuniform vec3 uChevron;    // start s, spacing, enabled\n202\tuniform vec2 uOutro;      // amount, chamber start s\n203\t// 05 river palette (see RIVER05_PAL) + its one constant advection speed (no stage-speed shear)\n204\tuniform vec3 uC5Deep;\n205\tuniform vec3 uC5;\n206\tuniform vec3 uC5Bright;\n207\tuniform vec3 uC5Streak;\n208\tuniform vec3 uP5Deep;\n209\tuniform vec3 uP5;\n210\tuniform vec3 uP5Light;\n211\tuniform vec3 uP5Streak;\n212\tuniform float uFlow05;\n213\tvarying vec2 vUV;\n214\tvarying float vHalfW;\n215\tvarying float vSpeed;\n216\tvarying float vSkirt;\n217\tvarying float vHide;\n218\tvarying vec4 vStyle;\n219\tvarying float vCore;\n220\tvarying vec3 vTanW;\n221\tvarying vec3 vPosW;\n222\tvarying vec3 vNormalW;\n223\t#include <fog_pars_fragment>\n224\t${NOISE_GLSL}\n225\t${FRAG_FX_GLSL}\n226\t\n227\t// Stationary channel shape (refs 05–07): lateral offset (units) of the electric-cyan core centre\n228\t// relative to the course centreline. Two incommensurate sines + slow noise so the S-curves do not\n229\t// visibly repeat; λ≈26 u differs from the course's own 05 geometry meander (λ≈36 u), so the two beat\n230\t// rather than cancel. It only drifts slowly downstream (+s) at a constant rate (no shear between\n231\t// stage speeds); the strand texture below is what is advected at the local stage speed.\n232\tfloat meander(float s, float hw) {\n233\t  float a = s - uTime * 0.7;\n234\t  float m = 0.2 * sin(a * 0.24) + 0.08 * sin(a * 0.53 + 1.3) + 0.12 * (vnoise(vec2(a * 0.05, 4.7)) - 0.5);\n235\t  return m * min(hw, 4.5);\n236\t}\n237\t\n238\t// polynomial smooth minimum (k = blend width, units)\n239\tfloat smin(float a, float b, float k) {\n240\t  float h = max(k - abs(a - b), 0.0) / k;\n241\t  return min(a, b) - h * h * k * 0.25;\n242\t}\n243\t\n244\t// Combed flow lines (ref 05: thin bright streaks along the flow, 2–4 px apart in the mid-ground).\n245\t// Anti-aliased lines across the flow (K slots per unit), each broken into tapered streak segments of\n246\t// varying length/brightness. Line width is in PIXELS (≈1.2 px core + ≈2.5 px glow), so near the camera\n247\t// the slots spread apart into sparse crisp glints instead of wide parallel light stripes (the\n248\t// \"flattened stripes\" the user rejected); the lines fade once they get closer than ≈3 px.\n249\tfloat combed(float x, float v, float K, float seed) {\n250\t  float p = x * K;\n251\t  float id = floor(p);\n252\t  float fw = max(fwidth(p), 1e-4);            // slots per pixel\n253\t  float hs = hash12(vec2(id, seed));\n254\t  float dpx = abs(fract(p) - 0.5 - (hs - 0.5) * 0.5) / fw;   // pixels from the line centre\n255\t  float line = (1.0 - smoothstep(0.4, 1.3, dpx)) * 0.8 + exp(-dpx * 0.45) * 0.3;\n256\t  // each line breaks into tapered streak segments; sparser when the slots are far apart on screen\n257\t  float sparse = smoothstep(0.03, 0.006, fw);\n258\t  float seg = smoothstep(0.5 + 0.15 * sparse, 0.9, vnoise(vec2(id * 3.7 + seed, v * 0.2 + hs * 9.0)));\n259\t  return line * seg * (0.45 + 0.55 * hs) * (1.0 - smoothstep(0.22, 0.4, fw));\n260\t}\n261\t\n262\t// advected strand texture (\"combed\" glossy water lines parallel to the flow)\n263\t// x = lateral units relative to the meander centre, v = advected arc length, aa = 0..1 detail fade\n264\t// returns: x = height 0..1 (shading + bump), y = white glint lines, z = mid strands, w = fine strands\n265\t// sw = swirl (05): the strands wander laterally and are less stretched, so the water reads as\n266\t// curling glossy flow instead of uniform straight parallel stripes (the user's rejected look)\n267\tvec4 strands(float x, float v, vec2 aa, float sw) {\n268\t  x += sw * 0.9 * (vnoise(vec2(x * 0.45, v * 0.2 + 7.0)) - 0.5);\n269\t  float a = vnoise(vec2(x * 2.4, v * (0.08 + 0.1 * sw)));\n270\t  float b = vnoise(vec2(x * 7.0 + a * 1.6, v * 0.19 + 5.0));\n271\t  #ifdef LOW_Q\n272\t  float c = b;\n273\t  #else\n274\t  float c = vnoise(vec2(x * 17.0 + b * 2.2, v * 0.42 + 3.0));\n275\t  #endif\n276\t  b = mix(0.5, b, aa.x);\n277\t  c = mix(0.5, c, aa.y);\n278\t  float h = a * 0.42 + b * 0.34 + c * 0.24;\n279\t  h = smoothstep(0.18, 0.82, h);              // more contrast: deep azure troughs, bright crests\n280\t  float line = smoothstep(0.72, 0.86, c) * aa.y + smoothstep(0.7, 0.86, b) * aa.x * 0.85;\n281\t  // the combed lines follow the large-scale strand warp so they bend with the flow\n282\t  float xw = x + (a - 0.5) * 0.5;\n283\t  line = max(line, combed(xw, v, 6.0, 0.0) * 0.85);\n284\t  #ifndef LOW_Q\n285\t  line = max(line, combed(xw + (b - 0.5) * 0.12, v * 1.3, 15.0, 11.0) * 0.55);\n286\t  #endif\n287\t  return vec4(h, line, b, c);\n288\t}\n289\t\n290\t// 05 silk streaks: anti-aliased light lines along the FLOW coordinate q (band-relative, so they bend\n291\t// with the pink S-bands instead of running as straight parallel road stripes). Each line wanders\n292\t// slowly (wig, slot fraction) so neighbours braid, and breaks into advected tapered segments of\n293\t// varying brightness. Width in pixels; the lines fade once they crowd closer than ≈3 px.\n294\tfloat silk(float q, float v, float K, float seed, float wig) {\n295\t  float p = q * K;\n296\t  float fw = max(fwidth(p), 1e-4);\n297\t  float id = floor(p);\n298\t  float hs = hash12(vec2(id, seed));\n299\t  float c = 0.5 + (hs - 0.5) * 0.34 + wig * sin(v * (0.28 + 0.3 * hs) + hs * 6.283);\n300\t  float dpx = abs(fract(p) - c) / fw;\n301\t  float line = (1.0 - smoothstep(0.3, 1.2, dpx)) * 0.7 + exp(-dpx * 0.55) * 0.4;\n302\t  // short tapered brush dashes (≈1–2 u: ref 05 speed streaks are 30–80 px in the mid field)\n303\t  float n = vnoise(vec2(id * 3.1 + seed, v * 0.42 + hs * 17.0));\n304\t  float seg = smoothstep(0.5, 0.86, n);\n305\t  return line * seg * (0.5 + 0.7 * hs) * (1.0 - smoothstep(0.22, 0.42, fw));\n306\t}\n307\t\n308\t// 05 (wave 8) speed streaks: ref 05 water is motion-blurred satin — densely packed bright dashes running\n309\t// ALONG the flow (≈4–8 px apart in the mid field, long fanning streaks near the camera) over broad light /\n310\t// dark lanes, on the cyan AND on the pink bands. Anisotropic value noise (cells ≈15–25× longer along the\n311\t// flow than across), octaves 2.3× finer across / 1.6× along; each octave fades once its cells get under\n312\t// ≈3–8 px (fwX / fwV = screen derivatives taken by the caller outside any branch) and the loop stops at\n313\t// the first fully faded octave (all later ones are finer). Peaks of each octave are the dashes (lattice\n314\t// rows staggered by the golden ratio so they never line up across the flow).\n315\t// returns x = lane (≈ -0.5..0.5, broad light/dark lanes), y = dash (0..≈1, thin bright dashes),\n316\t//         z = finest visible octave (0..1, brushes the band edges into streaks)\n317\t#ifdef LOW_Q\n318\t#define SS_OCT 2\n319\t#else\n320\t#define SS_OCT 5\n321\t#endif\n322\tvec3 speedStreaks(float X, float v, float fwX, float fwV) {\n323\t  float lane = 0.0, dash = 0.0, fine = 0.5, nPrev = 0.6;\n324\t  // (it04) cells 25× (fine octaves ≈45×) longer along the flow than across, NO lattice shear: it03's\n325\t  // golden-ratio shear skewed every cell diagonally across the current and the lines curled like marble\n326\t  float kx = 2.2, kv = 0.088, amp = 0.5;\n327\t  for (int i = 0; i < SS_OCT; i++) {\n328\t    float cpx = fwX * kx;                         // cells per pixel across the flow\n329\t    float cpp = max(cpx, fwV * kv * 1.5);\n330\t    float a = 1.0 - smoothstep(0.12, 0.3, cpp);\n331\t    if (a <= 0.0) break;\n332\t    float n = vnoise(vec2(X * kx + float(i) * 3.17, v * kv + float(i) * 7.31));\n333\t    lane += (n - 0.5) * a * amp;\n334\t    // (it03) the dashes are the iso-lines n = 0.5 of every octave whose cells are ≤ ≈30 px across: ≈1–2 px\n335\t    // wide whatever the depth (distance |n − 0.5| over the estimated per-pixel gradient ≈1.3·cpx), so the\n336\t    // water is densely combed like ref 05 satin (it02's thresholded noise peaks were too sparse), broken into\n337\t    // dashes by the next coarser octave (they gather on its light lanes)\n338\t    float dpx = abs(n - 0.5) / (1.3 * cpx + 1e-5);\n339\t    float ln = 1.0 - smoothstep(0.3, 1.1, dpx);\n340\t    dash = max(dash, ln * smoothstep(0.5, 0.78, nPrev) * a * smoothstep(0.025, 0.05, cpx) * (0.6 + 0.8 * amp));\n341\t    fine = mix(fine, n, a);\n342\t    nPrev = n;\n343\t    kx *= 2.3; kv *= 1.85; amp *= 0.62;\n344\t  }\n345\t  return vec3(lane, dash, fine);\n346\t}\n347\t\n348\tvoid main() {\n349\t  float u = vUV.x;\n350\t  float s = vUV.y;\n351\t  // dithered hide (03 hand-over)\n352\t  if (vHide < 0.5) discard;\n353\t  float cutFoam = 1.0 - smoothstep(0.5, 0.85, vHide);\n354\t  // 11 outro: the stream drains away in the chamber, leaving puddles\n355\t  if (uOutro.x > 0.0 && s > uOutro.y - 2.0) {\n356\t    float n = vnoise(vec2(u * 3.0, s * 0.35)) * 0.7 + 0.3;\n357\t    if (n < uOutro.x * 1.15) discard;\n358\t  }\n359\t\n360\t  // ---- channel layout: winding cyan core between two hot-pink S-bands, cyan again outside ----\n361\t  float hw = vHalfW;\n362\t  float lat = u * hw;                         // lateral units in the ribbon frame\n363\t  // core centre: free drifting meander on 04/06/07 (freeK = 1); on 05 (freeK = 0) pinned to the\n364\t  // course's own S-meander, amplified (vCore = CORE_SWING · offset05), so the coins stay on cyan\n365\t  float freeK = vStyle.w;\n366\t  float sw = 1.0 - freeK;                     // weight of the 05 river look (1 on 05 only)\n367\t  float M = meander(s, hw) * freeK + vCore;\n368\t  float x = lat - M;                          // lateral units in the core's frame\n369\t  // 05: the pink bands swing a further ±1.05 u about the core (a stationary λ≈20 u S on top of the\n370\t  // course meander, in phase with it: left at s≈139.5 / y≈800, right at s≈149.7 / y≈680 on the locked\n371\t  // view), so they read as ≈2 clear S-bends to the VP (ref 05: ±100 px). A small 2nd harmonic skews\n372\t  // each bend so the S is not a plain sine. The coins (at coreLateral = M) stay ≥0.3 u inside the cyan.\n373\t  float sbend = sw * (1.05 * sin(s * 0.31 - 0.834) + 0.18 * sin(s * 0.62 + 0.6));\n374\t  float xb = x - sbend;                       // band frame (== x on 04/06/07)\n375\t\n376\t  // detail fade with distance (cells per pixel), keeps far water from shimmering\n377\t  float fwx = fwidth(x);\n378\t  float fws = fwidth(s);\n379\t  // (a noise cell must stay ≳6–8 px wide; the combed lines of ref 05 are 2–4 px apart in the\n380\t  // mid-ground, so fading earlier than this flattens the water into a plain fill)\n381\t  vec2 aa = vec2(1.0 - smoothstep(0.12, 0.26, max(fwx * 7.0, fws * 0.19)),\n382\t                 1.0 - smoothstep(0.09, 0.2, max(fwx * 17.0, fws * 0.42)));\n383\t  // hair-fine combed strands for close-up water (refs: dense parallel flow lines)\n384\t  float aaH = 1.0 - smoothstep(0.14, 0.3, fwx * 46.0);\n385\t  #ifdef LOW_Q\n386\t  aa.y = 0.0;\n387\t  aaH = 0.0;\n388\t  #endif\n389\t\n390\t  // two-phase flow-map advection of the strands (period 4 s; offset scales with stage speed)\n391\t  float ph0 = fract(uTime * 0.25);\n392\t  float ph1 = fract(uTime * 0.25 + 0.5);\n393\t  float w0 = 1.0 - abs(1.0 - 2.0 * ph0);\n394\t  // (04/06/07 strand texture; 05 has its own silk/swell field below)\n395\t  vec4 F = vec4(0.5, 0.0, 0.5, 0.5);\n396\t  if (freeK > 0.001) F = mix(strands(x, s - vSpeed * ph1 * 4.0 + 23.0, aa, sw), strands(x, s - vSpeed * ph0 * 4.0, aa, sw), w0);\n397\t  float v5 = s - uTime * uFlow05;             // 05 advected arc length (one constant speed: no shear)\n398\t\n399\t  // Benny parts the bands like a bow wave (vStyle.x, ref 05): just ahead of him they narrow and\n400\t  // swing outward, so the water at and behind him (the near field) is pure cyan; behind him they\n401\t  // continue only as thin streaks pushed out toward the foam banks\n402\t  // (05: the near rows only show lat ±2.3 behind Benny, so a light parting is enough there)\n403\t  float gate = 1.0, part = 0.0, near05 = 1.0;\n404\t  float db = s - uBenny.x;\n405\t  if (vStyle.x > 0.0) {\n406\t    // 05 (wave 4): the bands stay wide (≥75 %) and run in CLOSER (0.8× offset) beside Benny, so they\n407\t    // sweep past both his sides like ref 05 (pink beside the hat/body at y≈800–1000) instead of\n408\t    // parting out under the foam banks; full width/offset ≈14–20 u ahead\n409\t    float g05 = 0.75 + 0.25 * smoothstep(1.0, 20.0, db);\n410\t    float gOld = 0.4 + 0.6 * smoothstep(0.0, 4.5, db);\n411\t    gate = mix(1.0, mix(g05, gOld, freeK), vStyle.x);\n412\t    part = vStyle.x * hw * 0.3 * freeK * (1.0 - smoothstep(-1.0, 9.0, db));\n413\t    near05 = mix(1.0, 0.8 + 0.2 * smoothstep(2.0, 14.0, db), sw * vStyle.x);\n414\t  }\n415\t  float hwc = min(hw, 4.5);\n416\t  float aaw = fwidth(lat) * 0.85 + 0.01;      // ≈1 px edges: no lavender cyan/pink blend zone\n417\t  // flowing band edges (the advected strand texture). 05: only a soft travelling ripple, so the band\n418\t  // edges are clean S-curves instead of the torn/jagged combed edges of the old slab\n419\t  float pert = mix((vnoise(vec2(x * 0.9, v5 * 0.12 + 3.0)) - 0.5) * 0.3,\n420\t                   (F.z - 0.5) * 0.5 + (F.w - 0.5) * 0.22, freeK) * hwc * 0.22;\n421\t  // 05: the band shapes are carried downstream (a slow travelling wobble), so the pink S-sections\n422\t  // visibly flow and swirl even though the channel itself is fixed to the course meander\n423\t  float tv = s - uTime * vSpeed * 0.3;\n424\t  float wob = sw * hwc;\n425\t  float offL = hw * (vStyle.y * near05 + mix(0.03, 0.07, freeK) * sin(s * 0.13 + 1.7)) + part + wob * 0.05 * sin(tv * 0.42 + 1.1);\n426\t  float offR = hw * (vStyle.y * near05 + mix(0.03, 0.07, freeK) * sin(s * 0.11 + 4.2)) + part + wob * 0.05 * sin(tv * 0.37 + 3.9);\n427\t  float modA = mix(0.15, 0.4, freeK);         // 05: even band width (the ±40 % swell drew the slab)\n428\t  float wL = hw * vStyle.z * (1.0 + modA * sin(s * 0.19 + 0.4) + 0.08 * wob * sin(tv * 0.6)) * gate;\n429\t  float wR = hw * vStyle.z * (1.0 + modA * sin(s * 0.17 + 2.9) + 0.08 * wob * sin(tv * 0.55 + 2.0)) * gate;\n430\t  float brush = 0.0;\n431\t  if (freeK < 0.5) {\n432\t    float Mb = M + sbend;\n433\t    // 05 (wave 7) channel shape fitted to ref 05 (band centres back-projected through the locked camera,\n434\t    // lateral from the core): the river widens at s≈148–166 (the right band runs along the right bank at\n435\t    // s≈152–157, the left band bulges toward the core at s≈145–152 and swings out at s≈158–166), and the\n436\t    // right band runs ≈0.3 u closer to the core at s≈136–139. Stationary in s; 0 beyond s 180 (06 join).\n437\t    float fR = -0.3 * smoothstep(133.0, 136.0, s) * (1.0 - smoothstep(139.5, 142.0, s))\n438\t             + 1.9 * smoothstep(146.5, 154.0, s) * (1.0 - smoothstep(160.0, 168.0, s))\n439\t             - 0.9 * smoothstep(165.0, 170.0, s) * (1.0 - smoothstep(174.0, 180.0, s));\n440\t    float fL = -0.5 * smoothstep(143.0, 147.0, s) * (1.0 - smoothstep(151.0, 155.0, s))\n441\t             + 1.0 * smoothstep(154.0, 158.0, s) * (1.0 - smoothstep(168.0, 176.0, s));\n442\t    offL += sw * fL;\n443\t    offR += sw * fR;\n444\t    // 05 (wave 7): approaching Benny the two S-bands swing OUT to the banks and leave the frame at the\n445\t    // image sides (ref 05: the left band exits at y≈930 ≈ 3.5 u ahead of him, the right one at y≈1090\n446\t    // ≈ 0.8 u ahead); behind him only the two diagonal wake sweeps (below) carry pink. (Wave 5 glided\n447\t    // the bands in to his track ±1.42 u instead, which drew the two wide vertical pink sheets.)\n448\t    if (vStyle.x > 0.0 && uBenny.z > 0.0) {\n449\t      float k5 = sw * vStyle.x;\n450\t      offL += k5 * 2.0 * smoothstep(7.0, 2.5, db);\n451\t      offR += k5 * 1.6 * smoothstep(2.6, 0.4, db);\n452\t    }\n453\t    // keep both bands inside the water (the core swing pushes one toward the bank on each bend);\n454\t    // the band pressed against the bank thins a little instead of collapsing the cyan core\n455\t    // (smooth minimum: a hard min() put a visible corner in the band where the clamp starts)\n456\t    float roomL = Mb + hw - 0.5 - offL, roomR = hw - 0.5 - Mb - offR;\n457\t    wL = smin(wL, max(roomL, 0.6 * wL), 0.5);\n458\t    wR = smin(wR, max(roomR, 0.6 * wR), 0.5);\n459\t    offL = smin(offL, Mb + hw - wL - 0.5, 1.2);\n460\t    offR = smin(offR, hw - wR - 0.5 - Mb, 1.2);\n461\t    // brushed edges: each band edge is combed into pink / cyan strands along the flow (ref 05: the\n462\t    // ribbons fray into light streaks); crisp per-pixel strands, so no violet pink-over-cyan blend.\n463\t    // Faded out where a strand would be < ≈3 px wide (no shimmer in the far field)\n464\t    float bK = 11.0;\n465\t    brush = sw * (vnoise(vec2(xb * bK, v5 * 0.11 + 5.0)) - 0.5) * (1.0 - smoothstep(0.05, 0.12, fwx * bK));\n466\t  }\n467\t  float sdL = xb + offL + pert;\n468\t  float sdR = xb - offR + pert;\n469\t  float dL = abs(sdL);\n470\t  float dR = abs(sdR);\n471\t  float on = smoothstep(0.02, 0.2, gate);\n472\t  float pL = (1.0 - smoothstep(wL - aaw, wL + aaw, dL - brush * wL * 0.55)) * on;\n473\t  float pR = (1.0 - smoothstep(wR - aaw, wR + aaw, dR - brush * wR * 0.55)) * on;\n474\t  // a thin cyan thread splits a band into two streaks along some stretches (ref 05 mid-ground)\n475\t  float rimW = 0.05 * hwc + aaw;\n476\t  float thrW = 0.028 * hwc;\n477\t  float splitOn = smoothstep(0.55, 0.7, vnoise(vec2(s * 0.07, 13.0))) * mix(0.0, 1.0, freeK);\n478\t  float sL = (1.0 - smoothstep(thrW, thrW + aaw, abs(xb + offL + pert * 1.4 + 0.25 * wL * sin(s * 0.5)))) * splitOn;\n479\t  float sR = (1.0 - smoothstep(thrW, thrW + aaw, abs(xb - offR + pert * 1.4 - 0.25 * wR * sin(s * 0.45 + 1.0)))) * (1.0 - splitOn) * freeK;\n480\t  // only split bands that are wide enough (smooth ramp: a hard step cut the band across the flow)\n481\t  pL *= 1.0 - sL * smoothstep(rimW * 1.8, rimW * 2.8, wL);\n482\t  pR *= 1.0 - sR * smoothstep(rimW * 1.8, rimW * 2.8, wR);\n483\t  // ---- 05 (wave 8): one speed-streak field for the whole river (cyan + pink) ----\n484\t  // X = across-flow coordinate (units): ahead of Benny it follows the S-band midline, normalised by the band\n485\t  // spacing so the streaks stay parallel to the pink bands on every bend; behind him it fans out from his\n486\t  // track (÷(1 + 0.7·back)) like his wake, so the near streaks and sweeps spread to the bottom corners.\n487\t  float back = max(-db, 0.0);\n488\t  float cLc = -offL - pert, cRc = offR - pert;\n489\t  float hS = max(0.5 * (cRc - cLc), 0.6);\n490\t  float q = (xb - 0.5 * (cLc + cRc)) / hS;\n491\t  float nearW = uBenny.z > 0.0 ? sw * smoothstep(5.0, 0.5, db) : 0.0;\n492\t  float X = (lat - mix(M + sbend + 0.5 * (cLc + cRc), uBenny.y, nearW)) * mix(3.0 / hS, 1.0, nearW) / (1.0 + 0.7 * back);\n493\t  X += 0.05 * sin(v5 * 0.21 + X * 1.1);       // the streaks braid gently\n494\t  float fwX5 = fwidth(X);\n495\t  vec3 SS = vec3(0.0, 0.0, 0.5);\n496\t  if (sw > 0.001) {\n497\t    SS = speedStreaks(X, v5, fwX5, fws);\n498\t    // brushed band edges: over ≈±22 % of the band width the pink and cyan interleave as streaks along the\n499\t    // flow (ref 05: the ribbons fray into the current) instead of the hard 1-px cut of the flat slab\n500\t    float fLw = 0.13 * wL + aaw, fRw = 0.13 * wR + aaw;\n501\t    float eL = clamp((wL - dL) / (2.0 * fLw) + 0.5, 0.0, 1.0);\n502\t    float eR = clamp((wR - dR) / (2.0 * fRw) + 0.5, 0.0, 1.0);\n503\t    pL = mix(pL, smoothstep(0.4, 0.6, eL + (SS.z - 0.5) * 0.6) * on, sw);\n504\t    pR = mix(pR, smoothstep(0.4, 0.6, eR + (SS.z - 0.5) * 0.6) * on, sw);\n505\t  }\n506\t  // hair-thin pink filaments drifting through the cyan core (mid/far field only)\n507\t  float fil = 0.0;\n508\t  #ifndef LOW_Q\n509\t  float fc = hw * 0.18 * sin(s * 0.21 + 0.8);\n510\t  fil = (1.0 - smoothstep(0.025 * hwc, 0.025 * hwc + aaw, abs(x - fc + pert * 0.7)))\n511\t      * smoothstep(0.62, 0.78, vnoise(vec2(s * 0.09, 21.0))) * gate * aa.x * freeK;   // 05 core: pure cyan\n512\t  #endif\n513\t  float pinkM = max(max(pL, pR), fil);\n514\t  // 05 (wave 7) wake sweeps: two satin pink ribbons leave Benny's sides under the splash and fan out\n515\t  // DIAGONALLY toward the bottom corners (ref 05 runs: y1240 x≈571–595, y1280 134–238 / 586–669,\n516\t  // y1320 91–202 / 626–738 → centre ±(0.4 + 0.52·back) u from his track, half width ≈0.2 u, measured\n517\t  // through the locked camera). They taper in from 0.3 u behind him, so the water right under and\n518\t  // behind him stays cyan, and leave the frame at the bottom corners (≈2.5 u behind him).\n519\t  float wake = (vStyle.x > 0.0 && uBenny.z > 0.0) ? sw * vStyle.x : 0.0;\n520\t  float dlB = lat - uBenny.y;\n521\t  // (it01 measured: Benny's real waterline s sits ≈0.3 u ahead of the checkpoint row, so the fit is\n522\t  // re-solved against the rendered sweeps: centre 0.2 + 0.55·back, tapering in 0.7 → 1.4 u behind him)\n523\t  float cW = 0.2 + 0.55 * back + 0.05 * sin(v5 * 1.7 + sign(dlB) * 1.9) * back;\n524\t  float wW = (0.12 + 0.07 * back) * smoothstep(0.7, 1.4, back);\n525\t  float dW = abs(abs(dlB) - cW);\n526\t  // (wave 8) soft brushed edges from the same streak field (the sweeps lie along the fanning X lines,\n527\t  // so their edges fray into streaks along the sweep instead of the straight plank edges of wave 7)\n528\t  float fWw = 0.4 * wW + aaw;\n529\t  float eW = clamp((wW - dW) / (2.0 * fWw) + 0.5, 0.0, 1.0);\n530\t  float pW = smoothstep(0.38, 0.62, eW + (SS.z - 0.5) * 0.7) * wake * step(0.001, wW);\n531\t  float relW = clamp((cW - abs(dlB)) / max(wW, 1e-3), -1.0, 1.0);   // -1 outer edge .. +1 toward Benny\n532\t  float pMain = max(pL, pR);\n533\t  pinkM = max(pinkM, pW);\n534\t  // glossy rims: light-pink just inside each band edge, bright cyan just outside it\n535\t  float rimIn = max(pL * smoothstep(wL - rimW, wL - aaw, dL), pR * smoothstep(wR - rimW, wR - aaw, dR));\n536\t  float rimOut = max((1.0 - pL) * (1.0 - smoothstep(wL + aaw, wL + rimW * 1.6, dL)),\n537\t                     (1.0 - pR) * (1.0 - smoothstep(wR + aaw, wR + rimW * 1.6, dR))) * on;\n538\t  float rel = pL >= pR ? sdL / max(wL, 1e-3) : -sdR / max(wR, 1e-3);   // -1 outer edge .. +1 core side\n539\t  if (pW > pMain) {\n540\t    rel = relW;\n541\t    rimIn = max(rimIn, pW * smoothstep(wW * 0.6, wW - aaw, dW));\n542\t  }\n543\t  rimOut = max(rimOut, (1.0 - pinkM) * (1.0 - smoothstep(wW + aaw, wW + 0.08 + aaw, dW)) * wake * step(0.001, wW));\n544\t  vec3 N0 = normalize(vNormalW);\n545\t  if (!gl_FrontFacing) N0 = -N0;\n546\t  vec3 V = normalize(cameraPosition - vPosW);\n547\t  vec3 L = normalize(uLightDir);\n548\t  vec3 Hv = normalize(L + V);\n549\t  vec3 Lg = normalize(vTanW + N0 * 0.1);      // the bright tunnel end, far downstream\n550\t\n551\t  vec3 col = vec3(0.0);\n552\t  // =============== 04 / 06 / 07 surface (freeK = 1; unchanged look) ===============\n553\t  if (freeK > 0.001) {\n554\t    float h = F.x;\n555\t    float hair = 0.5;\n556\t    if (aaH > 0.0) {\n557\t      float sv = s - vSpeed * fract(uTime * 0.5) * 2.0;\n558\t      float hA = vnoise(vec2(x * 46.0 + F.w * 3.0, sv * 0.9));\n559\t      float hB = vnoise(vec2(x * 46.0 + F.w * 3.0, (sv + vSpeed) * 0.9 + 17.0));\n560\t      hair = mix(0.5, mix(hB, hA, 1.0 - abs(1.0 - 2.0 * fract(uTime * 0.5))), aaH);\n561\t    }\n562\t    // deep azure troughs → electric cyan → light-cyan crests (crests stay a minority of the area)\n563\t    vec3 cyanCol = mix(uCyanDeep, uCyan, smoothstep(mix(0.3, 0.22, freeK), mix(0.72,