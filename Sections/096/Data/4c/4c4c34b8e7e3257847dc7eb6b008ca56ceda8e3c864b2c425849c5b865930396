const { chromium } = require('playwright');
const fs = require('node:fs');
const path = require('node:path');
const {open,pose} = require('./capture.cjs');
(async()=>{
 const variant=process.argv[2]||'NEW', label=process.argv[3]||'first', size=Number(process.argv[4]||432);
 const dir=path.join(__dirname,'trials',label,variant);fs.mkdirSync(dir,{recursive:true}); const browser=await chromium.launch({executablePath:'/usr/bin/chromium',args:['--use-angle=swiftshader','--enable-unsafe-swiftshader','--disable-background-networking']});
 try {
   const problems=[];const page=await open(browser,'06',variant,{width:size,height:size*16/9},problems);const metadata=[];
   for(const row of [['opening','forward',0],['hard-left','forward',12,-1],['middle','fraction',.5],['forward-10','forward',10],['deep','fraction',.76],['last-in-stage','exit',-.45],['hard-right','forward',12,1]]) {
     const details=await pose(page,'06',row);metadata.push(details); await page.screenshot({path:path.join(dir,row[0]+'.png'),animations:'disabled'});
   }
   fs.writeFileSync(path.join(dir,'poses.json'),JSON.stringify(metadata)); const geometry=await page.evaluate(()=>{const g=window.__rainbow.qa3d().scene.getObjectByName('Screen06_Structural_World');return g?g.children.map(o=>({name:o.name,family:o.userData.surface_family,verts:o.geometry?.attributes.position.count,indices:o.geometry?.index?.count,material:o.material?.name})):[]});fs.writeFileSync(path.join(dir,'mesh.json'),JSON.stringify(geometry,null,2));if(problems.length)throw Error(problems.join(' | '));console.log(label,variant,'captured',metadata.length,'views and',geometry.length,'editable mesh objects.');await page.close();
 }finally {await browser.close();}
})().catch(e=>{console.error(e.message);process.exitCode=1});
