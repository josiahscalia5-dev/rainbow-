EE.LatheGeometry(points.map(([r, y]) => new THREE.Vector2(r, y)), segs);\n121\t  // re-map v to height so stripes are linear in height; u (around) optionally tiles the texture\n122\t  const p = g.attributes.position as THREE.BufferAttribute;\n123\t  const uv = g.attributes.uv as THREE.BufferAttribute;\n124\t  for (let i = 0; i < p.count; i++) uv.setXY(i, uv.getX(i) * uRepeat, (p.getY(i) - v0) / (v1 - v0));\n125\t  return g;\n126\t}\n127\t\n128\tfunction starShape(outer: number, inner: number): THREE.Shape {\n129\t  const s = new THREE.Shape();\n130\t  for (let i = 0; i < 10; i++) {\n131\t    const a = Math.PI / 2 + (i * Math.PI) / 5;\n132\t    const r = i % 2 === 0 ? outer : inner;\n133\t    const x = Math.cos(a) * r, y = Math.sin(a) * r;\n134\t    if (i === 0) s.moveTo(x, y); else s.lineTo(x, y);\n135\t  }\n136\t  s.closePath();\n137\t  return s;\n138\t}\n139\t\n140\texport function buildBenny(): BuiltModel {\n141\t  const D = BENNY_DIMS;\n142\t  const root = named(new THREE.Group(), 'benny_root');\n143\t  const body = joint('body');\n144\t  root.add(body);\n145\t\n146\t  // ---------------- body (fur) ----------------\n147\t  const hatUp = new THREE.Vector3(0, 1, 0).applyAxisAngle(new THREE.Vector3(1, 0, 0), D.hatTilt);\n148\t  const bodyMat = std({ color: C.pinkSkin, roughness: 0.92, metalness: 0 });\n149\t  const bodyGeo = new THREE.SphereGeometry(D.skin, 48, 36);\n150\t  {\n151\t    // pear-round plush ball. Normals come from finite differences of the deformation on the sphere\n152\t    // (position-only, so UV-seam / pole duplicates get identical normals and the shell fur stays closed)\n153\t    const p = bodyGeo.attributes.position as THREE.BufferAttribute;\n154\t    const n = bodyGeo.attributes.normal as THREE.BufferAttribute;\n155\t    const d = new THREE.Vector3(), t1 = new THREE.Vector3(), t2 = new THREE.Vector3();\n156\t    const a = new THREE.Vector3(), b = new THREE.Vector3(), c = new THREE.Vector3(), e = new THREE.Vector3();\n157\t    const s = new THREE.Vector3(), o = new THREE.Vector3();\n158\t    const eps = 1e-3;\n159\t    for (let i = 0; i < p.count; i++) {\n160\t      d.set(p.getX(i), p.getY(i), p.getZ(i)).normalize();\n161\t      t1.set(0, 1, 0).cross(d);\n162\t      if (t1.lengthSq() < 1e-6) t1.set(1, 0, 0).cross(d);\n163\t      t1.normalize();\n164\t      t2.crossVectors(d, t1).normalize();\n165\t      const at = (u: number, w: number, out: THREE.Vector3) =>\n166\t        deformBody(s.copy(d).addScaledVector(t1, u).addScaledVector(t2, w).setLength(D.skin), out);\n167\t      at(eps, 0, a); at(-eps, 0, b); at(0, eps, c); at(0, -eps, e);\n168\t      a.sub(b); c.sub(e);\n169\t      const nn = o.crossVectors(a, c).normalize();\n170\t      if (nn.dot(d) < 0) nn.negate();\n171\t      n.setXYZ(i, nn.x, nn.y, nn.z);\n172\t      deformBody(s.copy(d).multiplyScalar(D.skin), a);\n173\t      p.setXYZ(i, a.x, a.y, a.z);\n174\t    }\n175\t  }\n176\t  const bodyMesh = named(new THREE.Mesh(bodyGeo, bodyMat), 'fur_body');\n177\t  bodyMesh.userData = furData({\n178\t    length: D.fur,\n179\t    density: 64,\n180\t    shells: 20,\n181\t    root: C.pinkRoot,\n182\t    tip: C.pinkTip,\n183\t    // bald under the beanie: dot(normal, hatUp) > brimBottom/skin (+ a little overlap)\n184\t    // (wave 4: +0.07 → full-length fur tucks under the cuff edge; +0.03 left a bare pink collar under the cuff once\n185\t    // the ride lean shows the back of the ball)\n186\t    bald: [hatUp.x, hatUp.y, hatUp.z, (D.brimBottom + 0.07) / D.skin],\n187\t    short: [FACE_DIR.x, FACE_DIR.y, FACE_DIR.z, 0.74, 0.93, 0.26],\n188\t    gravity: 0.1,\n189\t  });\n190\t  body.add(bodyMesh);\n191\t\n192\t  // ---------------- face ----------------\n193\t  const eyes = joint('eyes');\n194\t  body.add(eyes);\n195\t  const eyeR = 0.178;\n196\t  const eyeGeo = domeGeometry(eyeR, 32, 12);\n197\t  eyeGeo.scale(1, 1.06, 0.55);\n198\t  const eyeMatHappy = std({ map: eyeTexture('happy'), roughness: 0.12, metalness: 0 });\n199\t  const eyeMatDizzy = std({ map: eyeTexture('dizzy'), roughness: 0.12, metalness: 0 });\n200\t  const lashMat = std({ color: '#241036', roughness: 0.5 });\n201\t  for (const side of [1, -1] as const) {\n202\t    // side +1 = Benny's left (+X), −1 = right (−X)\n203\t    const dir = new THREE.Vector3(0.34 * side, -0.005, 0.94).normalize();\n204\t    const e = joint(side > 0 ? 'eyeL' : 'eyeR');\n205\t    e.position.copy(dir).multiplyScalar(0.665);\n206\t    e.lookAt(dir.clone().multiplyScalar(5));\n207\t    eyes.add(e);\n208\t    const happy = named(new THREE.Mesh(eyeGeo, eyeMatHappy), side > 0 ? 'eyeL_happy' : 'eyeR_happy');\n209\t    const dizzy = named(new THREE.Mesh(eyeGeo, eyeMatDizzy), side > 0 ? 'eyeL_dizzy' : 'eyeR_dizzy');\n210\t    dizzy.visible = false;\n211\t    e.add(happy, dizzy);\n212\t    // two little upper lashes on the outer corner\n213\t    for (const [a, len] of [[0.5, 0.075], [0.85, 0.065]] as const) {\n214\t      // eye-local: +X of the eye frame points to Benny's left when looking from the front\n215\t      const ang = side > 0 ? a : Math.PI - a;\n216\t      const lash = new THREE.Mesh(new THREE.ConeGeometry(0.014, len, 6), lashMat);\n217\t      lash.position.set(Math.cos(ang) * eyeR * 1.0, Math.sin(ang) * eyeR * 1.05, 0.045);\n218\t      lash.rotation.z = ang - Math.PI / 2;\n219\t      lash.translateY(len * 0.45);\n220\t      lash.name = `lash_${side > 0 ? 'L' : 'R'}_${a}`;\n221\t      e.add(lash);\n222\t    }\n223\t  }\n224\t  // blush\n225\t  const blushMat = std({ map: blushTexture(), transparent: true, depthWrite: false, roughness: 0.8 });\n226\t  for (const side of [1, -1]) {\n227\t    const m = named(new THREE.Mesh(sphereDecal(new THREE.Vector3(0.6 * side, -0.24, 0.78), 0.3, 0.19, 0.775), blushMat), side > 0 ? 'blushL' : 'blushR');\n228\t    m.renderOrder = 2;\n229\t    body.add(m);\n230\t  }\n231\t  // nose\n232\t  const nose = named(new THREE.Mesh(new THREE.SphereGeometry(0.03, 12, 8), std({ color: '#7d2550', roughness: 0.35 })), 'nose');\n233\t  nose.position.copy(new THREE.Vector3(0, -0.13, 1).normalize().multiplyScalar(0.738));\n234\t  nose.scale.set(1.3, 0.9, 0.8);\n235\t  body.add(nose);\n236\t  // mouth decals (alpha-tested)\n237\t  const mouth = joint('mouth');\n238\t  body.add(mouth);\n239\t  const mouthDir = new THREE.Vector3(0, -0.34, 0.94);\n240\t  for (const kind of ['happy', 'dizzy', 'peek'] as const) {\n241\t    const w = kind === 'dizzy' ? 0.19 : 0.29;\n242\t    const m = named(\n243\t      new THREE.Mesh(\n244\t        sphereDecal(mouthDir, w, w, 0.752, 8),\n245\t        std({ map: mouthTexture(kind), alphaTest: 0.5, roughness: 0.4, side: THREE.DoubleSide }),\n246\t      ),\n247\t      `mouth_${kind}`,\n248\t    );\n249\t    m.visible = kind === 'happy';\n250\t    mouth.add(m);\n251\t  }\n252\t\n253\t  // ---------------- arms ----------------\n254\t  const armMat = std({ color: C.pinkSkin, roughness: 0.92 });\n255\t  const palmTex = soleTexture('hand');\n256\t  for (const side of [1, -1] as const) {\n257\t    // round paw nubs stick out left/right just under the cuff (rear ref 05: ≈ 53 px round balls, centres ≈ 35 px\n258\t    // below the cuff's side corners and ≈ 0.92 cuff-half-widths out). Wave 4: a near-sphere with short dense fur\n259\t    // (was a 1.25× elongated ellipsoid with long drooping fur that read as fuzzy wings from behind).\n260\t    const a = joint(side > 0 ? 'armL' : 'armR', 0.71 * side, -0.06, 0.0);\n261\t    body.add(a);\n262\t    const phi = 1.3 * side;\n263\t    const dir = new THREE.Vector3(Math.sin(phi), -Math.cos(phi), 0);\n264\t    const g = new THREE.SphereGeometry(0.13, 20, 14);\n265\t    g.scale(1, 1.06, 1);\n266\t    const arm = named(new THREE.Mesh(g, armMat), side > 0 ? 'fur_armL' : 'fur_armR');\n267\t    arm.position.copy(dir).multiplyScalar(0.18);\n268\t    arm.rotation.z = phi;\n269\t    arm.userData = furData({ length: 0.055, density: 96, shells: 12, root: C.pinkRoot, tip: C.pinkTip, gravity: 0.04 });\n270\t    a.add(arm);\n271\t    const palm = named(\n272\t      new THREE.Mesh(new THREE.CircleGeometry(0.07, 24), std({ map: palmTex, roughness: 0.6 })),\n273\t      side > 0 ? 'palmL' : 'palmR',\n274\t    );\n275\t    palm.position.copy(dir).multiplyScalar(0.24).add(new THREE.Vector3(0, -0.01, 0.1));\n276\t    palm.rotation.x = -0.25;\n277\t    a.add(palm);\n278\t  }\n279\t\n280\t  // ---------------- feet ----------------\n281\t  const footTex = soleTexture('foot');\n282\t  for (const side of [1, -1] as const) {\n283\t    const f = joint(side > 0 ? 'footL' : 'footR', 0.31 * side, -0.65, 0.27);\n284\t    body.add(f);\n285\t    const g = new THREE.SphereGeometry(0.2, 22, 16);\n286\t    g.scale(1, 0.82, 1.12);\n287\t    const foot = named(new THREE.Mesh(g, armMat), side > 0 ? 'fur_footL' : 'fur_footR');\n288\t    foot.position.set(0, -0.03, 0.06);\n289\t    foot.userData = furData({\n290\t      length: 0.06, density: 70, shells: 8, root: C.pinkRoot, tip: C.pinkTip, gravity: 0.1,\n291\t      bald: [0, -0.55, 0.83, 0.55],\n292\t    });\n293\t    f.add(foot);\n294\t    const sole = named(new THREE.Mesh(new THREE.CircleGeometry(0.165, 28), std({ map: footTex, roughness: 0.55 })), side > 0 ? 'soleL' : 'soleR');\n295\t    sole.scale.set(1, 1.08, 1);\n296\t    sole.position.set(0, -0.085, 0.235);\n297\t    // faces forward and a little down (lookAt in foot-local space: sole has no parent yet)\n298\t    sole.lookAt(sole.position.clone().add(new THREE.Vector3(0, -0.55, 0.83)));\n299\t    f.add(sole);\n300\t  }\n301\t\n302\t  // ---------------- knitted beanie ----------------\n303\t  const hat = joint('hat');\n304\t  hat.rotation.x = D.hatTilt;\n305\t  body.add(hat);\n306\t  const yb = D.brimBottom;\n307\t  const yt = yb + D.cuffH; // cuff top\n308\t  const bk = D.brimR / 0.778; // profile scale (profiles were authored for a 0.778 brim)\n309\t  const brimTex = ribbedBrimTextures();\n310\t  const brimMat = std({ map: brimTex.map, normalMap: brimTex.normalMap, normalScale: new THREE.Vector2(1.25, 1.25), roughness: 0.86 });\n311\t  // inner lip hugs the skin at the brim height (sphere radius there ≈ 0.68)\n312\t  const lip = Math.sqrt(D.skin * D.skin - yb * yb) + 0.012;\n313\t  // chunky rolled cuff: rounded bottom and top edges, slight belly in the middle\n314\t  const brim = named(\n315\t    new THREE.Mesh(\n316\t      lathe(\n317\t        [\n318\t          [lip, yb + 0.01],\n319\t          [0.725 * bk, yb - 0.008],\n320\t          [0.758 * bk, yb + 0.02],\n321\t          [0.776 * bk, yb + 0.07],\n322\t          [0.781 * bk, yb + 0.15],\n323\t          [0.776 * bk, yt - 0.075],\n324\t          [0.758 * bk, yt - 0.025],\n325\t          [0.725 * bk, yt - 0.003],\n326\t          [0.68 * bk, yt],\n327\t        ],\n328\t        72,\n329\t        yb - 0.01,\n330\t        yt + 0.005,\n331\t      ),\n332\t      brimMat,\n333\t    ),\n334\t    'hat_brim',\n335\t  );\n336\t  // the brim texture's \"v\" should run across the band (ribs vertical): lathe u = around ✓\n337\t  hat.add(brim);\n338\t  const crownTex = knitCrownTextures();\n339\t  const crownMat = std({ map: crownTex.map, normalMap: crownTex.normalMap, normalScale: new THREE.Vector2(1.3, 1.3), roughness: 0.9 });\n340\t  // crown dome: starts inside the cuff and is narrower than it (the chunky cuff flares out, refs 04–10), with\n341\t  // an elliptic profile r = R0·√(1 − (y/H)²) that tapers to the pom-pom (which covers the apex).\n342\t  // v = height → horizontal knit stripes.\n343\t  const crownY0 = yt - 0.045;\n344\t  const R0 = 0.705 * bk;\n345\t  const crownProfile: [number, number][] = [];\n346\t  for (const t of [0, 0.08, 0.16, 0.25, 0.34, 0.43, 0.52, 0.6, 0.68, 0.75, 0.81, 0.86, 0.9, 0.935, 0.96, 0.98, 0.993, 1]) {\n347\t    // wave 4: × (1 − 0.18 t) tapers the shoulders (ref 05 rear: dome half-width ≈ 0.85 / 0.77 / 0.66 / 0.54 of the\n348\t    // cuff's at 0 / 0.11 / 0.27 / 0.38 above the cuff top: a rounded beehive, not a flat-topped mushroom)\n349\t    crownProfile.push([R0 * Math.sqrt(Math.max(0, 1 - t * t)) * (1 - 0.18 * t), crownY0 + t * D.crownH]);\n350\t  }\n351\t  const crown = named(\n352\t    new THREE.Mesh(lathe(crownProfile, 72, crownY0, crownY0 + D.crownH, CROWN_REPEAT), crownMat),\n353\t    'hat_crown',\n354\t  );\n355\t  hat.add(crown);\n356\t  // puffy gold star badge sewn on the lower white stripe just above the cuff, rear-RIGHT (−X): image-right of\n357\t  // centre in the rear gameplay views (ref 05: centre at ≈ +0.68 of the cuff half-width, ≈ 0.11 × the cuff width\n358\t  // above the cuff's top edge, ≈ 0.27 × the cuff width across, its lower points overlapping the cuff). Its face\n359\t  // is turned toward the back (normal 160° from the front) and leans back against the sloping crown (tilted 25°\n360\t  // up), so the rear ride cameras (10–25° above Benny) see it face-on, never edge-on.\n361\t  const starGeo = new THREE.ExtrudeGeometry(starShape(0.165, 0.083), {\n362\t    depth: 0.02,\n363\t    bevelEnabled: true,\n364\t    bevelThickness: 0.045,\n365\t    bevelSize: 0.032,\n366\t    bevelSegments: 4,\n367\t  });\n368\t  starGeo.center();\n369\t  const star = named(\n370\t    new THREE.Mesh(starGeo, std({ color: C.gold, metalness: 0.12, roughness: 0.3, emissive: '#ffb800', emissiveIntensity: 0.22 })),\n371\t    'hat_star',\n372\t  );\n373\t  const sa = THREE.MathUtils.degToRad(143);\n374\t  // wave 4: centred on the cuff's top edge (ref 05: ≈ 40 % of the star on the cuff, the rest on the white band);\n375\t  // leans back only 12° because the runtime's ride lean (≈ 13°) tips it the rest of the way toward the chase camera\n376\t  const starPos = new THREE.Vector3(-Math.sin(sa) * (D.brimR - 0.01), yt + 0.015, Math.cos(sa) * (D.brimR - 0.01));\n377\t  const na = THREE.MathUtils.degToRad(160), tilt = THREE.MathUtils.degToRad(12);\n378\t  const starN = new THREE.Vector3(-Math.sin(na) * Math.cos(tilt), Math.sin(tilt), Math.cos(na) * Math.cos(tilt));\n379\t  star.position.copy(starPos);\n380\t  star.lookAt(starPos.clone().add(starN));\n381\t  star.rotateZ(-0.14);\n382\t  hat.add(star);\n383\t  // big flu