from pathlib import Path
import collections, csv, hashlib, json, subprocess as sp
root=Path(__file__).resolve().parent
repo=root/'sources.git'
refs=json.loads((root/'remote.json').read_text())
lead='ccr-bbe2b27e-oxfh1w'; commit=refs['refs'][lead]
tree=json.loads((root/'trees.json').read_text())[lead]
records={path:meta[1] for path,meta in tree.items() if path in {'backups/AGENTS_STATUS.json','backups/TOOL_MANIFEST.json'} or path.startswith('backups/wip/') and Path(path).suffix in {'.patch','.json','.txt','.py','.md','.mjs'}}
hashes=list(dict.fromkeys(records.values()))
q=sp.run(['git','--no-lazy-fetch','-C',str(repo),'cat-file','--batch-check=%(objectname) %(objecttype)'],input=('\n'.join(hashes)+'\n').encode(),stdout=sp.PIPE,check=True)
missing=[s.split()[0] for s in q.stdout.decode().splitlines() if s.endswith(' missing')]
for i in range(0,len(missing),50):
 res=sp.run(['git','-C',str(repo),'-c','fetch.negotiationAlgorithm=noop','fetch','origin','--quiet','--no-tags','--no-write-fetch-head','--recurse-submodules=no','--filter=blob:none','--stdin'],input=('\n'.join(missing[i:i+50])+'\n').encode(),stderr=sp.PIPE)
 if res.returncode:raise RuntimeError('Fetch failed for WIP records: '+str(res.returncode))
out=root/'payload/05_REVIEW_RECORDS/Claudia_WIP'
out.mkdir(parents=True,exist_ok=True)
with (out/'INDEX.csv').open('w',newline='',encoding='utf8') as f:
 writer=csv.writer(f);writer.writerow(['source_path','git_blob','sha256','lead_commit','status'])
 for path,h in records.items():
  data=sp.check_output(['git','--no-lazy-fetch','-C',str(repo),'cat-file','blob',h])
  assert hashlib.sha1(b'blob '+str(len(data)).encode()+b'\0'+data).hexdigest()==h
  assert not data.startswith(b'version https://git-lfs.github.com/spec/v1')
  dest=out/path;dest.parent.mkdir(exist_ok=True,parents=True);dest.write_bytes(data)
  writer.writerow([path,h,hashlib.sha256(data).hexdigest(),commit,'Recorded status' if '/wip/' not in path else 'Unfinished snapshot. Never assumed applied, approved or retained.'])
print('Included',len(records),'Claudia text, patch and status records',sum((out/path).stat().st_size for path in records),'bytes.')

