 script=d/'scripts/compare.py'
 script.write_bytes(sp.check_output(['git','-C',str(root/'repos/06'),'show','HEAD:scripts/compare.py']))
 with (d/'comparison.log').open('w') as log:sp.run([sys.executable,'-I',str(script),'04','05','06','07','08'],stdout=log,stderr=log,check=True)
