+/**
+ * `&m05lump=1` (Screen 05 round 13, needs `m05far=1`; src/vfx/foam.ts): the near foam bank at the far tunnel's seam. The
+ * lather bank (berm) was cut by the flat seam plane — a straight edge / square corner, a tall pale panel with straight sides
+ * where the bank rises toward the wall (t75, k81 hard left) — and foam lumps whose real place lies behind the seam were cut
+ * by the far block's first row. Under the switch the berm ends 0.5 … 1.9 u before the seam in a scalloped edge (noise along
+ * the tunnel's cross direction) and the near bank lumps shrink away by the same edge, whole (no lump straddles the seam).
+ * Only while the far block is live (n ≠ 0); locked view: n = 0 → nothing changes.
+ */
+export const M05LUMP: boolean = M05CLIP && flag05('m05lump');
+/** GLSL: how far before the seam plane the near foam bank ends at this point (cd = point − seam point, n = tunnel axis) */
+export const CLIP05_CUT_GLSL = /* glsl */ `
+float c05h(float n) { return fract(sin(n * 12.9898 + 4.1414) * 43758.5453); }
+float c05n(float x) { float i = floor(x), f = fract(x); f = f * f * (3.0 - 2.0 * f); return mix(c05h(i), c05h(i + 1.0), f); }
+float c05cut(vec3 cd, vec3 n) {
+  vec3 rt = cross(n, vec3(0.0, 1.0, 0.0));
+  float l = dot(cd, rt / max(length(rt), 1e-4));
+  return 0.5 + 1.1 * c05n(l * 1.1 + 3.7) + 0.3 * c05n(l * 3.7 + 1.3);
+}`;
+/** as withClip05, but under `&m05lump=1` the cut is the scalloped edge c05cut before the plane (berm) */
+export function withClip05Scallop(mat: THREE.ShaderMaterial, posVar: string): void {
+  if (!M05LUMP) { withClip05(mat, posVar); return; }
+  Object.assign(mat.uniforms, clip05);
+  mat.fragmentShader = mat.fragmentShader.replace('void main() {', `uniform vec3 uClip05P; uniform vec3 uClip05N;${CLIP05_CUT_GLSL}
+void main() {
+  {  // m05lump: behind a scalloped edge 0.5 … 1.9 u before the 05 far tunnel seam, inside its tube only
+    vec3 cd = ${posVar} - uClip05P; float ca = dot(cd, uClip05N);
+    if (dot(uClip05N, uClip05N) > 0.5 && ca > -c05cut(cd, uClip05N) && ca < 40.0 && length(cd - ca * uClip05N) < 9.0) discard;
+  }`);
+}
