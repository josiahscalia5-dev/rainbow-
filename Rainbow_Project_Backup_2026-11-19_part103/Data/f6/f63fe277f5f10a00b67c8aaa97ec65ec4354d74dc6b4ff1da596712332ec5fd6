colorSpace = THREE.NoColorSpace; // the texels ARE display values: the shader undoes the post chain\n30\t    face05.anisotropy = 4;\n31\t  }));\n32\t}\n33\tconst post05 = { uPjPost: { value: new THREE.Vector4(0.86, 1.36, 1.15, 0.18) }, uPjRes: { value: new THREE.Vector2(864, 1536) } };\n34\tconst rt05 = new THREE.Vector2();\n35\t/** unlit material whose map holds DISPLAY colours: the fragment shows pjInverse(map) (the post chain then restores it) */\n36\tfunction coin05Material(map: THREE.Texture): THREE.MeshBasicMaterial {\n37\t  const mat = new THREE.MeshBasicMaterial({ map, fog: false });\n38\t  mat.onBeforeCompile = (shader) => {\n39\t    Object.assign(shader.uniforms, post05);\n40\t    shader.fragmentShader = shader.fragmentShader\n41\t      .replace('void main() {', `uniform vec4 uPjPost; uniform vec2 uPjRes;\\n${PROJ05_INVERSE}\\nvoid main() {`)\n42\t      .replace('#include <dithering_fragment>', `#include <dithering_fragment>\\ngl_FragColor = vec4(pjInverse(diffuseColor.rgb), 1.0); // coins05`);\n43\t  };\n44\t  mat.customProgramCacheKey = () => 'coin05';\n45\t  mat.onBeforeRender = (renderer) => {\n46\t    const rt = renderer.getRenderTarget();\n47\t    if (rt) rt05.set(rt.width, rt.height); else renderer.getDrawingBufferSize(rt05);\n48\t    post05.uPjRes.value.copy(rt05);\n49\t    post05.uPjPost.value.x = renderer.toneMappingExposure;\n50\t  };\n51\t  return mat;\n52\t}\n53\t/** approved coin edge band (display colours, measured below the face of approved coin 1: face side → back) + ridges */\n54\tfunction edge05Texture(): THREE.Texture {\n55\t  const band = [[231, 164, 29], [215, 139, 35], [195, 118, 43], [175, 103, 48], [165, 99, 53], [161, 99, 54], [157, 98, 53], [155, 97, 52], [153, 97, 52], [147, 96, 53], [135, 96, 60]];\n56\t  return canvasTexture(256, band.length, (c, w) => {\n57\t    band.forEach(([r, g, b], y) => {\n58\t      for (let x = 0; x < w; x++) {\n59\t        const k = x % 4; // 64 milled ridges round the coin: a light (water-lit) ridge, a dark groove\n60\t        const d = k === 0 ? [30, 38, 48] : k === 2 ? [-14, -12, -10] : [0, 0, 0];\n61\t        c.fillStyle = `rgb(${Math.min(255, Math.max(0, r + d[0]))},${Math.min(255, Math.max(0, g + d[1]))},${Math.min(255, Math.max(0, b + d[2]))})`;\n62\t        c.fillRect(x, y, 1, 1);\n63\t      }\n64\t    });\n65\t  }, false);\n66\t}\n67\t\n68\t/** scale: coin size factor (1 = 1.0 u diameter); tilt: radians the coin leans back (top away from the camera) */\n69\texport interface CoinDef {\n70\t  s: number; lat: number; h: number; stage: StageId; scale?: number; tilt?: number;\n71\t  /** coins05 only: bob / wobble phase (default: the coin's index, as before) */\n72\t  phase?: number;\n73\t  /** coins05 only: [scale at the 05 checkpoint, distance ahead of Benny at the checkpoint] — the coin shows `scale` from\n74\t   *  15 u closer on (see C05M) */\n75\t  far?: [number, number];\n76\t}\n77\t\n78\t/**\n79\t * 05 (ref 05, measured): ≈10 coins on the electric-cyan core winding to the VP. The nearest one is\n80\t * ≈95 px wide just above Benny's pom (474, 726), then 64 → 55 → 42 → 28 → 19 px: the spacing in depth\n81\t * grows with distance, so the gaps here grow too (C05.gap0 + k·C05.gapGrow). Coins lean back by C05.tilt\n82\t * so their face reads as a slightly flattened disc with the rim visible underneath, as in the ref.\n83\t * Before the 05 checkpoint the trail keeps a plain C05.gap0 spacing (gameplay only, never in frame).\n84\t */\n85\texport const C05 = { first: 5.7, gap0: 5.0, gapGrow: 1.5, gapMax: 8, scale: 0.9, h: 1.2, tilt: 0.8, preGap: 3.6, latK: 0.7 };\n86\t\n87\t/**\n88\t * `?coins05=1` (or `?match05=1`), Screen 05 full reference match (qa/pilot05/full_reference_match/coins/NOTES.md):\n89\t * the visible coins at the locked 05 checkpoint, MEASURED on the approved picture (centre x, y and face width w, px) and\n90\t * solved back onto the course with the live render camera (qa/pilot05/full_reference_match/hud/probe05.mjs --solve:\n91\t * course point (s, lat) at the coins' height whose coin centre — same bob as below, clock 12 — projects onto the\n92\t * approved centre; scale = approved width / projected width of a 1-u coin). Rows: [ds = s − 05_crest, lat, scale].\n93\t * approved (x, y, w): 1 (473.5, 725, 96) 2 (548.5, 658.5, 70) 3 (481.5, 612, 56) 4 (431, 575, 43) 5 (465.5, 545, 28)\n94\t * 6 (495.5, 532.5, 20) 7 (518, 524, 17) 8 (532, 516.5, 12.5) 9 (537, 509, 10) 10 (534, 502, 8) 11 (526, 497, 7)\n95\t * 12 (516, 492, 6) 13 (507.5, 489, 5) 14 (498, 487, 5) 15 (490.5, 485.5, 4) — the far line winds up into the light.\n96\t * The game's straight 05 tube is shorter than the painted one, so coins 8–15 sit where the course starts to climb\n97\t * (ds 56–60) and the approved sizes need scales < 1 there; those coins grow to C05M_NEAR (capped so neighbours do not\n98\t * overlap) as Benny closes in, so they are small only while far away. The pre-checkpoint trail and every other screen's\n99\t * coins are unchanged (their bob phase is kept: CoinDef.phase).\n100\t */\n101\texport const C05M: [number, number, number][] = [\n102\t  [6.356, -0.311, 0.976], [10.95, 0.161, 0.95], [16.614, -0.144, 1.001], [26.225, -0.665, 1.085], [43.262, -1.754, 1.085],\n103\t  [48.928, -1.967, 0.832], [55.075, 0.919, 0.788], [56.475, 1.629, 0.591], [57.469, 1.947, 0.479], [58.306, 1.9, 0.387],\n104\t  [58.889, 1.599, 0.341], [59.411, 1.195, 0.294], [59.653, 0.806, 0.245], [59.695, 0.325, 0.245], [59.687, -0.063, 0.195],\n105\t];\n106\t/** near size of the measured coins (C05.scale = the default 05 coin size), capped by the gap to the next coin */\n107\tconst C05M_NEAR = (k: number): number => {\n108\t  const [ds, lat] = C05M[k];\n109\t  const nb = [C05M[k - 1], C05M[k + 1]].filter(Boolean).map(([d2, l2]) => Math.hypot(d2 - ds, l2 - lat));\n110\t  return Math.max(C05M[k][2], Math.min(C05.scale, 0.85 * Math.min(...nb)));\n111\t};\n112\t\n113\tfunction coins05(course: Course, add: (stage: StageId, s: number, lat: number, h?: number, extra?: Partial<CoinDef>) => void) {\n114\t  const a = course.stage('05');\n115\t  const sCp = course.marks['05_crest'];\n116\t  const extra = { scale: C05.scale, tilt: C05.tilt };\n117\t  const ss: number[] = [];\n118\t  // gameplay trail before the checkpoint ends 1 u behind Benny's checkpoint spot (never between him and the camera view)\n119\t  for (let s = sCp - 1; s > a.s0 + 6; s -= C05.preGap) ss.unshift(s);\n120\t  for (let k = 0, s = sCp + C05.first; s < a.s1 - 3; k++) { ss.push(s); s += Math.min(C05.gapMax, C05.gap0 + k * C05.gapGrow); }\n121\t  // latK < 1: the trail winds with the cyan core but stays inside its middle (the core half width is\n122\t  // ≥ 2 u), so the far coins converge on the VP like the ref instead of swinging out to the pink bands\n123\t  for (const s of ss) add('05', s, C05.latK * coreLateral(course, s), C05.h, extra);\n124\t}\n125\t\n126\texport function coinLayout(course: Course): CoinDef[] {\n127\t  const out: CoinDef[] = [];\n128\t  const add = (stage: StageId, s: number, lat: number, h = 0.9, extra: Partial<CoinDef> = {}) => out.push({ s, lat, h, stage, ...extra });\n129\t  const st = (id: StageId) => course.stage(id);\n130\t  // 03 — spiral trail ahead of Benny toward the drain\n131\t  { const a = st('03'); for (let i = 0; i < 9; i++) add('03', a.s0 + 6 + i * 2.7, 0.9 - i * 0.12); }\n132\t  // 04 — along the left edge of the slide\n133\t  { const a = st('04'); for (let i = 0; i < 8; i++) add('04', a.s0 + 9 + i * 3.6, -1.35); }\n134\t  // 05 — on the winding cyan core (see C05)\n135\t  coins05(course, add);\n136\t  // 06 — up and over the crest (left of centre like the ref)\n137\t  { const a = st('06'); const n = 18; for (let i = 0; i < n; i++) { const s = a.s0 + 4 + i * ((a.s1 - a.s0 - 6) / n); add('06', s, -1.3 + 0.7 * Math.sin(i * 0.4)); } }\n138\t  // 07 — winding trail, continuing down the plunge\n139\t  { const a = st('07'); const n = 24; for (let i = 0; i < n; i++) { const s = a.s0 + 6 + i * ((a.s1 - a.s0 - 10) / n); add('07', s, 1.0 * Math.sin(i * 0.5 + 1)); } }\n140\t  // 08 — S toward the platform\n141\t  { const a = st('08'); for (let i = 0; i < 8; i++) add('08', a.s0 + 3 + i * 1.9, -0.6 + 0.9 * Math.sin(i * 0.8)); }\n142\t  // 09 — arc along the left (inside of the bend, under the wave)\n143\t  { const a = st('09'); for (let i = 0; i < 9; i++) add('09', a.s0 + 1.5 + i * 1.7, -1.7 + i * 0.12); }\n144\t  // 10 — straight line into the towel tunnel\n145\t  { const a = st('10'); for (let i = 0; i < 5; i++) add('10', a.s0 + 1.5 + i * 2.0, -0.15); }\n146\t  if (!COINS05) return out;\n147\t  // coins05: keep every coin's bob phase, swap the 05 coins after the checkpoint for the measured arrangement (C05M)\n148\t  out.forEach((d, i) => { d.phase = i; });\n149\t  const sCp = course.marks['05_crest'];\n150\t  const first = out.findIndex((d) => d.stage === '05' && d.s > sCp);\n151\t  const kept = out.filter((d) => !(d.stage === '05' && d.s > sCp));\n152\t  const a5 = st('05');\n153\t  const meas: CoinDef[] = C05M.map(([ds, lat, scale], k) => ({\n154\t    s: sCp + ds, lat, h: C05.h, stage: sCp + ds < a5.s1 ? '05' : '06', scale: C05M_NEAR(k), tilt: C05.tilt, phase: first + k,\n155\t    far: [scale, ds],\n156\t  }));\n157\t  kept.splice(first, 0, ...meas);\n158\t  return kept;\n159\t}\n160\t\n161\texport interface CoinSystem {\n162\t  group: THREE.Group;\n163\t  defs: CoinDef[];\n164\t  collected: Uint8Array;\n165\t  /** returns number of coins picked up this frame */\n166\t  update(time: number, dt: number, bennyS: number, bennyLat: number): number;\n167\t  /** mark coins before s as collected (deterministic QA checkpoint state) or reset all */\n168\t  resetUntil(s: number): void;\n169\t}\n170\t\n171\texport function createCoins(course: Course): CoinSystem {\n172\t  const defs = coinLayout(course);\n173\t  const faceTex = canvasTexture(256, 256, (c, w, h) => {\n174\t    const g = c.createRadialGradient(w * 0.38, h * 0.32, 10, w / 2, h / 2, w * 0.55);\n175\t    g.addColorStop(0, '#ffe680');\n176\t    g.addColorStop(0.45, '#ffcf2a');\n177\t    g.addColorStop(1, '#e89200');\n178\t    c.fillStyle = g;\n179\t    c.beginPath(); c.arc(w / 2, h / 2, w / 2, 0, Math.PI * 2); c.fill();\n180\t    // raised inner rim: dark groove + bright lip\n181\t    c.lineWidth = 9;\n182\t    c.strokeStyle = '#c98200'; c.beginPath(); c.arc(w / 2 + 2, h / 2 + 2, w * 0.4, 0, Math.PI * 2); c.stroke();\n183\t    c.strokeStyle = '#fff0a0'; c.beginPath(); c.arc(w / 2 - 1, h / 2 - 1, w * 0.4, 0, Math.PI * 2); c.stroke();\n184\t    // embossed \"$\" drawn as vector strokes (font-independent: identical on every Android device):\n185\t    // light bevel up-left, dark bevel down-right, deep-gold glyph on top\n186\t    const dollar = (dx: number, dy: number, col: string, lw: number) => {\n187\t      c.save(); c.translate(dx, dy);\n188\t      c.strokeStyle = col; c.lineCap = 'round'; c.lineJoin = 'round';\n189\t      c.lineWidth = lw;\n190\t      c.beginPath();\n191\t      c.moveTo(166, 90);\n192\t      c.bezierCurveTo(150, 66, 90, 64, 90, 98);\n193\t      c.bezierCurveTo(90, 128, 166, 124, 166, 160);\n194\t      c.bezierCurveTo(166, 196, 104, 198, 88, 168);\n195\t      c.stroke();\n196\t      c.lineWidth = lw * 0.62;\n197\t      c.beginPath(); c.moveTo(128, 50); c.lineTo(128, 206); c.stroke();\n198\t      c.restore();\n199\t    };\n200\t    dollar(3, 4, '#7a3c00', 32); // drop shadow\n201\t    dollar(0, 0, '#b86400', 30); // dark outline\n202\t    dollar(0, 0, '#ffe55a', 18); // bright raised glyph\n203\t    dollar(-3, -3, '#fff8d0', 6); // top-left bevel highlight\n204\t  });\n205\t  // the cylinder cap's UVs run sideways once the coin is stood up (rotateX): turn the face art upright\n206\t  faceTex.center.set(0.5, 0.5);\n207\t  faceTex.rotation = -Math.PI / 2;\n208\t  // milled (ridged) gold edge, as on the ref coins\n209\t  const edgeTex = canvasTexture(256, 8, (c, w, h) => {\n210\t    for (let x = 0; x < w; x += 4) { c.fillStyle = (x / 4) % 2 ? '#c08000' : '#ffe070'; c.fillRect(x, 0, 4, h); }\n211\t  });\n212\t  const geo = new THREE.CylinderGeometry(0.5, 0.5, COINS05 ? C05LOOK.thick : 0.2, 48, 1);\n213\t  geo.rotateX(Math.PI / 2); // faces along ±Z\n214\t  // Gold is carried mostly by EMISSIVE art (blue ≈ 0) so the pink-white candy environment and the\n215\t  // Neutral tone mapping cannot wash it to pale peach (ref face ≈ #F4C400); a dark-gold metal base\n216\t  // keeps a reflective sheen on top.\n217\t  const side = new THREE.MeshStandardMaterial({ color: '#6a4a00', metalness: 0.75, roughness: 0.3, emissive: '#ffffff', emissiveMap: edgeTex, emissiveIntensity: 1.0 });\n218\t  const face = new THREE.MeshStandardMaterial({ map: faceTex, color: '#7a5200', metalness: 0.7, roughness: 0.3, emissive: '#ffffff', emissiveMap: faceTex, emissiveIntensity: 1.15 });\n219\t  let mats: THREE.Material[] = [side, face, face];\n220\t  if (COINS05 && face05) {\n221\t    const f05 = face05 as THREE.Texture;\n222\t    f05.center.set(0.5, 0.5);\n223\t    f05.rotation = faceTex.rotation; // same cap orientation as the default art\n224\t    const face5 = coin05Material(f05);\n225\t    mats = [coin05Material(edge05Texture()), face5, face5];\n226\t  }\n227\t  const mesh = new THREE.InstancedMesh(geo, mats, defs.length);\n228\t  mesh.frustumCulled = false;\n229\t  const group = new THREE.Group();\n230\t  group.name = 'coins';\n231\t  group.add(mesh);\n232\t  const collected = new Uint8Array(defs.length);\n233\t  const popT = new Float32Array(defs.length).fill(-1);\n234\t  const m = new THREE.Matrix4(), q = new THREE.Quaternion(), basis = new THREE.Matrix4();\n235\t  const p = new THREE.Vector3(), sc = new THREE.Vector3();\n236\t  const spin = new THREE.Quaternion(), axis = new THREE.Vector3();\n237\t  const tiltQ = new THREE.Quaternion(), xAxis = new THREE.Vector3(1, 0, 0);\n238\t  const back = new THREE.Vector3();\n239\t\n240\t  let lastS = -1e9; // Benny's s at the last update (coins05 far-scale)\n241\t  const place = (time: number) => {\n242\t    defs.forEach((d, i) => {\n243\t      const f = course.sample(d.s);\n244\t      const ph = d.phase ?? i;\n245\t      let scale = 1;\n246\t      if (collected[i]) {\n247\t        if (popT[i] < 0) { sc.setScalar(0); m.compose(p.set(0, -9999, 0), q.identity(), sc); mesh.setMatrixAt(i, m); return; }\n248\t        const k = THREE.MathUtils.clamp((time - popT[i]) / 0.35, 0, 1);\n249\t        if (k >= 1) { popT[i] = -1; sc.setScalar(0); m.compose(p.set(0, -9999, 0), q.identity(), sc); mesh.setMatrixAt(i, m); return; }\n250\t        scale = 1 + k * 0.8;\n251\t        p.copy(f.pos).addScaledVector(f.right, d.lat).addScaledVector(f.up, d.h + k * 1.6);\n252\t      } else {\n253\t        p.copy(f.pos).addScaledVector(f.right, d.lat).addScaledVector(f.up, d.h + 0.08 * Math.sin(time * 3 + ph));\n254\t      }\n255\t      back.copy(f.tan).negate();\n256\t      const right = new THREE.Vector3().crossVectors(f.up, back).normalize();\n257\t      basis.makeBasis(right, f.up, back);\n258\t      q.setFromRotationMatrix(basis);\n259\t      // tilted coins (05) only wobble a little so the face stays toward the camera\n260\t      spin.setFromAxisAngle(axis.set(0, 1, 0), (d.tilt ? 0.18 : 0.35) * Math.sin(time * 2.2 + ph * 0.7));\n261\t      q.multiply(spin);\n262\t      if (d.tilt) q.multiply(tiltQ.setFromAxisAngle(xAxis, -d.tilt));\n263\t      let base = d.scale ?? 1;\n264\t      if (d.far) {\n265\t        // coins05: the measured checkpoint size while at least (checkpoint distance − 1) ahead, full size 15 u closer\n266\t        const k = THREE.MathUtils.clamp((d.far[1] - 1 - (d.s - lastS)) / 15, 0, 1);\n267\t        base = d.far[0] + (base - d.far[0]) * k;\n268\t      }\n269\t      m.compose(p, q, sc.setScalar(base * scale * (collected[i] ? 1 - (time - popT[i]) / 0.35 : 1)));\n270\t      mesh.setMatrixAt(i, m);\n271\t    });\n272\t    mesh.instanceMatrix.needsUpdate = true;\n273\t  };\n274\t  place(0);\n275\t\n276\t  return {\n277\t    group,\n278\t    defs,\n279\t    collected,\n280\t    update(time, _dt, s, lat) {\n281\t      lastS = s;\n282\t      let picked = 0;\n283\t      for (let i = 0; i < defs.length; i++) {\n284\t        if (collected[i]) continue;\n285\t        const d = defs[i];\n286\t        const ds = d.s - s;\n287\t        if (ds < -2 || ds > 2) continue;\n288\t        if (Math.abs(ds) < 1.0 && Math.abs(d.lat - lat) < 1.25) {\n289\t          collected[i] = 1;\n290\t          popT[i] = time;\n291\t          picked++;\n292\t        }\n293\t      }\n294\t      place(time);\n295\t      return picked;\n296\t    },\n297\t    resetUntil(s) {\n298\t      lastS = s - 0.5;\n299\t      for (let i = 0; i < defs.length; i++) { collected[i] = defs[i].s < s ? 1 : 0; popT[i] = -1; }\n300\t      place(0);\n301\t    },\n302\t  };\n303\t}\n304\t", "tool_use_id": "toolu_01SjRaD24GE4LdJsZ1FKEHUP", "type": "tool_result"}], "role": "user"}, "parentUuid": "3bfa3af8-1214-48e3-a5e9-28329794505b", "permissionDecision": {"decision": "accept", "reasonType": "rule", "ruleSource": "cliArg", "source": "config"}, "promptId": "ac454479-370a-42c2-ab54-e334c92d8eef", "sessionId": "4504d324-f312-5957-a7e6-3580c7fc5f29", "sourceToolAssistantUUID": "3bfa3af8-1214-48e3-a5e9-28329794505b", "timestamp": "2026-11-17T01:16:15.478Z", "type": "user", "userType": "external", "uuid": "0bf0d35f-cfb7-40c9-935d-008cc87cfa3b", "version": "2.1.326"}
