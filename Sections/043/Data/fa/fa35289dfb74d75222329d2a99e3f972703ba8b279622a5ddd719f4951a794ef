ddles\n473\t  if (uOutro.x > 0.0 && s > uOutro.y - 2.0) {\n474\t    float n = vnoise(vec2(u * 3.0, s * 0.35)) * 0.7 + 0.3;\n475\t    if (n < uOutro.x * 1.15) discard;\n476\t  }\n477\t\n478\t  // ---- channel layout: winding cyan core between two hot-pink S-bands, cyan again outside ----\n479\t  float hw = vHalfW;\n480\t  float lat = u * hw;                         // lateral units in the ribbon frame\n481\t  // core centre: free drifting meander on 04/06/07 (freeK = 1); on 05 (freeK = 0) pinned to the\n482\t  // course's own S-meander, amplified (vCore = CORE_SWING · offset05), so the coins stay on cyan\n483\t  float freeK = vStyle.w;\n484\t  float sw = 1.0 - freeK;                     // weight of the 05 river look (1 on 05 only)\n485\t  float M = meander(s, hw) * freeK + vCore;\n486\t  float x = lat - M;                          // lateral units in the core's frame\n487\t  // 05: the pink bands swing a further ±1.05 u about the core (a stationary λ≈20 u S on top of the\n488\t  // course meander, in phase with it: left at s≈139.5 / y≈800, right at s≈149.7 / y≈680 on the locked\n489\t  // view), so they read as ≈2 clear S-bends to the VP (ref 05: ±100 px). A small 2nd harmonic skews\n490\t  // each bend so the S is not a plain sine. The coins (at coreLateral = M) stay ≥0.3 u inside the cyan.\n491\t  float sbend = sw * (1.05 * sin(s * 0.31 - 0.834) + 0.18 * sin(s * 0.62 + 0.6));\n492\t  float xb = x - sbend;                       // band frame (== x on 04/06/07)\n493\t\n494\t  // detail fade with distance (cells per pixel), keeps far water from shimmering\n495\t  float fwx = fwidth(x);\n496\t  float fws = fwidth(s);\n497\t  // (a noise cell must stay ≳6–8 px wide; the combed lines of ref 05 are 2–4 px apart in the\n498\t  // mid-ground, so fading earlier than this flattens the water into a plain fill)\n499\t  vec2 aa = vec2(1.0 - smoothstep(0.12, 0.26, max(fwx * 7.0, fws * 0.19)),\n500\t                 1.0 - smoothstep(0.09, 0.2, max(fwx * 17.0, fws * 0.42)));\n501\t  // hair-fine combed strands for close-up water (refs: dense parallel flow lines)\n502\t  float aaH = 1.0 - smoothstep(0.14, 0.3, fwx * 46.0);\n503\t  #ifdef LOW_Q\n504\t  aa.y = 0.0;\n505\t  aaH = 0.0;\n506\t  #endif\n507\t\n508\t  // two-phase flow-map advection of the strands (period 4 s; offset scales with stage speed)\n509\t  float ph0 = fract(uTime * 0.25);\n510\t  float ph1 = fract(uTime * 0.25 + 0.5);\n511\t  float w0 = 1.0 - abs(1.0 - 2.0 * ph0);\n512\t  // (04/06/07 strand texture; 05 has its own silk/swell field below)\n513\t  vec4 F = vec4(0.5, 0.0, 0.5, 0.5);\n514\t  if (freeK > 0.001) F = mix(strands(x, s - vSpeed * ph1 * 4.0 + 23.0, aa, sw), strands(x, s - vSpeed * ph0 * 4.0, aa, sw), w0);\n515\t  float v5 = s - uTime * uFlow05;             // 05 advected arc length (one constant speed: no shear)\n516\t\n517\t  // Benny parts the bands like a bow wave (vStyle.x, ref 05): just ahead of him they narrow and\n518\t  // swing outward, so the water at and behind him (the near field) is pure cyan; behind him they\n519\t  // continue only as thin streaks pushed out toward the foam banks\n520\t  // (05: the near rows only show lat ±2.3 behind Benny, so a light parting is enough there)\n521\t  float gate = 1.0, part = 0.0, near05 = 1.0;\n522\t  float db = s - uBenny.x;\n523\t  if (vStyle.x > 0.0) {\n524\t    // 05 (wave 4): the bands stay wide (≥75 %) and run in CLOSER (0.8× offset) beside Benny, so they\n525\t    // sweep past both his sides like ref 05 (pink beside the hat/body at y≈800–1000) instead of\n526\t    // parting out under the foam banks; full width/offset ≈14–20 u ahead\n527\t    float g05 = 0.75 + 0.25 * smoothstep(1.0, 20.0, db);\n528\t    float gOld = 0.4 + 0.6 * smoothstep(0.0, 4.5, db);\n529\t    gate = mix(1.0, mix(g05, gOld, freeK), vStyle.x);\n530\t    part = vStyle.x * hw * 0.3 * freeK * (1.0 - smoothstep(-1.0, 9.0, db));\n531\t    near05 = mix(1.0, 0.8 + 0.2 * smoothstep(2.0, 14.0, db), sw * vStyle.x);\n532\t  }\n533\t  float hwc = min(hw, 4.5);\n534\t  float aaw = fwidth(lat) * 0.85 + 0.01;      // ≈1 px edges: no lavender cyan/pink blend zone\n535\t  // flowing band edges (the advected strand texture). 05: only a soft travelling ripple, so the band\n536\t  // edges are clean S-curves instead of the torn/jagged combed edges of the old slab\n537\t  float pert = mix((vnoise(vec2(x * 0.9, v5 * 0.12 + 3.0)) - 0.5) * 0.3,\n538\t                   (F.z - 0.5) * 0.5 + (F.w - 0.5) * 0.22, freeK) * hwc * 0.22;\n539\t  // 05: the band shapes are carried downstream (a slow travelling wobble), so the pink S-sections\n540\t  // visibly flow and swirl even though the channel itself is fixed to the course meander\n541\t  float tv = s - uTime * vSpeed * 0.3;\n542\t  float wob = sw * hwc;\n543\t  float offL = hw * (vStyle.y * near05 + mix(0.03, 0.07, freeK) * sin(s * 0.13 + 1.7)) + part + wob * 0.05 * sin(tv * 0.42 + 1.1);\n544\t  float offR = hw * (vStyle.y * near05 + mix(0.03, 0.07, freeK) * sin(s * 0.11 + 4.2)) + part + wob * 0.05 * sin(tv * 0.37 + 3.9);\n545\t  float modA = mix(0.15, 0.4, freeK);         // 05: even band width (the ±40 % swell drew the slab)\n546\t  float wL = hw * vStyle.z * (1.0 + modA * sin(s * 0.19 + 0.4) + 0.08 * wob * sin(tv * 0.6)) * gate;\n547\t  float wR = hw * vStyle.z * (1.0 + modA * sin(s * 0.17 + 2.9) + 0.08 * wob * sin(tv * 0.55 + 2.0)) * gate;\n548\t  float brush = 0.0;\n549\t  if (freeK < 0.5) {\n550\t    float Mb = M + sbend;\n551\t    // 05 (wave 7) channel shape fitted to ref 05 (band centres back-projected through the locked camera,\n552\t    // lateral from the core): the river widens at s≈148–166 (the right band runs along the right bank at\n553\t    // s≈152–157, the left band bulges toward the core at s≈145–152 and swings out at s≈158–166), and the\n554\t    // right band runs ≈0.3 u closer to the core at s≈136–139. Stationary in s; 0 beyond s 180 (06 join).\n555\t    float fR = -0.3 * smoothstep(133.0, 136.0, s) * (1.0 - smoothstep(139.5, 142.0, s))\n556\t             + 1.9 * smoothstep(146.5, 154.0, s) * (1.0 - smoothstep(160.0, 168.0, s))\n557\t             - 0.9 * smoothstep(165.0, 170.0, s) * (1.0 - smoothstep(174.0, 180.0, s));\n558\t    float fL = -0.5 * smoothstep(143.0, 147.0, s) * (1.0 - smoothstep(151.0, 155.0, s))\n559\t             + 1.0 * smoothstep(154.0, 158.0, s) * (1.0 - smoothstep(168.0, 176.0, s));\n560\t    offL += sw * fL;\n561\t    offR += sw * fR;\n562\t    // 05 (wave 7): approaching Benny the two S-bands swing OUT to the banks and leave the frame at the\n563\t    // image sides (ref 05: the left band exits at y≈930 ≈ 3.5 u ahead of him, the right one at y≈1090\n564\t    // ≈ 0.8 u ahead); behind him only the two diagonal wake sweeps (below) carry pink. (Wave 5 glided\n565\t    // the bands in to his track ±1.42 u instead, which drew the two wide vertical pink sheets.)\n566\t    if (vStyle.x > 0.0 && uBenny.z > 0.0) {\n567\t      float k5 = sw * vStyle.x;\n568\t      offL += k5 * 2.0 * smoothstep(7.0, 2.5, db);\n569\t      offR += k5 * 1.6 * smoothstep(2.6, 0.4, db);\n570\t    }\n571\t    // keep both bands inside the water (the core swing pushes one toward the bank on each bend);\n572\t    // the band pressed against the bank thins a little instead of collapsing the cyan core\n573\t    // (smooth minimum: a hard min() put a visible corner in the band where the clamp starts)\n574\t    float roomL = Mb + hw - 0.5 - offL, roomR = hw - 0.5 - Mb - offR;\n575\t    wL = smin(wL, max(roomL, 0.6 * wL), 0.5);\n576\t    wR = smin(wR, max(roomR, 0.6 * wR), 0.5);\n577\t    offL = smin(offL, Mb + hw - wL - 0.5, 1.2);\n578\t    offR = smin(offR, hw - wR - 0.5 - Mb, 1.2);\n579\t    // brushed edges: each band edge is combed into pink / cyan strands along the flow (ref 05: the\n580\t    // ribbons fray into light streaks); crisp per-pixel strands, so no violet pink-over-cyan blend.\n581\t    // Faded out where a strand would be < ≈3 px wide (no shimmer in the far field)\n582\t    float bK = 11.0;\n583\t    brush = sw * (vnoise(vec2(xb * bK, v5 * 0.11 + 5.0)) - 0.5) * (1.0 - smoothstep(0.05, 0.12, fwx * bK));\n584\t  }\n585\t  float sdL = xb + offL + pert;\n586\t  float sdR = xb - offR + pert;\n587\t  float dL = abs(sdL);\n588\t  float dR = abs(sdR);\n589\t  float on = smoothstep(0.02, 0.2, gate);\n590\t  float pL = (1.0 - smoothstep(wL - aaw, wL + aaw, dL - brush * wL * 0.55)) * on;\n591\t  float pR = (1.0 - smoothstep(wR - aaw, wR + aaw, dR - brush * wR * 0.55)) * on;\n592\t  // a thin cyan thread splits a band into two streaks along some stretches (ref 05 mid-ground)\n593\t  float rimW = 0.05 * hwc + aaw;\n594\t  float thrW = 0.028 * hwc;\n595\t  float splitOn = smoothstep(0.55, 0.7, vnoise(vec2(s * 0.07, 13.0))) * mix(0.0, 1.0, freeK);\n596\t  float sL = (1.0 - smoothstep(thrW, thrW + aaw, abs(xb + offL + pert * 1.4 + 0.25 * wL * sin(s * 0.5)))) * splitOn;\n597\t  float sR = (1.0 - smoothstep(thrW, thrW + aaw, abs(xb - offR + pert * 1.4 - 0.25 * wR * sin(s * 0.45 + 1.0)))) * (1.0 - splitOn) * freeK;\n598\t  // only split bands that are wide enough (smooth ramp: a hard step cut the band across the flow)\n599\t  pL *= 1.0 - sL * smoothstep(rimW * 1.8, rimW * 2.8, wL);\n600\t  pR *= 1.0 - sR * smoothstep(rimW * 1.8, rimW * 2.8, wR);\n601\t  // ---- 05 (wave 8): one speed-streak field for the whole river (cyan + pink) ----\n602\t  // X = across-flow coordinate (units): ahead of Benny it follows the S-band midline, normalised by the band\n603\t  // spacing so the streaks stay parallel to the pink bands on every bend; behind him it fans out from his\n604\t  // track (÷(1 + 0.7·back)) like his wake, so the near streaks and sweeps spread to the bottom corners.\n605\t  float back = max(-db, 0.0);\n606\t  float cLc = -offL - pert, cRc = offR - pert;\n607\t  float hS = max(0.5 * (cRc - cLc), 0.6);\n608\t  float q = (xb - 0.5 * (cLc + cRc)) / hS;\n609\t  float nearW = uBenny.z > 0.0 ? sw * smoothstep(5.0, 0.5, db) : 0.0;\n610\t  float X = (lat - mix(M + sbend + 0.5 * (cLc + cRc), uBenny.y, nearW)) * mix(3.0 / hS, 1.0, nearW) / (1.0 + 0.7 * back);\n611\t  X += 0.05 * sin(v5 * 0.21 + X * 1.1);       // the streaks braid gently\n612\t  float fwX5 = fwidth(X);\n613\t  vec3 SS = vec3(0.0, 0.0, 0.5);\n614\t  if (sw > 0.001) {\n615\t    #ifndef WATER05\n616\t    SS = speedStreaks(X, v5, fwX5, fws);\n617\t    #endif\n618\t    // brushed band edges: over ≈±22 % of the band width the pink and cyan interleave as streaks along the\n619\t    // flow (ref 05: the ribbons fray into the current) instead of the hard 1-px cut of the flat slab\n620\t    float fLw = 0.13 * wL + aaw, fRw = 0.13 * wR + aaw;\n621\t    float eL = clamp((wL - dL) / (2.0 * fLw) + 0.5, 0.0, 1.0);\n622\t    float eR = clamp((wR - dR) / (2.0 * fRw) + 0.5, 0.0, 1.0);\n623\t    pL = mix(pL, smoothstep(0.4, 0.6, eL + (SS.z - 0.5) * 0.6) * on, sw);\n624\t    pR = mix(pR, smoothstep(0.4, 0.6, eR + (SS.z - 0.5) * 0.6) * on, sw);\n625\t  }\n626\t  // hair-thin pink filaments drifting through the cyan core (mid/far field only)\n627\t  float fil = 0.0;\n628\t  #ifndef LOW_Q\n629\t  float fc = hw * 0.18 * sin(s * 0.21 + 0.8);\n630\t  fil = (1.0 - smoothstep(0.025 * hwc, 0.025 * hwc + aaw, abs(x - fc + pert * 0.7)))\n631\t      * smoothstep(0.62, 0.78, vnoise(vec2(s * 0.09, 21.0))) * gate * aa.x * freeK;   // 05 core: pure cyan\n632\t  #endif\n633\t  float pinkM = max(max(pL, pR), fil);\n634\t  // 05 (wave 7) wake sweeps: two satin pink ribbons leave Benny's sides under the splash and fan out\n635\t  // DIAGONALLY toward the bottom corners (ref 05 runs: y1240 x≈571–595, y1280 134–238 / 586–669,\n636\t  // y1320 91–202 / 626–738 → centre ±(0.4 + 0.52·back) u from his track, half width ≈0.2 u, measured\n637\t  // through the locked camera). They taper in from 0.3 u behind him, so the water right under and\n638\t  // behind him stays cyan, and leave the frame at the bottom corners (≈2.5 u behind him).\n639\t  float wake = (vStyle.x > 0.0 && uBenny.z > 0.0) ? sw * vStyle.x : 0.0;\n640\t  float dlB = lat - uBenny.y;\n641\t  // (it01 measured: Benny's real waterline s sits ≈0.3 u ahead of the checkpoint row, so the fit is\n642\t  // re-solved against the rendered sweeps: centre 0.2 + 0.55·back, tapering in 0.7 → 1.4 u behind him)\n643\t  float cW = 0.2 + 0.55 * back + 0.05 * sin(v5 * 1.7 + sign(dlB) * 1.9) * back;\n644\t  float wW = (0.12 + 0.07 * back) * smoothstep(0.7, 1.4, back);\n645\t  float dW = abs(abs(dlB) - cW);\n646\t  // (wave 8) soft brushed edges from the same streak field (the sweeps lie along the fanning X lines,\n647\t  // so their edges fray into streaks along the sweep instead of the straight plank edges of wave 7)\n648\t  float fWw = 0.4 * wW + aaw;\n649\t  float eW = clamp((wW - dW) / (2.0 * fWw) + 0.5, 0.0, 1.0);\n650\t  float pW = smoothstep(0.38, 0.62, eW + (SS.z - 0.5) * 0.7) * wake * step(0.001, wW);\n651\t  float relW = clamp((cW - abs(dlB)) / max(wW, 1e-3), -1.0, 1.0);   // -1 outer edge .. +1 toward Benny\n652\t  float pMain = max(pL, pR);\n653\t  pinkM = max(pinkM, pW);\n654\t  // glossy rims: light-pink just inside each band edge, bright cyan just outside it\n655\t  float rimIn = max(pL * smoothstep(wL - rimW, wL - aaw, dL), pR * smoothstep(wR - rimW, wR - aaw, dR));\n656\t  float rimOut = max((1.0 - pL) * (1.0 - smoothstep(wL + aaw, wL + rimW * 1.6, dL)),\n657\t                     (1.0 - pR) * (1.0 - smoothstep(wR + aaw, wR + rimW * 1.6, dR))) * on;\n658\t  float rel = pL >= pR ? sdL / max(wL, 1e-3) : -sdR / max(wR, 1e-3);   // -1 outer edge .. +1 core side\n659\t  if (pW > pMain) {\n660\t    rel = relW;\n661\t    rimIn = max(rimIn, pW * smoothstep(wW * 0.6, wW - aaw, dW));\n662\t  }\n663\t  rimOut = max(rimOut, (1.0 - pinkM) * (1.0 - smoothstep(wW + aaw, wW + 0.08 + aaw, dW)) * wake * step(0.001, wW));\n664\t  vec3 N0 = normalize(vNormalW);\n665\t  if (!gl_FrontFacing) N0 = -N0;\n666\t  vec3 V = normalize(cameraPosition - vPosW);\n667\t  vec3 L = normalize(uLightDir);\n668\t  vec3 Hv = normalize(L + V);\n669\t  vec3 Lg = normalize(vTanW + N0 * 0.1);      // the bright tunnel end, far downstream\n670\t\n671\t  vec3 col = vec3(0.0);\n672\t  // =============== 04 / 06 / 07 surface (freeK = 1; unchanged look) ===============\n673\t  if (freeK > 0.001) {\n674\t    float h = F.x;\n675\t    float hair = 0.5;\n676\t    if (aaH > 0.0) {\n677\t      float sv = s - vSpeed * fract(uTime * 0.5) * 2.0;\n678\t      float hA = vnoise(vec2(x * 46.0 + F.w * 3.0, sv * 0.9));\n679\t      float hB = vnoise(vec2(x * 46.0 + F.w * 3.0, (sv + vSpeed) * 0.9 + 17.0));\n680\t      hair = mix(0.5, mix(hB, hA, 1.0 - abs(1.0 - 2.0 * fract(uTime * 0.5))), aaH);\n681\t    }\n682\t    // deep azure troughs → electric cyan → light-cyan crests (crests stay a minority of the area)\n683\t    vec3 cyanCol = mix(uCyanDeep, uCyan, smoothstep(mix(0.3, 0.22, freeK), mix(0.72, 0.62, freeK), h));\n684\t    cyanCol = mix(cyanCol, uCyanBright, smoothstep(mix(0.7, 0.64, freeK), 0.95, h) * mix(0.55, 0.7, freeK) + rimOut * 0.45);\n685\t    // satin ribbon: a soft light streak runs along each band, off-centre toward the core\n686\t    float satin = exp(-pow((rel - 0.3) * 2.2, 2.0));\n687\t    vec3 pinkCol = mix(uPinkDeep, uPink, smoothstep(0.3, 0.72, h + satin * 0.2));\n688\t    pinkCol = mix(pinkCol, uPinkLight, clamp(smoothstep(0.6, 0.92, h) * 0.7 + satin * 0.35 + rimIn * 0.45, 0.0, 1.0));\n689\t    col = mix(cyanCol, pinkCol, pinkM);\n690\t    col *= 0.88 + 0.24 * hair;\n691\t    vec3 streakCol = mix(vec3(0.6, 1.25, 1.6), vec3(1.6, 0.8, 1.6), pinkM);\n692\t    col += streakCol * smoothstep(0.82, 0.94, hair) * 0.3 * aaH;\n693\t\n694\t    // ---- glossy lighting ----\n695\t    #ifdef LOW_Q\n696\t    vec3 N = normalize(N0 + 0.25 * vec3(h - 0.5, 0.0, F.z - 0.5));\n697\t    #else\n698\t    float bumpAmt = 0.07 * (1.0 - smoothstep(0.1, 0.5, fws));\n699\t    vec3 N = bumpNormal(vPosW, N0, h * bumpAmt);\n700\t    #endif\n701\t    float nv = clamp(dot(N, V), 0.0, 1.0);\n702\t    float fres = pow(1.0 - nv, 4.0);\n703\t    vec3 R = reflect(-V, N);\n704\t    // tinted (not white) reflection so the glossy far water stays saturated, not pastel\n705\t    vec3 reflTint = mix(uCyanBright, uPinkLight, pinkM);\n706\t    vec3 refl = mix(reflTint, vec3(1.5), smoothstep(0.6, 1.0, R.y) * 0.5);\n707\t    col = mix(col, refl, fres * 0.22);\n708\t    float spec = pow(clamp(dot(N, Hv), 0.0, 1.0), 120.0);\n709\t    float sheen = pow(clamp(dot(R, L), 0.0, 1.0), 10.0);\n710\t    col += vec3(1.0) * spec * 1.2 + reflTint * sheen * 0.12;\n711\t    // glossy white-blue reflection of the bright tunnel end (refs 05–07): the light sits far\n712\t    // downstream, so its mirror image is a glitter path along the river toward the VP, broken into\n713\t    // streaks by the bump normals and the strand crests (never a flat milky sheet)\n714\t    float glit = pow(clamp(dot(R, Lg), 0.0, 1.0), 160.0);\n715\t    float glitMask = smoothstep(0.5, 0.88, h) * 0.75 + F.y * 0.6;\n716\t    col += mix(vec3(0.7, 1.1, 1.45), vec3(1.5, 0.85, 1.4), pinkM) * glit * glitMask * mix(0.9, 0.45, freeK);\n717\t    // advected glossy streak lines along the flow\n718\t    col += streakCol * F.y * 0.8;\n719\t\n720\t    // ---- foreground ripple crests: pixel-thin lines bowed upstream around the core, in short\n721\t    // segments, so the near water reads as moving glossy ripples, not soft horizontal bars\n722\t    float nearK = 1.0 - smoothstep(0.02, 0.05, fws);\n723\t    if (nearK > 0.0) {\n724\t      float ph = s * 4.2 - uTime * 6.0 + 0.2 * x * x + 1.6 * vnoise(vec2(lat * 0.7, s * 0.45));\n725\t      float q = fract(ph * 0.159155 - 0.25) - 0.5;              // 0 on a crest (sin = 1)\n726\t      float dpx = abs(q) / max(fwidth(ph * 0.159155), 1e-4);\n727\t      float crest = (1.0 - smoothstep(0.5, 1.8, dpx)) * smoothstep(0.52, 0.8, vnoise(vec2(lat * 2.6, s * 1.1 + 3.0)));\n728\t      col *= 1.0 - 0.14 * nearK * (0.5 - 0.5 * sin(ph));\n729\t      col += mix(vec3(0.9, 1.4, 1.7), vec3(1.7, 1.1, 1.7), pinkM) * crest * nearK * mix(0.9, 0.6, freeK);\n730\t    }\n731\t\n732\t    