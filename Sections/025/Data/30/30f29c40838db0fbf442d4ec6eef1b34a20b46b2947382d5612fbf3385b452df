nes note says what lives where and which are reachable now.", "type": "string"}, "content": {"description": "The content to write to the file", "type": "string"}, "file_path": {"description": "The absolute path to the file to write (must be absolute, not relative)", "type": "string"}}, "required": ["file_path", "content"], "type": "object"}, "name": "Write"}}, {"description": "Create a doc, or apply several operations to one doc atomically.", "name": "mcp__Claude_Docs__batch", "schema": {"description": "Create a doc, or apply several operations to one doc atomically.", "eager_input_streaming": true, "input_schema": {"properties": {"batch": {"type": "array"}, "container": {"properties": {"create": {"type": "object"}, "id": {"type": "string"}, "kind": {"type": "string"}}, "required": ["kind"], "type": "object"}, "opId": {"type": "string"}, "verbose": {"type": "boolean"}}, "type": "object"}, "name": "mcp__Claude_Docs__batch"}, "server": "Claude_Docs"}, {"description": "Docs guides: topic.instructions repeats the server instructions. Read it only if your client dropped them. Also topic.<name>, refusal.<code>. After a doc's birth → [\"topic.index\"].", "name": "mcp__Claude_Docs__guide", "schema": {"description": "Docs guides: topic.instructions repeats the server instructions. Read it only if your client dropped them. Also topic.<name>, refusal.<code>. After a doc's birth → [\"topic.index\"].", "eager_input_streaming": true, "input_schema": {"properties": {"items": {"description": "topic.<name> (instructions, index, editing, tabs, comments, charts, chart-definition, diagram, uploads, sharing, skill) or refusal.<code>; several per call is fine.", "type": "array"}}, "type": "object"}, "name": "mcp__Claude_Docs__guide"}, "server": "Claude_Docs"}, {"description": "Edit a tab's contents, rename a doc or tab, or change a stored value.", "name": "mcp__Claude_Docs__update", "schema": {"description": "Edit a tab's contents, rename a doc or tab, or change a stored value.", "eager_