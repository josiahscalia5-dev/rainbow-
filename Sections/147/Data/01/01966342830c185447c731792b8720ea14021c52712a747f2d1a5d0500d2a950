{"agentId": "aab010bb38c09ff18", "cwd": "/home/user/rainbow-/.claude/worktrees/agent-aab010bb38c09ff18", "entrypoint": "remote_mobile", "gitBranch": "ccr-61131b9d-uj0oqb", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Tunnel geometry generated from course-aligned \"tube paths\", so walls, rings and nozzles follow the\n3\t * 04 slide, the 06 arch and the full 07 plunge with no seams.\n4\t *  - courseTubePath:   tube centred on the course itself (chute, gold ring pipe)\n5\t *  - straightTubePath: tube on a low-pass-filtered axis of the course (05–07): the tunnel stays\n6\t *    straight with concentric rings converging to one vanishing point (refs 05/07) while the stream\n7\t *    winds inside it. Radius/depth adapt so the floor always stays below the winding stream, and the\n8\t *    axis converges exactly onto the course at both ends (04 pipe junction, 08 chamber inlet).\n9\t */\n10\timport * as THREE from 'three';\n11\timport type { Course } from './course';\n12\t\n13\texport interface Frame { pos: THREE.Vector3; tan: THREE.Vector3; up: THREE.Vector3; right: THREE.Vector3 }\n14\t\n15\texport interface TubePath {\n16\t  frame(s: number): Frame;\n17\t  radius(s: number): number;\n18\t  /** distance from the water point on the axis down to the tube bottom */\n19\t  depth(s: number): number;\n20\t}\n21\t\n22\texport function courseTubePath(course: Course, radius: (s: number) => number, depth: number | ((s: number) => number) = 0.9): TubePath {\n23\t  return {\n24\t    frame: (s) => course.sample(s),\n25\t    radius,\n26\t    depth: typeof depth === 'number' ? () => depth : depth,\n27\t  };\n28\t}\n29\t\n30\texport function straightTubePath(\n31\t  course: Course,\n32\t  s0: number,\n33\t  s1: number,\n34\t  opts: { window: number; taper: number; baseRadius: (s: number) => number; floorExtra?: (s: number) => number },\n35\t): TubePath {\n36\t  const ds = 0.5;\n37\t  const n = Math.ceil((s1 - s0) / ds) + 1;\n38\t  const S = (i: number) => Math.min(s1, s0 + i * ds);\n39\t  const axis: THREE.Vector3[] = [];\n40\t  const cp: THREE.Vector3[] = [];\n41\t  for (let i = 0; i < n; i++) cp.push(course.sample(S(i)).pos.clone());\n42\t  for (let i = 0; i < n; i++) {\n43\t    const s = S(i);\n44\t    const taper = THREE.MathUtils.smoothstep(s, s0, s0 + opts.taper) * (1 - THREE.MathUtils.smoothstep(s, s1 - opts.taper, s1));\n45\t    const W = opts.window * taper;\n46\t    const k = Math.round(W / ds);\n47\t    let x = 0, z = 0, wsum = 0;\n48\t    for (let j = i - k; j <= i + k; j++) {\n49\t      const jj = THREE.MathUtils.clamp(j, 0, n - 1);\n50\t      const w = k === 0 ? 1 : 1 - Math.abs(j - i) / (k + 1);\n51\t      x += cp[jj].x * w; z += cp[jj].z * w; wsum += w;\n52\t    }\n53\t    axis.push(new THREE.Vector3(x / wsum, cp[i].y, z / wsum));\n54\t  }\n55\t  // exact straight stretches (05 current): the axis is pulled onto the course's straight centre line\n56\t  // (foot of the perpendicular from the stream point), so the tunnel is truly straight — no yaw\n57\t  // wiggle, no roll — and the rings converge on one vanishing point. Blends in over 12 units after\n58\t  // the 04 junction; height/roll/radius/depth return to the 06 arch tube just past its foot (wRun),\n59\t  // the lateral position over the last ~20 units of the stretch (wXZ) so the hand-over to the\n60\t  // filtered 06 axis has no yaw kink and 06 itself is unchanged.\n61\t  const wRun = new Array<number>(n).fill(0);\n62\t  const wXZ = new Array<number>(n).fill(0);\n63\t  const runDepth = new Array<number>(n).fill(0);\n64\t  for (const r of course.straightAxes ?? []) {\n65\t    if (r.s1 <= s0 || r.s0 >= s1) continue;\n66\t    const ab = r.b.clone().sub(r.a);\n67\t    const ab2 = ab.lengthSq();\n68\t    for (let i = 0; i < n; i++) {\n69\t      const s = S(i);\n70\t      const wIn = THREE.MathUtils.smoothstep(s, r.s0, r.s0 + 12);\n71\t      const w = wIn * (1 - THREE.MathUtils.smoothstep(s, r.s1 - 6, r.s1 + 2));\n72\t      const wl = wIn * (1 - THREE.MathUtils.smoothstep(s, r.s1 - 18, r.s1 + 2));\n73\t      if (wl <= wXZ[i]) continue;\n74\t      wXZ[i] = wl;\n75\t      wRun[i] = w;\n76\t      runDepth[i] = r.floorDepth;\n77\t      const u = cp[i].clone().sub(r.a).dot(ab) / ab2;\n78\t      const onLine = r.a.clone().addScaledVector(ab, u);\n79\t      axis[i].x += (onLine.x - axis[i].x) * wl;\n80\t      axis[i].z += (onLine.z - axis[i].z) * wl;\n81\t      axis[i].y += (onLine.y - axis[i].y) * w;\n82\t    }\n83\t  }\n84\t  const WU = new THREE.Vector3(0, 1, 0);\n85\t  const frames: Frame[] = axis.map((p, i) => {\n86\t    const a = axis[Math.max(0, i - 2)], b = axis[Math.min(n - 1, i + 2)];\n87\t    const tan = b.clone().sub(a).normalize();\n88\t    const cu = course.sample(S(i)).up.clone().lerp(WU, wRun[i]); // no banking roll on straight stretches\n89\t    const up = cu.addScaledVector(tan, -cu.dot(tan)).normalize();\n90\t    const right = new THREE.Vector3().crossVectors(tan, up).normalize();\n91\t    return { pos: p, tan, up, right };\n92\t  });\n93\t  // radius/depth so the floor stays below the stream edges, dilated + smoothed for a steady tube\n94\t  const rawR: number[] = [], rawD: number[] = [], needR: number[] = [], needD: number[] = [];\n95\t  for (let i = 0; i < n; i++) {\n96\t    const s = S(i);\n97\t    const off = cp[i].clone().sub(frames[i].pos);\n98\t    const d = off.dot(frames[i].right);\n99\t    const X = Math.abs(d) + course.widthAt(s) / 2 + 0.25;\n100\t    const r = Math.max(opts.baseRadius(s), X + 0.7);\n101\t    rawR.push(r);\n102\t    rawD.push(Math.max(0.9, r - Math.sqrt(Math.max(0, r * r - X * X)) + 0.2));\n103\t    // straight stretches: also account for the stream's height above/below the (straight) axis point\n104\t    needR.push(X + 0.7);\n105\t    needD.push(r - Math.sqrt(Math.max(0, r * r - X * X)) + 0.2 - off.dot(frames[i].up));\n106\t  }\n107\t  const dilate = (arr: number[], k: number) => arr.map((_, i) => { let m = -Infinity; for (let j = i - k; j <= i + k; j++) m = Math.max(m, arr[THREE.MathUtils.clamp(j, 0, n - 1)]); return m; });\n108\t  const box = (arr: number[], k: number) => arr.map((_, i) => { let a = 0; for (let j = i - k; j <= i + k; j++) a += arr[THREE.MathUtils.clamp(j, 0, n - 1)]; return a / (2 * k + 1); });\n109\t  const R = box(dilate(rawR, 30), 16);\n110\t  const D = box(dilate(rawD, 30), 16);\n111\t  if (wRun.some((w) => w > 0)) {\n112\t    // on a straight stretch the tunnel keeps its own constant radius (the next stage's wider hall is\n113\t    // not dilated back into it) and the stream sits `floorDepth` above the tunnel bottom (wide current)\n114\t    const nR = box(dilate(needR, 30), 16);\n115\t    const nD = box(dilate(needD, 30), 16);\n116\t    for (let i = 0; i < n; i++) {\n117\t      const w = wRun[i];\n118\t      if (w <= 0) continue;\n119\t      R[i] += (Math.max(opts.baseRadius(S(i)), nR[i]) - R[i]) * w;\n120\t      D[i] += (Math.max(runDepth[i], nD[i], 0.9) - D[i]) * w;\n121\t    }\n122\t  }\n123\t  // optional extra floor depth (Screen 05 controlled test T2): lowers the tunnel centre by floorExtra(s)\n124\t  // without touching the radius, the stream or the frames; undefined = unchanged geometry\n125\t  if (opts.floorExtra) for (let i = 0; i < n; i++) D[i] += opts.floorExtra(S(i));\n126\t  const idx = (s: number) => {\n127\t    const x = THREE.MathUtils.clamp((s - s0) / ds, 0, n - 1);\n128\t    const i = Math.min(n - 2, Math.floor(x));\n129\t    return { i, f: x - i };\n130\t  };\n131\t  const lerpArr = (arr: number[], s: number) => { const { i, f } = idx(s); return arr[i] + (arr[i + 1] - arr[i]) * f; };\n132\t  return {\n133\t    frame(s) {\n134\t      const { i, f } = idx(s);\n135\t      const A = frames[i], B = frames[i + 1];\n136\t      const pos = A.pos.clone().lerp(B.pos, f);\n137\t      const tan = A.tan.clone().lerp(B.tan, f).normalize();\n138\t      const up = A.up.clone().lerp(B.up, f);\n139\t      up.addScaledVector(tan, -up.dot(tan)).normalize();\n140\t      return { pos, tan, up, right: new THREE.Vector3().crossVectors(tan, up).normalize() };\n141\t    },\n142\t    radius: (s) => lerpArr(R, s),\n143\t    depth: (s) => lerpArr(D, s),\n144\t  };\n145\t}\n146\t\n147\texport function tubeCenterAt(path: TubePath, s: number, out = new THREE.Vector3()) {\n148\t  const f = path.frame(s);\n149\t  return out.copy(f.pos).addScaledVector(f.up, path.radius(s) - path.depth(s));\n150\t}\n151\t\n152\texport interface TubeGeoOptions {\n153\t  radial?: number;\n154\t  step?: number;\n155\t  vScale?: number;\n156\t  /** angular range (radians, measured from the bottom) — default full circle */\n157\t  arc?: number;\n158\t  /** radius offset (negative = inset toward the axis) */\n159\t  inset?: number;\n160\t  /**\n161\t   * Store the front-face (outward) normal. The faces wind outward, so BackSide/DoubleSide materials\n162\t   * flip this to the inward normal and light the inside of the tube correctly. The legacy default\n163\t   * (false) stores -d, which those materials flip to point AWAY from the viewer (dot(N,V) <= 0 →\n164\t   * full fresnel, un-tinted pale reflections); kept only so the 02 chute / 04 pipe look is unchanged.\n165\t   */\n166\t  frontNormals?: boolean;\n167\t  /** also store the local tube frame per vertex (`tubeAxis`, `tubeUp`) for withTubeStrips('attribute') */\n168\t  axisAttr?: boolean;\n169\t  /**\n170\t   * wave 8: lateral stretch of the cross-section (1 = circle): the `right` component of every wall point is\n171\t   * multiplied by oval(s) (ref 05 rings are ovals ≈1.75 wider than tall), normals follow the ellipse\n172\t   */\n173\t  oval?: (s: number) => number;\n174\t}\n175\t\n176\texport function buildTubeGeometry(path: TubePath, s0: number, s1: number, o: TubeGeoOptions = {}): THREE.BufferGeometry {\n177\t  const radial = o.radial ?? 48;\n178\t  const step = o.step ?? 0.6;\n179\t  const vScale = o.vScale ?? 1;\n180\t  const arc = o.arc ?? Math.PI * 2;\n181\t  const ns = o.frontNormals ? 1 : -1;\n182\t  const rings = Math.max(2, Math.ceil((s1 - s0) / step) + 1);\n183\t  const pos = new Float32Array(rings * (radial + 1) * 3);\n184\t  const nor = new Float32Array(rings * (radial + 1) * 3);\n185\t  const uv = new Float32Array(rings * (radial + 1) * 2);\n186\t  const ax = o.axisAttr ? new Float32Array(rings * (radial + 1) * 3) : null;\n187\t  const au = o.axisAttr ? new Float32Array(rings * (radial + 1) * 3) : null;\n188\t  const c = new THREE.Vector3();\n189\t  const d = new THREE.Vector3();\n190\t  for (let i = 0; i < rings; i++) {\n191\t    const s = s0 + ((s1 - s0) * i) / (rings - 1);\n192\t    const f = path.frame(s);\n193\t    const r = path.radius(s) + (o.inset ?? 0);\n194\t    const ov = o.oval ? o.oval(s) : 1;\n195\t    c.copy(f.pos).addScaledVector(f.up, path.radius(s) - path.depth(s));\n196\t    for (let j = 0; j <= radial; j++) {\n197\t      const th = -Math.PI / 2 - arc / 2 + (j / radial) * arc; // centred on the bottom\n198\t      d.copy(f.right).multiplyScalar(Math.cos(th) * ov).addScaledVector(f.up, Math.sin(th));\n199\t      const k = i * (radial + 1) + j;\n200\t      if (ax && au) { f.tan.toArray(ax, k * 3); f.up.toArray(au, k * 3); }\n201\t      pos[k * 3] = c.x + d.x * r;\n202\t      pos[k * 3 + 1] = c.y + d.y * r;\n203\t      pos[k * 3 + 2] = c.z + d.z * r;\n204\t      if (ov !== 1) d.copy(f.right).multiplyScalar(Math.cos(th) / ov).addScaledVector(f.up, Math.sin(th)).normalize();\n205\t      nor[k * 3] = ns * d.x; nor[k * 3 + 1] = ns * d.y; nor[k * 3 + 2] = ns * d.z;\n206\t      uv[k * 2] = j / radial;\n207\t      uv[k * 2 + 1] = s / vScale;\n208\t    }\n209\t  }\n210\t  const idx: number[] = [];\n211\t  for (let i = 0; i < rings - 1; i++) {\n212\t    for (let j = 0; j < radial; j++) {\n213\t      const a = i * (radial + 1) + j, b = a + radial + 1;\n214\t      idx.push(a, b, a + 1, b, b + 1, a + 1);\n215\t    }\n216\t  }\n217\t  const g = new THREE.BufferGeometry();\n218\t  g.setAttribute('position', new THREE.BufferAttribute(pos, 3));\n219\t  g.setAttribute('normal', new THREE.BufferAttribute(nor, 3));\n220\t  g.setAttribute('uv', new THREE.BufferAttribute(uv, 2));\n221\t  if (ax && au) {\n222\t    g.setAttribute('tubeAxis', new THREE.BufferAttribute(ax, 3));\n223\t    g.setAttribute('tubeUp', new THREE.BufferAttribute(au, 3));\n224\t  }\n225\t  g.setIndex(idx);\n226\t  g.computeBoundingSphere();\n227\t  return g;\n228\t}\n229\t\n230\t/**\n231\t * Washer-tube ring collar (ref 05: \"flat gold band with a double contour\"): a broad FLAT inner band that\n232\t * barely stands off the wall, a dark groove, then a thin raised lip on the near edge (−z, the side the\n233\t * rider looks at) whose small camera-facing side catches a bright line. The protrusion is shallow on\n234\t * purpose: a deep collar shows a big camera-facing annulus (the old \"thick orange pipe\" look, 21% gold)\n235\t * and pokes through the stream where it hugs the wall (06 arch).\n236\t * Lathe around local Z; radial values are fractions of the tube radius, axial values are world units\n237\t * (the instance scales z by 1). Interior corners are duplicated so every facet keeps a crisp normal.\n238\t */\n239\texport function collarGeometry(depth = 0.022, lip = 0.012, width = 1.1, segments = 96): THREE.BufferGeometry {\n240\t  const w = width / 2;\n241\t  const d = depth;\n242\t  const lipW = Math.min(0.16, width * 0.15), groove = Math.min(0.07, width * 0.06);\n243\t  // traversed from +z to -z so LatheGeometry's faces/normals point INWARD (toward the tunnel axis)\n244\t  const prof: [number, number][] = [\n245\t    [1.03, w], [1 - d * 0.5, w], // far side (hidden from the rider)\n246\t    [1 - d, w - 0.05], // far chamfer\n247\t    [1 - d, -w + lipW + groove + 0.02], // the flat band\n248\t    [1 - d * 0.55, -w + lipW + groove * 0.5], // dark groove (recessed toward the wall)\n249\t    [1 - d - lip, -w + lipW], [1 - d - lip, -w + 0.05], // raised lip\n250\t    [1 - d * 0.35, -w], // lip's camera-facing side → thin bright contour\n251\t    [1.03, -w],\n252\t  ];\n253\t  const pts: THREE.Vector2[] = [];\n254\t  prof.forEach(([x, y], i) => {\n255\t    pts.push(new THREE.Vector2(x, y));\n256\t    if (i > 0 && i < prof.length - 1) pts.push(new THREE.Vector2(x, y)); // crisp facet normals\n257\t  });\n258\t  const g = new THREE.LatheGeometry(pts, segments);\n259\t  g.rotateX(Math.PI / 2); // lathe axis Y → tube axis Z\n260\t  return g;\n261\t}\n262\t\n263\t/**\n264\t * Ref 05 ring (wave 4): a ROUNDED gold band with a double contour — a thick half-round main band (the\n265\t * camera-facing body catches a bright highlight on its crown and falls to copper in its shadowed lower\n266\t * half) and, on the camera side (−z), a thin half-round lip separated by a narrow dark groove. Radial\n267\t * values are fractions of the ring radius (1 = wall), axial values world units. Lathe around local Z,\n268\t * traversed +z → −z so the faces point inward.\n269\t */\n270\texport function roundBandGeometry(height = 0.095, width = 0.78, lipHeight = 0.045, lipWidth = 0.26, groove = 0.07, segments = 96): THREE.BufferGeometry {\n271\t  const w = (width + groove + lipWidth) / 2;\n272\t  const yc = w - width / 2, a = width / 2;\n273\t  const yl = -w + lipWidth / 2, al = lipWidth / 2;\n274\t  const pts: THREE.Vector2[] = [];\n275\t  const dup = (x: number, y: number) => { pts.push(new THREE.Vector2(x, y), new THREE.Vector2(x, y)); };\n276\t  pts.push(new THREE.Vector2(1.03, w));\n277\t  dup(1.0, w);\n278\t  for (let i = 1; i < 12; i++) {\n279\t    const f = (i / 12) * Math.PI;\n280\t    pts.push(new THREE.Vector2(1 - height * Math.sin(f), yc + a * Math.cos(f)));\n281\t  }\n282\t  dup(1.0, yc - a);\n283\t  pts.push(new THREE.Vector2(1.0 - height * 0.04, yc - a - groove * 0.5));\n284\t  dup(1.0, yl + al);\n285\t  for (let i = 1; i < 7; i++) {\n286\t    const f = (i / 7) * Math.PI;\n287\t    pts.push(new THREE.Vector2(1 - lipHeight * Math.sin(f), yl + al * Math.cos(f)));\n288\t  }\n289\t  dup(1.0, -w);\n290\t  pts.push(new THREE.Vector2(1.03, -w));\n291\t  const g = new THREE.LatheGeom