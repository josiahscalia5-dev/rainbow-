from pathlib import Path
import subprocess as sp,json,datetime
p=Path.cwd(); repo=p/'repos/06'
def git(*a):return sp.check_output(['git','-C',str(repo),*a],text=True,stderr=sp.PIPE).strip()
c=json.loads((p/'first-source-06.json').read_text())
ref='refs/heads/'+c['branch'];base=c['retained']['commit']
initial=git('ls-remote','--heads','origin',ref).split()[0]
assert initial==git('rev-parse','HEAD')==c['commit']
assert git('ls-remote','--heads','origin','refs/heads/'+c['retained']['branch']).split()[0]==base
for k in ['src/game/Game.ts','src/characters/benny/knitCuff06.ts','src/characters/benny/runtime.ts']:
 assert (repo/k).read_bytes()==(p/'games/06'/k).read_bytes()
git('add','--sparse','--','src/game/Game.ts','src/characters/benny/knitCuff06.ts','src/characters/benny/runtime.ts')
git('diff','--cached','--check')
assert set(git('diff','--cached','--name-only').splitlines())=={'src/game/Game.ts','src/characters/benny/knitCuff06.ts','src/characters/benny/runtime.ts'}
git('commit','-qm','Use the fitted cuff only while Benny is in Screen 06')
c['initialSource']=initial;c['commit']=git('rev-parse','HEAD');c['sourceFiles']=git('diff','--name-only',base,'HEAD').splitlines();c['utc']=datetime.datetime.now(datetime.timezone.utc).isoformat()
git('push','origin','HEAD:'+ref);assert git('ls-remote','--heads','origin',ref).split()==[c['commit'],ref]
(p/'checkpoint-06.json').write_text(json.dumps(c,indent=2)+'\n');print(c['commit'])
