from pathlib import Path
import json,csv,hashlib,shutil
from PIL import Image
root=Path(__file__).resolve().parent;pkg=root/'payload'
outputs=json.loads((root/'compact-image-outputs.json').read_text());catalog=json.loads((root/'media-catalog.json').read_text());records=json.loads((root/'media-records.json').read_text())
oldroot=root/'superseded-review-encodings';oldroot.mkdir(exist_ok=True)
for alias in csv.DictReader((pkg/'05_REVIEW_RECORDS/OPENING_ROLE_COPIES.csv').open()):
 original=pkg/alias['opening_file'];dest=oldroot/alias['opening_file'];dest.parent.mkdir(parents=True,exist_ok=True);original.rename(dest)
focus={'04':{'forward-20'},'05':{'last-right-bend'},'06':{'hard-left','hard-right','crest-release'},'07':{'plunge-bottom'},'08':{'hard-right'}}
selected={r['sha'] for r in records if r['case'] and r['section'] in {'CLAUDIA_BEFORE','CODEX_NEW'} and r['kind']=='image' and (r['name'].rsplit('/',1)[-1]=='opening' or not r['case'].startswith('Previous_') and r['name'].rsplit('/',1)[-1] in focus[r['screen']])}
count=0;newsum=0
for h in selected:
 x=outputs[h]
 if x['pixelExact']:continue
 old=pkg/x['file'];new=old.with_suffix('.webp')
 if old.stem=='opening-repeat' and old.parent.name=='CLAUDIA_RETAINED':new=old.parent/'opening.webp'
 assert not new.exists(),new
 with Image.open(catalog[h]['local']) as pic:
  pic=pic.convert(x['sourceMode']);pic.save(new,'WEBP',lossless=True,method=4,exact=True)
 with Image.open(new) as checked:
  assert checked.size==(x['nativeWidth'],x['nativeHeight']) and hashlib.sha256(checked.convert(x['sourceMode']).tobytes()).hexdigest()==x['sourcePixelSHA256']
 with new.open('rb') as f:packsha=hashlib.file_digest(f,'sha256').hexdigest()
 dest=oldroot/x['file'];dest.parent.mkdir(parents=True,exist_ok=True);old.rename(dest)
 newsum+=new.stat().st_size-x['bytes']
 x.update(file=new.relative_to(pkg).as_posix(),encoding='pixel-exact lossless WebP at source dimensions',bytes=new.stat().st_size,packagedSHA256=packsha,pixelExact=True,meanAbsSourceRGBError=0.,p99AbsSourceRGBError=0.)
 (root/'compact-metrics-image'/(h+'.json')).write_text(json.dumps(x)+'\n');count+=1
(root/'compact-image-outputs.json').write_text(json.dumps(outputs,indent=2,ensure_ascii=False)+'\n')
print('Verified key opening and moving frames',len(selected),'upgraded',count,'additional bytes',newsum,flush=True)

