const fs=require('node:fs'),path=require('node:path'),{spawn}=require('node:child_process');
const {chromium}=require('playwright');const query=require('./queries.json')['07'];const dir=path.join(__dirname,'paddle-test');
function stream(label){
 const proc=spawn('ffmpeg',['-hide_banner','-v','error','-y','-f','image2pipe','-vcodec','mjpeg','-r','12','-i','pipe:0','-c:v','libx264','-threads','2','-preset','veryfast','-crf','17','-pix_fmt','yuv420p','-movflags','+faststart',path.join(dir,label+'-steering.mp4')],{stdio:['pipe','ignore','pipe']});
 let error='';proc.stderr.on('data',x=>error+=String(x));
 return {input:proc.stdin,done:new Promise((ok,bad)=>proc.on('exit',n=>n?bad(Error(error)):ok()))};
}
(async()=>{
 const browser=await chromium.launch({executablePath:'/usr/bin/chromium',args:['--use-angle=swiftshader','--enable-unsafe-swiftshader','--ignore-gpu-blocklist','--disable-background-networking']});
 try {
 const page=await browser.newPage({viewport:{width:324,height:576},deviceScaleFactor:1});
 await page.route('**/*',r=>['','127.0.0.1','localhost'].includes(new URL(r.request().url()).hostname)?r.continue():r.abort());
 await page.goto('http://127.0.0.1:5607/?qa=1&dpr=1&'+query,{timeout:110000});
 await page.waitForFunction(()=>window.__rainbow?.ready,null,{timeout:150000});await page.evaluate(()=>document.fonts.ready);
 await page.evaluate(()=>{
  const r=window.__rainbow;r.run(false);r.goto('07');r.unfreeze();r.setSteer(0);
  const obj=r.qa3d().scene.getObjectByName('m07_paddle2'),base=obj.material,trial=base.clone();trial.uniforms=base.uniforms;
  const token='smoothstep(0.970, 0.995, dot(normalize(cameraPosition - vW), normalize(uProjPos - vW)))';
  if(!base.fragmentShader.includes(token))throw Error('Paddle material changed');
  trial.fragmentShader=base.fragmentShader.replace(token,token.replace('0.970, 0.995','0.987, 0.998'));
  window.__dual={obj,base,trial};
 });
 const streams=[stream('CLAUDIA_BEFORE'),stream('CODEX_TEST')];const frames=[];
 try{
 for(let i=0;i<39;i++){
  frames.push(await page.evaluate(i=>{
   const r=window.__rainbow;const steer=i<5?0:i<15?1:i<29?-1:.4;r.setSteer(steer);if(i)r.step(5);
   const st=r.state();return {i,steer,stage:st.stage,s:st.s,lat:st.lat,hearts:st.hearts,cam:st.cam};
  },i));
  for(const [j,mode] of ['base','trial'].entries()){
   await page.evaluate(mode=>{const q=window.__dual;q.obj.material=q[mode];window.__rainbow.drawList()},mode);
   const img=await page.screenshot({type:'jpeg',quality:88,timeout:90000});
   if(!streams[j].input.write(img))await new Promise(ok=>streams[j].input.once('drain',ok));
  }
 }
 } finally {streams.forEach(e=>e.input.end());await Promise.all(streams.map(e=>e.done))}
 fs.writeFileSync(path.join(dir,'steering-clip.json'),JSON.stringify({fps:12,step:1/60,stepsPerFrame:5,frames},null,1));
 }finally{await browser.close()}
})().catch(e=>{console.error(e.stack);process.exitCode=1});
