from pathlib import Path
from datetime import datetime, timezone
import json,subprocess
v=Path.cwd();saved=json.load(open('heads.json'))
remote='https://github.com/josiahscalia5-dev/rainbow-.git'
raw=subprocess.check_output(['git','ls-remote','--heads',remote],text=True)
heads={k.removeprefix('refs/heads/'):val for val,k in (ln.split() for ln in raw.splitlines())}
protected={k:{**saved[k],'liveCommit':heads[saved[k]['branch']],'sameAsStart':heads[saved[k]['branch']]==saved[k]['commit']} for k in ['lead','04','04r','05','06','07','08']}
new={};checked=0
for sid in ['04','05','06','07','08','skill']:
 meta=json.load(open('base-'+sid+'.json'));br=meta['branch']
 g=['git','-C',str(v/'repos'/sid)];sha=subprocess.check_output(g+['rev-parse','HEAD'],text=True).strip()
 assert sha==heads[br]
 # Diff all retained paths at the protected tip. Only the experimental source, its derived assets and evidence may differ.
 paths=subprocess.check_output(g+['diff','--name-only',meta['base']['commit'],sha],text=True).splitlines()
 if sid!='skill':
  allowed=set(meta['paths'])
  if sid=='07':allowed.update(['assets/textures/match07/paddleShape07.json','assets/textures/match07/paddleWall07.png'])
  if sid=='05':allowed.add('assets/textures/env05/wall05SlotDetail.png')
  assert all(p in allowed or p.startswith('experiments/codex/'+sid+'/') for p in paths),(sid,paths)
  samples=v/'repos'/sid/'experiments/codex'/sid
  import hashlib
  manifest=json.load(open(samples/'sha256.json'))
  for name,expected in manifest.items():
   assert hashlib.sha256((samples/name).read_bytes()).hexdigest()==expected
  checked+=len(manifest)
 else:assert all(f=='AGENTS.md' or f.startswith('.agents/skills/rainbow-visual-motion-matcher/') for f in paths)
 new[sid]={'branch':br,'verifiedCommit':sha}
builds={}
for sid,log in {'04':'04.txt','05':'fitted-05.txt','06':'final-06.txt','07':'wallfit-07.txt','08':'08.txt'}.items():
 lines=(v/'build-logs'/log).read_text().splitlines()
 result=next(line for line in reversed(lines) if '✓ built in' in line)
 assert any('tsc --noEmit && vite build' in line for line in lines)
 builds[sid]={'sourceCommit':(v/('source-'+sid+'.txt')).read_text().strip(),'typecheck':'tsc --noEmit passed','releaseBuild':result.strip()}
(v/'protected-end.json').write_text(json.dumps({'timeUTC':datetime.now(timezone.utc).isoformat(),'protectedBranches':protected,'codexBranches':new,'artifactHashesVerified':checked,'portraitReviewAt393Pixels':json.loads((v/'portrait-check.json').read_text()),'productionBuilds':builds,'androidHardwareTest':'Pending physical-device frame-time and sustained-load measurements','remoteMediaDownloads':{sid:json.load(open(v/('lfs-checked-'+sid+'.json'))) for sid in ('04','05','06','07','08')}},indent=2)+'\n')
print('Protected tips',sum(r['sameAsStart'] for r in protected.values()),'of',len(protected),'Codex branches',len(new),'hashed files',checked)
