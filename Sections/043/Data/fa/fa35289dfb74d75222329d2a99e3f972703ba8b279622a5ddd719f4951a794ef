ater body: outer bank of each far bend (units from the axis; the floor chord is ≈6.53, foam rim outside) */\n26\tconst EXTENT_FAR = 6.25;\n27\t\n28\t/**\n29\t * Designed far path: lateral of the VISIBLE cyan core (units along ft.Rt, + = right) at virtual depth Z beyond the\n30\t * seam. Fitted to the reference core (between the two pink bands) back-projected through the locked 05 eye\n31\t * (f 1278 px, VP (500,479), eye 3.56 u above the far water plane): y 538 → core x 506–553 (Z≈24), 532 → 525–560\n32\t * (Z≈32), 526 → 529–565 (Z≈43), 511 → 513–561 (Z≈88), 508 → 518–555 (Z≈103), then back left into the VP:\n33\t * coins/core ≈505 at y 496 (Z≈215), ≈490 at y 490 (Z≈330). The first knots continue the real exit bend\n34\t * (route lateral ≈0.3 at Z≈6) straight into the right swing (the reference's dip to the left at y≈550 sits where\n35\t * the locked course has its exit bend, so it is not chased: that would add a wiggle at the seam).\n36\t */\n37\texport const FAR05_CORE: [number, number][] = [\n38\t  [8, 0.55], [12, 0.75], [17, 1.0], [24, 1.8], [32, 2.75], [43, 3.4], [60, 3.6], [88, 4.0], [110, 4.35], [140, 4.45],\n39\t  [175, 4.1], [212, 2.6], [260, 0.8], [310, -1.6], [350, -2.5], [400, -2.8],\n40\t];\n41\t\n42\tfunction smoothstep(a: number, b: number, x: number) {\n43\t  const t = Math.min(1, Math.max(0, (x - a) / (b - a)));\n44\t  return t * t * (3 - 2 * t);\n45\t}\n46\t/** same smooth minimum as the ribbon shader */\n47\tfunction smin(a: number, b: number, k: number) {\n48\t  const h = Math.max(k - Math.abs(a - b), 0) / k;\n49\t  return Math.min(a, b) - h * h * k * 0.25;\n50\t}\n51\t/** C¹ monotone-free cubic Hermite through knots (Catmull-Rom tangents, flat ends) */\n52\tfunction hermite(k: [number, number][], x: number) {\n53\t  const n = k.length;\n54\t  if (x <= k[0][0]) return k[0][1];\n55\t  if (x >= k[n - 1][0]) return k[n - 1][1];\n56\t  let i = 0;\n57\t  while (x > k[i + 1][0]) i++;\n58\t  const tan = (j: number) => (j === 0 || j === n - 1 ? 0 : (k[j + 1][1] - k[j - 1][1]) / (k[j + 1][0] - k[j - 1][0]));\n59\t  const [x0, p0] = k[i], [x1, p1] = k[i + 1];\n60\t  const h = x1 - x0, t = (x - x0) / h, t2 = t * t, t3 = t2 * t;\n61\t  return (2 * t3 - 3 * t2 + 1) * p0 + (t3 - 2 * t2 + t) * h * tan(i) + (-2 * t3 + 3 * t2) * p1 + (t3 - t2) * h * tan(i + 1);\n62\t}\n63\t\n64\t/** one row of the river layout, all laterals in units from the tunnel axis along ft.Rt */\n65\texport interface FarRiverRow {\n66\t  /** route (water body) centre */\n67\t  xB: number;\n68\t  /** water body half width */\n69\t  hw: number;\n70\t  /** left / right pink band centre and half width */\n71\t  cL: number; wL: number; cR: number; wR: number;\n72\t  /** visible cyan core centre (between the bands) — flow lines and the far coins follow it */\n73\t  core: number;\n74\t}\n75\t\n76\t/**\n77\t * The real 05 ribbon's band layout (waterRibbon.ts FRAG, 05 block with sw = 1, freeK = 0, Benny far away,\n78\t * time-dependent wobble/noise left out) for a route centre xB, half width hw, core swing M (from the route\n79\t * centre) and band S offset sb, at arc length s (only feeds the slow sin() modulations).\n80\t */\n81\texport function bandLayout(xB: number, hw: number, M: number, sb: number, s: number): FarRiverRow {\n82\t  const Mb = M + sb;\n83\t  let offL = hw * (0.62 + 0.03 * Math.sin(s * 0.13 + 1.7));\n84\t  let offR = hw * (0.62 + 0.03 * Math.sin(s * 0.11 + 4.2));\n85\t  let wL = hw * 0.19 * (1 + 0.15 * Math.sin(s * 0.19 + 0.4));\n86\t  let wR = hw * 0.19 * (1 + 0.15 * Math.sin(s * 0.17 + 2.9));\n87\t  const roomL = Mb + hw - 0.5 - offL, roomR = hw - 0.5 - Mb - offR;\n88\t  wL = smin(wL, Math.max(roomL, 0.6 * wL), 0.5);\n89\t  wR = smin(wR, Math.max(roomR, 0.6 * wR), 0.5);\n90\t  offL = smin(offL, Mb + hw - wL - 0.5, 1.2);\n91\t  offR = smin(offR, hw - wR - 0.5 - Mb, 1.2);\n92\t  const cL = xB + Mb - offL, cR = xB + Mb + offR;\n93\t  return { xB, hw, cL, wL, cR, wR, core: 0.5 * (cL + wL + cR - wR) };\n94\t}\n95\t\n96\t/** the ribbon shader's 05 band S (sbend) */\n97\tconst sbend05 = (s: number) => 1.05 * Math.sin(s * 0.31 - 0.834) + 0.18 * Math.sin(s * 0.62 + 0.6);\n98\t\n99\texport interface FarRiverLayout {\n100\t  row(Z: number): FarRiverRow;\n101\t  /** half chord of the tube floor at the water level */\n102\t  chord: number;\n103\t}\n104\t\n105\t/**\n106\t * Far design row for a water-body centre xB: the body hugs the outer wall of each bend (half width\n107\t * EXTENT_FAR − |xB|); the two pink bands are thin lines near the banks (ref 05 far field: 3–10 px bands, the cyan\n108\t * core fills the river), the inner-bank band sits a little further in.\n109\t */\n110\tfunction designFromXB(xB: number, Z: number): FarRiverRow {\n111\t  const hw = EXTENT_FAR - Math.sqrt(xB * xB + 0.09);\n112\t  const bend = Math.min(1, Math.abs(xB) / 2.5);\n113\t  const aIn = 0.25 + 0.2 * bend, aOut = 0.25 - 0.08 * bend;\n114\t  const aL = xB >= 0 ? aIn : aOut, aR = xB >= 0 ? aOut : aIn;\n115\t  const w = Math.min(0.65, Math.max(0.26, 0.13 * hw)) * (1 - 0.35 * smoothstep(60, 200, Z));\n116\t  const cL = xB - hw * (1 - aL), cR = xB + hw * (1 - aR);\n117\t  return { xB, hw, cL, wL: w, cR, wR: w, core: 0.5 * (cL + cR) };\n118\t}\n119\t\n120\t/**\n121\t * W10 (?water05=1) far path: lateral of the visible cyan core (units along ft.Rt). Starts where the W10 ribbon hands\n122\t * over at the seam (core held at −0.3 u, see coreShiftW10) and climbs smoothly up-right like the approved river\n123\t * (core ≈ 504 px at y 540, ≈ 523 at y 522, ≈ 535 at y 510 → Z ≈ 24 / 55 / 100 at the locked eye), then swings back\n124\t * left into the vanishing point (as FAR05_CORE beyond Z 140).\n125\t */\n126\texport const FAR05_CORE_W10: [number, number][] = [\n127\t  [0, -0.3], [8, 0.2], [16, 0.75], [24, 1.25], [32, 1.8], [43, 2.45], [60, 3.1], [88, 3.7], [110, 4.05], [140, 4.3],\n128\t  [175, 4.0], [212, 2.6], [260, 0.8], [310, -1.4], [350, -2.2], [400, -2.5],\n129\t];\n130\t\n131\t/**\n132\t * Test S1 (?fars05=1, user 2026-11-16: \"the far river must wind in continuous S-curves all the way into the golden\n133\t * light\"). ONE factor: the far river's lateral path. Measured on the approved image (qa/pilot05/wave10/\n134\t * FAR_RIVER_ANALYSIS.md, far Z = depth beyond the seam): left dip −0.8…−2.5 u at Z 6–17, +0.5…+0.7 at Z 24–33,\n135\t * +3.3…+3.9 at Z 44–58, right peak +4.6 at Z≈77, coins ≈ +1.0 at Z 215 and −3.2 at Z 360. FAR05_CORE and\n136\t * FAR05_CORE_W10 skip the left dip (one long swing right → reads as a single bend into a blob). The S variants\n137\t * add it — gentler in the default variant, whose seam sits at +1.2 u (the real exit bend), so the hand-over has no\n138\t * hook — and keep the right peak and the return left into the light. Seam blend, banks, bands, coins untouched.\n139\t */\n140\texport const FARS05: boolean = (() => {\n141\t  try {\n142\t    return typeof location !== 'undefined' && new URLSearchParams(location.search).get('fars05') === '1';\n143\t  } catch {\n144\t    return false;\n145\t  }\n146\t})();\n147\texport const FAR05_CORE_S: [number, number][] = [\n148\t  [8, 0.35], [16, -0.9], [24, -0.5], [34, 0.9], [46, 2.6], [60, 3.7], [80, 4.5], [110, 4.2], [140, 3.0], [175, 1.7],\n149\t  [215, 1.0], [260, -0.6], [310, -2.4], [350, -3.0], [400, -3.0],\n150\t];\n151\texport const FAR05_CORE_W10_S: [number, number][] = [\n152\t  [0, -0.3], [6, -0.9], [14, -1.8], [22, -1.2], [32, 0.4], [44, 2.2], [60, 3.6], [80, 4.5], [110, 4.2], [140, 3.0],\n153\t  [175, 1.7], [215, 1.0], [260, -0.6], [310, -2.4], [350, -3.0], [400, -3.0],\n154\t];\n155\t\n156\t/**\n157\t * W10 far design row: the water body spans the whole floor chord (foam rim at the wall), the two satin bands run\n158\t * BESIDE the winding core (approved far field: bands ≈ 20 px wide, 120 px apart at y 540, deep violet water between\n159\t * each band and its bank) instead of as thin lines on the banks of a narrow body hugging the outer wall.\n160\t */\n161\tfunction designW10(Z: number, chord: number): FarRiverRow {\n162\t  const hw = chord - 0.35;\n163\t  const core = Math.max(-hw + 1.2, Math.min(hw - 1.2, hermite(FARS05 ? FAR05_CORE_W10_S : FAR05_CORE_W10, Z)));\n164\t  const sep = 3.9 - 0.9 * smoothstep(60, 260, Z);\n165\t  const w = 0.85 - 0.3 * smoothstep(40, 250, Z);\n166\t  const cL = Math.max(-hw + w + 0.3, core - sep), cR = Math.min(hw - w - 0.3, core + sep);\n167\t  return { xB: 0, hw, cL, wL: w, cR, wR: w, core };\n168\t}\n169\t\n170\t/**\n171\t * Layout of the far river at virtual depth Z. For small Z it is the REAL ribbon exactly as the eye would see it\n172\t * there without the far section: at the seam the route is in its exit bend (heading ≈26° off the axis), so a\n173\t * screen row cuts the ribbon diagonally — each band centre / bank edge curve l(s) of the real ribbon is intersected\n174\t * with the row (axial = Z), widths divided by cos(heading). It blends (Z 2 → 10) into the designed FAR05_CORE path.\n175\t */\n176\texport function farRiverLayout(course: Course, ft: ForcedTunnel, level: number): FarRiverLayout {\n177\t  const q = new THREE.Vector3();\n178\t  const at = (s: number, l: number) => {\n179\t    const f = course.sample(s);\n180\t    q.copy(f.pos).addScaledVector(f.right, l).sub(ft.c0);\n181\t    return { ax: q.dot(ft.T), x: q.dot(ft.Rt), rx: f.right.dot(ft.Rt) };\n182\t  };\n183\t  // the real ribbon's band layout at s, relative to the route centre (ribbon frame, vCore = coreLateral)\n184\t  const relLay = (s: number) => bandLayout(0, course.widthAt(s) / 2, coreLateral(course, s) + coreShiftW10(course, s), sbend05(s), s);\n185\t  const cross = (Z: number, lOf: (s: number) => number) => {\n186\t    let a = ft.sF - 8, b = ft.sF + 16;\n187\t    for (let i = 0; i < 36; i++) { const m = 0.5 * (a + b); if (at(m, lOf(m)).ax < Z) a = m; else b = m; }\n188\t    const s = 0.5 * (a + b), p = at(s, lOf(s));\n189\t    return { s, x: p.x, rx: Math.max(0.3, p.rx) };\n190\t  };\n191\t  const realRow = (Z: number): FarRiverRow => {\n192\t    const eL = cross(Z, (s) => -course.widthAt(s) / 2), eR = cross(Z, (s) => course.widthAt(s) / 2);\n193\t    const bl = cross(Z, (s) => relLay(s).cL), br = cross(Z, (s) => relLay(s).cR);\n194\t    const wL = relLay(bl.s).wL / bl.rx, wR = relLay(br.s).wR / br.rx;\n195\t    return { xB: 0.5 * (eL.x + eR.x), hw: 0.5 * (eR.x - eL.x), cL: bl.x, wL, cR: br.x, wR, core: 0.5 * (bl.x + wL + br.x - wR) };\n196\t  };\n197\t  const chordW10 = Math.sqrt(Math.max(0, ft.R * ft.R - level * level)) * 0.995;\n198\t  const designRow = (Z: number): FarRiverRow => {\n199\t    if (WATER05) return designW10(Z, chordW10);\n200\t    const target = hermite(FARS05 ? FAR05_CORE_S : FAR05_CORE, Z);\n201\t    let a = -5, b = 5;\n202\t    for (let i = 0; i < 36; i++) { const m = 0.5 * (a + b); if (designFromXB(m, Z).core < target) a = m; else b = m; }\n203\t    return designFromXB(0.5 * (a + b), Z);\n204\t  };\n205\t  const chord = Math.sqrt(Math.max(0, ft.R * ft.R - level * level)) * 0.995;\n206\t  return {\n207\t    chord,\n208\t    row(Z) {\n209\t      const w = smoothstep(2, 10, Z);\n210\t      if (w <= 0) return realRow(Z);\n211\t      const d = designRow(Z);\n212\t      if (w >= 1) return d;\n213\t      const r = realRow(Math.min(Z, 8));\n214\t      const o = {} as FarRiverRow;\n215\t      for (const k of Object.keys(d) as (keyof FarRiverRow)[]) o[k] = r[k] + (d[k] - r[k]) * w;\n216\t      return o;\n217\t    },\n218\t  };\n219\t}\n220\t\n221\t/**\n222\t * The far river surface in the virtual tunnel: one row per screen step (uniform in 1/depth, like the far wall),\n223\t * spanning the whole tube floor chord at `level` so it covers the real ribbon's continuation behind the seam.\n224\t * Columns: 3 over each bank, `cols` over the water body (whose centre/width change per row); the body has the\n225\t * ribbon's trough profile (EDGE_LIFT·|u|³) so it lands on the real ribbon at the seam, the banks sit a little\n226\t * higher (foam rims). Attributes for farRiverMaterial: aRivLat (lateral, units from the axis), aRivA (xB, hw,\n227\t * cL, cR), aRivB (wL, wR, core, Z), fgExtra (virtual − real depth). Morph \"open\": dropped below the real tube\n228\t * bottom (as the old chord), so the ride into 06 is untouched.\n229\t */\n230\texport function farRiverGeometry(ft: ForcedTunnel, lay: FarRiverLayout, level: number, cols = 16, steps = 120): THREE.BufferGeometry {\n231\t  const bank = 3;\n232\t  const per = cols + 1 + 2 * bank;\n233\t  const rows = steps + 1;\n234\t  const n = rows * per;\n235\t  const pos = new Float32Array(n * 3), nor = new Float32Array(n * 3), uv = new Float32Array(n * 2);\n236\t  const lat = new Float32Array(n), A = new Float32Array(n * 4), B = new Float32Array(n * 4), ext = new Float32Array(n), opn = new Float32Array(n * 3);\n237\t  const o = new THREE.Vector3(), p = new THREE.Vector3(), cr = new THREE.Vector3();\n238\t  const ch = lay.chord;\n239\t  for (let i = 0; i < rows; i++) {\n240\t    const t = i / steps;\n241\t    const Dv = 1 / (1 / ft.D0 - t * (1 / ft.D0 - 1 / (ft.D0 + ft.zEnd)));\n242\t    const Z = Math.max(0, Dv - ft.D0);\n243\t    const z = ft.zOf(Z);\n244\t    const sReal = ft.sF + z;\n245\t    const fr = ft.path.frame(sReal);\n246\t    tubeCenterAt(ft.path, sReal, cr);\n247\t    const rr = ft.path.radius(sReal);\n248\t    const r = lay.row(Z);\n249\t    const e0 = Math.max(-ch + 0.05, r.xB - r.hw), e1 = Math.min(ch - 0.05, r.xB + r.hw);\n250\t    for (let j = 0; j < per; j++) {\n251\t      let x: number, h: number;\n252\t      if (j < bank) { const f = j / bank; x = -ch + (e0 + ch) * f; h = EDGE_LIFT + 0.1 * Math.sin(Math.PI * f); }\n253\t      else if (j > bank + cols) { const f = (j - bank - cols) / bank; x = e1 + (ch - e1) * f; h = EDGE_LIFT + 0.1 * Math.sin(Math.PI * f); }\n254\t      else {\n255\t        const f = (j - bank) / cols; x = e0 + (e1 - e0) * f;\n256\t        const u = Math.min(1, Math.abs(x - r.xB) / Math.max(0.5, r.hw));\n257\t        h = EDGE_LIFT * u * u * u;\n258\t      }\n259\t      o.copy(ft.Rt).multiplyScalar(x).addScaledVect