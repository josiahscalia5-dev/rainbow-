.tubes.add(buildWallLids(perfPath, 0, 0, ringSpacing, lidMat, { positions: lids0607, angleDeg: 18, droopDeg: 20, size: 1.7, thickness: 0.42, stretch: 1.3, sink: 0.12, skip: lidClear }));\n324\t\n325\t  // ---- 05 far tunnel (forced perspective, calibrated for the locked 05 checkpoint eye) ----\n326\t  {\n327\t    // the checkpoint eye, exactly as RideCamera places it on the straight (cameraRig.ts, '05' block, lat 0)\n328\t    const sC = course.marks['05_crest'];\n329\t    const p5 = STAGE_CAM['05']!;\n330\t    const af = perfPath.frame(sC);\n331\t    const T = af.tan.clone();\n332\t    const U = new THREE.Vector3(0, 1, 0).addScaledVector(T, -T.y).normalize();\n333\t    const Rt = new THREE.Vector3().crossVectors(T, U).normalize();\n334\t    const water = course.sample(sC).pos.clone();\n335\t    const off = water.clone().sub(af.pos).dot(Rt);\n336\t    const dz = p5.deadZone ?? 1;\n337\t    const follow = p5.latFollow * (1 - Math.exp(-(off * off) / (dz * dz)));\n338\t    const eye = water.addScaledVector(T, -p5.back).addScaledVector(U, p5.up).addScaledVector(Rt, -off * (1 - follow));\n339\t    // one ring per knot: virtual depth of ring n (ref 05 radii → depths 86,124,160,196,234,276,322,374)\n340\t    const D0 = tubeCenterAt(perfPath, sF05).sub(eye).dot(T);\n341\t    const ringDv = [86, 124, 160, 196, 234, 276, 322, 374];\n342\t    const knots: [number, number][] = [[0, 0], ...ringDv.map((d, i) => [(i + 1) * bay05, Math.max(d - D0, (i + 1) * bay05)] as [number, number])];\n343\t    const zEnd = 430 - D0;\n344\t    const ft = new ForcedTunnel(perfPath, sF05, eye, 6, zEnd, knots, T);\n345\t    const uEnd = ft.uOfZ(zEnd);\n346\t    // walls: same pressed metal, slot rows continue (uv.y = sF + u), distance glow by virtual depth\n347\t    const farWallMat = withTubeStrips(perforatedMetal({ ...wall05, virtualDepth: true }), strips05, 'attribute', 'wall05v');\n348\t    const farWall = new THREE.Mesh(ft.geometry(64, 80), farWallMat);\n349\t    // the far stream (flat chord a