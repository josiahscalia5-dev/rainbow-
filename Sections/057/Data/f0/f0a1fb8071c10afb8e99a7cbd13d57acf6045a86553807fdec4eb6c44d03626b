from pathlib import Path
from PIL import Image
from datetime import datetime,timezone
import hashlib,io,json,subprocess as sp
root=Path(__file__).resolve().parent
folder=root/'from-original-github';folder.mkdir(exist_ok=True)
repo=folder/'source.git';url='https://github.com/josiahscalia5-dev/rainbow-.git'
def run(args,**kw):return sp.run(args,check=True,stdout=sp.PIPE,stderr=sp.PIPE,**kw).stdout
if not repo.exists():
    run(['git','init','--bare',str(repo)]);run(['git','--git-dir='+str(repo),'remote','add','origin',url])
git=['git','--git-dir='+str(repo)]
sources={s:json.loads((root/('checkpoint-'+s+'.json')).read_text())['retained'] for s in ['04','05','06','07','08']}
before=run([*git,'ls-remote','--heads','origin',*[x['branch'] for x in sources.values()]]).decode().splitlines()
remote={ref.removeprefix('refs/heads/'):c for c,ref in map(str.split,before)}
assert all(remote[x['branch']]==x['commit'] for x in sources.values())
refspecs=['refs/heads/'+x['branch']+':refs/heads/source-'+s for s,x in sources.items()]
run([*git,'-c','protocol.version=2','fetch','--quiet','--no-tags','--filter=blob:none','--depth=1','origin',*refspecs])
report={}
for s,source in sources.items():
    local=root if s=='06' else root/'round2'
    bas=json.loads((root/'baseline.json' if s=='06' else local/('baseline-'+s+'.json')).read_text());art=bas['approved'];path=art['path'];commit=source['commit']
    assert run([*git,'rev-parse','refs/heads/source-'+s]).decode().strip()==commit
    manifest=run([*git,'show',commit+':scripts/reference.sha256']).decode()
    entries={parts[1].lstrip('*'):parts[0] for line in manifest.splitlines() if line.strip() and not line.startswith('#') for parts in [line.split(maxsplit=1)]}
    raw=run([*git,'show',commit+':'+path])
    lfs=raw.startswith(b'version https://git-lfs.github.com/spec/v1')
    if lfs:raw=run([*git,'-c','lfs.storage='+str(folder/'asset-lfs'),'lfs','smudge','--',path],input=raw)
    digest=hashlib.sha256(raw).hexdigest()
    assert digest==art['sha256']==entries[path]
    used=Path('/tmp/rainbow-final-fidelity.RuUP0xJ2/repos')/s/'experiments/codex'/('fidelity-'+s)/'APPROVED.jpg'
    assert raw==used.read_bytes()==(local/'games'/s/path).read_bytes()
    phone=Path('/workspace/library-files/Rainbow-Nov19-Worlds-in-Motion')/s/('S'+s+'-APPROVED.jpg')
    assert phone.read_bytes()==raw
    im=Image.open(io.BytesIO(raw));im.load();assert im.size==(864,1536)
    dest=folder/path;dest.parent.mkdir(exist_ok=True,parents=True);dest.write_bytes(raw)
    report[s]={'retained':source,'path':path,'gitBlob':run([*git,'rev-parse',commit+':'+path]).decode().strip(),'sha256':digest,'bytes':len(raw),'size':list(im.size),'originalEncoding':im.format,'lfsHydrated':lfs,'manifestReferenceCount':len(entries),'verifiedSameBytesAsExperimentAndPhone':True,'url':'https://github.com/josiahscalia5-dev/rainbow-/blob/'+commit+'/'+path}
    print(s,path,digest[:12],flush=True)
(root/'original-github-artwork.json').write_text(json.dumps({'source':'GitHub private repository, fresh shallow fetch of the five independently verified Claudia specialist heads','utc':datetime.now(timezone.utc).isoformat(),'screens':report},indent=2)+'\n')
