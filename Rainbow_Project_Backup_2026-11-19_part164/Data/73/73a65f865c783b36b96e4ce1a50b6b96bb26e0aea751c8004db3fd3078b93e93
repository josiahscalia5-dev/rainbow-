target: [number, number, number] };\n38\t}\n39\t\n40\t(async () => {\n41\t  try {\n42\t    const views = q.get('views') ?? 'refs';\n43\t    const RIDE = 0.8 * 0.55; // Game.ts: root = water surface + benny.radius * 0.55\n44\t    const panels: Panel[] =\n45\t      views === 'refs'\n46\t        ? [\n47\t            { name: '05-rear', yaw: Math.PI, pitch: 0.24, dist: 4.4, expr: 'happy', swim: 0.8, fov: 40, tumble: false },\n48\t            { name: '03-front', yaw: 0.55, pitch: 0.12, dist: 4.2, expr: 'happy', swim: 0.3, fov: 40, tumble: false },\n49\t            { name: '02-dizzy', yaw: 0.0, pitch: 0.05, dist: 4.2, expr: 'dizzy', swim: 0, fov: 40, tumble: true },\n50\t          ]\n51\t        : views === 'measure'\n52\t          ? // proportion check: rear views at the ride height (lifted) at 12° / 18° / 24° / 28° camera elevation,\n53\t            // chroma-green background + water so a colour mask separates Benny (qa/pilot05/benny measure script)\n54\t            // `&elev=12,16,20,24` picks the elevations; `&bennyMask` renders flat ID colours on grey (maskmeasure)\n55\t            (q.get('elev') ?? '12,18,24,28').split(',').map(Number).map((deg) => ({ name: `rear-${deg}`, yaw: Math.PI, pitch: THREE.MathUtils.degToRad(deg), dist: 7.2, expr: 'happy', swim: 1, fov: 33, tumble: false }))\n56\t        : views === 'g05'\n57\t          ? // wave 4: ONE full-size 864×1536 frame with the live stage-05 camera relative to Benny's root, taken\n58\t            // from qa/capture_log.json, expressed in Benny's own frame (the tube slopes 2.4° down there): root→cam =\n59\t            // 0.50 to his right, 3.13 up, 6.59 back (25.4° elevation); view pitched 12.7° below his forward axis,\n60\t            // yawed 2.96° left (STAGE_CAM['05']). `&bennyMask` → flat ID colours on grey for pixel measurement.\n61\t            [\n62\t              (() => {\n63\t                const p = Math.atan2(3.6 + 1.92, 18 + 6.4), y = THREE.MathUtils.degToRad(2.96);\n64\t                const pos: [numb