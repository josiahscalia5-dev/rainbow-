from pathlib import Path
import json,subprocess as sp,re,urllib.parse
root=Path(__file__).resolve().parent;meta=json.loads((root/'private-review-tree.json').read_text())
repo='https://github.com/josiahscalia5-dev/rainbow-.git';branch=meta['branch'];commit=meta['commit'];ref='refs/heads/'+branch
start=sp.run(['git','ls-remote','--heads',repo,ref],stdout=sp.PIPE,stderr=sp.PIPE,check=True)
if start.stdout:
 assert start.stdout.decode().strip().split()[0]==commit,'A different remote branch already exists.'
else:
 print('Publishing only the new private review snapshot.',flush=True)
 args=['git','-C',str(root/'delivery-tree.git'),'-c','pack.threads=3','-c','pack.windowMemory=96m','push','--porcelain',repo,commit+':'+ref]
 res=sp.run(args,stdout=sp.PIPE,stderr=sp.PIPE,timeout=1200)
 if res.returncode:
  msg=re.sub(r'https?://\S+',lambda m:'['+(urllib.parse.urlsplit(m.group()).hostname or 'GitHub')+']',res.stderr.decode(errors='replace'))
  msg=re.sub(r'(?:github_pat_|gh[pousr]_|sk-)[A-Za-z0-9_-]+','[redacted]',msg)
  print('Private snapshot push',res.returncode,msg[-650:],flush=True)
  if res.returncode:raise SystemExit(res.returncode)
result=sp.check_output(['git','ls-remote','--heads',repo,ref]).decode().strip()
assert result.split()[0]==commit;print(branch,commit,'verified remotely.',flush=True)

