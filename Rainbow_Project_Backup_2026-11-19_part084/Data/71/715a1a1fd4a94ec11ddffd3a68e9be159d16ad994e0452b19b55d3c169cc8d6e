from pathlib import Path
import os,subprocess as sp,sys,tempfile,json
root=Path(__file__).resolve().parent
pkg=root/'payload';editions=json.loads((pkg/'02_VERSIONS/INDEX.json').read_text())['variants']
chosen=['Claudia_Lead','Claudia_S04','Claudia_S05','Claudia_S06','Claudia_S07','Claudia_S08','Codex_s04-approved-gold-bay','Codex_s06-benny-fitted-knit-cuff']
with tempfile.TemporaryDirectory(prefix='rainbow-offline-builds-',dir=root) as tmp:
 out=[]
 for edition in chosen:
  dest=Path(tmp)/edition
  sp.run([sys.executable,str(pkg/'02_VERSIONS/materialize_version.py'),edition,str(dest)],stdout=sp.DEVNULL,check=True)
  (dest/'node_modules').symlink_to('/tmp/rainbow-visual-audit.X0POSzUq/runtime-deps/node_modules',target_is_directory=True)
  run=sp.run(['npm','run','build'],cwd=dest,stdout=sp.PIPE,stderr=sp.STDOUT,env=dict(os.environ,npm_config_offline='true'),timeout=200)
  if run.returncode or not (dest/'dist/index.html').exists():raise RuntimeError(edition+' '+run.stdout.decode(errors='replace')[-1500:])
  out.append({'edition':edition,'commit':editions[edition]['commit'],'typecheck':'passed','viteProduction':'passed','dependencies':'Existing locked project dependency installation'})
  print('Built',edition,flush=True)
 (root/'independent-builds.json').write_text(json.dumps(out,indent=2)+'\n')

