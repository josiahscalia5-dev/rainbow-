from html.parser import HTMLParser
from urllib.request import Request,urlopen
from pathlib import Path
from concurrent.futures import ThreadPoolExecutor
import json,re
class Parser(HTMLParser):
 def __init__(self): super().__init__();self.rows=[];self.inScript=False
 def handle_starttag(self,t,a):
  if t in ['style','script']:self.inScript=True
 def handle_endtag(self,t):
  if t in ['style','script']:self.inScript=False
 def handle_data(self,data):
  if not self.inScript and data.strip():self.rows.append(' '.join(data.split()))
models=['meshy/v7.1/image-to-3d','meshy/v7.1/multi-image-to-3d','tripo3d/h3.1/image-to-3d','tripo3d/h3.1/multiview-to-3d','fal-ai/hunyuan-3d/v3.1/pro/image-to-3d','fal-ai/trellis-2','fal-ai/sam-3/3d-objects']
def one(id):
 url='https://fal.ai/models/'+id
 try:
  with urlopen(Request(url,headers={'User-Agent':'Mozilla/5.0 Rainbow model evaluation'}),timeout=25) as r:
   raw=r.read().decode();status=r.status
  p=Parser();p.feed(raw);lines=' '.join(p.rows);terms=[r'\$\s*\d',r'\d+\s+credits'];hits=[]
  for term in terms:
   for m in re.finditer(term,lines,re.I):hits.append(lines[max(0,m.start()-60):m.end()+195])
  if not hits:
   for m in re.finditer(r'(?:\$\d+\.\d{1,3}|price(?:Description|_description))',raw,re.I):
    hits.append(re.sub(r'[<>\\]',' ',raw[max(0,m.start()-40):m.start()+210]))
    if len(hits)>12:break
  return {'id':id,'url':url,'http':status,'billingText':list(dict.fromkeys(hits))[:17]}
 except Exception as e:return {'id':id,'failure':str(e)}
with ThreadPoolExecutor(max_workers=3) as ex:rows=list(ex.map(one,models))
Path('fal-pages.json').write_text(json.dumps(rows,indent=2)+'\n')
for r in rows:print(r['id'],r.get('http',r.get('failure')),(r.get('billingText')or [''])[0][:260])
