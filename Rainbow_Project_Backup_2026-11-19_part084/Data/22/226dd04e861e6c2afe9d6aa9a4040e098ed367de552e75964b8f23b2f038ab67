from pathlib import Path
import hashlib,json,os,subprocess as sp
from PIL import Image

root=Path(__file__).resolve().parent
review=Path('/tmp/rainbow-one-review.MG1VK6V4'); payload=review/'payload'
old=json.loads((review/'private-review-tree.json').read_text())
branch='codex/review/five-screens-on-android-20261119';origin='https://github.com/josiahscalia5-dev/rainbow-.git'
repo=root/'repo'
def git(*args,inp=None):
 return sp.check_output(['git','-C',str(repo),*args],input=inp,stderr=sp.PIPE)
def digest(p):return hashlib.sha256(p.read_bytes()).hexdigest()
fresh=sp.check_output(['git','ls-remote','--heads',origin,'refs/heads/'+old['branch'],'refs/heads/'+branch]).decode().splitlines()
if len(fresh)!=1 or fresh[0].split()[0]!=old['commit']:raise ValueError('Review branch changed')
repo.mkdir();git('init','-q');(repo/'.git/objects/info/alternates').write_text(str(review/'delivery-tree.git/objects')+'\n')
for k,v in {'remote.origin.url':origin,'user.name':'Codex','user.email':'codex@users.noreply.github.com','gc.auto':'0'}.items():git('config','--local',k,v)
git('sparse-checkout','set','--no-cone','--stdin',inp=b'/OPEN_RAINBOW_ON_ANDROID.md\n/PHONE_PICTURES/\n')
git('checkout','-q','-b',branch,old['commit'])
out=repo/'PHONE_PICTURES';out.mkdir()
titles={'04':'Through the Five Arrows','05':'Flow Into the Current','06':'Crest the Rinse Arch','07':'Dive the Washer Tube','08':'Final Spin Chamber'}
picks={'04':('Fifth_Gold_Ring','forward-20','Twenty units into the gold corridor','Look at the depth, spacing and pink-violet reflections on the farther gold rings.'),
       '05':('Final_Bend_Highlights','last-right-bend','Steering right through the final bend','Follow the cyan ripples around the last bend. Long straight highlights make the water look stretched.'),
       '06':('Crest_Release','crest-release','Benny coming over the crest','Follow the upper edge of the water toward the gold rings on the right. Look also at the pale patch below Benny.'),
       '07':('Plunge_Outlet_Foam','plunge-bottom','Near the bottom of the plunge','Follow the cyan and magenta riverbanks through the drop. Large white banks interrupt the curve.'),
       '08':('Chamber_Flow_Distance','hard-right','Steering hard right in the chamber','Check the width of the pink bank against the cyan channel while the door, towel, platform and four spouts stay in view.')}
rows=json.loads((review/'media-records.json').read_text())
lines=['# Rainbow on your phone','','Scroll to a screen to see the original artwork and Claudia’s retained moving view. Each picture opens separately. The swimming links play or download the real game recordings.','','[Download the five-screen picture PDF](Rainbow_Visual_Review.pdf)','']
checks=[]
for id,title in titles.items():
 stage='03_SCREENS/Screen_'+id;orig=stage+'/APPROVED_ORIGINAL.jpg'
 case,pose,label,note=picks[id]
 a=next(r for r in rows if r['screen']==id and r['accuracy']=='art' and r['name'].endswith('APPROVED_ORIGINAL'))
 b=next(r for r in rows if r['case']==case and r['section']=='CLAUDIA_BEFORE' and r['name'].split('/')[-1]==pose)
 assert digest(payload/orig)==a['sha']
 p=Path(b['local']);assert digest(p)==b['sha']
 fn='Screen_'+id+'_Claudia_'+pose+'.jpg'
 with Image.open(p) as im:
  assert im.size==(864,1536);im.convert('RGB').save(out/fn,'JPEG',quality=89,subsampling=0,optimize=True)
 file=next((payload/stage/'CLAUDIA_RETAINED').glob(pose+'.*')).relative_to(payload).as_posix()
 movie=stage+'/CLAUDIA_RETAINED/ride.mp4'
 for dest in [orig,file,movie]:
  git('cat-file','-e',old['commit']+':'+dest)
 lines.extend([f'## Screen {id} | {title}','',note,'','**APPROVED original artwork**','',f'[![Screen {id} original approved artwork]({orig})]({orig})','','**CLAUDIA BEFORE**','',label+'.','',f'[![Screen {id} retained gameplay]({"PHONE_PICTURES/"+fn})]({file})','',f'[Open the full-size retained frame]({file}) · [Watch Claudia’s swim]({movie})',''])
 checks.append({'screen':id,'originalSHA256':a['sha'],'retainedPNG_SHA256':b['sha'],'retainedBranch':b['branch'],'retainedCommit':b['commit'],'view':pose,'phoneJpeg':fn})
lines+=['## Reviewing the next change','','A moving view shows an interpretation where the original artwork has no camera angle. Only your approval makes it a new visual reference. Use the two swimming clips for each experiment to judge the same turn, crest or plunge.']
(repo/'OPEN_RAINBOW_ON_ANDROID.md').write_text('\n'.join(lines)+'\n')
(out/'SOURCES.json').write_text(json.dumps(checks,indent=2)+'\n')
git('add','--','OPEN_RAINBOW_ON_ANDROID.md','PHONE_PICTURES')
git('diff','--cached','--check');git('commit','-q','-m','Give Android one scrolling gallery of approved artwork and retained moving views')
tip=git('rev-parse','HEAD').decode().strip()
git('push','--quiet','origin','HEAD:refs/heads/'+branch)
assert git('ls-remote','--heads','origin','refs/heads/'+branch).decode().split()[0]==tip
(root/'gallery.json').write_text(json.dumps({'commit':tip,'branch':branch,'previous':old['commit'],'path':'OPEN_RAINBOW_ON_ANDROID.md'},indent=2)+'\n')
print('Verified private Android picture gallery',tip)
