};\n27\t\n28\t/** called once by cameraRig after STAGE_CAM is defined */\n29\texport function applyMatchCam(stageCam: Partial<Record<string, CamParams>>): void {\n30\t  for (const id of MATCH_IDS) {\n31\t    const o = MATCH_CAM[id];\n32\t    if (!MATCH[id] || !o || !stageCam[id]) continue;\n33\t    stageCam[id] = { ...(stageCam[id] as CamParams), ...o };\n34\t  }\n35\t}\n36\t", "tool_use_id": "toolu_01CsnpihK8FTje1mmpD63SjU", "type": "tool_result"}], "role": "user"}, "parentUuid": "3a70ec38-08bb-4052-b718-fed6607a3053", "permissionDecision": {"decision": "accept", "reasonType": "rule", "ruleSource": "cliArg", "source": "config"}, "promptId": "8c2bf963-7bf1-47d9-b5fc-60b5a6fbaa4d", "sessionId": "e47fc047-26b4-5efa-bfda-db0784968866", "slug": "kind-riding-parnas", "sourceToolAssistantUUID": "3a70ec38-08bb-4052-b718-fed6607a3053", "timestamp": "2026-11-17T11:24:39.535Z", "type": "user", "userType": "external", "uuid": "44d01f25-3b8d-4d85-865c-cf648c6e6788", "version": "2.1.326"}
