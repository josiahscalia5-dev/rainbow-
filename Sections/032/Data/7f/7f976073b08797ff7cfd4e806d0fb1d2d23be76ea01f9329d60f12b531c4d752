{"agentId": "aaef40383ee292ad9", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "claude/rainbow-restore-env-setup-bxn85h", "isSidechain": true, "message": {"content": [{"content": "1\t\"\"\"benny05 bake: approved Screen-05 pixels -> albedo maps in each Benny part's own UV space.\n2\tusage: python3 bake.py <run_dir with uv.f32, calA.png (k=0.2), calB.png (k=0.6)> <out_dir> [--normals]\n3\tPer pixel: L = inverse post chain (display -> linear scene radiance; exact port of PROJ05_INVERSE, bloom is off on 05),\n4\tE = (L_B - L_A)/(kB - kA), S = L_A - kA*E  (radiance = albedo*E + S), target albedo = (L_approved - S)/E.\n5\tStrict part correspondence: a texel of part P only takes approved pixels that the approved part masks call P (eroded 1 px)\n6\tand where the game shows P (UV pass id). Ratio of sums per texel, bilinear splat, push-pull hole fill, unseen texels by\n7\tmirror tiling of the well-seen central strip (knit / fur keeps its structure all around).\"\"\"\n8\timport sys, json, os\n9\tsys.path.insert(0, 'qa/pilot05/full_reference_match/benny'); sys.path.insert(0, 'qa/pilot05/full_reference_match/benny/work')\n10\timport numpy as np\n11\tfrom PIL import Image\n12\tfrom scipy import ndimage as ndi\n13\tfrom parts import approved_parts\n14\tfrom geom import load_uv\n15\t\n16\tKA, KB = 0.2, 0.6\n17\tEXPO, SAT, CON, VIG = 0.86, 1.36, 1.15, 0.18\n18\tLUM = np.array([0.2126, 0.7152, 0.0722])\n19\t\n20\tdef inv_chain(t):\n21\t    \"\"\"display sRGB (0..1, HxWx3, full 864x1536 frame) -> linear scene radiance\"\"\"\n22\t    H, W = t.shape[:2]\n23\t    yy, xx = np.mgrid[:H, :W]\n24\t    qx = ((xx + 0.5) / W - 0.5) * 0.75; qy = (yy + 0.5) / H - 0.5\n25\t    r = np.sqrt(qx * qx + qy * qy)\n26\t    sm = np.clip((r - 0.25) / 0.5, 0, 1); sm = sm * sm * (3 - 2 * sm)\n27\t    vig = 1 - VIG * sm\n28\t    c = t / np.maximum(vig, 0.5)[..., None]\n29\t    c = (c - 0.5) / CON + 0.5\n30\t    l = (c * LUM).sum(-1, keepdims=True)\n31\t    c = l + (c - l) / SAT\n32\t    c = np.clip(c, 0, 0.975)\n33\t    c = np.where(c > 0.04045, ((c + 0.055) / 1.055) ** 2.4, c / 12.92)\n34\t    npk = c.max(-1, keepdims=True)\n35\t    hi = npk >= 0.76\n36\t    peak = 0.0576 / (1 - np.minimum(npk, 0.9999)) + 0.52\n37\t    g = 1 - 1 / (0.15 * (peak - npk) + 1)\n38\t    c2 = (c - g * npk) / (1 - g) * (peak / np.maximum(npk, 1e-6))\n39\t    c = np.where(hi, c2, c)\n40\t    x = c.min(-1, keepdims=True)\n41\t    off = np.where(x >= 0.04, 0.04, np.sqrt(np.maximum(x, 0)) / 2.5 - x)\n42\t    return (c + off) / EXPO\n43\t\n44\tdef img(p): return np.asarray(Image.open(p).convert('RGB')).astype(np.float64) / 255.0\n45\t\n46\tPARTS = {  # id: (name, approved part key, tex W, H, central u strip for tiling or None)\n47\t    1: ('body', 'body', 1024, 512, (0.62, 0.88)),\n48\t    2: ('crown', 'crown', 1024, 256, (0.36, 0.64)),\n49\t    3: ('brim', 'cuff', 1024, 128, (0.36, 0.64)),\n50\t    4: ('pom', 'pom', 512, 256, None),\n51\t    6: ('armL', 'body', 256, 128, None),\n52\t    7: ('armR', 'body', 256, 128, None),\n53\t}\n54\t\n55\tdef push_pull(num, den):\n56\t    \"\"\"fill den==0 texels from coarser levels (num: HxWxC, den: HxW); u wraps\"\"\"\n57\t    if min(den.shape) <= 2:\n58\t        tot = den.sum()\n59\t        v = num.sum((0, 1)) / max(tot, 1e-9)\n60\t        return np.broadcast_to(v, num.shape).copy(), np.ones_like(den)\n61\t    H, W = den.shape\n62\t    h2, w2 = (H + 1) // 2, (W + 1) // 2\n63\t    pn = np.zeros((h2 * 2, w2 * 2, num.shape[2])); pd = np.zeros((h2 * 2, w2 * 2))\n64\t    pn[:H, :W] = num; pd[:H, :W] = den\n65\t    cn = pn.reshape(h2, 2, w2, 2, -1).sum((1, 3)); cd = pd.reshape(h2, 2, w2, 2).sum((1, 3))\n66\t    fn, fd = push_pull(cn, cd)\n67\t    up_n = np.repeat(np.repeat(fn / np.maximum(fd, 1e-9)[..., None], 2, 0), 2, 1)[:H, :W]\n68\t    up_n = ndi.uniform_filter(up_n, size=(3, 3, 1), mode='wrap')\n69\t    w = np.clip(den / 1.0, 0, 1)[..., None]\n70\t    val = np.where(den[..., None] > 0, num / np.maximum(den, 1e-9)[..., None], 0)\n71\t    out = w * val + (1 - w) * up_n\n72\t    return out, np.ones_like(den)\n73\t\n74\tdef main():\n75\t    run, out = sys.argv[1], sys.argv[2]\n76\t    os.makedirs(out, exist_ok=True)\n77\t    P, a8, m = approved_parts()\n78\t    ap = a8 / 255.0\n79\t    uvf = load_uv(f'{run}/uv.f32')\n80\t    ids = np.rint(uvf[..., 2]).astype(int); ids[np.abs(uvf[..., 2] - ids) > 0.01] = 0\n81\t    La, Lb, Lt = inv_chain(img(f'{run}/calA.png')), inv_chain(img(f'{run}/calB.png')), inv_chain(ap)\n82\t    E = (Lb - La) / (KB - KA); S = La - KA * E\n83\t    valid = (E * LUM).sum(-1) > 0.03\n84\t    target = (Lt - S) / np.maximum(E, 1e-4)\n85\t    report = {}\n86\t    from bennyseg import rgb2hsv, colour_classes\n87\t    Hh, Ss, Vv = rgb2hsv(a8); cls = colour_classes(a8)\n88\t    okc = {'body': ((Hh > 280) | (Hh < 20)) & (Ss > 0.2), 'crown': np.isin(cls, [2, 3]), 'cuff': (Hh > 230) & (Hh < 300) & (Ss > 0.35),\n89\t           'pom': (Hh > 230) & (Hh < 320) & (Ss > 0.2)}\n90\t    star = (ids == 5) & ndi.binary_erosion(P['star'], iterations=1) & valid\n91\t    if star.sum():\n92\t        sa = np.median(target[star], 0)\n93\t        report['star_albedo_linear'] = [round(float(v), 3) for v in sa]\n94\t        report['star_px'] = int(star.sum())\n95\t    for pid, (name, key, TW, TH, strip) in PARTS.items():\n96\t        sel = (ids == pid) & ndi.binary_erosion(P[key], iterations=1) & ndi.binary_erosion(ids == pid, iterations=1) & valid & okc[key]\n97\t        u = uvf[..., 0][sel] % 1.0; v = uvf[..., 1][sel]\n98\t        num_px = (Lt - S)[sel]; den_px = E[sel]\n99\t        num = np.zeros((TH, TW, 3)); den = np.zeros((TH, TW, 3)); cnt = np.zeros((TH, TW))\n100\t        tx = u * TW - 0.5; ty = (1 - v) * TH - 0.5\n101\t        x0 = np.floor(tx).astype(int); y0 = np.floor(ty).astype(int); fx = tx - x0; fy = ty - y0\n102\t        for dx, dy, w in [(0, 0, (1 - fx) * (1 - fy)), (1, 0, fx * (1 - fy)), (0, 1, (1 - fx) * fy), (1, 1, fx * fy)]:\n103\t            xi = (x0 + dx) % TW; yi = np.clip(y0 + dy, 0, TH - 1)\n104\t            np.add.at(num, (yi, xi), num_px * w[:, None]); np.add.at(den, (yi, xi), den_px * w[:, None]); np.add.at(cnt, (yi, xi), w)\n105\t        seen = cnt > 0.25\n106\t        alb = np.where(seen[..., None], num / np.maximum(den, 1e-6), 0)\n107\t        # push-pull fill (per-texel albedo, weight = coverage)\n108\t        filled, _ = push_pull(alb * np.clip(cnt, 0, 1)[..., None], np.clip(cnt, 0, 1))\n109\t        if strip is not None:\n110\t            # unseen texels: mirror-tile the central strip around (knit columns / fur tufts continue), ramp 24 texels\n111\t            u0, u1 = int(strip[0] * TW), int(strip[1] * TW)\n112\t            src = filled[:, u0:u1]\n113\t            Ls = src.shape[1]\n114\t            cover = ndi.uniform_filter(seen.astype(float), size=(1, 9), mode='wrap')\n115\t            idx = np.arange(TW)\n116\t            k = (idx - u0) % (2 * Ls); k = np.where(k < Ls, k, 2 * Ls - 1 - k)\n117\t            tiled = src[:, k]\n118\t            col_seen = ndi.binary_dilation(seen.any(0) & (seen.mean(0) > 0.0), iterations=0)\n119\t            wseen = np.clip(cover * 1.6, 0, 1)\n120\t            wseen = ndi.uniform_filter(wseen, size=(1, 25), mode='wrap')\n121\t            filled = wseen[..., None] * filled + (1 - wseen[..., None]) * tiled\n122\t        scale = float(max(1.0, np.percentile(filled, 99.7)))\n123\t        stored = np.clip(filled / scale, 0, 1)\n124\t        srgb = np.where(stored <= 0.0031308, stored * 12.92, 1.055 * stored ** (1 / 2.4) - 0.055)\n125\t        Image.fromarray((srgb * 255 + 0.5).astype(np.uint8)).save(f'{out}/{name}.png')\n126\t        Image.fromarray((seen * 255).astype(np.uint8)).save(f'{out}/{name}_seen.png')\n127\t        report[name] = dict(px=int(sel.sum()), seen_texels=int(seen.sum()), scale=round(scale, 3),\n128\t                            median_albedo=[round(float(x), 3) for x in np.median(alb[seen], 0)])\n129\t        if name in ('crown', 'brim') and '--normals' in sys.argv:\n130\t            lum = (srgb * LUM).sum(-1)\n131\t            hp = lum - ndi.gaussian_filter(lum, (3, 3), mode='wrap')\n132\t            hh = ndi.gaussian_filter(hp, 0.6, mode='wrap')\n133\t            # u wraps; d/du, d/dv in texels\n134\t            dx = (np.roll(hh, -1, 1) - np.roll(hh, 1, 1)) * 0.5\n135\t            dy = (np.vstack([hh[1:], hh[-1:]]) - np.vstack([hh[:1], hh[:-1]])) * 0.5\n136\t            st = 6.0\n137\t            n = np.stack([-dx * st, dy * st, np.ones_like(hh)], -1)\n138\t            n /= np.linalg.norm(n, axis=-1, keepdims=True)\n139\t            Image.fromarray(((n * 0.5 + 0.5) * 255 + 0.5).astype(np.uint8)).save(f'{out}/{name}_n.png')\n140\t    # feet: tiny map with the body's mean albedo\n141\t    json.dump(report, open(f'{out}/bake_report.json', 'w'), indent=1)\n142\t    print(json.dumps(report, indent=1))\n143\t\n144\tif __name__ == '__main__':\n145\t    main()\n146\t", "tool_use_id": "toolu_01Dxd2arri2w26uTD8MC5Rkf", "type": "tool_result"}], "role": "user"}, "parentUuid": "c4400dca-0761-4dff-b004-51addd7368cc", "permissionDecision": {"decision": "accept", "reasonType": "rule", "ruleSource": "cliArg", "source": "config"}, "promptId": "02c666a0-f583-4841-9aec-5d071b450b57", "sessionId": "c85b9efb-7963-5a97-9c4e-da811e450f6b", "sourceToolAssistantUUID": "c4400dca-0761-4dff-b004-51addd7368cc", "timestamp": "2026-11-17T00:50:51.009Z", "type": "user", "userType": "external", "uuid": "1384ea54-e742-4ee2-a00b-34964edefe9f", "version": "2.1.326"}
