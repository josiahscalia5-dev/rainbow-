{"agentId": "ac8112848dd644d86", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "claude/rainbow-3d-recovery-m4v347", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Tunnel geometry generated from course-aligned \"tube paths\", so walls, rings and nozzles follow the\n3\t * 04 slide, the 06 arch and the full 07 plunge with no seams.\n4\t *  - courseTubePath:   tube centred on the course itself (chute, gold ring pipe)\n5\t *  - straightTubePath: tube on a low-pass-filtered axis of the course (05–07): the tunnel stays\n6\t *    straight with concentric rings converging to one vanishing point (refs 05/07) while the stream\n7\t *    winds inside it. Radius/depth adapt so the floor always stays below the winding stream, and the\n8\t *    axis converges exactly onto the course at both ends (04 pipe junction, 08 chamber inlet).\n9\t */\n10\timport * as THREE from 'three';\n11\timport type { Course } from './course';\n12\t\n13\texport interface Frame { pos: THREE.Vector3; tan: THREE.Vector3; up: THREE.Vector3; right: THREE.Vector3 }\n14\t\n15\texport interface TubePath {\n16\t  frame(s: number): Frame;\n17\t  radius(s: number): number;\n18\t  /** distance from the water point on the axis down to the tube bottom */\n19\t  depth(s: number): number;\n20\t}\n21\t\n22\texport function courseTubePath(course: Course, radius: (s: number) => number, depth: number | ((s: number) => number) = 0.9): TubePath {\n23\t  return {\n24\t    frame: (s) => course.sample(s),\n25\t    radius,\n26\t    depth: typeof depth === 'number' ? () => depth : depth,\n27\t  };\n28\t}\n29\t\n30\texport function straightTubePath(\n31\t  course: Course,\n32\t  s0: number,\n33\t  s1: number,\n34\t  opts: { window: number; taper: number; baseRadius: (s: number) => number },\n35\t): TubePath {\n36\t  const ds = 0.5;\n37\t  const n = Math.ceil((s1 - s0) / ds) + 1;\n38\t  const S = (i: number) => Math.min(s1, s0 + i * ds);\n39\t  const axis: THREE.Vector3[] = [];\n40\t  const cp: THREE.Vector3[] = [];\n41\t  for (let i = 0; i < n; i++) cp.push(course.sample(S(i)).pos.clone());\n42\t  for (let i = 0; i < n; i++) {\n43\t    const s = S(i);\n44\t    const taper = THREE.MathUtils.smoothstep(s, s0, s0 + opts.taper) * (1 - THREE.MathUtils.smoothstep(s, s1 - opts.taper, s1));\n45\t    const W = opts.window * taper;\n46\t    const k = Math.round(W / ds);\n47\t    let x = 0, z = 0, wsum = 0;\n48\t    for (let j = i - k; j <= i + k; j++) {\n49\t      const jj = THREE.MathUtils.clamp(j, 0, n - 1);\n50\t      const w = k === 0 ? 1 : 1 - Math.abs(j - i) / (k + 1);\n51\t      x += cp[jj].x * w; z += cp[jj].z * w; wsum += w;\n52\t    }\n53\t    axis.push(new THREE.Vector3(x / wsum, cp[i].y, z / wsum));\n54\t  }\n55\t  const frames: Frame[] = axis.map((p, i) => {\n56\t    const a = axis[Math.max(0, i - 2)], b = axis[Math.min(n - 1, i + 2)];\n57\t    const tan = b.clone().sub(a).normalize();\n58\t    const cu = course.sample(S(i)).up;\n59\t    const up = cu.clone().addScaledVector(tan, -cu.dot(tan)).normalize();\n60\t    const right = new THREE.Vector3().crossVectors(tan, up).normalize();\n61\t    return { pos: p, tan, up, right };\n62\t  });\n63\t  // radius/depth so the floor stays below the stream edges, dilated + smoothed for a steady tube\n64\t  const rawR: number[] = [], rawD: number[] = [];\n65\t  for (let i = 0; i < n; i++) {\n66\t    const s = S(i);\n67\t    const d = cp[i].clone().sub(frames[i].pos).dot(frames[i].right);\n68\t    const X = Math.abs(d) + course.widthAt(s) / 2 + 0.25;\n69\t    const r = Math.max(opts.baseRadius(s), X + 0.7);\n70\t    rawR.push(r);\n71\t    rawD.push(Math.max(0.9, r - Math.sqrt(Math.max(0, r * r - X * X)) + 0.2));\n72\t  }\n73\t  const dilate = (arr: number[], k: number) => arr.map((_, i) => { let m = -Infinity; for (let j = i - k; j <= i + k; j++) m = Math.max(m, arr[THREE.MathUtils.clamp(j, 0, n - 1)]); return m; });\n74\t  const box = (arr: number[], k: number) => arr.map((_, i) => { let a = 0; for (let j = i - k; j <= i + k; j++) a += arr[THREE.MathUtils.clamp(j, 0, n - 1)]; return a / (2 * k + 1); });\n75\t  const R = box(dilate(rawR, 30), 16);\n76\t  const D = box(dilate(rawD, 30), 16);\n77\t  const idx = (s: number) => {\n78\t    const x = THREE.MathUtils.clamp((s - s0) / ds, 0, n - 1);\n79\t    const i = Math.min(n - 2, Math.floor(x));\n80\t    return { i, f: x - i };\n81\t  };\n82\t  const lerpArr = (arr: number[], s: number) => { const { i, f } = idx(s); return arr[i] + (arr[i + 1] - arr[i]) * f; };\n83\t  return {\n84\t    frame(s) {\n85\t      const { i, f } = idx(s);\n86\t      const A = frames[i], B = frames[i + 1];\n87\t      const pos = A.pos.clone().lerp(B.pos, f);\n88\t      const tan = A.tan.clone().lerp(B.tan, f).normalize();\n89\t      const up = A.up.clone().lerp(B.up, f);\n90\t      up.addScaledVector(tan, -up.dot(tan)).normalize();\n91\t      return { pos, tan, up, right: new THREE.Vector3().crossVectors(tan, up).normalize() };\n92\t    },\n93\t    radius: (s) => lerpArr(R, s),\n94\t    depth: (s) => lerpArr(D, s),\n95\t  };\n96\t}\n97\t\n98\texport function tubeCenterAt(path: TubePath, s: number, out = new THREE.Vector3()) {\n99\t  const f = path.frame(s);\n100\t  return out.copy(f.pos).addScaledVector(f.up, path.radius(s) - path.depth(s));\n101\t}\n102\t\n103\texport interface TubeGeoOptions {\n104\t  radial?: number;\n105\t  step?: number;\n106\t  vScale?: number;\n107\t  /** angular range (radians, measured from the bottom) — default full circle */\n108\t  arc?: number;\n109\t  /** radius offset (negative = inset toward the axis) */\n110\t  inset?: number;\n111\t}\n112\t\n113\texport function buildTubeGeometry(path: TubePath, s0: number, s1: number, o: TubeGeoOptions = {}): THREE.BufferGeometry {\n114\t  const radial = o.radial ?? 48;\n115\t  const step = o.step ?? 0.6;\n116\t  const vScale = o.vScale ?? 1;\n117\t  const arc = o.arc ?? Math.PI * 2;\n118\t  const rings = Math.max(2, Math.ceil((s1 - s0) / step) + 1);\n119\t  const pos = n