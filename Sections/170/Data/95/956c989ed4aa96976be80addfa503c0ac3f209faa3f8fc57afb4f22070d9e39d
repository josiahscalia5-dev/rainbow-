tion attribute (positions are generated in the vertex shader)\n  geo.setAttribute('position', new THREE.BufferAttribute(new Float32Array((SEG + 1) * 2 * 3), 3));\n  geo.setIndex(idx);\n  const n = perSide * 2;\n  const jet = new Float32Array(n * 4);\n  // deterministic layout: stratified across the fan, golden-ratio phases (no clumping in a frozen frame)\n  let k = 0;\n  for (const side of [-1, 1]) {\n    for (let i = 0; i < perSide; i++) {\n      const h = (x: number) => { const v = Math.sin(x * 127.1 + side * 311.7) * 43758.5453; return v - Math.floor(v); };\n      const a = Math.min(1, Math.max(0, (i + h(i * 1.7)) / perSide));\n      jet[k++] = side;\n      // denser towards the middle of the fan, thinner at both borders\n      jet[k++] = 0.5 + (a - 0.5) * (0.75 + 0.25 * Math.abs(a - 0.5) * 2);\n      jet[k++] = (i * 0.6180339 + h(i * 3.3) * 0.25) % 1;\n      jet[k++] = h(i * 5.1 + 0.37);\n    }\n  }\n  geo.setAttribute('aJet', new THREE.InstancedBufferAttribute(jet, 4));\n  geo.instanceCount = n;\n  const uniforms = withFog({ uTime: { value: 0 }, uR: { value: 0.45 }, uLen: { value: 1.25 }, uH: { value: 0.34 }, uStrength: { value: 0 } });\n  const mat = new THREE.ShaderMaterial({\n    uniforms,\n    vertexShader: VERT,\n    fragmentShader: FRAG,\n    fog: true,\n    transparent: true,\n    depthWrite: false,\n    side: THREE.DoubleSide,\n  });\n  const mesh = new THREE.Mesh(geo, mat);\n  mesh.name = 'rider_splash';\n  mesh.frustumCulled = false;\n  mesh.renderOrder = 3;\n  mesh.visible = false;\n  const basis = new THREE.Matrix4();\n  const back = new THREE.Vector3();\n  const side = new THREE.Vector3();\n  let target = 0;\n  let fed = false;\n  return {\n    mesh,\n    uniforms,\n    place(center, forward, up, radius, strength) {\n      back.copy(forward).multiplyScalar(-1);\n      side.crossVectors(up, back).normalize(); // x × y = z  →  (side, up, back) right-handed\n      basis.makeBasis(side, up, back);\n      mesh.quaternion.setFromRotationMatrix(basis);\n      mesh.position.copy(center);\n      uniforms.uR.value = radius;\n      target = strength;\n      fed = true;\n    },\n    update(time, dt) {\n      uniforms.uTime.value = time;\n      if (!fed) target = 0;\n      fed = false;\n      const s = uniforms.uStrength.value as number;\n      const v = dt > 0 ? s + (target - s) * Math.min(1, dt * 6) : target;\n      uniforms.uStrength.value = v;\n      mesh.visible = v > 0.01;\n    },\n  };\n}\n/**\n * Spray droplets: one pooled THREE.Points draw for Benny's wake fans, landing splashes, the\n * final-wave crest spray and spout splashes. Simple ballistic CPU sim (gravity along -Y).\n */\nimport * as THREE from 'three';\nimport { FRAG_TAIL, withFog } from './glsl';\n\nconst VERT = /* glsl */ `\nattribute float aSize;\nattribute float aAlpha;\nuniform float uScale;\nvarying float vAlpha;\n#include <fog_pars_vertex>\nvoid main() {\n  vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);\n  gl_PointSize = clamp(aSize * uScale / -mvPosition.z, 1.0, 28.0);\n  vAlpha = aAlpha;\n  gl_Position = projectionMatrix * mvPosition;\n  #include <fog_vertex>\n}\n`;\n// water bead (ref 05 droplets): translucent cyan body, brighter rim, a white glint up-left. Never a\n// solid white disc: the old opaque discs read as white dots stuck round Benny's base.\nconst FRAG = /* glsl */ `\nvarying float vAlpha;\n#include <fog_pars_fragment>\nvoid main() {\n  vec2 c = gl_PointCoord - 0.5;\n  float d = length(c) * 2.0;\n  if (d > 1.0) discard;\n  float body = 1.0 - smoothstep(0.7, 1.0, d);\n  float rim = smoothstep(0.45, 0.85, d) * body;\n  float hl = smoothstep(0.32, 0.0, length(c - vec2(-0.14, -0.14)));\n  vec3 col = mix(vec3(0.5, 0.88, 1.0), vec3(1.15, 1.18, 1.2), clamp(rim * 0.6 + hl, 0.0, 1.0));\n  gl_FragColor = vec4(col, (body * 0.38 + rim * 0.3 + hl * 0.5) * vAlpha);\n  ${FRAG_TAIL}\n}\n`;\n\nexport interface Spray {\n  points: THREE.Points;\n  emit(pos: THREE.Vector3, vel: THREE.Vector3, size: number, life: number): void;\n  update(dt: number, camera: THREE.Camera): void;\n  capacity: number;\n}\n\nexport function createSpray(quality: 'high' | 'low'): Spray {\n  const N = quality === 'high' ? 600 : 220;\n  const pos = new Float32Array(N * 3);\n  const vel = new Float32Array(N * 3);\n  const size = new Float32Array(N);\n  const alpha = new Float32Array(N);\n  const age = new Float32Array(N).fill(1e9);\n  const life = new Float32Array(N).fill(1);\n  const geo = new THREE.BufferGeometry();\n  geo.setAttribute('position', new THREE.BufferAttribute(pos, 3).setUsage(THREE.DynamicDrawUsage));\n  geo.setAttribute('aSize', new THREE.BufferAttribute(size, 1).setUsage(THREE.DynamicDrawUsage));\n  geo.setAttribute('aAlpha', new THREE.BufferAttribute(alpha, 1).setUsage(THREE.DynamicDrawUsage));\n  const uniforms = withFog({ uScale: { value: 600 } });\n  const points = new THREE.Points(geo, new THREE.ShaderMaterial({ uniforms, vertexShader: VERT, fragmentShader: FRAG, fog: true, transparent: true, depthWrite: false }));\n  points.name = 'spray';\n  points.frustumCulled = false;\n  points.renderOrder = 6;\n  let cursor = 0;\n  return {\n    points,\n    capacity: N,\n    emit(p, v, s, l) {\n      const i = cursor;\n      cursor = (cursor + 1) % N;\n      p.toArray(pos, i * 3);\n      v.toArray(vel, i * 3);\n      size[i] = s;\n      age[i] = 0;\n      life[i] = l;\n    },\n    update(dt, camera) {\n      const persp = camera as THREE.PerspectiveCamera;\n      const vh = (typeof window !== 'undefined' ? window.innerHeight : 800) * (typeof window !== 'undefined' ? Math.min(2, window.devicePixelRatio || 1) : 1);\n      uniforms.uScale.value = persp.isPerspectiveCamera ? vh / (2 * Math.tan(THREE.MathUtils.degToRad(persp.fov) / 2)) : 600;\n      for (let i = 0; i < N; i++) {\n        if (age[i] > life[i]) { alpha[i] = 0; continue; }\n        age[i] += dt;\n        vel[i * 3 + 1] -= 18 * dt;\n        pos[i * 3] += vel[i * 3] * dt;\n        pos[i * 3 + 1] += vel[i * 3 + 1] * dt;\n        pos[i * 3 + 2] += vel[i * 3 + 2] * dt;\n        const k = age[i] / life[i];\n        alpha[i] = k < 1 ? Math.min(1, (1 - k) * 2.5) : 0;\n      }\n      geo.attributes.position.needsUpdate = true;\n      geo.attributes.aSize.needsUpdate = true;\n      geo.attributes.aAlpha.needsUpdate = true;\n    },\n  };\n}", "is_error": false, "tool_use_id": "toolu_01XRVtkew82Cfn4NsM99QRFe", "type": "tool_result"}], "role": "user"}, "parentUuid": "b09ac3b7-c764-4fa2-891f-9ee4f6d0bd06", "permissionDecision": {"decision": "accept", "reasonType": "rule", "ruleSource": "cliArg", "source": "config"}, "promptId": "8703950a-5de8-447d-b5cd-e35cf6e80317", "sandboxed": false, "sessionId": "94cf04e3-ba8e-597b-bef0-28aeffba4499", "sourceToolAssistantUUID": "b09ac3b7-c764-4fa2-891f-9ee4f6d0bd06", "timestamp": "2026-11-16T01:48:20.336Z", "type": "user", "userType": "external", "uuid": "502d950d-e775-4cb5-bccc-b2000edf80c8", "version": "2.1.325"}
