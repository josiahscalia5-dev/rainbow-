from pathlib import Path
import json
p=Path.cwd()
for b in ['proof','altproof/proof','fitproof/proof','fitdiag/proof']:
 data=[]
 for f in sorted((p/b).glob('*/*/poses.json')):
  a=json.loads(f.read_text()); d=f.parent
  data.append(d.parent.name+d.name[0]+':'+str(len(a))+('g' if (d/'gameplay.json').is_file() else '')+('r' if (d/'route.json').is_file() else '')+('p' if (d/'opening-repeat.png').is_file() else ''))
 print(b,' '.join(data))
print('worker log entries',[(f.name,f.stat().st_size) for f in (p/'worker-logs').glob('*')])
