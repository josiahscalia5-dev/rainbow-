{"attachment": {"entries": [{"defer_loading": true, "description": "Generate or edit views from a text prompt and targetFrames, each with a camera and optional image, keep mask, or depth guide. Use contextFrames for unmasked reference photographs. Uses the project's World Labs Developer API credits. Returns an operation immediately; poll get_operation for the result. Reuse the same idempotency_key when retrying so the work is not submitted twice. Guide: https://docs.atlas.worldlabs.ai/depth-guided-generation.md", "eager_input_streaming": true, "input_schema": {"$defs": {"AtlasChiselModelParameters": {"additionalProperties": false, "description": "Sampling controls for atlasChisel.", "properties": {"numSteps": {"anyOf": [{"maximum": 100, "minimum": 1, "type": "integer"}, {"type": "null"}], "default": null, "description": "Number of denoising steps. Omit to use the model's default.", "title": "Numsteps"}, "seed": {"anyOf": [{"minimum": 0, "type": "integer"}, {"type": "null"}], "default": 42, "description": "Random seed for image generation.", "title": "Seed"}}, "title": "AtlasChiselModelParameters", "type": "object"}, "AtlasChiselTargetFrameAsset": {"additionalProperties": false, "description": "A target frame: the camera of one view to generate, plus a depth, an\nimage, or both when the view is conditioned.", "properties": {"camera": {"$ref": "#/$defs/PinholeCamera", "description": "Camera-to-world pose and intrinsics."}, "depth": {"anyOf": [{"$ref": "#/$defs/MaskedLogDepthBufferAsset"}, {"$ref": "#/$defs/MaskedLinearDepthBufferAsset"}, {"type": "null"}], "default": null, "description": "Depth buffer aligned to the camera, with an optional mask; null for an image-only frame.", "title": "Depth"}, "imageAsset": {"anyOf": [{"$ref": "#/$defs/TaskAsset"}, {"type": "null"}], "default": null, "description": "Source image as a URL or inline asset, or null (depth-only)."}, "maskAsset": {"anyOf": [{"$ref": "#/$defs/TaskAsset"}, {"type": "null"}], "default": null, "description": "Optional alpha mask as a URL or inline asset: an 8-bit grayscale PNG on the image grid whose pixel value / 255 is the alpha in [0, 1] (1 = kept, 0 = excluded). Null when the frame carries no mask."}}, "required": ["camera"], "title": "AtlasChiselTargetFrameAsset", "type": "object"}, "CoordinateFrame": {"additionalProperties": false, "description": "Pose represented by a position and an XYZW quaternion.\n\n``coordinate_system`` names the axes convention the pose is expressed in:\n``rub`` (right-up-back, the OpenGL/Three.js convention) or ``rdf``\n(right-down-forward, the OpenCV convention). Both the ``coordinateSystem``\n(camelCase) and ``coordinate_system`` spellings are accepted.", "properties": {"coordinateSystem": {"default": "rub", "enum": ["rub", "rdf"], "title": "Coordinatesystem", "type": "string"}, "position": {"maxItems": 3, "minItems": 3, "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "title": "Position", "type": "array"}, "quaternion": {"maxItems": 4, "minItems": 4, "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "title": "Quaternion", "type": "array"}}, "required": ["position", "quaternion"], "title": "CoordinateFrame", "type": "object"}, "LinearDepthBufferAsset": {"additionalProperties": false, "description": "Linear-depth EXR (URL or inline asset).", "properties": {"confidenceAsset": {"anyOf": [{"$ref": "#/$defs/TaskAsset"}, {"type": "null"}], "default": null, "description": "Optional 8-bit grayscale PNG on the depth grid whose pixel value / 255 is the per-pixel depth confidence in [0, 1], as a URL or inline asset."}, "depthAsset": {"$ref": "#/$defs/TaskAsset", "description": "EXR of linear depth in world units, as a URL or inline asset."}}, "required": ["depthAsset"], "title": "LinearDepthBufferAsset", "type": "object"}, "LogDepthBufferAsset": {"additionalProperties": false, "description": "Inverted log-depth PNG (URL or inline asset) plus its decode range.", "properties": {"confidenceAsset": {"anyOf": [{"$ref": "#/$defs/TaskAsset"}, {"type": "null"}], "default": null, "description": "Optional 8-bit grayscale PNG on the depth grid whose pixel value / 255 is the per-pixel depth confidence in [0, 1], as a URL or inline asset."}, "logDepthAsset": {"$ref": "#/$defs/TaskAsset", "description": "Inverted log-depth grayscale PNG, as a URL or inline asset."}, "zMax": {"description": "Linear depth in world units encoded as black (>0).", "title": "Zmax", "type": "number"}, "zMin": {"description": "Linear depth in world units encoded as white (1.0).", "title": "Zmin", "type": "number"}}, "required": ["logDepthAsset", "zMin", "zMax"], "title": "LogDepthBufferAsset", "type": "object"}, "MaskedLinearDepthBufferAsset": {"additionalProperties": false, "description": "Linear-depth EXR plus an optional mask.", "properties": {"confidenceAsset": {"anyOf": [{"$ref": "#/$defs/TaskAsset"}, {"type": "null"}], "default": null, "description": "Optional 8-bit grayscale PNG on the depth grid whose pixel value / 255 is the per-pixel depth confidence in [0, 1], as a URL or inline asset."}, "depthAsset": {"$ref": "#/$defs/TaskAsset", "description": "EXR of linear depth in world units, as a URL or inline asset."}, "maskAsset": {"anyOf": [{"$ref": "#/$defs/TaskAsset"}, {"type": "null"}], "default": null, "description": "Optional 8-bit grayscale PNG on the depth grid, as a URL or inline asset: white where the buffer's depth is known, black where it has none. Null when every pixel's depth is known."}}, "required": ["depthAsset"], "title": "MaskedLinearDepthBufferAsset", "type": "object"}, "MaskedLogDepthBufferAsset": {"additionalProperties": false, "description": "Inverted log-depth PNG plus its decode range and an optional mask.", "properties": {"confidenceAsset": {"anyOf": [{"$ref": "#/$defs/TaskAsset"}, {"type": "null"}], "default": null, "description": "Optional 8-bit grayscale PNG on the depth grid whose pixel value / 255 is the per-pixel depth confidence in [0, 1], as a URL or inline asset."}, "logDepthAsset": {"$ref": "#/$defs/TaskAsset", "description": "Inverted log-depth grayscale PNG, as a URL or inline asset."}, "maskAsset": {"anyOf": [{"$ref": "#/$defs/TaskAsset"}, {"type": "null"}], "default": null, "description": "Optional 8-bit grayscale PNG on the depth grid, as a URL or inline asset: white where the buffer's depth is known, black where it has none. Null when every pixel's depth is known."}, "zMax": {"description": "Linear depth in world units encoded as black (>0).", "title": "Zmax", "type": "number"}, "zMin": {"description": "Linear depth in world units encoded as white (1.0).", "title": "Zmin", "type": "number"}}, "required": ["logDepthAsset", "zMin", "zMax"], "title": "MaskedLogDepthBufferAsset", "type": "object"}, "PinholeCamera": {"additionalProperties": false, "description": "A posed pinhole camera.\n\nThe axes convention of the pose is carried by\n``extrinsics.coordinate_system``.", "properties": {"extrinsics": {"$ref": "#/$defs/CoordinateFrame"}, "intrinsics": {"$ref": "#/$defs/PinholeCameraIntrinsics"}}, "required": ["extrinsics", "intrinsics"], "title": "PinholeCamera", "type": "object"}, "PinholeCameraIntrinsics": {"additionalProperties": false, "description": "Pinhole camera intrinsics in pixel coordinates (not normalized).\n\nPixel coordinates have their origin (0, 0) at the top-left corner of the\nimage, +x right and +y down, so ``cx``/``cy`` measure from the top-left.\n``width`` and ``height`` are the image size in pixels the intrinsics\nrefer to. This is independent of the pose's ``coordinate_system``.", "properties": {"cx": {"title": "Cx", "type": "number"}, "cy": {"title": "Cy", "type": "number"}, "fx": {"title": "Fx", "type": "number"}, "fy": {"title": "Fy", "type": "number"}, "height": {"title": "Height", "type": "integer"}, "width": {"title": "Width", "type": "integer"}}, "required": ["fx", "fy", "cx", "cy", "width", "height"], "title": "PinholeCameraIntrinsics", "type": "object"}, "PosedRG