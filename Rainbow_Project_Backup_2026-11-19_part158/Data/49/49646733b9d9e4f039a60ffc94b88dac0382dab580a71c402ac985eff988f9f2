{"agentId": "ae805b4b3d62c3b2f", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-d4bb0ad3-8ycajb", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * RAINBOW master course — ONE continuous route through the washer world.\n3\t *\n4\t * Units: 1 unit ≈ 5 cm at Benny's scale (Benny body radius ≈ 0.8). +Y is up (absolute altitude).\n5\t * The route starts inside Drum A (scene 01/02), drains through a chute into the whirlpool basin (03),\n6\t * drops down the five-arrow slide (04), winds through the perforated current tube (05), crests the\n7\t * rinse arch (06), winds through the washer tube and then PLUNGES ~62 units straight down (07) before\n8\t * the bottom of that same tube flares into the Final Spin Chamber inlet (08). 08–10 stay in that same\n9\t * chamber; the route ends under the purple towel on the platform, where the 11 cinematic plays.\n10\t *\n11\t * Every stage is a range of arc-length `s` on a single centripetal Catmull-Rom spline, so position\n12\t * and tangent are continuous by construction; `validateContinuity()` measures it anyway.\n13\t */\n14\timport * as THREE from 'three';\n15\t\n16\texport type StageId = '01' | '02' | '03' | '04' | '05' | '06' | '07' | '08' | '09' | '10' | '11';\n17\texport type TubeKind = 'none' | 'chute' | 'gold' | 'perf';\n18\texport type StageProp = 'width' | 'tube' | 'speed' | 'bank';\n19\t\n20\texport interface StageDef {\n21\t  id: StageId;\n22\t  title: string;\n23\t  /** arc-length range on the course */\n24\t  s0: number;\n25\t  s1: number;\n26\t  /** water ribbon width (units) */\n27\t  width: number;\n28\t  /** enclosing tube radius (0 = open environment such as a drum/basin/chamber) */\n29\t  tube: number;\n30\t  tubeKind: TubeKind;\n31\t  /** auto-propulsion speed (units / s) */\n32\t  speed: number;\n33\t  /** coin counter shown in the locked reference screenshot of this stage */\n34\t  refCoins: number;\n35\t  interactive: boolean;\n36\t  /** banking strength multiplier */\n37\t  bank: number;\n38\t}\n39\t\n40\texport interface CourseSample {\n41\t  s: number;\n42\t  pos: THREE.Vector3;\n43\t  tan: THREE.Vector3;\n44\t  up: THREE.Vector3;\n45\t  right: THREE.Vector3;\n46\t}\n47\t\n48\texport const STAGE_TITLES: Record<StageId, string> = {\n49\t  '01': 'INSIDE THE WASHING MACHINE',\n50\t  '02': 'WHIRLPOOL TUMBLE',\n51\t  '03': 'WHIRLPOOL TWIRL',\n52\t  '04': 'THROUGH THE FIVE ARROWS',\n53\t  '05': 'FLOW INTO THE CURRENT',\n54\t  '06': 'CREST THE RINSE ARCH',\n55\t  '07': 'DIVE THE WASHER TUBE',\n56\t  '08': 'FINAL SPIN CHAMBER',\n57\t  '09': 'RIDE THE FINAL WAVE',\n58\t  '10': 'SLIDE INTO HIDING',\n59\t  '11': 'SAFELY HOME',\n60\t};\n61\t\n62\t/** Fixed world anchors shared by environment builders (absolute coordinates). */\n63\texport const WORLD = {\n64\t  drumA: { center: new THREE.Vector3(0, 0, 0), radius: 5, zBack: -6.5, zDoor: 3.5, doorRadius: 3.2, waterY: -2.5 },\n65\t  basin: { center: new THREE.Vector3(2, -16, -19), rimRadius: 11.5, rimY: -10.6, drainRadius: 4.3, drainY: -20.2 },\n66\t  /** Final Spin Chamber (08–11): drum with axis along Z, door at the far (-Z) end */\n67\t  chamber: { center: new THREE.Vector3(12, -101.1, 0), radius: 13.5, zBack: -280, zDoor: -332, floorY: -113.6, doorRadius: 6.2 },\n68\t  platform: { center: new THREE.Vector3(12, -110.6, -325.0), radius: 6.2, topY: -110.6 },\n69\t  plunge: { topY: -52, bottomY: -113.6 },\n70\t};\n71\t\n72\t/** funnel surface height of the whirlpool basin as a function of radius from its axis */\n73\texport function funnelY(r: number): number {\n74\t  const b = WORLD.basin;\n75\t  const t = THREE.MathUtils.clamp((r - b.drainRadius * 0.6) / (b.rimRadius - b.drainRadius * 0.6), 0, 1);\n76\t  return b.drainY + (b.rimY - b.drainY) * Math.pow(t, 0.72);\n77\t}\n78\t\n79\tconst V = (x: number, y: number, z: number) => new THREE.Vector3(x, y, z);\n80\tconst smooth = (a: number, b: number, x: number) => {\n81\t  const t = THREE.MathUtils.clamp((x - a) / (b - a), 0, 1);\n82\t  return t * t * (3 - 2 * t);\n83\t};\n84\t\n85\t/**\n86\t * A stretch whose tunnel axis is an exact straight line a→b (the stream winds inside it). The\n87\t * course lies on the line at both ends of the stretch; tube.ts aligns the tunnel axis to it.\n88\t */\n89\texport interface StraightAxis {\n90\t  /** arc-length range of the stretch on the course */\n91\t  s0: number;\n92\t  s1: number;\n93\t  a: THREE.Vector3;\n94\t  b: THREE.Vector3;\n95\t  /** stream-to-tunnel-bottom depth on the line (water sits this high in the tube) */\n96\t  floorDepth: number;\n97\t}\n98\t\n99\tinterface RouteData {\n100\t  points: THREE.Vector3[];\n101\t  marks: Record<string, number>;\n102\t  straight: { from: string; to: string; a: THREE.Vector3; b: THREE.Vector3; floorDepth: number }[];\n103\t}\n104\t\n105\t/**\n106\t * 05 current (ref 05): the tunnel is a straight line; the STREAM winds inside it. The meander is the\n107\t * lateral (world +X) offset of the course centreline from that line, as a function of the distance\n108\t * `u` along the line (0 … L05). It is applied to the route AFTER smoothPolyline, so it is exact (the\n109\t * smoothing would shave ~25 % off the amplitude) and still C¹ at both ends (offset and slope → 0).\n110\t *\n111\t * Shape tuned against the reference's cyan core: a small first crest under Benny at the 05\n112\t * checkpoint (u≈uCrest, offset a0 to the LEFT, heading parallel to the tunnel axis), then crests\n113\t * that grow toward the far end (screen: Benny → (560,700) → (450,600) → (520,520) → VP).\n114\t * Coins (gameplay/coins.ts) sit on this centreline (lat 0), so they wind with the same S.\n115\t */\n116\texport const S05 = {\n117\t  /** length of the straight tunnel line (units) */\n118\t  L: 72,\n119\t  /** wavelength along the line (crest → crest of the same side) */\n120\t  lambda: 32,\n121\t  /** u of the first (left) crest, where Benny rides at the 05 checkpoint */\n122\t  uCrest: 14,\n123\t  /** crest amplitude at uCrest and at uCrest + 1.5 λ (linear growth in between) */\n124\t  a0: 0.45,\n125\t  a1: 1.85,\n126\t  /** half extent of the stream (|offset| + half width) in the current: fills the tube floor */\n127\t  extent: 6.0,\n128\t};\n129\t\n130\t/** lateral offset (units, + = world +X = rider's right when heading -Z) of the 05 stream from its tunnel line */\n131\texport function meander05(u: number): number {\n132\t  const { L, lambda, uCrest, a0, a1 } = S05;\n133\t  if (u <= 0 || u >= L) return 0;\n134\t  const grow = THREE.MathUtils.clamp((u - uCrest) / (1.5 * lambda), 0, 1);\n135\t  const amp = (a0 + (a1 - a0) * grow) * smooth(0, 10, u) * (1 - smooth(L - 12, L, u));\n136\t  return -amp * Math.cos((2 * Math.PI * (u - uCrest)) / lambda);\n137\t}\n138\t\n139\t/** Generates the dense control polyline of the route (absolute coordinates). */\n140\tfunction buildRoute(): RouteData {\n141\t  const pts: THREE.Vector3[] = [];\n142\t  const marks: Record<string, number> = {};\n143\t  const straight: RouteData['straight'] = [];\n144\t  const push = (p: THREE.Vector3) => {\n145\t    if (pts.length && p.distanceTo(pts[pts.length - 1]) < 0.25) return;\n146\t    pts.push(p);\n147\t  };\n148\t  const mark = (k: string) => (marks[k] = pts.length - 1);\n149\t  const seg = (n: number, f: (t: number) => THREE.Vector3, skipFirst = true) => {\n150\t    for (let i = skipFirst ? 1 : 0; i <= n; i++) push(f(i / n));\n151\t  };\n152\t\n153\t  // ---- 01: Benny hidden in the towel, drum A front-left floor (camera looks toward the door) ----\n154\t  const dA = WORLD.drumA;\n155\t  const hc = V(0, -0.4, 0); // swirl axis\n156\t  const th0 = Math.atan2(-2.0, 1.6);\n157\t  push(V(1.6, -2.4, -2.2));\n158\t  mark('01');\n159\t  // ---- 02: whirlpool tumble — helix around the drum axis toward the back drain ----\n160\t  const thEnd = -Math.PI / 2 - Math.PI * 2;\n161\t  seg(26, (t) => {\n162\t    const th = th0 + (thEnd - th0) * t;\n163\t    const r = 2.56 + (3.9 - 2.56) * smooth(0, 1, t);\n164\t    const z = -2.2 + (-5.4 + 2.2) * t;\n165\t    return V(hc.x + r * Math.cos(th), hc.y + r * Math.sin(th), z);\n166\t  });\n167\t  mark('02_drain');\n168\t  // chute from drum A back drain down into the whirlpool basin rim\n169\t  const b = WORLD.basin;\n170\t  const spiralStart = V(b.center.x - 9.6, funnelY(9.6) + 0.25, b.center.z);\n171\t  const c0 = pts[pts.length - 1].clone();\n172\t  const chuteCtrl = [c0, V(-0.6, -5.6, -7.6), V(-3.2, -7.8, -10.4), V(-6.6, -9.8, -14.2), spiralStart.clone().add(V(0, 0.15, 2.4))];\n173\t  const chute = new THREE.CatmullRomCurve3(chuteCtrl, false, 'centripetal');\n174\t  seg(14, (t) => chute.getPoint(t));\n175\t  push(spiralStart);\n176\t  mark('03');\n177\t  // ---- 03: whirlpool twirl — 3/4 inward turn down the funnel that dives into the drain CENTRE ----\n178\t  // decreasing angle from the -X side (θ=-π/2) round the far and right sides to the near (+Z) side;\n179\t  // r shrinks as (1-t)^1.6 so the last stretch heads radially inward = straight -Z into the drain hole.\n180\t  seg(60, (t) => {\n181\t    const th = -Math.PI / 2 - Math.PI * 1.5 * (1 - (1 - t) * (1 - t)); // angle eases out → radial finish\n182\t    const r = 9.6 * Math.pow(1 - t, 0.9);\n183\t    return V(b.center.x + r * Math.sin(th), funnelY(r) + 0.25, b.center.z + r * Math.cos(th));\n184\t  });\n185\t  mark('04');\n186\t  // ---- 04: five-arrow slide — steep straight drop (≈32°) inside the gold ring pipe ----\n187\t  const s4 = pts[pts.length - 1].clone();\n188\t  const pitch4 = THREE.MathUtils.degToRad(32);\n189\t  const d4 = V(0, -Math.sin(pitch4), -Math.cos(pitch4));\n190\t  // pull-down arc from the drain lip into the steep slide pitch\n191\t  const R4a = 9;\n192\t  seg(7, (t) => {\n193\t    const a = pitch4 * t;\n194\t    return s4.clone().add(V(0, -R4a * (1 - Math.cos(a)), -R4a * Math.sin(a)));\n195\t  });\n196\t  const s4b = pts[pts.length - 1].clone();\n197\t  seg(16, (t) => s4b.clone().addScaledVector(d4, 34 * t));\n198\t  // pull out of the slide into the horizontal current\n199\t  const s4c = pts[pts.length - 1].clone();\n200\t  const R4 = 12;\n201\t  seg(8, (t) => {\n202\t    const a = -pitch4 + pitch4 * t;\n203\t    return s4c.clone().add(V(0, R4 * (Math.cos(-pitch4) - Math.cos(a)), R4 * (Math.sin(-pitch4) - Math.sin(a))));\n204\t  });\n205\t  mark('05');\n206\t  // ---- 05: long STRAIGHT perforated current tube (ref 05: concentric rings, ONE vanishing point);\n207\t  // the wide stream winds in S-curves inside it. Here only the straight line s5 → s5+L05 (slight\n208\t  // descent) is laid; the lateral S-offset meander05(u) is added after smoothing (see the end of\n209\t  // buildRoute). Offset and slope vanish at both ends, so 04 and 06 join tangentially and s6 (hence\n210\t  // 06/07/plunge/08) is unchanged. tube.ts builds the 05 tunnel on the line.\n211\t  const s5 = pts[pts.length - 1].clone();\n212\t  const L05 = V(0, -3, -S05.L);\n213\t  // 48 points (1.5-unit spacing) as before: the junction smoothing, hence the 04/05 and 05/06 stage\n214\t  // boundaries and the 06 checkpoint, stay exactly where they were\n215\t  seg(48, (t) => s5.clone().addScaledVector(L05, t));\n216\t  straight.push({ from: '05', to: '06', a: s5.clone(), b: s5.clone().add(L05), floorDepth: 3.3 });\n217\t  mark('06');\n218\t  // ---- 06: rinse arch — rises ~12 units, crests, curls down and to the right into the 07 tube ----\n219\t  const s6 = pts[pts.length - 1].clone();\n220\t  seg(34, (t) =>\n221\t    V(\n222\t      s6.x - 4 * Math.sin(Math.PI * t) + (WORLD.chamber.center.x - s6.x) * smooth(0.4, 1, t),\n223\t      s6.y + 12.5 * Math.pow(Math.sin(Math.PI * Math.min(t / 0.82, 1)), 1.15) - 4.5 * smooth(0.5, 1, t),\n224\t      s6.z - 46 * t,\n225\t    ),\n226\t  );\n227\t  mark('07');\n228\t  // ---- 07: winding washer tube (the visible stretch) ----\n229\t  const s7 = pts[pts.length - 1].clone();\n230\t  seg(32, (t) =>\n231\t    V(s7.x + 3.2 * Math.sin(3 * Math.PI * t) * Math.sin(Math.PI * t), s7.y + (WORLD.plunge.topY - s7.y) * t, s7.z - 60 * t),\n232\t  );\n233\t  mark('07_plunge_top');\n234\t  // ---- 07: THE DEEP PLUNGE — pull-down arc, long -70° straight, pull-up arc into the 08 inlet ----\n235\t  const p0 = pts[pts.length - 1].clone();\n236\t  const R = 14;\n237\t  const amax = THREE.MathUtils.degToRad(70);\n238\t  seg(12, (t) => {\n239\t    const a = amax * t;\n240\t    return p0.clone().add(V(0, -R * (1 - Math.cos(a)), -R * Math.sin(a)));\n241\t  });\n242\t  const p1 = pts[pts.length - 1].clone();\n243\t  const dPl = V(0, -Math.sin(amax), -Math.cos(amax));\n244\t  // straight length chosen so the bottom lands exactly on the chamber floor altitude\n245\t  const drop = p0.y - WORLD.plunge.bottomY;\n246\t  const Lstraight = (drop - 2 * R * (1 - Math.cos(amax))) / Math.sin(amax);\n247\t  seg(Math.ceil(Lstraight / 2), (t) => p1.clone().addScaledVector(dPl, Lstraight * t));\n248\t  mark('07_plunge_mid_end');\n249\t  const p2 = pts[pts.length - 1].clone();\n250\t  seg(12, (t) => {\n251\t    const a = -amax + amax * t;\n252\t    return p2.clone().add(V(0, R * (Math.cos(-amax) - Math.cos(a)), R * (Math.sin(-amax) - Math.sin(a))));\n253\t  });\n254\t  mark('07_plunge_bottom');\n255\t  const p3 = pts[pts.length - 1].clone();\n256\t  const zIn = WORLD.chamber.zBack;\n257\t  seg(4, (t) => V(p3.x, p3.y, p3.z + (zIn - p3.z) * t));\n258\t  mark('08');\n259\t  // ---- 08–10: Final Spin Chamber — winding stream toward the platform & towel ----\n260\t  const s8 = pts[pts.length - 1].clone();\n261\t  const plat = WORLD.platform;\n262\t  seg(14, (t) => V(s8.x + 3.6 * Math.sin(2 * Math.PI * t) * Math.sin(Math.PI * t), s8.y, s8.z - 15 * t));\n263\t  mark('09');\n264\t  const s9 = pts[pts.length - 1].clone();\n265\t  seg(14, (t) => V(s9.x - 3.2 * Math.sin(Math.PI * t), s9.y + 0.1 * t, s9.z - 15 * t));\n266\t  mark('10');\n267\t  const s10 = pts[pts.length - 1].clone();\n268\t  const end = V(plat.center.x, plat.topY + 0.45, plat.center.z + 0.6);\n269\t  seg(10, (t) =>\n270\t    V(s10.x + (end.x - s10.x) * t, s10.y + (end.y - s10.y) * smooth(0.3, 1, t), s10.z + (end.z - s10.z) * t),\n271\t  );\n272\t  mark('11');\n273\t  smoothPolyline(pts, marks['03'], 2.2, 3);\n274\t  // 05 meander: exact lateral offset from the straight tunnel line (after smoothing, see S05)\n275\t  const dir05 = L05.clone().normalize();\n276\t  for (let i = marks['05'] + 1; i < marks['06']; i++) {\n277\t    const u = pts[i].clone().sub(s5).dot(dir05) * (S05.L / L05.length());\n278\t    pts[i].x += meander05(u);\n279\t  }\n280\t  return { points: pts, marks, straight };\n281\t}\n282\t\n283\t/**\n284\t * Arc-length Gaussian smoothing of the polyline from index `from` to the end (endpoints fixed).\n285\t * Removes tangent kinks where independently generated segments meet; the 02 tumble helix\n286\t * (before `from`) is left untouched.\n287\t */\n288\tfunction smoothPolyline(pts: THREE.Vector3[], from: number, sigma: number, passes: number) {\n289\t  for (let pass = 0; pass < passes; pass++) {\n290\t    const cum: number[] = [0];\n291\t    for (let i = 1; i < pts.length; i++) cum.push(cum[i - 1] + pts[i].distanceTo(pts[i - 1]));\n292\t    const out = pts.map((p) => p.clone());\n293\t    for (let i = from + 1; i < pts.length - 1; i++) {\n294\t      const acc = new THREE.Vector3();\n295\t      let wsum = 0;\n296\t      for (let j = i - 12; j <= i + 12; j++) {\n297\t        if (j < from || j >= pts.length) continue;\n298\t        const d = cum[j] - cum[i];\n299\t        const w = Math.exp(-(d * d) / (2 * sigma * sigma));\n300\t        acc.addScaledVector(pts[j], w);\n301\t        wsum += w;\n302\t      }\n303\t      out[i].copy(acc.divideScalar(wsum));\n304\t    }\n305\t    for (let i = from + 1; i < pts.length - 1; i++) pts[i].copy(out[i]);\n306\t  }\n307\t}\n308\t\n309\texport class Course {\n310\t  readonly curve: THREE.CatmullRomCurve3;\n311\t  readonly length: number;\n312\t  readonly stages: StageDef[];\n313\t  readonly marks: Record<string, number>; // arc-length of named marks\n314\t  /** straight tunnel stretches (05 current) — see StraightAxis */\n315\t  readonly straightAxes: StraightAxis[];\n316\t  /** world X of the straight 05 tunnel line (the meander is pos.x − line05x) */\n317\t  private readonly line05x: number;\n318\t  private st05!: StageDef;\n319\t  private st10!: StageDef;\n320\t  private readonly N: number;\n321\t  private readonly ds: number;\n322\t  private readonly P: Float32Array;\n323\t  private readonly T: Float32Array;\n324\t  private readonly U: Float32Array;\n325\t\n326\t  constructor() {\n327\t    const route = buildRoute();\n328\t    this.curve = new THREE.CatmullRomCurve3(route.points, false, 'centripetal');\n329\t    // arc-length table over curve parameter u\n330\t    const M = route.points.length * 24;\n331\t    const us: number[] = [0];\n332\t    const ls: number[] = [0];\n333\t    let prev = this.curve.getPoint(0);\n334\t    for (let i = 1; i <= M; i++) {\n335\t      const u = i / M;\n336\t      const p = this.curve.getPoint(u);\n337\t      ls.push(ls[i - 1] + p.distanceTo(prev));\n338\t      us.push(u);\n339\t      prev = p;\n340\t    }\n341\t    this.length = ls[M];\n342\t    const uAtS = (s: number) => {\n343\t      let lo = 0, hi = M;\n344\t      while (hi - lo > 1) {\n345\t        const mid = (lo + hi) >> 1;\n346\t        if (ls[mid] < s) lo = mid; else hi = mid;\n347\t      }\n348\t      const f = (s - ls[lo]) / Math.max(1e-6, ls[hi] - ls[lo]);\n349\t      return us[lo] + (us[hi] - us[lo]) * f;\n350\t    };\n351\t    const sAtIndex = (i: number) => {\n352\t      const u = i / (route.points.length - 1);\n353\t      const k = Math.round(u * M);\n354\t      return ls[k];\n355\t    };\n356\t    this.marks = {};\n357\t    for (const [k, i] of Object.entries(route.marks)) this.marks[k] = sAtIndex(i);\n358\t    this.straightAxes = route.straight.map((r) => ({ s0: this.marks[r.from], s1: this.marks[r.to], a: r.a, b: r.b, floorDepth: r.floorDepth }));\n359\t    this.line05x = route.straight[0].a.x;\n360\t\n361\t    // ---- stages ----\n362\t    const m = this.marks;\n363\t    const def = (id: StageId, s0: number, s1: number, o: Partial<StageDef>): StageDef => ({\n364\t      id, title: STAGE_TITLES[id], s0, s1, width: 5, tube: 0, tubeKind: 'none', speed: 11, refCoins: 0,\n365\t      interactive: true, bank: 1, ...o,\n366\t    });\n367\t    this.stages = [\n368\t      def('01', 0, 0.01, { width: 6, interactive: false, speed: 0 }),\n369\t      def('02', 0.01, m['03'], { width: 5, interactive: false, speed: 9, bank: 0 }),\n370\t      def('03', m['03'], m['04'], { width: 7, speed: 9, refCoins: 1330, bank: 2.2 }),\n371\t      def('04', m['04'], m['05'], { width: 4.4, tube: 4.8, tubeKind: 'gold', speed: 14, refCoins: 1330 }),\n372\t      // 05: level current (ref 05 shows no tilt) → weak curvature banking. `width` is the hand-over\n373\t      // value at the 04/06 junctions; inside the current widthAt() widens the stream to fill the floor.\n374\t      def('05', m['05'], m['06'], { width: 9, tube: 7.6, tubeKind: 'perf', speed: 11, refCoins: 1420, bank: 0.25 }),\n375\t      def('06', m['06'], m['07'], { width: 7, tube: 15, tubeKind: 'perf', speed: 11, refCoins: 1680, bank: 0.6 }),\n376\t      def('07', m['07'], m['08'], { width: 5.6, tube: 7.2, tubeKind: 'perf', speed: 12, refCoins: 1940 }),\n377\t      def('08', m['08'], m['09'], { width: 4.8, speed: 9.5, refCoins: 2040 }),\n378\t      def('09', m['09'], m['10'], { width: 6.4, speed: 9.5, refCoins: 2280 }),\n379\t      def('10', m['10'], m['11'], { width: 3.8, speed: 7.5, refCoins: 2500 }),\n380\t      def('11', m['11'], this.length, { width: 3, interactive: false, speed: 0, refCoins: 2500 }),\n381\t    ];\n382\t\n383\t    // ---- dense frame table (pos, tangent, banked up) ----\n384\t    this.N = Math.ceil(this.length / 0.25) + 1;\n385\t    this.ds = this.length / (this.N - 1); // exact spacing so the last interval is not short\n386\t    this.P = new Float32Array(this.N * 3);\n387\t    this.T = new Float32Array(this.N * 3);\n388\t    this.U = new Float32Array(this.N * 3);\n389\t  