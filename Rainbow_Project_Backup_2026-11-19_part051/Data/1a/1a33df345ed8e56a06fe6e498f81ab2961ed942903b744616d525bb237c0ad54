  "set_material_property": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "name": {
        "description": "Material name, or name of a mesh using it",
        "type": "string"
      },
      "uuid": {
        "description": "Material UUID",
        "type": "string"
      },
      "property": {
        "type": "string",
        "description": "color, emissive, emissiveIntensity, roughness, metalness, opacity, transparent, wireframe, visible, side, depthWrite, depthTest, alphaTest, flatShading, fog, envMapIntensity; physical: clearcoat, clearcoatRoughness, transmission, thickness, ior, sheen, sheenColor, sheenRoughness, iridescence, anisotropy, dispersion, specularIntensity, specularColor, attenuationColor"
