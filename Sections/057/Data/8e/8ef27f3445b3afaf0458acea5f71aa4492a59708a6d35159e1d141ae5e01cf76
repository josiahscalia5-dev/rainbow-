from pathlib import Path
import json, hashlib, os, shutil, subprocess, sys
from datetime import datetime, timezone

root = Path(__file__).parent
old = Path('/tmp/rainbow-reconstruction.etSm9SmK')
motion = Path('/tmp/rainbow-motion-tools.ef8YVWIN')
audit = Path('/tmp/rainbow-visual-audit.X0POSzUq')
url = 'https://github.com/josiahscalia5-dev/rainbow-.git'
branches = {'06':'codex/s06-crest-foam-clearance','07':'codex/s07-plunge-bank-continuity','04':'codex/s04-distant-ring-profile','05':'codex/s05-final-bend-river-uv'}
paths = {'06':['src/world/match06.ts'],'07':['src/vfx/foam.ts','src/vfx/waterRibbon.ts','src/world/match07.ts'],
         '04':['src/world/match04m4.ts'],'05':['src/world/match05far.ts','src/vfx/proj05.ts','src/vfx/waterRibbon.ts','src/vfx/proj05Tunnel.ts']}
prior_paths = {'04':'games/04','05':'fitted/05','06':'alternatives/06','07':'wallfit/07'}
def cmd(*args, cwd=None, data=None):
    return subprocess.run(args,cwd=cwd,input=data,text=True,check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE).stdout.strip()
def heads():
    return {line.split()[1].removeprefix('refs/heads/'):line.split()[0] for line in cmd('git','ls-remote','--heads',url).splitlines()}
for sid in sys.argv[1:]:
    live = heads()
    profile = json.loads((old/('base-'+sid+'.json')).read_text())
    lead = profile['lead']; specialist = profile['base']; prev = profile['branch']
    assert live[lead['branch']]==lead['commit'] and live[specialist['branch']]==specialist['commit']
    existing = branches[sid]
    assert existing not in live
    previous = json.loads((old/('final-push-'+sid+'.json')).read_text())['commit']
    assert live[prev]==previous
    if sid=='04':assert live['claude/rainbow-s04-ringtex-c17']=='0f275af1e3d4e9276e5a4016d0335a85fe055e58'
    base = previous if sid in ('04','05') else specialist['commit']
    repo = root/'repos'/sid; repo.mkdir(parents=True)
    def git(*args, data=None): return cmd('git',*args,cwd=repo,data=data)
    git('init','-q')
    (repo/'.git/objects/info/alternates').write_text(str(old/'repos'/sid/'.git/objects')+'\n'+str(audit/'objects.git/objects')+'\n')
    for k,v in {'remote.origin.url':url,'remote.origin.fetch':'+refs/heads/*:refs/remotes/origin/*','remote.origin.promisor':'true','remote.origin.partialclonefilter':'blob:none','user.name':'Codex','user.email':'codex@users.noreply.github.com','gc.auto':'0'}.items():git('config','--local',k,v)
    git('lfs','install','--local')
    br=prev if sid in ('04','05') else specialist['branch']
    git('fetch','--quiet','--depth=1','--filter=blob:none','--no-tags','origin','refs/heads/'+br+':refs/remotes/origin/'+br)
    docs='experiments/codex/fidelity-'+sid
    git('sparse-checkout','set','--no-cone','--stdin',data='\n'.join(['/.gitattributes','/'+docs+'/',*['/'+x for x in paths[sid]]])+'\n')
    git('-c','filter.lfs.process=','-c','filter.lfs.required=false','checkout','-q','-b',existing,base)
    source = old/prior_paths[sid] if sid in ('04','05') else motion/'games'/sid
    game=root/'games'/sid;game.mkdir(parents=True)
    for f in source.iterdir():
        if f.name in ('src','scripts'):shutil.copytree(f,game/f.name,symlinks=True)
        elif f.name in ('assets','references','character_references','public','node_modules'):(game/f.name).symlink_to(f.resolve(),target_is_directory=True)
        elif f.is_file() and f.suffix in ('.ts','.json','.html') and not f.name.startswith('__'):shutil.copyfile(f,game/f.name)
    for f in paths[sid]:
        if (repo/f).exists():assert (repo/f).read_bytes()==(game/f).read_bytes(),f
    manifest=json.loads((motion/'reference-checks.json').read_text())['manifest']
    assert all(hashlib.sha256((game/f).read_bytes()).hexdigest()==expected for f,expected in manifest.items())
    (repo/docs).mkdir(parents=True,exist_ok=True)
    receipt={'screen':sid,'checked':datetime.now(timezone.utc).isoformat(),'lead':lead,'specialist':specialist,'priorCandidate':{'branch':prev,'commit':previous},'branch':existing,'base':base,'referenceManifest':manifest,'ringSpecialist':live['claude/rainbow-s04-ringtex-c17']}
    (root/('base-'+sid+'.json')).write_text(json.dumps(receipt,indent=2))
    print(sid,base,'->',existing,flush=True)
