    if len(a)==1:return z.name in {'.gitattributes','.gitignore','.mcp.json.template'} or z.suffix.lower() in code_ext
    if a[0] in {'src','android','assets','public','scripts','tools','references','character_references','.agents','.claude','docs'}:return True
    if a[0] in {'qa','experiments'}:
        return z.suffix.lower() in (assets_ext|code_ext) or name in depth_paths or (a[0]=='experiments' and 'model' in a and z.suffix.lower() in {'.png','.jpg','.webp'})
    return False
