from pathlib import Path
from collections import Counter,defaultdict
from concurrent.futures import ThreadPoolExecutor
from PIL import Image
import numpy as np,json,hashlib

rows=json.load(open('converted.json'))
early=json.load(open('early-branch-map.json'))
for r in rows:
    if r['section']=='Earlier_Specialist_Audit':
        r['branch']=early.get(r['commit'],r['branch'])
bysha=defaultdict(list)
for r in rows:bysha[r['sha256']].append(r)
chosen=[r for r in rows if r['name']==r['canonical']]
sizes=Counter(r['sha256'] for r in chosen)
budget=197_000_000
total=sum(r['shareSize'] for r in chosen)
def alternative(task):
    hx,q,sub=task; group=bysha[hx];file=Path(group[0]['file']);cached=Path('image-cache')/hx/('q'+str(q)+'s'+str(sub)+'.jpg')
    with Image.open(file) as src:
        rgb=src.convert('RGB')
        if not cached.is_file():rgb.save(cached,'JPEG',quality=q,subsampling=sub,optimize=True,progressive=True)
        with Image.open(cached) as out:
            a=np.asarray(rgb,dtype=np.int16);b=np.asarray(out.convert('RGB'),dtype=np.int16);diff=np.abs(a-b)
            hist=np.bincount(diff.reshape(-1),minlength=256)
            err=round(float(diff.mean()),4);p99=int(np.searchsorted(np.cumsum(hist),diff.size*.99))
    return hx,dict(share=str(cached.resolve()),shareHash=hashlib.sha256(cached.read_bytes()).hexdigest(),shareSize=cached.stat().st_size,
                   quality='JPEG quality '+str(q)+' '+['4:4:4','4:2:2','4:2:0'][sub],meanError=err,p99Error=p99)
for lo,hi,q,sub in [(2,6,89,1),(4,6,86,2),(0,1,93,0),(2,3,87,1),(0,1,92,0),(2,6,85,2)]:
    if total<=budget:break
    keys=[h for h,count in sizes.items() if lo<=min(r['rank'] for r in bysha[h])<=hi and bysha[h][0]['quality']!='original bytes']
    keys.sort(key=lambda h:(-min(r['rank'] for r in bysha[h]),-bysha[h][0]['shareSize']*sizes[h]))
    with ThreadPoolExecutor(max_workers=3) as pool:
        for hx,alt in pool.map(alternative,[(h,q,sub) for h in keys]):
            if total<=budget:continue
            gain=sizes[hx]*(bysha[hx][0]['shareSize']-alt['shareSize'])
            if gain<=0:continue
            for r in bysha[hx]:r.update(alt)
            total-=gain
    print('Budget after',q,sub,round(total/1e6,2),'MB',flush=True)
assert total<=budget,total
assert all(r['quality']=='original bytes' for r in rows if r.get('exact'))
Path('final-images.json').write_text(json.dumps(rows))
print('Image payload',len(chosen),sum(r['shareSize'] for r in chosen),Counter(r['quality'] for r in chosen),max(r['meanError'] for r in chosen))
