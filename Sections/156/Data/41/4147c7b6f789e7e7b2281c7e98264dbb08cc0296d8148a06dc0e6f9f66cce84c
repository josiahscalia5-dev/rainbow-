= true || window.__error, null, { timeout: 300000 });\n  for (const [name, dist, steer] of SHOTS) {\n    const st = await page.evaluate(async ([id, dist, steer]) => {\n      const r = window.__rainbow; r.goto(id);\n      const s0 = r.state().s;\n      const stg = r.course.stage(id);\n      const s1 = stg.s1 ?? (stg.s0 + (stg.length ?? 0));\n      const target = typeof dist === 'string' ? s0 + Number(dist.slice(1)) * Math.max(0, s1 - s0) : s0 + dist;\n      r.setSteer(steer);\n      let n = 0; while (r.state().s < target - 1e-3 && n < 4000) { r.step(1); n++; }\n      r.setSteer(null);\n      r.run(true); await new Promise((res) => requestAnimationFrame(() => requestAnimationFrame(res))); r.run(false);\n      return { ...r.state(), frames: n, s0, s1, target };\n    }, [SCREEN, dist, steer]);\n    await page.waitForTimeout(150);\n    await page.screenshot({ path: `${OUT}/${name}.png` });\n    log.push({ name, dist, steer, ...st });\n    console.log(SCREEN, name, 's', st.s, 'lat', st.lat, 'stage', st.stage, 'frames', st.frames);\n  }\n} finally {\n  writeFileSync(`${OUT}/motion.json`, JSON.stringify({ screen: SCREEN, query: Q, shots: log }, null, 1));\n  await browser.close(); await vite.close?.();\n}\n751 src/world/match08.ts\n#!/usr/bin/env node\n// Lead r13 (2026-11-18): a short REAL-GAMEPLAY swimming clip for any playable screen 04–08 (read-only).\n// Starts at the screen's checkpoint and rides the real game simulation (Benny, camera rig, course, coins unchanged) with\n// the shader clock running: straight, then left, then right, then straight — one frame per 1/fps s → OUT/0000.png …\n// Generalises scripts/proj05-move.mjs --zigzag. Encode: ffmpeg -framerate 24 -i OUT/%04d.png -pix_fmt yuv420p clip.mp4\n//   node tools/lead_r13/swim_clip.mjs <screen 04..08> <outDir> <seconds> [query]\nimport { mkdirSync } from 'node:fs';\nimport { pathToFileURL } from 'node:url';\nconst { loadPlaywright, CHROMIUM_ARGS, startVite } = await import(pathToFileURL(`${process.cwd()}/scrip