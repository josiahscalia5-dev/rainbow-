import json,sys
import numpy as np
from PIL import Image
from pathlib import Path
d=Path('paddle-test');t=json.loads((d/'trial.json').read_text())
def read(p):return np.asarray(Image.open(p).convert('RGB'),dtype=np.int16)
def delta(a,b):
 diff=np.abs(a-b);m=diff.any(-1); y,x=np.where(m);return {'differentPixels':int(m.sum()),'bboxXYXYExclusive':[int(x.min()),int(y.min()),int(x.max()+1),int(y.max()+1)] if len(x) else None,'averageChannelDifferenceInside':round(float(diff[m].mean()),3) if len(x) else 0,'maxChannelDelta':int(diff.max())}
rows={}
for r in t['shots']:
 key=r['name'];a=read(d/f'{key}-before.png');res={}
 for source in ['candidate','repeat','hide-two','hide-far']:
  p=d/f'{key}-{source}.png'
  if p.exists():res[source]=delta(a,read(p))
 rows[key]=res
canonical=read(Path('captures/07/approved.png'))
result={'onePaddle':t['setup'],'canonicalOpeningVsIndependent':delta(canonical,read(Path('fresh/07/fresh-opening.png'))),'canonicalOpeningVsCandidate':delta(canonical,read(Path('fresh/07/candidate-opening.png'))),'poses':rows}
(d/'measurements.json').write_text(json.dumps(result,indent=2))
for k,v in rows.items():print(k,v['candidate']['differentPixels'],v['candidate']['averageChannelDifferenceInside'],v['repeat']['differentPixels'])
