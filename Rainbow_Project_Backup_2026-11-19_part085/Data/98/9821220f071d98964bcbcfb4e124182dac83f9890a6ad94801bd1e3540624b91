const fs = require('node:fs');
const path = require('node:path');
const assert = require('node:assert/strict');
const http = require('node:http');
const { chromium } = require('playwright');

(async () => {
  const review = '/workspace/library-files/Rainbow-Reconstruction-Experiments';
  const gallery = http.createServer((request,response)=>{
    const resource=new URL(request.url,'http://localhost').pathname;
    if (!/^\/Screen-(04|05|06|07|08)\/(index\.html|APPROVED\.jpg|(BEFORE|NEW)\/(opening\.png|inlet\.png|ride\.mp4))$/.test(resource)) {
      response.writeHead(404);response.end();return;
    }
    const file=path.join(review,resource);
    const type={'.html':'text/html','.jpg':'image/jpeg','.png':'image/png','.mp4':'video/mp4'}[path.extname(file)];
    response.writeHead(200,{'Content-Type':type,'Content-Length':fs.statSync(file).size});
    fs.createReadStream(file).pipe(response);
  });
  await new Promise(resolve=>gallery.listen(0,'127.0.0.1',resolve));
  const address='http://127.0.0.1:'+gallery.address().port;
  const browser = await chromium.launch({executablePath:'/usr/bin/chromium', args:['--disable-background-networking']});
  const page = await browser.newPage({viewport:{width:393,height:873}, deviceScaleFactor:1, hasTouch:true, isMobile:true});
  const checks = {};
  try {
    for (const id of ['04','05','06','07','08']) {
      await page.goto(address+'/Screen-'+id+'/index.html', {waitUntil:'load'});
      const state = await page.evaluate(async () => {
        const pictures = [...document.querySelectorAll('figure img')];
        const dimensions = await Promise.all(pictures.map(async image => {
          image.loading='eager';
          await image.decode();
          return [image.naturalWidth,image.naturalHeight];
        }));
        const videos=Array.from(document.querySelectorAll('video'));
        const clips=await Promise.all(videos.map(video=>new Promise((resolve,reject)=>{
          const timeout=setTimeout(()=>reject(new Error('Clip metadata timed out')),10000);
          video.addEventListener('loadedmetadata',()=>{clearTimeout(timeout);resolve([video.videoWidth,video.videoHeight,video.duration]);},{once:true});
          video.addEventListener('error',()=>{clearTimeout(timeout);reject(new Error('Clip failed to load'));},{once:true});
          video.preload='metadata';
          video.load();
        })));
        return {viewport:innerWidth,content:document.documentElement.scrollWidth,dimensions,clips};
      });
      assert.equal(state.viewport,393);
      assert.equal(state.content,state.viewport);
      assert.deepEqual(state.dimensions,[[864,1536],[864,1536],[864,1536]]);
      assert.equal(state.clips.length,2);
      for (const [width,height,seconds] of state.clips) {
        assert.equal(width,324);
        assert.equal(height,576);
        assert.ok(seconds>0);
      }
      checks[id]=state;
    }
  } finally {
    await browser.close();
    await new Promise(resolve=>gallery.close(resolve));
  }
  fs.writeFileSync('portrait-check.json',JSON.stringify(checks,null,2)+'\n');
  console.log('Five review galleries fit a 393-pixel viewport and loaded all 15 images and ten clips');
})().catch(error=>{console.error(error.message);process.exitCode=1;});
