4(), m = new THREE.Matrix4(), q = new THREE.Quaternion(), p = new THREE.Vector3();\n398\t  let k = 0;\n399\t  for (const s of list) {\n400\t    for (const side of [1, -1]) {\n401\t      const f = path.frame(s);\n402\t      const r = path.radius(s);\n403\t      tubeCenterAt(path, s, c);\n404\t      dir.copy(f.right).multiplyScalar(Math.cos(ang) * side).addScaledVector(f.up, Math.sin(ang)).normalize();\n405\t      const sz = size * Math.min(1.4, r / 7.6);\n406\t      // in the cross-section: +X points inward (radially, then drooped toward the stream), +Y is the\n407\t      // hood's top normal, +Z runs along the tube (the D's straight edge)\n408\t      X.copy(f.right).multiplyScalar(-Math.cos(tilt) * side).addScaledVector(f.up, -Math.sin(tilt)).normalize();\n409\t      Y.copy(f.right).multiplyScalar(-Math.sin(tilt) * side).addScaledVector(f.up, Math.cos(tilt)).normalize();\n410\t      Z.crossVectors(X, Y).normalize();\n411\t      basis.makeBasis(X, Y, Z);\n412\t      q.setFromRotationMatrix(basis);\n413\t      p.copy(c).addScaledVector(dir, r - sz * (opts.sink ?? 0.12));\n414\t      if (opts.oval) p.addScaledVector(f.right, (opts.oval(s) - 1) * r * Math.cos(ang) * side);\n415\t      if (opts.skip?.(s, p.clone().addScaledVector(X, sz * 0.5), sz)) continue;\n416\t      m.compose(p, q, new THREE.Vector3(sz, sz, sz * (opts.stretch ?? 1.25)));\n417\t      mesh.setMatrixAt(k++, m);\n418\t    }\n419\t  }\n420\t  mesh.count = k;\n421\t  mesh.instanceMatrix.needsUpdate = true;\n422\t  mesh.frustumCulled = false;\n423\t  return mesh;\n424\t}\n425\t\n426\t/**\n427\t * `?projlid05=1` (src/vfx/proj05Tunnel.ts): the matrix of ONE wall lid with its own parameters, the same placement as\n428\t * buildWallLids (which stays untouched for the default build): side ±1, angle above the axis, droop, size (already\n429\t * radius-scaled by the caller), stretch along the tube, sink into the wall.\n430\t */\n431\texport function wallLidMatrix(path: TubePath, s: number, side: number, angDeg: number, droopDeg: number, size: number, stretch: number, sink: number, out = new THREE.Matrix4()): THREE.Matrix4 {\n432\t  const f = path.frame(s);\n433\t  const r = path.radius(s);\n434\t  const c = tubeCenterAt(path, s, new THREE.Vector3());\n435\t  const b = wallLidBasis(f, side, angDeg, droopDeg);\n436\t  const p = c.addScaledVector(b.dir, r - size * sink);\n437\t  const q = new THREE.Quaternion().setFromRotationMatrix(new THREE.Matrix4().makeBasis(b.X, b.Y, b.Z));\n438\t  return out.compose(p, q, new THREE.Vector3(size, size, size * stretch));\n439\t}\n440\t\n441\t/** Profile of a wall lid (lathe, half revolution toward local +X), centred on its thickness. */\n442\texport function wallLidGeometry(shape: 'hood' | 'dome' | 'slab', h: number, segments?: number): THREE.BufferGeometry {\n443\t  // bottom → top so the lathe normals face outward\n444\t  const prof: [number, number][] = shape === 'dome'\n445\t    ? [\n446\t      [0, 0.06], [0.62, 0.05], [0.7, 0.0], [0.86, -0.04], [1.04, -0.05], [1.08, 0.0], [1.0, 0.06],\n447\t      [0.98, h * 0.55], [0.96, h * 0.82], [0.88, h * 1.02], [0.72, h * 1.18], [0.48, h * 1.3], [0.24, h * 1.36], [0, h * 1.38],\n448\t    ]\n449\t    : shape === 'slab'\n450\t      ? [\n451\t        // flat underside with a shallow recess and an inner ring, rounded lower edge, straight rim band,\n452\t        // rounded upper edge, flat (very slightly crowned) top\n453\t        // (edge rounding scales with the thickness so thin pucks stay valid)\n454\t        // wave 8: ROUNDED puck — the rim band bulges (barrel, radius 0.95 → 1.04 → 0.95) between two rounded\n455\t        // edges, so its smooth normal sweeps up/down across the band and the shading reads a glossy convex\n456\t        // copper-gold rim with a highlight low on the bulge (ref L1 at x 140: peach top edge → orange-gold → pale\n457\t        // yellow → white → orange-red bottom edge) instead of a flat plank; flat recessed underside; domed top\n458\t        [0, 0.1 * h], [0.56, 0.1 * h], [0.62, 0.03 * h], [0.88, 0.0], [0.94, 0.035 * h], [0.975, 0.12 * h],\n459\t        [1.015, 0.3 * h], [1.04, 0.5 * h], [1.015, 0.7 * h], [0.975, 0.86 * h], [0.93, 0.95 * h], [0.86, h],\n460\t        [0.55, h * 1.07], [0, h * 1.1],\n461\t      ]\n462\t      : [\n463\t        [0, 0.09], [0.74, 0.07], [0.82, 0.0], [0.9, -0.03], [0.97, -0.01], [1, 0.05], [1, h * 0.78], [0.95, h * 0.97], [0.82, h * 1.04], [0, h * 1.08],\n464\t      ];\n465\t  // half revolution (phi 0..π → local +X): the open cut face lies in the wall plane x = 0\n466\t  const geo = new THREE.LatheGeometry(prof.map(([x, y]) => new THREE.Vector2(x, y)), segments ?? (shape === 'hood' ? 28 : 24), 0, Math.PI);\n467\t  geo.translate(0, -h * 0.5, 0);\n468\t  return geo;\n469\t}\n470\t\n471\t/** Orientation of a wall lid in a tube cross-section (see buildWallLids): radial direction to the wall\n472\t *  point, inward X (drooped), top normal Y, Z along the tube. */\n473\texport function wallLidBasis(f: Frame, side: number, angDeg: number, droopDeg: number) {\n474\t  const ang = THREE.MathUtils.degToRad(angDeg);\n475\t  const tilt = ang + THREE.MathUtils.degToRad(droopDeg);\n476\t  const dir = f.right.clone().multiplyScalar(Math.cos(ang) * side).addScaledVector(f.up, Math.sin(ang)).normalize();\n477\t  const X = f.right.clone().multiplyScalar(-Math.cos(tilt) * side).addScaledVector(f.up, -Math.sin(tilt)).normalize();\n478\t  const Y = f.right.clone().multiplyScalar(-Math.sin(tilt) * side).addScaledVector(f.up, Math.cos(tilt)).normalize();\n479\t  const Z = new THREE.Vector3().crossVectors(X, Y).normalize();\n480\t  return { dir, X, Y, Z };\n481\t}\n482\t\n483\t/**\n484\t * Forced-perspective far section of the straight 05 tunnel (ref 05: ≈10 concentric rings converging on\n485\t * one small hot spot — far more tunnel than the 72-unit straight holds before the 06 hall). A short real\n486\t * funnel, calibrated for the locked 05 checkpoint camera `eye`, reproduces what a straight tunnel of the\n487\t * same radius