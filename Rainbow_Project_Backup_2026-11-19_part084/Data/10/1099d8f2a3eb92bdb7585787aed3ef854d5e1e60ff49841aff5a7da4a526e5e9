const fs=require('node:fs'),path=require('node:path'),{chromium}=require('playwright');
const {open,pose}=require('./capture.cjs');
(async()=>{
 const dst=path.join(__dirname,'outlet-diagnostics');fs.mkdirSync(dst,{recursive:true});
 const b=await chromium.launch({executablePath:'/usr/bin/chromium',args:['--use-angle=swiftshader','--enable-unsafe-swiftshader','--disable-background-networking']});
 try{for(const variant of ['NEW']){
   const errors=[],p=await open(b,'07',variant,{width:432,height:768},errors);
   const dir=path.join(dst,variant);fs.mkdirSync(dir,{recursive:true});
   const geometry=await p.evaluate(async()=>{
     const r=window.__rainbow;r.goto('07');r.drawList();
     const mesh=r.qa3d().scene.getObjectByName('foam_berm');
     const p=mesh.geometry.attributes.position, f=mesh.geometry.attributes.aFoam || mesh.geometry.attributes.aF;
     if(!f)throw Error('Foam attributes '+Object.keys(mesh.geometry.attributes));
     const s0=r.course.stage('08').s0,s1=r.course.stage('08').s1;
     const groups={upstream:[],chamber:[],following:[]};
     for(let i=0;i<p.count;i++){
       const s=f.getY(i);const region=s<=s0?'upstream':s>=s1?'following':'chamber';
       groups[region].push(p.getX(i),p.getY(i),p.getZ(i));
     }
     const hashes={};for(const [k,coords]of Object.entries(groups)){
       const digest=await crypto.subtle.digest('SHA-256',new Float32Array(coords));
       hashes[k]={vertices:coords.length/3,sha256:Array.from(new Uint8Array(digest),n=>n.toString(16).padStart(2,'0')).join('')};
     }
     return {bounds:[s0,s1],groups:hashes,mesh:mesh.name};
   });fs.writeFileSync(path.join(dir,'geometry.json'),JSON.stringify(geometry,null,2)+'\n');
   for(const row of [['plunge-bottom','drop',.97],['last-in-stage','exit',-.45],['across-transition','exit',.65]]){
     await pose(p,'07',row);
     for(const part of ['all','berm-off','foam-off','water-ribbon-off']){
       await p.evaluate(part=>{
         const r=window.__rainbow,d=r.qa3d();if(window.__undo)window.__undo();
         const name={'berm-off':'foam_berm','foam-off':'foam_banks','water-ribbon-off':'water_ribbon'}[part];
         if(name){const o=d.scene.getObjectByName(name);if(!o)throw Error(name);const v=o.visible;o.visible=false;window.__undo=()=>{o.visible=v;window.__undo=null};}
         r.drawList();
       },part);
       await p.screenshot({path:path.join(dir,row[0]+'-'+part+'.png'),animations:'disabled'});
     }
     await p.evaluate(()=>window.__undo?.());
   }
   await p.close();if(errors.length)throw Error(errors.join('\n'));console.log('Outlet diagnostic',variant);
 }}finally{await b.close()}
})().catch(e=>{console.error(e);process.exitCode=1});
