, -0.08, 0.03];\n416\tconst FOOT_L: E3 = [0.31, -0.65, 0.27];\n417\tconst FOOT_R: E3 = [-0.31, -0.65, 0.27];\n418\t\n419\tfunction buildClips(): THREE.AnimationClip[] {\n420\t  const N = 12;\n421\t  const tau = Math.PI * 2;\n422\t  // idle\n423\t  const ti = loop(N, 2.4);\n424\t  const idle = new THREE.AnimationClip('idle', 2.4, [\n425\t    vTrack('body', 'position', ti, ti.map((t) => [0, Math.sin((t / 2.4) * tau) * 0.015, 0])),\n426\t    qTrack('armL', ti, ti.map((t) => [0, 0, Math.sin((t / 2.4) * tau) * 0.08])),\n427\t    qTrack('armR', ti, ti.map((t) => [0, 0, -Math.sin((t / 2.4) * tau) * 0.08])),\n428\t    qTrack('footL', ti, ti.map(() => [0, 0, 0])),\n429\t    qTrack('footR', ti, ti.map(() => [0, 0, 0])),\n430\t    qTrack('body', ti, ti.map(() => [0, 0, 0])),\n431\t  ]);\n432\t  // swim — paws paddle, feet kick, body bobs (0.6 s loop)\n433\t  const D = 0.6;\n434\t  const ts = loop(N, D);\n435\t  const ph = (t: number) => (t / D) * tau;\n436\t  const swim = new THREE.AnimationClip('swim', D, [\n437\t    vTrack('body', 'position', ts, ts.map((t) => [0, Math.abs(Math.sin(ph(t))) * 0.04 - 0.01, 0])),\n438\t    qTrack('body', ts, ts.map((t) => [Math.sin(ph(t) * 2) * 0.03, 0, Math.sin(ph(t)) * 0.05])),\n439\t    qTrack('armL', ts, ts.map((t) => [Math.sin(ph(t)) * 0.75, 0, 0.25 + Math.cos(ph(t)) * 0.2])),\n440\t    qTrack('armR', ts, ts.map((t) => [Math.sin(ph(t) + Math.PI) * 0.75, 0, -0.25 - Math.cos(ph(t) + Math.PI) * 0.2])),\n441\t    qTrack('footL', ts, ts.map((t) => [Math.sin(ph(t) + Math.PI) * 0.5, 0, 0])),\n442\t    qTrack('footR', ts, ts.map((t) => [Math.sin(ph(t)) * 0.5, 0, 0])),\n443\t  ]);\n444\t  // tumble — paws flail up, feet kick fast (caller spins the root)\n445\t  const T = 1.0;\n446\t  const tt = loop(N, T);\n447\t  const pt = (t: number) => (t / T) * tau;\n448\t  const tumble = new THREE.AnimationClip('tumble', T, [\n449\t    vTrack('body', 'position', tt, tt.map(() => [0, 0, 0])),\n450\t    qTrack('body', tt, tt.map((t) => [0, 0, Math.sin(pt(t)) * 