itle": "CoordinateFrame", "type": "object"}, "LinearDepthBufferAsset": {"additionalProperties": false, "description": "Linear-depth EXR (URL or inline asset).", "properties": {"confidenceAsset": {"anyOf": [{"$ref": "#/$defs/TaskAsset"}, {"type": "null"}], "default": null, "description": "Optional 8-bit grayscale PNG on the depth grid whose pixel value / 255 is the per-pixel depth confidence in [0, 1], as a URL or inline asset."}, "depthAsset": {"$ref": "#/$defs/TaskAsset", "description": "EXR of linear depth in world units, as a URL or inline asset."}}, "required": ["depthAsset"], "title": "LinearDepthBufferAsset", "type": "object"}, "LogDepthBufferAsset": {"additionalProperties": false, "description": "Inverted log-depth PNG (URL or inline asset) plus its decode range.", "properties": {"confidenceAsset": {"anyOf": [{"$ref": "#/$defs/TaskAsset"}, {"type": "null"}], "default": null, "description": "Optional 8-bit grayscale PNG on the depth grid whose pixel value / 255 is the per-pixel depth confidence in [0, 1], as a URL or inline asset."}, "logDepthAsset": {"$ref": "#/$defs/TaskAsset", "description": "Inverted log-depth grayscale PNG, as a URL or inline asset."}, "zMax": {"description": "Linear depth in world units encoded as black (>0).", "title": "Zmax", "type": "number"}, "zMin": {"description": "Linear depth in world units encoded as white (1.0).", "title": "Zmin", "type": "number"}}, "required": ["logDepthAsset", "zMin", "zMax"], "title": "LogDepthBufferAsset", "type": "object"}, "PinholeCamera": {"additionalProperties": false, "description": "A posed pinhole camera.\n\nThe axes convention of the pose is carried by\n``extrinsics.coordinate_system``.", "properties": {"extrinsics": {"$ref": "#/$defs/CoordinateFrame"}, "intrinsics": {"$ref": "#/$defs/PinholeCameraIntrinsics"}}, "required": ["extrinsics", "intrinsics"], "title": "PinholeCamera", "type": "object"}, "PinholeCameraIntrinsics": {"additionalProperties": false, "description": "Pinhole camera intrinsics in pixel coordinates (not normalized).\n\nPixel coordinates have their origin (0, 0) at the top-left corner of the\nimage, +x right and +y down, so ``cx``/``cy`` measure from the top-left.\n``width`` and ``height`` are the image size in pixels the intrinsics\nrefer to. This is independent of the pose's ``coordinate_system``.", "properties": {"cx": {"title": "Cx", "type": "number"}, "cy": {"title": "Cy", "type": "number"}, "fx": {"title": "Fx", "type": "number"}, "fy": {"title": "Fy", "type": "number"}, "height": {"title": "Height", "type": "integer"}, "width": {"title": "Width", "type": "integer"}}, "required": ["fx", "fy", "cx", "cy", "width", "height"], "title": "PinholeCameraIntrinsics", "type": "object"}, "PosedRGBDAsset": {"additionalProperties": false, "description": "A posed frame carrying both its RGB image and its depth buffer.", "properties": {"camera": {"$ref": "#/$defs/PinholeCamera", "description": "Camera-to-world pose and intrinsics."}, "depth": {"anyOf": [{"$ref": "#/$defs/LogDepthBufferAsset"}, {"$ref": "#/$defs/LinearDepthBufferAsset"}], "description": "Depth buffer aligned to the camera.", "title": "Depth"}, "imageAsset": {"$ref": "#/$defs/TaskAsset", "description": "Source image as a URL or inline asset."}, "maskAsset": {"anyOf": [{"$ref": "#/$defs/TaskAsset"}, {"type": "null"}], "default": null, "description": "Optional alpha mask as a URL or inline asset: an 8-bit grayscale PNG on the image grid whose pixel value / 255 is the alpha in [0, 1] (1 = kept, 0 = excluded). Null when the frame carries no mask."}}, "required": ["imageAsset", "camera", "depth"], "title": "PosedRGBDAsset", "type": "object"}, "TaskAsset": {"additionalProperties": false, "description": "Media named by asset id, inline base64, or public URL.\n\nA task response names each output by id and url together: the url expires,\nthe id does not. The pair is accepted as input as well, so a response can\nbe handed straight back to the next task; the id names the media and the\nurl is ignored. Inline base64 stands alone. A response returns it only\nwhen a task is answered at submission; the stored operation names the\nsame output by id and url.", "properties": {"assetId": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Account-owned asset id, e.g. `asset_...`.", "title": "Assetid"}, "base64": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Base64-encoded media bytes, with or without a data URL prefix. Decoded size must be less than 10 MiB. A task response carries inline bytes only when it is returned from the submission; the stored operation names the same output by `assetId` and `url`.", "title": "Base64"}, "url": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Public HTTP(S) URL containing the media. On a task response this is a read URL for `assetId` and it expires; mint a fresh one with `assets/{asset}:createReadUrl`.", "title": "Url"}}, "title": "TaskAsset", "type": "object"}}, "properties": {"idempotency_key": {"description": "A unique string you choose for this request and reuse on retries of it.", "maxLength": 128, "minLength": 8, "title": "Idempotency Key", "type": "string"}, "project_id": {"description": "A project_id from list_projects.", "maxLength": 64, "minLength": 1, "title": "Project Id", "type": "string"}, "request": {"description": "The task's request.", "properties": {"base64Outputs": {"default": false, "description": "When a ?wait=true submission is answered inline, return each output file as base64 in that response rather than by assetId and url. This skips storing the files before the answer and the caller's download after it. Any other submission, and every later read of the operation, names the outputs by assetId and url.", "title": "Base64Outputs", "type": "boolean"}, "contextFrames": {"description": "Posed RGBD context views: each an image, its depth buffer, and its camera, all required. All context cameras must declare the same width and height. Context depth is required and provides geometry references for generation. Undistort fisheye or lens-distorted images before upload, and align depth and camera intrinsics to the resulting pinhole image grid.", "items": {"$ref": "#/$defs/PosedRGBDAsset"}, "minItems": 1, "title": "Contextframes", "type": "array"}, "enhancePrompt": {"default": true, "description": "Expand the prompt into a scene description before generation. With no prompt, describe the context images. Set false to use your wording unchanged.", "title": "Enhanceprompt", "type": "boolean"}, "modelParameters": {"$ref": "#/$defs/AtlasGenerateModelParameters", "description": "Model-specific parameters for atlasGenerate."}, "prompt": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Optional description of the scene's content and appearance, for example \"A quiet stone courtyard at blue hour\". Do not use editing instructions such as \"add a car to the scene\" or camera-trajectory descriptions such as \"rotate around the person\".", "title": "Prompt"}, "purgeContentOnOperationCompletion": {"anyOf": [{"type": "boolean"}, {"type": "null"}], "default": null, "description": "Purge this operation's outputs and the transient uploads it consumed one hour after it finishes. Omitted, the account's setting applies; true raises it for this operation; false is refused when the account already purges. Uploads in the library are never purged by an operation.", "title": "Purgecontentonoperationcompletion"}, "returnDepth": {"default": false, "description": "Return the generated frames as posed RGBD in the request's camera frame and scale; every entry in `frames` then carries a `depth` buffer. A request whose cameras all share one center (a pure-rotation rig) is rejected because depth scale requires a camera baseline. For 720x1280 targets, more than 11 context frames, or more than 32 target cameras, depth is reconstructed after generation: context and target cameras must share an aspect ratio, and every target principal point must be within 5% of the image center along each axis, or the request is rejected. A context image anchors that reconstruction only when its principal point is centered. Other requests do not require these additional aspect-ratio and principal-point checks.", "title": "Returndepth", "type": "boolean"}, "targetCameras": {"description": "Pinhole cameras for the views to generate, in output order. Generated frames are returned in `frames`, one per camera. All cameras share one size (width x height): 1280x720, 960x720, 528x704, or 720x1280. Camera intrinsics use a pinhole model; lens-distortion coefficients are not accepted.", "items": {"$ref": "#/$defs/PinholeCamera"}, "minItems": 1, "title": "Targetcameras", "type": "array"}, "webhookUrl": {"anyOf": [{"maxLength": 2048, "type": "string"}, {"type": "null"}], "default": null, "description": "Where Atlas POSTs one signed task.succeeded or task.failed event when this operation finishes; retried for 24 hours. Verify the signature with the public keys at /.well-known/webhooks/jwks.json. Cannot be combined with ?wait=true. https on port 443 only, no IP literals. Developer API only.", "title": "Webhookurl"}}, "required": ["contextFrames", "targetCameras"], "title": "AtlasGenerateRequest", "type": "object"}}, "required": ["project_id", "request", "idempotency_key"], "title": "runArguments", "type": "object"}, "name": "mcp__World_Labs_Atlas__atlasGenerate"}, {"defer_loading": true, "description": "Estimate the camera (intrinsics and pose) and a per-pixel depth map with confidence for each of one or more images of a scene. The results are estimates and carry no measured physical scale. For an image from create_image_upload, upload its bytes first. Uses the project's World Labs Developer API credits. Returns an operation immediately; poll get_operation for the result. Reuse the same idempotency_key when retrying so the work is not submitted twice. Guide: https://docs.atlas.worldlabs.ai/images-to-posed-images.md", "eager_input_streaming": true, "input_schema": {"$defs": {"CoordinateFrame": {"additionalProperties": false, "description": "Pose represented by a position and an XYZW quaternion.\n\n``coordinate_system`` names the axes convention the pose is expressed in:\n``rub`` (right-up-back, the OpenGL/Three.js convention) or ``rdf``\n(right-down-forward, the OpenCV convention). Both the ``coordinateSystem``\n(camelCase) and ``coordinate_system`` spellings are accepted.", "properties": {"coordinateSystem": {"default": "rub", "enum": ["rub", "rdf"], "title": "Coordinatesystem", "type": "string"}, "position": {"maxItems": 3, "minItems": 3, "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "title": "Position", "type": "array"}, "quaternion": {"maxItems": 4, "minItems": 4, "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "title": "Quaternion", "type": "array"}}, "required": ["position", "quaternion"], "title": "CoordinateFrame", "type": "object"}, "FrameRGBAsset": {"additionalProperties": false, "description": "A frame whose RGB image is always present; camera stays optional.", "properties": {"camera": {"anyOf": [{"$ref": "#/$defs/PinholeCamera"}, {"type": "null"}], "default": null, "description": "Optional camera-to-world pose and intrinsics."}, "depth": {"anyOf": [{"$ref": "#/$defs/LogDepthBufferAsset"}, {"$ref": "#/$defs/LinearDepthBufferAsset"}, {"type": "null"}], "default": null, "description": "Optional depth buffer, as an inverted log-depth PNG (logDepthAsset) or a linear-depth EXR (depthAsset).", "title": "Depth"}, "imageAsset": {"$ref": "#/$defs/TaskAsset", "description": "Source image as a URL or inline asset."}, "maskAsset": {"anyOf": [{"$ref": "#/$defs/TaskAsset"}, {"type": "null"}], "default": null, "description": "Optional alpha mask as a URL or inline asset: an 8-bit grayscale PNG on the image grid whose pixel value / 255 is the alpha in [0, 1] (1 = kept, 0 = excluded). Null when the frame carries no mask."}}, "required": ["imageAsset"], "title": "FrameRGBAsset", "type": "object"}, "LinearDepthBufferAsset": {"additionalProperties": false, "description": "Linear-depth EXR (URL or inline asset).", "properties": {"confidenceAsset": {"anyOf": [{"$ref": "#/$defs/TaskAsset"}, {"type": "null"}], "default": null, "description": "Optional 8-bit grayscale PNG on the depth grid whose pixel value / 255 is the per-pixel depth confidence in [0, 1], as a URL or inline asset."}, "depthAsset": {"$ref": "#/$defs/TaskAsset", "description": "EXR of linear depth in world units, as a URL or inline asset."}}, "required": ["depthAsset"], "title": "LinearDepthBufferAsset", "type": "object"}, "LogDepthBufferAsset": {"additionalProperties": false, "description": "Inverted log-depth PNG (URL or inline asset) plus its decode range.", "properties": {"confidenceAsset": {"anyOf": [{"$ref": "#/$defs/TaskAsset"}, {"type": "null"}], "default": null, "description": "Optional 8-bit grayscale PNG on the depth grid whose pixel value / 255 is the per-pixel depth confidence in [0, 1], as a URL or inline asset."}, "logDepthAsset": {"$ref": "#/$defs/TaskAsset", "description": "Inverted log-depth grayscale PNG, as a URL or inline asset."}, "zMax": {"description": "Linear depth in world units encoded as black (>0).", "title": "Zmax", "type": "number"}, "zMin": {"description": "Linear depth in world units encoded as white (1.0).", "title": "Zmin", "type": "number"}}, "required": ["logDepthAsset", "zMin", "zMax"], "title": "LogDepthBufferAsset", "type": "object"}, "PinholeCamera": {"additionalProperties": false, "description": "A posed pinhole camera.\n\nThe axes convention of the pose is carried by\n``extrinsics.coordinate_system``.", "properties": {"extrinsics": {"$ref": "#/$defs/CoordinateFrame"}, "intrinsics": {"$ref": "#/$defs/PinholeCameraIntrinsics"}}, "required": ["extrinsics", "intrinsics"], "title": "PinholeCamera", "type": "object"}, "PinholeCameraIntrinsics": {"additionalProperties": false, "description": "Pinhole camera intrinsics in pixel coordinates (not normalized).\n\nPixel coordinates have their origin (0, 0) at the top-left corner of the\nimage, +x right and +y down, so ``cx``/``cy`` measure from the top-left.\n``width`` and ``height`` are the image size in pixels the intrinsics\nrefer to. This is independent of the pose's ``coordinate_system``.", "properties": {"cx": {"title": "Cx", "type": "number"}, "cy": {"title": "Cy", "type": "number"}, "fx": {"title": "Fx", "type": "number"}, "fy": {"title": "Fy", "type": "number"}, "height": {"title": "Height", "type": "integer"}, "width": {"title": "Width", "type": "integer"}}, "required": ["fx", "fy", "cx", "cy", "width", "height"], "title": "PinholeCameraIntrinsics", "type": "object"}, "TaskAsset": {"additionalProperties": false, "description": "Media named by asset id, inline base64, or public URL.\n\nA task response names each output by id and url together: the url expires,\nthe id does not. The pair is accepted as input as well, so a response can\nbe handed straight back to the next task; the id names the media and the\nurl is ignored. Inline base64 stands alone. A response returns it only\nwhen a task is answered at submission; the stored operation names the\nsame output by id and url.", "properties": {"assetId": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Account-owned asset id, e.g. `asset_...`.", "title": "Assetid"}, "base64": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Base64-encoded media bytes, with or without a data URL prefix. Decoded size must be less than 10 MiB. A task response carries inline bytes only when it is returned from the submission; the stored operation names the same output by `assetId` and `url`.", "title": "Base64"}, "url": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Public HTTP(S) URL containing the media