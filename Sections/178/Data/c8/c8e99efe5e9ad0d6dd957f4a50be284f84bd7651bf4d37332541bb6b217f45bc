ort?.[5] ?? 1) },\n40\t    uTime: { value: 0 },\n41\t    uWind: { value: new THREE.Vector3() },\n42\t  };\n43\t  const material = new THREE.MeshStandardMaterial({ color: '#ffffff', roughness: 0.9, metalness: 0 });\n44\t  material.onBeforeCompile = (shader) => {\n45\t    Object.assign(shader.uniforms, uniforms);\n46\t    shader.vertexShader = shader.vertexShader\n47\t      .replace(\n48\t        '#include <common>',\n49\t        `#include <common>\n50\t        uniform float uFurLen; uniform float uGravity; uniform vec4 uBald;\n51\t        uniform vec3 uShortDir; uniform vec3 uShort; uniform float uTime; uniform vec3 uWind;\n52\t        varying float vLayer; varying vec3 vBase; varying float vLenMask;`,\n53\t      )\n54\t      .replace(\n55\t        '#include <begin_vertex>',\n56\t        `#include <begin_vertex>\n57\t        vLayer = float(gl_InstanceID) / float(${shells - 1});\n58\t        vec3 nrm = normalize(objectNormal);\n59\t        float bald = 1.0 - smoothstep(uBald.w - 0.04, uBald.w + 0.01, dot(nrm, normalize(uBald.xyz)));\n60\t        float sh = mix(1.0, uShort.z, smoothstep(uShort.x, uShort.y, dot(nrm, normalize(uShortDir))));\n61\t        vLenMask = bald * sh;\n62\t        vBase = position;\n63\t        float h = uFurLen * vLayer * vLenMask;\n64\t        transformed += nrm * h;\n65\t        // gravity droop + gentle wind sway grows with layer height\n66\t        vec3 g = vec3(0.0, -1.0, 0.0) * uGravity + uWind;\n67\t        g += vec3(sin(uTime * 3.0 + position.y * 9.0), 0.0, cos(uTime * 2.3 + position.x * 7.0)) * 0.06;\n68\t        transformed += g * uFurLen * vLayer * vLayer * vLenMask;`,\n69\t      );\n70\t    shader.fragmentShader = shader.fragmentShader\n71\t      .replace(\n72\t        '#include <common>',\n73\t        `#include <common>\n74\t        uniform float uDensity; uniform vec3 uRoot; uniform vec3 uTip;\n75\t        varying float vLayer; varying vec3 vBase; varying float vLenMask;\n76\t        float fhash(vec3 p) { p = fract(p * 0.3183099 + 0.1); p *= 17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); }\n77\t        vec3 fhash3(vec3 p) { return vec3(fhash(p), fhash(p + 17.31), fhash(p + 41.7)); }`,\n78\t      )\n79\t      .replace(\n80\t        '#include <color_fragment>',\n81\t        `#include <color_fragment>\n82\t        {\n83\t          vec3 q = vBase * uDensity;\n84\t          // clumping: strands lean toward low-frequency tuft centres as they rise → plush tufts\n85\t          vec3 qc = q * 0.2;\n86\t          vec3 cc = (floor(qc) + 0.5 + (fhash3(floor(qc)) - 0.5) * 0.7) / 0.2;\n87\t          q = mix(q, cc, vLayer * 0.42);\n88\t          vec3 cell = floor(q);\n89\t          float best = 10.0; float hgt = 0.0;\n90\t          // nearest strand among this + neighbouring cells (gives round, jittered strands)\n91\t          for (int k = 0; k < 8; k++) {\n92\t            vec3 o = vec3(float(k & 1), float((k >> 1) & 1), float((k >> 2) & 1));\n93\t            vec3 c = floor(q - 0.5) + o;\n94\t            vec3 jp = c + 0.5 + (fhash3(c) - 0.5) * 0.8;\n95\t            float d = length(q - jp);\n96\t            if (d < best) { best = d; hgt = fhash(c * 1.7 + 3.1); }\n97\t          }\n98\t          float layer = vLayer;\n99\t          if (layer > 0.001) {\n100\t            if (vLenMask < 0.05) discard;\n101\t            float strandH = 0.55 + 0.45 * hgt;\n102\t            float radius = 0.78 * (1.0 - 0.85 * layer / strandH);\n103\t            if (layer > strandH || best > radius) discard;\n104\t          }\n105\t          float ao = mix(0.55, 1.0, smoothstep(0.0, 0.9, layer));\n106\t          diffuseColor.rgb = mix(uRoot, uTip, smoothstep(0.0, 1.0, layer)) * ao * (0.92 + 0.16 * hgt);\n107\t        }`,\n108\t      )\n109\t      .replace(\n110\t        '#include <emissivemap_fragment>',\n111\t        `#include <emissivemap_fragment>\n112\t        totalEmissiveRadiance += diffuseColor.rgb * 0.10 * vLayer;`,\n113\t      );\n114\t  };\n115\t  material.customProgramCacheKey = () => `benny-fur-${shells}`;\n116