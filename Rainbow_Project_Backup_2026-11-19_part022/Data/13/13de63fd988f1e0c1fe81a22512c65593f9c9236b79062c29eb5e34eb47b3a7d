{"cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-61131b9d-uj0oqb", "isSidechain": false, "message": {"content": [{"content": "1\t\"\"\"Screen 05 proj05 — bake the TARGET water image (tools/proj05/make_target.py) onto the REAL game river, in the\n2\triver's own coordinates (u across -1..1, s = arc length), using the live game's per-pixel river coordinates from the\n3\tlocked 05 camera (scripts/proj05-probe.mjs -> uv_river.f32). Everything is anchored to the river, not to the camera.\n4\t\n5\tusage: python3 -I tools/proj05/bake.py <probe_dir> <target_dir> <out_dir>\n6\toutputs (out_dir, default assets/textures/water05/):\n7\t  proj05_E.png   EXACT layer: the approved water at ~screen resolution; rows follow s with the locked view's own\n8\t                 density, columns span the locked view's visible u-range per row (lookup in proj05_lut.json); alpha = valid\n9\t  proj05_N.png   NEAR layer: same water, full river width, uniform 24 texels per unit of s for s in [sN0, sN1]; alpha = coverage\n10\t  proj05_T.png   TILE layer: seamless periodic copy of the full-width mid river (s period L) for the rest of Screen 05\n11\t  proj05_D.png   DETAIL layer: luminance high-pass of the sharpest near water (the approved streaks / glints), seamless\n12\t                 in u and s, 0.5 = no change\n13\t  proj05_F.png   FAR layer: the far river block (far05.ts) in its own (uv.x, log depth) coordinates; alpha = valid\n14\t  proj05_lut.json  s -> (V, centre u, half range u) for proj05_E + all layer extents\n15\tcoins are filled along the flow (s direction) in river space.\"\"\"\n16\timport json, os, sys\n17\timport numpy as np\n18\tfrom PIL import Image\n19\tfrom scipy.ndimage import gaussian_filter, gaussian_filter1d, binary_dilation, binary_erosion\n20\t\n21\tprobe, tdir, out = sys.argv[1], sys.argv[2], sys.argv[3]\n22\tos.makedirs(out, exist_ok=True)\n23\tW, H = 864, 1536\n24\tR = np.fromfile(os.path.join(probe, \"uv_river.f32\"), np.float32).reshape(H, W, 4).astype(np.float64)\n25\tsurf = np.abs(R[..., 2] - 1) < 0.01\n26\twm = np.asarray(Image.open(os.path.join(tdir, \"water_mask.png\"))) > 127\n27\t# coins are filled in the target from the user's artwork (make_target.py); the along-s hole filling below stays for gaps\n28\tcoin = np.zeros((H, W), bool)\n29\ttgt = np.asarray(Image.open(os.path.join(tdir, \"target_05.png\")).convert(\"RGB\"), np.float64) / 255\n30\t# colour feedback from the live capture (tools/proj05/residual.py): what the bloom pass adds is taken out of the bake\n31\tif os.path.exists(os.path.join(tdir, \"correction.npz\")):\n32\t    tgt = np.clip(tgt - np.load(os.path.join(tdir, \"correction.npz\"))[\"c\"].astype(np.float64), 0, 1)\n33\tU, S = R[..., 0], R[..., 1]\n34\tS_CUT = 182.0                                   # the real ribbon ends behind the far block's seam\n35\tuse = surf & wm & (S < S_CUT)\n36\tys, xs = np.nonzero(use)\n37\tsu, ss, sc, scoin = U[use], S[use], tgt[use], coin[use]\n38\t# locked-view density along s (screen rows per unit s), per pixel\n39\tdsy = np.abs(np.gradient(S, axis=0))\n40\t\n41\t# ---------------------------------------------------------------- E (exact) layer\n42\tsE0, sE1 = float(ss.min()) - 0.02, float(ss.max()) + 0.02\n43\tNL = 2048\n44\tsg = np.linspace(sE0, sE1, NL)\n45\tbin_i = np.clip(((ss - sE0) / (sE1 - sE0) * (NL - 1)).round().astype(int), 0, NL - 1)\n46\tumin = np.full(NL, np.nan); umax = np.full(NL, np.nan); dens = np.full(NL, np.nan)\n47\torder = np.argsort(bin_i); bi = bin_i[order]\n48\tstarts = np.searchsorted(bi, np.arange(NL)); ends = np.searchsorted(bi, np.arange(NL), side=\"right\")\n49\tdsel = dsy[use][order]; usel = su[order]\n50\tfor k in range(NL):\n51\t    a, b = starts[k], ends[k]\n52\t    if b - a >= 3:\n53\t        uu = usel[a:b]\n54\t        umin[k], umax[k] = uu.min(), uu.max()\n55\t        dens[k] = 1.0 / max(np.median(dsel[a:b]), 1e-4)\n56\tdef fill_nan(v):\n57\t    i = np.arange(len(v)); ok = np.isfinite(v)\n58\t    return np.interp(i, i[ok], v[ok])\n59\tumin, umax, dens = fill_nan(umin), fill_nan(umax), fill_nan(dens)\n60\t# u-range: running min / max over +-6 bins, then smooth (no wiggles), 1.5 % margin\n61\tfrom scipy.ndimage import minimum_filter1d, maximum_filter1d\n62\tumin = gaussian_filter1d(minimum_filter1d(umin, 25), 6) - 0.015\n63\tumax = gaussian_filter1d(maximum_filter1d(umax, 25), 6) + 0.015\n64\tumin, umax = np.clip(umin, -1, 1), np.clip(umax, -1, 1)\n65\tcE, wE = (umin + umax) / 2, np.maximum((umax - umin) / 2, 0.02)\n66\tdens = np.exp(gaussian_filter1d(np.log(np.clip(dens, 1, 400)), 8))\n67\ttex_d = np.maximum(dens * 1.3, 8.0)                  # texel rows per unit s (>= 8: the far rows stay sharp at the locked eye)\n68\tcum = np.concatenate([[0], np.cumsum((tex_d[1:] + tex_d[:-1]) / 2 * np.diff(sg))])\n69\tNE = int(min(2048, np.ceil(cum[-1])))\n70\tV = cum / cum[-1]\n71\tWE = 1024\n72\tdef e_coords(u, s):\n73\t    v = np.interp(s, sg, V); c = np.interp(s, sg, cE); w = np.interp(s, sg, wE)\n74\t    return (0.5 + (u - c) / (2 * w)) * WE - 0.5, v * NE - 0.5\n75\t\n76\tdef splat(xf, yf, col, Wt, Ht):\n77\t    acc = np.zeros((Ht, Wt, col.shape[1])); wt = np.zeros((Ht, Wt))\n78\t    x0 = np.floor(xf).astype(int); y0 = np.floor(yf).astype(int); fx = xf - x0; fy = yf - y0\n79\t    for dx, dy, ww in ((0, 0, (1 - fx) * (1 - fy)), (1, 0, fx * (1 - fy)), (0, 1, (1 - fx) * fy), (1, 1, fx * fy)):\n80\t        xi, yi = x0 + dx, y0 + dy\n81\t        ok = (xi >= 0) & (xi < Wt) & (yi >= 0) & (yi < Ht)\n82\t        np.add.at(acc, (yi[ok], xi[ok]), col[ok] * ww[ok, None]); np.add.at(wt, (yi[ok], xi[ok]), ww[ok])\n83\t    return acc, wt\n84\t\n85\tdef finish(acc, wt, holew, fill_sigma=1.2, along_axis=0, max_gap=400, fill_all=False):\n86\t    \"\"\"normalise; fill tiny gaps by normalised blur; coin holes by linear interpolation along s (axis 0).\"\"\"\n87\t    img = acc / np.maximum(wt, 1e-9)[..., None]\n88\t    valid = wt > 0.2\n89\t    hole = holew > np.maximum(wt, 1e-9) * 0.5         # coin pixels dominate this texel\n90\t    valid &= ~hole\n91\t    blur_w = gaussian_filter(valid.astype(float), fill_sigma)\n92\t    blur_c = np.stack([gaussian_filter(np.where(valid, img[..., i], 0), fill_sigma) for i in range(img.shape[2])], -1)\n93\t    gap = (~valid) & (blur_w > 0.12) & ~binary_dilation(hole, iterations=1)\n94\t    img[gap] = (blur_c / np.maximum(blur_w, 1e-6)[..., None])[gap]\n95\t    valid = valid | gap\n96\t    # coin holes: interpolate along s (columns), between valid texels at both ends\n97\t    hole_t = (binary_dilation(hole, iterations=2) & ~valid | hole) if not fill_all else (~valid | hole)\n98\t    Ht, Wt = valid.shape\n99\t    filled = np.zeros_like(valid)\n100\t    for x in range(Wt):\n101\t        col_h = hole_t[:, x]\n102\t        if not col_h.any(): continue\n103\t        vcol = valid[:, x] & ~col_h\n104\t        idx = np.nonzero(vcol)[0]\n105\t        if len(idx) < 2: continue\n106\t        hy = np.nonzero(col_h)[0]\n107\t        lo = np.searchsorted(idx, hy) - 1; hi = lo + 1\n108\t        ok = (lo >= 0) & (hi < len(idx))\n109\t        hy, lo, hi = hy[ok], lo[ok], hi[ok]\n110\t        y0_, y1_ = idx[lo], idx[hi]\n111\t        ok = (y1_ - y0_) <= max_gap\n112\t        hy, y0_, y1_ = hy[ok], y0_[ok], y1_[ok]\n113\t        t = ((hy - y0_) / np.maximum(y1_ - y0_, 1))[:, None]\n114\t        img[hy, x] = img[y0_, x] * (1 - t) + img[y1_, x] * t\n115\t        filled[hy, x] = True\n116\t    # soften the interpolated stripes across u a little\n117\t    if filled.any():\n118\t        sm = np.stack([gaussian_filter(img[..., i], (0.6, 1.5)) for i in range(img.shape[2])], -1)\n119\t        img[filled] = sm[filled]\n120\t    valid = valid | filled\n121\t    finish.filled = filled\n122\t    return img, valid\n123\t\n124\txE, yE = e_coords(su, ss)\n125\taccE, _ = splat(xE, yE, np.where(scoin[:, None], 0, sc), WE, NE)\n126\tholeE, _ = splat(xE, yE, scoin[:, None].astype(float), WE, NE)\n127\twtE, _ = splat(xE, yE, (~scoin)[:, None].astype(float), WE, NE)\n128\tE, validE = finish(accE, wtE[..., 0], holeE[..., 0], max_gap=int(NE * 0.35))\n129\talphaE = gaussian_filter(binary_erosion(validE, iterations=1).astype(float), 0.8)\n130\t\n131\t# ---------------------------------------------------------------- N (near, full width) layer\n132\tsN0, sN1, dN, WN = 126.0, 166.0, 24, 512\n133\tNN = int((sN1 - sN0) * dN)\n134\txN = (su + 1) / 2 * WN - 0.5; yN = (ss - sN0) * dN - 0.5\n135\taccN, _ = splat(xN, yN, np.where(scoin[:, None], 0, sc), WN, NN)\n136\tholeN, _ = splat(xN, yN, scoin[:, None].astype(float), WN, NN)\n137\twtN, _ = splat(xN, yN, (~scoin)[:, None].astype(float), WN, NN)\n138\tN_, validN = finish(accN, wtN[..., 0], holeN[..., 0], fill_sigma=1.5, max_gap=int(12 * dN), fill_all=True)\n139\trealN = validN & ~finish.filled                    # texels that saw real approved water (not coin / gap fills)\n140\t# fill the remaining (unseen) gaps inside N by a wide normalised blur, but keep them flagged as weak\n141\tcovN = gaussian_filter(validN.astype(float), 3.0)\n142\talphaN = np.clip((covN - 0.35) / 0.5, 0, 1)\n143\t# where the locked eye saw the river only at low density (far rows) the near layer would be a blurred copy: the\n144\t# crisp tile takes over there (rows weighted by the locked view's own density, < 6 rows / unit -> 0, > 14 -> 1)\n145\tsrow = sN0 + (np.arange(NN) + 0.5) / dN\n146\talphaN *= np.clip((np.interp(srow, sg, dens) - 6.0) / 8.0, 0, 1)[:, None]\n147\t\n148\t# ---------------------------------------------------------------- T (periodic tile) layer\n149\t# the crisp near river (s 134-151: hot-pink ribbons and cyan core at high locked density), as LAYOUT (the detail layer\n150\t# adds the fine streaks): rows interpolated; the bank the locked eye does not see is the mirror of the other bank, then\n151\t# the column mean, with smooth weights (no hard fill edges); periodic with a 3-unit crossfade at the wrap\n152\ta_s, L, b = 134.0, 14.0, 3.0\n153\tNT = int(L * dN)\n154\tdef rows_at(img, s_):\n155\t    y = np.clip((s_ - sN0) * dN - 0.5, 0, NN - 1.001); y0 = np.floor(y).astype(int); f = (y - y0)[:, None]\n156\t    return img[y0] * (1 - f[..., None] if img.ndim == 3 else 1 - f) + img[y0 + 1] * (f[..., None] if img.ndim == 3 else f)\n157\tsl = a_s + (np.arange(NT) + 0.5) / dN\n158\t# the tile trusts only texels that saw real water; everything else is first replaced by its column mean\n159\tcolmeanN = (N_ * realN[..., None]).sum(0) / np.maximum(realN.sum(0), 1)[:, None]\n160\tN_t = np.where(realN[..., None], N_, colmeanN[None])\n161\tvN = np.clip((gaussian_filter(realN.astype(float), 2.0) - 0.5) * 2, 0, 1)\n162\tdef layer(s_):\n163\t    c = rows_at(N_t, s_); w = rows_at(vN, s_)\n164\t    cm, wm_ = c[:, ::-1], w[:, ::-1]                      # mirrored bank\n165\t    colmean = (c * w[..., None]).sum(0) / np.maximum(w.sum(0), 1e-6)[:, None]\n166\t    w1 = np.clip(w, 0, 1); w2 = np.clip(wm_, 0, 1) * (1 - w1)\n167\t    w3 = np.clip(1 - w1 - w2, 0, 1)\n168\t    return (c * w1[..., None] + cm * w2[..., None] + colmean[None] * w3[..., None]) / np.maximum(w1 + w2 + w3, 1e-6)[..., None]\n169\tT_ = layer(sl)\n170\tblendr = sl - a_s < b\n171\tr = ((sl[blendr] - a_s) / b)[:, None, None]\n172\tT_[blendr] = layer(sl[blendr] + L) * (1 - r) + T_[blendr] * r\n173\tT_ = np.stack([gaussian_filter(T_[..., i], (3.0, 1.5), mode=(\"wrap\", \"nearest\")) for i in range(3)], -1)\n174\t\n175\t# ---------------------------------------------------------------- D (detail) layer\n176\t# streaky, glinting water under Benny (the user's isolated artwork, no bubbles or coins): s in [131.5, 134.3], u in [-0.18, 0.18]\n177\tdu0, du1, ds0, ds1 = -0.18, 0.18, 131.5, 134.3\n178\tND = 512\n179\tm = (su > du0 - 0.03) & (su < du1 + 0.03) & (ss > ds0 - 0.1) & (ss < ds1 + 0.1)\n180\tlum = (sc[m] * np.array([0.2126, 0.7152, 0.0722])).sum(1)\n181\tpad = 0.12                                    # crossfade fraction for seamless wrap\n182\tWd = int(ND * (1 + pad)); Hd = int(ND * (1 + pad))\n183\txd = (su[m] - du0) / (du1 - du0) * Wd - 0.5\n184\tyd = (ss[m] - ds0) / (ds1 - ds0) * Hd - 0.5\n185\taccD, wtD = splat(xd, yd, lum[:, None], Wd, Hd)\n186\tDimg = accD[..., 0] / np.maximum(wtD, 1e-9)\n187\tokD = wtD > 0.05\n188\tbw = gaussian_filter(okD.astype(float), 1.5); bc = gaussian_filter(np.where(okD, Dimg, 0), 1.5)\n189\tDimg = np.where(okD, Dimg, bc / np.maximum(bw, 1e-6))\n190\thp = Dimg - gaussian_filter(Dimg, 14)          # high-pass: streaks, glints\n191\tp = int(ND * pad)\n192\tdef wrap_axis(a, axis):\n193\t    a = np.moveaxis(a, axis, 0)\n194\t    n = a.shape[0] - p\n195\t    outa = a[:n].copy()\n196\t    r = (np.arange(p) / p)[:, None]\n197\t    outa[:p] = a[n:n + p] * (1 - r) + a[:p] * r\n198\t    return np.moveaxis(outa, 0, axis)\n199\thpw = wrap_axis(wrap_axis(hp, 0), 1)\n200\tD = np.clip(0.5 + hpw * 1.0, 0, 1)\n201\t\n202\t# ---------------------------------------------------------------- F (far river block) layer\n203\t# the forced-perspective far river (far05.ts): its own coordinates (uv.x across the floor chord, virtual depth Z)\n204\tfarm = (np.abs(R[..., 2] - 3) < 0.01) & wm\n205\tfx_, fz_ = R[..., 0][farm], R[..., 1][farm]\n206\tfcol, fcoin = tgt[farm], coin[farm]\n207\tZMAX = float(max(fz_.max(), 1.0)) if farm.any() else 400.0\n208\tWF_, HF_ = 512, 512\n209\txF = fx_ * WF_ - 0.5; yF = np.log1p(np.maximum(fz_, 0)) / np.log1p(ZMAX) * HF_ - 0.5\n210\taccF, _ = splat(xF, yF, np.where(fcoin[:, None], 0, fcol), WF_, HF_)\n211\tholeF, _ = splat(xF, yF, fcoin[:, None].astype(float), WF_, HF_)\n212\twtF, _ = splat(xF, yF, (~fcoin)[:, None].astype(float), WF_, HF_)\n213\tF_, validF = finish(accF, wtF[..., 0], holeF[..., 0], fill_sigma=1.5, max_gap=80, fill_all=True)\n214\talphaF = np.clip((gaussian_filter(validF.astype(float), 1.5) - 0.3) / 0.5, 0, 1)\n215\t\n216\t# ---------------------------------------------------------------- A (bank strip) layer\n217\t# the visual-only strip on the lower wall (src/vfx/proj05Apron.ts): x = 0.5 + 0.5 * t * side, y = s over [A_S0, A