{"agentId": "af52c8cdde18a37b5", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-4f6c3e0e-5kxgr0", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * Rainbow water system (water-fx-specialist + foam-bubbles-particles).\n3\t *\n4\t *   const water = createWater(course, { quality: 'high' });\n5\t *   scene.add(water.group);\n6\t *   // per frame:\n7\t *   water.update(time, dt, bennyS, camera);\n8\t *   water.wake(bennyBodyCentre, forward, right, speed, dt);   // centre of the (lifted) body, not the root\n9\t *   // cinematic controls (0..1): water.controls.drumSwirl / drumAgitation / outro\n10\t *\n11\t * Benny rides ON the water: place his body centre at\n12\t *   course.pointAt(s, lateral, water.surfaceHeight(s, lateral, time) + BENNY_RIDE_OFFSET)\n13\t * (BENNY_RIDE_OFFSET ≈ 0.55 for a 0.8-radius body: bottom third in the water, splash visible).\n14\t */\n15\timport * as THREE from 'three';\n16\timport { type Course, WORLD, funnelY } from '../world/course';\n17\timport { createRibbon } from './waterRibbon';\n18\timport { createWhirlpool, whirlpoolHeight, FUNNEL_LIFT } from './whirlpool';\n19\timport { createDrumWater } from './drumWater';\n20\timport { createFinalWave } from './finalWave';\n21\timport { createPuddles } from './puddles';\n22\timport { createFoam } from './foam';\n23\timport { createBubbles } from './bubbles';\n24\timport { createSpray } from './spray';\n25\timport { createRiderSplash, FAN } from './riderSplash';\n26\t\n27\texport { PALETTE } from './glsl';\n28\texport const BENNY_RIDE_OFFSET = 0.55;\n29\t/** Benny's outer (fur) radius near the waterline: skin 0.7 + fur 0.12 + lower-body bulge (benny/build.ts BENNY_DIMS) */\n30\tconst BENNY_OUTER_R = 0.86;\n31\t\n32\texport interface WaterControls {\n33\t  /** 02 tumble: spinning water shell on the Drum A wall (0..1) */\n34\t  drumSwirl: number;\n35\t  /** Drum A swell size: 0 calm (01) .. 1 spin cycle (02) */\n36\t  drumAgitation: number;\n37\t  /** 11 outro: stream drains away (0..1) and leftover puddles appear */\n38\t  outro: number;\n39\t}\n40\t\n41\texport interface WaterSystem {\n42\t  group: THREE.Group;\n43\t  /** call every frame; focusS = Benny's arc-length (for pooling/LOD of bubbles & foam) */\n44\t  update(time: number, dt: number, focusS: number, camera: THREE.Camera): void;\n45\t  /** height of the animated water surface above the course centreline frame at (s, lateral) */\n46\t  surfaceHeight(s: number, lateral: number, time: number): number;\n47\t  /** spray/wake at Benny: call each frame while riding */\n48\t  wake(pos: THREE.Vector3, forward: THREE.Vector3, right: THREE.Vector3, speed: number, dt: number): void;\n49\t  splash(pos: THREE.Vector3, up: THREE.Vector3, strength: number): void;\n50\t  /** cinematic controls */\n51\t  controls: WaterControls;\n52\t  /** sub-systems (for visibility overrides / debugging) */\n53\t  parts: Record<string, THREE.Object3D>;\n54\t  /** live stats for perf reporting */\n55\t  stats(): { instances: number; bubbles: number; smallBubbles: number; sprayCapacity: number };\n56\t}\n57\t\n58\tconst smooth = (a: number, b: number, x: number) => {\n59\t  const t = Math.min(1, Math.max(0, (x - a) / (b - a)));\n60\t  return t * t * (3 - 2 * t);\n61\t};\n62\t\n63\texport function createWater(course: Course, opts: { quality?: 'high' | 'low' } = {}): WaterSystem {\n64\t  const quality = opts.quality ?? 'high';\n65\t  const group = new THREE.Group();\n66\t  group.name = 'water_system';\n67\t\n68\t  const drainMark = course.marks['02_drain'] ?? course.stage('02').s1 - 2;\n69\t  const st03 = course.stage('03'), st04 = course.stage('04'), st08 = course.stage('08'), st09 = course.stage('09');\n70\t  const ribbonS0 = drainMark - 1;\n71\t  const ribbon = createRibbon(course, { s0: ribbonS0, s1: course.length, quality });\n72\t  // open the funnel where the 04 slide tube leaves the basin (the course exits the spiral at\n73\t  // r≈2.8, just outside the drain hole, and the slide then runs beneath the funnel surface)\n74\t  const cutPts: THREE.Vector3[] = [];\n75\t  for (let i = 0; i < 8; i++) {\n76\t    const s = st04.s0 - 3 + (i / 7) * 34;\n77\t    const f = course.sample(s);\n78\t    cutPts.push(f.pos.clone().addScaledVector(f.up, 1.2));\n79\t  }\n80\t  const whirl = createWhirlpool(quality, { points: cutPts, radius: Math.max(3.6, course.stage('04').tube * 0.85) });\n81\t  const drum = createDrumWater(quality);\n82\t  const wave = createFinalWave(course, quality);\n83\t  const puddles = createPuddles();\n84\t  const foam = createFoam(course, { s0: ribbonS0, s1: course.length, quality, height: (s, lat, t) => ribbon.heightAt(s, lat, t) });\n85\t  const bubbles = createBubbles(course, { quality, sStart: ribbonS0 });\n86\t  const spray = createSpray(quality);\n87\t  const crown = createRiderSplash(quality);\n88\t  group.add(ribbon.mesh, whirl.mesh, drum.group, wave.mesh, puddles.group, foam.group, bubbles.group, spray.points, crown.mesh);\n89\t\n90\t  const parts: Record<string, THREE.Object3D> = { ribbon: ribbon.mesh, whirlpool: whirl.mesh, drum: drum.group, drumSwirl: drum.swirl, finalWave: wave.mesh, puddles: puddles.group, foam: foam.group, foamBerm: foam.berm, foamRafts: foam.rafts, foamFlank: foam.flank, bubbles: bubbles.group, bubblesSmall: bubbles.small, bubblesBig: bubbles.big, spray: spray.points, splashCrown: crown.mesh };\n91\t  const controls: WaterControls = { drumSwirl: 0, drumAgitation: 0, outro: 0 };\n92\t  // QA: ?waterhide=crown,spray,bubbles,foam,foamBerm,ribbon … hides water parts (isolation captures)\n93\t  const qaHide = typeof location !== 'undefined' ? (new URLSearchParams(location.search).get('waterhide') ?? '').split(',').filter(Boolean) : [];\n94\t  /** `waterhide=ribbonWake`: keep the ribbon but switch off its Benny contact/wake block */\n95\t  const qaNoRibbonWake = qaHide.includes('ribbonWake');\n96\t  let focus = 0;\n97\t  let curTime = 0;\n98\t  const tmpV = new THREE.Vector3();\n99\t  const tmpV2 = new THREE.Vector3();\n100\t  const tmpV3 = new THREE.Vector3();\n101\t  // spray fan scratch (no per-frame allocation)\n102\t  const sprP = new THREE.Vector3();\n103\t  const sprV = new THREE.Vector3();\n104\t  const back = new THREE.Vector3();\n105\t  const lastWake = new THREE.Vector3();\n106\t  const riderVel = new THREE.Vector3();\n107\t  let lastWakeT = -1;\n108\t  // seeded RNG for the spray: re-seeded whenever Benny jumps (checkpoint / respawn), so QA frames are\n109\t  // deterministic and comparable between runs\n110\t  let seed = 0x5eed;\n111\t  const rand = () => {\n112\t    seed = (seed + 0x6d2b79f5) >>> 0;\n113\t    let t = seed;\n114\t    t = Math.imul(t ^ (t >>> 15), t | 1);\n115\t    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n116\t    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n117\t  };\n118\t  const rnd = (a: number, b: number) => a + rand() * (b - a);\n119\t  let lastFocusSeed = -1e9;\n120\t  let qaCamera: THREE.Camera | null = null;\n121\t\n122\t  /** 0 = ribbon fully shown, 1 = whirlpool surface takes over (mirrors the ribbon vertex shader) */\n123\t  const whirlBlend = (s: number) => smooth(st03.s0 + 0.5, st03.s0 + 3.5, s) * (1 - smooth(st04.s0 - 9, st04.s0 - 1.5, s));\n124\t\n125\t  const surfaceHeight = (s: number, lateral: number, t: number): number => {\n126\t    if (s < ribbonS0) {\n127\t      // Drum A: absolute swell height relative to the course point\n128\t      const p = course.pointAt(s, lateral, 0, tmpV);\n129\t      const up = course.sample(s).up;\n130\t      return (drum.heightAt(p.x, p.z, t) - p.y) / Math.max(0.3, up.y);\n131\t    }\n132\t    const hr = ribbon.heightAt(s, lateral, t);\n133\t    const k = whirlBlend(s);\n134\t    if (k <= 0) return hr;\n135\t    const f = course.sample(s);\n136\t    const p = tmpV.copy(f.pos).addScaledVector(f.right, lateral);\n137\t    const b = WORLD.basin;\n138\t    const r = Math.hypot(p.x - b.center.x, p.z - b.center.z);\n139\t    const yW = funnelY(r) + FUNNEL_LIFT + whirlpoolHeight(p.x, p.z, t);\n140\t    const hw = (yW - p.y) / Math.max(0.3, f.up.y);\n141\t    return hr * (1 - k) + hw * k;\n142\t  };\n143\t\n144\t  // QA (?qa=1): window.__waterQA() reports what the VFX put on screen (bubble sizes/positions, foam\n145\t  // rafts) for the capture scripts; read-only, nothing is allocated unless it is called\n146\t  if (typeof window !== 'undefined' && new URLSearchParams(location.search).has('qa')) {\n147\t    (window as unknown as { __waterQA: () => unknown }).__waterQA = () => {\n148\t      const cam = qaCamera as THREE.PerspectiveCamera | null;\n149\t      if (!cam) return null;\n150\t      const w = window.innerWidth, h = window.innerHeight;\n151\t      return { bubbles: bubbles.qaScreen(cam, w, h), rafts: foam.qaRafts(), fanStrength: crown.uniforms.uStrength.value, waterlineR: ribbon.uniforms.uBennyR.value };\n152\t    };\n153\t  }\n154\t\n155\t  return {\n156\t    group,\n157\t    controls,\n158\t    parts,\n159\t    surfaceHeight,\n160\t    stats: () => ({ instances: foam.instanceCount, bubbles: bubbles.counts.big, smallBubbles: bubbles.counts.small, sprayCapacity: spray.capacity }),\n161\t    update(time, dt, focusS, camera) {\n162\t      if (Math.abs(focusS - lastFocusSeed) > 25) seed = 0x5eed ^ Math.round(focusS * 16);\n163\t      lastFocusSeed = focusS;\n164\t      qaCamera = camera;\n165\t      focus = focusS;\n166\t      curTime = time;\n167\t      ribbon.uniforms.uTime.value = time;\n168\t      whirl.uniforms.uTime.value = time;\n169\t      drum.uniforms.uTime.value = time;\n170\t      drum.uniforms.uAgitation.value = controls.drumAgitation;\n171\t      drum.swirlUniforms.uSwirl.value = controls.drumSwirl;\n172\t      drum.swirl.visible = controls.drumSwirl > 0.001;\n173\t      wave.uniforms.uTime.value = time;\n174\t      puddles.uniforms.uTime.value = time;\n175\t      puddles.uniforms.uAmount.value = controls.outro;\n176\t      (ribbon.uniforms.uOutro.value as THREE.Vector2).x = controls.outro;\n177\t      puddles.group.visible = controls.outro > 0.001;\n178\t      // region visibility (perf): only what the camera around focusS can see\n179\t      drum.group.visible = focusS < st03.s0 + 12;\n180\t      whirl.mesh.visible = focusS > drainMark - 8 && focusS < st04.s0 + 45;\n181\t      wave.mesh.visible = focusS > st08.s0 - 25;\n182\t      // when Benny is off the ribbon (drum / whirlpool), no ribbon wake\n183\t      if (focusS < ribbonS0 || whirlBlend(focusS) > 0.5) (ribbon.uniforms.uBenny.value as THREE.Vector3).z = 0;\n184\t      foam.update(time, dt, focusS, controls.outro, camera);\n185\t      bubbles.update(time, dt, focusS, camera, 1 - 0.7 * controls.outro);\n186\t      // crest spray off the final wave\n187\t      if (wave.mesh.visible && focusS > st09.s0 - 20 && focusS < st09.s1 + 20 && controls.outro < 0.5) {\n188\t        const n = quality === 'high' ? 3 : 1;\n189\t        for (let i = 0; i < n; i++) {\n190\t          const c = wave.crest[(rand() * wave.crest.length) | 0];\n191\t          if (!c) break;\n192\t          const f = course.sample(Math.min(course.length, Math.max(0, focusS)));\n193\t          tmpV2.copy(f.right).multiplyScalar(rnd(1, 3.5)).addScaledVector(f.up, rnd(1.5, 4)).addScaledVector(f.tan, rnd(-1, 2));\n194\t          spray.emit(c, tmpV2, rnd(0.08, 0.2), rnd(0.5, 1.0));\n195\t        }\n196\t      }\n197\t      spray.update(dt, camera);\n198\t      crown.update(time, dt);\n199\t      for (const k of qaHide) { const o = parts[k]; if (o) o.visible = false; }\n200\t    },\n201\t    wake(pos, forward, right, speed, dt) {\n202\t      // Benny's arc length / lateral from his actual position (focus lags one frame)\n203\t      const f0 = course.sample(Math.max(0, focus));\n204\t      const d = tmpV3.copy(pos).sub(f0.pos);\n205\t      const s = Math.min(course.length, Math.max(0, focus + d.dot(f0.tan)));\n206\t      const f = course.sample(s);\n207\t      d.copy(pos).sub(f.pos);\n208\t      const lateral = d.dot(f.right);\n209\t      // pos = Benny's real body centre (Game.ts passes it AFTER the runtime's ride lift). The waterline\n210\t      // radius is the chord of the fluffy ball at the water surface, so the contact foam, the crown and\n211\t      // the ribbon wake hug his actual footprint. (Deriving the radius from `above / BENNY_RIDE_OFFSET`\n212\t      // made it grow with the lift and drew a white contact band ~2x wider than the body.)\n213\t      const above = d.dot(f.up) - surfaceHeight(s, lateral, curTime);\n214\t      const waterlineR = Math.sqrt(Math.max(BENNY_OUTER_R * BENNY_OUTER_R - above * above, (0.35 * BENNY_OUTER_R) ** 2));\n215\t      const strength = Math.min(1, speed / 8);\n216\t      if (s >= ribbonS0 && whirlBlend(s) < 0.5 && !qaNoRibbonWake) {\n217\t        (ribbon.uniforms.uBenny.value as THREE.Vector3).set(s, lateral, strength);\n218\t        ribbon.uniforms.uBennyR.value = waterlineR;\n219\t      }\n220\t      // 3D V spray fans thrown back and outward from the waterline (ref 05)\n221\t      const center = tmpV.copy(pos).addScaledVector(f.up, -above);\n222\t      crown.place(center, forward, f.up, waterlineR, strength);\n223\t      // Benny's measured velocity: droplets inherit it so the fan stays attached to him instead of\n224\t      // trailing 4-6 units back toward the chase camera (the old white spots at the frame bottom).\n225\t      // QA checkpoints hold him still, so the measured velocity is 0 there as well.\n226\t      if (lastWakeT >= 0 && dt > 1e-4 && lastWake.distanceToSquared(pos) < 9) riderVel.copy(pos).sub(lastWake).divideScalar(dt);\n227\t      else riderVel.set(0, 0, 0);\n228\t      lastWake.copy(pos);\n229\t      lastWakeT = curTime;\n230\t      // droplets thrown off the two streak fans: rooted on the flanks at the waterline and flying\n231\t      // back-outward along the same jet directions as riderSplash.ts (FAN), a short hop above the water\n232\t      // (ref 05: fine 3–12 px droplets all round the fans, a few flung up beside the body)\n233\t      const rate = (quality === 'high' ? 150 : 