{"cwd": "/home/user/rainbow-", "entrypoint": "remote", "gitBranch": "claude/rainbow-s06-match-c2", "isSidechain": false, "message": {"content": [{"content": "=== make_plate04.py\n\"\"\"Screen 04 (?match04=1): texture plate = the user's ORIGINAL approved pixels; PROVISIONAL local fill (OpenCV\ninpainting, Telea) only where the HUD bar, title banner, Benny and the five coins are (the game draws those itself).\nA fal nano-banana-2/edit clean plate is prepared (qa/match/04/FAL_PLATE_REQUEST.md) but NOT run.\nAlso cuts the material patches for unseen surfaces (tunnel rings, water, room wall) from the artwork.\nusage: python3 -I tools/match04/make_plate04.py <approved.png> <out dir>\"\"\"\nimport sys, json\nimport numpy as np, cv2\n\nsrc, out = sys.argv[1], sys.argv[2]\nA = cv2.imread(src, cv2.IMREAD_COLOR); H, W = A.shape[:2]\nM = np.zeros((H, W), np.uint8)\n# HUD bar + title banner (rounded pills)\ncv2.rectangle(M, (55, 12), (808, 108), 255, -1)\ncv2.rectangle(M, (98, 112), (768, 190), 255, -1)\n# Benny: pom-pom, beanie (with star), body + paws; down to where his fur meets the water\ncv2.ellipse(M, (400, 1032), (84, 78), 0, 0, 360, 255, -1)\ncv2.ellipse(M, (395, 1160), (172, 92), 0, 0, 360, 255, -1)\ncv2.ellipse(M, (392, 1290), (224, 130), 0, 0, 360, 255, -1)\n# the picture's coins (centre, diameter): they are real pickups in the game\nCOINS = [(175, 970, 112), (262, 872, 82), (330, 792, 58), (378, 742, 40), (423, 712, 26)]\nfor x, y, d in COINS:\n    cv2.ellipse(M, (x, y), (int(d * 0.62), int(d * 0.58)), 0, 0, 360, 255, -1)\nM = cv2.dilate(M, np.ones((7, 7), np.uint8))\nfill = cv2.inpaint(A, M, 9, cv2.INPAINT_TELEA)\n# texture the large fills: low frequencies from the inpainting (colour continuity), high frequencies from a mirrored\n# tiling of an artwork patch (swirling water under Benny, room/foam under the HUD) so moving views see texture, not smears\ndef tiled(patch, h, w):\n    p = np.concatenate([patch, patch[:, ::-1]], 1); p = np.concatenate([p, p[::-1]], 0)\n    return np.tile(p, (h // p.shape[0] + 1, w // p.shape[1] + 1, 1))[:h, :w].astype(np.float32)\ndef hi(img, s=10): img = img.astype(np.float32); return img - cv2.GaussianBlur(img, (0, 0), s)\nlow = cv2.GaussianBlur(fill.astype(np.float32), (0, 0), 10)\ntex = np.zeros_like(low)\ntex[:200] = hi(tiled(A[230:330, 590:700], 200, W))[:200]           # room / foam above, under the HUD + title\ntex[200:] = hi(tiled(A[1110:1250, 30:180], H - 200, W))             # swirling cyan/pink water left of Benny (Benny, coins)\nfilled = np.clip(low + 0.85 * tex, 0, 255)\na = cv2.GaussianBlur(M.astype(np.float32) / 255, (0, 0), 3)[..., None]\nplate = np.clip(A * (1 - a) + filled * a, 0, 255).astype(np.uint8)\ncv2.imwrite(f\"{out}/plate04_hybrid.png\", plate)\ncv2.imwrite(f\"{out}/plate04_fillmask.png\", M)\n# material patches cut from the ORIGINAL artwork (mirrored-repeat tiled in the shader)\ncv2.imwrite(f\"{out}/patch_gold.png\", A[560:700, 600:720])      # inner tunnel rings (gold bands)\ncv2.imwrite(f\"{out}/patch_water.png\", A[1110:1250, 30:180])     # swirling cyan/pink water (no foam)\ncv2.imwrite(f\"{out}/patch_wall.png\", A[300:420, 560:700])       # pink room wall / foam edge\njson.dump({\"filled_share\": float((M > 0).mean()), \"coins_px\": COINS}, open(f\"{out}/plate04.json\", \"w\"), indent=1)\nprint(\"filled share\", (M > 0).mean())\n=== make_tiles04.py\n\"\"\"Screen 04 (?match04=1): design tiles UNWRAPPED from the approved artwork through the locked camera, for the views the\napproved picture never resolved (moving camera deep in the tunnel / close to the water):\n  tile_tunnel.png  the painted gold rings on the tunnel wall, angle 0..pi (upper half, mirrored in the shader) x one ring\n                   band along the axis (TUN_A from the mouth) - follows the ring geometry, no stretching along the walls\n  tile_river.png   the painted cyan river with ONE chevron arrow, lateral -4..4 u x RIV_A along the slide (repeats down the\n                   slide, flows in the shader)\nSource = plate04_hybrid.png (original pixels; coins/Benny filled). usage: python3 -I tools/match04/make_tiles04.py <dir>\"\"\"\nimport json, math, sys\nimport numpy as np, cv2\nd = sys.argv[1]\nL = json.load(open(f\"{d}/proj04.json\"))\nW, H = L[\"camera\"][\"size\"]; t = math.tan(math.radians(L[\"camera\"][\"fov\"]) / 2); asp = W / H\nMW = np.array(L[\"camera\"][\"matrixWorld\"]).reshape(4, 4).T; C = MW[:3, 3]; R = MW[:3, :3]\nD, U, X = (np.array(L[k], float) for k in \"DUX\"); base = np.array(L[\"water\"], float); T = L[\"tube\"]\nA = cv2.imread(f\"{d}/plate04_hybrid.png\").astype(np.float32)\nTUN_A, RIV_A, RIV_X = (1.0, 5.5), (8.8, 14.8), (-4.0, 4.0)\ndef proj(P):\n    q = (P - C) @ R; return ((q[..., 0] / -q[..., 2] / (t * asp) + 1) / 2 * W).astype(np.float32), ((1 - q[..., 1] / -q[..., 2] / t) / 2 * H).astype(np.float32)\ndef sharpen(img, s=2.0, k=0.6): return np.clip(img + k * (img - cv2.GaussianBlur(img, (0, 0), s)), 0, 255)\n# tunnel: rows = angle 0 (right) .. pi (left) over the top, columns = axial distance from the mouth\nth = np.linspace(0, np.pi, 1024); a = np.linspace(*TUN_A, 256)\nAA, TH = np.meshgrid(a, th)\ncen = np.array(T[\"mouth\"], float)\nP = cen + AA[..., None] * D + T[\"r\"] * (np.cos(TH)[..., None] * X + np.sin(TH)[..., None] * U)\nu, v = proj(P); tun = cv2.remap(A, u, v, cv2.INTER_CUBIC)\ncv2.imwrite(f\"{d}/tile_tunnel.png\", sharpen(tun).astype(np.uint8))\n# river: rows = along the slide (far at the top: t grows down the slide), columns = lateral\nx = np.linspace(*RIV_X, 512); a = np.linspace(*RIV_A, 512)\nXX, AA = np.meshgrid(x, a)\nP = base + XX[..., None] * X + AA[..., None] * D\nu, v = proj(P); riv = cv2.remap(A, u, v, cv2.INTER_CUBIC)\n# make the along-slide repeat seamless: cross-fade the last 12 % into the first rows\nn = int(0.12 * riv.shape[0]); w = np.linspace(0, 1, n)[:, None, None]\nriv[-n:] = riv[-n:] * (1 - w) + riv[:n] * w\ncv2.imwrite(f\"{d}/tile_river.png\", sharpen(riv).astype(np.uint8))\njson.dump({\"tunnel\": {\"angle\": [0, math.pi], \"axialFromMouth\": TUN_A, \"size\": [256, 1024]}, \"river\": {\"lateral\": RIV_X, \"alongFromBenny\": RIV_A, \"size\": [512, 512]}},\n          open(f\"{d}/tiles04.json\", \"w\"), indent=1)\nprint(\"tiles written\")\n=== coins04.py\n\"\"\"Screen 04 (?match04=1): the approved picture's five coins as real pickups at the painted spots.\nEach painted coin (centre px, diameter px) is a ray from the locked camera; the coin (1 u diameter x scale) sits where\nits painted size and its bottom edge on the water agree (bottom on the slide's water plane), expressed as course\ns / lateral / height (coins.ts). usage: python3 -I tools/match04/coins04.py <proj04.json> <s of the cam04 water point> <out coins04.json>\"\"\"\nimport json, sys, math\nimport numpy as np\nL = json.load(open(sys.argv[1])); s_cp = float(sys.argv[2])\nW, H = L[\"camera\"][\"size\"]; fov = L[\"camera\"][\"fov\"]; t = math.tan(math.radians(fov) / 2); asp = W / H; F = (H / 2) / t\nMW = np.array(L[\"camera\"][\"matrixWorld\"]).reshape(4, 4).T; C = MW[:3, 3]; R = MW[:3, :3]\nD, U, X, base = (np.array(L[k], float) for k in (\"D\", \"U\", \"X\", \"water\"))\ndef ray(u, v):\n    d = R @ np.array([(u / W * 2 - 1) * t * asp, (1 - v / H * 2) * t, -1.0]); return d / np.linalg.norm(d)\nCOINS = [(175, 970, 112), (262, 872, 82), (330, 792, 58), (378, 742, 40), (423, 712, 26)]\nout = []\nfor u, v, d in COINS:\n    r = ray(u, v); best = None\n    for k in np.arange(2, 80, 0.01):\n        P = C + k * r; sc = d * k / F                       # painted diameter at that depth (world units)\n        h = (P - base) @ U                                  # centre height above the water plane\n        e = abs(h - 0.5 * sc * 1.0)                         # bottom edge on the water\n        if best is None or e < best[0]: best = (e, k, P, sc, h)\n    e, k, P, sc, h = best\n    # painted perspective puts the coins on the bank beyond the tunnel wall: as in match08, slide each coin along its own\n    # view ray (same pixel in the approved view) to the nearest depth within pickup reach (|lateral| <= 1.6 = inside the river, >= 0.3 above\n    # the water, >= 1 u ahead of the checkpoint, inside stage 04); its size scales with the depth so it still covers the painted coin\n    if abs((P - base) @ X) > 1.6 or s_cp + (P - base) @ D < s_cp + 1.0:\n        pick = None\n        for f in np.arange(0.15, 1.0, 0.002):\n            Q = C + k * f * r; lat = (Q - base) @ X; hq = (Q - base) @ U; sq = s_cp + (Q - base) @ D\n            if abs(lat) <= 1.6 and hq >= 0.3 + 0.5 * sc * f and s_cp + 1.0 <= sq < 112 and (pick is None or f > pick[0]): pick = (f, Q, hq)\n        if pick: f, P, h = pick; k *= f; sc *= f\n    out.append({\"px\": [u, v, d], \"s\": s_cp + float((P - base) @ D), \"lat\": float((P - base) @ X), \"h\": float(h), \"scale\": float(sc), \"dist\": float(k), \"pos\": P.tolist()})\njson.dump({\"note\": \"Screen 04 approved picture coins from the locked ?match04=1 camera (tools/match04/coins04.py, 2026-11-17)\", \"faceTo\": C.tolist(), \"coins\": out}, open(sys.argv[3], \"w\"), indent=1)\nfor c in out: print({k: (round(v, 3) if isinstance(v, float) else v) for k, v in c.items() if k != \"pos\"})\n=== motion04.mjs\n// Screen 04 moving-camera test (read-only): from the 04 checkpoint ride forward / steer with the real game sim and\n// screenshot what the live camera sees. usage: node tools/match04/motion04.mjs <outDir> [q]\nimport { mkdirSync, writeFileSync } from 'node:fs';\nimport { loadPlaywright, CHROMIUM_ARGS, startVite } from '../../scripts/lib/pw.mjs';\nconst OUT = process.argv[2]; const Q = process.argv[3] ?? 'match04=1';\nmkdirSync(OUT, { recursive: true });\nconst { chromium } = loadPlaywright();\nconst vite = await startVite(5268);\nconst browser = await chromium.launch({ args: CHROMIUM_ARGS });\nconst log = [];\ntry {\n  const page = await browser.newPage({ viewport: { width: 864, height: 1536 }, deviceScaleFactor: 1 });\n  page.on('pageerror', (e) => console.error('pageerror', e.message));\n  await page.goto(`${vite.url}/?qa=1&dpr=1&${Q}`);\n  await page.waitForFunction(() => window.__rainbow?.ready === true || window.__error, null, { timeout: 240000 });\n  // [name, forward distance (u), steer]\n  const shots = [['f00_checkpoint', 0, null], ['f03_forward3u', 3, null], ['f06_forward6u', 6, null], ['f10_forward10u', 10, null],\n                 ['f20_forward20u', 20, null], ['s_left_steer', 6, -1], ['s_right_steer', 6, 1]];\n  for (const [name, dist, steer] of shots) {\n    const st = await page.evaluate(async ([dist, steer]) => {\n      const r = window.__rainbow; r.goto('04'); const s0 = r.state().s; r.setSteer(steer);\n      let k = 0; while (r.state().s < s0 + dist && k < 2000) { r.step(1); k++; }\n      r.setSteer(null);\n      r.run(true); await new Promise((res) => requestAnimationFrame(() => requestAnimationFrame(res))); r.run(false);\n      return { ...r.state(), frames: k };\n    }, [dist, steer]);\n    await page.waitForTimeout(150);\n    await page.screenshot({ path: `${OUT}/${name}.png` });\n    log.push({ name, dist, steer, frames: st.frames, s: st.s, lat: st.lat, stage: st.stage, coins: st.coins }); console.log(name, 's', st.s, 'lat', st.lat, st.stage, 'coins', st.coins);\n  }\n} finally { writeFileSync(`${OUT}/motion.json`, JSON.stringify(log, null, 1)); await browser.close(); await vite.close?.(); }\n=== metrics04.py\n\"\"\"Screen 04: approved vs capture by region (same measures as tools/qa/screen_match.py: share within 20 levels, SSIM).\nSCENERY = below the HUD/title (rows >= 13 %) without Benny (his ellipses from tools/match04/make_plate04.py).\nusage: python3 -I tools/match04/metrics04.py <approved.png> <before.png> <new.png> <out.json>\"\"\"\nimport json, sys\nimport numpy as np, cv2\nfrom PIL import Image\nfrom scipy.ndimage import gaussian_filter\nap = Image.open(sys.argv[1]).convert(\"RGB\"); W, H = ap.size\nload = lambda p: np.asarray(Image.open(p).convert(\"RGB\").resize((W, H), Image.LANCZOS), float)\nA = np.asarray(ap, float)\ndef ssim_map(a, b):\n    la, lb = (a * [0.2126, 0.7152, 0.0722]).sum(-1), (b * [0.2126, 0.7152, 0.0722]).sum(-1)\n    s = 1.5; C1, C2 = (0.01 * 255) ** 2, (0.03 * 255) ** 2\n    ma, mb = gaussian_filter(la, s), gaussian_filter(lb, s)\n    va, vb = gaussian_filter(la * la, s) - ma * ma, gaussian_filter(lb * lb, s) - mb * mb\n    cab = gaussian_filter(la * lb, s) - ma * mb\n    return ((2 * ma * mb + C1) * (2 * cab + C2)) / ((ma * ma + mb * mb + C1) * (va + vb + C2))\nB = np.zeros((H, W), np.uint8)\ncv2.ellipse(B, (400, 1032), (84, 78), 0, 0, 360, 1, -1); cv2.ellipse(B, (395, 1160), (172, 92), 0, 0, 360, 1, -1)\ncv2.ellipse(B, (392, 1290), (224, 130), 0, 0, 360, 1, -1); B = B.astype(bool)\nrows = np.arange(H)[:, None] * np.ones((1, W))\nR = {\"FULL\": np.ones((H, W), bool), \"BELOWHUD\": rows >= int(0.13 * H), \"SCENERY\": (rows >= int(0.13 * H)) & ~B,\n     \"upper_room_ringtop_y200_560\": (rows >= 200) & (rows < 560), \"middle_tunnel_arrows_coins_y560_960\": (rows >= 560) & (rows < 960) & ~B,\n     \"lower_water_foam_y960_1536_noBenny\": (rows >= 960) & ~B, \"BENNY\": B}\nout = {}\nfor name, p in ((\"BEFORE\", sys.argv[2]), (\"NEW\", sys.argv[3])):\n    C = load(p); d = np.abs(A - C).mean(-1); sm = ssim_map(A, C)\n    out[name] = {k: {\"within_20\": round(float((d[m] <= 20).mean()), 4), \"mean_abs\": round(float(d[m].mean()), 2), \"ssim\": round(float(sm[m].mean()), 4)} for k, m in R.items()}\njson.dump(out, open(sys.argv[4], \"w\"), indent=1)\nfor k in R: print(f\"{k:38s} BEFORE {out['BEFORE'][k]['within_20']*100:5.1f} %  SSIM {out['BEFORE'][k]['ssim']:.3f}   NEW {out['NEW'][k]['within_20']*100:5.1f} %  SSIM {out['NEW'][k]['ssim']:.3f}\")\n=== probe04.mjs\n// read-only probe of the live game at the 04 checkpoint: camera, Benny, course frames over stage 04 (no source change)\nimport { loadPlaywright, CHROMIUM_ARGS, startVite } from '../../scripts/lib/pw.mjs';\nconst q = process.argv[2] || '';\nconst { chromium } = loadPlaywright();\nconst vite = await startVite(5266);\nconst browser = await chromium.launch({ args: CHROMIUM_ARGS });\ntry {\n  const page = await browser.newPage({ viewport: { width: 864, height: 1536 }, deviceScaleFactor: 1 });\n  await page.goto(`${vite.url}/?qa=1&dpr=1&${q}`);\n  await page.waitForFunction(() => window.__rainbow?.ready === true || window.__error, null, { timeout: 240000 });\n  const st = await page.evaluate(() => window.__rainbow.goto('04'));\n  const info = await page.evaluate(() => {\n    const R = window.__rainbow; const { scene, camera } = R.qa3d(); const c = R.course;\n    const v = (p) => p.toArray().map((x) => +x.toFixed(3));\n    const st4 = c.stage('04'), st5 = c.stage('05');\n    const frames = []; for (let s = st4.s0 - 4; s <= st5.s0 + 4; s += 2) { const f = c.sample(s); frames.push({ s: +s.toFixed(2), pos: v(f.pos), tan: v(f.tan), up: v(f.up), right: v(f.right) }); }\n    let benny = null; scene.traverse((o) => { if (!benny && o.name === 'Benny') benny = o; });\n    const V = camera.position.constructor; const mn = new V(1e9, 1e9, 1e9), mx = new V(-1e9, -1e9, -1e9), tmp = new V();\n    benny.updateWorldMatrix(true, true);\n    benny.traverse((o) => { if (o.isMesh && o.visible && o.geometry) { o.geometry.computeBoundingBox(); const bb = o.geometry.boundingBox;\n      for (const x of [bb.min.x, bb.max.x]) for (const y of [bb.min.y, bb.max.y]) for (const z of [bb.min.z, bb.max.z]) { tmp.set(x, y, z).applyMatrix4(o.matrixWorld); mn.min(tmp); mx.max(tmp); } } });\n    return { s0: st4.s0, s1: st4.s1, cam: R.camera(), bennyRoot: v(benny.position), bennyAABB: [v(mn), v(mx)], frames, state: R.state() };\n  });\n  console.log(JSON.stringify({ q, st, ...info }));\n} finally { await browser.close(); await vite.close?.(); }\n\"\"\"Any screen — APPROVED reference vs real-game capture, measured three ways (never one invented 'fidelity score'):\n  FULL      every pixel: mean |dRGB| (0-255), share within 10 / 20 levels, luminance SSIM (7x7 Gaussian)\n  BELOWHUD  the same below the HUD bar + title (rows >= 13 % of the height)\n  LAYOUT    both images blurred (sigma 8 px) first: colour + composition independent of fine detail / exact edges\n            (mean |dRGB| and share within 20 levels) — a big gap between FULL and LAYOUT means the right things are\n            roughly in the right places but details / edges differ; a bad LAYOUT means the scene itself differs\nusage: python3 -I tools/qa/screen_match.py <approved.png> <capture.png> [--json=OUT] [--label=NAME]\"\"\"\nimport json, sys\nimport numpy as np\nfrom PIL import Image\nfrom scipy.ndimage import gaussian_filter\n\nargs = [a for a in sys.argv[1:] if not a.startswith(\"--\")]\nopt = dict(a[2:].split(\"=\", 1) for a in sys.argv[1:] if a.startswith(\"--\") and \"=\" in a)\nap = Image.open(args[0]).convert(\"RGB\")\ncp = Image.open(args[1]).convert(\"RGB\")\nif cp.size != ap.size:\n    cp = cp.resize(ap.size, Image.LANCZOS)\nA, C = np.asarray(ap, float), np.asarray(cp, float)\nH, W = A.shape[:2]\n\n\ndef ssim_map(a, b):\n    la, lb = (a * [0.2126, 0.7152, 0.0722]).sum(-1), (b * [0.2126, 0.7152, 0.0722]).sum(-1)\n    s = 1.5; C1, C2 = (0.01 * 255) ** 2, (0.03 * 255) ** 2\n    ma, mb = gaussian_filter(la, s), gaussian_filter(lb, s)\n    va, vb = gaussian_filter(la * la, s) - ma * ma, gaussian_filter(lb * lb, s) - mb * mb\n    cab = gaussian_filter(la * lb, s) - ma * mb\n    return ((2 * ma * mb + C1) * (2 * cab + C2)) / ((ma * ma + mb * mb + C1) * (va + vb + C2))", "is_error": false, "tool_use_id": "toolu_01R6QERNNyHBPamusZqe18i8", "type": "tool_result"}], "role": "user"}, "parentUuid": "5468fb3d-525a-4002-82c2-23293d796ffd", "permissionDecision": {"decision": "accept", "reasonType": "rule", "ruleSource": "cliArg", "source": "config"}, "promptId": "ba031afd-0eb6-4ea7-bf55-39e91e874364", "sandboxed": false, "sessionId": "9b5796f0-194a-5de9-bfc1-2f1ef2f220ad", "sourceToolAssistantUUID": "5468fb3d-525a-4002-82c2-23293d796ffd", "timestamp": "2026-11-17T16:41:00.909Z", "toolUseResult": {"interrupted": false, "isImage": false, "noOutputExpected": false, "stderr": "", "stdout": "=== make_plate04.py\n\"\"\"Screen 04 (?match04=1): texture plate = the user's ORIGINAL approved pixels; PROVISIONAL local fill (OpenCV\ninpainting, Telea) only where the HUD bar, title banner, Benny and the five coins are (the game draws those itself).\nA fal nano-banana-2/edit clean plate is prepared (qa/match/04/FAL_PLATE_REQUEST.md) but NOT run.\nAlso cuts the material patches for unseen surfaces (tunnel rings, water, room wall) from the artwork.\nusage: python3 -I tools/match04/make_plate04.py <approved.png> <out dir>\"\"\"\nimport sys, json\nimport numpy as np, cv2\n\nsrc, out = sys.argv[1], sys.argv[2]\nA = cv2.imread(src, cv2.IMREAD_COLOR); H, W = A.shape[:2]\nM = np.zeros((H, W), np.uint8)\n# HUD bar + title banner (rounded pills)\ncv2.rectangle(M, (55, 12), (808, 108), 255, -1)\ncv2.rectangle(M, (98, 112), (768, 190), 255, -1)\n# Benny: pom-pom, beanie (with star), body + paws; down to where his fur meets the water\ncv2.ellipse(M, (400, 1032), (84, 78), 0, 0, 360, 255, -1)\ncv2.ellipse(M, (395, 1160), (172, 92), 0, 0, 360, 255, -1)\ncv2.ellipse(M, (392, 1290), (224, 130), 0, 0, 360, 255, -1)\n# the picture's coins (centre, diameter): they are real pickups in the game\nCOINS = [(175, 970, 112), (262, 872, 82), (330, 792, 58), (378, 742, 40), (423, 712, 26)]\nfor x, y, d in COINS:\n    cv2.ellipse(M, (x, y), (int(d * 0.62), int(d * 0.58)), 0, 0, 360, 255, -1)\nM = cv2.dilate(M, np.ones((7, 7), np.uint8))\nfill = cv2.inpaint(A, M, 9, cv2.INPAINT_TELEA)\n# texture the large fills: low frequencies from the inpainting (colour continuity), high frequencies from a mirrored\n# tiling of an artwork patch (swirling water under Benny, room/foam under the HUD) so moving views see texture, not smears\ndef tiled(patch, h, w):\n    p = np.concatenate([patch, patch[:, ::-1]], 1); p = np.concatenate([p, p[::-1]], 0)\n    return np.tile(p, (h // p.shape[0] + 1, w // p.shape[1] + 1, 1))[:h, :w].astype(np.float32)\ndef hi(img, s=10): img = img.astype(np.float32); return img - cv2.GaussianBlur(img, (0, 0), s)\nlow = cv2.GaussianBlur(fill.astype(np.float32), (0, 0), 10)\ntex = np.zeros_like(low)\ntex[:200] = hi(tiled(A[230:330, 590:700], 200, W))[:200]           # room / foam above, under the HUD + title\ntex[200:] = hi(tiled(A[1110:1250, 30:180], H - 200, W))             # swirling cyan/pink water left of Benny (Benny, coins)\nfilled = np.clip(low + 0.85 * tex, 0, 255)\na = cv2.GaussianBlur(M.astype(np.float32) / 255, (0, 0), 3)[..., None]\nplate = np.clip(A * (1 - a) + filled * a, 0, 255).astype(np.uint8)\ncv2.imwrite(f\"{out}/plate04_hybrid.png\", plate)\ncv2.imwrite(f\"{out}/plate04_fillmask.png\", M)\n# material patches cut from the ORIGINAL artwork (mirrored-repeat tiled in the shader)\ncv2.imwrite(f\"{out}/patch_gold.png\", A[560:700, 600:720])      # inner tunnel rings (gold bands)\ncv2.imwrite(f\"{out}/patch_water.png\", A[1110:1250, 30:180])     # swirling cyan/pink water (no foam)\ncv2.imwrite(f\"{out}/patch_wall.png\", A[300:420, 560:700])       # pink room wall / foam edge\njson.dump({\"filled_share\": float((M > 0).mean()), \"coins_px\": COINS}, open(f\"{out}/plate04.json\", \"w\"), indent=1)\nprint(\"filled share\", (M > 0).mean())\n=== make_tiles04.py\n\"\"\"Screen 04 (?match04=1): design tiles UNWRAPPED from the approved artwork through the locked camera, for the views the\napproved picture never resolved (moving camera deep in the tunnel / close to the water):\n  tile_tunnel.png  the painted gold rings on the tunnel wall, angle 0..pi (upper half, mirrored in the shader) x one ring\n                   band along the axis (TUN_A from the mouth) - follows the ring geometry, no stretching along the walls\n  tile_river.png   the painted cyan river with ONE chevron arrow, lateral -4..4 u x RIV_A along the slide (repeats down the\n                   slide, flows in the shader)\nSource = plate04_hybrid.png (original pixels; coins/Benny filled). usage: python3 -I tools/match04/make_tiles04.py <dir>\"\"\"\nimport json, math, sys\nimport numpy as np, cv2\nd = sys.argv[1]\nL = json.load(open(f\"{d}/proj04.json\"))\nW, H = L[\"camera\"][\"size\"]; t = math.tan(math.radians(L[\"camera\"][\"fov\"]) / 2); asp = W / H\nMW = np.array(L[\"camera\"][\"matrixWorld\"]).reshape(4, 4).T; C = MW[:3, 3]; R = MW[:3, :3]\nD, U, X = (np.array(L[k], float) for k in \"DUX\"); base = np.array(L[\"water\"], float); T = L[\"tube\"]\nA = cv2.imread(f\"{d}/plate04_hybrid.png\").astype(np.float32)\nTUN_A, RIV_A, RIV_X = (1.0, 5.5), (8.8, 14.8), (-4.0, 4.0)\ndef proj(P):\n    q = (P - C) @ R; return ((q[..., 0] / -q[..., 2] / (t * asp) + 1) / 2 * W).astype(np.float32), ((1 - q[..., 1] / -q[..., 2] / t) / 2 * H).astype(np.float32)\ndef sharpen(img, s=2.0, k=0.6): return np.clip(img + k * (img - cv2.GaussianBlur(img, (0, 0), s)), 0, 255)\n# tunnel: rows = angle 0 (right) .. pi (left) over the top, columns = axial distance from the mouth\nth = np.linspace(0, np.pi, 1024); a = np.linspace(*TUN_A, 256)\nAA, TH = np.meshgrid(a, th)\ncen = np.array(T[\"mouth\"], float)\nP = cen + AA[..., None] * D + T[\"r\"] * (np.cos(TH)[..., None] * X + np.sin(TH)[..., None] * U)\nu, v = proj(P); tun = cv2.remap(A, u, v, cv2.INTER_CUBIC)\ncv2.imwrite(f\"{d}/tile_tunnel.png\", sharpen(tun).astype(np.uint8))\n# river: rows = along the slide (far at the top: t grows down the slide), columns = lateral\nx = np.linspace(*RIV_X, 512); a = np.linspace(*RIV_A, 512)\nXX, AA = np.meshgrid(x, a)\nP = base + XX[..., None] * X + AA[..., None] * D\nu, v = proj(P); riv = cv2.remap(A, u, v, cv2.INTER_CUBIC)\n# make the along-slide repeat seamless: cross-fade the last 12 % into the first rows\nn = int(0.12 * riv.shape[0]); w = np.linspace(0, 1, n)[:, None, None]\nriv[-n:] = riv[-n:] * (1 - w) + riv[:n] * w\ncv2.imwrite(f\"{d}/tile_river.png\", sharpen(riv).astype(np.uint8))\njson.dump({\"tunnel\": {\"angle\": [0, math.pi], \"axialFromMouth\": TUN_A, \"size\": [256, 1024]}, \"river\": {\"lateral\": RIV_X, \"alongFromBenny\": RIV_A, \"size\": [512, 512]}},\n          open(f\"{d}/tiles04.json\", \"w\"), indent=1)\nprint(\"tiles written\")\n=== coins04.py\n\"\"\"Screen 04 (?match04=1): the approved picture's five coins as real pickups at the painted spots.\nEach painted coin (centre px, diameter px) is a ray from the locked camera; the coin (1 u diameter x scale) sits where\nits painted size and its bottom edge on the water agree (bottom on the slide's water plane), expressed as course\ns / lateral / height (coins.ts). usage: python3 -I tools/match04/coins04.py <proj04.json> <s of the cam04 water point> <out coins04.json>\"\"\"\nimport json, sys, math\nimport numpy as np\nL = json.load(open(sys.argv[1])); s_cp = float(sys.argv[2])\nW, H = L[\"camera\"][\"size\"]; fov = L[\"camera\"][\"fov\"]; t = math.tan(math.radians(fov) / 2); asp = W / H; F = (H / 2) / t\nMW = np.array(L[\"camera\"][\"matrixWorld\"]).reshape(4, 4).T; C = MW[:3, 3]; R = MW[:3, :3]\nD, U, X, base = (np.array(L[k], float) for k in (\"D\", \"U\", \"X\", \"water\"))\ndef ray(u, v):\n    d = R @ np.array([(u / W * 2 - 1) * t * asp, (1 - v / H * 2) * t, -1.0]); return d / np.linalg.norm(d)\nCOINS = [(175, 970, 112), (262, 872, 82), (330, 792, 58), (378, 742, 40), (423, 712, 26)]\nout = []\nfor u, v, d in COINS:\n    r = ray(u, v); best = None\n    for k in np.arange(2, 80, 0.01):\n        P = C + k * r; sc = d * k / F                       # painted diameter at that depth (world units)\n        h = (P - base) @ U                                  # centre height above the water plane\n        e = abs(h - 0.5 * sc * 1.0)                         # bottom edge on the water\n        if best is None or e < best[0]: best = (e, k, P, sc, h)\n    e, k, P, sc, h = best\n    # painted perspective puts the coins on the bank beyond the tunnel wall: as in match08, slide each coin along its own\n    # view ray (same pixel in the approved view) to the nearest depth within pickup reach (|lateral| <= 1.6 = inside the river, >= 0.3 above\n    # the water, >= 1 u ahead of the checkpoint, inside stage 04); its size scales with the depth so it still covers the painted coin\n    if abs((P - base) @ X) > 1.6 or s_cp + (P - base) @ D < s_cp + 1.0:\n        pick = None\n        for f in np.arange(0.15, 1.0, 0.002):\n            Q = C + k * f * r; lat = (Q - base) @ X; hq = (Q - base) @ U; sq = s_cp + (Q - base) @ D\n            if abs(lat) <= 1.6 and hq >= 0.3 + 0.5 * sc * f and s_cp + 1.0 <= sq < 112 and (pick is None or f > pick[0]): pick = (f, Q, hq)\n        if pick: f, P, h = pick; k *= f; sc *= f\n    out.append({\"px\": [u, v, d], \"s\": s_cp + float((P - base) @ D), \"lat\": float((P - base) @ X), \"h\": float(h), \"scale\": float(sc), \"dist\": float(k), \"pos\": P.tolist()})\njson.dump({\"note\": \"Screen 04 approved picture coins from the locked ?match04=1 camera (tools/match04/coins04.py, 2026-11-17)\", \"faceTo\": C.tolist(), \"coins\": out}, open(sys.argv[3], \"w\"), indent=1)\nfor c in out: print({k: (round(v, 3) if isinstance(v, float) else v) for k, v in c.items() if k != \"pos\"})\n=== motion04.mjs\n// Screen 04 moving-camera test (read-only): from the 04 checkpoint ride forward / steer with the real game sim and\n// screenshot what the live camera sees. usage: node tools/match04/motion04.mjs <outDir> [q]\nimport { mkdirSync, writeFileSync } from 'node:fs';\nimport { loadPlaywright, CHROMIUM_ARGS, startVite } from '../../scripts/lib/pw.mjs';\nconst OUT = process.argv[2]; const Q = process.argv[3] ?? 'match04=1';\nmkdirSync(OUT, { recursive: true });\nconst { chromium } = loadPlaywright();\nconst vite = await startVite(5268);\nconst browser = await chromium.launch({ args: CHROMIUM_ARGS });\nconst log = [];\ntry {\n  const page = await browser.newPage({ viewport: { width: 864, height: 1536 }, deviceScaleFactor: 1 });\n  page.on('pageerror', (e) => console.error('pageerror', e.message));\n  await page.goto(`${vite.url}/?qa=1&dpr=1&${Q}`);\n  await page.waitForFunction(() => window.__rainbow?.ready === true || window.__error, null, { timeout: 240000 });\n  // [name, forward distance (u), steer]\n  const shots = [['f00_checkpoint', 0, null], ['f03_forward3u', 3, null], ['f06_forward6u', 6, null], ['f10_forward10u', 10, null],\n                 ['f20_forward20u', 20, null], ['s_left_steer', 6, -1], ['s_right_steer', 6, 1]];\n  for (const [name, dist, steer] of shots) {\n    const st = await page.evaluate(async ([dist, steer]) => {\n      const r = window.__rainbow; r.goto('04'); const s0 = r.state().s; r.setSteer(steer);\n      let k = 0; while (r.state().s < s0 + dist && k < 2000) { r.step(1); k++; }\n      r.setSteer(null);\n      r.run(true); await new Promise((res) => requestAnimationFrame(() => requestAnimationFrame(res))); r.run(false);\n      return { ...r.state(), frames: k };\n    }, [dist, steer]);\n    await page.waitForTimeout(150);\n    await page.screenshot({ path: `${OUT}/${name}.png` });\n    log.push({ name, dist, steer, frames: st.frames, s: st.s, lat: st.lat, stage: st.stage, coins: st.coins }); console.log(name, 's', st.s, 'lat', st.lat, st.stage, 'coins', st.coins);\n  }\n} finally { writeFileSync(`${OUT}/motion.json`, JSON.stringify(log, null, 1)); await browser.close(); await vite.close?.(); }\n=== metrics04.py\n\"\"\"Screen 04: approved vs capture by region (same measures as tools/qa/screen_match.py: share within 20 levels, SSIM).\nSCENERY = below the HUD/title (rows >= 13 %) without Benny (his ellipses from tools/match04/make_plate04.py).\nusage: python3 -I tools/match04/metrics04.py <approved.png> <before.png> <new.png> <out.json>\"\"\"\nimport json, sys\nimport numpy as np, cv2\nfrom PIL import Image\nfrom scipy.ndimage import gaussian_filter\nap = Image.open(sys.argv[1]).convert(\"RGB\"); W, H = ap.size\nload = lambda p: np.asarray(Image.open(p).convert(\"RGB\").resize((W, H), Image.LANCZOS), float)\nA = np.asarray(ap, float)\ndef ssim_map(a, b):\n    la, lb = (a * [0.2126, 0.7152, 0.0722]).sum(-1), (b * [0.2126, 0.7152, 0.0722]).sum(-1)\n    s = 1.5; C1, C2 = (0.01 * 255) ** 2, (0.03 * 255) ** 2\n    ma, mb = gaussian_filter(la, s), gaussian_filter(lb, s)\n    va, vb = gaussian_filter(la * la, s) - ma * ma, gaussian_filter(lb * lb, s) - mb * mb\n    cab = gaussian_filter(la * lb, s) - ma * mb\n    return ((2 * ma * mb + C1) * (2 * cab + C2)) / ((ma * ma + mb * mb + C1) * (va + vb + C2))\nB = np.zeros((H, W), np.uint8)\ncv2.ellipse(B, (400, 1032), (84, 78), 0, 0, 360, 1, -1); cv2.ellipse(B, (395, 1160), (172, 92), 0, 0, 360, 1, -1)\ncv2.ellipse(B, (392, 1290), (224, 130), 0, 0, 360, 1, -1); B = B.astype(bool)\nrows = np.arange(H)[:, None] * np.ones((1, W))\nR = {\"FULL\": np.ones((H, W), bool), \"BELOWHUD\": rows >= int(0.13 * H), \"SCENERY\": (rows >= int(0.13 * H)) & ~B,\n     \"upper_room_ringtop_y200_560\": (rows >= 200) & (rows < 560), \"middle_tunnel_arrows_coins_y560_960\": (rows >= 560) & (rows < 960) & ~B,\n     \"lower_water_foam_y960_1536_noBenny\": (rows >= 960) & ~B, \"BENNY\": B}\nout = {}\nfor name, p in ((\"BEFORE\", sys.argv[2]), (\"NEW\", sys.argv[3])):\n    C = load(p); d = np.abs(A - C).mean(-1); sm = ssim_map(A, C)\n    out[name] = {k: {\"within_20\": round(float((d[m] <= 20).mean()), 4), \"mean_abs\": round(float(d[m].mean()), 2), \"ssim\": round(float(sm[m].mean()), 4)} for k, m in R.items()}\njson.dump(out, open(sys.argv[4], \"w\"), indent=1)\nfor k in R: print(f\"{k:38s} BEFORE {out['BEFORE'][k]['within_20']*100:5.1f} %  SSIM {out['BEFORE'][k]['ssim']:.3f}   NEW {out['NEW'][k]['within_20']*100:5.1f} %  SSIM {out['NEW'][k]['ssim']:.3f}\")\n=== probe04.mjs\n// read-only probe of the live game at the 04 checkpoint: camera, Benny, course frames over stage 04 (no source change)\nimport { loadPlaywright, CHROMIUM_ARGS, startVite } from '../../scripts/lib/pw.mjs';\nconst q = process.argv[2] || '';\nconst { chromium } = loadPlaywright();\nconst vite = await startVite(5266);\nconst browser = await chromium.launch({ args: CHROMIUM_ARGS });\ntry {\n  const page = await browser.newPage({ viewport: { width: 864, height: 1536 }, deviceScaleFactor: 1 });\n  await page.goto(`${vite.url}/?qa=1&dpr=1&${q}`);\n  await page.waitForFunction(() => window.__rainbow?.ready === true || window.__error, null, { timeout: 240000 });\n  const st = await page.evaluate(() => window.__rainbow.goto('04'));\n  const info = await page.evaluate(() => {\n    const R = window.__rainbow; const { scene, camera } = R.qa3d(); const c = R.course;\n    const v = (p) => p.toArray().map((x) => +x.toFixed(3));\n    const st4 = c.stage('04'), st5 = c.stage('05');\n    const frames = []; for (let s = st4.s0 - 4; s <= st5.s0 + 4; s += 2) { const f = c.sample(s); frames.push({ s: +s.toFixed(2), pos: v(f.pos), tan: v(f.tan), up: v(f.up), right: v(f.right) }); }\n    let benny = null; scene.traverse((o) => { if (!benny && o.name === 'Benny') benny = o; });\n    const V = camera.position.constructor; const mn = new V(1e9, 1e9, 1e9), mx = new V(-1e9, -1e9, -1e9), tmp = new V();\n    benny.updateWorldMatrix(true, true);\n    benny.traverse((o) => { if (o.isMesh && o.visible && o.geometry) { o.geometry.computeBoundingBox(); const bb = o.geometry.boundingBox;\n      for (const x of [bb.min.x, bb.max.x]) for (const y of [bb.min.y, bb.max.y]) for (const z of [bb.min.z, bb.max.z]) { tmp.set(x, y, z).applyMatrix4(o.matrixWorld); mn.min(tmp); mx.max(tmp); } } });\n    return { s0: st4.s0, s1: st4.s1, cam: R.camera(), bennyRoot: v(benny.position), bennyAABB: [v(mn), v(mx)], frames, state: R.state() };\n  });\n  console.log(JSON.stringify({ q, st, ...info }));\n} finally { await browser.close(); await vite.close?.(); }\n\"\"\"Any screen — APPROVED reference vs real-game capture, measured three ways (never one invented 'fidelity score'):\n  FULL      every pixel: mean |dRGB| (0-255), share within 10 / 20 levels, luminance SSIM (7x7 Gaussian)\n  BELOWHUD  the same below the HUD bar + title (rows >= 13 % of the height)\n  LAYOUT    both images blurred (sigma 8 px) first: colour + composition independent of fine detail / exact edges\n            (mean |dRGB| and share within 20 levels) — a big gap between FULL and LAYOUT means the right things are\n            roughly in the right places but details / edges differ; a bad LAYOUT means the scene itself differs\nusage: python3 -I tools/qa/screen_match.py <approved.png> <capture.png> [--json=OUT] [--label=NAME]\"\"\"\nimport json, sys\nimport numpy as np\nfrom PIL import Image\nfrom scipy.ndimage import gaussian_filter\n\nargs = [a for a in sys.argv[1:] if not a.startswith(\"--\")]\nopt = dict(a[2:].split(\"=\", 1) for a in sys.argv[1:] if a.startswith(\"--\") and \"=\" in a)\nap = Image.open(args[0]).convert(\"RGB\")\ncp = Image.open(args[1]).convert(\"RGB\")\nif cp.size != ap.size:\n    cp = cp.resize(ap.size, Image.LANCZOS)\nA, C = np.asarray(ap, float), np.asarray(cp, float)\nH, W = A.shape[:2]\n\n\ndef ssim_map(a, b):\n    la, lb = (a * [0.2126, 0.7152, 0.0722]).sum(-1), (b * [0.2126, 0.7152, 0.0722]).sum(-1)\n    s = 1.5; C1, C2 = (0.01 * 255) ** 2, (0.03 * 255) ** 2\n    ma, mb = gaussian_filter(la, s), gaussian_filter(lb, s)\n    va, vb = gaussian_filter(la * la, s) - ma * ma, gaussian_filter(lb * lb, s) - mb * mb\n    cab = gaussian_filter(la * lb, s) - ma * mb\n    return ((2 * ma * mb + C1) * (2 * cab + C2)) / ((ma * ma + mb * mb + C1) * (va + vb + C2))"}, "type": "user", "userType": "external", "uuid": "5ccdbbfb-fa8d-44a5-b70d-15f24fe5df43", "version": "2.1.326"}
