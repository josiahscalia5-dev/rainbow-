from pathlib import Path
import re,json,sys,collections,hashlib,struct,gzip,io,zipfile
p=Path(__file__).parent;root=Path(sys.argv[1]).resolve() if len(sys.argv)>1 else p/'payload'
patterns={
 'private key material':rb'-----BEGIN (?:OPENSSH |RSA |EC |DSA |PGP )?PRIVATE KEY(?: BLOCK)?-----',
 'GitHub token':rb'\b(?:gh[pousr]_[0-9A-Za-z]{32,}|github_pat_[A-Za-z0-9_]{55,})\b',
 'OpenAI or Anthropic secret':rb'\bsk-(?:(?:proj-|ant-api\d+-)?[A-Za-z0-9_\-]{32,})\b',
 'AWS access key':rb'\b(?:AKIA|ASIA)[A-Z2-7]{16}\b',
 'Google API key':rb'\bAIza[A-Za-z0-9_-]{35}\b',
 'Slack or payment secret':rb'\b(?:xox[baprs]-[0-9A-Za-z-]{21,}|sk_(?:live|test)_[A-Za-z0-9]{20,})\b',
 'authenticated URL':rb'https?://[\w.-]{2,}:[^/\s@"<>]{8,}@',
 'signed service URL':rb'[?&](?:X-Amz-Signature|X-Goog-Signature|Signature|sig|jwt|access_token|refresh_token)=([A-Za-z0-9._%~+/-]{24,})',
 'JWT bearer token':rb'\beyJ[A-Za-z0-9_-]{12,}\.[A-Za-z0-9_-]{12,}\.[A-Za-z0-9_-]{14,}\b',
 'literal authorization header':rb'\b(?:Bearer|Basic) [A-Za-z0-9_./+=-]{28,}\b',
 'literal service credential':rb'(?i)(?:fal_key|marble_api_key|worldlabs_api_key|api[_-]?key|client[_-]?secret|access[_-]?token|password)\s*["\x27]?\s*[:=]\s*["\x27]([A-Za-z0-9._:+/=-]{16,})["\x27]'
}
compiled={k:re.compile(v,re.I if k=='signed service URL' else 0) for k,v in patterns.items()}
sensitive={'node_modules','.git','.env','.aws','.ssh'}
known_placeholders=('example','replace','placeholder','your_','your-','xxx','REDACTED','dummy','process.env','env.','os.environ','XXX','TOKEN_HERE')
hits=[]
for f in sorted(root.rglob('*')):
 if not f.is_file():continue
 rel=f.relative_to(root).as_posix()
 if any(x in sensitive or x.startswith('.env.') for x in f.relative_to(root).parts) or f.suffix.lower() in {'.pem','.key','.keystore','.p12','.jks','.pfx'}:hits.append({'path':rel,'reason':'sensitive filename'});continue
 suffix=f.suffix.lower()
 if suffix in ['.webp','.avif','.mp4','.png','.jpg','.jpeg','.gif','.npz','.npy','.woff','.woff2','.jar','.bin']:continue
 data=f.read_bytes()
 if suffix=='.glb':
  n,kind=struct.unpack('<II',data[12:20]);assert kind==0x4E4F534A
  data=data[20:20+n]
 if suffix=='.blend' and data[:2]==b'\\x1f\\x8b':data=gzip.decompress(data)
 if suffix=='.blend' and data[:4]==b'\\x28\\xb5\\x2f\\xfd':
  import zstandard
  with zstandard.ZstdDecompressor().stream_reader(io.BytesIO(data),read_across_frames=True) as stream:data=stream.read()
 if suffix=='.pdf':
  import fitz
  with fitz.open(f) as doc:data=('\\n'.join(page.get_text() for page in doc)+'\\n'+str(doc.metadata)).encode()

 for name,rx in compiled.items():
  for m in rx.finditer(data):
   item=(m.group(1) if m.lastindex else m.group()).decode(errors='ignore')
   if any(s.lower() in item.lower() for s in known_placeholders):continue
   hits.append({'path':rel,'reason':name,'offset':m.start(),'length':len(m.group())})
(p/'scan-findings.json').write_text(json.dumps(hits,indent=2)+'\n')
print('Sensitive material scan',len(hits),'findings;',dict(collections.Counter(x['reason'] for x in hits)),flush=True)
if hits:print('Files only:',list(dict.fromkeys(x['path'] for x in hits))[:12]);sys.exit(2)
