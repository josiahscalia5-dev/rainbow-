rt interface ContinuityReport {\n446\t  ok: boolean;\n447\t  boundaries: { from: StageId; to: StageId; s: number; posGap: number; tangentAngleDeg: number; upAngleDeg: number; altitude: number }[];\n448\t  maxStepTangentDeg: number;\n449\t  maxStepPos: number;\n450\t  plunge: { entryAltitude07: number; plungeTop: { s: number; y: number }; plungeMid: { s: number; y: number }; plungeBottom: { s: number; y: number }; inlet08: { s: number; y: number }; verticalDrop: number; minPitchDeg: number };\n451\t}\n452\t\n453\t/** Numerical continuity validation of the whole route. */\n454\texport function validateContinuity(c: Course): ContinuityReport {\n455\t  const eps = 0.02;\n456\t  const boundaries = c.stages.slice(0, -1).map((st, i) => {\n457\t    const nx = c.stages[i + 1];\n458\t    const sa = Math.max(st.s1 - eps, 0);\n459\t    const sb = Math.min(st.s1 + eps, c.length); // 11 starts at the route end (cinematic)\n460\t    const a = c.sample(sa);\n461\t    const b = c.sample(sb);\n462\t    return {\n463\t      from: st.id,\n464\t      to: nx.id,\n465\t      s: +st.s1.toFixed(2),\n466\t      posGap: +(a.pos.distanceTo(b.pos) - (sb - sa)).toFixed(4),\n467\t      tangentAngleDeg: +THREE.MathUtils.radToDeg(a.tan.angleTo(b.tan)).toFixed(3),\n468\t      upAngleDeg: +THREE.MathUtils.radToDeg(a.up.angleTo(b.up)).toFixed(3),\n469\t      altitude: +a.pos.y.toFixed(2),\n470\t    };\n471\t  });\n472\t  let maxT = 0, maxP = 0;\n473\t  const step = 0.25;\n474\t  let prev = c.sample(0);\n475\t  let minPitch = 0;\n476\t  const rideStart = c.stage('03').s0; // 01–02 tumble helix is a cinematic, checked for gaps only\n477\t  for (let s = step; s <= c.length; s += step) {\n478\t    const cur = c.sample(s);\n479\t    if (s > rideStart + step) maxT = Math.max(maxT, THREE.MathUtils.radToDeg(prev.tan.angleTo(cur.tan)));\n480\t    maxP = Math.max(maxP, prev.pos.distanceTo(cur.pos));\n481\t    if (s > c.marks['07_plunge_top'] && s < c.marks['08']) minPitch = Math.min(minPitch, THREE.MathUtils.radToDeg(Math.asin(cur.tan.y)));\n482\t    prev = { ...cur, pos: cur.pos.clone(), tan: cur.tan.clone(), up: cur.up.clone(), right: cur.right.clone() };\n483\t  }\n484\t  const y = (s: number) => +c.sample(s).pos.y.toFixed(2);\n485\t  const top = c.marks['07_plunge_top'];\n486\t  const bottom = c.marks['07_plunge_bottom'];\n487\t  const mid = (top + bottom) / 2;\n488\t  const inlet = c.marks['08'];\n489\t  const plunge = {\n490\t    entryAltitude07: y(c.stage('07').s0),\n491\t    plungeTop: { s: +top.toFixed(2), y: y(top) },\n492\t    plungeMid: { s: +mid.toFixed(2), y: y(mid) },\n493\t    plungeBottom: { s: +bottom.toFixed(2), y: y(bottom) },\n494\t    inlet08: { s: +inlet.toFixed(2), y: y(inlet) },\n495\t    verticalDrop: +(y(top) - y(inlet)).toFixed(2),\n496\t    minPitchDeg: +minPitch.toFixed(1),\n497\t  };\n498\t  const ok =\n499\t    boundaries.every((b) => Math.abs(b.posGap) < 0.01 && b.tangentAngleDeg < 1 && b.upAngleDeg < 2) &&\n500\t    maxP < step * 1.05 &&\n501\t    maxT < 8 && // ≥1.8-unit turn radius anywhere on the ride (tightest: the drop into the 03 drain)\n502\t    plunge.verticalDrop > 50 &&\n503\t    plunge.inlet08.y < plunge.entryAltitude07 - 50;\n504\t  return { ok, boundaries, maxStepTangentDeg: +maxT.toFixed(3), maxStepPos: +maxP.toFixed(4), plunge };\n505\t}\n506\t", "tool_use_id": "toolu_015ki4Q8RobtcEo8LZc7TYEh", "type": "tool_result"}], "role": "user"}, "parentUuid": "852dd907-1af7-4816-af4c-077746b85071", "permissionDecision": {"decision": "accept", "reasonType": "rule", "ruleSource": "cliArg", "source": "config"}, "promptId": "c53ad454-3350-48aa-919e-00238c9cb0b2", "sessionId": "eae80a1c-be41-5f1a-858b-469afcc249da", "sourceToolAssistantUUID": "852dd907-1af7-4816-af4c-077746b85071", "timestamp": "2026-11-15T19:18:50.393Z", "type": "user", "userType": "external", "uuid": "b5213c3e-9101-4c01-8695-f38f6ff885a9", "version": "2.1.325"}
