from pathlib import Path
import json,subprocess as sp,sys,shutil
p=Path(__file__).resolve().parent
sids=['04','05','06','07','08']
if sys.argv[1]=='continuity':
    work=p/'existing-continuity';(work/'scripts').mkdir(parents=True,exist_ok=True)
    for name in ['src','node_modules','package.json','tsconfig.json']:
        if not (work/name).exists():(work/name).symlink_to(p/'games/06'/name)
    file='scripts/continuity-test.ts'
    (work/file).write_bytes(sp.check_output(['git','-C',str(p/'repo'),'show','HEAD:'+file]))
    run=sp.run([str(work/'node_modules/.bin/vite-node'),file],cwd=work,stdout=sp.PIPE,stderr=sp.STDOUT)
    assert run.returncode==0,run.stdout.decode()[-650:]
    data=json.loads((work/'qa/continuity_report.json').read_text())
    assert data['ok'];shutil.copyfile(work/'qa/continuity_report.json',p/'continuity-report.json')
    sp.run([str(p/'games/06/node_modules/.bin/tsc'),'--noEmit'],cwd=p/'games/06',check=True)
    print('Existing entire-course continuity and Screen 06 type check passed.')
else:
    past=Path('/tmp/rainbow-final-fidelity.RuUP0xJ2/repos')
    for role in ['BEFORE','NEW']:
        dest=p/'official-visual-comparator'/role
        for n in ['scripts','qa','screenshots']:(dest/n).mkdir(parents=True,exist_ok=True)
        if not (dest/'references').exists():(dest/'references').symlink_to(p/'games/06/references',target_is_directory=True)
        fn='scripts/compare.py';(dest/fn).write_bytes(sp.check_output(['git','-C',str(p/'repo'),'show','HEAD:'+fn]))
        for sid in sids:
            local=p if sid=='06' else p/'round2'
            src=past/sid/'experiments/codex'/('fidelity-'+sid)/'CLAUDIA_BEFORE/opening.png' if role=='BEFORE' else local/'proof'/sid/'NEW/opening.png'
            assert src.is_file()
            link=dest/'screenshots'/(sid+'.png')
            if not link.exists():link.symlink_to(src)
        proc=sp.run([sys.executable,'-I',fn,*sids],cwd=dest,stdout=sp.PIPE,stderr=sp.STDOUT)
        assert proc.returncode==0,proc.stdout.decode()[-600:]
        result=json.loads((dest/'qa/report_metrics.json').read_text());assert [r['id'] for r in result]==sids
        for row in result:(p/('official-'+row['id']+'-'+role+'.json')).write_text(json.dumps(row,indent=2)+'\n')
    print('Official project comparator passed on all ten openings.')
