from pathlib import Path
import os,hashlib,subprocess,urllib.parse,zipfile,json
root=Path(__file__).resolve().parent;dir=root/'gradle-dist';dir.mkdir(exist_ok=True)
fn='gradle-8.2.1-bin.zip';url='https://services.gradle.org/distributions/'+fn;zipfilePath=dir/fn
expected=subprocess.check_output(['curl','-fsSL','--max-time','40',url+'.sha256'],text=True).strip().split()[0]
assert len(expected)==64
if not zipfilePath.exists():subprocess.run(['curl','-fsSL','--retry','2','--max-time','180','-o',str(zipfilePath),url],check=True)
assert hashlib.sha256(zipfilePath.read_bytes()).hexdigest()==expected
subprocess.run(['unzip','-qo',str(zipfilePath),'-d',str(dir)],check=True)
env=dict(os.environ,ANDROID_HOME=str(root/'sdk'),ANDROID_SDK_ROOT=str(root/'sdk'),GRADLE_USER_HOME=str(root/'gradle-cache'),ANDROID_USER_HOME=str(root/'device-state'),CI='1')
prop=[]
for proto in ['http','https']:
 url=urllib.parse.urlsplit(os.environ.get(proto.upper()+'_PROXY',os.environ.get(proto+'_proxy','')))
 if url.hostname:
  prop+=['-D'+proto+'.proxyHost='+url.hostname,'-D'+proto+'.proxyPort='+str(url.port or 80)]
env['JAVA_TOOL_OPTIONS']=' '.join(prop)
version=subprocess.check_output([str(dir/'gradle-8.2.1/bin/gradle'),'--version'],env=env,stderr=subprocess.DEVNULL,text=True)
(root/'gradle-version.txt').write_text(version)
(root/'gradle-source-check.json').write_text(json.dumps({'filename':fn,'sha256':expected,'source':'Gradle official distribution checksum'},indent=2))
with (root/'gradle-verified.log').open('w') as log:
 proc=subprocess.run([str(dir/'gradle-8.2.1/bin/gradle'),*prop,'assembleDebug','--no-daemon','--max-workers=2','--console=plain'],cwd=root/'rainbow-build/android',env=env,stdout=log,stderr=subprocess.STDOUT)
print('Gradle 8.2.1 verified. Android debug build result',proc.returncode,flush=True)
