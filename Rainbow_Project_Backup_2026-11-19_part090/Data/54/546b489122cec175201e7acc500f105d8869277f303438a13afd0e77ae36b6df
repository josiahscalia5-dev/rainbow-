from pathlib import Path,PurePosixPath
from zipfile import ZipFile
import io,csv,hashlib,json,re,sys
from PIL import Image
from guides import ROOT,OUT,IDS,CURRENT

blocked_ext={'.blend','.glb','.fbx','.ts','.js','.cjs','.py','.apk','.zip','.tar','.exe','.key','.pem'}
forbidden=re.compile(rb'-----BEGIN (?:[A-Z ]+ )?PRIVATE KEY-----|(?:gh[pousr]_|github_pat_)[A-Za-z0-9_]{25,}|sk-(?:proj-)?[A-Za-z0-9_-]{40,}|AKIA[0-9A-Z]{16}|(?:api[_-]?key|client[_-]?secret)\s*["\x27]?\s*[:=]\s*["\x27][A-Za-z0-9_/-]{24,}',re.I)
def sha(x):return hashlib.sha256(x).hexdigest()
def audit(path,kind):
    assert 0<path.stat().st_size<200_000_000,path
    with ZipFile(path) as z:
        names=z.namelist();assert len(names)==len(set(names)) and names[0]=='README_FIRST.md',path
        assert z.testzip() is None,path
        hashes={name:val for val,name in (line.split('  ',1) for line in z.read('SHA256SUMS.txt').decode().splitlines())}
        assert set(hashes)==set(names)-{'SHA256SUMS.txt'}
        media=[n for n in names if n.lower().endswith(('.png','.jpg','.jpeg','.webp','.mp4'))]
        idx=list(csv.DictReader(io.StringIO(z.read('FILE_INDEX.csv').decode())))
        assert set(x['file_inside_this_zip'] for x in idx)==set(media)
        for name in names:
            p=PurePosixPath(name);assert not p.is_absolute() and '..' not in p.parts and not blocked_ext.intersection(p.suffixes)
            assert not any(s in ['node_modules','.git','.aws','backups','private','credentials'] for s in p.parts)
            data=z.read(name)
            if name in hashes:assert sha(data)==hashes[name],name
            if p.suffix in ['.md','.csv','.json','.txt']:
                assert not forbidden.search(data),name
            if p.suffix in ['.jpg','.png','.webp','.jpeg']:
                with Image.open(io.BytesIO(data)) as im:
                    im.load()
                    dims=str(im.width)+'x'+str(im.height)
                for row in (r for r in idx if r['file_inside_this_zip']==name):
                    assert row['original_dimensions']==dims,name
                    assert row['packaged_sha256']==hashes[name]
                    if kind in ['native','small'] or row['status'] in ['APPROVED','APPROVED DETAIL']:assert row['source_sha256']==hashes[name],name
            if p.suffix=='.mp4':
                assert any(r['packaged_sha256']==hashes[name] and r['codec']=='h264' for r in idx if r['file_inside_this_zip']==name)
        if kind=='master-images':
            assert len([n for n in media if '/Current/' in n])==140
            assert len(idx)==516 and len(media)==449
            for sid in IDS:
                file='Screen_'+sid+'/SCREEN'+sid+'_APPROVED.jpg'
                art=json.load(open(CURRENT/('Screen-'+sid)/'provenance.json'))
                assert hashes[file]==art['referenceSHA256']
                assert hashlib.sha256((CURRENT/('Screen-'+sid)/'APPROVED.jpg').read_bytes()).hexdigest()==hashes[file]
            f=next(n for n in media if '/SCREEN05_APPROVED_WATER_DETAIL.' in n)
            chk=json.load(open(CURRENT/'Screen-05/reference-and-source-check.json'))
            assert hashes[f]==chk['verifiedReferenceHashes']['references/water/05_water_isolated_original.png']
            native=list(csv.DictReader(io.StringIO(z.read('SOURCE_PARTS.csv').decode())))
            assert len(native)==len(idx) and all((OUT/'Source_Images'/x['source_part']).is_file() for x in native)
        elif kind=='master-videos':
            assert len(media)==35 and len([n for n in media if n.endswith('ENTRANCE_TO_EXIT.mp4')])==10
            for sid in IDS:
                assert all('Screen_'+sid+'/SCREEN'+sid+'_'+v+'_ENTRANCE_TO_EXIT.mp4' in names for v in ['CLAUDIA_RETAINED','CODEX_CANDIDATE'])
                hd=json.loads(z.read('Screen_'+sid+'/Reports/HD_REPLAY_VERIFICATION.json'));assert len(hd)==2
                for r in hd:assert hashes[r['file']]==r['hdSHA256']
        elif kind=='small':assert len(media)==9
    return {'file':path.relative_to(OUT).as_posix(),'bytes':path.stat().st_size,'mediaFiles':len(media),'entries':len(names),'sha256':sha(path.read_bytes()),'crcAndChecksums':'verified'}
if __name__=='__main__':
    what=sys.argv[1]
    if what=='images':
        x=[audit(OUT/'Rainbow_Visual_Images.zip','master-images')]
        x.extend(audit(p,'native') for p in sorted((OUT/'Source_Images').glob('*.zip')))
        x.extend(audit(p,'small') for p in sorted((OUT/'Small_Image_Batches').glob('*.zip')))
    else:
        x=[audit(OUT/'Rainbow_Gameplay_Videos.zip','master-videos')]
    Path('checked-'+what+'.json').write_text(json.dumps(x,indent=2)+'\n')
    print('Verified',len(x),'archives and',sum(v['entries'] for v in x),'archive entries for',what,flush=True)
