from pathlib import Path
from PIL import Image,ImageDraw
import json,hashlib,shutil
p=Path(__file__).parent;old=Path('/tmp/rainbow-final-fidelity.RuUP0xJ2/repos')
out=p/'moving';out.mkdir(exist_ok=True);phone=Path('/workspace/library-files/Rainbow-Nov19-Benny-Steering');phone.mkdir(exist_ok=True)
summary={}
thumb=Image.new('RGB',(610,2*160));draw=ImageDraw.Draw(thumb)
for j,s in enumerate(['04','05','06','07','08']):
    folder=old/s/'experiments/codex'/('fidelity-'+s)/'CLAUDIA_BEFORE'
    poses={row['name']:row for row in json.loads((folder/'poses.json').read_text())}
    pub=json.loads((p.parent/('published-'+s+'.json')).read_text())
    art=json.loads((p/'original-vs-retained-benny.json').read_text())['screens'][s]['originalArtwork']
    summary[s]={'retained':art['retained'],'fullNativeEvidence':pub['evidence']+'/CLAUDIA_BEFORE','poses':{}}
    for i,name in enumerate(['hard-left','hard-right']):
        pose=poses[name];actor=pose['benny'];assert 'skip' not in pose and actor['visible']
        source=folder/(name+'.png');image=Image.open(source).convert('RGB');w,h=image.size
        assert (w,h)==(864,1536)
        cx=(1+actor['x'])*w/2;cy=(1-actor['y'])*h/2
        x=max(0,min(w-510,round(cx-255)));y=max(0,min(h-545,round(cy-315)))
        crop=image.crop((x,y,x+510,y+545));file='S'+s+'-CLAUDIA-'+name+'-character-native.png';crop.save(out/file);shutil.copyfile(out/file,phone/file)
        summary[s]['poses'][name]={'retainedCourseS':pose['state']['s'],'stage':pose['state']['stage'],'steer':pose['steer'],'shaderTime':pose['shaderTime'],'actorCenterNDC':[actor['x'],actor['y']],'pixelCropXYXY':[x,y,x+510,y+545],'wholeFrameSHA256':hashlib.sha256(source.read_bytes()).hexdigest(),'nativeCropSHA256':hashlib.sha256((out/file).read_bytes()).hexdigest(),'crop':file}
        crop.thumbnail((120,131));thumb.paste(crop,(122*j,160*i+18));draw.text((122*j+2,160*i+1),s+' '+name,fill='white')
(out/'retained-steering-character-views.json').write_text(json.dumps(summary,indent=2)+'\n')
thumb.save(p/'steering-character-internal.jpg',quality=88)
print('Ten native crops verified from retained game captures')
