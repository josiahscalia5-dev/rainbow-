6\t\n27\ttype Mode = 'intro' | 'ride' | 'outro' | 'end';\n28\tconst START_COINS = 1330;\n29\tconst STAGE_ORDER: StageId[] = ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11'];\n30\tconst sm = (a: number, b: number, x: number) => THREE.MathUtils.smoothstep(x, a, b);\n31\tconst lerp = THREE.MathUtils.lerp;\n32\t\n33\t/** intro timeline marks (seconds) */\n34\tconst T = { dropEnd: 1.6, doorClose0: 1.9, doorClose1: 2.8, walk0: 3.0, peek: 4.4, cp01: 6.6, spin: 7.4, cp02: 9.1, drain: 11.4, rideStart: 14.0 };\n35\t/** outro timeline marks */\n36\tconst O = { hide: 0.6, walk0: 0.0, door0: 1.1, door1: 2.1, lean0: 1.9, fold0: 2.7, fold1: 3.7, hold: 6.4, badge: 3.9, cp11: 5.2 };\n37\t\n38\texport async function startGame(canvas: HTMLCanvasElement) {\n39\t  const qs = new URLSearchParams(location.search);\n40\t  const qaMode = qs.has('qa');\n41\t  const renderer = createRenderer(canvas, { preserveDrawingBuffer: qaMode });\n42\t  const dpr = qs.has('dpr') ? Number(qs.get('dpr')) : Math.min(window.devicePixelRatio || 1, 2);\n43\t  renderer.setPixelRatio(dpr);\n44\t  const scene = new THREE.Scene();\n45\t  scene.environment = createCandyEnvironment(renderer);\n46\t  scene.background = new THREE.Color('#b23fb4');\n47\t  const fog = new THREE.FogExp2('#ffbde9', 0.0035);\n48\t  scene.fog = fog;\n49\t  scene.add(new THREE.HemisphereLight('#fff0ff', '#a33bb8', 1.15));\n50\t  const sun = new THREE.DirectionalLight('#fff4e6', 1.6);\n51\t  sun.position.set(0.3, 1, 0.45);\n52\t  scene.add(sun);\n53\t  scene.add(sun.target);\n54\t  const fill = new THREE.PointLight('#ffd8ff', 30, 30, 1.6);\n55\t  scene.add(fill);\n56\t\n57\t  const camera = new THREE.PerspectiveCamera(66, 9 / 16, 0.05, 1200);\n58\t  const composer = new EffectComposer(renderer);\n59\t  composer.addPass(new RenderPass(scene, camera));\n60\t  const bloom = new UnrealBloomPass(new THREE.Vector2(256, 256), 0.2, 0.35, 0.94);\n61\t  const useBloom = qs.get('bloom') !== '0';\n62\t  if (useBloom) composer.addPass(bloom);\n63\t  composer.addPass(new OutputPass());\n64\t  composer.addPass(createGradePass());\n65\t\n66\t  const resize = () => {\n67\t    const w = canvas.clientWidth || window.innerWidth;\n68\t    const h = canvas.clientHeight || window.innerHeight;\n69\t    renderer.setSize(w, h, false);\n70\t    composer.setSize(w, h);\n71\t    bloom.resolution.set(w / 2, h / 2);\n72\t    camera.aspect = w / h;\n73\t    camera.updateProjectionMatrix();\n74\t  };\n75\t  window.addEventListener('resize', resize);\n76\t  resize();\n77\t\n78\t  // ---------------------------------------------------------------- world\n79\t  const course = new Course();\n80\t  const env = buildEnvironment(course);\n81\t  scene.add(env.group);\n82\t  const water = await loadWater(course);\n83\t  scene.add(water.group);\n84\t  const benny = await loadBennyRuntime();\n85\t  scene.add(benny.root);\n86\t  const girl = await loadGirlRuntime();\n87\t  const coins = createCoins(course);\n88\t  scene.add(coins.group);\n89\t  // debug: ?hide=water,benny,coins,drumA,basin,tubes,chamber\n90\t  const hidden = new Set((qs.get('hide') ?? '').split(',').filter(Boolean));\n91\t  if (hidden.has('water')) water.group.visible = false;\n92\t  if (hidden.has('coins')) coins.group.visible = false;\n93\t  const zoneHidden = (k: string) => hidden.has(k);\n94\t  const hud = createHud();\n95\t  const input = createInput(canvas);\n96\t  const rideCam = new RideCamera(course);\n97\t  rideCam.axis = env.tubeAxis;\n98\t\n99\t  // ---------------------------------------------------------------- state\n100\t  const st = {\n101\t    mode: 'intro' as Mode,\n102\t    t: 0, // time within the current mode\n103\t    clock: 0, // global animation time (shaders)\n104\t    frozen: null as number | null, // QA: freeze shader time\n105\t    s: 0,\n106\t    lat: 0,\n107\t    vlat: 0,\n108\t    coins: START_COINS,\n109\t    hearts: 5,\n110\t    paused: false,\n111\t    stage: '01' as StageId,\n112\t    bumpCooldown: 0,\n113\t    edgeTime: 0,\n114\t    twirl: 0,\n115\t    respawns: 0,\n116\t    log: [] as { t: number; s: number; y: number; stage: StageId }[],\n117\t  };\n118\t\n119\t  const stageOf = (s: number): StageId => course.stageAtS(s).id;\n120\t\n121\t  const setStage = (id: StageId) => {\n122\t    if (st.stage === id) return;\n123\t    st.stage = id;\n124\t    hud.setStage(id);\n125\t    updateZones();\n126\t  };\n127\t\n128\t  const zoneRanges: Record<keyof typeof env.zones, [StageId, StageId]> = {\n129\t    drumA: ['01', '02'],\n130\t    basin: ['02', '05'],\n131\t    tubes: ['03', '09'],\n132\t    chamber: ['07', '11'],\n133\t  };\n134\t  const updateZones = () => {\n135\t    const i = STAGE_ORDER.indexOf(st.stage);\n136\t    for (const [k, [a, b]] of Object.entries(zoneRanges)) {\n137\t      env.zones[k as keyof typeof env.zones].visible = !zoneHidden(k) && i >= STAGE_ORDER.indexOf(a) && i <= STAGE_ORDER.indexOf(b);\n138\t    }\n139\t    const inDrum = i <= 1;\n140\t    fog.density = inDrum ? 0.0015 : i >= 7 ? 0.0025 : 0.0035;\n141\t  };\n142\t\n143\t  // girl placement helpers (she lives in laundry-room local frames)\n144\t  const placeGirl = (room: 'A' | 'C', local: THREE.Vector3, yaw: number) => {\n145\t    const anchor = room === 'A' ? env.roomA.anchor : env.roomC.anchor;\n146\t    if (girl.root.parent !== anchor) anchor.add(girl.root);\n147\t    girl.root.position.copy(local);\n148\t    girl.root.rotation.set(0, yaw, 0);\n149\t  };\n150\t\n151\t  const bennyPose = (s: number, lat: number, time: number, out: { pos: THREE.Vector3; quat: THREE.Quaternion }) => {\n152\t    const f = course.sample(s);\n153\t    const h = water.surfaceHeight(s, lat, time);\n154\t    out.pos.copy(f.pos).addScaledVector(f.right, lat).addScaledVector(f.up, h + benny.radius * 0.55);\n155\t    const m = new THREE.Matrix4().makeBasis(new THREE.Vector3().crossVectors(f.up, f.tan).normalize(), f.up, f.tan);\n156\t    out.quat.setFromRotationMatrix(m);\n157\t    return f;\n158\t  };\n159\t\n160\t  const pose = { pos: new