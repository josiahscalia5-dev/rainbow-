{"agentId": "ac8112848dd644d86", "cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "claude/rainbow-3d-recovery-m4v347", "isSidechain": true, "message": {"content": [{"content": "1\t/**\n2\t * RAINBOW master course — ONE continuous route through the washer world.\n3\t *\n4\t * Units: 1 unit ≈ 5 cm at Benny's scale (Benny body radius ≈ 0.8). +Y is up (absolute altitude).\n5\t * The route starts inside Drum A (scene 01/02), drains through a chute into the whirlpool basin (03),\n6\t * drops down the five-arrow slide (04), winds through the perforated current tube (05), crests the\n7\t * rinse arch (06), winds through the washer tube and then PLUNGES ~62 units straight down (07) before\n8\t * the bottom of that same tube flares into the Final Spin Chamber inlet (08). 08–10 stay in that same\n9\t * chamber; the route ends under the purple towel on the platform, where the 11 cinematic plays.\n10\t *\n11\t * Every stage is a range of arc-length `s` on a single centripetal Catmull-Rom spline, so position\n12\t * and tangent are continuous by construction; `validateContinuity()` measures it anyway.\n13\t */\n14\timport * as THREE from 'three';\n15\t\n16\texport type StageId = '01' | '02' | '03' | '04' | '05' | '06' | '07' | '08' | '09' | '10' | '11';\n17\texport type TubeKind = 'none' | 'chute' | 'gold' | 'perf';\n18\texport type StageProp = 'width' | 'tube' | 'speed' | 'bank';\n19\t\n20\texport interface StageDef {\n21\t  id: StageId;\n22\t  title: string;\n23\t  /** arc-length range on the course */\n24\t  s0: number;\n25\t  s1: number;\n26\t  /** water ribbon width (units) */\n27\t  width: number;\n28\t  /** enclosing tube radius (0 = open environment such as a drum/basin/chamber) */\n29\t  tube: number;\n30\t  tubeKind: TubeKind;\n31\t  /** auto-propulsion speed (units / s) */\n32\t  speed: number;\n33\t  /** coin counter shown in the locked reference screenshot of this stage */\n34\t  refCoins: number;\n35\t  interactive: boolean;\n36\t  /** banking strength multiplier */\n37\t  bank: number;\n38\t}\n39\t\n40\texport interface CourseSample {\n41\t  s: number;\n42\t  pos: THREE.Vector3;\n43\t  tan: THREE.Vector3;\n44\t  up: THREE.Vector3;\n45\t  right: THREE.Vector3;\n46\t}\n47\t\n48\texport const STAGE_TITLES: Record<StageId, string> = {\n49\t  '01': 'INSIDE THE WASHING MACHINE',\n50\t  '02': 'WHIRLPOOL TUMBLE',\n51\t  '03': 'WHIRLPOOL TWIRL',\n52\t  '04': 'THROUGH THE FIVE ARROWS',\n53\t  '05': 'FLOW INTO THE CURRENT',\n54\t  '06': 'CREST THE RINSE ARCH',\n55\t  '07': 'DIVE THE WASHER TUBE',\n56\t  '08': 'FINAL SPIN CHAMBER',\n57\t  '09': 'RIDE THE FINAL WAVE',\n58\t  '10': 'SLIDE INTO HIDING',\n59\t  '11': 'SAFELY HOME',\n60\t};\n61\t\n62\t/** Fixed world anchors shared by environment builders (absolute coordinates). */\n63\texport const WORLD = {\n64\t  drumA: { center: new THREE.Vector3(0, 0, 0), radius: 5, zBack: -6.5, zDoor: 3.5, doorRadius: 3.2, waterY: -2.5 },\n65\t  basin: { center: new THREE.Vector3(2, -16, -19), rimRadius: 11.5, rimY: -10.6, drainRadius: 4.3, drainY: -20.2 },\n66\t  /** Final Spin Chamber (08–11): drum with axis along Z, door at the far (-Z) end */\n67\t  chamber: { center: new THREE.Vector3(12, -101.1, 0), radius: 13.5, zBack: -280, zDoor: -332, floorY: -113.6, doorRadius: 6.2 },\n68\t  platform: { center: new THREE.Vector3(12, -110.6, -325.0), radius: 6.2, topY: -110.6 },\n69\t  plunge: { topY: -52, bottomY: -113.6 },\n70\t};\n71\t\n72\t/** funnel surface height of the whirlpool basin as a function of radius from its axis */\n73\texport function funnelY(r: number): number {\n74\t  const b = WORLD.basin;\n75\t  const t = THREE.MathUtils.clamp((r - b.drainRadius * 0.6) / (b.rimRadius - b.drainRadius * 0.6), 0, 1);\n76\t  return b.drainY + (b.rimY - b.drainY) * Math.pow(t, 0.72);\n77\t}\n78\t\n79\tconst V = (x: number, y: number, z: number) => new THREE.Vector3(x, y, z);\n80\tconst smooth = (a: number, b: number, x: number) => {\n81\t  const t = THREE.MathUtils.clamp((x - a) / (b - a), 0, 1);\n82\t  return t * t * (3 - 2 * t);\n83\t};\n84\t\n85\tinterface RouteData {\n86\t  points: THREE.Vector3[];\n87\t  marks: Record<string, number>;\n88\t}\n89\t\n90\t/** Generates the dense control polyline of the route (absolute coordinates). */\n91\tfunction buildRoute(): RouteData {\n92\t  const pts: THREE.Vector3[] = [];\n93\t  const marks: Record<string, number> = {};\n94\t  const push = (p: THREE.Vector3) => {\n95\t    if (pts.length && p.distanceTo(pts[pts.length - 1]) < 0.25) return;\n96\t    pts.push(p);\n97\t  };\n98\t  const mark = (k: string) => (marks[k] = pts.length - 1);\n99\t  const seg = (n: number, f: (t: number) => THREE.Vector3, skipFirst = true) => {\n100\t    for (let i = skipFirst ? 1 : 0; i <= n; i++) push(f(i / n));\n101\t  };\n102\t\n103\t  // ---- 01: Benny hidden in the towel, drum A front-left floor (camera looks toward the door) ----\n104\t  const dA = WORLD.drumA;\n105\t  const hc = V(0, -0.4, 0); // swirl axis\n106\t  const th0 = Math.atan2(-2.0, 1.6);\n107\t  push(V(1.6, -2.4, -2.2));\n108\t  mark('01');\n109\t  // ---- 02: whirlpool tumble — helix around the drum axis toward the back drain ----\n110\t  const thEnd = -Math.PI / 2 - Math.PI * 2;\n111\t  seg(26, (t) => {\n112\t    const th = th0 + (thEnd - th0) * t;\n113\t    const r = 2.56 + (3.9 - 2.56) * smooth(0, 1, t);\n114\t    const z = -2.2 + (-5.4 + 2.2) * t;\n115\t    return V(hc.x + r * Math.cos(th), hc.y + r * Math.sin(th), z);\n116\t  });\n117\t  mark('02_drain');\n118\t  // chute from drum A back drain down into the whirlpool basin rim\n119\t  const b = WORLD.basin;\n120\t  const spiralStart = V(b.center.x - 9.6, funnelY(9.6) + 0.25, b.center.z);\n121\t  const c0 = pts[pts.length - 1].clone();\n122\t  const chuteCtrl = [c0, V(-0.6, -5.6, -7.6), V(-3.2, -7.8, -10.4), V(-6.6, -9.8, -14.2), spiralStart.clone().add(V(0, 0.15, 2.4))];\n123\t  const chute = new THREE.CatmullRomCurve3(chuteCtrl, false, 'centripetal');\n124\t  seg(14, (t) => chute.getPoint(t));\n125\t  push(spiralStart);\n126\t  mark('03');\n127\t  // ---- 03: whirlpool twirl — 3/4 inward turn down the funnel that dives into the drain CENTRE ----\n128\t  // decreasing angle from the -X side (θ=-π/2) round the far and right sides to the near (+Z) side;\n129\t  // r shrinks as (1-t)^1.6 so the last stretch heads radially inward = straight -Z into the drain hole.\n130\t  seg(60, (t) => {\n131\t    const th = -Math.PI / 2 - Math.PI * 1.5 * (1 - (1 - t) * (1 - t)); // angle eases out → radial finish\n132\t    const r = 9.6 * Math.pow(1 - t, 0.9);\n133\t    return V(b.center.x + r * Math.sin(th), funnelY(r) + 0.25, b.center.z + r * Math.cos(th));\n134\t  });\n135\t  mark('04');\n136\t  // ---- 04: five-arrow slide — steep straight drop (≈32°) inside the gold ring pipe ----\n137\t  const s4 = pts[pts.length - 1].clone();\n138\t  const pitch4 = THREE.MathUtils.degToRad(32);\n139\t  const d4 = V(0, -Math.sin(pitch4), -Math.cos(pitch4));\n140\t  // pull-down arc from the drain lip into the steep slide pitch\n141\t  const R4a = 9;\n142\t  seg(7, (t) => {\n143\t    const a = pitch4 * t;\n144\t    return s4.clone().add(V(0, -R4a * (1 - Math.cos(a)), -R4a * Math.sin(a)));\n145\t  });\n146\t  const s4b = pts[pts.length - 1].clone();\n147\t  seg(16, (t) => s4b.clone().addScaledVector(d4, 34 * t));\n148\t  // pull out of the slide into the horizontal current\n149\t  const s4c = pts[pts.length - 1].clone();\n150\t  const R4 = 12;\n151\t  seg(8, (t) => {\n152\t    const a = -pitch4 + pitch4 * t;\n153\t    return s4c.clone().add(V(0, R4 * (Math.cos(-pitch4) - Math.cos(a)), R4 * (Math.sin(-pitch4) - Math.sin(a))));\n154\t  });\n155\t  mark('05');\n156\t  // ---- 05: horizontal S-shaped current in the perforated tube ----\n157\t  const s5 = pts[pts.length - 1].clone();\n158\t  seg(36, (t) =>\n159\t    V(s5.x + 3.4 * Math.sin(2 * Math.PI * t) * Math.sin(Math.PI * t), s5.y - 3 * t, s5.z - 72 * t),\n160\t  );\n161\t  mark('06');\n162\t  // ---- 06: rinse arch — rises ~12 units, crests, curls down and to the right into the 07 tube ----\n163\t  const s6 = pts[pts.length - 1].clone();\n164\t  seg(34, (t) =>\n165\t    V(\n166\t      s6.x - 4 * Math.sin(Math.PI * t) + (WORLD.chamber.center.x - s6.x) * smooth(0.4, 1, t),\n167\t      s6.y + 12.5 * Math.pow(Math.sin(Math.PI * Math.min(t / 0.82, 1)), 1.15) - 4.5 * smooth(0.5, 1, t),\n168\t      s6.z - 46 * t,\n169\t    ),\n170\t  );\n171\t  mark('07');\n172\t  // ---- 07: winding washer tube (the visible stretch) ----\n173\t  const s7 = pts[pts.length - 1].clone();\n174\t  seg(32, (t) =>\n175\t    V(s7.x + 3.2 * Math.sin(3 * Math.PI * t) * Math.sin(Math.PI * t), s7.y + (WORLD.plunge.topY - s7.y) * t, s7.z - 60 * t),\n176\t  );\n177\t  mark('07_plunge_top');\n178\t  // ---- 07: THE DEEP PLUNGE — pull-down arc, long -70° straight, pull-up arc into the 08 inlet ----\n179\t  const p0 = pts[pts.length - 1].clone();\n180\t  const R = 14;\n181\t  const amax = THREE.MathUtils.degToRad(70);\n182\t  seg(12, (t) => {\n183\t    const a = amax * t;\n184\t    return p0.clone().add(V(0, -R * (1 - Math.cos(a)), -R * Math.sin(a)));\n185\t  });\n186\t  const p1 = pts[pts.length - 1].clone();\n187\t  const dPl = V(0, -Math.sin(amax), -Math.cos(amax));\n188\t  // straight length chosen so the bottom lands exactly on the chamber floor altitude\n189\t  const drop = p0.y - WORLD.plunge.bottomY;\n190\t  const Lstraight = (drop - 2 * R * (1 - Math.cos(amax))) / Math.sin(amax);\n191\t  seg(Math.ceil(Lstraight / 2), (t) => p1.clone().addScaledVector(dPl, Lstraight * t));\n192\t  mark('07_plunge_mid_end');\n193\t  const p2 = pts[pts.length - 1].clone();\n194\t  seg(12, (t) => {\n195\t    const a = -amax + amax * t;\n196\t    return p2.clone().add(V(0, R * (Math.cos(-amax) - Math.cos(a)), R * (Math.sin(-amax) - Math.sin(a))));\n197\t  });\n198\t  mark('07_plunge_bottom');\n199\t  const p3 = pts[pts.length - 1].clone();\n200\t  const zIn = WORLD.chamber.zBack;\n201\t  seg(4, (t) => V(p3.x, p3.y, p3.z + (zIn - p3.z) * t));\n202\t  mark('0