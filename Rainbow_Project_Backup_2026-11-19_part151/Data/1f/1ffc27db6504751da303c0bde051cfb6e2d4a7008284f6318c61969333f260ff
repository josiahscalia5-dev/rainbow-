{"cwd": "/home/user/rainbow-", "entrypoint": "remote_mobile", "gitBranch": "ccr-61131b9d-uj0oqb", "isSidechain": false, "message": {"content": [{"content": "1\t#!/usr/bin/env node\n2\t// Screen 05 tunnel probe (walls + gold rings bake, `?projwall05=1` / `?projring05=1`) — exact, read-only\n3\t// measurements of the REAL game at the locked 05 checkpoint (time frozen, as scripts/capture.mjs).\n4\t//   node scripts/proj05-tunnel-probe.mjs [--q='switches'] [--out=qa/pilot05/proj/tunnel/probe] [--raw=DIR] [--all]\n5\t// Writes into OUT:\n6\t//   tunnel.json     camera (world + projection matrix), the 05 tunnel numbers (checkpoint eye s, ring positions, far\n7\t//                   block knots / virtual depths, band widths) and the list of probed meshes\n8\t// and into RAW (21 MB each, keep them out of git):\n9\t//   tunnel_id.f32   864×1536×4 float32, top row first. Per pixel, the first surface the camera sees:\n10\t//                     real 05 wall   (uv.x round the tube, uv.y = s,            1, 10)\n11\t//                     far wall       (uv.x,                uv.y = sF + u,       2, 10)\n12\t//                     real ring      (phi object space,    z across the band,   3, 20 + instance)\n13\t//                     far ring       (phi,                 z,                   4, 20 + instance)\n14\t//                     real lid / far lid (object x, y, 5 / 6, 40 + instance); anything else: its own colour, alpha ≤ 1\n15\t//                   Benny, coins, bubbles, foam, splash and spray are hidden unless --all is given (then they occlude,\n16\t//                   and pixels blended with something transparent no longer carry an exact alpha → not usable).\n17\t//   tunnel_coords.f32  (--coords, with --q='projwall05=1&projring05=1'): the same frame, but the tunnel shaders write the\n18\t//                   baked-texture coordinates they sample: wall (u, v in wall05.png, 7, 77), ring (u, v in ring05.png, 8, 78)\n19\t// Uses window.__rainbow.qa3d() (QA accessor; rendering is unchanged). Nothing in the game is modified.\n20\timport { mkdirSync, writeFileSync } from 'node:fs';\n21\timport { loadPlaywright, CHROMIUM_ARGS, startVite } from './lib/pw.mjs';\n22\t\n23\tconst opt = Object.fromEntries(process.argv.slice(2).filter((a) => a.startsWith('--')).map((a) => { const [k, ...r] = a.slice(2).split('='); return [k, r.length ? r.join('=') : true]; }));\n24\tconst OUT = typeof opt.out === 'string' ? opt.out : 'qa/pilot05/proj/tunnel/probe';\n25\tconst RAW = typeof opt.raw === 'string' ? opt.raw : OUT;\n26\tconst Q = typeof opt.q === 'string' ? opt.q : '';\n27\tconst ALL = !!opt.all;\n28\tconst COORDS = !!opt.coords;   // with ?projwall05=1 / ?projring05=1: the baked-texture coordinates the shaders use (tunnel_coords.f32)\n29\tmkdirSync(OUT, { recursive: true });\n30\tmkdirSync(RAW, { recursive: true });\n31\tconst W = 864, H = 1536;\n32\t\n33\tconst { chromium } = loadPlaywright();\n34\tconst vite = await startVite(5233);\n35\tconst browser = await chromium.launch({ args: CHROMIUM_ARGS });\n36\ttry {\n37\t  const page = await browser.newPage({ viewport: { width: W, height: H }, deviceScaleFactor: 1 });\n38\t  page.on('pageerror', (e) => console.error('pageerror', e.message));\n39\t  page.on('console', (m) => { if (m.type() === 'error') console.error('console', m.text()); });\n40\t  const hide = ALL ? '' : '&hide=benny,coins&waterhide=crown,spray,bubbles,splash05,splashCrown,foamRim05,foamFlank,foamRafts';\n41\t  await page.goto(`${vite.url}/?qa=1&dpr=1${hide}${Q ? '&' + Q : ''}`);\n42\t  await page.waitForFunction(() => window.__rainbow?.ready === true || window.__error, null, { timeout: 240000 });\n43\t  const meta = await page.evaluate(async (COORDS) => {\n44\t    const R = window.__rainbow;\n45\t    R.goto('05');\n46\t    await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(() => r())));\n47\t    const { scene, camera, renderer, composer } = R.qa3d();\n48\t    const far = scene.getObjectByName('tube05_far_river'