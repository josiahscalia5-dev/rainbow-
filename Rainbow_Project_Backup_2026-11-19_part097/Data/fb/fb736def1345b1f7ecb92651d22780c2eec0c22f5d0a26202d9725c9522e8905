const {chromium}=require('playwright');const fs=require('node:fs');
(async()=>{const browser=await chromium.launch({executablePath:'/usr/bin/chromium',args:['--use-angle=swiftshader','--enable-unsafe-swiftshader','--disable-background-networking']});const receipt=[];try{for(const name of ['reconstructed','Claudia']){const page=await browser.newPage({viewport:{width:324,height:576}});const errors=[];page.on('pageerror',e=>errors.push(e.message));await page.route('**/*',r=>new URL(r.request().url()).hostname==='127.0.0.1'?r.continue():r.abort());await page.goto('http://127.0.0.1:8398');await page.getByRole('link',{name:new RegExp(name)}).click();await page.waitForFunction(()=>window.__rainbow?.ready&&window.__rainbow.state().stage==='06',null,{timeout:170000});const initial=await page.evaluate(()=>({state:window.__rainbow.state(),mesh:!!window.__rainbow.qa3d().scene.getObjectByName('Screen06_Structural_World')}));await page.waitForFunction(s=>window.__rainbow.state().s>s+.3,initial.state.s,{timeout:30000});await page.goBack();await page.getByRole('heading',{name:'Crest the Rinse Arch'}).waitFor();if(initial.mesh!==(name==='reconstructed')||errors.length)throw Error('Wrong world or runtime error for '+name);receipt.push({label:name,entryStage:initial.state.stage,stageStation:initial.state.s,renderedNewGeometry:initial.mesh,autoSwimming:true,returnedToComparison:true});await page.close();}}finally{await browser.close();}fs.writeFileSync('launcher-check.json',JSON.stringify(receipt,null,2));console.log('Both production review entries opened the correct Three.js scene and swam forward.');})().catch(e=>{console.error(e.message);process.exitCode=1});
