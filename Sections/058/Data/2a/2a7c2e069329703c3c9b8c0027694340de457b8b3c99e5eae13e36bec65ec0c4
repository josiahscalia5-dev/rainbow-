from pathlib import Path
from datetime import datetime,timezone
import json,subprocess,sys,hashlib
root=Path(__file__).parent
def read(p):return json.loads(p.read_text())
def dump(p,v):p.write_text(json.dumps(v,indent=2)+'\n')
def now():return datetime.now(timezone.utc).isoformat()
for sid in sys.argv[1:]:
 repo=root/'repos'/sid;base=read(root/('base-'+sid+'.json'));src=read(root/('source-'+sid+'.json'))
 prefix='experiments/codex/fidelity-'+sid
 evidence=repo/prefix;hashes=read(evidence/'checksums.json')
 def git(*a,bin=False):
  v=subprocess.check_output(['git','-C',str(repo),*a],stderr=subprocess.PIPE);return v if bin else v.decode().strip()
 for f,value in hashes.items():assert hashlib.sha256((evidence/f).read_bytes()).hexdigest()==value
 ref='refs/heads/'+base['branch']
 assert git('branch','--show-current')==base['branch']
 last=git('ls-remote','--heads','origin',ref).split()[0]
 if git('rev-parse','HEAD')==src['commit']:
  assert last==src['commit']
  git('add','--',prefix);git('diff','--cached','--check')
  staged=git('diff','--cached','--name-only').splitlines();assert len(staged)==len(hashes)+1 and all(f.startswith(prefix+'/') for f in staged)
  git('commit','-qm','Save native visual comparisons and verified swim for Screen '+sid)
 tip=git('rev-parse','HEAD')
 assert git('rev-parse','HEAD^')==src['commit']
 if last!=tip:
  assert last==src['commit']
  proc=subprocess.run(['git','-C',str(repo),'push','origin','HEAD:'+ref],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True)
  if proc.returncode:
   (root/('push-error-'+sid+'.txt')).write_text(proc.stdout[-3500:]);raise RuntimeError('Git push failed for '+sid)
 assert git('ls-remote','--heads','origin',ref).split()==[tip,ref]
 paths=git('diff','--name-only',base['base'],tip).splitlines()
 assert all(p==src['sourceFile'] or p.startswith(prefix+'/') for p in paths)
 manifest=git('show',tip+':scripts/reference.sha256').splitlines()
 for line in manifest:
  if not line.strip() or line.startswith('#'):continue
  hv,path=line.split(maxsplit=1);path=path.lstrip('*');assert hashlib.sha256((root/'games'/sid/path).read_bytes()).hexdigest()==hv
 assert not git('status','--porcelain')
 fresh=root/'lfs-verification'/sid;fresh.mkdir(parents=True,exist_ok=True)
 cert=[]
 for f in sorted(evidence.rglob('*.mp4')):
  rel=f.relative_to(repo).as_posix();ptr=git('show',tip+':'+rel,bin=True)
  assert ptr.startswith(b'version https://git-lfs.github.com/spec/v1')
  expected=ptr.decode().split('oid sha256:')[1].split()[0]
  result=subprocess.run(['git','-C',str(repo),'-c','lfs.storage='+str(fresh),'lfs','smudge','--',rel],input=ptr,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
  assert result.returncode==0 and len(result.stdout)==f.stat().st_size and hashlib.sha256(result.stdout).hexdigest()==expected==hashlib.sha256(f.read_bytes()).hexdigest()
  cert.append({'file':rel,'size':len(result.stdout),'verifiedDownloadedSHA256':expected})
 dump(root/('published-'+sid+'.json'),{'branch':base['branch'],'commit':tip,'sourceCommit':src['commit'],'verifiedUTC':now(),'verifiedFiles':len(hashes),'lfsDownloads':cert,'evidence':'https://github.com/josiahscalia5-dev/rainbow-/tree/'+tip+'/'+prefix})
 print(sid,tip,len(hashes),'verified',flush=True)
