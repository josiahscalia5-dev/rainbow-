          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/autosave-hook.sh\" SessionStart", "timeout": 60 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/autosave-hook.sh\" PreCompact", "timeout": 120 }
